# Validierungs-Modus (Validation): Schattenfenster, Referenzphase, Zeitzone, Summen.
# Felder mit Tabulator getrennt. Zeilen «ref»: erwartete Referenzphase, Zeitpunkt, Phasen «Beginn-Ende:PHASE» mit
# Kommas («-» = keine), alles in Sekunden ab 2026-11-08 22:00 UTC (Validation.reference, ±60 s).
# Fälle ab «case Name Gerätezone» bis zum nächsten, Zeiten in Minuten ab 2026-11-08 22:00 UTC:
#   night   «Fensterbeginn Zielzeit Wecken GRUND» und optional Epochen (eigene Nacht)
#   record  «Beginn» und Epochen (abgeschlossene Aufzeichnung)
#   session «Beginn Ende Zone|-» und Phasen «Beginn-Ende:PHASE» mit Kommas (Gesundheits-App)
#   learned «Grundrauschen|- Ruhepuls|-» (gelernte Werte)
#   row     erwartete Zeilen von ValidationReport.exportCsv ohne Kopf, alle, in Reihenfolge
#   sum     erwartete Zeilen «night N: …» und «all: …» von ValidationReport.lines, alle, in Reihenfolge
# Epochen: «Anzahl*Bewegung/Puls» mit Leerzeichen, «-» = leer.
ref	light	900	600-1200:LIGHT,1200-1800:UNKNOWN,1860-2400:DEEP,2400-3000:REM,3120-3600:AWAKE
ref	light	600	600-1200:LIGHT,1200-1800:UNKNOWN,1860-2400:DEEP,2400-3000:REM,3120-3600:AWAKE
ref	light	599	600-1200:LIGHT,1200-1800:UNKNOWN,1860-2400:DEEP,2400-3000:REM,3120-3600:AWAKE
ref	light	540	600-1200:LIGHT,1200-1800:UNKNOWN,1860-2400:DEEP,2400-3000:REM,3120-3600:AWAKE
ref	unknown	539	600-1200:LIGHT,1200-1800:UNKNOWN,1860-2400:DEEP,2400-3000:REM,3120-3600:AWAKE
ref	light	1200	600-1200:LIGHT,1200-1800:UNKNOWN,1860-2400:DEEP,2400-3000:REM,3120-3600:AWAKE
ref	light	1260	600-1200:LIGHT,1200-1800:UNKNOWN,1860-2400:DEEP,2400-3000:REM,3120-3600:AWAKE
ref	unknown	1261	600-1200:LIGHT,1200-1800:UNKNOWN,1860-2400:DEEP,2400-3000:REM,3120-3600:AWAKE
ref	unknown	1799	600-1200:LIGHT,1200-1800:UNKNOWN,1860-2400:DEEP,2400-3000:REM,3120-3600:AWAKE
ref	deep	1800	600-1200:LIGHT,1200-1800:UNKNOWN,1860-2400:DEEP,2400-3000:REM,3120-3600:AWAKE
ref	rem	2400	600-1200:LIGHT,1200-1800:UNKNOWN,1860-2400:DEEP,2400-3000:REM,3120-3600:AWAKE
ref	rem	3060	600-1200:LIGHT,1200-1800:UNKNOWN,1860-2400:DEEP,2400-3000:REM,3120-3600:AWAKE
ref	awake	3061	600-1200:LIGHT,1200-1800:UNKNOWN,1860-2400:DEEP,2400-3000:REM,3120-3600:AWAKE
ref	awake	3660	600-1200:LIGHT,1200-1800:UNKNOWN,1860-2400:DEEP,2400-3000:REM,3120-3600:AWAKE
ref	unknown	3661	600-1200:LIGHT,1200-1800:UNKNOWN,1860-2400:DEEP,2400-3000:REM,3120-3600:AWAKE
ref	unknown	100	-
ref	light	400	0-600:DEEP,300-900:LIGHT
ref	deep	400	300-900:LIGHT,0-600:DEEP
# Schatten: Leicht im 1. Fenster, ohne Moment im 2. (Zielzeit, Gleichstand ±60 s: die frühere Phase), Wach im 3.; echter
# Entscheid 60 s nach dem Ende der Phase (zählt noch)
case	shadows_and_tolerance	Europe/Zurich
record	60	10*0.02/55 1*0.3/62 89*0.02/55 2*0.3/55 18*0.02/55
night	450 480 470 LIGHT_SLEEP
session	30 475 -	30-70:LIGHT,70-104:DEEP,106-130:REM,130-469:LIGHT
row	1,00:05,shadow,LIGHT_SLEEP,light
row	1,00:45,shadow,DEADLINE,deep
row	1,00:51,shadow,AWAKE,rem
row	1,06:50,real,LIGHT_SLEEP,light
sum	night 1: LIGHT_SLEEP real 1/1 shadow 1/1 · target real - shadow deep 1 · hits real 1/1
sum	all: 1 nights, 1 with reference · LIGHT_SLEEP real 1/1 shadow 1/1 · target real - shadow deep 1 · hits real 1/1
# Nacht ohne Referenz: aufgeführt, zählt nicht
case	no_reference	Europe/Zurich
night	450 480 480 DEADLINE
row	1,07:00,real,DEADLINE,none
sum	night 1: no reference
sum	all: 1 nights, 0 with reference
# Stichproben (2 von 10 Epochen): kein Schattenfenster, nur der echte Entscheid; 5 Min nach der Phase: unbekannt
case	sampled_only_real	Europe/Zurich
record	60	2*0.02/55 8*-/- 2*0.02/55 8*-/- 2*0.02/55 8*-/- 2*0.02/55 8*-/- 2*0.02/55 8*-/- 2*0.02/55 8*-/- 2*0.02/55 8*-/- 2*0.02/55 8*-/- 2*0.02/55 8*-/- 2*0.02/55 8*-/- 2*0.02/55 8*-/- 2*0.02/55 8*-/-
night	450 480 480 DEADLINE
session	30 475 -	30-470:LIGHT,470-475:DEEP
row	1,07:00,real,DEADLINE,unknown
sum	night 1: LIGHT_SLEEP real - shadow - · target real unknown 1 shadow - · hits real 0/0 unknown 1
sum	all: 1 nights, 1 with reference · LIGHT_SLEEP real - shadow - · target real unknown 1 shadow - · hits real 0/0 unknown 1
# Zeitzone der Aufzeichnung (New York) für die Uhrzeit; zwei Nächte; Fenster mit 45 von 60 Epochen zählt, mit 44 nicht
