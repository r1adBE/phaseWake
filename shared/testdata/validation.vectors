record	1600	16*-/- 44*0.02/55
session	1440 1925 -	1440-1925:REM
row	1,00:45,real,LIGHT_SLEEP,deep
row	2,00:30,shadow,DEADLINE,rem
row	2,07:00,real,EXACT,rem
