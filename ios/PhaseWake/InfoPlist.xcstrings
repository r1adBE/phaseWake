{
  "sourceLanguage": "en",
  "strings": {
    "NSAlarmKitUsageDescription": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يوقظك Phase Wake كمنبّه احتياطي على iPhone."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake tě na iPhonu vzbudí jako záložní budík."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake vækker dig som backupalarm på din iPhone."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake weckt dich als Zweitwecker auf dem iPhone."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Phase Wake σε ξυπνά ως εφεδρικό ξυπνητήρι στο iPhone σου."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake te despierta como alarma de respaldo en tu iPhone."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake به‌عنوان زنگ هشدار پشتیبان روی iPhone بیدارت می‌کند."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake herättää sinut varahälytyksenä iPhonellasi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake te réveille comme alarme de secours sur ton iPhone."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "‏Phase Wake מעיר אותך כשעון מעורר גיבוי ב-iPhone."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake तुम्हारे iPhone पर बैकअप अलार्म के रूप में तुम्हें जगाता है।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Phase Wake tartalék ébresztőként ébreszt fel az iPhone-odon."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake membangunkanmu sebagai alarm cadangan di iPhone-mu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake ti sveglia come sveglia di riserva su iPhone."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wakeは、iPhoneのバックアップアラームとしてあなたを起こします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake는 iPhone의 백업 알람으로 너를 깨웁니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake mengejutkanmu sebagai penggera sandaran pada iPhone-mu."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake vekker deg som reservealarm på iPhonen din."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake maakt je wakker als back-upwekker op je iPhone."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake budzi cię jako zapasowy budzik na iPhonie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Phase Wake acorda você como alarme de reserva no seu iPhone."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O Phase Wake acorda-te como alarme de reserva no teu iPhone."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake te trezește ca alarmă de rezervă pe iPhone-ul tău."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake будит тебя как резервный будильник на iPhone."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake väcker dig som reservlarm på din iPhone."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake ปลุกคุณเป็นนาฬิกาปลุกสำรองบน iPhone"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake, iPhone'unda yedek alarm olarak seni uyandırır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake будить тебе як резервний будильник на iPhone."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake đánh thức bạn như một báo thức dự phòng trên iPhone."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake会在你的 iPhone 上作为备用闹钟唤醒你。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake會在你的 iPhone 上作為備用鬧鐘喚醒你。"
          }
        }
      }
    },
    "NSHealthShareUsageDescription": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يقرأ Phase Wake مراحل نومك بعد استيقاظك للتحقق مما إذا تم إيقاظك أثناء النوم الخفيف."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake po probuzení načte tvoje fáze spánku, aby zjistil, jestli tě vzbudil v lehkém spánku."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake læser dine søvnfaser, når du er vågnet, for at tjekke, om du blev vækket i let søvn."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake liest nach dem Aufwachen deine Schlafphasen, um zu prüfen, ob du im leichten Schlaf geweckt wurdest."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Phase Wake διαβάζει τις φάσεις ύπνου σου αφού ξυπνήσεις, για να ελέγξει αν σε ξύπνησε σε ελαφρύ ύπνο."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake lee tus fases de sueño después de despertarte para comprobar si te despertó en sueño ligero."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake پس از بیدار شدنت مراحل خوابت را می‌خواند تا بررسی کند در خواب سبک بیدار شده‌ای یا نه."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake lukee unenvaiheesi heräämisen jälkeen tarkistaakseen, herätettiinkö sinut kevyestä unesta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake lit tes phases de sommeil après ton réveil pour vérifier si tu as été réveillé(e) pendant un sommeil léger."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "‏Phase Wake קורא את שלבי השינה שלך לאחר ההתעוררות כדי לבדוק אם התעוררת בשינה קלה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake जागने के बाद तुम्हारे नींद के चरण पढ़ता है, ताकि यह जाँच सके कि तुम्हें हल्की नींद में जगाया गया या नहीं।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Phase Wake ébredés után beolvassa az alvási szakaszaidat, hogy ellenőrizze, könnyű alvásban ébresztett-e fel."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake membaca fase tidurmu setelah kamu bangun untuk memeriksa apakah kamu dibangunkan saat tidur ringan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake legge le tue fasi del sonno dopo il risveglio per verificare se sei stato svegliato durante il sonno leggero."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wakeは、起床後に睡眠ステージを読み取り、浅い眠りで起こせたかを確認します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake는 기상 후 수면 단계를 읽어 얕은 잠에서 깼는지 확인합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake membaca peringkat tidurmu selepas kamu bangun untuk menyemak sama ada kamu dikejutkan semasa tidur ringan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake leser søvnfasene dine etter at du har våknet, for å sjekke om du ble vekket i lett søvn."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake leest je slaapfases na het wakker worden om te controleren of je in lichte slaap bent gewekt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake odczytuje twoje fazy snu po przebudzeniu, aby sprawdzić, czy obudził cię w fazie lekkiego snu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Phase Wake lê suas fases do sono depois que você acorda para verificar se você foi acordado durante o sono leve."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O Phase Wake lê as tuas fases do sono depois de acordares para verificar se foste acordado durante o sono leve."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake citește fazele somnului tău după ce te trezești, pentru a verifica dacă ai fost trezit în somn ușor."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake считывает твои фазы сна после пробуждения, чтобы проверить, разбудил ли он тебя в фазе лёгкого сна."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake läser dina sömnfaser efter att du vaknat för att kontrollera om du väcktes i lätt sömn."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake อ่านระยะการนอนหลับของคุณหลังตื่น เพื่อตรวจสอบว่าคุณถูกปลุกในช่วงหลับตื้นหรือไม่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake, uyandıktan sonra uyku evrelerini okuyarak hafif uykuda uyandırılıp uyandırılmadığını kontrol eder."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake зчитує твої фази сну після пробудження, щоб перевірити, чи розбудив він тебе в фазі легкого сну."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake đọc các giai đoạn giấc ngủ của bạn sau khi thức dậy để kiểm tra xem bạn có được đánh thức lúc ngủ nông hay không."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake会在你醒来后读取睡眠阶段，以检查你是否在浅睡时被唤醒。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake會在你醒來後讀取睡眠階段，以檢查你是否在淺眠時被喚醒。"
          }
        }
      }
    },
    "NSMicrophoneUsageDescription": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يسجّل Phase Wake ليلاً مقاطع قصيرة من الشخير والكلام أثناء النوم إذا فعّلت ذلك. تبقى على iPhone وتُحذف بعد 7 أيام."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake v noci nahrává krátké úryvky chrápání a mluvení ze spaní, pokud to zapneš. Zůstanou v tvém iPhonu a po 7 dnech se smažou."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake optager korte klip af snorken og søvnsnak om natten, hvis du slår det til. De bliver på din iPhone og slettes efter 7 dage."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake nimmt nachts kurze Ausschnitte von Schnarchen und Sprechen im Schlaf auf, wenn du es einschaltest. Sie bleiben auf deinem iPhone und werden nach 7 Tagen gelöscht."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Phase Wake ηχογραφεί τη νύχτα σύντομα αποσπάσματα από ροχαλητό και ομιλία στον ύπνο, αν το ενεργοποιήσεις. Μένουν στο iPhone σου και διαγράφονται μετά από 7 ημέρες."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake graba por la noche fragmentos cortos de ronquidos y de hablar en sueños si lo activas. Se quedan en tu iPhone y se borran después de 7 días."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "اگر روشنش کنی، Phase Wake شب‌ها تکه‌های کوتاهی از خروپف و حرف زدن در خواب ضبط می‌کند. آن‌ها روی iPhone تو می‌مانند و پس از ۷ روز پاک می‌شوند."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake nauhoittaa öisin lyhyitä pätkiä kuorsauksesta ja unissa puhumisesta, jos otat sen käyttöön. Ne pysyvät iPhonessasi ja poistetaan 7 päivän kuluttua."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si tu l’actives, Phase Wake enregistre la nuit de courts extraits de ronflements et de paroles pendant le sommeil. Ils restent sur ton iPhone et sont supprimés après 7 jours."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אם תפעיל את זה, Phase Wake מקליט בלילה קטעים קצרים של נחירות ודיבור מתוך שינה. הם נשארים ב-iPhone שלך ונמחקים אחרי 7 ימים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अगर तुम इसे चालू करो, तो Phase Wake रात में खर्राटों और नींद में बोलने के छोटे अंश रिकॉर्ड करता है। ये तुम्हारे iPhone पर ही रहते हैं और 7 दिन बाद मिटा दिए जाते हैं।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ha bekapcsolod, a Phase Wake éjjel rövid részleteket rögzít a horkolásról és az alvás közbeni beszédről. Ezek az iPhone-odon maradnak, és 7 nap után törlődnek."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jika kamu menyalakannya, Phase Wake merekam potongan pendek dengkuran dan mengigau di malam hari. Rekaman tetap di iPhone-mu dan dihapus setelah 7 hari."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se lo attivi, Phase Wake registra di notte brevi estratti di russamento e di parole nel sonno. Restano sul tuo iPhone e vengono eliminati dopo 7 giorni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オンにすると、Phase Wake は夜間のいびきや寝言を短く録音します。録音は iPhone に保存され、7日後に削除されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "켜 두면 Phase Wake가 밤에 코골이와 잠꼬대를 짧게 녹음해. 녹음은 iPhone에만 남고 7일 후에 삭제돼."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Jika kamu menghidupkannya, Phase Wake merakam klip pendek dengkuran dan bercakap semasa tidur pada waktu malam. Klip kekal pada iPhone kamu dan dipadam selepas 7 hari."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake tar opp korte klipp av snorking og søvnprat om natten hvis du slår det på. De blir på iPhonen din og slettes etter 7 dager."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake neemt ’s nachts korte fragmenten van snurken en praten in je slaap op als je dit aanzet. Ze blijven op je iPhone en worden na 7 dagen verwijderd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeśli to włączysz, Phase Wake nagrywa w nocy krótkie fragmenty chrapania i mówienia przez sen. Zostają na twoim iPhonie i są usuwane po 7 dniach."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Se você ativar, o Phase Wake grava à noite trechos curtos de ronco e de fala durante o sono. Eles ficam no seu iPhone e são apagados após 7 dias."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Se ativares, o Phase Wake grava à noite excertos curtos de ressonar e de falar a dormir. Ficam no teu iPhone e são apagados ao fim de 7 dias."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Dacă activezi asta, Phase Wake înregistrează noaptea fragmente scurte de sforăit și vorbit prin somn. Rămân pe iPhone-ul tău și sunt șterse după 7 zile."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если ты включишь эту функцию, Phase Wake будет ночью записывать короткие фрагменты храпа и разговоров во сне. Они остаются на твоём iPhone и удаляются через 7 дней."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake spelar in korta klipp av snarkning och sömnprat på natten om du slår på det. De stannar på din iPhone och raderas efter 7 dagar."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หากเปิดใช้ Phase Wake จะบันทึกเสียงกรนและการละเมอพูดช่วงสั้นๆ ในตอนกลางคืน คลิปจะอยู่บน iPhone ของคุณเท่านั้นและจะถูกลบหลังจาก 7 วัน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Açarsan Phase Wake geceleri horlama ve uykuda konuşmadan kısa kesitler kaydeder. Bunlar iPhone’unda kalır ve 7 gün sonra silinir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Якщо ти це ввімкнеш, Phase Wake уночі записуватиме короткі фрагменти хропіння та розмов уві сні. Вони залишаються на твоєму iPhone і видаляються через 7 днів."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nếu bạn bật, Phase Wake sẽ ghi lại các đoạn ngắn tiếng ngáy và nói mớ vào ban đêm. Chúng chỉ lưu trên iPhone của bạn và bị xóa sau 7 ngày."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开启后，Phase Wake 会在夜间录下打鼾和说梦话的简短片段。片段只保存在你的 iPhone 上，7 天后自动删除。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟後，Phase Wake 會在夜間錄下打鼾和說夢話的簡短片段。片段只保存在你的 iPhone 上，7 天後自動刪除。"
          }
        }
      }
    }
  },
  "version": "1.0"
}
