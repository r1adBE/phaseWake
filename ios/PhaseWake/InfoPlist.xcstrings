        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നേരിയ ഉറക്കത്തിലാണോ ഉണർത്തിയത് എന്ന് പരിശോധിക്കാൻ, ഉണർന്ന ശേഷം Phase Wake നിങ്ങളുടെ ഉറക്ക ഘട്ടങ്ങൾ വായിക്കും."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Чамайг хөнгөн нойронд сэрээсэн эсэхийг шалгахын тулд Phase Wake сэрсний чинь дараа нойрны үе шатыг уншина."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुम्हाला हलक्या झोपेत उठवले की नाही हे तपासण्यासाठी Phase Wake उठल्यानंतर तुमचे झोपेचे टप्पे वाचते."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake membaca peringkat tidurmu selepas kamu bangun untuk menyemak sama ada kamu dikejutkan semasa tidur ringan."
          }
        },
        "my": {
          "stringUnit": {
            "state": "translated",
            "value": "အိပ်ရေးပေါ့ချိန်တွင် နှိုးခဲ့သလား စစ်ဆေးရန် နိုးပြီးနောက် Phase Wake က သင့်အိပ်စက်မှုအဆင့်များကို ဖတ်သည်။"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake leser søvnfasene dine etter at du har våknet, for å sjekke om du ble vekket i lett søvn."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "तिमीलाई हल्का निद्रामा ब्युँझाइयो कि भनेर जाँच्न, ब्युँझेपछि Phase Wake ले तिम्रो निद्राका चरण पढ्छ।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake leest je slaapfases na het wakker worden om te controleren of je in lichte slaap bent gewekt."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਤੁਹਾਨੂੰ ਹਲਕੀ ਨੀਂਦ ਵਿੱਚ ਜਗਾਇਆ ਗਿਆ ਜਾਂ ਨਹੀਂ, ਇਹ ਜਾਂਚਣ ਲਈ Phase Wake ਜਾਗਣ ਤੋਂ ਬਾਅਦ ਤੁਹਾਡੇ ਨੀਂਦ ਦੇ ਪੜਾਅ ਪੜ੍ਹਦਾ ਹੈ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake odczytuje twoje fazy snu po przebudzeniu, aby sprawdzić, czy obudził cię w fazie lekkiego snu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Phase Wake lê suas fases do sono depois que você acorda para verificar se você foi acordado durante o sono leve."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O Phase Wake lê as tuas fases do sono depois de acordares para verificar se foste acordado durante o sono leve."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake citește fazele somnului tău după ce te trezești, pentru a verifica dacă ai fost trezit în somn ușor."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake считывает твои фазы сна после пробуждения, чтобы проверить, разбудил ли он тебя в фазе лёгкого сна."
          }
        },
        "si": {
          "stringUnit": {
            "state": "translated",
            "value": "ඔබව සැහැල්ලු නින්දේදී අවදි කළාද යන්න පරීක්ෂා කිරීමට, ඔබ අවදි වූ පසු Phase Wake ඔබේ නින්දේ අදියර කියවයි."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake po prebudení načíta tvoje fázy spánku, aby overil, či ťa zobudil v ľahkom spánku."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake po prebujenju prebere tvoje faze spanca, da preveri, ali te je zbudil v lahkem spancu."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake lexon fazat e gjumit pasi zgjohesh, për të kontrolluar nëse u zgjove në gjumë të lehtë."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake после буђења чита твоје фазе сна да би проверио да ли те је пробудио у лаганом сну."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake läser dina sömnfaser efter att du vaknat för att kontrollera om du väcktes i lätt sömn."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake husoma hatua zako za usingizi baada ya kuamka ili kuangalia kama uliamshwa katika usingizi mwepesi."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நீங்கள் லேசான தூக்கத்தில் எழுப்பப்பட்டீர்களா என்று சரிபார்க்க, எழுந்த பிறகு Phase Wake உங்கள் தூக்க நிலைகளைப் படிக்கும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మిమ్మల్ని తేలికపాటి నిద్రలో లేపారో లేదో చూడటానికి, మీరు మేల్కొన్న తర్వాత Phase Wake మీ నిద్ర దశలను చదువుతుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake อ่านระยะการนอนหลับของคุณหลังตื่น เพื่อตรวจสอบว่าคุณถูกปลุกในช่วงหลับตื้นหรือไม่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake, uyandıktan sonra uyku evrelerini okuyarak hafif uykuda uyandırılıp uyandırılmadığını kontrol eder."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake зчитує твої фази сну після пробудження, щоб перевірити, чи розбудив він тебе в фазі легкого сну."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake جاگنے کے بعد تمہاری نیند کے مراحل پڑھتا ہے تاکہ دیکھ سکے کہ تمہیں ہلکی نیند میں جگایا گیا یا نہیں۔"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Yengil uyquda uygʻotilganingni tekshirish uchun Phase Wake uygʻonganingdan keyin uyqu bosqichlaringni oʻqiydi."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake đọc các giai đoạn giấc ngủ của bạn sau khi thức dậy để kiểm tra xem bạn có được đánh thức lúc ngủ nông hay không."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake 會在你醒來後讀取睡眠階段，以檢查你是否在淺睡時被叫醒。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake会在你醒来后读取睡眠阶段，以检查你是否在浅睡时被唤醒。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake會在你醒來後讀取睡眠階段，以檢查你是否在淺眠時被喚醒。"
          }
        },
        "zu": {
          "stringUnit": {
            "state": "translated",
            "value": "I-Phase Wake ifunda izigaba zakho zokulala ngemva kokuvuka ukuze ihlole ukuthi uvuswe yini ebuthongweni obulula."
          }
        }
      }
    },
    "NSMicrophoneUsageDescription": {
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "As jy dit aanskakel, neem Phase Wake snags kort snitte van snork en praat in jou slaap op. Hulle bly op jou iPhone en word ná 7 dae uitgevee."
          }
        },
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "ካበሩት፣ Phase Wake ማታ የማንኮራፋትና በእንቅልፍ የማውራት አጫጭር ቅንጥቦችን ይቀዳል። በiPhoneዎ ላይ ይቆያሉ እና ከ7 ቀናት በኋላ ይሰረዛሉ።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يسجّل Phase Wake ليلاً مقاطع قصيرة من الشخير والكلام أثناء النوم إذا فعّلت ذلك. تبقى على iPhone وتُحذف بعد 7 أيام."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Açsan, Phase Wake gecə xoruldama və yuxuda danışmanın qısa kliplərini yazır. Onlar iPhone-unda qalır və 7 gündən sonra silinir."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ако го включиш, Phase Wake записва нощем кратки откъси от хъркане и говорене насън. Те остават на твоя iPhone и се изтриват след 7 дни."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "তুমি চালু করলে Phase Wake রাতে নাক ডাকা আর ঘুমের মধ্যে কথা বলার ছোট ক্লিপ রেকর্ড করে। এগুলো তোমার iPhone-এই থাকে আর ৭ দিন পরে মুছে যায়।"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ako to uključiš, Phase Wake noću snima kratke isječke hrkanja i govora u snu. Ostaju na tvom iPhoneu i brišu se nakon 7 dana."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Si ho actives, Phase Wake enregistra a la nit fragments curts de roncs i de parlar en somnis. Es queden al teu iPhone i se suprimeixen al cap de 7 dies."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake v noci nahrává krátké úryvky chrápání a mluvení ze spaní, pokud to zapneš. Zůstanou v tvém iPhonu a po 7 dnech se smažou."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake optager korte klip af snorken og søvnsnak om natten, hvis du slår det til. De bliver på din iPhone og slettes efter 7 dage."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake nimmt nachts kurze Ausschnitte von Schnarchen und Sprechen im Schlaf auf, wenn du es einschaltest. Sie bleiben auf deinem iPhone und werden nach 7 Tagen gelöscht."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Phase Wake ηχογραφεί τη νύχτα σύντομα αποσπάσματα από ροχαλητό και ομιλία στον ύπνο, αν το ενεργοποιήσεις. Μένουν στο iPhone σου και διαγράφονται μετά από 7 ημέρες."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake graba por la noche fragmentos cortos de ronquidos y de hablar en sueños si lo activas. Se quedan en tu iPhone y se borran después de 7 días."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kui lülitad selle sisse, salvestab Phase Wake öösel lühikesi klippe norskamisest ja unes rääkimisest. Need jäävad sinu iPhone’i ja kustutatakse 7 päeva pärast."
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktibatzen baduzu, Phase Wake-k zurrungaren eta loan hitz egitearen klip laburrak grabatzen ditu gauez. Zure iPhone-an geratzen dira eta 7 egunen ondoren ezabatzen dira."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "اگر روشنش کنی، Phase Wake شب‌ها تکه‌های کوتاهی از خروپف و حرف زدن در خواب ضبط می‌کند. آن‌ها روی iPhone تو می‌مانند و پس از ۷ روز پاک می‌شوند."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake nauhoittaa öisin lyhyitä pätkiä kuorsauksesta ja unissa puhumisesta, jos otat sen käyttöön. Ne pysyvät iPhonessasi ja poistetaan 7 päivän kuluttua."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Kung io-on mo ito, magre-record ang Phase Wake ng maiikling clip ng hilik at pagsasalita habang tulog sa gabi. Nananatili ang mga ito sa iPhone mo at dine-delete pagkalipas ng 7 araw."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si tu l’actives, Phase Wake enregistre la nuit de courts extraits de ronflements et de paroles pendant le sommeil. Ils restent sur ton iPhone et sont supprimés après 7 jours."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Má chuireann tú ar siúl é, taifeadann Phase Wake gearrthóga gearra de shrannadh agus de chaint i do chodladh san oíche. Fanann siad ar d’iPhone agus scriostar iad tar éis 7 lá."
          }
        },
        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "Se o activas, Phase Wake grava pola noite fragmentos curtos de roncos e de falar en soños. Quedan no teu iPhone e elimínanse despois de 7 días."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તમે ચાલુ કરો તો Phase Wake રાત્રે નસકોરાં અને ઊંઘમાં બોલવાની ટૂંકી ક્લિપ રેકોર્ડ કરે છે. તે તમારા iPhone પર જ રહે છે અને 7 દિવસ પછી કાઢી નખાય છે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אם תפעיל את זה, Phase Wake מקליט בלילה קטעים קצרים של נחירות ודיבור מתוך שינה. הם נשארים ב-iPhone שלך ונמחקים אחרי 7 ימים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अगर तुम इसे चालू करो, तो Phase Wake रात में खर्राटों और नींद में बोलने के छोटे अंश रिकॉर्ड करता है। ये तुम्हारे iPhone पर ही रहते हैं और 7 दिन बाद मिटा दिए जाते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ako to uključiš, Phase Wake noću snima kratke isječke hrkanja i govora u snu. Ostaju na tvom iPhoneu i brišu se nakon 7 dana."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ha bekapcsolod, a Phase Wake éjjel rövid részleteket rögzít a horkolásról és az alvás közbeni beszédről. Ezek az iPhone-odon maradnak, és 7 nap után törlődnek."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Եթե միացնես, Phase Wake-ը գիշերը ձայնագրում է խռմփոցի և քնի մեջ խոսքի կարճ հատվածներ։ Դրանք մնում են iPhone-իդ վրա և ջնջվում են 7 օր հետո։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jika kamu menyalakannya, Phase Wake merekam potongan pendek dengkuran dan mengigau di malam hari. Rekaman tetap di iPhone-mu dan dihapus setelah 7 hari."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Ef þú kveikir á því tekur Phase Wake upp stuttar upptökur af hrotum og svefntali á nóttunni. Þær verða eftir á iPhone og er eytt eftir 7 daga."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se lo attivi, Phase Wake registra di notte brevi estratti di russamento e di parole nel sonno. Restano sul tuo iPhone e vengono eliminati dopo 7 giorni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オンにすると、Phase Wake は夜間のいびきや寝言を短く録音します。録音は iPhone に保存され、7日後に削除されます。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "თუ ჩართავ, Phase Wake ღამით ჩაწერს ხვრინვისა და ძილში ლაპარაკის მოკლე ფრაგმენტებს. ისინი რჩება შენს iPhone-ზე და 7 დღის შემდეგ იშლება."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Қоссаң, Phase Wake түнде қорылдау мен ұйқыдағы сөйлеудің қысқа үзінділерін жазады. Олар iPhone-ыңда қалады және 7 күннен кейін жойылады."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "បើអ្នកបើកវា Phase Wake ថតឃ្លីបខ្លីៗនៃការស្រមុក និងការនិយាយពេលដេកនៅពេលយប់។ វានៅលើ iPhone របស់អ្នក ហើយត្រូវលុបក្រោយ 7 ថ្ងៃ។"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನೀವು ಆನ್ ಮಾಡಿದರೆ, Phase Wake ರಾತ್ರಿ ಗೊರಕೆ ಮತ್ತು ನಿದ್ರೆಯಲ್ಲಿ ಮಾತನಾಡುವುದರ ಚಿಕ್ಕ ಕ್ಲಿಪ್‌ಗಳನ್ನು ರೆಕಾರ್ಡ್ ಮಾಡುತ್ತದೆ. ಅವು ನಿಮ್ಮ iPhone ನಲ್ಲೇ ಇರುತ್ತವೆ ಮತ್ತು 7 ದಿನಗಳ ನಂತರ ಅಳಿಸಲಾಗುತ್ತವೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "켜 두면 Phase Wake가 밤에 코골이와 잠꼬대를 짧게 녹음해. 녹음은 iPhone에만 남고 7일 후에 삭제돼."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ຖ້າເຈົ້າເປີດໃຊ້ Phase Wake ຈະບັນທຶກຄລິບສັ້ນໆຂອງສຽງກົນ ແລະ ການລະເມີໃນຕອນກາງຄືນ ຄລິບຢູ່ໃນ iPhone ຂອງເຈົ້າ ແລະ ຖືກລຶບຫຼັງ 7 ມື້"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Jei tai įjungsi, Phase Wake naktį įrašo trumpus knarkimo ir kalbėjimo per miegus fragmentus. Jie lieka tavo iPhone ir ištrinami po 7 dienų."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ja to ieslēgsi, Phase Wake naktī ieraksta īsus krākšanas un runāšanas miegā fragmentus. Tie paliek tavā iPhone un tiek dzēsti pēc 7 dienām."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ако го вклучиш, Phase Wake ноќе снима кратки снимки од хркање и зборување во сон. Остануваат на твојот iPhone и се бришат по 7 дена."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങൾ ഓണാക്കിയാൽ, രാത്രിയിൽ കൂർക്കംവലിയുടെയും ഉറക്കത്തിലെ സംസാരത്തിന്റെയും ചെറിയ ക്ലിപ്പുകൾ Phase Wake റെക്കോർഡ് ചെയ്യും. അവ iPhone-ൽ തന്നെ ഇരിക്കും, 7 ദിവസത്തിനു ശേഷം ഇല്ലാതാകും."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Чи асаавал Phase Wake шөнө хурхиралт, нойрондоо ярихын богино хэсгийг бичнэ. Тэдгээр нь iPhone дээр чинь үлдэж, 7 хоногийн дараа устна."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुम्ही चालू केल्यास Phase Wake रात्री घोरण्याच्या आणि झोपेत बोलण्याच्या छोट्या क्लिप रेकॉर्ड करते. त्या तुमच्या iPhone वरच राहतात आणि ७ दिवसांनी हटवल्या जातात."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Jika kamu menghidupkannya, Phase Wake merakam klip pendek dengkuran dan bercakap semasa tidur pada waktu malam. Klip kekal pada iPhone kamu dan dipadam selepas 7 hari."
          }
        },
        "my": {
          "stringUnit": {
            "state": "translated",
            "value": "ဖွင့်ထားလျှင် Phase Wake သည် ညဘက် ဟောက်သံနှင့် အိပ်ယောင်စကားပြောသံ အတိုလေးများကို မှတ်တမ်းတင်သည်။ ၎င်းတို့သည် သင့် iPhone ပေါ်တွင်သာ ရှိပြီး 7 ရက်အကြာတွင် ဖျက်သည်။"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake tar opp korte klipp av snorking og søvnprat om natten hvis du slår det på. De blir på iPhonen din og slettes etter 7 dager."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "तिमीले अन गरेमा, Phase Wake ले राति घुर्ने र निद्रामा बोल्ने छोटा क्लिप रेकर्ड गर्छ। यी तिम्रो iPhone मै रहन्छन् र ७ दिनपछि मेटिन्छन्।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake neemt ’s nachts korte fragmenten van snurken en praten in je slaap op als je dit aanzet. Ze blijven op je iPhone en worden na 7 dagen verwijderd."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਜੇ ਤੁਸੀਂ ਚਾਲੂ ਕਰੋ, ਤਾਂ Phase Wake ਰਾਤ ਨੂੰ ਘੁਰਾੜਿਆਂ ਅਤੇ ਨੀਂਦ ਵਿੱਚ ਬੋਲਣ ਦੀਆਂ ਛੋਟੀਆਂ ਕਲਿੱਪਾਂ ਰਿਕਾਰਡ ਕਰਦਾ ਹੈ। ਇਹ ਤੁਹਾਡੇ iPhone ’ਤੇ ਹੀ ਰਹਿੰਦੀਆਂ ਹਨ ਅਤੇ 7 ਦਿਨਾਂ ਬਾਅਦ ਮਿਟ ਜਾਂਦੀਆਂ ਹਨ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeśli to włączysz, Phase Wake nagrywa w nocy krótkie fragmenty chrapania i mówienia przez sen. Zostają na twoim iPhonie i są usuwane po 7 dniach."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Se você ativar, o Phase Wake grava à noite trechos curtos de ronco e de fala durante o sono. Eles ficam no seu iPhone e são apagados após 7 dias."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Se ativares, o Phase Wake grava à noite excertos curtos de ressonar e de falar a dormir. Ficam no teu iPhone e são apagados ao fim de 7 dias."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Dacă activezi asta, Phase Wake înregistrează noaptea fragmente scurte de sforăit și vorbit prin somn. Rămân pe iPhone-ul tău și sunt șterse după 7 zile."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если ты включишь эту функцию, Phase Wake будет ночью записывать короткие фрагменты храпа и разговоров во сне. Они остаются на твоём iPhone и удаляются через 7 дней."
          }
        },
        "si": {
          "stringUnit": {
            "state": "translated",
            "value": "ඔබ සක්‍රිය කළහොත්, Phase Wake රාත්‍රියේ ගොරවීමේ සහ නින්දේ කතා කිරීමේ කෙටි කොටස් පටිගත කරයි. ඒවා ඔබේ iPhone හි පවතින අතර දින 7 කට පසු මැකේ."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ak to zapneš, Phase Wake v noci nahrá krátke záznamy chrápania a rozprávania zo spánku. Zostávajú v tvojom iPhone a po 7 dňoch sa vymažú."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake ponoči posname kratke posnetke smrčanja in govorjenja v spanju, če to vklopiš. Ostanejo na tvojem iPhonu in se po 7 dneh izbrišejo."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Nëse e aktivizon, Phase Wake regjistron natën fragmente të shkurtra të gërhitjes dhe të të folurit në gjumë. Ato mbeten në iPhone dhe fshihen pas 7 ditësh."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ако то укључиш, Phase Wake ноћу снима кратке исечке хркања и говора у сну. Остају на твом iPhone-у и бришу се после 7 дана."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake spelar in korta klipp av snarkning och sömnprat på natten om du slår på det. De stannar på din iPhone och raderas efter 7 dagar."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Ukiwasha, Phase Wake hurekodi vipande vifupi vya kukoroma na kuongea usingizini usiku. Vinabaki kwenye iPhone yako na hufutwa baada ya siku 7."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நீங்கள் ஆன் செய்தால், Phase Wake இரவில் குறட்டை, தூக்கத்தில் பேசுதல் ஆகியவற்றின் சிறு கிளிப்புகளைப் பதிவுசெய்யும். அவை உங்கள் iPhone இலேயே இருக்கும், 7 நாட்களுக்குப் பிறகு நீக்கப்படும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీరు ఆన్ చేస్తే, Phase Wake రాత్రి గురక, నిద్రలో మాట్లాడటం చిన్న క్లిప్‌లుగా రికార్డ్ చేస్తుంది. అవి మీ iPhoneలోనే ఉంటాయి, 7 రోజుల తర్వాత తొలగిపోతాయి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หากเปิดใช้ Phase Wake จะบันทึกเสียงกรนและการละเมอพูดช่วงสั้นๆ ในตอนกลางคืน คลิปจะอยู่บน iPhone ของคุณเท่านั้นและจะถูกลบหลังจาก 7 วัน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Açarsan Phase Wake geceleri horlama ve uykuda konuşmadan kısa kesitler kaydeder. Bunlar iPhone’unda kalır ve 7 gün sonra silinir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Якщо ти це ввімкнеш, Phase Wake уночі записуватиме короткі фрагменти хропіння та розмов уві сні. Вони залишаються на твоєму iPhone і видаляються через 7 днів."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اگر تم اسے آن کرو تو Phase Wake رات کو خراٹوں اور نیند میں باتیں کرنے کے چھوٹے کلپس ریکارڈ کرتا ہے۔ یہ تمہارے iPhone پر رہتے ہیں اور 7 دن بعد حذف ہو جاتے ہیں۔"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Yoqsang, Phase Wake tunda xurrak va uyqudagi gaplarning qisqa parchalarini yozadi. Ular iPhoneʼingda qoladi va 7 kundan keyin oʻchiriladi."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nếu bạn bật, Phase Wake sẽ ghi lại các đoạn ngắn tiếng ngáy và nói mớ vào ban đêm. Chúng chỉ lưu trên iPhone của bạn và bị xóa sau 7 ngày."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟後，Phase Wake 會在晚上錄下打鼾和說夢話的短片段。片段只會留在你的 iPhone 上，7 日後刪除。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开启后，Phase Wake 会在夜间录下打鼾和说梦话的简短片段。片段只保存在你的 iPhone 上，7 天后自动删除。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟後，Phase Wake 會在夜間錄下打鼾和說夢話的簡短片段。片段只保存在你的 iPhone 上，7 天後自動刪除。"
          }
        },
        "zu": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma ukuvula, i-Phase Wake iqopha iziqeshana ezimfushane zokuhona nokukhuluma ebuthongweni ebusuku. Zihlala ku-iPhone yakho futhi zisuswa ngemva kwezinsuku ezi-7."
          }
        }
      }
    }
  },
  "version": "1.0"
}
