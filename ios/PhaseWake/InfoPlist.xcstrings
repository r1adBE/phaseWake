        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يقرأ Phase Wake مراحل نومك بعد استيقاظك للتحقق مما إذا تم إيقاظك أثناء النوم الخفيف."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake oyandıqdan sonra yuxu fazalarını oxuyur ki, səni yüngül yuxuda oyadıb-oyatmadığını yoxlasın."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "След събуждане Phase Wake чете фазите на съня ти, за да провери дали те е събудил в лек сън."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "তোমাকে হালকা ঘুমে জাগানো হয়েছিল কি না দেখতে, জেগে ওঠার পর Phase Wake তোমার ঘুমের পর্যায় পড়ে।"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake nakon buđenja čita tvoje faze sna kako bi provjerio je li te probudio u laganom snu."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake llegeix les teves fases del son després que et despertis per comprovar si t’ha despertat en son lleuger."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake po probuzení načte tvoje fáze spánku, aby zjistil, jestli tě vzbudil v lehkém spánku."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake læser dine søvnfaser, når du er vågnet, for at tjekke, om du blev vækket i let søvn."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake liest nach dem Aufwachen deine Schlafphasen, um zu prüfen, ob du im leichten Schlaf geweckt wurdest."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Phase Wake διαβάζει τις φάσεις ύπνου σου αφού ξυπνήσεις, για να ελέγξει αν σε ξύπνησε σε ελαφρύ ύπνο."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake lee tus fases de sueño después de despertarte para comprobar si te despertó en sueño ligero."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake loeb pärast ärkamist sinu unefaase, et kontrollida, kas sind äratati kerges unes."
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "Esnatu ondoren, Phase Wake-k zure lo-faseak irakurtzen ditu, lo arinean esnatu zaituen egiaztatzeko."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake پس از بیدار شدنت مراحل خوابت را می‌خواند تا بررسی کند در خواب سبک بیدار شده‌ای یا نه."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake lukee unenvaiheesi heräämisen jälkeen tarkistaakseen, herätettiinkö sinut kevyestä unesta."
          }
        },
        "fil": {
          "stringUnit": {
