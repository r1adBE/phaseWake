{
  "sourceLanguage": "en",
  "strings": {
    "NSAlarmKitUsageDescription": {
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake maak jou as rugsteunwekker op jou iPhone wakker."
          }
        },
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake በiPhoneዎ ላይ እንደ ተጠባባቂ ማንቂያ ይቀሰቅስዎታል።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يوقظك Phase Wake كمنبّه احتياطي على iPhone."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake iPhone-da ehtiyat siqnal kimi səni oyadır."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake те събужда като резервен будилник на iPhone."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake তোমার iPhone-এ ব্যাকআপ অ্যালার্ম হিসেবে তোমাকে জাগায়।"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake te budi kao rezervni alarm na iPhoneu."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake et desperta com a alarma de reserva a l’iPhone."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake tě na iPhonu vzbudí jako záložní budík."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake vækker dig som backupalarm på din iPhone."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake weckt dich als Zweitwecker auf dem iPhone."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Phase Wake σε ξυπνά ως εφεδρικό ξυπνητήρι στο iPhone σου."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake te despierta como alarma de respaldo en tu iPhone."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake äratab sind iPhone’is varuäratusena."
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake-k ordezko alarma gisa esnatzen zaitu iPhone-an."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake به‌عنوان زنگ هشدار پشتیبان روی iPhone بیدارت می‌کند."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake herättää sinut varahälytyksenä iPhonellasi."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ginigising ka ng Phase Wake bilang backup na alarm sa iPhone mo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake te réveille comme alarme de secours sur ton iPhone."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Dúisíonn Phase Wake thú mar aláram cúltaca ar d’iPhone."
          }
        },
        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake espértate como alarma de reserva no iPhone."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake તમને iPhone પર બેકઅપ એલાર્મ તરીકે જગાડે છે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "‏Phase Wake מעיר אותך כשעון מעורר גיבוי ב-iPhone."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake तुम्हारे iPhone पर बैकअप अलार्म के रूप में तुम्हें जगाता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake te budi kao rezervni alarm na iPhoneu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Phase Wake tartalék ébresztőként ébreszt fel az iPhone-odon."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake-ը քեզ արթնացնում է iPhone-ում՝ որպես պահուստային զարթուցիչ։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake membangunkanmu sebagai alarm cadangan di iPhone-mu."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake vekur þig sem varavekjari á iPhone."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake ti sveglia come sveglia di riserva su iPhone."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wakeは、iPhoneのバックアップアラームとしてあなたを起こします。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake გაღვიძებს iPhone-ზე, როგორც სარეზერვო მაღვიძარა."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake сені iPhone-да қосалқы оятқыш ретінде оятады."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake ដាស់អ្នកជាម៉ោងរោទ៍បម្រុងលើ iPhone របស់អ្នក។"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake ನಿಮ್ಮ iPhone ನಲ್ಲಿ ಬ್ಯಾಕಪ್ ಅಲಾರಾಂ ಆಗಿ ನಿಮ್ಮನ್ನು ಎಬ್ಬಿಸುತ್ತದೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake는 iPhone의 백업 알람으로 너를 깨웁니다."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake ປຸກເຈົ້າເປັນໂມງປຸກສຳຮອງໃນ iPhone ຂອງເຈົ້າ"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake pažadina tave kaip atsarginis žadintuvas tavo iPhone."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake tevi pamodina kā rezerves modinātājs tavā iPhone."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake те буди како резервен аларм на iPhone."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake നിങ്ങളുടെ iPhone-ൽ ബാക്കപ്പ് അലാറമായി ഉണർത്തുന്നു."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake чамайг iPhone дээр нөөц сэрүүлгээр сэрээнэ."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake तुम्हाला iPhone वर बॅकअप अलार्म म्हणून उठवते."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake mengejutkanmu sebagai penggera sandaran pada iPhone-mu."
          }
        },
        "my": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake သည် သင့် iPhone ပေါ်တွင် အရန်နှိုးစက်အဖြစ် နှိုးပေးသည်။"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake vekker deg som reservealarm på iPhonen din."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake ले तिमीलाई iPhone मा ब्याकअप अलार्मको रूपमा ब्युँझाउँछ।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake maakt je wakker als back-upwekker op je iPhone."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake ਤੁਹਾਨੂੰ iPhone ’ਤੇ ਬੈਕਅੱਪ ਅਲਾਰਮ ਵਜੋਂ ਜਗਾਉਂਦਾ ਹੈ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake budzi cię jako zapasowy budzik na iPhonie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Phase Wake acorda você como alarme de reserva no seu iPhone."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O Phase Wake acorda-te como alarme de reserva no teu iPhone."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake te trezește ca alarmă de rezervă pe iPhone-ul tău."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake будит тебя как резервный будильник на iPhone."
          }
        },
        "si": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake ඔබව iPhone හි උපස්ථ එලාමයක් ලෙස අවදි කරයි."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake ťa zobudí ako záložný budík v iPhone."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake te zbudi kot rezervna budilka na iPhonu."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake të zgjon si alarm rezervë në iPhone."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake те буди као резервни аларм на iPhone-у."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake väcker dig som reservlarm på din iPhone."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake inakuamsha kama kengele ya akiba kwenye iPhone yako."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake உங்கள் iPhone இல் மாற்று அலாரமாக உங்களை எழுப்பும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake మిమ్మల్ని iPhoneలో బ్యాకప్ అలారంగా లేపుతుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake ปลุกคุณเป็นนาฬิกาปลุกสำรองบน iPhone"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake, iPhone'unda yedek alarm olarak seni uyandırır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake будить тебе як резервний будильник на iPhone."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake تمہارے iPhone پر بیک اپ الارم کے طور پر تمہیں جگاتا ہے۔"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake seni iPhoneʼda zaxira budilnik sifatida uygʻotadi."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake đánh thức bạn như một báo thức dự phòng trên iPhone."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake 會在你的 iPhone 上作為備用鬧鐘叫醒你。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake会在你的 iPhone 上作为备用闹钟唤醒你。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake會在你的 iPhone 上作為備用鬧鐘喚醒你。"
          }
        },
        "zu": {
          "stringUnit": {
            "state": "translated",
            "value": "I-Phase Wake ikuvusa njenge-alamu yokwesekwa ku-iPhone yakho."
          }
        }
      }
    },
    "NSFaceIDUsageDescription": {
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake vra vir Face ID voordat jou geskiedenis uitgevee of jou data vervang word."
          }
        },
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake ታሪክዎን ከመሰረዙ ወይም ውሂብዎን ከመተካቱ በፊት Face ID ይጠይቃል።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يطلب Phase Wake استخدام Face ID قبل حذف سجلك أو استبدال بياناتك."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Tarixçən silinməzdən və ya məlumatların əvəz edilməzdən əvvəl Phase Wake Face ID istəyir."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake иска Face ID, преди историята ти да бъде изтрита или данните ти – заменени."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "তোমার ইতিহাস মোছার বা তোমার ডেটা প্রতিস্থাপনের আগে Phase Wake Face ID চায়।"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake traži Face ID prije brisanja tvoje historije ili zamjene tvojih podataka."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake et demana Face ID abans de suprimir l’historial o substituir les teves dades."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake si vyžádá Face ID, než smaže tvou historii nebo nahradí tvoje data."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake beder om Face ID, før din historik slettes, eller dine data erstattes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake fragt nach Face ID, bevor dein Verlauf gelöscht oder deine Daten ersetzt werden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Phase Wake ζητά Face ID πριν διαγραφεί το ιστορικό σου ή αντικατασταθούν τα δεδομένα σου."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake te pide Face ID antes de borrar tu historial o reemplazar tus datos."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake küsib Face ID-d, enne kui su ajalugu kustutatakse või andmed asendatakse."
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake-k Face ID eskatzen du zure historia ezabatu edo zure datuak ordeztu aurretik."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake پیش از حذف تاریخچه یا جایگزینی داده‌هایت Face ID را درخواست می‌کند."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake pyytää Face ID:tä ennen kuin historiasi poistetaan tai tietosi korvataan."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Humihingi ang Phase Wake ng Face ID bago i-delete ang kasaysayan mo o palitan ang data mo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake demande Face ID avant de supprimer ton historique ou de remplacer tes données."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Iarrann Phase Wake Face ID sula scriostar do stair nó sula n-athsholáthraítear do chuid sonraí."
          }
        },
        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake pide Face ID antes de eliminar o teu historial ou substituír os teus datos."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તમારો ઇતિહાસ કાઢી નાખતાં કે તમારો ડેટા બદલતાં પહેલાં Phase Wake Face ID માગે છે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "‏Phase Wake מבקש Face ID לפני מחיקת ההיסטוריה שלך או החלפת הנתונים שלך."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "तुम्हारा इतिहास हटाने या तुम्हारा डेटा बदलने से पहले Phase Wake Face ID माँगता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake traži Face ID prije brisanja tvoje povijesti ili zamjene tvojih podataka."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Phase Wake Face ID-t kér, mielőtt törölné az előzményeidet vagy lecserélné az adataidat."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake-ը Face ID է խնդրում՝ նախքան պատմությունդ ջնջելը կամ տվյալներդ փոխարինելը։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake meminta Face ID sebelum riwayatmu dihapus atau datamu diganti."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake biður um Face ID áður en ferlinum þínum er eytt eða gögnunum þínum skipt út."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake chiede Face ID prima di eliminare la tua cronologia o sostituire i tuoi dati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wakeは、履歴を削除したりデータを置き換えたりする前にFace IDを求めます。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake ითხოვს Face ID-ს, სანამ შენი ისტორია წაიშლება ან მონაცემები ჩანაცვლდება."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тарихыңды жою немесе деректеріңді ауыстыру алдында Phase Wake Face ID сұрайды."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake សុំ Face ID មុនពេលលុបប្រវត្តិ ឬជំនួសទិន្នន័យរបស់អ្នក។"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನಿಮ್ಮ ಇತಿಹಾಸ ಅಳಿಸುವ ಅಥವಾ ಡೇಟಾ ಬದಲಿಸುವ ಮೊದಲು Phase Wake Face ID ಕೇಳುತ್ತದೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake는 기록을 삭제하거나 데이터를 바꾸기 전에 Face ID를 요청합니다."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake ຂໍ Face ID ກ່ອນລຶບປະຫວັດ ຫຼື ແທນທີ່ຂໍ້ມູນຂອງເຈົ້າ"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake paprašo Face ID prieš ištrinant tavo istoriją ar pakeičiant tavo duomenis."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake pieprasa Face ID, pirms tiek dzēsta tava vēsture vai aizstāti tavi dati."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake бара Face ID пред да се избрише твојата историја или да се заменат твоите податоци."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ചരിത്രം ഇല്ലാതാക്കുന്നതിനോ ഡാറ്റ മാറ്റിസ്ഥാപിക്കുന്നതിനോ മുമ്പ് Phase Wake Face ID ചോദിക്കും."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Түүхийг чинь устгах эсвэл өгөгдлийг чинь солихоос өмнө Phase Wake Face ID асууна."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुमचा इतिहास हटवण्यापूर्वी किंवा तुमचा डेटा बदलण्यापूर्वी Phase Wake Face ID मागते."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake meminta Face ID sebelum sejarahmu dipadam atau datamu diganti."
          }
        },
        "my": {
          "stringUnit": {
            "state": "translated",
            "value": "မှတ်တမ်း ဖျက်ခြင်း သို့မဟုတ် ဒေတာ အစားထိုးခြင်း မပြုမီ Phase Wake က Face ID တောင်းသည်။"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake ber om Face ID før historikken din slettes eller dataene dine erstattes."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "तिम्रो इतिहास मेटाउनु वा डेटा बदल्नुअघि Phase Wake ले Face ID माग्छ।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake vraagt om Face ID voordat je geschiedenis wordt verwijderd of je gegevens worden vervangen."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਤੁਹਾਡਾ ਇਤਿਹਾਸ ਮਿਟਾਉਣ ਜਾਂ ਤੁਹਾਡਾ ਡਾਟਾ ਬਦਲਣ ਤੋਂ ਪਹਿਲਾਂ Phase Wake Face ID ਮੰਗਦਾ ਹੈ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake prosi o Face ID, zanim usunie twoją historię lub zastąpi twoje dane."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Phase Wake pede o Face ID antes de apagar seu histórico ou substituir seus dados."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O Phase Wake pede o Face ID antes de apagar o teu histórico ou substituir os teus dados."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake îți cere Face ID înainte de a-ți șterge istoricul sau de a-ți înlocui datele."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake запрашивает Face ID, прежде чем удалить твою историю или заменить твои данные."
          }
        },
        "si": {
          "stringUnit": {
            "state": "translated",
            "value": "ඔබේ ඉතිහාසය මැකීමට හෝ දත්ත ප්‍රතිස්ථාපනයට පෙර Phase Wake Face ID ඉල්ලයි."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake si vyžiada Face ID, než sa vymaže tvoja história alebo nahradia tvoje údaje."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake zahteva Face ID, preden se zgodovina izbriše ali se tvoji podatki zamenjajo."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake kërkon Face ID para se të fshihet historiku yt ose të zëvendësohen të dhënat e tua."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake тражи Face ID пре брисања твоје историје или замене твојих података."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake ber om Face ID innan din historik raderas eller dina data ersätts."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake inaomba Face ID kabla historia yako haijafutwa au data yako kubadilishwa."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் வரலாற்றை நீக்கும் முன் அல்லது உங்கள் தரவை மாற்றும் முன் Phase Wake Face ID ஐக் கேட்கும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ చరిత్రను తొలగించే ముందు లేదా మీ డేటాను మార్చే ముందు Phase Wake Face ID అడుగుతుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake จะขอ Face ID ก่อนลบประวัติหรือแทนที่ข้อมูลของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake, geçmişin silinmeden veya verilerin değiştirilmeden önce Face ID ister."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake запитує Face ID, перш ніж видалити твою історію або замінити твої дані."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "تمہارا تاریخچہ حذف کرنے یا تمہارا ڈیٹا تبدیل کرنے سے پہلے Phase Wake، Face ID مانگتا ہے۔"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Tarixing oʻchirilishi yoki maʼlumotlaring almashtirilishidan oldin Phase Wake Face ID soʻraydi."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake yêu cầu Face ID trước khi xóa lịch sử hoặc thay thế dữ liệu của bạn."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake 會在刪除你的記錄或取代你的資料前要求 Face ID。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake会在删除你的记录或替换你的数据前请求Face ID。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake會在刪除你的紀錄或取代你的資料前要求Face ID。"
          }
        },
        "zu": {
          "stringUnit": {
            "state": "translated",
            "value": "I-Phase Wake icela i-Face ID ngaphambi kokuthi umlando wakho ususwe noma idatha yakho ishintshwe."
          }
        }
      }
    },
    "NSHealthShareUsageDescription": {
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake lees jou slaapdata om dit in jou geskiedenis te wys en die oomblik na te gaan waarop jy wakker gemaak is. Dit lees net, en die data bly op jou iPhone."
          }
        },
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake የእንቅልፍ ውሂብዎን በታሪክዎ ውስጥ ለማሳየትና የተቀሰቀሱበትን ቅጽበት ለማረጋገጥ ያነባል። ያነባል ብቻ፣ ውሂቡም በiPhoneዎ ላይ ይቆያል።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يقرأ Phase Wake بيانات نومك لعرضها في سجلك وللتحقق من لحظة إيقاظك. يقرأ فقط، وتبقى البيانات على iPhone الخاص بك."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake yuxu məlumatlarını tarixçəndə göstərmək və oyadıldığın anı yoxlamaq üçün oxuyur. Yalnız oxuyur, məlumatlar isə iPhone-unda qalır."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake чете данните за съня ти, за да ги покаже в историята ти и да провери момента на събуждането ти. Само чете, а данните остават на твоя iPhone."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "তোমার ইতিহাসে দেখাতে এবং তোমাকে জাগানোর মুহূর্তটি যাচাই করতে Phase Wake তোমার ঘুমের ডেটা পড়ে। এটি শুধু পড়ে, আর ডেটা তোমার iPhone-এই থাকে।"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake čita tvoje podatke o snu da bi ih prikazao u tvojoj historiji i provjerio trenutak tvog buđenja. Samo čita, a podaci ostaju na tvom iPhoneu."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake llegeix les teves dades de son per mostrar-les al teu historial i comprovar el moment en què t’ha despertat. Només les llegeix, i les dades es queden al teu iPhone."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake čte tvoje data o spánku, aby je zobrazil v tvé historii a zkontroloval okamžik, kdy tě vzbudil. Data jen čte a zůstávají v tvém iPhonu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake læser dine søvndata for at vise dem i din historik og tjekke det øjeblik, du blev vækket. Den læser kun, og dataene bliver på din iPhone."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake liest deine Schlafdaten, um sie in deinem Verlauf zu zeigen und den Weckmoment zu prüfen. Phase Wake liest nur, und die Daten bleiben auf deinem iPhone."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Phase Wake διαβάζει τα δεδομένα ύπνου σου για να τα δείχνει στο ιστορικό σου και να ελέγχει τη στιγμή που σε ξύπνησε. Μόνο διαβάζει, και τα δεδομένα μένουν στο iPhone σου."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake lee tus datos de sueño para mostrarlos en tu historial y comprobar el momento en que te despertó. Solo los lee, y los datos se quedan en tu iPhone."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake loeb sinu uneandmeid, et näidata neid sinu ajaloos ja kontrollida äratamise hetke. See ainult loeb ja andmed jäävad sinu iPhone’i."
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake-k zure lo-datuak irakurtzen ditu, zure historian erakusteko eta esnatu zaituen unea egiaztatzeko. Irakurri bakarrik egiten du, eta datuak zure iPhonean geratzen dira."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake داده‌های خوابت را می‌خواند تا آن‌ها را در تاریخچه‌ات نشان دهد و لحظهٔ بیدار کردنت را بررسی کند. فقط می‌خواند و داده‌ها روی iPhone تو می‌مانند."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake lukee unitietosi näyttääkseen ne historiassasi ja tarkistaakseen herätyshetken. Se vain lukee, ja tiedot pysyvät iPhonessasi."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Binabasa ng Phase Wake ang sleep data mo para ipakita ito sa kasaysayan mo at tingnan ang sandali ng paggising sa iyo. Nagbabasa lang ito, at nananatili ang data sa iPhone mo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake lit tes données de sommeil pour les afficher dans ton historique et vérifier le moment de ton réveil. Il les lit seulement, et les données restent sur ton iPhone."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Léann Phase Wake do shonraí codlata chun iad a thaispeáint i do stair agus chun an nóiméad ar dúisíodh thú a sheiceáil. Ní dhéanann sé ach léamh, agus fanann na sonraí ar do iPhone."
          }
        },
        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake le os teus datos de sono para mostralos no teu historial e comprobar o momento en que te espertou. Só os le, e os datos quedan no teu iPhone."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તમારા ઇતિહાસમાં બતાવવા અને તમને જગાડવાની ક્ષણ તપાસવા માટે Phase Wake તમારો ઊંઘનો ડેટા વાંચે છે. તે ફક્ત વાંચે છે, અને ડેટા તમારા iPhone પર જ રહે છે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "‏Phase Wake קורא את נתוני השינה שלך כדי להציג אותם בהיסטוריה שלך ולבדוק את רגע ההשכמה. הוא רק קורא, והנתונים נשארים ב-iPhone שלך."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake तुम्हारा नींद का डेटा पढ़ता है, ताकि उसे तुम्हारे इतिहास में दिखा सके और तुम्हें जगाने का पल जाँच सके। यह सिर्फ़ पढ़ता है, और डेटा तुम्हारे iPhone पर ही रहता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake čita tvoje podatke o snu kako bi ih prikazao u tvojoj povijesti i provjerio trenutak tvog buđenja. Samo čita, a podaci ostaju na tvom iPhoneu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Phase Wake beolvassa az alvási adataidat, hogy megjelenítse őket az előzményeidben, és ellenőrizze az ébresztés pillanatát. Csak olvas, az adatok pedig az iPhone-odon maradnak."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake-ը կարդում է քնի տվյալներդ՝ դրանք քո պատմության մեջ ցույց տալու և քեզ արթնացնելու պահը ստուգելու համար։ Այն միայն կարդում է, և տվյալները մնում են քո iPhone-ում։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake membaca data tidurmu untuk menampilkannya di riwayatmu dan memeriksa saat kamu dibangunkan. Phase Wake hanya membaca, dan datanya tetap di iPhone-mu."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake les svefngögnin þín til að sýna þau í ferlinum þínum og athuga vakningarstundina. Það les bara, og gögnin haldast á iPhone-símanum þínum."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake legge i tuoi dati sul sonno per mostrarli nella tua cronologia e verificare il momento del risveglio. Li legge soltanto, e i dati restano sul tuo iPhone."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wakeは、睡眠データを読み取って履歴に表示し、起こしたタイミングを確認します。読み取りのみで、データはiPhoneの中に保存されたままです。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake კითხულობს შენი ძილის მონაცემებს, რათა აჩვენოს ისინი შენს ისტორიაში და შეამოწმოს გაღვიძების მომენტი. ის მხოლოდ კითხულობს და მონაცემები შენს iPhone-ზე რჩება."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake ұйқы деректеріңді тарихыңда көрсету және сені ояту сәтін тексеру үшін оқиды. Ол тек оқиды, деректер iPhone-ыңда қалады."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake អានទិន្នន័យដំណេករបស់អ្នក ដើម្បីបង្ហាញវាក្នុងប្រវត្តិរបស់អ្នក និងពិនិត្យពេលដែលអ្នកត្រូវបានដាស់។ វាគ្រាន់តែអាន ហើយទិន្នន័យនៅតែលើ iPhone របស់អ្នក។"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನಿಮ್ಮ ಇತಿಹಾಸದಲ್ಲಿ ತೋರಿಸಲು ಮತ್ತು ನಿಮ್ಮನ್ನು ಎಬ್ಬಿಸಿದ ಕ್ಷಣವನ್ನು ಪರಿಶೀಲಿಸಲು Phase Wake ನಿಮ್ಮ ನಿದ್ರೆಯ ಡೇಟಾವನ್ನು ಓದುತ್ತದೆ. ಅದು ಓದುತ್ತದೆ ಮಾತ್ರ, ಡೇಟಾ ನಿಮ್ಮ iPhone ನಲ್ಲೇ ಉಳಿಯುತ್ತದೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake는 수면 데이터를 읽어 기록에 표시하고 깨운 시점을 확인합니다. 읽기만 하며, 데이터는 iPhone에 그대로 남습니다."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake ອ່ານຂໍ້ມູນການນອນຂອງເຈົ້າ ເພື່ອສະແດງໃນປະຫວັດຂອງເຈົ້າ ແລະ ກວດເວລາທີ່ເຈົ້າຖືກປຸກ ມັນອ່ານຢ່າງດຽວ ແລະ ຂໍ້ມູນຍັງຢູ່ໃນ iPhone ຂອງເຈົ້າ"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake nuskaito tavo miego duomenis, kad parodytų juos tavo istorijoje ir patikrintų, kuriuo momentu tave pažadino. Jis tik skaito, o duomenys lieka tavo iPhone."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake nolasa tavus miega datus, lai parādītu tos tavā vēsturē un pārbaudītu pamodināšanas brīdi. Tā tikai lasa, un dati paliek tavā iPhone."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake ги чита твоите податоци за сон за да ги прикаже во твојата историја и да го провери мигот на будењето. Само чита, а податоците остануваат на твојот iPhone."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങളുടെ ചരിത്രത്തിൽ കാണിക്കാനും നിങ്ങളെ ഉണർത്തിയ നിമിഷം പരിശോധിക്കാനും Phase Wake നിങ്ങളുടെ ഉറക്ക ഡാറ്റ വായിക്കും. അത് വായിക്കുക മാത്രം ചെയ്യും, ഡാറ്റ നിങ്ങളുടെ iPhone-ൽ തന്നെ തുടരും."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake нойрны өгөгдлийг чинь түүхэнд чинь харуулах, чамайг сэрээсэн мөчийг шалгахын тулд уншина. Зөвхөн уншина, өгөгдөл iPhone дээр чинь үлдэнэ."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुमच्या इतिहासात दाखवण्यासाठी आणि तुम्हाला उठवण्याचा क्षण तपासण्यासाठी Phase Wake तुमचा झोपेचा डेटा वाचते. ते फक्त वाचते, आणि डेटा तुमच्या iPhone वरच राहतो."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake membaca data tidurmu untuk memaparkannya dalam sejarahmu dan menyemak saat kamu dikejutkan. Ia hanya membaca, dan data kekal pada iPhone kamu."
          }
        },
        "my": {
          "stringUnit": {
            "state": "translated",
            "value": "သင့်မှတ်တမ်းတွင် ပြရန်နှင့် သင့်ကို နှိုးခဲ့သည့်အချိန်ကို စစ်ဆေးရန် Phase Wake က သင့်အိပ်စက်မှုဒေတာကို ဖတ်သည်။ ဖတ်ရုံသာဖတ်ပြီး ဒေတာသည် သင့် iPhone ပေါ်တွင်သာ ရှိနေမည်။"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake leser søvndataene dine for å vise dem i historikken din og sjekke øyeblikket du ble vekket. Den leser bare, og dataene blir værende på iPhonen din."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "तिम्रो इतिहासमा देखाउन र तिमीलाई ब्युँझाएको क्षण जाँच्न Phase Wake ले तिम्रो निद्राको डेटा पढ्छ। यसले पढ्छ मात्र, र डेटा तिम्रो iPhone मै रहन्छ।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake leest je slaapgegevens om ze in je geschiedenis te tonen en het moment te controleren waarop je bent gewekt. Phase Wake leest alleen, en de gegevens blijven op je iPhone."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਤੁਹਾਡੇ ਇਤਿਹਾਸ ਵਿੱਚ ਦਿਖਾਉਣ ਅਤੇ ਤੁਹਾਨੂੰ ਜਗਾਉਣ ਦਾ ਪਲ ਜਾਂਚਣ ਲਈ Phase Wake ਤੁਹਾਡਾ ਨੀਂਦ ਦਾ ਡਾਟਾ ਪੜ੍ਹਦਾ ਹੈ। ਇਹ ਸਿਰਫ਼ ਪੜ੍ਹਦਾ ਹੈ, ਅਤੇ ਡਾਟਾ ਤੁਹਾਡੇ iPhone ’ਤੇ ਹੀ ਰਹਿੰਦਾ ਹੈ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake odczytuje twoje dane o śnie, aby pokazać je w twojej historii i sprawdzić moment, w którym cię obudził. Tylko czyta, a dane zostają na twoim iPhonie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Phase Wake lê seus dados de sono para mostrá-los no seu histórico e verificar o momento do seu despertar. Ele só lê, e os dados ficam no seu iPhone."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O Phase Wake lê os teus dados de sono para os mostrar no teu histórico e verificar o momento do teu despertar. Só lê, e os dados ficam no teu iPhone."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake citește datele tale de somn pentru a le afișa în istoricul tău și a verifica momentul trezirii. Doar citește, iar datele rămân pe iPhone-ul tău."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake считывает твои данные о сне, чтобы показать их в твоей истории и проверить момент пробуждения. Он только читает, а данные остаются на твоём iPhone."
          }
        },
        "si": {
          "stringUnit": {
            "state": "translated",
            "value": "ඔබේ ඉතිහාසයේ පෙන්වීමට සහ ඔබව අවදි කළ මොහොත පරීක්ෂා කිරීමට Phase Wake ඔබේ නින්දේ දත්ත කියවයි. එය කියවන්නේ පමණක් වන අතර දත්ත ඔබේ iPhone හි පවතී."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake číta tvoje údaje o spánku, aby ich zobrazil v tvojej histórii a overil okamih, keď ťa zobudil. Iba číta a údaje zostávajú v tvojom iPhone."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake prebere tvoje podatke o spanju, da jih prikaže v tvoji zgodovini in preveri trenutek bujenja. Samo bere, podatki pa ostanejo na tvojem iPhonu."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake lexon të dhënat e tua të gjumit për t’i shfaqur në historikun tënd dhe për të kontrolluar momentin e zgjimit. Vetëm lexon, dhe të dhënat mbeten në iPhone-in tënd."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake чита твоје податке о сну да би их приказао у твојој историји и проверио тренутак твог буђења. Само чита, а подаци остају на твом iPhone-у."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake läser dina sömndata för att visa dem i din historik och kontrollera ögonblicket då du väcktes. Den läser bara, och datan stannar på din iPhone."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake husoma data yako ya usingizi ili kuionyesha kwenye historia yako na kuangalia wakati ulipoamshwa. Inasoma tu, na data inabaki kwenye iPhone yako."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் வரலாற்றில் காட்டவும், உங்களை எழுப்பிய தருணத்தைச் சரிபார்க்கவும் Phase Wake உங்கள் தூக்கத் தரவைப் படிக்கும். அது படிக்க மட்டுமே செய்யும், தரவு உங்கள் iPhone-இலேயே இருக்கும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ చరిత్రలో చూపడానికి, మిమ్మల్ని లేపిన క్షణాన్ని తనిఖీ చేయడానికి Phase Wake మీ నిద్ర డేటాను చదువుతుంది. ఇది చదువుతుంది మాత్రమే, డేటా మీ iPhoneలోనే ఉంటుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake อ่านข้อมูลการนอนของคุณเพื่อแสดงในประวัติของคุณและตรวจสอบช่วงเวลาที่ปลุกคุณ โดยอ่านอย่างเดียว และข้อมูลจะอยู่ใน iPhone ของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake, uyku verilerini geçmişinde göstermek ve uyandırıldığın anı kontrol etmek için okur. Yalnızca okur ve veriler iPhone’unda kalır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake зчитує твої дані про сон, щоб показати їх у твоїй історії й перевірити момент пробудження. Він лише читає, а дані залишаються на твоєму iPhone."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake تمہاری نیند کا ڈیٹا پڑھتا ہے تاکہ اسے تمہارے تاریخچے میں دکھا سکے اور تمہیں جگانے کا لمحہ جانچ سکے۔ یہ صرف پڑھتا ہے، اور ڈیٹا تمہارے iPhone پر ہی رہتا ہے۔"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake uyqu maʼlumotlaringni tarixingda koʻrsatish va seni uygʻotish paytini tekshirish uchun oʻqiydi. U faqat oʻqiydi, maʼlumotlar esa iPhone’ingda qoladi."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake đọc dữ liệu giấc ngủ của bạn để hiển thị trong lịch sử và kiểm tra thời điểm bạn được đánh thức. Ứng dụng chỉ đọc, và dữ liệu vẫn nằm trên iPhone của bạn."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake 會讀取你的睡眠數據，以便在記錄中顯示，並檢查叫醒你的時刻。Phase Wake 只會讀取，數據會留在你的 iPhone 上。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake会读取你的睡眠数据，以便在记录中显示，并检查叫醒你的时刻。Phase Wake只读取，数据会留在你的iPhone上。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake會讀取你的睡眠資料，以便在紀錄中顯示，並檢查叫醒你的時刻。Phase Wake只讀取，資料會留在你的iPhone上。"
          }
        },
        "zu": {
          "stringUnit": {
            "state": "translated",
            "value": "I-Phase Wake ifunda idatha yakho yokulala ukuze iyibonise emlandweni wakho futhi ihlole isikhathi owavuswa ngaso. Iyafunda kuphela, futhi idatha ihlala ku-iPhone yakho."
          }
        }
      }
    },
    "NSMicrophoneUsageDescription": {
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "As jy dit aanskakel, neem Phase Wake snags kort snitte van snork en praat in jou slaap op. Hulle bly op jou iPhone en word ná 7 dae uitgevee."
          }
        },
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "ካበሩት፣ Phase Wake ማታ የማንኮራፋትና በእንቅልፍ የማውራት አጫጭር ቅንጥቦችን ይቀዳል። በiPhoneዎ ላይ ይቆያሉ እና ከ7 ቀናት በኋላ ይሰረዛሉ።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يسجّل Phase Wake ليلاً مقاطع قصيرة من الشخير والكلام أثناء النوم إذا فعّلت ذلك. تبقى على iPhone وتُحذف بعد 7 أيام."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Açsan, Phase Wake gecə xoruldama və yuxuda danışmanın qısa kliplərini yazır. Onlar iPhone-unda qalır və 7 gündən sonra silinir."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ако го включиш, Phase Wake записва нощем кратки откъси от хъркане и говорене насън. Те остават на твоя iPhone и се изтриват след 7 дни."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "তুমি চালু করলে Phase Wake রাতে নাক ডাকা আর ঘুমের মধ্যে কথা বলার ছোট ক্লিপ রেকর্ড করে। এগুলো তোমার iPhone-এই থাকে আর ৭ দিন পরে মুছে যায়।"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ako to uključiš, Phase Wake noću snima kratke isječke hrkanja i govora u snu. Ostaju na tvom iPhoneu i brišu se nakon 7 dana."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Si ho actives, Phase Wake enregistra a la nit fragments curts de roncs i de parlar en somnis. Es queden al teu iPhone i se suprimeixen al cap de 7 dies."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake v noci nahrává krátké úryvky chrápání a mluvení ze spaní, pokud to zapneš. Zůstanou v tvém iPhonu a po 7 dnech se smažou."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake optager korte klip af snorken og søvnsnak om natten, hvis du slår det til. De bliver på din iPhone og slettes efter 7 dage."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake nimmt nachts kurze Ausschnitte von Schnarchen und Sprechen im Schlaf auf, wenn du es einschaltest. Sie bleiben auf deinem iPhone und werden nach 7 Tagen gelöscht."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Phase Wake ηχογραφεί τη νύχτα σύντομα αποσπάσματα από ροχαλητό και ομιλία στον ύπνο, αν το ενεργοποιήσεις. Μένουν στο iPhone σου και διαγράφονται μετά από 7 ημέρες."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake graba por la noche fragmentos cortos de ronquidos y de hablar en sueños si lo activas. Se quedan en tu iPhone y se borran después de 7 días."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kui lülitad selle sisse, salvestab Phase Wake öösel lühikesi klippe norskamisest ja unes rääkimisest. Need jäävad sinu iPhone’i ja kustutatakse 7 päeva pärast."
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktibatzen baduzu, Phase Wake-k zurrungaren eta loan hitz egitearen klip laburrak grabatzen ditu gauez. Zure iPhone-an geratzen dira eta 7 egunen ondoren ezabatzen dira."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "اگر روشنش کنی، Phase Wake شب‌ها تکه‌های کوتاهی از خروپف و حرف زدن در خواب ضبط می‌کند. آن‌ها روی iPhone تو می‌مانند و پس از ۷ روز پاک می‌شوند."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake nauhoittaa öisin lyhyitä pätkiä kuorsauksesta ja unissa puhumisesta, jos otat sen käyttöön. Ne pysyvät iPhonessasi ja poistetaan 7 päivän kuluttua."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Kung io-on mo ito, magre-record ang Phase Wake ng maiikling clip ng hilik at pagsasalita habang tulog sa gabi. Nananatili ang mga ito sa iPhone mo at dine-delete pagkalipas ng 7 araw."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si tu l’actives, Phase Wake enregistre la nuit de courts extraits de ronflements et de paroles pendant le sommeil. Ils restent sur ton iPhone et sont supprimés après 7 jours."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Má chuireann tú ar siúl é, taifeadann Phase Wake gearrthóga gearra de shrannadh agus de chaint i do chodladh san oíche. Fanann siad ar d’iPhone agus scriostar iad tar éis 7 lá."
          }
        },
        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "Se o activas, Phase Wake grava pola noite fragmentos curtos de roncos e de falar en soños. Quedan no teu iPhone e elimínanse despois de 7 días."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તમે ચાલુ કરો તો Phase Wake રાત્રે નસકોરાં અને ઊંઘમાં બોલવાની ટૂંકી ક્લિપ રેકોર્ડ કરે છે. તે તમારા iPhone પર જ રહે છે અને 7 દિવસ પછી કાઢી નખાય છે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אם תפעיל את זה, Phase Wake מקליט בלילה קטעים קצרים של נחירות ודיבור מתוך שינה. הם נשארים ב-iPhone שלך ונמחקים אחרי 7 ימים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अगर तुम इसे चालू करो, तो Phase Wake रात में खर्राटों और नींद में बोलने के छोटे अंश रिकॉर्ड करता है। ये तुम्हारे iPhone पर ही रहते हैं और 7 दिन बाद मिटा दिए जाते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ako to uključiš, Phase Wake noću snima kratke isječke hrkanja i govora u snu. Ostaju na tvom iPhoneu i brišu se nakon 7 dana."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ha bekapcsolod, a Phase Wake éjjel rövid részleteket rögzít a horkolásról és az alvás közbeni beszédről. Ezek az iPhone-odon maradnak, és 7 nap után törlődnek."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Եթե միացնես, Phase Wake-ը գիշերը ձայնագրում է խռմփոցի և քնի մեջ խոսքի կարճ հատվածներ։ Դրանք մնում են iPhone-իդ վրա և ջնջվում են 7 օր հետո։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jika kamu menyalakannya, Phase Wake merekam potongan pendek dengkuran dan mengigau di malam hari. Rekaman tetap di iPhone-mu dan dihapus setelah 7 hari."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Ef þú kveikir á því tekur Phase Wake upp stuttar upptökur af hrotum og svefntali á nóttunni. Þær verða eftir á iPhone og er eytt eftir 7 daga."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se lo attivi, Phase Wake registra di notte brevi estratti di russamento e di parole nel sonno. Restano sul tuo iPhone e vengono eliminati dopo 7 giorni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オンにすると、Phase Wake は夜間のいびきや寝言を短く録音します。録音は iPhone に保存され、7日後に削除されます。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "თუ ჩართავ, Phase Wake ღამით ჩაწერს ხვრინვისა და ძილში ლაპარაკის მოკლე ფრაგმენტებს. ისინი რჩება შენს iPhone-ზე და 7 დღის შემდეგ იშლება."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Қоссаң, Phase Wake түнде қорылдау мен ұйқыдағы сөйлеудің қысқа үзінділерін жазады. Олар iPhone-ыңда қалады және 7 күннен кейін жойылады."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "បើអ្នកបើកវា Phase Wake ថតឃ្លីបខ្លីៗនៃការស្រមុក និងការនិយាយពេលដេកនៅពេលយប់។ វានៅលើ iPhone របស់អ្នក ហើយត្រូវលុបក្រោយ 7 ថ្ងៃ។"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನೀವು ಆನ್ ಮಾಡಿದರೆ, Phase Wake ರಾತ್ರಿ ಗೊರಕೆ ಮತ್ತು ನಿದ್ರೆಯಲ್ಲಿ ಮಾತನಾಡುವುದರ ಚಿಕ್ಕ ಕ್ಲಿಪ್‌ಗಳನ್ನು ರೆಕಾರ್ಡ್ ಮಾಡುತ್ತದೆ. ಅವು ನಿಮ್ಮ iPhone ನಲ್ಲೇ ಇರುತ್ತವೆ ಮತ್ತು 7 ದಿನಗಳ ನಂತರ ಅಳಿಸಲಾಗುತ್ತವೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "켜 두면 Phase Wake가 밤에 코골이와 잠꼬대를 짧게 녹음해. 녹음은 iPhone에만 남고 7일 후에 삭제돼."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ຖ້າເຈົ້າເປີດໃຊ້ Phase Wake ຈະບັນທຶກຄລິບສັ້ນໆຂອງສຽງກົນ ແລະ ການລະເມີໃນຕອນກາງຄືນ ຄລິບຢູ່ໃນ iPhone ຂອງເຈົ້າ ແລະ ຖືກລຶບຫຼັງ 7 ມື້"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Jei tai įjungsi, Phase Wake naktį įrašo trumpus knarkimo ir kalbėjimo per miegus fragmentus. Jie lieka tavo iPhone ir ištrinami po 7 dienų."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ja to ieslēgsi, Phase Wake naktī ieraksta īsus krākšanas un runāšanas miegā fragmentus. Tie paliek tavā iPhone un tiek dzēsti pēc 7 dienām."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ако го вклучиш, Phase Wake ноќе снима кратки снимки од хркање и зборување во сон. Остануваат на твојот iPhone и се бришат по 7 дена."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങൾ ഓണാക്കിയാൽ, രാത്രിയിൽ കൂർക്കംവലിയുടെയും ഉറക്കത്തിലെ സംസാരത്തിന്റെയും ചെറിയ ക്ലിപ്പുകൾ Phase Wake റെക്കോർഡ് ചെയ്യും. അവ iPhone-ൽ തന്നെ ഇരിക്കും, 7 ദിവസത്തിനു ശേഷം ഇല്ലാതാകും."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Чи асаавал Phase Wake шөнө хурхиралт, нойрондоо ярихын богино хэсгийг бичнэ. Тэдгээр нь iPhone дээр чинь үлдэж, 7 хоногийн дараа устна."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुम्ही चालू केल्यास Phase Wake रात्री घोरण्याच्या आणि झोपेत बोलण्याच्या छोट्या क्लिप रेकॉर्ड करते. त्या तुमच्या iPhone वरच राहतात आणि ७ दिवसांनी हटवल्या जातात."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Jika kamu menghidupkannya, Phase Wake merakam klip pendek dengkuran dan bercakap semasa tidur pada waktu malam. Klip kekal pada iPhone kamu dan dipadam selepas 7 hari."
          }
        },
        "my": {
          "stringUnit": {
            "state": "translated",
            "value": "ဖွင့်ထားလျှင် Phase Wake သည် ညဘက် ဟောက်သံနှင့် အိပ်ယောင်စကားပြောသံ အတိုလေးများကို မှတ်တမ်းတင်သည်။ ၎င်းတို့သည် သင့် iPhone ပေါ်တွင်သာ ရှိပြီး 7 ရက်အကြာတွင် ဖျက်သည်။"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake tar opp korte klipp av snorking og søvnprat om natten hvis du slår det på. De blir på iPhonen din og slettes etter 7 dager."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "तिमीले अन गरेमा, Phase Wake ले राति घुर्ने र निद्रामा बोल्ने छोटा क्लिप रेकर्ड गर्छ। यी तिम्रो iPhone मै रहन्छन् र ७ दिनपछि मेटिन्छन्।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake neemt ’s nachts korte fragmenten van snurken en praten in je slaap op als je dit aanzet. Ze blijven op je iPhone en worden na 7 dagen verwijderd."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਜੇ ਤੁਸੀਂ ਚਾਲੂ ਕਰੋ, ਤਾਂ Phase Wake ਰਾਤ ਨੂੰ ਘੁਰਾੜਿਆਂ ਅਤੇ ਨੀਂਦ ਵਿੱਚ ਬੋਲਣ ਦੀਆਂ ਛੋਟੀਆਂ ਕਲਿੱਪਾਂ ਰਿਕਾਰਡ ਕਰਦਾ ਹੈ। ਇਹ ਤੁਹਾਡੇ iPhone ’ਤੇ ਹੀ ਰਹਿੰਦੀਆਂ ਹਨ ਅਤੇ 7 ਦਿਨਾਂ ਬਾਅਦ ਮਿਟ ਜਾਂਦੀਆਂ ਹਨ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeśli to włączysz, Phase Wake nagrywa w nocy krótkie fragmenty chrapania i mówienia przez sen. Zostają na twoim iPhonie i są usuwane po 7 dniach."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Se você ativar, o Phase Wake grava à noite trechos curtos de ronco e de fala durante o sono. Eles ficam no seu iPhone e são apagados após 7 dias."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Se ativares, o Phase Wake grava à noite excertos curtos de ressonar e de falar a dormir. Ficam no teu iPhone e são apagados ao fim de 7 dias."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Dacă activezi asta, Phase Wake înregistrează noaptea fragmente scurte de sforăit și vorbit prin somn. Rămân pe iPhone-ul tău și sunt șterse după 7 zile."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если ты включишь эту функцию, Phase Wake будет ночью записывать короткие фрагменты храпа и разговоров во сне. Они остаются на твоём iPhone и удаляются через 7 дней."
          }
        },
        "si": {
          "stringUnit": {
            "state": "translated",
            "value": "ඔබ සක්‍රිය කළහොත්, Phase Wake රාත්‍රියේ ගොරවීමේ සහ නින්දේ කතා කිරීමේ කෙටි කොටස් පටිගත කරයි. ඒවා ඔබේ iPhone හි පවතින අතර දින 7 කට පසු මැකේ."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ak to zapneš, Phase Wake v noci nahrá krátke záznamy chrápania a rozprávania zo spánku. Zostávajú v tvojom iPhone a po 7 dňoch sa vymažú."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake ponoči posname kratke posnetke smrčanja in govorjenja v spanju, če to vklopiš. Ostanejo na tvojem iPhonu in se po 7 dneh izbrišejo."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Nëse e aktivizon, Phase Wake regjistron natën fragmente të shkurtra të gërhitjes dhe të të folurit në gjumë. Ato mbeten në iPhone dhe fshihen pas 7 ditësh."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ако то укључиш, Phase Wake ноћу снима кратке исечке хркања и говора у сну. Остају на твом iPhone-у и бришу се после 7 дана."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake spelar in korta klipp av snarkning och sömnprat på natten om du slår på det. De stannar på din iPhone och raderas efter 7 dagar."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Ukiwasha, Phase Wake hurekodi vipande vifupi vya kukoroma na kuongea usingizini usiku. Vinabaki kwenye iPhone yako na hufutwa baada ya siku 7."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நீங்கள் ஆன் செய்தால், Phase Wake இரவில் குறட்டை, தூக்கத்தில் பேசுதல் ஆகியவற்றின் சிறு கிளிப்புகளைப் பதிவுசெய்யும். அவை உங்கள் iPhone இலேயே இருக்கும், 7 நாட்களுக்குப் பிறகு நீக்கப்படும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీరు ఆన్ చేస్తే, Phase Wake రాత్రి గురక, నిద్రలో మాట్లాడటం చిన్న క్లిప్‌లుగా రికార్డ్ చేస్తుంది. అవి మీ iPhoneలోనే ఉంటాయి, 7 రోజుల తర్వాత తొలగిపోతాయి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หากเปิดใช้ Phase Wake จะบันทึกเสียงกรนและการละเมอพูดช่วงสั้นๆ ในตอนกลางคืน คลิปจะอยู่บน iPhone ของคุณเท่านั้นและจะถูกลบหลังจาก 7 วัน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Açarsan Phase Wake geceleri horlama ve uykuda konuşmadan kısa kesitler kaydeder. Bunlar iPhone’unda kalır ve 7 gün sonra silinir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Якщо ти це ввімкнеш, Phase Wake уночі записуватиме короткі фрагменти хропіння та розмов уві сні. Вони залишаються на твоєму iPhone і видаляються через 7 днів."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اگر تم اسے آن کرو تو Phase Wake رات کو خراٹوں اور نیند میں باتیں کرنے کے چھوٹے کلپس ریکارڈ کرتا ہے۔ یہ تمہارے iPhone پر رہتے ہیں اور 7 دن بعد حذف ہو جاتے ہیں۔"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Yoqsang, Phase Wake tunda xurrak va uyqudagi gaplarning qisqa parchalarini yozadi. Ular iPhoneʼingda qoladi va 7 kundan keyin oʻchiriladi."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nếu bạn bật, Phase Wake sẽ ghi lại các đoạn ngắn tiếng ngáy và nói mớ vào ban đêm. Chúng chỉ lưu trên iPhone của bạn và bị xóa sau 7 ngày."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟後，Phase Wake 會在晚上錄下打鼾和說夢話的短片段。片段只會留在你的 iPhone 上，7 日後刪除。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开启后，Phase Wake 会在夜间录下打鼾和说梦话的简短片段。片段只保存在你的 iPhone 上，7 天后自动删除。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟後，Phase Wake 會在夜間錄下打鼾和說夢話的簡短片段。片段只保存在你的 iPhone 上，7 天後自動刪除。"
          }
        },
        "zu": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma ukuvula, i-Phase Wake iqopha iziqeshana ezimfushane zokuhona nokukhuluma ebuthongweni ebusuku. Zihlala ku-iPhone yakho futhi zisuswa ngemva kwezinsuku ezi-7."
          }
        }
      }
    }
  },
  "version": "1.0"
}
