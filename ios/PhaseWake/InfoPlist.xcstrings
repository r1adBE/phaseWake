        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake ອ່ານໄລຍະການນອນຂອງເຈົ້າຫຼັງຕື່ນ ເພື່ອກວດວ່າເຈົ້າຖືກປຸກຕອນຫຼັບຕື້ນຫຼືບໍ່"
          }
        },
        "lt": {
          "stringUnit": {
