    "NSHealthShareUsageDescription": {
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake lees ná die wakker word jou slaapfases om na te gaan of jy in ligte slaap wakker gemaak is."
          }
        },
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake በቀላል እንቅልፍ ላይ ሳሉ መቀስቀስዎን ለማረጋገጥ ከነቁ በኋላ የእንቅልፍ ደረጃዎችዎን ያነባል።"
