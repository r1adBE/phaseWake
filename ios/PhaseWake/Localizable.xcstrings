    "check_dnd": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عدم الإزعاج يسمح بالمنبهات"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Režim Nerušit propouští budíky"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Forstyr ikke lader alarmer igennem"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "«Nicht stören» lässt Wecker durch"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το «Μην ενοχλείτε» επιτρέπει ξυπνητήρια"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Do Not Disturb lets alarms through"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No molestar deja pasar las alarmas"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "مزاحم نشوید، زنگ‌ها را عبور می‌دهد"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Älä häiritse päästää herätykset läpi"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne pas déranger laisse passer les alarmes"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "״נא לא להפריע״ מאפשר שעונים מעוררים"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "डू नॉट डिस्टर्ब में अलार्म की अनुमति है"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Ne zavarjanak átengedi az ébresztőket"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jangan Ganggu meloloskan alarm"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non disturbare lascia passare le sveglie"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "おやすみモード中もアラームが鳴ります"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "방해 금지 모드에서도 알람이 울려요"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Jangan Ganggu membenarkan penggera"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ikke forstyrr slipper gjennom alarmer"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Niet storen laat wekkers door"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie przeszkadzać przepuszcza budziki"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não perturbe deixa os alarmes passarem"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não incomodar deixa passar os alarmes"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nu deranja lasă alarmele să treacă"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Режим «Не беспокоить» пропускает будильники"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Stör ej släpper igenom alarm"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โหมดห้ามรบกวนยังให้นาฬิกาปลุกดังได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rahatsız Etme alarmların çalmasına izin veriyor"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Режим «Не турбувати» пропускає будильники"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chế độ Không làm phiền vẫn cho báo thức kêu"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "勿扰模式允许闹钟"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "勿擾模式允許鬧鐘"
          }
        }
