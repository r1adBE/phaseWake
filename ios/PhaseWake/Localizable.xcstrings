      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يرنّ على هاتفك مع ساعتك."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zvoní v telefonu spolu s hodinkami."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ringer på telefonen sammen med uret."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Klingelt auf dem Handy zusammen mit der Uhr."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Χτυπά στο κινητό μαζί με το ρολόι σου."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rings on your phone together with your watch."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Suena en tu móvil junto con tu reloj."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "هم‌زمان با ساعتت روی گوشی هم زنگ می‌خورد."
