    "editor_advice_text": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "في %1$lld من آخر %2$lld ليالٍ لم يظهر نوم خفيف ضمن النافذة. مع %3$lld دقيقة تزداد فرص الاستيقاظ في لحظة مناسبة."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "V %1$lld z posledních %2$lld nocí se v okně neobjevil žádný lehký spánek. S %3$lld min se budeš častěji budit ve vhodnou chvíli."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "I %1$lld af de seneste %2$lld nætter var der ingen let søvn i vinduet. Med %3$lld min vågner du oftere på et godt tidspunkt."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In %1$lld der letzten %2$lld Nächte kam kein leichter Schlaf ins Fenster. Mit %3$lld Min erwischst du öfter einen guten Moment."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Σε %1$lld από τις τελευταίες %2$lld νύχτες δεν υπήρχε ελαφρύς ύπνος στο παράθυρο. Με %3$lld λεπτά θα ξυπνάς πιο συχνά την κατάλληλη στιγμή."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In %1$lld of the last %2$lld nights there was no light sleep in the window. With %3$lld min you’ll more often wake at a good moment."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En %1$lld de las últimas %2$lld noches no hubo sueño ligero dentro de la ventana. Con %3$lld min te despertarás más a menudo en un buen momento."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "در %1$lld شب از %2$lld شب اخیر، در بازه خواب سبک نبود. با %3$lld دقیقه بیشتر در لحظه‌ای مناسب بیدار می‌شوی."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld viimeisestä %2$lld yöstä ikkunassa ei ollut kevyttä unta. Kun ikkuna on %3$lld min, heräät useammin hyvällä hetkellä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dans %1$lld des %2$lld dernières nuits, il n'y avait pas de sommeil léger dans la fenêtre. Avec %3$lld min, tu te réveilleras plus souvent au bon moment."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ב-%1$lld מתוך %2$lld הלילות האחרונים לא הייתה שינה קלה בחלון. עם %3$lld דק׳ יהיו יותר התעוררויות ברגע טוב."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पिछली %2$lld रातों में से %1$lld रातों में विंडो के दौरान हल्की नींद नहीं आई। %3$lld मिनट से तुम अक्सर सही समय पर जागोगे।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az utolsó %2$lld éjszakából %1$lld alkalommal nem volt könnyű alvás az ablakban. %3$lld perccel gyakrabban ébredsz jó pillanatban."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pada %1$lld dari %2$lld malam terakhir, tidak ada tidur ringan di dalam jendela. Dengan %3$lld mnt, kamu lebih sering bangun di saat yang tepat."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In %1$lld delle ultime %2$lld notti non c'era sonno leggero nella finestra. Con %3$lld min ti sveglierai più spesso al momento giusto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "直近 %2$lld 日のうち %1$lld 日は、ウィンドウ内に浅い眠りがありませんでした。%3$lld 分にすると、よりよいタイミングで起きやすくなります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "최근 %2$lld일 중 %1$lld일은 구간 안에 얕은 잠이 없었어요. %3$lld분으로 하면 좋은 타이밍에 깰 가능성이 높아져요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Dalam %1$lld daripada %2$lld malam terakhir, tiada tidur ringan dalam tetingkap. Dengan %3$lld min, kamu lebih kerap bangun pada saat yang sesuai."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "I %1$lld av de siste %2$lld nettene var det ingen lett søvn i vinduet. Med %3$lld min våkner du oftere på et godt tidspunkt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "In %1$lld van de laatste %2$lld nachten zat er geen lichte slaap in het venster. Met %3$lld min word je vaker op een goed moment wakker."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "W %1$lld z ostatnich %2$lld nocy w oknie nie było lekkiego snu. Przy %3$lld min częściej obudzisz się w dobrym momencie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Em %1$lld das últimas %2$lld noites não houve sono leve na janela. Com %3$lld min, você vai acordar mais vezes em um bom momento."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Em %1$lld das últimas %2$lld noites não houve sono leve na janela. Com %3$lld min, vais acordar mais vezes num bom momento."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "În %1$lld din ultimele %2$lld nopți nu a fost somn ușor în fereastră. Cu %3$lld min te vei trezi mai des într-un moment bun."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В %1$lld из последних %2$lld ночей в окне не было лёгкого сна. С %3$lld мин ты чаще будешь просыпаться в удачный момент."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Under %1$lld av de senaste %2$lld nätterna fanns ingen lätt sömn i fönstret. Med %3$lld min vaknar du oftare vid ett bra tillfälle."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใน %1$lld จาก %2$lld คืนล่าสุด ไม่มีช่วงหลับตื้นในช่วงเวลาปลุก หากตั้งเป็น %3$lld นาที จะตื่นในจังหวะที่ดีได้บ่อยขึ้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Son %2$lld gecenin %1$lld tanesinde aralıkta hafif uyku yoktu. %3$lld dk ile daha sık uygun bir anda uyanırsın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "У %1$lld з останніх %2$lld ночей у вікні не було легкого сну. З %3$lld хв ти частіше прокидатимешся у слушний момент."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trong %1$lld trong %2$lld đêm gần nhất, khung giờ không có giấc ngủ nhẹ. Với %3$lld phút, bạn sẽ thức dậy đúng lúc thường xuyên hơn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在最近 %2$lld 个夜晚中，有 %1$lld 个夜晚窗口内没有浅睡。设为 %3$lld 分钟，你会更容易在合适的时刻醒来。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在最近 %2$lld 個夜晚中，有 %1$lld 個夜晚視窗內沒有淺眠。設為 %3$lld 分鐘，你會更容易在合適的時刻醒來。"
          }
        }
      }
    },
