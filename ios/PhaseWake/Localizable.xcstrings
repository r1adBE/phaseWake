    "settings_clear_history_text": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحذف كل الليالي المسجّلة على هاتفك وساعتك. تبقى منبّهاتك كما هي."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Smaže všechny zaznamenané noci v telefonu a hodinkách. Tvoje budíky zůstanou."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Sletter alle optagede nætter på din telefon og dit ur. Dine alarmer bliver."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Löscht alle aufgezeichneten Nächte auf Handy und Uhr. Deine Wecker bleiben."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Διαγράφει όλες τις καταγεγραμμένες νύχτες στο κινητό και στο ρολόι σου. Τα ξυπνητήρια σου παραμένουν."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Deletes all recorded nights on your phone and watch. Your alarms stay."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Borra todas las noches registradas en tu móvil y tu reloj. Tus alarmas se mantienen."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "همه شب‌های ثبت‌شده در گوشی و ساعتت پاک می‌شود. زنگ‌های هشدارت می‌مانند."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Poistaa kaikki tallennetut yöt puhelimesta ja kellosta. Herätyksesi säilyvät."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Efface toutes les nuits enregistrées sur ton téléphone et ta montre. Tes alarmes restent."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מחיקת כל הלילות שהוקלטו בטלפון ובשעון. המעוררים שלך נשארים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फ़ोन और वॉच पर रिकॉर्ड की गई सभी रातें हट जाएँगी। तुम्हारे अलार्म बने रहेंगे।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Törli az összes rögzített éjszakát a telefonodon és az órádon. Az ébresztőid megmaradnak."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menghapus semua malam yang tercatat di ponsel dan jam tanganmu. Alarmmu tetap ada."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimina tutte le notti registrate su telefono e orologio. Le tue sveglie restano."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スマホとウォッチに記録されたすべての夜のデータを削除します。アラームはそのまま残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "휴대폰과 워치에 기록된 모든 밤 데이터를 삭제해요. 알람은 그대로 유지돼요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Memadam semua malam yang direkodkan pada telefon dan jam tanganmu. Penggera kekal."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Sletter alle registrerte netter på telefonen og klokka. Alarmene dine blir værende."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wist alle opgenomen nachten op je telefoon en horloge. Je wekkers blijven."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Usuwa wszystkie zapisane noce na telefonie i zegarku. Twoje budziki zostają."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Apaga todas as noites registradas no seu celular e no relógio. Seus alarmes continuam."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Apaga todas as noites registadas no teu telemóvel e no relógio. Os teus alarmes mantêm-se."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Șterge toate nopțile înregistrate pe telefon și pe ceas. Alarmele tale rămân."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удаляет все записанные ночи на телефоне и часах. Твои будильники останутся."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Raderar alla registrerade nätter på telefonen och klockan. Dina alarm finns kvar."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลบข้อมูลทุกคืนที่บันทึกไว้บนโทรศัพท์และนาฬิกา การปลุกของคุณจะยังอยู่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Telefonundaki ve saatindeki tüm kayıtlı geceleri siler. Alarmların kalır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Видаляє всі записані ночі на телефоні та годиннику. Твої будильники залишаться."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xóa mọi đêm đã ghi trên điện thoại và đồng hồ của bạn. Báo thức của bạn vẫn được giữ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将删除手机和手表上记录的所有夜晚数据。你的闹钟会保留。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將刪除手機和手錶上記錄的所有夜晚資料。你的鬧鐘會保留。"
          }
        }
      }
    },
