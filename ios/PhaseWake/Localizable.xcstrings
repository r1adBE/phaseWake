    "check_exact_alarms_problem": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اسمح بالمنبهات والتذكيرات ليرنّ المنبه الاحتياطي في الوقت المحدد."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Povol budíky a připomenutí, aby záložní budík zazvonil včas."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tillad alarmer og påmindelser, så reservealarmen ringer til tiden."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erlaube «Wecker und Erinnerungen», damit der Zweitwecker pünktlich klingelt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επίτρεψε τα ξυπνητήρια και τις υπενθυμίσεις, ώστε το εφεδρικό ξυπνητήρι να χτυπά στην ώρα του."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow alarms & reminders so the backup alarm rings on time."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite alarmas y recordatorios para que la alarma de respaldo suene a tiempo."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "زنگ‌ها و یادآوری‌ها را مجاز کن تا زنگ پشتیبان سر وقت به صدا درآید."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Salli herätykset ja muistutukset, jotta varaherätys soi ajallaan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorise les alarmes et rappels pour que l’alarme de secours sonne à l’heure."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אשרו שעונים מעוררים ותזכורות כדי שהשעון המעורר הגיבוי יצלצל בזמן."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अलार्म और रिमाइंडर की अनुमति दें ताकि बैकअप अलार्म समय पर बजे।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Engedélyezd az ébresztéseket és emlékeztetőket, hogy a tartalék ébresztés pontosan szóljon."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Izinkan alarm & pengingat agar alarm cadangan berbunyi tepat waktu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Consenti sveglie e promemoria perché la sveglia di riserva suoni puntuale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "予備のアラームが時間どおりに鳴るよう、「アラームとリマインダー」を許可してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보조 알람이 제시간에 울리도록 알람 및 리마인더를 허용해 주세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Benarkan penggera & peringatan supaya penggera sandaran berbunyi tepat pada masanya."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Tillat alarmer og påminnelser slik at reservealarmen ringer i tide."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sta wekkers en herinneringen toe zodat de reservewekker op tijd afgaat."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zezwól na alarmy i przypomnienia, aby zapasowy budzik zadzwonił na czas."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Permita alarmes e lembretes para que o alarme reserva toque na hora certa."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite alarmes e lembretes para que o alarme de reserva toque à hora certa."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite alarmele și mementourile pentru ca alarma de rezervă să sune la timp."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разреши будильники и напоминания, чтобы резервный будильник звонил вовремя."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tillåt alarm och påminnelser så att reservalarmet ringer i tid."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อนุญาตการปลุกและการช่วยเตือนเพื่อให้นาฬิกาปลุกสำรองดังตรงเวลา"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yedek alarmın zamanında çalması için alarmlara ve hatırlatıcılara izin ver."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дозволь будильники й нагадування, щоб резервний будильник дзвонив вчасно."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy cho phép báo thức và lời nhắc để báo thức dự phòng reo đúng giờ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请允许“闹钟和提醒”，这样备用闹钟才能准时响起。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請允許「鬧鐘與提醒」，這樣備用鬧鐘才能準時響起。"
          }
        }
      }
    },
