    "dnd_text": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اسمحوا بالمنبّهات في وضع عدم الإزعاج، وإلا سيبقى هاتفك صامتًا."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Povol budíky v režimu Nerušit, jinak bude telefon zticha."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tillad alarmer i Forstyr ikke, ellers forbliver din telefon stille."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erlaube Wecker bei «Nicht stören», sonst bleibt dein Handy still."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επίτρεψε ξυπνητήρια στο «Μην ενοχλείτε», αλλιώς το κινητό σου θα μένει σιωπηλό."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow alarms in Do Not Disturb, otherwise your phone stays silent."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite las alarmas en No molestar; si no, tu móvil seguirá en silencio."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "در حالت «مزاحم نشو» اجازهٔ زنگ بده، وگرنه گوشی‌ات ساکت می‌ماند."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Salli herätykset Älä häiritse -tilassa, muuten puhelimesi pysyy hiljaa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorise les alarmes dans Ne pas déranger, sinon ton téléphone reste silencieux."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אפשרו מעוררים במצב ‘נא לא להפריע’, אחרת הטלפון יישאר שקט."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "डू नॉट डिस्टर्ब में अलार्म की अनुमति दो, वरना फ़ोन चुप रहेगा।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Engedélyezd az ébresztőket Ne zavarjanak módban, különben a telefonod néma marad."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Izinkan alarm saat Jangan Ganggu, kalau tidak ponselmu tetap senyap."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Consenti le sveglie in Non disturbare, altrimenti il telefono resta muto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サイレントモード中もアラームを許可してください。許可しないとスマートフォンは鳴りません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "방해 금지 모드에서 알람을 허용해 주세요. 그렇지 않으면 휴대폰이 울리지 않아요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Benarkan penggera dalam Jangan Ganggu, jika tidak telefon awak kekal senyap."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Tillat alarmer i Ikke forstyrr, ellers blir telefonen stille."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sta wekkers toe bij Niet storen, anders blijft je telefoon stil."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zezwól na budziki w trybie Nie przeszkadzać, inaczej telefon będzie milczał."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Permita alarmes no Não perturbe; senão seu celular fica em silêncio."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite alarmes em Não incomodar; caso contrário, o telemóvel fica em silêncio."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite alarmele în modul Nu deranja, altfel telefonul tău rămâne mut."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разреши будильники в режиме «Не беспокоить», иначе телефон будет молчать."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tillåt larm i Stör ej, annars förblir mobilen tyst."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อนุญาตให้นาฬิกาปลุกดังในโหมดห้ามรบกวน มิฉะนั้นโทรศัพท์จะเงียบ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rahatsız Etme'de alarmlara izin ver, yoksa telefonun sessiz kalır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дозволь будильники в режимі «Не турбувати», інакше телефон мовчатиме."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy cho phép báo thức trong chế độ Không làm phiền, nếu không điện thoại sẽ im lặng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在勿扰模式下允许闹钟，否则手机不会响铃。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請在勿擾模式下允許鬧鐘，否則手機不會響鈴。"
          }
        }
      }
    },
    "dnd_title": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عدم الإزعاج يحجب المنبّهات"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nerušit blokuje budíky"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Forstyr ikke blokerer alarmer"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "«Nicht stören» blockiert Wecker"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το «Μην ενοχλείτε» μπλοκάρει ξυπνητήρια"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Do Not Disturb blocks alarms"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No molestar bloquea las alarmas"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "«مزاحم نشو» زنگ‌ها را مسدود می‌کند"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Älä häiritse estää herätykset"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne pas déranger bloque les alarmes"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "‘נא לא להפריע’ חוסם מעוררים"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "डू नॉट डिस्टर्ब अलार्म रोक रहा है"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Ne zavarjanak letiltja az ébresztőket"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jangan Ganggu memblokir alarm"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non disturbare blocca le sveglie"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サイレントモードがアラームを妨げています"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "방해 금지 모드가 알람을 막고 있어요"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Jangan Ganggu menyekat penggera"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ikke forstyrr blokkerer alarmer"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Niet storen blokkeert wekkers"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie przeszkadzać blokuje budziki"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não perturbe bloqueia alarmes"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não incomodar bloqueia alarmes"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nu deranja blochează alarmele"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«Не беспокоить» блокирует будильники"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Stör ej blockerar larm"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โหมดห้ามรบกวนบล็อกนาฬิกาปลุก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rahatsız Etme alarmları engelliyor"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "«Не турбувати» блокує будильники"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không làm phiền đang chặn báo thức"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "勿扰模式拦截了闹钟"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "勿擾模式封鎖了鬧鐘"
          }
        }
      }
    },
