          "stringUnit": {
            "state": "translated",
            "value": "מגמות מופיעות אחרי כמה לילות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कुछ रातों के बाद रुझान दिखेंगे।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A trendek néhány éjszaka után jelennek meg."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
