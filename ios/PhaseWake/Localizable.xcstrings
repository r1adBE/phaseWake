    "channel_sunrise_description": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يضيء شاشتك مثل شروق الشمس قبل أن تستيقظ."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Rozsvítí displej jako východ slunce, než se probudíš."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tænder skærmen som en solopgang, før du vågner."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lässt den Bildschirm vor dem Wecken wie einen Sonnenaufgang leuchten."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Φωτίζει την οθόνη σου σαν ανατολή ηλίου πριν ξυπνήσεις."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lights up your screen like a sunrise before you wake."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ilumina tu pantalla como un amanecer antes de despertarte."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "پیش از بیدار شدنت، صفحه را مثل طلوع خورشید روشن می‌کند."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Valaisee näytön kuin auringonnousun ennen heräämistäsi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Illumine ton écran comme un lever de soleil avant ton réveil."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מאיר את המסך כמו זריחה לפני שתתעוררו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जगाने से पहले आपकी स्क्रीन को सूर्योदय की तरह रोशन करता है।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Napfelkeltéhez hasonlóan világítja meg a képernyőt ébredés előtt."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menyalakan layar seperti matahari terbit sebelum kamu bangun."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Illumina lo schermo come un’alba prima che ti svegli."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "起きる前に、日の出のように画面を明るくします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "깨우기 전에 화면을 일출처럼 밝혀요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Menyalakan skrin seperti matahari terbit sebelum awak bangun."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Lyser opp skjermen som en soloppgang før du våkner."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Laat je scherm oplichten als een zonsopgang voordat je wakker wordt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rozjaśnia ekran jak wschód słońca, zanim się obudzisz."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ilumina sua tela como um nascer do sol antes de você acordar."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ilumina o ecrã como um nascer do sol antes de acordares."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Luminează ecranul ca un răsărit înainte să te trezești."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подсвечивает экран, как рассвет, перед твоим пробуждением."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tänder skärmen som en soluppgång innan du vaknar."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทำให้หน้าจอสว่างเหมือนพระอาทิตย์ขึ้นก่อนที่คุณจะตื่น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sen uyanmadan önce ekranı gün doğumu gibi aydınlatır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Підсвічує екран, як світанок, перш ніж ти прокинешся."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Làm sáng màn hình như bình minh trước khi bạn thức dậy."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在你醒来前，让屏幕像日出一样亮起。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在你醒來前，讓螢幕像日出一樣亮起。"
          }
        }
      }
    },
