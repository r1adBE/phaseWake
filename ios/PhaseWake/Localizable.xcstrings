    "home_permission_text": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحتاج Phase Wake إلى الإشعارات والتنبيهات بملء الشاشة لإيقاظك."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake potřebuje oznámení a upozornění na celou obrazovku, aby tě vzbudil."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake skal bruge notifikationer og fuldskærmsadvarsler for at vække dig."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake braucht Mitteilungen und Vollbild-Hinweise, um dich zu wecken."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Phase Wake χρειάζεται ειδοποιήσεις και ειδοποιήσεις πλήρους οθόνης για να σε ξυπνήσει."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake needs notifications and full-screen alerts to wake you."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake necesita notificaciones y avisos a pantalla completa para despertarte."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake برای بیدار کردنت به اعلان و هشدار تمام‌صفحه نیاز دارد."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake tarvitsee ilmoitukset ja koko näytön hälytykset herättääkseen sinut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake a besoin des notifications et des alertes plein écran pour te réveiller."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כדי להעיר אתכם, Phase Wake צריכה התראות והתראות במסך מלא."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "तुम्हें जगाने के लिए Phase Wake को नोटिफ़िकेशन और फ़ुल-स्क्रीन अलर्ट चाहिए।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Phase Wake-nek értesítésekre és teljes képernyős riasztásokra van szüksége az ébresztéshez."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake butuh notifikasi dan peringatan layar penuh untuk membangunkanmu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake ha bisogno delle notifiche e degli avvisi a schermo intero per svegliarti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wakeが起こすには、通知と全画面表示の許可が必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake가 깨워 드리려면 알림과 전체 화면 알림 권한이 필요해요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake perlukan pemberitahuan dan makluman skrin penuh untuk bangunkan awak."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake trenger varsler og fullskjermsvarsler for å vekke deg."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake heeft meldingen en schermvullende waarschuwingen nodig om je te wekken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake potrzebuje powiadomień i alertów na pełnym ekranie, żeby cię obudzić."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Phase Wake precisa de notificações e alertas em tela cheia para acordar você."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O Phase Wake precisa de notificações e de alertas em ecrã inteiro para te acordar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake are nevoie de notificări și alerte pe tot ecranul ca să te trezească."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake нужны уведомления и полноэкранные оповещения, чтобы разбудить тебя."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake behöver aviseringar och helskärmsvarningar för att väcka dig."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake ต้องใช้การแจ้งเตือนและการแจ้งเตือนแบบเต็มหน้าจอเพื่อปลุกคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake'in seni uyandırabilmesi için bildirimlere ve tam ekran uyarılara ihtiyacı var."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake потрібні сповіщення та повноекранні сповіщення, щоб тебе розбудити."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake cần quyền thông báo và thông báo toàn màn hình để đánh thức bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake 需要通知和全屏提醒权限才能叫醒你。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake 需要通知和全螢幕提醒權限才能叫醒你。"
          }
        }
      }
    },
