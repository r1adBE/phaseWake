    "history_empty_text": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بعد أول ليلة مع الساعة، سيظهر هنا وقت إيقاظك وسببه."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Po první noci s hodinkami tu uvidíš, kdy a proč tě vzbudily."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Efter din første nat med uret kan du her se, hvornår og hvorfor det vækkede dig."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nach der ersten Nacht mit der Uhr siehst du hier, wann und warum sie dich geweckt hat."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μετά την πρώτη νύχτα με το ρολόι θα βλέπεις εδώ πότε και γιατί σε ξύπνησε."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After your first night with the watch, you’ll see when and why it woke you."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tras tu primera noche con el reloj verás aquí cuándo y por qué te despertó."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "بعد از اولین شب با ساعت، اینجا می‌بینی کِی و چرا بیدارت کرده."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ensimmäisen kellon kanssa nukutun yön jälkeen näet täällä, milloin ja miksi se herätti sinut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Après ta première nuit avec la montre, tu verras ici quand et pourquoi elle t'a réveillé."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אחרי הלילה הראשון עם השעון תראו כאן מתי ולמה הוא העיר אתכם."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "घड़ी के साथ पहली रात के बाद यहाँ दिखेगा कि घड़ी ने कब और क्यों जगाया।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az első, órával töltött éjszaka után itt látod, mikor és miért ébresztett az óra."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Setelah malam pertama dengan jam tangan, kamu akan melihat kapan dan mengapa jam membangunkanmu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dopo la tua prima notte con lo smartwatch vedrai qui quando e perché ti ha svegliato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ウォッチで最初の夜を過ごすと、いつ、なぜ起こしたかがここに表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "워치와 함께 첫 밤을 보내면 언제, 왜 깨웠는지 여기에 표시돼요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Selepas malam pertama bersama jam tangan, awak akan nampak bila dan mengapa ia bangunkan awak."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Etter den første natten med klokka ser du her når og hvorfor den vekket deg."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Na je eerste nacht met het horloge zie je hier wanneer en waarom het je wekte."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Po pierwszej nocy z zegarkiem zobaczysz tu, kiedy i dlaczego cię obudził."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Depois da sua primeira noite com o relógio, você verá aqui quando e por que ele acordou você."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Depois da tua primeira noite com o relógio, vais ver aqui quando e porquê te acordou."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "După prima noapte cu ceasul vei vedea aici când și de ce te-a trezit."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "После первой ночи с часами здесь появится, когда и почему они тебя разбудили."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Efter din första natt med klockan ser du här när och varför den väckte dig."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หลังคืนแรกที่ใช้นาฬิกา คุณจะเห็นที่นี่ว่าถูกปลุกเมื่อไรและเพราะอะไร"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saatle ilk gecenden sonra seni ne zaman ve neden uyandırdığını burada görürsün."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Після першої ночі з годинником тут буде видно, коли і чому він тебе розбудив."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sau đêm đầu tiên dùng đồng hồ, bạn sẽ thấy ở đây thời điểm và lý do bạn được đánh thức."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "戴着手表睡完第一晚后，你就能在这里看到何时、为何被叫醒。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "戴著手錶睡完第一晚後，就能在這裡看到何時、為何被叫醒。"
          }
        }
      }
    },
