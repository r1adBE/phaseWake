    "check_alarmkit_problem": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اسمح لـ Phase Wake بضبط المنبهات ليتمكن الـ iPhone من الرنين كمنبه احتياطي."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Povol Phase Wake nastavovat budíky, aby tvůj iPhone mohl zazvonit jako záložní budík."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tillad Phase Wake at indstille alarmer, så din iPhone kan ringe som backup-alarm."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erlaube Phase Wake Wecker, damit dein iPhone als Zweitwecker klingeln kann."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επίτρεψε στο Phase Wake να ορίζει ξυπνητήρια, ώστε το iPhone σου να χτυπά ως εφεδρικό ξυπνητήρι."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow Phase Wake to set alarms so your iPhone can ring as a backup alarm."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite que Phase Wake programe alarmas para que tu iPhone pueda sonar como alarma de respaldo."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "به Phase Wake اجازه بده زنگ تنظیم کند تا iPhone بتواند به‌عنوان زنگ پشتیبان زنگ بزند."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Salli Phase Waken asettaa herätyksiä, jotta iPhonesi voi soida varaherätyksenä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorise Phase Wake à programmer des alarmes pour que ton iPhone puisse sonner comme alarme de secours."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אשרו ל-Phase Wake להגדיר שעונים מעוררים, כדי שה-iPhone שלכם יוכל לצלצל כשעון גיבוי."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake को अलार्म सेट करने की अनुमति दें ताकि आपका iPhone बैकअप अलार्म के रूप में बज सके।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Engedélyezd a Phase Wake-nek az ébresztők beállítását, hogy az iPhone-od tartalék ébresztőként megszólalhasson."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Izinkan Phase Wake mengatur alarm agar iPhone-mu bisa berbunyi sebagai alarm cadangan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Consenti a Phase Wake di impostare sveglie, così il tuo iPhone può suonare come sveglia di riserva."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhoneがバックアップのアラームを鳴らせるよう、Phase Wakeにアラームの設定を許可してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone이 예비 알람으로 울릴 수 있도록 Phase Wake에 알람 설정을 허용해 주세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Benarkan Phase Wake menetapkan penggera supaya iPhone awak boleh berdering sebagai penggera sandaran."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Tillat Phase Wake å stille alarmer slik at iPhone kan ringe som reservealarm."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sta Phase Wake toe wekkers in te stellen zodat je iPhone als back-upwekker kan overgaan."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zezwól Phase Wake na ustawianie budzików, aby iPhone mógł zadzwonić jako zapasowy budzik."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Permita que o Phase Wake defina alarmes para que seu iPhone possa tocar como alarme reserva."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite que o Phase Wake defina alarmes para que o teu iPhone possa tocar como alarme de reserva."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite Phase Wake să seteze alarme pentru ca iPhone-ul tău să poată suna ca alarmă de rezervă."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разреши Phase Wake ставить будильники, чтобы iPhone мог зазвонить как резервный будильник."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tillåt Phase Wake att ställa alarm så att din iPhone kan ringa som reservalarm."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อนุญาตให้ Phase Wake ตั้งการปลุก เพื่อให้ iPhone ของคุณส่งเสียงเป็นนาฬิกาปลุกสำรองได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone’un yedek alarm olarak çalabilmesi için Phase Wake’in alarm kurmasına izin ver."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дозволь Phase Wake ставити будильники, щоб iPhone міг задзвонити як резервний будильник."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy cho phép Phase Wake đặt báo thức để iPhone của bạn có thể reo làm báo thức dự phòng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请允许 Phase Wake 设置闹钟，这样你的 iPhone 可以作为备用闹钟响铃。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請允許 Phase Wake 設定鬧鐘，這樣你的 iPhone 可以作為備用鬧鐘響鈴。"
          }
        }
      }
    },
