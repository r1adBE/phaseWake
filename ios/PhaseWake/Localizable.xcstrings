    "editor_sunrise_hint": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تبدأ الشاشة بتوهج برتقالي خافت ثم تتحول إلى ضوء دافئ ساطع بأقصى سطوع. ضع الهاتف والشاشة للأعلى."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Displej nejdřív slabě zoranží a pak přejde v jasné, teplé světlo na plný jas. Polož telefon displejem nahoru."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Skærmen starter med et svagt orange skær og bliver til klart, varmt lys ved fuld lysstyrke. Læg telefonen med skærmen opad."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Bildschirm leuchtet erst schwach orange und wird dann zu hellem, warmem Licht bei voller Helligkeit. Leg das Handy mit dem Bildschirm nach oben hin."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η οθόνη ξεκινά με ένα αχνό πορτοκαλί φως και γίνεται έντονο, ζεστό φως στη μέγιστη φωτεινότητα. Τοποθέτησε το κινητό με την οθόνη προς τα πάνω."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The screen starts with a faint orange glow and turns into bright, warm light at full brightness. Place your phone screen up."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La pantalla empieza con un tenue brillo naranja y se convierte en una luz cálida e intensa a pleno brillo. Coloca el móvil con la pantalla hacia arriba."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "صفحه با درخششی کم‌رنگ و نارنجی شروع می‌شود و با نور کامل به نوری روشن و گرم تبدیل می‌شود. گوشی را رو به بالا بگذار."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Näyttö alkaa himmeänä oranssina hehkuna ja muuttuu kirkkaaksi, lämpimäksi valoksi täydellä kirkkaudella. Aseta puhelin näyttö ylöspäin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’écran démarre avec une faible lueur orange, puis se transforme en lumière chaude et vive à pleine luminosité. Place ton téléphone écran vers le haut."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "המסך מתחיל בזוהר כתום חלש והופך לאור חם ובהיר בבהירות מלאה. הניחו את הטלפון כשהמסך כלפי מעלה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्क्रीन हल्की नारंगी चमक से शुरू होती है और पूरी ब्राइटनेस पर तेज़, गर्म रोशनी बन जाती है। फ़ोन को स्क्रीन ऊपर करके रखें।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A képernyő halvány narancsszínű fénnyel indul, majd teljes fényerőn erős, meleg fénnyé válik. Fektesd a telefont képernyővel felfelé."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Layar mulai dengan cahaya oranye redup, lalu berubah menjadi cahaya hangat yang terang dengan kecerahan penuh. Letakkan ponsel dengan layar menghadap ke atas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo schermo parte con un tenue bagliore arancione e diventa una luce calda e intensa alla massima luminosità. Appoggia il telefono con lo schermo verso l’alto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画面はかすかなオレンジ色の光から始まり、最大輝度の明るく暖かい光に変わります。スマホは画面を上にして置いてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "화면이 희미한 주황빛으로 시작해 최대 밝기의 밝고 따뜻한 빛으로 바뀌어요. 휴대폰을 화면이 위로 가게 두세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Skrin bermula dengan cahaya oren yang malap, kemudian bertukar menjadi cahaya hangat yang cerah pada kecerahan penuh. Letakkan telefon dengan skrin menghadap ke atas."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Skjermen starter med et svakt oransje skjær og blir til sterkt, varmt lys ved full lysstyrke. Legg telefonen med skjermen opp."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het scherm begint met een zwakke oranje gloed en wordt helder, warm licht op volle helderheid. Leg je telefoon met het scherm omhoog."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekran zaczyna od słabej pomarańczowej poświaty i zmienia się w jasne, ciepłe światło przy pełnej jasności. Połóż telefon ekranem do góry."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A tela começa com um brilho laranja fraco e se torna uma luz quente e intensa com o brilho no máximo. Deixe o celular com a tela para cima."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O ecrã começa com um brilho laranja fraco e torna-se uma luz quente e intensa com o brilho no máximo. Deixa o telemóvel com o ecrã para cima."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ecranul începe cu o strălucire portocalie slabă și devine o lumină caldă și intensă la luminozitate maximă. Așază telefonul cu ecranul în sus."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Экран начинает слабо светиться оранжевым, а затем становится ярким тёплым светом на полной яркости. Положи телефон экраном вверх."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Skärmen börjar med ett svagt orange sken och blir ett starkt, varmt ljus med full ljusstyrka. Lägg mobilen med skärmen uppåt."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หน้าจอเริ่มจากแสงสีส้มจาง ๆ แล้วค่อยเป็นแสงอุ่นสว่างที่ความสว่างเต็มที่ วางโทรศัพท์โดยหงายหน้าจอขึ้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekran soluk bir turuncu parıltıyla başlar ve tam parlaklıkta parlak, sıcak bir ışığa dönüşür. Telefonu ekranı yukarı bakacak şekilde bırak."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Екран починає слабо світитися помаранчевим, а потім стає яскравим теплим світлом на повній яскравості. Поклади телефон екраном догори."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Màn hình bắt đầu bằng ánh cam mờ rồi chuyển thành ánh sáng ấm, rực rỡ ở độ sáng tối đa. Hãy đặt điện thoại ngửa màn hình lên trên."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "屏幕先泛起微弱的橙色光，再逐渐变为全亮度的明亮暖光。请将手机屏幕朝上放置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "螢幕先泛起微弱的橙色光，再逐漸變為全亮度的明亮暖光。請將手機螢幕朝上放置。"
          }
        }
      }
    },
    "editor_sunrise_ios_hint": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يستطيع الـ iPhone عرض الضوء إلا أثناء فتح Phase Wake – ابدأ وضع المنضدة قبل النوم."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tvůj iPhone může zobrazit světlo, jen když je Phase Wake otevřená – před spaním spusť noční režim."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Din iPhone kan kun vise lyset, mens Phase Wake er åben – start natbordstilstand, før du går i seng."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das iPhone kann das Licht nur zeigen, solange Phase Wake offen ist – starte vor dem Schlafen den Nachttisch-Modus."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το iPhone σου μπορεί να δείξει το φως μόνο όσο το Phase Wake είναι ανοιχτό – ξεκίνα τη λειτουργία κομοδίνου πριν κοιμηθείς."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your iPhone can only show the light while Phase Wake is open – start nightstand mode before you go to sleep."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu iPhone solo puede mostrar la luz mientras Phase Wake esté abierta: inicia el modo mesita de noche antes de dormir."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone فقط تا وقتی Phase Wake باز است می‌تواند نور را نشان بدهد – پیش از خواب حالت پاتختی را شروع کن."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhonesi voi näyttää valon vain Phase Waken ollessa auki – käynnistä yöpöytätila ennen nukkumaanmenoa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ton iPhone ne peut afficher la lumière que tant que Phase Wake est ouverte – démarre le mode table de chevet avant de dormir."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ה-iPhone יכול להציג את האור רק כש-Phase Wake פתוחה – הפעילו מצב שידת לילה לפני השינה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका iPhone रोशनी तभी दिखा सकता है जब Phase Wake खुला हो – सोने से पहले बेडसाइड मोड शुरू करें।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az iPhone csak akkor tudja megjeleníteni a fényt, amíg a Phase Wake nyitva van – lefekvés előtt indítsd el az éjjeliszekrény-módot."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone-mu hanya bisa menampilkan cahaya selama Phase Wake terbuka – mulai mode samping tempat tidur sebelum tidur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo iPhone può mostrare la luce solo finché Phase Wake è aperta – avvia la modalità comodino prima di dormire."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhoneはPhase Wakeを開いている間しかライトを表示できません – 眠る前にナイトスタンドモードを開始してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone은 Phase Wake가 열려 있는 동안에만 빛을 보여줄 수 있어요 – 자기 전에 탁상 모드를 시작하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone hanya boleh menunjukkan cahaya semasa Phase Wake terbuka – mulakan mod meja sisi katil sebelum awak tidur."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone kan bare vise lyset mens Phase Wake er åpen – start nattbordmodus før du legger deg."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je iPhone kan het licht alleen tonen zolang Phase Wake open is – start de nachtkastmodus voordat je gaat slapen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone może pokazywać światło tylko przy otwartym Phase Wake – włącz tryb nocnego stolika przed snem."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O iPhone só pode mostrar a luz enquanto o Phase Wake estiver aberto – inicie o modo de mesa de cabeceira antes de dormir."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O iPhone só pode mostrar a luz enquanto o Phase Wake estiver aberto – inicia o modo de mesa de cabeceira antes de dormires."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone-ul poate arăta lumina doar cât timp Phase Wake este deschis – pornește modul noptieră înainte de culcare."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone может показывать свет, только пока Phase Wake открыт – включи режим прикроватных часов перед сном."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone kan bara visa ljuset medan Phase Wake är öppen – starta nattduksbordsläge innan du somnar."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone แสดงแสงได้ก็ต่อเมื่อเปิด Phase Wake อยู่ – เริ่มโหมดข้างเตียงก่อนเข้านอน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone ışığı yalnızca Phase Wake açıkken gösterebilir – uyumadan önce komodin modunu başlat."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone може показувати світло, лише поки Phase Wake відкритий – увімкни режим нічного столика перед сном."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone chỉ hiển thị được ánh sáng khi Phase Wake đang mở – hãy bắt đầu chế độ đầu giường trước khi đi ngủ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的 iPhone 只有在 Phase Wake 打开时才能显示光线 – 请在睡觉前开始床头模式。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的 iPhone 只有在 Phase Wake 開啟時才能顯示光線 – 請在睡覺前開始床頭模式。"
          }
        }
      }
    },
    "editor_sunrise_ring_hint|few": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يبدأ عند إيقاظك ويصبح ساطعًا تمامًا بعد %1$lld دقائق."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Začne, když tě probudí, a po %1$lld minutách naplno září."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaczyna się, gdy cię obudzimy, a po %1$lld minutach świeci pełną jasnością."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Pornește când ești trezit și este complet luminos după %1$lld minute."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Начинается, когда тебя будят, и через %1$lld минуты светит на полную яркость."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Починається, коли тебе будять, і через %1$lld хвилини світить на повну яскравість."
          }
        }
      }
    },
    "editor_sunrise_ring_hint|many": {
