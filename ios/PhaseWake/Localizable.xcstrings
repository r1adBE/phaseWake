        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Trend muncul selepas beberapa malam."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Trender vises etter noen netter."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Trends verschijnen na een paar nachten."
          }
        },
        "pl": {
