    "editor_sunrise_hint": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تبدأ الشاشة بتوهج برتقالي خافت ثم تتحول إلى ضوء دافئ ساطع بأقصى سطوع. ضع الهاتف والشاشة للأعلى."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Displej nejdřív slabě zoranží a pak přejde v jasné, teplé světlo na plný jas. Polož telefon displejem nahoru."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Skærmen starter med et svagt orange skær og bliver til klart, varmt lys ved fuld lysstyrke. Læg telefonen med skærmen opad."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Bildschirm leuchtet erst schwach orange und wird dann zu hellem, warmem Licht bei voller Helligkeit. Leg das Handy mit dem Bildschirm nach oben hin."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η οθόνη ξεκινά με ένα αχνό πορτοκαλί φως και γίνεται έντονο, ζεστό φως στη μέγιστη φωτεινότητα. Τοποθέτησε το κινητό με την οθόνη προς τα πάνω."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The screen starts with a faint orange glow and turns into bright, warm light at full brightness. Place your phone screen up."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La pantalla empieza con un tenue brillo naranja y se convierte en una luz cálida e intensa a pleno brillo. Coloca el móvil con la pantalla hacia arriba."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "صفحه با درخششی کم‌رنگ و نارنجی شروع می‌شود و با نور کامل به نوری روشن و گرم تبدیل می‌شود. گوشی را رو به بالا بگذار."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Näyttö alkaa himmeänä oranssina hehkuna ja muuttuu kirkkaaksi, lämpimäksi valoksi täydellä kirkkaudella. Aseta puhelin näyttö ylöspäin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’écran démarre avec une faible lueur orange, puis se transforme en lumière chaude et vive à pleine luminosité. Place ton téléphone écran vers le haut."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "המסך מתחיל בזוהר כתום חלש והופך לאור חם ובהיר בבהירות מלאה. הניחו את הטלפון כשהמסך כלפי מעלה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्क्रीन हल्की नारंगी चमक से शुरू होती है और पूरी ब्राइटनेस पर तेज़, गर्म रोशनी बन जाती है। फ़ोन को स्क्रीन ऊपर करके रखें।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A képernyő halvány narancsszínű fénnyel indul, majd teljes fényerőn erős, meleg fénnyé válik. Fektesd a telefont képernyővel felfelé."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Layar mulai dengan cahaya oranye redup, lalu berubah menjadi cahaya hangat yang terang dengan kecerahan penuh. Letakkan ponsel dengan layar menghadap ke atas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo schermo parte con un tenue bagliore arancione e diventa una luce calda e intensa alla massima luminosità. Appoggia il telefono con lo schermo verso l’alto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画面はかすかなオレンジ色の光から始まり、最大輝度の明るく暖かい光に変わります。スマホは画面を上にして置いてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "화면이 희미한 주황빛으로 시작해 최대 밝기의 밝고 따뜻한 빛으로 바뀌어요. 휴대폰을 화면이 위로 가게 두세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Skrin bermula dengan cahaya oren yang malap, kemudian bertukar menjadi cahaya hangat yang cerah pada kecerahan penuh. Letakkan telefon dengan skrin menghadap ke atas."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Skjermen starter med et svakt oransje skjær og blir til sterkt, varmt lys ved full lysstyrke. Legg telefonen med skjermen opp."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het scherm begint met een zwakke oranje gloed en wordt helder, warm licht op volle helderheid. Leg je telefoon met het scherm omhoog."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekran zaczyna od słabej pomarańczowej poświaty i zmienia się w jasne, ciepłe światło przy pełnej jasności. Połóż telefon ekranem do góry."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A tela começa com um brilho laranja fraco e se torna uma luz quente e intensa com o brilho no máximo. Deixe o celular com a tela para cima."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O ecrã começa com um brilho laranja fraco e torna-se uma luz quente e intensa com o brilho no máximo. Deixa o telemóvel com o ecrã para cima."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ecranul începe cu o strălucire portocalie slabă și devine o lumină caldă și intensă la luminozitate maximă. Așază telefonul cu ecranul în sus."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Экран начинает слабо светиться оранжевым, а затем становится ярким тёплым светом на полной яркости. Положи телефон экраном вверх."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Skärmen börjar med ett svagt orange sken och blir ett starkt, varmt ljus med full ljusstyrka. Lägg mobilen med skärmen uppåt."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หน้าจอเริ่มจากแสงสีส้มจาง ๆ แล้วค่อยเป็นแสงอุ่นสว่างที่ความสว่างเต็มที่ วางโทรศัพท์โดยหงายหน้าจอขึ้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekran soluk bir turuncu parıltıyla başlar ve tam parlaklıkta parlak, sıcak bir ışığa dönüşür. Telefonu ekranı yukarı bakacak şekilde bırak."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Екран починає слабо світитися помаранчевим, а потім стає яскравим теплим світлом на повній яскравості. Поклади телефон екраном догори."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Màn hình bắt đầu bằng ánh cam mờ rồi chuyển thành ánh sáng ấm, rực rỡ ở độ sáng tối đa. Hãy đặt điện thoại ngửa màn hình lên trên."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "屏幕先泛起微弱的橙色光，再逐渐变为全亮度的明亮暖光。请将手机屏幕朝上放置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "螢幕先泛起微弱的橙色光，再逐漸變為全亮度的明亮暖光。請將手機螢幕朝上放置。"
          }
        }
      }
    },
    "editor_sunrise_ring_hint": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يبدأ عند إيقاظك ويصبح ساطعًا تمامًا بعد %1$lld دقيقة."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Začne, když tě probudí, a po %1$lld minutách naplno září."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Starter, når du bliver vækket, og er fuldt lys efter %1$lld minutter."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beginnt beim Wecken und ist nach %1$lld Minuten voll hell."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ξεκινά όταν σε ξυπνήσει και φτάνει στη μέγιστη φωτεινότητα μετά από %1$lld λεπτά."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Starts when you’re woken and is fully bright after %1$lld minutes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Empieza cuando te despierta y alcanza el brillo máximo a los %1$lld minutos."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "وقتی بیدارت کنند شروع می‌شود و پس از %1$lld دقیقه کاملاً روشن است."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Alkaa, kun sinut herätetään, ja on täysin kirkas %1$lld minuutin kuluttua."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Démarre quand tu es réveillé(e) et atteint sa pleine luminosité après %1$lld minutes."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מתחיל כשמעירים אתכם ובהיר לגמרי אחרי %1$lld דקות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपको जगाने पर शुरू होता है और %1$lld मिनट बाद पूरी तरह तेज़ हो जाता है।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az ébresztéskor indul, és %1$lld perc múlva teljes fényerővel világít."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mulai saat kamu dibangunkan dan terang penuh setelah %1$lld menit."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Parte quando vieni svegliato e raggiunge la piena luminosità dopo %1$lld minuti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "起こされた時点で始まり、%1$lld分後に最も明るくなります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "깨울 때 시작해 %1$lld분 후 가장 밝아져요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Bermula apabila awak dikejutkan dan cerah sepenuhnya selepas %1$lld minit."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Starter når du blir vekket og er fullt lys etter %1$lld minutter."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Begint wanneer je gewekt wordt en is na %1$lld minuten volledig helder."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaczyna się, gdy cię obudzimy, a po %1$lld minutach świeci pełną jasnością."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Começa quando você é acordado e fica totalmente clara após %1$lld minutos."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Começa quando és acordado e fica totalmente claro após %1$lld minutos."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Pornește când ești trezit și este complet luminos după %1$lld minute."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Начинается, когда тебя будят, и через %1$lld мин. светит на полную яркость."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Börjar när du väcks och är helt ljus efter %1$lld minuter."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เริ่มเมื่อคุณถูกปลุก และสว่างเต็มที่หลังผ่านไป %1$lld นาที"
