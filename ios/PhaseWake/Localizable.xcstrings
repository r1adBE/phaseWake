    "check_watch_arm_problem": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "افتح Phase Wake على Apple Watch قبل أن تنام. لا يفعّل watchOS المنبه إلا أثناء فتح التطبيق."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Před spaním otevři Phase Wake na Apple Watch. watchOS aktivuje budík, jen když je aplikace otevřená."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Åbn Phase Wake på dit Apple Watch, før du går i seng. watchOS aktiverer kun alarmen, mens appen er åben."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne Phase Wake vor dem Schlafen auf der Apple Watch. watchOS schaltet den Wecker nur bei offener App scharf."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Άνοιξε το Phase Wake στο Apple Watch σου πριν κοιμηθείς. Το watchOS ενεργοποιεί το ξυπνητήρι μόνο όσο η εφαρμογή είναι ανοιχτή."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Phase Wake on your Apple Watch before you go to sleep. watchOS only arms the alarm while the app is open."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre Phase Wake en tu Apple Watch antes de dormir. watchOS solo activa la alarma mientras la app está abierta."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "پیش از خواب Phase Wake را روی Apple Watch خود باز کن. watchOS فقط تا وقتی برنامه باز است زنگ را فعال می‌کند."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Avaa Phase Wake Apple Watchissa ennen nukkumaanmenoa. watchOS aktivoi herätyksen vain, kun sovellus on auki."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvre Phase Wake sur ton Apple Watch avant de dormir. watchOS n’active l’alarme que tant que l’app est ouverte."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "פתחו את Phase Wake ב-Apple Watch שלכם לפני השינה. watchOS מפעיל את המעורר רק כשהאפליקציה פתוחה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सोने से पहले अपनी Apple Watch पर Phase Wake खोलें। watchOS अलार्म को तभी सक्रिय करता है जब ऐप खुला हो।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Lefekvés előtt nyisd meg a Phase Wake-et az Apple Watchodon. A watchOS csak akkor élesíti az ébresztőt, amíg az alkalmazás nyitva van."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Buka Phase Wake di Apple Watch-mu sebelum tidur. watchOS hanya mengaktifkan alarm selama aplikasi terbuka."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apri Phase Wake sul tuo Apple Watch prima di dormire. watchOS attiva la sveglia solo finché l’app è aperta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "眠る前にApple WatchでPhase Wakeを開いてください。watchOSはアプリが開いている間だけアラームを有効にします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "잠들기 전에 Apple Watch에서 Phase Wake를 열어 주세요. watchOS는 앱이 열려 있는 동안에만 알람을 활성화해요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Buka Phase Wake pada Apple Watch sebelum awak tidur. watchOS hanya mengaktifkan penggera semasa apl dibuka."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Åpne Phase Wake på Apple Watch før du legger deg. watchOS aktiverer bare alarmen mens appen er åpen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Phase Wake op je Apple Watch voordat je gaat slapen. watchOS activeert de wekker alleen zolang de app geopend is."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Otwórz Phase Wake na Apple Watch przed snem. watchOS aktywuje budzik tylko wtedy, gdy aplikacja jest otwarta."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra o Phase Wake no seu Apple Watch antes de dormir. O watchOS só ativa o alarme enquanto o app está aberto."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre o Phase Wake no teu Apple Watch antes de dormires. O watchOS só ativa o alarme enquanto a app estiver aberta."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Deschide Phase Wake pe Apple Watch înainte de culcare. watchOS activează alarma doar cât timp aplicația este deschisă."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Открой Phase Wake на Apple Watch перед сном. watchOS активирует будильник, только пока приложение открыто."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Öppna Phase Wake på Apple Watch innan du somnar. watchOS aktiverar bara alarmet medan appen är öppen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปิด Phase Wake บน Apple Watch ก่อนเข้านอน watchOS จะเปิดใช้งานนาฬิกาปลุกเฉพาะตอนที่แอปเปิดอยู่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uyumadan önce Apple Watch’ta Phase Wake’i aç. watchOS alarmı yalnızca uygulama açıkken etkinleştirir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відкрий Phase Wake на Apple Watch перед сном. watchOS активує будильник, лише поки застосунок відкритий."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy mở Phase Wake trên Apple Watch trước khi đi ngủ. watchOS chỉ kích hoạt báo thức khi ứng dụng đang mở."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "睡觉前请在你的 Apple Watch 上打开 Phase Wake。watchOS 只有在应用打开时才会启用闹钟。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "睡覺前請在你的 Apple Watch 上開啟 Phase Wake。watchOS 只有在 App 開啟時才會啟用鬧鐘。"
          }
        }
      }
    },
    "check_watch_problem": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذر الوصول إلى ساعتك. ارتدِها، وأبقِ Bluetooth قيد التشغيل، وافتح Phase Wake على الساعة مرة واحدة."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Hodinky nejsou dostupné. Nasaď si je, nech zapnuté Bluetooth a jednou na hodinkách otevři Phase Wake."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit ur kan ikke nås. Tag det på, hold Bluetooth slået til, og åbn Phase Wake på uret én gang."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Uhr ist nicht erreichbar. Trag sie, lass Bluetooth an und öffne Phase Wake einmal auf der Uhr."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το ρολόι σου δεν είναι προσβάσιμο. Φόρεσέ το, κράτα το Bluetooth ενεργό και άνοιξε το Phase Wake στο ρολόι μία φορά."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your watch isn’t reachable. Wear it, keep Bluetooth on and open Phase Wake on the watch once."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se puede acceder a tu reloj. Póntelo, mantén el Bluetooth activado y abre Phase Wake en el reloj una vez."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "به ساعتت دسترسی ندارم. آن را ببند، Bluetooth را روشن نگه دار و یک بار Phase Wake را روی ساعت باز کن."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kelloasi ei tavoiteta. Pidä se ranteessa, pidä Bluetooth päällä ja avaa Phase Wake kellossa kerran."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta montre est injoignable. Mets-la au poignet, garde le Bluetooth activé et ouvre Phase Wake une fois sur la montre."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אי אפשר להגיע לשעון שלכם. ענדו אותו, השאירו את ה-Bluetooth פעיל ופתחו את Phase Wake בשעון פעם אחת."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपकी वॉच तक पहुँचा नहीं जा सकता। उसे पहनें, Bluetooth चालू रखें और वॉच पर एक बार Phase Wake खोलें।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az órád nem érhető el. Vedd fel, tartsd bekapcsolva a Bluetooth-t, és nyisd meg egyszer a Phase Wake-et az órán."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jam tanganmu tidak terjangkau. Kenakan, biarkan Bluetooth menyala, dan buka Phase Wake di jam tangan sekali."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo orologio non è raggiungibile. Indossalo, tieni attivo il Bluetooth e apri Phase Wake sull’orologio una volta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ウォッチに接続できません。ウォッチを装着し、Bluetoothをオンにして、ウォッチでPhase Wakeを一度開いてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "워치에 연결할 수 없어요. 워치를 착용하고 Bluetooth를 켠 뒤, 워치에서 Phase Wake를 한 번 열어 주세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Jam tangan tidak dapat dicapai. Pakai jam tangan, biarkan Bluetooth hidup dan buka Phase Wake pada jam tangan sekali."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Klokken er ikke tilgjengelig. Ha den på deg, la Bluetooth stå på og åpne Phase Wake på klokken én gang."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je horloge is niet bereikbaar. Draag het, laat Bluetooth aan en open Phase Wake één keer op het horloge."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zegarek jest niedostępny. Załóż go, zostaw włączony Bluetooth i raz otwórz Phase Wake na zegarku."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível alcançar seu relógio. Use-o, mantenha o Bluetooth ligado e abra o Phase Wake no relógio uma vez."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O relógio não está acessível. Usa-o, mantém o Bluetooth ativado e abre o Phase Wake no relógio uma vez."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ceasul nu este accesibil. Poartă-l, ține Bluetooth pornit și deschide Phase Wake pe ceas o dată."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Часы недоступны. Надень их, не выключай Bluetooth и один раз открой Phase Wake на часах."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Klockan går inte att nå. Ta på den, låt Bluetooth vara på och öppna Phase Wake på klockan en gång."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ติดต่อนาฬิกาของคุณไม่ได้ ให้สวมนาฬิกา เปิด Bluetooth ไว้ และเปิด Phase Wake บนนาฬิกาสักครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saatine ulaşılamıyor. Tak, Bluetooth’u açık tut ve saatte Phase Wake’i bir kez aç."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Годинник недоступний. Одягни його, не вимикай Bluetooth і один раз відкрий Phase Wake на годиннику."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể kết nối với đồng hồ. Hãy đeo đồng hồ, bật Bluetooth và mở Phase Wake trên đồng hồ một lần."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法连接到你的手表。请戴上手表，保持 Bluetooth 开启，并在手表上打开一次 Phase Wake。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法連線到你的手錶。請戴上手錶，保持 Bluetooth 開啟，並在手錶上開啟一次 Phase Wake。"
          }
        }
      }
    },
