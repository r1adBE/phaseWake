    "sunrise_text": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تزداد الشاشة سطوعًا ببطء حتى تستيقظ."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Displej se pomalu rozjasňuje, dokud se neprobudíš."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Skærmen bliver langsomt lysere, indtil du vågner."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Bildschirm wird langsam heller, bis du geweckt wirst."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η οθόνη φωτίζεται σιγά σιγά μέχρι να ξυπνήσεις."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your screen slowly gets brighter until you wake up."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La pantalla se va iluminando poco a poco hasta que te despiertes."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "صفحه کم‌کم روشن‌تر می‌شود تا بیدار شوی."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Näyttö kirkastuu hitaasti, kunnes heräät."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’écran devient peu à peu plus lumineux jusqu’à ton réveil."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "המסך מתבהר לאט עד שתתעוררו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके जागने तक स्क्रीन धीरे-धीरे तेज़ होती जाती है।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A képernyő lassan egyre világosabb lesz, amíg fel nem ébredsz."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Layar perlahan menjadi lebih terang sampai kamu bangun."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo schermo diventa lentamente più luminoso finché non ti svegli."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "起きるまで、画面がゆっくり明るくなります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "깨어날 때까지 화면이 서서히 밝아져요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Skrin perlahan-lahan menjadi lebih cerah sehingga awak bangun."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Skjermen blir sakte lysere helt til du våkner."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je scherm wordt langzaam helderder tot je wakker wordt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekran powoli się rozjaśnia, aż się obudzisz."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A tela fica mais clara aos poucos até você acordar."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O ecrã fica mais claro aos poucos até acordares."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ecranul devine treptat mai luminos până te trezești."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Экран медленно становится ярче, пока ты не проснёшься."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Skärmen blir långsamt ljusare tills du vaknar."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หน้าจอจะค่อย ๆ สว่างขึ้นจนกว่าคุณจะตื่น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sen uyanana kadar ekran yavaşça parlaklaşır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Екран повільно яскравішає, поки ти не прокинешся."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Màn hình sáng dần cho đến khi bạn thức dậy."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "屏幕会慢慢变亮，直到你醒来。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "螢幕會慢慢變亮，直到你醒來。"
          }
        }
      }
    },
