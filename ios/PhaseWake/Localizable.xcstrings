    "settings_data_text": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كل شيء يبقى على هاتفك وساعتك. بلا حساب ولا خادم ولا تتبّع."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vše zůstává v telefonu a hodinkách. Bez účtu, bez serveru, bez sledování."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Alt bliver på din telefon og dit ur. Ingen konto, ingen server, ingen sporing."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles bleibt auf Handy und Uhr. Kein Konto, kein Server, keine Auswertung."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Όλα μένουν στο κινητό και στο ρολόι. Χωρίς λογαριασμό, χωρίς διακομιστή, χωρίς παρακολούθηση."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Everything stays on your phone and watch. No account, no server, no tracking."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo se queda en tu móvil y tu reloj. Sin cuenta, sin servidor, sin seguimiento."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "همه‌چیز روی گوشی و ساعتت می‌ماند. بدون حساب، بدون سرور، بدون ردیابی."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaikki pysyy puhelimessa ja kellossa. Ei tiliä, ei palvelinta, ei seurantaa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout reste sur ton téléphone et ta montre. Pas de compte, pas de serveur, pas de suivi."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הכול נשאר בטלפון ובשעון. בלי חשבון, בלי שרת, בלי מעקב."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सब कुछ तुम्हारे फ़ोन और घड़ी में रहता है। न खाता, न सर्वर, न ट्रैकिंग।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Minden a telefonodon és az órádon marad. Nincs fiók, nincs szerver, nincs követés."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Semua tetap di ponsel dan jam tanganmu. Tanpa akun, tanpa server, tanpa pelacakan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutto resta sul telefono e sullo smartwatch. Nessun account, nessun server, nessun tracciamento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべてスマートフォンとウォッチ内に保存されます。アカウントもサーバーもトラッキングもありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 데이터는 휴대폰과 워치에만 저장돼요. 계정도, 서버도, 추적도 없어요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Semuanya kekal pada telefon dan jam tangan. Tiada akaun, tiada pelayan, tiada penjejakan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Alt blir på telefonen og klokka. Ingen konto, ingen server, ingen sporing."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles blijft op je telefoon en horloge. Geen account, geen server, geen tracking."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wszystko zostaje na telefonie i zegarku. Bez konta, serwera i śledzenia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tudo fica no seu celular e no relógio. Sem conta, sem servidor, sem rastreamento."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Tudo fica no telemóvel e no relógio. Sem conta, sem servidor, sem rastreio."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Totul rămâne pe telefon și pe ceas. Fără cont, fără server, fără urmărire."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Всё остаётся на телефоне и часах. Без аккаунта, сервера и слежки."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Allt stannar på mobilen och klockan. Inget konto, ingen server, ingen spårning."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทุกอย่างอยู่บนโทรศัพท์และนาฬิกาของคุณเท่านั้น ไม่มีบัญชี ไม่มีเซิร์ฟเวอร์ ไม่มีการติดตาม"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her şey telefonunda ve saatinde kalır. Hesap yok, sunucu yok, takip yok."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Усе залишається на телефоні та годиннику. Без облікового запису, сервера й стеження."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mọi thứ chỉ nằm trên điện thoại và đồng hồ của bạn. Không tài khoản, không máy chủ, không theo dõi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所有数据都只保存在手机和手表上。无需账号，没有服务器，不做跟踪。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "所有資料都只儲存在手機和手錶上。不需帳號、沒有伺服器、不做追蹤。"
          }
        }
      }
    },
