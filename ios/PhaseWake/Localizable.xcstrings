          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Починається, коли тебе будять, і через %1$lld хв світить на повну яскравість."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bắt đầu khi bạn được đánh thức và sáng hoàn toàn sau %1$lld phút."
          }
        },
