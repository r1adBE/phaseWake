    "health_rationale": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكن لـ Phase Wake قراءة مراحل النوم التي يحفظها تطبيق الصحة لديك (مثل Samsung Health) بعد الاستيقاظ. تُستخدم فقط للتحقق من أنك أُيقظت في نوم خفيف ولتحسين الرصد لك. يقرأ Phase Wake فقط ولا يكتب أبدًا، ولا شيء يغادر هاتفك."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake umí číst fáze spánku, které tvoje zdravotní aplikace (třeba Samsung Health) uloží po probuzení. Slouží jen ke kontrole, zda tě budík vzbudil v lehkém spánku, a k vylepšení rozpoznávání pro tebe. Phase Wake jen čte, nikdy nezapisuje a nic neopustí tvůj telefon."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake kan læse de søvnfaser, som din sundheds-app (for eksempel Samsung Health) gemmer, efter du er vågnet. De bruges kun til at tjekke, om du blev vækket i let søvn, og til at forbedre registreringen for dig. Phase Wake læser kun, skriver aldrig, og intet forlader din telefon."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake kann die Schlafphasen lesen, die deine Gesundheits-App (zum Beispiel Samsung Health) nach dem Aufwachen ablegt. Sie dienen nur dazu zu prüfen, ob du im leichten Schlaf geweckt wurdest, und die Erkennung für dich zu verbessern. Phase Wake liest nur, schreibt nie, und nichts verlässt dein Handy."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Phase Wake μπορεί να διαβάζει τις φάσεις ύπνου που αποθηκεύει η εφαρμογή υγείας σου (για παράδειγμα το Samsung Health) αφού ξυπνήσεις. Χρησιμοποιούνται μόνο για να ελέγχεται αν σε ξύπνησε στον ελαφρύ ύπνο και για να βελτιωθεί η ανίχνευση για σένα. Το Phase Wake μόνο διαβάζει, δεν γράφει ποτέ, και τίποτα δεν φεύγει από το κινητό σου."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake can read the sleep stages that your health app (for example Samsung Health) stores after you wake up. They are used only to check whether you were woken in light sleep and to improve detection for you. Phase Wake only reads, never writes, and nothing leaves your phone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake puede leer las fases del sueño que tu app de salud (por ejemplo, Samsung Health) guarda al despertar. Se usan solo para comprobar si te despertaron en sueño ligero y para mejorar la detección para ti. Phase Wake solo lee, nunca escribe, y nada sale de tu móvil."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake می‌تواند مراحل خوابی را که برنامهٔ سلامتت (مثلاً Samsung Health) بعد از بیدار شدن ذخیره می‌کند بخواند. این داده‌ها فقط برای بررسی اینکه در خواب سبک بیدار شده‌ای یا نه و بهتر کردن تشخیص برای خودت استفاده می‌شوند. Phase Wake فقط می‌خواند، هیچ‌وقت چیزی نمی‌نویسد و هیچ چیز از گوشی‌ات بیرون نمی‌رود."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake voi lukea univaiheet, jotka terveyssovelluksesi (esimerkiksi Samsung Health) tallentaa heräämisen jälkeen. Niitä käytetään vain tarkistamaan, herätettiinkö sinut kevyessä unessa, ja parantamaan tunnistusta sinulle. Phase Wake vain lukee, ei koskaan kirjoita, eikä mikään poistu puhelimestasi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake peut lire les phases de sommeil que ton application santé (par exemple Samsung Health) enregistre après ton réveil. Elles servent uniquement à vérifier si tu as été réveillé en sommeil léger et à améliorer la détection pour toi. Phase Wake lit seulement, n'écrit jamais, et rien ne quitte ton téléphone."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ניתן לאפשר ל-Phase Wake לקרוא את שלבי השינה שאפליקציית הבריאות שלכם (למשל Samsung Health) שומרת לאחר ההתעוררות. הם משמשים רק כדי לבדוק אם התעוררתם בשינה קלה ולשפר עבורכם את הזיהוי. הגישה היא לקריאה בלבד, ושום דבר לא יוצא מהטלפון."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake वे नींद के चरण पढ़ सकता है जो तुम्हारा हेल्थ ऐप (जैसे Samsung Health) जागने के बाद सेव करता है। इनका इस्तेमाल सिर्फ़ यह जाँचने के लिए होता है कि तुम्हें हल्की नींद में जगाया गया या नहीं, और तुम्हारे लिए पहचान बेहतर बनाने के लिए। Phase Wake सिर्फ़ पढ़ता है, कभी लिखता नहीं, और कुछ भी तुम्हारे फ़ोन से बाहर नहीं जाता।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Phase Wake el tudja olvasni az alvási fázisokat, amelyeket az egészségügyi appod (például a Samsung Health) ébredés után eltárol. Ezeket csak annak ellenőrzésére használja, hogy könnyű alvásban ébresztettek-e, és hogy javítsa az észlelést számodra. A Phase Wake csak olvas, soha nem ír, és semmi sem hagyja el a telefonodat."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake dapat membaca fase tidur yang disimpan aplikasi kesehatanmu (misalnya Samsung Health) setelah kamu bangun. Data ini hanya dipakai untuk memeriksa apakah kamu dibangunkan saat tidur ringan dan untuk meningkatkan deteksi bagimu. Phase Wake hanya membaca, tidak pernah menulis, dan tidak ada yang keluar dari ponselmu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake può leggere le fasi del sonno che la tua app di salute (ad esempio Samsung Health) salva dopo il risveglio. Servono solo a verificare se sei stato svegliato nel sonno leggero e a migliorare il rilevamento per te. Phase Wake legge soltanto, non scrive mai, e nulla lascia il tuo telefono."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wakeは、起床後にヘルスケアアプリ(Samsung Healthなど)が保存した睡眠ステージを読み取れます。浅い眠りで起こせたかの確認と、検出精度の向上にのみ使用します。Phase Wakeは読み取りのみで書き込みは行わず、データがスマートフォンの外に出ることもありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake는 일어난 뒤 건강 앱(예: Samsung Health)에 저장된 수면 단계를 읽을 수 있어요. 얕은 잠에서 깨웠는지 확인하고 감지 정확도를 높이는 데만 사용해요. Phase Wake는 읽기만 하고 쓰지 않으며, 데이터는 휴대폰 밖으로 나가지 않아요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake boleh membaca peringkat tidur yang disimpan oleh apl kesihatan awak (contohnya Samsung Health) selepas awak bangun. Ia hanya digunakan untuk menyemak sama ada awak dikejutkan dalam tidur ringan dan untuk menambah baik pengesanan untuk awak. Phase Wake hanya membaca, tidak pernah menulis, dan tiada apa-apa keluar dari telefon awak."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake kan lese søvnfasene som helse-appen din (for eksempel Samsung Health) lagrer etter at du har våknet. De brukes bare til å sjekke om du ble vekket i lett søvn, og til å forbedre gjenkjenningen for deg. Phase Wake leser bare, skriver aldri, og ingenting forlater telefonen din."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake kan de slaapfases lezen die je gezondheidsapp (bijvoorbeeld Samsung Health) opslaat nadat je wakker bent geworden. Ze worden alleen gebruikt om te controleren of je in lichte slaap bent gewekt en om de herkenning voor jou te verbeteren. Phase Wake leest alleen, schrijft nooit, en er verlaat niets je telefoon."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake może odczytywać fazy snu, które aplikacja zdrowotna (na przykład Samsung Health) zapisuje po twoim przebudzeniu. Służą wyłącznie do sprawdzenia, czy obudzono cię w lekkim śnie, i do ulepszenia wykrywania dla ciebie. Phase Wake tylko czyta, nigdy nie zapisuje, a nic nie opuszcza twojego telefonu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Phase Wake pode ler as fases do sono que seu app de saúde (por exemplo, o Samsung Health) salva depois que você acorda. Elas servem apenas para verificar se você foi acordado no sono leve e para melhorar a detecção para você. O Phase Wake só lê, nunca grava, e nada sai do seu celular."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O Phase Wake pode ler as fases do sono que a tua app de saúde (por exemplo, o Samsung Health) guarda depois de acordares. Servem apenas para verificar se foste acordado em sono leve e para melhorar a deteção para ti. O Phase Wake só lê, nunca escreve, e nada sai do teu telemóvel."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake poate citi fazele somnului pe care aplicația ta de sănătate (de exemplu Samsung Health) le salvează după ce te trezești. Sunt folosite doar pentru a verifica dacă ai fost trezit din somn ușor și pentru a îmbunătăți detectarea pentru tine. Phase Wake doar citește, nu scrie niciodată, iar nimic nu părăsește telefonul tău."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake может читать фазы сна, которые твоё приложение для здоровья (например, Samsung Health) сохраняет после пробуждения. Они нужны только чтобы проверить, разбудили ли тебя в лёгком сне, и улучшить распознавание для тебя. Phase Wake только читает, ничего не записывает, и данные не покидают твой телефон."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake kan läsa de sömnfaser som din hälsoapp (till exempel Samsung Health) sparar efter att du vaknat. De används bara för att kontrollera om du väcktes i lätt sömn och för att förbättra igenkänningen åt dig. Phase Wake läser bara, skriver aldrig, och inget lämnar din mobil."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake อ่านระยะการนอนหลับที่แอปสุขภาพของคุณ (เช่น Samsung Health) บันทึกไว้หลังคุณตื่นได้ ใช้เพื่อตรวจสอบว่าคุณถูกปลุกตอนหลับตื้นหรือไม่ และพัฒนาการตรวจจับให้เหมาะกับคุณเท่านั้น Phase Wake อ่านอย่างเดียว ไม่เขียนข้อมูล และไม่มีข้อมูลใดออกจากโทรศัพท์ของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake, sağlık uygulamanın (örneğin Samsung Health) uyandıktan sonra kaydettiği uyku evrelerini okuyabilir. Bunlar yalnızca hafif uykuda uyandırılıp uyandırılmadığını kontrol etmek ve algılamayı senin için geliştirmek amacıyla kullanılır. Phase Wake yalnızca okur, asla yazmaz ve hiçbir şey telefonundan çıkmaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake може читати фази сну, які після пробудження зберігає твій застосунок для здоров'я (наприклад, Samsung Health). Вони потрібні лише для перевірки, чи тебе розбудили в легкому сні, і для покращення розпізнавання саме для тебе. Phase Wake лише читає, нічого не записує, і дані не залишають твій телефон."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake có thể đọc các giai đoạn ngủ mà ứng dụng sức khỏe của bạn (ví dụ Samsung Health) lưu sau khi bạn thức dậy. Dữ liệu chỉ dùng để kiểm tra xem bạn có được đánh thức khi ngủ nông hay không và để cải thiện khả năng nhận diện cho bạn. Phase Wake chỉ đọc, không bao giờ ghi, và không có gì rời khỏi điện thoại của bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake 可以读取你的健康应用（例如 Samsung Health）在你醒来后保存的睡眠阶段。这些数据仅用于检查你是否在浅睡时被叫醒，并为你改进检测效果。Phase Wake 只读取、从不写入，数据也不会离开你的手机。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake 可以讀取你的健康應用程式（例如 Samsung Health）在你醒來後儲存的睡眠階段。這些資料僅用於檢查你是否在淺眠時被叫醒，並為你改善偵測效果。Phase Wake 只讀取、從不寫入，資料也不會離開你的手機。"
          }
        }
      }
    },
