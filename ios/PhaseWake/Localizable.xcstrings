    "health_connect_hint": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يقرأ مراحل النوم من Health Connect بعد الاستيقاظ للتحقق من الرصد وتحسينه."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Po probuzení načte fáze spánku z Health Connect, aby rozpoznávání ověřil a vylepšil."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Læser søvnfaser fra Health Connect efter opvågning for at tjekke og forbedre registreringen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Liest nach dem Aufwachen die Schlafphasen aus Health Connect, um die Erkennung zu prüfen und zu verbessern."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Διαβάζει τις φάσεις ύπνου από το Health Connect μετά το ξύπνημα, για έλεγχο και βελτίωση της ανίχνευσης."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reads sleep stages from Health Connect after waking, to check and improve detection."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lee las fases del sueño de Health Connect al despertar, para comprobar y mejorar la detección."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "بعد از بیدار شدن مراحل خواب را از Health Connect می‌خواند تا تشخیص را بسنجد و بهتر کند."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lukee univaiheet Health Connectista heräämisen jälkeen tunnistuksen tarkistamiseksi ja parantamiseksi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lit les phases de sommeil dans Health Connect après le réveil, pour vérifier et améliorer la détection."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "קורא את שלבי השינה מ-Health Connect אחרי ההתעוררות, כדי לבדוק ולשפר את הזיהוי."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जागने के बाद Health Connect से नींद के चरण पढ़ता है, ताकि पहचान जाँची और बेहतर की जा सके।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ébredés után beolvassa az alvási fázisokat a Health Connectből, hogy ellenőrizze és javítsa az észlelést."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Membaca fase tidur dari Health Connect setelah bangun, untuk memeriksa dan meningkatkan deteksi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Legge le fasi del sonno da Health Connect dopo il risveglio, per verificare e migliorare il rilevamento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "起床後にHealth Connectから睡眠ステージを読み取り、検出の確認と改善に使います。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일어난 뒤 Health Connect에서 수면 단계를 읽어 감지를 확인하고 개선해요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Membaca peringkat tidur daripada Health Connect selepas bangun, untuk menyemak dan menambah baik pengesanan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Leser søvnfaser fra Health Connect etter oppvåkning for å sjekke og forbedre gjenkjenningen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Leest na het wakker worden de slaapfases uit Health Connect, om de herkenning te controleren en te verbeteren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Po przebudzeniu odczytuje fazy snu z Health Connect, by sprawdzać i ulepszać wykrywanie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Lê as fases do sono do Health Connect depois de acordar, para verificar e melhorar a detecção."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Lê as fases do sono do Health Connect depois de acordares, para verificar e melhorar a deteção."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Citește fazele somnului din Health Connect după trezire, ca să verifice și să îmbunătățească detectarea."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "После пробуждения читает фазы сна из Health Connect, чтобы проверять и улучшать распознавание."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Läser sömnfaser från Health Connect efter uppvaknandet för att kontrollera och förbättra igenkänningen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อ่านระยะการนอนหลับจาก Health Connect หลังตื่น เพื่อตรวจสอบและพัฒนาการตรวจจับ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uyandıktan sonra uyku evrelerini Health Connect'ten okuyarak algılamayı kontrol eder ve geliştirir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Після пробудження читає фази сну з Health Connect, щоб перевіряти й покращувати розпізнавання."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đọc các giai đoạn ngủ từ Health Connect sau khi thức dậy để kiểm tra và cải thiện nhận diện."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "醒来后从 Health Connect 读取睡眠阶段，用于检查并改进检测。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "醒來後從 Health Connect 讀取睡眠階段，用於檢查並改善偵測。"
          }
        }
      }
    },
