    "nightstand_hint": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لشروق الشمس، اترك Phase Wake مفتوحًا على الشاحن طوال الليل. تبقى الشاشة معتمة حتى يبدأ الضوء."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro východ slunce nech Phase Wake přes noc otevřenou na nabíječce. Displej zůstane tmavý, dokud nezačne světlo."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Til solopgangen skal du lade Phase Wake være åben på opladeren natten over. Skærmen forbliver mørk, indtil lyset begynder."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für den Sonnenaufgang Phase Wake über Nacht am Ladekabel offen lassen. Der Bildschirm bleibt dunkel, bis das Licht beginnt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Για την ανατολή, άφησε το Phase Wake ανοιχτό στον φορτιστή όλη νύχτα. Η οθόνη μένει σκοτεινή μέχρι να αρχίσει το φως."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For the sunrise, leave Phase Wake open on the charger overnight. The screen stays dark until the light begins."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para el amanecer, deja Phase Wake abierta toda la noche en el cargador. La pantalla permanece oscura hasta que empieza la luz."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "برای طلوع، Phase Wake را تمام شب روی شارژر باز بگذار. صفحه تا شروع نور تاریک می‌ماند."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Auringonnousua varten jätä Phase Wake auki laturissa yön yli. Näyttö pysyy pimeänä, kunnes valo alkaa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour le lever de soleil, laisse Phase Wake ouverte toute la nuit sur le chargeur. L’écran reste noir jusqu’au début de la lumière."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לזריחה, השאירו את Phase Wake פתוחה על המטען לאורך הלילה. המסך נשאר חשוך עד שהאור מתחיל."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सूर्योदय के लिए Phase Wake को रात भर चार्जर पर खुला छोड़ें। रोशनी शुरू होने तक स्क्रीन अँधेरी रहती है।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A napfelkeltéhez hagyd nyitva a Phase Wake-et a töltőn egész éjjel. A kijelző sötét marad, amíg a fény el nem kezdődik."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Untuk matahari terbit, biarkan Phase Wake terbuka di pengisi daya semalaman. Layar tetap gelap sampai cahaya mulai menyala."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per l’alba, lascia Phase Wake aperta tutta la notte sul caricabatterie. Lo schermo resta buio finché non inizia la luce."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サンライズを使うには、Phase Wakeを開いたまま一晩充電器につないでおいてください。ライトが始まるまで画面は暗いままです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일출 효과를 쓰려면 밤새 충전기에 연결한 채 Phase Wake를 열어 두세요. 빛이 시작될 때까지 화면은 어두운 상태로 유지돼요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Untuk matahari terbit, biarkan Phase Wake terbuka pada pengecas sepanjang malam. Skrin kekal gelap sehingga cahaya bermula."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "For soloppgangen lar du Phase Wake stå åpen på laderen over natten. Skjermen forblir mørk til lyset begynner."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Laat Phase Wake voor de zonsopgang ’s nachts open staan op de oplader. Het scherm blijft donker tot het licht begint."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aby korzystać ze wschodu słońca, zostaw Phase Wake otwarty na ładowarce na całą noc. Ekran pozostaje ciemny, aż zacznie się światło."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para o nascer do sol, deixe o Phase Wake aberto no carregador durante a noite. A tela fica escura até a luz começar."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Para o nascer do sol, deixa o Phase Wake aberto no carregador durante a noite. O ecrã fica escuro até a luz começar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Pentru răsărit, lasă Phase Wake deschis pe încărcător peste noapte. Ecranul rămâne întunecat până începe lumina."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для рассвета оставь Phase Wake открытым на зарядке на всю ночь. Экран остаётся тёмным, пока не начнётся свет."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "För soluppgången, låt Phase Wake vara öppen på laddaren över natten. Skärmen förblir mörk tills ljuset börjar."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สำหรับแสงอาทิตย์ขึ้น ให้เปิด Phase Wake ทิ้งไว้บนที่ชาร์จตลอดคืน หน้าจอจะมืดจนกว่าแสงจะเริ่ม"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gün doğumu için Phase Wake’i gece boyunca şarjda açık bırak. Işık başlayana kadar ekran karanlık kalır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Для світанку залиш Phase Wake відкритим на зарядці на всю ніч. Екран залишається темним, доки не почнеться світло."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Để dùng bình minh, hãy để Phase Wake mở trên đế sạc suốt đêm. Màn hình vẫn tối cho đến khi ánh sáng bắt đầu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为了日出唤醒，请让 Phase Wake 整晚在充电器上保持打开。屏幕会保持黑暗，直到光线开始亮起。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "為了日出喚醒，請讓 Phase Wake 整晚在充電器上保持開啟。螢幕會保持黑暗，直到光線開始亮起。"
          }
        }
      }
    },
