    "trends_not_enough": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تظهر الاتجاهات بعد بضع ليالٍ."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Trendy se zobrazí po několika nocích."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tendenser vises efter nogle nætter."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Trends erscheinen nach ein paar Nächten."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι τάσεις εμφανίζονται μετά από μερικές νύχτες."
