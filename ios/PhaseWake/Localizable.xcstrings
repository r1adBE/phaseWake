    "editor_sleep_hint": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يبدأ العدّ عند النوم. اضغطوا على “ليلة سعيدة” في ساعتكم."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Počítá se od usnutí. Klepni na hodinkách na „Dobrou noc“."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tæller fra du falder i søvn. Tryk på »Godnat« på uret."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zählt ab dem Einschlafen. Tippe auf der Uhr auf «Gute Nacht»."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η μέτρηση ξεκινά όταν κοιμηθείς. Πάτα «Καληνύχτα» στο ρολόι σου."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Starts counting when you fall asleep. Tap “Good night” on your watch."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuenta desde que te duermes. Toca «Buenas noches» en tu reloj."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "از لحظهٔ به خواب رفتنت شمارش شروع می‌شود. روی ساعتت «شب بخیر» را بزن."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Laskenta alkaa, kun nukahdat. Napauta kellossa ”Hyvää yötä”."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le compte à rebours démarre à l'endormissement. Appuie sur « Bonne nuit » sur ta montre."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הספירה מתחילה בהירדמות. הקישו על “לילה טוב” בשעון."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "गिनती सोने के बाद शुरू होती है। घड़ी पर “शुभ रात्रि” दबाओ।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az elalvástól számít. Koppints az óránál a „Jó éjszakát” gombra."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mulai dihitung saat kamu tertidur. Ketuk “Selamat tidur” di jam tanganmu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il conto parte da quando ti addormenti. Tocca «Buonanotte» sullo smartwatch."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "眠りについた時点から計測します。ウォッチで「おやすみ」をタップしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "잠든 순간부터 계산해요. 워치에서 “잘 자요”를 탭하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pengiraan bermula apabila awak tertidur. Ketik “Selamat malam” pada jam tangan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Teller fra du sovner. Trykk på «God natt» på klokka."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Telt vanaf het moment dat je in slaap valt. Tik op je horloge op “Welterusten”."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odliczanie startuje, gdy zaśniesz. Dotknij „Dobranoc” na zegarku."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A contagem começa quando você adormece. Toque em “Boa noite” no relógio."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A contagem começa quando adormeces. Toca em “Boa noite” no relógio."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Numărătoarea începe când adormi. Atinge „Noapte bună” pe ceas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отсчёт начинается, когда ты заснёшь. Нажми «Спокойной ночи» на часах."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Räknas från att du somnar. Tryck på ”Godnatt” på klockan."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เริ่มนับเมื่อคุณหลับ แตะ “ราตรีสวัสดิ์” บนนาฬิกา"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uykuya daldığında saymaya başlar. Saatinde “İyi geceler”e dokun."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відлік починається, коли ти заснеш. Натисни «На добраніч» на годиннику."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bắt đầu tính khi bạn ngủ. Hãy chạm vào “Chúc ngủ ngon” trên đồng hồ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从你入睡时开始计时。请在手表上点按“晚安”。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "從你入睡時開始計時。請在手錶上點選「晚安」。"
          }
        }
      }
    },
