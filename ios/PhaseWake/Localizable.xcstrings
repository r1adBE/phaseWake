    "watch_not_armed": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "افتح Phase Wake قبل أن تنام لتتمكن ساعتك من تفعيل المنبه."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Před spaním otevři Phase Wake, aby mohly hodinky budík aktivovat."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Åbn Phase Wake, før du går i seng, så dit ur kan aktivere alarmen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne Phase Wake vor dem Schlafen, damit die Uhr den Wecker scharf schaltet."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Άνοιξε το Phase Wake πριν κοιμηθείς, ώστε το ρολόι σου να ενεργοποιήσει το ξυπνητήρι."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Phase Wake before you go to sleep so your watch can arm the alarm."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre Phase Wake antes de dormir para que tu reloj pueda activar la alarma."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "پیش از خواب Phase Wake را باز کن تا ساعتت بتواند زنگ را فعال کند."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Avaa Phase Wake ennen nukkumaanmenoa, jotta kellosi voi aktivoida herätyksen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvre Phase Wake avant de dormir pour que ta montre puisse activer l’alarme."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "פתחו את Phase Wake לפני השינה כדי שהשעון יוכל להפעיל את המעורר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सोने से पहले Phase Wake खोलें, ताकि आपकी वॉच अलार्म को सक्रिय कर सके।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Lefekvés előtt nyisd meg a Phase Wake-et, hogy az órád élesíthesse az ébresztőt."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Buka Phase Wake sebelum tidur agar jam tanganmu bisa mengaktifkan alarm."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apri Phase Wake prima di dormire, così il tuo orologio può attivare la sveglia."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "眠る前にPhase Wakeを開いてください。ウォッチがアラームを有効にできるようになります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "잠들기 전에 Phase Wake를 열어 주세요. 그래야 워치가 알람을 활성화할 수 있어요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Buka Phase Wake sebelum awak tidur supaya jam tangan boleh mengaktifkan penggera."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Åpne Phase Wake før du legger deg, så klokken kan aktivere alarmen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Phase Wake voordat je gaat slapen, zodat je horloge de wekker kan activeren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Otwórz Phase Wake przed snem, aby zegarek mógł aktywować budzik."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra o Phase Wake antes de dormir para que seu relógio possa ativar o alarme."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre o Phase Wake antes de dormires para que o relógio possa ativar o alarme."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Deschide Phase Wake înainte de culcare, ca ceasul să poată activa alarma."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Открой Phase Wake перед сном, чтобы часы могли активировать будильник."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Öppna Phase Wake innan du somnar så att klockan kan aktivera alarmet."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปิด Phase Wake ก่อนเข้านอน เพื่อให้นาฬิกาเปิดใช้งานนาฬิกาปลุกได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uyumadan önce Phase Wake’i aç; böylece saatin alarmı etkinleştirebilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відкрий Phase Wake перед сном, щоб годинник міг активувати будильник."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy mở Phase Wake trước khi đi ngủ để đồng hồ có thể kích hoạt báo thức."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "睡觉前请打开 Phase Wake，这样你的手表才能启用闹钟。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "睡覺前請開啟 Phase Wake，這樣你的手錶才能啟用鬧鐘。"
          }
        }
      }
    },
