            "value": "يرنّ مع الساعة، ويرنّ وحده إن لم تستجب الساعة."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zvoní s hodinkami – a sám, pokud hodinky nereagují."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ringer sammen med uret, og af sig selv, hvis uret ikke reagerer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Klingelt mit der Uhr – und allein, falls sich die Uhr nicht meldet."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Χτυπά μαζί με το ρολόι και μόνο του, αν το ρολόι δεν απαντήσει."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rings with your watch, and on its own if the watch doesn’t respond."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Suena con tu reloj, y por sí solo si el reloj no responde."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "همراه ساعت زنگ می‌خورد، و اگر ساعت جواب نداد، خودش."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Soi kellon kanssa ja itsenäisesti, jos kello ei vastaa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sonne avec ta montre, et seul si elle ne répond pas."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מצלצל יחד עם השעון, ולבד אם השעון לא מגיב."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "घड़ी के साथ बजता है, और घड़ी जवाब न दे तो अकेले भी।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az órával együtt csörög, és magától is, ha az óra nem jelez."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Berdering bersama jam tangan, dan sendiri jika jam tangan tidak merespons."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Suona con lo smartwatch, e da sola se lo smartwatch non risponde."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ウォッチと一緒に鳴り、ウォッチが反応しないときはスマートフォンだけで鳴ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "워치와 함께 울리고, 워치가 반응하지 않으면 휴대폰만 울려요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Berbunyi bersama jam tangan, dan sendiri jika jam tangan tidak bertindak balas."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ringer sammen med klokka, og av seg selv hvis klokka ikke svarer."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gaat af met je horloge, en alleen als het horloge niet reageert."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dzwoni razem z zegarkiem, a sam – gdy zegarek nie odpowie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca com o relógio, e sozinho se o relógio não responder."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca com o relógio, e sozinho se o relógio não responder."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Sună împreună cu ceasul și singur, dacă ceasul nu răspunde."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Звонит вместе с часами, а если часы не ответят — сам."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ringer med klockan, och på egen hand om klockan inte svarar."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ดังพร้อมกับนาฬิกา และดังเองหากนาฬิกาไม่ตอบสนอง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saatle birlikte çalar, saat yanıt vermezse tek başına da çalar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дзвонить разом із годинником, а якщо годинник не відповість — сам."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đổ chuông cùng đồng hồ, và tự đổ chuông nếu đồng hồ không phản hồi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "与手表一起响铃；手表没有响应时，手机会单独响铃。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "與手錶一起響鈴；手錶沒有回應時，手機會單獨響鈴。"
          }
        }
      }
    },
