    "channel_window_description": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تظهر أثناء ترقّب Phase Wake للنوم الخفيف."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zobrazeno, zatímco Phase Wake hlídá lehký spánek."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vises, mens Phase Wake holder øje med let søvn."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erscheint, während Phase Wake auf leichten Schlaf wartet."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Εμφανίζεται όσο το Phase Wake περιμένει ελαφρύ ύπνο."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shown while Phase Wake watches for light sleep."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se muestra mientras Phase Wake espera el sueño ligero."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "تا وقتی Phase Wake مراقب خواب سبک است نمایش داده می‌شود."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Näkyy, kun Phase Wake seuraa kevyttä unta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affiché pendant que Phase Wake guette le sommeil léger."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מוצג בזמן ההמתנה של Phase Wake לשינה קלה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जब तक Phase Wake हल्की नींद पर नज़र रखता है, तब तक दिखता है।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Addig látszik, amíg a Phase Wake a könnyű alvást figyeli."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tampil saat Phase Wake memantau tidur ringan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostrata mentre Phase Wake cerca il sonno leggero."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wakeが浅い眠りを見守っている間に表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake가 얕은 잠을 살피는 동안 표시돼요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Dipaparkan semasa Phase Wake memantau tidur ringan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Vises mens Phase Wake følger med på lett søvn."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zichtbaar terwijl Phase Wake op lichte slaap wacht."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Widoczne, gdy Phase Wake czeka na lekki sen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aparece enquanto o Phase Wake espera o sono leve."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Aparece enquanto o Phase Wake aguarda o sono leve."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Apare cât timp Phase Wake urmărește somnul ușor."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показывается, пока Phase Wake следит за лёгким сном."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Visas medan Phase Wake bevakar lätt sömn."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แสดงขณะที่ Phase Wake เฝ้าดูการหลับตื้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake hafif uykuyu beklerken gösterilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Показується, поки Phase Wake стежить за легким сном."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiển thị khi Phase Wake đang theo dõi giấc ngủ nông."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake 监测浅睡期间显示。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake 監測淺眠期間顯示。"
          }
        }
      }
    },
