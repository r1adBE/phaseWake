    "editor_alert_hint": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يأتي الصوت دائمًا مع الاهتزاز. تعمل المنبّهات أيضًا مع وضع عدم الإزعاج ووضع وقت النوم والهاتف الصامت."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zvuk vždy doprovází vibrace. Budíky zvoní i v režimu Nerušit, ve spánkovém režimu a při ztlumeném telefonu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Lyd kommer altid med vibration. Alarmer ringer også i Forstyr ikke, sengetidstilstand og med lydløs telefon."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ton kommt immer mit Vibration. Wecker klingeln auch bei «Nicht stören», im Bettzeitmodus und bei lautlosem Handy."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ο ήχος συνοδεύεται πάντα από δόνηση. Τα ξυπνητήρια χτυπούν και με «Μην ενοχλείτε», σε λειτουργία ώρας ύπνου και με σίγαση."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sound always comes with vibration. Alarms also ring with Do Not Disturb, bedtime mode and a silent phone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El sonido siempre va con vibración. Las alarmas suenan también con No molestar, el modo hora de dormir y el móvil en silencio."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "صدا همیشه با لرزش همراه است. زنگ‌ها در حالت «مزاحم نشو»، حالت زمان خواب و گوشی بی‌صدا هم به صدا درمی‌آیند."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ääni tulee aina värinän kanssa. Herätykset soivat myös Älä häiritse -tilassa, nukkumaanmenotilassa ja äänettömällä puhelimella."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le son s'accompagne toujours de vibrations. Les alarmes sonnent aussi en mode Ne pas déranger, en mode coucher et avec un téléphone en silencieux."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "צליל תמיד מגיע עם רטט. מעוררים מצלצלים גם במצב ‘נא לא להפריע’, במצב שעת שינה ובטלפון מושתק."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आवाज़ हमेशा वाइब्रेशन के साथ आती है। अलार्म डू नॉट डिस्टर्ब, बेडटाइम मोड और साइलेंट फ़ोन में भी बजते हैं।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A hang mindig rezgéssel jár együtt. Az ébresztők Ne zavarjanak módban, lefekvési módban és némított telefonnál is szólnak."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Suara selalu disertai getaran. Alarm juga berbunyi saat Jangan Ganggu, mode waktu tidur, dan ponsel senyap."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il suono è sempre accompagnato dalla vibrazione. Le sveglie suonano anche con Non disturbare, la modalità riposo e il telefono in silenzioso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音は必ずバイブレーションと一緒に鳴ります。おやすみモードや就寝モード、マナーモード中でもアラームは鳴ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "소리는 항상 진동과 함께 울려요. 방해 금지 모드, 취침 모드, 무음일 때도 알람은 울려요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Bunyi sentiasa disertai getaran. Penggera juga berbunyi semasa Jangan Ganggu, mod waktu tidur dan telefon senyap."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Lyd kommer alltid med vibrasjon. Alarmer ringer også i Ikke forstyrr, sengetidsmodus og med lydløs telefon."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geluid komt altijd met trillen. Wekkers gaan ook af bij Niet storen, de bedtijdmodus en een telefoon op stil."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dźwięk zawsze idzie z wibracją. Budziki dzwonią też w trybie Nie przeszkadzać, w trybie snu i na wyciszonym telefonie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O som sempre vem com vibração. Os alarmes tocam também com Não perturbe, modo hora de dormir e celular no silencioso."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O som vem sempre com vibração. Os alarmes tocam também com Não incomodar, modo de deitar e telemóvel em silêncio."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunetul vine mereu cu vibrație. Alarmele sună și în modul Nu deranja, în modul de culcare și cu telefonul pe silențios."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Звук всегда идёт с вибрацией. Будильники звонят и в режиме «Не беспокоить», в режиме сна и на беззвучном телефоне."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ljud kommer alltid med vibration. Larm ringer även i Stör ej, sänggåendeläge och med ljudlös mobil."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เสียงจะมาพร้อมการสั่นเสมอ นาฬิกาปลุกดังแม้เปิดโหมดห้ามรบกวน โหมดเวลานอน หรือปิดเสียงโทรศัพท์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ses her zaman titreşimle birlikte gelir. Alarmlar Rahatsız Etme, uyku vakti modu ve sessiz telefonda da çalar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Звук завжди йде з вібрацією. Будильники дзвонять і в режимі «Не турбувати», у режимі сну та на беззвучному телефоні."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Âm thanh luôn đi kèm rung. Báo thức vẫn đổ chuông khi bật Không làm phiền, chế độ giờ đi ngủ hoặc điện thoại im lặng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "响铃时总会同时振动。即使开启勿扰、就寝模式或手机静音，闹钟也会响。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
