    "settings_export_hint": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ساهموا في تحسين الرصد: ملف CSV بلا أسماء أو تواريخ أو معرّفات أجهزة."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pomoz vylepšit rozpoznávání: CSV bez jmen, dat a ID zařízení."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hjælp med at forbedre registreringen: CSV uden navne, datoer eller enheds-id."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hilf mit, die Erkennung zu verbessern: CSV ohne Namen, Datum oder Gerätekennung."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Βοήθησε να βελτιωθεί η ανίχνευση: CSV χωρίς ονόματα, ημερομηνίες ή αναγνωριστικά συσκευής."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Help improve detection: CSV without names, dates or device IDs."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayuda a mejorar la detección: CSV sin nombres, fechas ni ID de dispositivo."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "به بهتر شدن تشخیص کمک کن: فایل CSV بدون نام، تاریخ یا شناسهٔ دستگاه."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Auta parantamaan tunnistusta: CSV ilman nimiä, päivämääriä tai laitetunnisteita."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aide à améliorer la détection : CSV sans noms, dates ni identifiants d'appareil."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "עזרו לשפר את הזיהוי: קובץ CSV בלי שמות, תאריכים או מזהי מכשיר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पहचान बेहतर बनाने में मदद करो: बिना नाम, तारीख़ या डिवाइस ID की CSV।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Segíts a felismerés javításában: CSV nevek, dátumok és eszközazonosítók nélkül."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Bantu tingkatkan deteksi: CSV tanpa nama, tanggal, atau ID perangkat."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aiuta a migliorare il rilevamento: CSV senza nomi, date o ID del dispositivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "検出精度の向上にご協力ください。名前・日付・端末IDを含まないCSVです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "감지 정확도 개선에 도움을 주세요. 이름, 날짜, 기기 ID가 없는 CSV예요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Bantu tingkatkan pengesanan: CSV tanpa nama, tarikh atau ID peranti."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hjelp til med å forbedre gjenkjenningen: CSV uten navn, datoer eller enhets-ID."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Help de herkenning te verbeteren: CSV zonder namen, datums of apparaat-ID's."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pomóż ulepszyć wykrywanie: CSV bez imion, dat i identyfikatorów urządzeń."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajude a melhorar a detecção: CSV sem nomes, datas ou ID do dispositivo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajuda a melhorar a deteção: CSV sem nomes, datas nem IDs de dispositivo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajută la îmbunătățirea detectării: CSV fără nume, date sau ID-uri de dispozitiv."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Помоги улучшить распознавание: CSV без имён, дат и ID устройств."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Hjälp till att förbättra igenkänningen: CSV utan namn, datum eller enhets-ID."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ช่วยพัฒนาการตรวจจับ: ไฟล์ CSV ที่ไม่มีชื่อ วันที่ หรือรหัสอุปกรณ์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Algılamayı geliştirmeye yardım et: isim, tarih veya cihaz kimliği içermeyen CSV."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Допоможи покращити розпізнавання: CSV без імен, дат та ідентифікаторів пристроїв."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giúp cải thiện khả năng nhận diện: tệp CSV không chứa tên, ngày hay mã thiết bị."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "帮助改进检测：CSV 文件不含姓名、日期或设备 ID。"
          }
        },
        "zh-Hant": {
