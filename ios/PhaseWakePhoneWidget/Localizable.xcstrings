          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося відновити. Нічого не змінено."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "بحالی ناکام رہی۔ کچھ نہیں بدلا گیا۔"
