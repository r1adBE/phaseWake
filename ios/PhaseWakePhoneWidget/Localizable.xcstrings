          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "ब्युँझाउने अवधिसँगै सुरु हुन्छ र लक्षित समयमा पूरा उज्यालो हुन्छ।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Begint met het venster en is op de doeltijd volledig helder."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਜਗਾਉਣ ਦੀ ਮਿਆਦ ਨਾਲ ਸ਼ੁਰੂ ਹੁੰਦਾ ਹੈ ਅਤੇ ਟੀਚੇ ਦੇ ਸਮੇਂ ’ਤੇ ਪੂਰਾ ਚਮਕਦਾਰ ਹੁੰਦਾ ਹੈ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
