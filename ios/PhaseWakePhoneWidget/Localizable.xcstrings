        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਸੌਣ ਤੋਂ ਪਹਿਲਾਂ ਆਪਣੀ Apple Watch ’ਤੇ Phase Wake ਖੋਲ੍ਹੋ। watchOS ਸਿਰਫ਼ ਐਪ ਖੁੱਲ੍ਹੀ ਹੋਣ ’ਤੇ ਹੀ ਅਲਾਰਮ ਸਰਗਰਮ ਕਰਦਾ ਹੈ।"
          }
        },
        "pl": {
          "stringUnit": {
