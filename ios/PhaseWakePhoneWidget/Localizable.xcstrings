        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "នាឡិកាបានភ្ជាប់ ម៉ោងរោទ៍បានអនុញ្ញាត។ ចុចដើម្បីមើលព័ត៌មានលម្អិត។"
