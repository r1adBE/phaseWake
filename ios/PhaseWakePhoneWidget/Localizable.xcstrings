        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "גם לילות מ־Apple Health ומאפליקציות אחרות יכולים להופיע כאן. כדי לראות אותם, השוו לנתוני בריאות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Health और दूसरे ऐप की रातें भी यहाँ दिख सकती हैं। उन्हें देखने के लिए हेल्थ डेटा से मिलान करो।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovdje se mogu prikazati i noći iz aplikacije Apple Health i drugih aplikacija. Da ih vidiš, usporedi sa zdravstvenim podacima."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Apple Health és más alkalmazások éjszakái is megjelenhetnek itt. Ha látni szeretnéd őket, vesd össze az egészségügyi adatokkal."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Այստեղ կարող են երևալ նաև Apple Health-ի և այլ հավելվածների գիշերները։ Դրանք տեսնելու համար համեմատիր առողջության տվյալների հետ։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Malam dari Apple Health dan aplikasi lain juga bisa muncul di sini. Untuk melihatnya, cocokkan dengan data kesehatan."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Nætur úr Apple Health og öðrum forritum geta líka birst hér. Berðu saman við heilsugögn til að sjá þær."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Qui possono comparire anche le notti di Apple Health e di altre app. Per vederle, confronta con i dati di salute."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Health やほかのアプリの夜もここに表示できます。表示するには、ヘルスデータと照合してください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "აქ შეიძლება გამოჩნდეს Apple Health-ისა და სხვა აპების ღამეებიც. მათ სანახავად შეადარე ჯანმრთელობის მონაცემებს."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Мұнда Apple Health және басқа қолданбалардың түндері де көрсетілуі мүмкін. Оларды көру үшін денсаулық деректерімен салыстыр."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "យប់ពី Apple Health និងកម្មវិធីផ្សេងទៀតក៏អាចបង្ហាញនៅទីនេះដែរ។ ដើម្បីមើលវា សូមប្រៀបធៀបជាមួយទិន្នន័យសុខភាព។"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Health ಮತ್ತು ಇತರ ಆ್ಯಪ್‌ಗಳ ರಾತ್ರಿಗಳೂ ಇಲ್ಲಿ ಕಾಣಿಸಬಹುದು. ಅವುಗಳನ್ನು ನೋಡಲು, ಆರೋಗ್ಯ ಡೇಟಾದೊಂದಿಗೆ ಹೋಲಿಸಿ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Health와 다른 앱의 밤도 여기에 표시될 수 있어요. 보려면 건강 데이터와 비교하세요."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ຄືນຈາກ Apple Health ແລະ ແອັບອື່ນກໍສາມາດສະແດງຢູ່ນີ້ໄດ້. ເພື່ອເບິ່ງ ໃຫ້ປຽບທຽບກັບຂໍ້ມູນສຸຂະພາບ."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Čia gali būti rodomos ir naktys iš programos Apple Health bei kitų programų. Kad jas matytum, palygink su sveikatos duomenimis."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Šeit var parādīties arī naktis no lietotnes Apple Health un citām lietotnēm. Lai tās redzētu, salīdzini ar veselības datiem."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тука може да се појават и ноќи од Apple Health и други апликации. За да ги видиш, спореди со здравствените податоци."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Health-ൽ നിന്നും മറ്റ് ആപ്പുകളിൽ നിന്നുമുള്ള രാത്രികളും ഇവിടെ കാണാം. അവ കാണാൻ, ആരോഗ്യ ഡാറ്റയുമായി താരതമ്യം ചെയ്യുക."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Health болон бусад аппын шөнүүд ч энд харагдаж болно. Тэдгээрийг харахын тулд эрүүл мэндийн өгөгдөлтэй харьцуул."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Health आणि इतर ॲप्समधील रात्रीही इथे दिसू शकतात. त्या पाहण्यासाठी हेल्थ डेटाशी तुलना करा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Malam daripada Apple Health dan apl lain juga boleh muncul di sini. Untuk melihatnya, banding dengan data kesihatan."
          }
        },
        "my": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Health နှင့် အခြားအက်ပ်များမှ ညများကိုလည်း ဤနေရာတွင် ပြနိုင်သည်။ ကြည့်ရန် ကျန်းမာရေးဒေတာနှင့် နှိုင်းယှဉ်ပါ။"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Netter fra Apple Health og andre apper kan også vises her. Sammenlign med helsedata for å se dem."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Health र अन्य एपका रातहरू पनि यहाँ देखिन सक्छन्। तिनलाई हेर्न स्वास्थ्य डेटासँग तुलना गर।"
          }
