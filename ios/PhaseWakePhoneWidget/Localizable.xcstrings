    "history_health_live": {
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Uit %1$@. Phase Wake neem veranderinge en skrappings daar outomaties oor."
          }
        },
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "ከ%1$@። እዚያ የሚደረጉ ለውጦችንና ስረዛዎችን Phase Wake በራስ-ሰር ይከተላል።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "من %1$@. يطبّق Phase Wake التغييرات وعمليات الحذف هناك تلقائيًا."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Mənbə: %1$@. Orada edilən dəyişiklikləri və silinmələri Phase Wake avtomatik tətbiq edir."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "От %1$@. Phase Wake прилага автоматично промените и изтриванията там."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ থেকে। সেখানে করা বদল ও মুছে ফেলা Phase Wake নিজে থেকেই মেনে নেয়।"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Iz aplikacije %1$@. Phase Wake automatski preuzima izmjene i brisanja napravljena tamo."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "De %1$@. Phase Wake aplica automàticament els canvis i les eliminacions que s’hi facin."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Z aplikace %1$@. Změny a smazání provedená tam Phase Wake převezme automaticky."
          }
        },
        "da": {
