        "my": {
          "stringUnit": {
            "state": "translated",
            "value": "နှိုးချိန်အပိုင်း လည်ပတ်နေ – ယခု တိုင်းတာနေသည်"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Vinduet pågår – måler nå"
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "ब्युँझाउने अवधि चलिरहेको छ – अहिले मापन हुँदैछ"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Venster loopt – er wordt nu gemeten"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਜਗਾਉਣ ਦੀ ਮਿਆਦ ਜਾਰੀ – ਹੁਣ ਮਾਪ ਹੋ ਰਿਹਾ ਹੈ"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Okno trwa – trwa pomiar"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Janela em andamento – medindo agora"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Janela em curso – a medir agora"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Intervalul este în desfășurare – se măsoară acum"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Окно идёт – сейчас идёт измерение"
          }
        },
        "si": {
          "stringUnit": {
            "state": "translated",
            "value": "අවදි පරාසය ක්‍රියාත්මකයි – දැන් මනිමින්"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Okno budenia beží – prebieha meranie"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Okno bujenja teče – meritev poteka"
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Intervali i zgjimit po vazhdon – po matet tani"
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Интервал буђења траје – мерење је у току"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Fönstret pågår – mäter nu"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Kipindi cha kuamka kinaendelea – inapima sasa"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "எழுப்பும் வரம்பு நடக்கிறது – இப்போது அளவிடுகிறது"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "నిద్రలేపే వ్యవధి నడుస్తోంది – ఇప్పుడు కొలుస్తోంది"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ช่วงเวลาปลุกกำลังทำงาน – กำลังวัดอยู่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aralık sürüyor – şu an ölçülüyor"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вікно триває – зараз іде вимірювання"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "جاگنے کی ونڈو جاری – پیمائش ہو رہی ہے"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygʻotish oraligʻi boshlandi – oʻlchanmoqda"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khoảng thời gian đang chạy – đang đo"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "喚醒時段進行中 – 正在測量"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "时间窗运行中——正在监测"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "喚醒時段進行中——正在偵測"
          }
        },
        "zu": {
          "stringUnit": {
            "state": "translated",
            "value": "Isikhala sokuvuka siyaqhubeka – kuyalinganiswa manje"
          }
        }
      }
    },
