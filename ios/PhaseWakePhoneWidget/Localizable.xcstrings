    "home_no_alarm_text": {
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Stel ’n tyd en ’n venster. Jou horlosie maak jou daarin wakker sodra jy onrustig word."
          }
        },
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "ሰዓትና የጊዜ ክልል ያዘጋጁ። እረፍት ማጣት ሲጀምሩ ሰዓትዎ በክልሉ ውስጥ ይቀሰቅስዎታል።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضبطوا وقتًا ونافذة زمنية. تُوقظك ساعتك خلالها بمجرد أن تبدأ بالتململ."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaxt və pəncərə seç. Narahat olmağa başlayan kimi saatın səni həmin pəncərədə oyadır."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Задай час и прозорец. Часовникът ще те събуди в него, щом сънят ти стане неспокоен."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "একটা সময় আর সময়সীমা ঠিক করো। তুমি অস্থির হতে শুরু করলেই ঘড়ি সেই সময়সীমায় তোমাকে জাগাবে।"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Postavi vrijeme i interval. Sat te u njemu budi čim ti san postane nemiran."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Tria una hora i una finestra. El rellotge et desperta dins seu tan bon punt el son es torna inquiet."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nastav čas a okno. Hodinky tě v něm vzbudí, jakmile začne být tvůj spánek neklidný."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vælg et tidspunkt og et vindue. Dit ur vækker dig i det, så snart du bliver urolig."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stell eine Zeit und ein Fenster ein. Deine Uhr weckt dich darin, sobald du unruhig wirst."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Όρισε ώρα και παράθυρο. Το ρολόι σε ξυπνά μέσα σε αυτό μόλις ο ύπνος σου γίνει ανήσυχος."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set a time and a window. Your watch wakes you within it once you get restless."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige una hora y una ventana. Tu reloj te despierta dentro de ella en cuanto te inquietas."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Määra aeg ja äratusaken. Kell äratab sind selle sees kohe, kui su uni muutub rahutuks."
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ezarri ordu bat eta leiho bat. Erlojuak leihoaren barruan esnatuko zaitu, ezinegona hasten zaizun unean."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "یک زمان و یک بازه تعیین کن. ساعتت در همان بازه، به‌محض اینکه بی‌قرار شوی، بیدارت می‌کند."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Aseta aika ja aikaikkuna. Kellosi herättää sinut sen aikana heti, kun unesi muuttuu levottomaksi."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Magtakda ng oras at window. Gigisingin ka ng relo mo sa loob nito sa sandaling hindi ka na mapakali."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisis une heure et une plage. Ta montre t’y réveille dès que ton sommeil devient agité."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Socraigh am agus fuinneog. Dúiseoidh an t-uaireadóir thú laistigh di chomh luath is a éiríonn tú corrthónach."
          }
        },
        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolle unha hora e unha xanela. O reloxo espértate dentro dela en canto te inquietas."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "સમય અને સમયગાળો પસંદ કરો. તમે બેચેન થવા લાગો કે તરત ઘડિયાળ તમને તેમાં જગાડશે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "קבעו שעה וחלון זמן. השעון יעיר אתכם בתוכו ברגע שהשינה נעשית חסרת מנוחה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "समय और विंडो चुनो। जैसे ही तुम बेचैन होने लगोगे, घड़ी तुम्हें उसी विंडो में जगा देगी।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Postavi vrijeme i interval. Sat te u njemu budi čim ti san postane nemiran."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Állíts be egy időpontot és egy időablakot. Az órád ezen belül ébreszt, amint nyugtalan leszel."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Սահմանիր ժամը և պատուհանը։ Ժամացույցդ քեզ կարթնացնի դրա ընթացքում, հենց որ անհանգիստ դառնաս։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Atur waktu dan rentang. Jam tanganmu membangunkanmu di dalamnya begitu kamu mulai gelisah."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Veldu tíma og glugga. Úrið vekur þig innan hans um leið og svefninn verður órólegur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli un orario e una finestra. Il tuo smartwatch ti sveglia al suo interno non appena il sonno si fa agitato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "時刻と時間幅を設定してください。眠りが落ち着かなくなったら、ウォッチがその中で起こします。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "დააყენე დრო და ფანჯარა. საათი მასში გაგაღვიძებს, როგორც კი მოუსვენარი გახდები."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Уақыт пен терезені орнат. Мазасыздана бастасаң, сағатың сені сол терезе ішінде оятады."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "កំណត់ម៉ោង និងចន្លោះពេល។ នាឡិកានឹងដាស់អ្នកក្នុងចន្លោះនោះ ភ្លាមៗនៅពេលអ្នកចាប់ផ្ដើមដេកមិនស្ងប់។"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಸಮಯ ಮತ್ತು ಅವಧಿಯನ್ನು ಹೊಂದಿಸಿ. ನೀವು ಚಡಪಡಿಸಲು ಶುರುಮಾಡಿದ ತಕ್ಷಣ ವಾಚ್ ಆ ಅವಧಿಯೊಳಗೆ ನಿಮ್ಮನ್ನು ಎಬ್ಬಿಸುತ್ತದೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시간과 범위를 정해 보세요. 뒤척이기 시작하면 워치가 그 범위 안에서 깨워 드려요."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ຕັ້ງເວລາ ແລະ ຊ່ວງເວລາ ໂມງຈະປຸກເຈົ້າໃນຊ່ວງນັ້ນ ທັນທີທີ່ເຈົ້າເລີ່ມນອນບໍ່ສະຫງົບ"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Nustatyk laiką ir žadinimo langą. Laikrodis pažadins tave jame, vos tik tavo miegas taps neramus."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Iestati laiku un modināšanas logu. Pulkstenis tevi tajā pamodina, tiklīdz tavs miegs kļūst nemierīgs."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Постави време и прозорец. Часовникот те буди во него штом сонот ти стане немирен."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഒരു സമയവും സമയപരിധിയും സജ്ജമാക്കുക. നിങ്ങൾ അസ്വസ്ഥരാകാൻ തുടങ്ങുമ്പോൾത്തന്നെ വാച്ച് ആ സമയപരിധിക്കുള്ളിൽ ഉണർത്തും."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Цаг болон хугацаа тохируул. Тайван бус унтаж эхлэхэд цаг чинь чамайг тэр хугацааны дотор сэрээнэ."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "वेळ आणि कालावधी निवडा. तुम्ही अस्वस्थ होऊ लागताच घड्याळ तुम्हाला त्या कालावधीत उठवेल."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tetapkan masa dan tetingkap. Jam tangan akan bangunkan awak di dalamnya sebaik sahaja awak mula gelisah."
          }
        },
        "my": {
          "stringUnit": {
            "state": "translated",
            "value": "အချိန်နှင့် အချိန်အပိုင်းကို သတ်မှတ်ပါ။ မငြိမ်မသက် ဖြစ်လာသည်နှင့် နာရီက ထိုအပိုင်းအတွင်း နှိုးပေးမည်။"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Velg et tidspunkt og et vindu. Klokka vekker deg innenfor det så snart du blir urolig."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "समय र अवधि सेट गर। तिमी छटपटिन थाल्नेबित्तिकै तिम्रो घडीले तिमीलाई त्यही अवधिभित्र ब्युँझाउँछ।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stel een tijd en een venster in. Je horloge wekt je daarbinnen zodra je onrustig wordt."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਸਮਾਂ ਅਤੇ ਮਿਆਦ ਚੁਣੋ। ਜਿਵੇਂ ਹੀ ਤੁਸੀਂ ਬੇਚੈਨ ਹੋਣ ਲੱਗੋਗੇ, ਘੜੀ ਤੁਹਾਨੂੰ ਉਸ ਮਿਆਦ ਵਿੱਚ ਜਗਾ ਦੇਵੇਗੀ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ustaw godzinę i okno. Zegarek obudzi cię w nim, gdy tylko twój sen stanie się niespokojny."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Defina um horário e uma janela. Seu relógio acorda você dentro dela assim que seu sono fica agitado."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Define uma hora e uma janela. O teu relógio acorda-te dentro dela assim que o teu sono fica agitado."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Alege o oră și un interval. Ceasul te trezește în el imediat ce somnul tău devine agitat."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Задай время и окно. Часы разбудят тебя в нём, как только сон станет беспокойным."
          }
        },
        "si": {
          "stringUnit": {
            "state": "translated",
            "value": "වේලාවක් සහ පරාසයක් සකසන්න. ඔබ නොසන්සුන් වීමට පටන් ගත් වහාම ඔරලෝසුව එම පරාසය තුළ ඔබව අවදි කරයි."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Nastav čas a okno. Hodinky ťa v ňom zobudia, len čo sa tvoj spánok stane nepokojným."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nastavi čas in okno. Ura te v njem zbudi, takoj ko postane tvoj spanec nemiren."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Cakto kohën dhe intervalin. Ora jote të zgjon brenda tij sapo gjumi yt bëhet i shqetësuar."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Подеси време и интервал. Сат те у њему буди чим ти сан постане немиран."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ställ in en tid och ett intervall. Klockan väcker dig inom det så snart sömnen blir orolig."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Weka muda na kipindi. Saa yako inakuamsha ndani yake mara tu unapoanza kutotulia."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஒரு நேரத்தையும் வரம்பையும் அமையுங்கள். நீங்கள் அமைதியின்றி அசையத் தொடங்கியதும் வாட்ச் அந்த வரம்புக்குள் உங்களை எழுப்பும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "సమయం, వ్యవధి ఎంచుకోండి. మీరు అశాంతిగా కదలడం మొదలుపెట్టగానే వాచ్ ఆ వ్యవధిలో మిమ్మల్ని లేపుతుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตั้งเวลาและช่วงเวลาปลุก นาฬิกาจะปลุกคุณในช่วงนั้นทันทีที่คุณเริ่มนอนกระสับกระส่าย"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir saat ve bir aralık belirle. Saatin, huzursuzlanmaya başladığın anda seni bu aralıkta uyandırır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Задай час і вікно. Годинник розбудить тебе в ньому, щойно сон стане неспокійним."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "وقت اور ونڈو مقرر کرو۔ جیسے ہی تم بے چین ہونے لگو گے، گھڑی تمہیں اسی ونڈو میں جگا دے گی۔"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaqt va oraliqni belgila. Bezovtalana boshlashing bilan soating seni shu oraliq ichida uygʻotadi."
