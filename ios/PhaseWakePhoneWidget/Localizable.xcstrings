    "learn_text": {
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake meet %1$lld nagte lank met jou horlosie om die wekker by jou aan te pas. Dra dit snags met minstens %2$lld %% battery."
          }
        },
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake ማንቂያውን ለአንተ ለማስማማት በሰዓትህ %1$lld ሌሊቶችን ይለካል። ሌሊት ቢያንስ %2$lld %% ባትሪ ይዘህ አድርገው።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يقيس Phase Wake لمدة %1$lld ليالٍ بساعتك ليضبط المنبّه على مقاسك. ارتدِها ليلًا وبطاريتها %2$lld %% على الأقل."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake zəngli saatı sənə uyğunlaşdırmaq üçün saatınla %1$lld gecə ölçür. Gecələr ən azı %2$lld %% batareya ilə tax."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake мери %1$lld нощи с часовника ти, за да нагласи будилника според теб. Носи го нощем с поне %2$lld %% батерия."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "তোমার জন্য অ্যালার্ম মানিয়ে নিতে Phase Wake তোমার ঘড়ি দিয়ে %1$lld রাত মাপে। রাতে অন্তত %2$lld %% চার্জ রেখে ঘড়িটি পরো।"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake %1$lld noći mjeri s tvojim satom kako bi budilicu prilagodio tebi. Nosi ga noću s najmanje %2$lld %% baterije."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Durant %1$lld nits, Phase Wake mesura amb el teu rellotge per adaptar-te l’alarma. Porta’l a la nit amb almenys un %2$lld %% de bateria."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake měří %1$lld nocí s tvými hodinkami, aby budík přizpůsobil tobě. Nos je v noci s alespoň %2$lld %% baterie."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "I %1$lld nætter måler Phase Wake med dit ur for at tilpasse vækkeuret til dig. Bær det om natten med mindst %2$lld %% batteri."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake misst %1$lld Nächte mit deiner Uhr, um den Wecker an dich anzupassen. Trag sie nachts mit mindestens %2$lld %% Akku."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Για %1$lld νύχτες το Phase Wake μετρά με το ρολόι σου για να προσαρμόσει το ξυπνητήρι σε σένα. Φόρα το τη νύχτα με τουλάχιστον %2$lld %% μπαταρία."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For %1$lld nights, Phase Wake measures with your watch to adapt the alarm to you. Wear it at night with at least %2$lld %% battery."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Durante %1$lld noches, Phase Wake mide con tu reloj para adaptar la alarma a ti. Llévalo por la noche con al menos un %2$lld %% de batería."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake mõõdab %1$lld ööd sinu kellaga, et äratus sulle sobiks. Kanna seda öösel vähemalt %2$lld %% akuga."
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake-k %1$lld gauez neurtzen du zure erlojuarekin, alarma zuri egokitzeko. Eraman ezazu gauez, gutxienez %%%2$lld bateriarekin."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake به‌مدت %1$lld شب با ساعتت اندازه می‌گیرد تا زنگ را با تو هماهنگ کند. شب‌ها آن را با دست‌کم %2$lld %% باتری ببند."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake mittaa kellollasi %1$lld yötä sovittaakseen herätyksen sinulle. Pidä sitä yöllä vähintään %2$lld %%:n akulla."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Sa loob ng %1$lld gabi, sumusukat ang Phase Wake gamit ang relo mo para iakma sa iyo ang alarm. Isuot ito sa gabi nang may hindi bababa sa %2$lld %% na baterya."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pendant %1$lld nuits, Phase Wake mesure avec ta montre pour adapter le réveil à toi. Porte-la la nuit avec au moins %2$lld %% de batterie."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Ar feadh %1$lld oíche, tomhaiseann Phase Wake le d’uaireadóir chun an t-aláram a oiriúnú duit. Caith san oíche é le %2$lld %% ceallraí ar a laghad."
          }
        },
        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "Durante %1$lld noites, Phase Wake mide co teu reloxo para adaptarche a alarma. Lévao pola noite con polo menos un %2$lld %% de batería."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake તારા માટે અલાર્મ અનુકૂળ કરવા તારી ઘડિયાળથી %1$lld રાત માપે છે. રાત્રે ઓછામાં ઓછી %2$lld %% બેટરી સાથે પહેરજે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "במשך %1$lld לילות Phase Wake מודד עם השעון שלך כדי להתאים לך את ההשכמה. ענוד אותו בלילה עם לפחות %2$lld %% סוללה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake तुम्हारे लिए अलार्म ढालने को तुम्हारी घड़ी से %1$lld रातें मापता है। रात में कम से कम %2$lld %% बैटरी के साथ पहनो।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake %1$lld noći mjeri tvojim satom kako bi budilicu prilagodio tebi. Nosi ga noću s barem %2$lld %% baterije."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Phase Wake %1$lld éjszakán át mér az órádon, hogy az ébresztőt hozzád igazítsa. Viseld éjjel legalább %2$lld %% töltöttséggel."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake-ը %1$lld գիշեր չափում է քո ժամացույցով, որ զարթուցիչը հարմարեցնի քեզ։ Գիշերը կրիր այն առնվազն %2$lld %% մարտկոցով։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Selama %1$lld malam, Phase Wake mengukur dengan jam tanganmu untuk menyesuaikan alarm denganmu. Pakai di malam hari dengan baterai minimal %2$lld %%."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Í %1$lld nætur mælir Phase Wake með úrinu þínu til að laga vekjarann að þér. Notaðu það á nóttunni með a.m.k. %2$lld %% rafhlöðu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per %1$lld notti Phase Wake misura con il tuo orologio per adattare la sveglia a te. Indossalo di notte con almeno il %2$lld %% di batteria."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake はアラームをあなたに合わせるため、ウォッチで%1$lld夜測定します。夜はバッテリー%2$lld %%以上で着けてください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake შენი საათით %1$lld ღამეს ზომავს, რომ მაღვიძარა შენზე მოარგოს. ღამით ატარე მინიმუმ %2$lld %% ბატარეით."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake оятқышты саған бейімдеу үшін сағатыңмен %1$lld түн өлшейді. Түнде кемінде %2$lld %% батареямен тағып жүр."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake វាស់ %1$lld យប់ជាមួយនាឡិការបស់អ្នក ដើម្បីកែសម្រួលម៉ោងរោទ៍ឲ្យសមនឹងអ្នក។ ពាក់វានៅពេលយប់ដោយមានថ្មយ៉ាងហោចណាស់ %2$lld %%។"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನಿನಗೆ ತಕ್ಕಂತೆ ಅಲಾರಂ ಹೊಂದಿಸಲು Phase Wake ನಿನ್ನ ವಾಚ್‌ನಿಂದ %1$lld ರಾತ್ರಿ ಅಳೆಯುತ್ತದೆ. ರಾತ್ರಿ ಕನಿಷ್ಠ %2$lld %% ಬ್ಯಾಟರಿಯೊಂದಿಗೆ ಧರಿಸು."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake가 알람을 너에게 맞추려고 워치로 %1$lld일 밤 동안 측정해. 밤에는 배터리 %2$lld %% 이상으로 착용해 줘."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake ວັດແທກ %1$lld ຄືນດ້ວຍໂມງຂອງເຈົ້າ ເພື່ອປັບໂມງປຸກໃຫ້ເໝາະກັບເຈົ້າ. ໃສ່ມັນຕອນກາງຄືນໂດຍມີແບັດຢ່າງໜ້ອຍ %2$lld %%."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld naktis Phase Wake matuoja tavo laikrodžiu, kad pritaikytų žadintuvą tau. Nešiok jį naktį su bent %2$lld %% baterijos."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld naktis Phase Wake mēra ar tavu pulksteni, lai pielāgotu modinātāju tev. Valkā to naktī ar vismaz %2$lld %% akumulatora."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake мери %1$lld ноќи со твојот часовник за да го прилагоди будилникот кон тебе. Носи го ноќе со најмалку %2$lld %% батерија."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിനക്ക് ചേരും വിധം അലാറം ക്രമീകരിക്കാൻ Phase Wake നിന്റെ വാച്ച് ഉപയോഗിച്ച് %1$lld രാത്രി അളക്കുന്നു. രാത്രി കുറഞ്ഞത് %2$lld %% ബാറ്ററിയോടെ ധരിക്കൂ."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake сэрүүлгийг чамд тааруулахын тулд цагаар чинь %1$lld шөнө хэмжинэ. Шөнө наад зах нь %2$lld %% цэнэгтэй зүү."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुझ्यासाठी अलार्म जुळवण्यासाठी Phase Wake तुझ्या घड्याळाने %1$lld रात्री मोजते. रात्री किमान %2$lld %% बॅटरीसह घाल."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Selama %1$lld malam, Phase Wake mengukur dengan jam tanganmu untuk menyesuaikan penggera dengan kamu. Pakai pada waktu malam dengan bateri sekurang-kurangnya %2$lld %%."
          }
        },
        "my": {
          "stringUnit": {
            "state": "translated",
            "value": "နှိုးစက်ကို သင်နဲ့ကိုက်အောင် Phase Wake က သင့်နာရီနဲ့ %1$lld ည တိုင်းတာပါတယ်။ ညဘက် ဘက်ထရီ အနည်းဆုံး %2$lld %% ရှိအောင် ဝတ်ထားပါ။"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "I %1$lld netter måler Phase Wake med klokken din for å tilpasse vekkerklokken til deg. Bruk den om natten med minst %2$lld %% batteri."
