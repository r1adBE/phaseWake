        },
        "my": {
          "stringUnit": {
            "state": "translated",
            "value": "နာရီကို ဆက်သွယ်၍ မရပါ။ ဝတ်ထားပါ၊ Bluetooth ဖွင့်ထားပြီး နာရီပေါ်တွင် Phase Wake ကို တစ်ကြိမ် ဖွင့်ပါ။"
