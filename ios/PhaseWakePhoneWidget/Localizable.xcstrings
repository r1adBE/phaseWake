    "onb_done_text": {
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Jy kan later alles in die instellings verander. Goeienag!"
          }
        },
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "ሁሉንም ነገር በኋላ በቅንብሮች ውስጥ መቀየር ይችላሉ። ደህና እደሩ!"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكنك تغيير كل شيء لاحقًا في الإعدادات. تصبح على خير!"
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Hər şeyi sonra ayarlarda dəyişə bilərsən. Gecən xeyrə!"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Всичко можеш да промениш по-късно в настройките. Лека нощ!"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "পরে সেটিংসে সবকিছু বদলাতে পারবে। শুভরাত্রি!"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Sve možeš kasnije promijeniti u postavkama. Laku noć!"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Pots canviar-ho tot més endavant a la configuració. Bona nit!"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vše můžeš později změnit v nastavení. Dobrou noc!"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan ændre alt senere i indstillingerne. Godnat!"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles lässt sich später in den Einstellungen ändern. Gute Nacht!"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μπορείς να αλλάξεις τα πάντα αργότερα στις ρυθμίσεις. Καληνύχτα!"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can change everything later in the settings. Good night!"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes cambiarlo todo más tarde en los ajustes. ¡Buenas noches!"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kõike saad hiljem seadetes muuta. Head ööd!"
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "Gero dena alda dezakezu ezarpenetan. Gabon!"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "بعداً می‌توانی همه‌چیز را در تنظیمات تغییر دهی. شب بخیر!"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Voit muuttaa kaiken myöhemmin asetuksissa. Hyvää yötä!"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Puwede mong baguhin ang lahat mamaya sa mga setting. Matulog nang mahimbing!"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu peux tout modifier plus tard dans les réglages. Bonne nuit !"
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Is féidir leat gach rud a athrú níos déanaí sna socruithe. Oíche mhaith!"
          }
        },
        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "Podes cambialo todo máis tarde nos axustes. Boas noites!"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તમે પછીથી સેટિંગમાં બધું બદલી શકો છો. શુભ રાત્રિ!"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אפשר לשנות הכול מאוחר יותר בהגדרות. לילה טוב!"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप सब कुछ बाद में सेटिंग में बदल सकते हैं। शुभ रात्रि!"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sve možeš kasnije promijeniti u postavkama. Laku noć!"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Később mindent módosíthatsz a beállításokban. Jó éjszakát!"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ամեն ինչ կարող ես հետո փոխել կարգավորումներում։ Բարի գիշեր։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Semuanya bisa diubah nanti di setelan. Selamat tidur!"
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Þú getur breytt öllu seinna í stillingunum. Góða nótt!"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Puoi cambiare tutto più tardi nelle impostazioni. Buonanotte!"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべて後から設定で変更できます。おやすみなさい！"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ყველაფრის შეცვლა მოგვიანებით პარამეტრებში შეგიძლია. ძილი ნებისა!"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бәрін кейін параметрлерде өзгерте аласың. Қайырлы түн!"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "អ្នកអាចប្ដូរអ្វីៗទាំងអស់ពេលក្រោយក្នុងការកំណត់។ រាត្រីសួស្តី!"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಎಲ್ಲವನ್ನೂ ನಂತರ ಸೆಟ್ಟಿಂಗ್‌ಗಳಲ್ಲಿ ಬದಲಾಯಿಸಬಹುದು. ಶುಭ ರಾತ್ರಿ!"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "나중에 설정에서 모두 바꿀 수 있어요. 잘 자요!"
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ເຈົ້າປ່ຽນທຸກຢ່າງໄດ້ພາຍຫຼັງໃນການຕັ້ງຄ່າ ລາຕີສະຫວັດ!"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Viską vėliau gali pakeisti nustatymuose. Labanakt!"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Visu vēlāk vari mainīt iestatījumos. Ar labu nakti!"
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сè можеш да смениш подоцна во поставките. Добра ноќ!"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "എല്ലാം പിന്നീട് ക്രമീകരണത്തിൽ മാറ്റാം. ശുഭരാത്രി!"
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Бүгдийг дараа нь тохиргоонд өөрчилж болно. Сайхан амраарай!"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "सेटिंग्जमध्ये नंतर सगळं बदलू शकता. शुभ रात्री!"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Semuanya boleh diubah kemudian dalam tetapan. Selamat malam!"
          }
        },
        "my": {
          "stringUnit": {
            "state": "translated",
            "value": "နောက်ပိုင်း ဆက်တင်များတွင် အားလုံး ပြောင်းနိုင်သည်။ ကောင်းသောညပါ!"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan endre alt senere i innstillingene. God natt!"
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "सबै कुरा पछि सेटिङमा बदल्न सक्छौ। शुभ रात्रि!"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je kunt alles later in de instellingen wijzigen. Welterusten!"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਤੁਸੀਂ ਬਾਅਦ ਵਿੱਚ ਸੈਟਿੰਗਾਂ ਵਿੱਚ ਸਭ ਕੁਝ ਬਦਲ ਸਕਦੇ ਹੋ। ਸ਼ੁਭ ਰਾਤ!"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wszystko możesz później zmienić w ustawieniach. Dobranoc!"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você pode mudar tudo depois nas configurações. Boa noite!"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Podes alterar tudo mais tarde nas definições. Boa noite!"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Poți schimba totul mai târziu în setări. Noapte bună!"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Всё можно изменить позже в настройках. Спокойной ночи!"
          }
        },
        "si": {
          "stringUnit": {
            "state": "translated",
            "value": "ඔබට පසුව සැකසීම්වල සියල්ල වෙනස් කළ හැක. සුබ රාත්‍රියක්!"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Všetko môžeš neskôr zmeniť v nastaveniach. Dobrú noc!"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vse lahko pozneje spremeniš v nastavitvah. Lahko noč!"
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Mund t’i ndryshosh të gjitha më vonë te cilësimet. Natën e mirë!"
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Све можеш касније да промениш у подешавањима. Лаку ноћ!"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan ändra allt senare i inställningarna. God natt!"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Unaweza kubadilisha kila kitu baadaye kwenye mipangilio. Usiku mwema!"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "பின்னர் அமைப்புகளில் எதையும் மாற்றலாம். இனிய இரவு!"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "తర్వాత సెట్టింగ్‌లలో అన్నీ మార్చుకోవచ్చు. శుభ రాత్రి!"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปลี่ยนทุกอย่างได้ภายหลังในการตั้งค่า ฝันดี!"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her şeyi daha sonra ayarlardan değiştirebilirsin. İyi geceler!"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Усе можна змінити пізніше в налаштуваннях. Добраніч!"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "بعد میں ترتیبات میں سب کچھ بدل سکتے ہو۔ شب بخیر!"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
