    "sunrise_text": {
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Jou skerm word stadig helderder totdat jy wakker word."
          }
        },
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "እስኪነቁ ድረስ ማያ ገጽዎ ቀስ በቀስ ይደምቃል።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تزداد الشاشة سطوعًا ببطء حتى تستيقظ."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Oyanana qədər ekranın yavaş-yavaş işıqlanır."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Екранът бавно става по-светъл, докато се събудиш."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "তুমি জেগে না ওঠা পর্যন্ত স্ক্রিন ধীরে ধীরে উজ্জ্বল হয়।"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekran polako postaje svjetliji dok se ne probudiš."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "La pantalla es va il·luminant a poc a poc fins que et despertes."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Displej se pomalu rozjasňuje, dokud se neprobudíš."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Skærmen bliver langsomt lysere, indtil du vågner."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Bildschirm wird langsam heller, bis du geweckt wirst."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η οθόνη φωτίζεται σιγά σιγά μέχρι να ξυπνήσεις."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your screen slowly gets brighter until you wake up."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La pantalla se va iluminando poco a poco hasta que te despiertes."
          }
        },
        "et": {
