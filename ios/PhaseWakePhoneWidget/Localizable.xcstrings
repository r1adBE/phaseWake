          "stringUnit": {
            "state": "translated",
            "value": "Le níos lú ná %1$lld %% ceallra, ní thaifeadfaidh d’uaireadóir anocht don chéim foghlama – luchtaigh roimh ré é. Dúiseoidh an t-aláram thú mar sin féin."
          }
        },
        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "Con menos do %1$lld %% de batería, o reloxo non gravará esta noite para a fase de aprendizaxe: cárgao antes. A alarma espertarate igualmente."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld %%થી ઓછી બેટરીમાં ઘડિયાળ આજે રાત્રે શીખવાના તબક્કા માટે રેકોર્ડ કરશે નહીં – પહેલાં ચાર્જ કર. એલાર્મ તો પણ તને જગાડશે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "עם פחות מ-%1$lld %% סוללה השעון לא יקליט הלילה עבור שלב הלמידה – טען אותו מראש. ההשכמה תעיר אותך בכל זאת."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld %% से कम बैटरी पर घड़ी आज रात सीखने के चरण के लिए रिकॉर्ड नहीं करेगी – पहले चार्ज कर लो। अलार्म फिर भी तुम्हें जगाएगा।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ispod %1$lld %% baterije sat noćas neće snimati za fazu učenja – napuni ga prije toga. Alarm će te ipak probuditi."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld %% alatti akkumulátorral az óra ma éjjel nem rögzít a tanulási szakaszhoz – töltsd fel előtte. Az ébresztő így is felébreszt."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld %%-ից ցածր մարտկոցով ժամացույցն այս գիշեր չի ձայնագրի ուսուցման փուլի համար – նախապես լիցքավորիր այն։ Զարթուցիչը միևնույն է կարթնացնի քեզ։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Dengan baterai di bawah %1$lld %%, jam tanganmu tidak akan merekam untuk fase belajar malam ini – isi dayanya lebih dulu. Alarm tetap akan membangunkanmu."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Með undir %1$lld %% rafhlöðu skráir úrið ekki í nótt fyrir námsfasann – hladdu það fyrir fram. Vekjarinn vekur þig samt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Con meno del %1$lld %% di batteria, stanotte l’orologio non registrerà per la fase di apprendimento – ricaricalo prima. La sveglia ti sveglierà comunque."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バッテリーが%1$lld %%未満のため、今夜ウォッチは学習期間の記録をしません – 事前に充電してください。アラームはそれでも鳴ります。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld %%-ზე ნაკლები ბატარეით საათი ამაღამ სწავლის ფაზისთვის არ ჩაწერს – წინასწარ დატენე. მაღვიძარა მაინც გაგაღვიძებს."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Батарея %1$lld %%-дан төмен болса, сағат бүгін түнде үйрену кезеңі үшін жазбайды – алдын ала зарядта. Оятқыш бәрібір сені оятады."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ពេលថ្មទាបជាង %1$lld %% នាឡិកានឹងមិនថតសម្រាប់ដំណាក់កាលរៀននៅយប់នេះទេ – សូមសាកវាជាមុន។ ម៉ោងរោទ៍នឹងនៅតែដាស់អ្នក។"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld %% ಕ್ಕಿಂತ ಕಡಿಮೆ ಬ್ಯಾಟರಿಯಲ್ಲಿ ಇಂದು ರಾತ್ರಿ ಕಲಿಕೆಯ ಹಂತಕ್ಕಾಗಿ ವಾಚ್ ರೆಕಾರ್ಡ್ ಮಾಡುವುದಿಲ್ಲ – ಮೊದಲೇ ಚಾರ್ಜ್ ಮಾಡು. ಅಲಾರಾಂ ಆದರೂ ನಿನ್ನನ್ನು ಎಬ್ಬಿಸುತ್ತದೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "배터리가 %1$lld %% 미만이면 오늘 밤 시계가 학습 단계용으로 기록하지 않아요 – 미리 충전해 주세요. 알람은 그래도 울려요."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ເມື່ອແບັດເຕີຣີຕ່ຳກວ່າ %1$lld %% ໂມງຈະບໍ່ບັນທຶກສຳລັບໄລຍະຮຽນຮູ້ໃນຄືນນີ້ – ສາກໄວ້ກ່ອນ. ໂມງປຸກຍັງຈະປຸກເຈົ້າຢູ່."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Kai baterija mažesnė nei %1$lld %%, laikrodis šiąnakt neįrašys mokymosi etapui – įkrauk jį iš anksto. Žadintuvas vis tiek tave pažadins."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ja akumulators ir zem %1$lld %%, pulkstenis šonakt neierakstīs mācīšanās posmam – uzlādē to iepriekš. Modinātājs tevi tik un tā pamodinās."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Под %1$lld %% батерија часовникот вечерва нема да снима за фазата на учење – наполни го однапред. Алармот сепак ќе те разбуди."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld %%-ൽ താഴെ ബാറ്ററിയിൽ ഇന്ന് രാത്രി പഠന ഘട്ടത്തിനായി വാച്ച് റെക്കോർഡ് ചെയ്യില്ല – മുൻകൂട്ടി ചാർജ് ചെയ്യുക. എന്നാലും അലാറം നിന്നെ ഉണർത്തും."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Батерей %1$lld %%-иас бага бол цаг өнөө шөнө суралцах үед зориулж бичлэг хийхгүй – урьдчилан цэнэглэ. Сэрүүлэг чамайг ямар ч байсан сэрээнэ."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld %% पेक्षा कमी बॅटरीवर घड्याळ आज रात्री शिकण्याच्या टप्प्यासाठी रेकॉर्ड करणार नाही – आधीच चार्ज कर. अलार्म तरीही तुला उठवेल."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Dengan bateri di bawah %1$lld %%, jam tangan tidak akan merakam untuk fasa pembelajaran malam ini – cas dahulu. Penggera tetap akan mengejutkan awak."
          }
        },
        "my": {
          "stringUnit": {
            "state": "translated",
            "value": "ဘက်ထရီ %1$lld %% အောက်ဆိုလျှင် ယနေ့ည သင်ယူမှုအဆင့်အတွက် နာရီက မမှတ်တမ်းတင်ပါ – ကြိုတင် အားသွင်းပါ။ သို့သော် နိုးစက်က သင့်ကို နှိုးပေးမည်။"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Under %1$lld %% batteri tar ikke klokken opp for læringsfasen i natt – lad den før. Du blir vekket likevel."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld %% भन्दा कम ब्याट्रीमा घडीले आज राति सिक्ने चरणका लागि रेकर्ड गर्दैन – पहिल्यै चार्ज गर। अलार्मले तिमीलाई तैपनि उठाउनेछ।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Met minder dan %1$lld %% batterij neemt je horloge vannacht niet op voor de leerfase – laad het vooraf op. Je wordt toch gewekt."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld %% ਤੋਂ ਘੱਟ ਬੈਟਰੀ ’ਤੇ ਘੜੀ ਅੱਜ ਰਾਤ ਸਿੱਖਣ ਦੇ ਪੜਾਅ ਲਈ ਰਿਕਾਰਡ ਨਹੀਂ ਕਰੇਗੀ – ਪਹਿਲਾਂ ਚਾਰਜ ਕਰ ਲੈ। ਅਲਾਰਮ ਫਿਰ ਵੀ ਤੈਨੂੰ ਜਗਾਏਗਾ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Poniżej %1$lld %% baterii zegarek nie nagra dziś w nocy dla fazy nauki – naładuj go wcześniej. Budzik i tak cię obudzi."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Com menos de %1$lld %% de bateria, o relógio não vai gravar hoje à noite para a fase de aprendizado – carregue-o antes. O alarme vai te acordar mesmo assim."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Com menos de %1$lld %% de bateria, o relógio não vai gravar esta noite para a fase de aprendizagem – carrega-o antes. O alarme vai acordar-te na mesma."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Sub %1$lld %% baterie, ceasul nu va înregistra în noaptea asta pentru faza de învățare – încarcă-l dinainte. Alarma te va trezi oricum."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "При заряде ниже %1$lld %% часы сегодня ночью не будут записывать для этапа обучения, – заряди их заранее. Будильник всё равно тебя разбудит."
          }
        },
        "si": {
          "stringUnit": {
            "state": "translated",
            "value": "බැටරිය %1$lld %% ට අඩු නම් අද රාත්‍රියේ ඉගෙනීමේ අදියර සඳහා ඔරලෝසුව පටිගත කරන්නේ නැත – කලින්ම ආරෝපණය කරන්න. එලාමය කෙසේ වෙතත් ඔබව අවදි කරයි."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pod %1$lld %% batérie hodinky dnes v noci nebudú nahrávať pre fázu učenia – nabi ich vopred. Budík ťa aj tak zobudí."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pod %1$lld %% baterije ura nocoj ne bo snemala za fazo učenja – napolni jo vnaprej. Budilka te bo vseeno zbudila."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Me më pak se %1$lld %% bateri, ora sonte nuk do të regjistrojë për fazën e të mësuarit – karikoje më parë. Alarmi do të të zgjojë gjithsesi."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Испод %1$lld %% батерије сат ноћас неће снимати за фазу учења – напуни га пре тога. Аларм ће те ипак пробудити."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Under %1$lld %% batteri spelar klockan inte in för inlärningsfasen i natt – ladda den innan. Du blir väckt ändå."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Betri ikiwa chini ya %1$lld %%, saa haitarekodi usiku wa leo kwa hatua ya kujifunza – ichaji mapema. Kengele bado itakuamsha."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld %% க்குக் குறைவான பேட்டரியில் இன்றிரவு கற்றல் நிலைக்காகக் கடிகாரம் பதிவு செய்யாது – முன்பே சார்ஜ் செய். அலாரம் எப்படியும் உன்னை எழுப்பும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld %% కంటే తక్కువ బ్యాటరీతో ఈ రాత్రి నేర్చుకునే దశ కోసం వాచ్ రికార్డ్ చేయదు – ముందే ఛార్జ్ చెయ్యి. అయినా అలారం నిన్ను లేపుతుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เมื่อแบตเตอรี่ต่ำกว่า %1$lld %% คืนนี้นาฬิกาจะไม่บันทึกสำหรับช่วงเรียนรู้ – ชาร์จไว้ก่อน แต่นาฬิกาปลุกจะยังปลุกคุณตามปกติ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pil %1$lld %% altındayken saat bu gece öğrenme aşaması için kayıt yapmaz – önceden şarj et. Alarm seni yine de uyandıracak."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Із зарядом нижче %1$lld %% годинник цієї ночі не записуватиме для етапу навчання, – заряди його заздалегідь. Будильник усе одно тебе розбудить."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld %% سے کم بیٹری پر گھڑی آج رات سیکھنے کے مرحلے کے لیے ریکارڈ نہیں کرے گی – پہلے سے چارج کر لو۔ الارم پھر بھی تمہیں جگائے گا۔"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Batareya %1$lld %% dan kam bo‘lsa, soat bu kecha o‘rganish bosqichi uchun yozib olmaydi – oldindan quvvatla. Budilnik baribir seni uyg‘otadi."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi pin dưới %1$lld %%, đêm nay đồng hồ sẽ không ghi lại cho giai đoạn học – hãy sạc trước. Báo thức vẫn sẽ đánh thức bạn."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "電量低過 %1$lld %% 嘅時候，手錶今晚唔會為學習階段錄製——請預先充電。鬧鐘照樣會叫醒你。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "电量低于 %1$lld %% 时，手表今晚不会为学习阶段记录——请提前充电。闹钟仍会叫醒你。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "電量低於 %1$lld %% 時，手錶今晚不會為學習階段記錄——請提前充電。鬧鐘仍會叫醒你。"
          }
        },
        "zu": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma ibhethri lingaphansi kuka-%1$lld %%, iwashi ngeke liqophe namuhla ebusuku esigabeni sokufunda – lishaje kusenesikhathi. I-alamu isazokuvusa."
          }
        }
      }
    },
