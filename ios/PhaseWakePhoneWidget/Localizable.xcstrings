        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "ማንቂያዎች & አስታዋሾችን ይፍቀዱ – ያለዚህ ፍቃድ ተጠባባቂ ማንቂያው ጭራሽ ላይደውል ይችላል።"
