    "check_watch_problem": {
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Jou horlosie is nie bereikbaar nie. Dra dit, hou Bluetooth aan en maak Phase Wake een keer op die horlosie oop."
          }
        },
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "ሰዓትዎ ሊደረስበት አልቻለም። ያድርጉት፣ Bluetooth እንደበራ ያቆዩ እና Phase Wakeን በሰዓቱ ላይ አንድ ጊዜ ይክፈቱ።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذر الوصول إلى ساعتك. ارتدِها، وأبقِ Bluetooth قيد التشغيل، وافتح Phase Wake على الساعة مرة واحدة."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Saatın əlçatan deyil. Onu tax, Bluetooth-u açıq saxla və saatda Phase Wake-i bir dəfə aç."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Часовникът не е достъпен. Носи го, остави Bluetooth включен и отвори веднъж Phase Wake на часовника."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "তোমার ঘড়ির সঙ্গে যোগাযোগ হচ্ছে না। ঘড়িটা পরো, Bluetooth চালু রাখো আর ঘড়িতে একবার Phase Wake খোলো।"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Sat nije dostupan. Nosi ga, drži Bluetooth uključen i jednom otvori Phase Wake na satu."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "No es pot connectar amb el rellotge. Porta’l posat, mantén el Bluetooth activat i obre Phase Wake al rellotge una vegada."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Hodinky nejsou dostupné. Nasaď si je, nech zapnuté Bluetooth a jednou na hodinkách otevři Phase Wake."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit ur kan ikke nås. Tag det på, hold Bluetooth slået til, og åbn Phase Wake på uret én gang."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Uhr ist nicht erreichbar. Trag sie, lass Bluetooth an und öffne Phase Wake einmal auf der Uhr."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το ρολόι σου δεν είναι προσβάσιμο. Φόρεσέ το, κράτα το Bluetooth ενεργό και άνοιξε το Phase Wake στο ρολόι μία φορά."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your watch isn’t reachable. Wear it, keep Bluetooth on and open Phase Wake on the watch once."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se puede acceder a tu reloj. Póntelo, mantén el Bluetooth activado y abre Phase Wake en el reloj una vez."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kell pole kättesaadav. Kanna seda, hoia Bluetooth sees ja ava Phase Wake kellas üks kord."
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ezin da erlojura iritsi. Jantzi, utzi Bluetootha aktibatuta eta ireki Phase Wake erlojuan behin."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "به ساعتت دسترسی ندارم. آن را ببند، Bluetooth را روشن نگه دار و یک بار Phase Wake را روی ساعت باز کن."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kelloasi ei tavoiteta. Pidä se ranteessa, pidä Bluetooth päällä ja avaa Phase Wake kellossa kerran."
          }
        },
        "fil": {
          "stringUnit": {
