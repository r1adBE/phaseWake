    "holidays_hint": {
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Plaaslike vakansiedae van enkele dorpe is nie ingesluit nie."
          }
        },
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "የነጠላ ከተሞች የአካባቢ በዓላት አልተካተቱም።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا تشمل العطل المحلية لبلديات بعينها."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayrı-ayrı yaşayış məntəqələrinin yerli bayramları daxil deyil."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Местните празници на отделни селища не са включени."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আলাদা আলাদা শহরের স্থানীয় ছুটি এতে নেই।"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Lokalni praznici pojedinih mjesta nisu uključeni."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "No s’hi inclouen els festius locals de cada municipi."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Místní svátky jednotlivých obcí nejsou zahrnuty."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Lokale helligdage i enkelte kommuner er ikke med."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lokale Feiertage einzelner Gemeinden sind nicht enthalten."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι τοπικές αργίες μεμονωμένων δήμων δεν περιλαμβάνονται."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Local holidays of single towns are not included."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se incluyen los festivos locales de cada municipio."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Üksikute linnade kohalikke pühi pole arvestatud."
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "Herri bakoitzeko tokiko jaiegunak ez daude barne."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "تعطیلات محلی شهرهای جداگانه در آن نیست."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Yksittäisten kuntien paikalliset juhlapäivät eivät ole mukana."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi kasama ang mga lokal na holiday ng bawat bayan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les jours fériés locaux de certaines communes ne sont pas inclus."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Níl laethanta saoire áitiúla bailte aonair san áireamh."
          }
        },
        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "Non se inclúen os festivos locais de cada concello."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "એકલ-દોકલ શહેરોની સ્થાનિક રજાઓ સામેલ નથી."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "חגים מקומיים של יישובים בודדים אינם כלולים."
          }
        },
        "hi": {
          "stringUnit": {
