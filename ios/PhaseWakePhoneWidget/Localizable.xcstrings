        },
        "my": {
          "stringUnit": {
            "state": "translated",
            "value": "အသံသွင်းရန် Phase Wake သည် မိုက်ခရိုဖုန်း လိုအပ်သည်။ အသံသွင်းခြင်း ဖွင့်ထားချိန်တွင်သာ နားထောင်သည်။"
          }
        },
        "nb": {
