        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ფაილი შეიცავს თითოეული ღამის მოძრაობისა და პულსის მწკრივებს – სახელების, თარიღებისა და მოწყობილობის ID-ების გარეშე."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Файлда әр түннің қозғалыс және жүрек соғысы қатарлары бар – атаусыз, күнсіз және құрылғы ID-сіз."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ឯកសារមានស៊េរីចលនា និងចង្វាក់បេះដូងនៃយប់នីមួយៗ – គ្មានឈ្មោះ កាលបរិច្ឆេទ ឬ ID ឧបករណ៍។"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಫೈಲ್‌ನಲ್ಲಿ ಪ್ರತಿ ರಾತ್ರಿಯ ಚಲನೆ ಮತ್ತು ಹೃದಯ ಬಡಿತದ ಸರಣಿಗಳಿವೆ – ಹೆಸರು, ದಿನಾಂಕ ಅಥವಾ ಸಾಧನ ID ಇಲ್ಲದೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파일에는 이름, 날짜, 기기 ID 없이 밤마다의 움직임 및 심박수 데이터가 들어 있습니다."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ໄຟລ໌ມີຂໍ້ມູນການເຄື່ອນໄຫວ ແລະ ອັດຕາການເຕັ້ນຫົວໃຈຂອງແຕ່ລະຄືນ – ບໍ່ມີຊື່ ວັນທີ ຫຼື ID ອຸປະກອນ"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Faile yra kiekvienos nakties judesių ir pulso sekos – be vardų, datų ir įrenginių ID."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Failā ir katras nakts kustību un pulsa sērijas – bez vārdiem, datumiem un ierīču ID."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Датотеката содржи серии на движење и пулс за секоја ноќ – без имиња, датуми или ID на уреди."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഓരോ രാത്രിയുടെയും ചലനവും ഹൃദയമിടിപ്പും ഫയലിലുണ്ട് – പേരോ തീയതിയോ ഉപകരണ ID-യോ ഇല്ലാതെ."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Файлд шөнө бүрийн хөдөлгөөн, зүрхний цохилтын цуваа бий – нэр, огноо, төхөөрөмжийн ID-гүй."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "फाइलमध्ये प्रत्येक रात्रीच्या हालचाल आणि हृदयगतीच्या मालिका आहेत – नावे, तारखा किंवा डिव्हाइस आयडीशिवाय."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Fail ini mengandungi siri pergerakan dan kadar denyutan jantung bagi setiap malam – tanpa nama, tarikh atau ID peranti."
          }
        },
        "my": {
          "stringUnit": {
            "state": "translated",
            "value": "ဖိုင်တွင် ညတစ်ညစီ၏ လှုပ်ရှားမှုနှင့် နှလုံးခုန်နှုန်း အစဉ်များ ပါသည် – အမည်၊ ရက်စွဲ သို့မဟုတ် စက် ID မပါ။"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Filen inneholder bevegelses- og pulsserier for hver natt – uten navn, datoer eller enhets-ID-er."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "फाइलमा हरेक रातको चाल र मुटुको धड्कनको शृङ्खला हुन्छ – नाम, मिति वा डिभाइस ID बिना।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het bestand bevat bewegings- en hartslagreeksen van elke nacht – zonder namen, datums of apparaat-ID’s."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਫ਼ਾਈਲ ਵਿੱਚ ਹਰ ਰਾਤ ਦੀ ਹਿਲਜੁਲ ਅਤੇ ਦਿਲ ਦੀ ਧੜਕਣ ਦੀਆਂ ਲੜੀਆਂ ਹਨ – ਨਾਮਾਂ, ਤਾਰੀਖਾਂ ਜਾਂ ਡੀਵਾਈਸ ID ਤੋਂ ਬਿਨਾਂ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Plik zawiera serie ruchu i tętna z każdej nocy – bez imion, dat i identyfikatorów urządzeń."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O arquivo contém séries de movimento e frequência cardíaca de cada noite – sem nomes, datas ou IDs de dispositivos."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O ficheiro contém séries de movimento e frequência cardíaca de cada noite – sem nomes, datas ou IDs de dispositivos."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Fișierul conține seriile de mișcare și puls din fiecare noapte – fără nume, date sau ID-uri de dispozitiv."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Файл содержит ряды движения и пульса за каждую ночь – без имён, дат и идентификаторов устройств."
          }
        },
        "si": {
          "stringUnit": {
            "state": "translated",
            "value": "ගොනුවේ එක් එක් රාත්‍රියේ චලන සහ හෘද ස්පන්දන ශ්‍රේණි ඇත – නම්, දින හෝ උපාංග ID නොමැතිව."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Súbor obsahuje údaje o pohybe a tepe za každú noc – bez mien, dátumov či ID zariadení."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Datoteka vsebuje podatke o gibanju in srčnem utripu za vsako noč – brez imen, datumov ali ID-jev naprav."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Skedari përmban seritë e lëvizjes dhe të pulsit për çdo natë – pa emra, data ose ID pajisjesh."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Датотека садржи низове покрета и пулса за сваку ноћ – без имена, датума и ID-јева уређаја."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Filen innehåller rörelse- och pulsserier för varje natt – utan namn, datum eller enhets-id."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Faili ina mfululizo wa mwendo na mapigo ya moyo kwa kila usiku – bila majina, tarehe wala vitambulisho vya kifaa."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "கோப்பில் ஒவ்வொரு இரவுக்குமான அசைவு, இதயத் துடிப்புத் தொடர்கள் இருக்கும் – பெயர், தேதி, சாதன ID இல்லாமல்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఫైల్‌లో ప్రతి రాత్రి కదలిక, గుండె వేగం శ్రేణులు ఉంటాయి – పేర్లు, తేదీలు లేదా పరికర IDలు లేకుండా."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไฟล์มีข้อมูลการเคลื่อนไหวและอัตราการเต้นของหัวใจของแต่ละคืน โดยไม่มีชื่อ วันที่ หรือรหัสอุปกรณ์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dosya her gecenin hareket ve nabız serilerini içerir – ad, tarih veya cihaz kimliği olmadan."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Файл містить ряди руху та пульсу за кожну ніч – без імен, дат та ідентифікаторів пристроїв."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "فائل میں ہر رات کی حرکت اور دل کی دھڑکن کے سلسلے ہوتے ہیں – نام، تاریخ یا ڈیوائس آئی ڈی کے بغیر۔"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Faylda har bir tun uchun harakat va yurak urishi qatorlari bor – nomlar, sanalar va qurilma IDlarisiz."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tệp chứa chuỗi dữ liệu chuyển động và nhịp tim của từng đêm – không có tên, ngày hay ID thiết bị."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "檔案包含每晚的動作和心率數據，不含姓名、日期或裝置 ID。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文件包含每晚的体动和心率序列，不含姓名、日期或设备 ID。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "檔案包含每晚的體動和心率序列，不含姓名、日期或裝置 ID。"
          }
        },
        "zu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ifayela linochungechunge lokunyakaza nokushaya kwenhliziyo lobusuku ngabunye – ngaphandle kwamagama, izinsuku noma ama-ID edivayisi."
          }
        }
      }
    },
