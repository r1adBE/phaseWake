        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dati paliek tavās ierīcēs. Mācīšanās posmu vari jebkurā laikā izslēgt iestatījumos."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Податоците остануваат на твоите уреди. Фазата на учење можеш да ја исклучиш во поставките во секое време."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഡാറ്റ നിങ്ങളുടെ ഉപകരണങ്ങളിൽ തന്നെ നിൽക്കും. പഠന ഘട്ടം ക്രമീകരണങ്ങളിൽ എപ്പോൾ വേണമെങ്കിലും ഓഫാക്കാം."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Өгөгдөл чиний төхөөрөмж дээр үлдэнэ. Суралцах үеийг тохиргооноос хүссэн үедээ унтрааж болно."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "डेटा तुमच्या डिव्हाइसवरच राहतो. शिकण्याचा टप्पा सेटिंग्जमध्ये कधीही बंद करू शकता."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Data kekal pada peranti anda. Anda boleh mematikan fasa pembelajaran dalam tetapan pada bila-bila masa."
          }
        },
        "my": {
          "stringUnit": {
            "state": "translated",
            "value": "ဒေတာများသည် သင့်စက်များပေါ်တွင်သာ ရှိသည်။ သင်ယူမှုအဆင့်ကို ဆက်တင်များတွင် အချိန်မရွေး ပိတ်နိုင်သည်။"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Dataene blir på enhetene dine. Du kan slå av læringsfasen i innstillingene når som helst."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "डेटा तिम्रो उपकरणमै रहन्छ। सिक्ने चरण सेटिङमा जुनसुकै बेला बन्द गर्न सक्छौ।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De gegevens blijven op je apparaten. Je kunt de leerfase op elk moment uitzetten in de instellingen."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਡਾਟਾ ਤੁਹਾਡੇ ਡਿਵਾਈਸਾਂ ’ਤੇ ਹੀ ਰਹਿੰਦਾ ਹੈ। ਸਿੱਖਣ ਦਾ ਪੜਾਅ ਸੈਟਿੰਗਾਂ ਵਿੱਚ ਕਦੇ ਵੀ ਬੰਦ ਕਰ ਸਕਦੇ ਹੋ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dane zostają na twoich urządzeniach. Fazę nauki możesz w każdej chwili wyłączyć w ustawieniach."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os dados ficam nos seus dispositivos. Você pode desativar a fase de aprendizado nas configurações a qualquer momento."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Os dados ficam nos teus dispositivos. Podes desativar a fase de aprendizagem nas definições a qualquer momento."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Datele rămân pe dispozitivele tale. Poți dezactiva oricând faza de învățare din setări."
