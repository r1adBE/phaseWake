        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nachten uit Apple Health en andere apps kunnen hier ook verschijnen. Vergelijk met gezondheidsgegevens om ze te zien."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Health ਅਤੇ ਹੋਰ ਐਪਾਂ ਦੀਆਂ ਰਾਤਾਂ ਵੀ ਇੱਥੇ ਦਿਖ ਸਕਦੀਆਂ ਹਨ। ਉਨ੍ਹਾਂ ਨੂੰ ਦੇਖਣ ਲਈ ਸਿਹਤ ਡਾਟੇ ਨਾਲ ਤੁਲਨਾ ਕਰੋ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutaj mogą się też pojawiać noce z aplikacji Apple Health i innych aplikacji. Aby je zobaczyć, porównaj z danymi zdrowotnymi."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Noites do Apple Health e de outros apps também podem aparecer aqui. Para vê-las, compare com dados de saúde."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Noites do Apple Health e de outras apps também podem aparecer aqui. Para as veres, compara com dados de saúde."
