          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu gecə üçün siqnalı aktivləşdirmək üçün toxun."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Докосни, за да активираш будилника за тази нощ."
