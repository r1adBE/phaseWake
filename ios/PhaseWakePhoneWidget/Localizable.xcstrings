          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Hap Phase Wake para se të flesh, që ora të aktivizojë alarmin."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Отвори Phase Wake пре спавања да би сат могао да активира аларм."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Öppna Phase Wake innan du somnar så att klockan kan aktivera alarmet."
          }
        },
        "sw": {
          "stringUnit": {
