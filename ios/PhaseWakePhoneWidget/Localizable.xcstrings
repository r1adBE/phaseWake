    "sound_rec_default_hint": {
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Begin wanneer jy Phase Wake vanaf jou slaaptyd oopmaak (sonder wekker vanaf 21:00). Net kort snitte; hulle bly op jou foon en word ná 7 dae uitgevee."
          }
        },
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "ከመኝታ ሰዓትዎ ጀምሮ Phase Wakeን ሲከፍቱ ይጀምራል (ማንቂያ ከሌለ ከ21:00 ጀምሮ)። አጫጭር ቅንጥቦች ብቻ፤ በስልክዎ ላይ ይቆያሉ እና ከ7 ቀናት በኋላ ይሰረዛሉ።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يبدأ عندما تفتح Phase Wake بدءًا من موعد نومك (بدون منبّه من الساعة 9 مساءً). مقاطع قصيرة فقط؛ تبقى على هاتفك وتُحذف بعد 7 أيام."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake-i yatma vaxtından sonra açanda başlayır (siqnal yoxdursa, 21:00-dan). Yalnız qısa kliplər; onlar telefonunda qalır və 7 gündən sonra silinir."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Стартира, когато отвориш Phase Wake след часа си за лягане (без будилник – след 21:00). Само кратки записи; остават на телефона и се изтриват след 7 дни."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ঘুমানোর সময় থেকে Phase Wake খুললে শুরু হয় (অ্যালার্ম না থাকলে রাত ৯টা থেকে)। শুধু ছোট ক্লিপ; এগুলো তোমার ফোনেই থাকে আর ৭ দিন পরে মুছে যায়।"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokreće se kad otvoriš Phase Wake od svog vremena za spavanje (bez alarma od 21:00). Samo kratki isječci; ostaju na tvom telefonu i brišu se nakon 7 dana."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Comença quan obres Phase Wake a partir de la teva hora d’anar a dormir (sense alarma, a partir de les 21 h). Només fragments curts; es queden al telèfon i se suprimeixen al cap de 7 dies."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Spustí se, když otevřeš Phase Wake od své doby spánku (bez budíku od 21:00). Jen krátké úryvky; zůstávají v telefonu a po 7 dnech se smažou."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Starter, når du åbner Phase Wake fra din sengetid (uden alarm fra kl. 21). Kun korte klip; de bliver på telefonen og slettes efter 7 dage."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Startet, wenn du Phase Wake ab deiner Bettzeit öffnest (ohne Wecker ab 21 Uhr). Nur kurze Ausschnitte, bleiben auf dem Handy, nach 7 Tagen gelöscht."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ξεκινά όταν ανοίγεις το Phase Wake από την ώρα ύπνου σου (χωρίς ξυπνητήρι από τις 21:00). Μόνο σύντομα αποσπάσματα· μένουν στο τηλέφωνο και διαγράφονται μετά από 7 ημέρες."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Starts when you open Phase Wake from your bedtime on (without an alarm from 9 pm). Only short clips; they stay on your phone and are deleted after 7 days."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Empieza cuando abres Phase Wake a partir de tu hora de dormir (sin alarma, desde las 21:00). Solo fragmentos cortos; se quedan en tu teléfono y se borran a los 7 días."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Algab, kui avad Phase Wake’i alates magamamineku ajast (ilma äratuseta alates kl 21). Ainult lühikesed klipid; need jäävad sinu telefoni ja kustutatakse 7 päeva pärast."
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "Oheratzeko ordutik aurrera Phase Wake irekitzen duzunean hasten da (alarmarik gabe, 21:00etatik aurrera). Klip laburrak soilik; telefonoan geratzen dira eta 7 egunen ondoren ezabatzen dira."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "وقتی Phase Wake را از زمان خوابت به بعد باز کنی شروع می‌شود (بدون زنگ از ساعت ۲۱). فقط قطعه‌های کوتاه؛ روی گوشی می‌مانند و بعد از ۷ روز پاک می‌شوند."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Käynnistyy, kun avaat Phase Waken nukkumaanmenoajastasi alkaen (ilman herätystä klo 21 alkaen). Vain lyhyitä pätkiä; ne pysyvät puhelimessa ja poistetaan 7 päivän kuluttua."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Nagsisimula kapag binuksan mo ang Phase Wake mula sa oras ng pagtulog mo (kung walang alarm, mula 9 pm). Maiikling clip lang; nananatili ang mga ito sa telepono mo at dine-delete pagkalipas ng 7 araw."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Démarre quand tu ouvres Phase Wake à partir de ton heure de coucher (sans réveil, dès 21 h). Seulement de courts extraits ; ils restent sur ton téléphone et sont supprimés après 7 jours."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Tosaíonn sé nuair a osclaíonn tú Phase Wake ó d’am codlata ar aghaidh (gan aláram ó 21:00). Gearrthóga gearra amháin; fanann siad ar do fhón agus scriostar iad tar éis 7 lá."
          }
        },
        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "Comeza cando abres Phase Wake a partir da túa hora de deitarte (sen alarma, desde as 21:00). Só fragmentos curtos; quedan no teléfono e elimínanse despois de 7 días."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તમારા સૂવાના સમયથી Phase Wake ખોલો ત્યારે શરૂ થાય છે (એલાર્મ ન હોય તો રાત્રે 9 વાગ્યાથી). ફક્ત ટૂંકી ક્લિપ; તે તમારા ફોન પર જ રહે છે અને 7 દિવસ પછી કાઢી નખાય છે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מתחיל כשפותחים את Phase Wake משעת השינה (בלי שעון מעורר – מ־21:00). רק קטעים קצרים; הם נשארים בטלפון ונמחקים אחרי 7 ימים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सोने के समय से Phase Wake खोलने पर शुरू होता है (अलार्म न हो तो रात 9 बजे से)। सिर्फ़ छोटे अंश; ये फ़ोन पर रहते हैं और 7 दिन बाद मिट जाते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokreće se kad otvoriš Phase Wake od svog vremena za spavanje (bez alarma od 21:00). Samo kratki isječci; ostaju na tvom telefonu i brišu se nakon 7 dana."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Akkor indul, amikor a lefekvési időpontodtól megnyitod a Phase Wake-et (ébresztő nélkül 21:00-tól). Csak rövid részletek; a telefonon maradnak, és 7 nap után törlődnek."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Սկսվում է, երբ բացում ես Phase Wake-ը քնելու ժամիցդ սկսած (առանց զարթուցիչի՝ 21:00-ից)։ Միայն կարճ հատվածներ, որոնք մնում են հեռախոսիդ վրա և ջնջվում են 7 օր հետո։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mulai saat kamu membuka Phase Wake sejak jam tidurmu (tanpa alarm mulai pukul 21.00). Hanya potongan pendek; tetap di ponselmu dan dihapus setelah 7 hari."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Byrjar þegar þú opnar Phase Wake frá háttatíma (án vekjara frá kl. 21). Aðeins stuttar upptökur; þær verða eftir í símanum og er eytt eftir 7 daga."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Parte quando apri Phase Wake dalla tua ora di andare a letto (senza sveglia dalle 21:00). Solo brevi estratti; restano sul telefono e vengono eliminati dopo 7 giorni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "就寝時刻以降に Phase Wake を開くと始まります（アラームなしの場合は21時から）。短い断片だけ。スマホに残り、7日後に削除されます。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "იწყება, როცა Phase Wake-ს დაძინების დროიდან ხსნი (მაღვიძარის გარეშე – 21:00-დან). მხოლოდ მოკლე ფრაგმენტები; ისინი რჩება ტელეფონზე და 7 დღის შემდეგ იშლება."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake-ті ұйқыға жату уақытыңнан бастап ашқанда басталады (оятқыш болмаса, 21:00-ден). Тек қысқа үзінділер; олар телефоныңда қалады және 7 күннен кейін жойылады."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ចាប់ផ្ដើមពេលអ្នកបើក Phase Wake ចាប់ពីម៉ោងចូលដេក (បើគ្មានម៉ោងរោទ៍ ចាប់ពីម៉ោង 9 យប់)។ តែឃ្លីបខ្លីៗ វានៅលើទូរសព្ទ ហើយត្រូវលុបក្រោយ 7 ថ្ងៃ។"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನಿಮ್ಮ ಮಲಗುವ ಸಮಯದಿಂದ (ಅಲಾರಾಂ ಇಲ್ಲದಿದ್ದರೆ ರಾತ್ರಿ 9 ರಿಂದ) Phase Wake ತೆರೆದಾಗ ಶುರುವಾಗುತ್ತದೆ. ಚಿಕ್ಕ ಕ್ಲಿಪ್‌ಗಳು ಮಾತ್ರ; ಅವು ಫೋನ್‌ನಲ್ಲೇ ಇದ್ದು 7 ದಿನಗಳ ನಂತರ ಅಳಿಸಲಾಗುತ್ತವೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "취침 시간부터 Phase Wake를 열면 시작돼요(알람이 없으면 오후 9시부터). 짧은 조각만 저장하고, 휴대폰에만 남으며 7일 뒤 삭제돼요."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ເລີ່ມເມື່ອເຈົ້າເປີດ Phase Wake ຕັ້ງແຕ່ເວລາເຂົ້ານອນ (ຖ້າບໍ່ມີໂມງປຸກ ຕັ້ງແຕ່ 21:00) ສະເພາະຄລິບສັ້ນ ຢູ່ໃນໂທລະສັບ ແລະ ຖືກລຶບຫຼັງ 7 ມື້"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pradeda, kai atidarai Phase Wake nuo miego laiko (be žadintuvo – nuo 21:00). Tik trumpi įrašai; jie lieka tavo telefone ir ištrinami po 7 dienų."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Sākas, kad atver Phase Wake no gulētiešanas laika (bez modinātāja – no 21:00). Tikai īsi fragmenti; tie paliek tavā tālrunī un tiek dzēsti pēc 7 dienām."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Почнува кога ќе го отвориш Phase Wake од времето за спиење (без аларм од 21 ч). Само кратки снимки; остануваат на телефонот и се бришат по 7 дена."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഉറക്കസമയം മുതൽ (അലാറം ഇല്ലെങ്കിൽ രാത്രി 9 മുതൽ) Phase Wake തുറക്കുമ്പോൾ തുടങ്ങും. ചെറിയ ക്ലിപ്പുകൾ മാത്രം; അവ ഫോണിൽ തന്നെ ഇരിക്കും, 7 ദിവസത്തിനു ശേഷം ഇല്ലാതാകും."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Унтах цагаасаа хойш Phase Wake-ийг нээхэд эхэлнэ (сэрүүлэггүй бол 21:00-аас). Зөвхөн богино хэсгүүд; утсан дээр чинь үлдэж, 7 хоногийн дараа устна."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "झोपण्याच्या वेळेपासून Phase Wake उघडल्यावर सुरू होते (अलार्म नसल्यास रात्री ९ पासून). फक्त छोट्या क्लिप; त्या तुमच्या फोनवरच राहतात आणि ७ दिवसांनी हटवल्या जातात."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Bermula apabila anda membuka Phase Wake dari waktu tidur anda (tanpa penggera, mulai 9 malam). Hanya keratan pendek; kekal di telefon anda dan dipadam selepas 7 hari."
          }
        },
        "my": {
          "stringUnit": {
            "state": "translated",
            "value": "အိပ်ချိန်မှစ၍ (နှိုးစက်မရှိလျှင် ည 9 နာရီမှစ၍) Phase Wake ကို ဖွင့်သည့်အခါ စတင်သည်။ အတိုလေးများသာ၊ ဖုန်းပေါ်တွင်သာ ရှိပြီး 7 ရက်အကြာတွင် ဖျက်သည်။"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Starter når du åpner Phase Wake fra leggetiden din (uten alarm fra kl. 21). Bare korte klipp; de blir på telefonen og slettes etter 7 dager."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "सुत्ने समयदेखि Phase Wake खोल्दा सुरु हुन्छ (अलार्म नभए राति ९ बजेदेखि)। छोटा क्लिप मात्र; यी तिम्रो फोनमै रहन्छन् र ७ दिनपछि मेटिन्छन्।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Start wanneer je Phase Wake vanaf je bedtijd opent (zonder wekker vanaf 21:00). Alleen korte fragmenten; ze blijven op je telefoon en worden na 7 dagen gewist."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਤੁਹਾਡੇ ਸੌਣ ਦੇ ਸਮੇਂ ਤੋਂ Phase Wake ਖੋਲ੍ਹਣ ’ਤੇ ਸ਼ੁਰੂ ਹੁੰਦਾ ਹੈ (ਅਲਾਰਮ ਨਾ ਹੋਵੇ ਤਾਂ ਰਾਤ 9 ਵਜੇ ਤੋਂ)। ਸਿਰਫ਼ ਛੋਟੀਆਂ ਕਲਿੱਪਾਂ; ਇਹ ਤੁਹਾਡੇ ਫ਼ੋਨ ’ਤੇ ਹੀ ਰਹਿੰਦੀਆਂ ਹਨ ਅਤੇ 7 ਦਿਨਾਂ ਬਾਅਦ ਮਿਟ ਜਾਂਦੀਆਂ ਹਨ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Startuje, gdy otworzysz Phase Wake od swojej pory snu (bez budzika od 21:00). Tylko krótkie fragmenty; zostają na telefonie i są usuwane po 7 dniach."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Começa quando você abre o Phase Wake a partir da sua hora de dormir (sem alarme, das 21h em diante). Só trechos curtos; ficam no seu celular e são apagados depois de 7 dias."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Começa quando abres o Phase Wake a partir da tua hora de deitar (sem alarme, desde as 21:00). Só excertos curtos; ficam no teu telemóvel e são apagados ao fim de 7 dias."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Pornește când deschizi Phase Wake de la ora ta de culcare (fără alarmă, de la 21:00). Doar fragmente scurte; rămân pe telefon și se șterg după 7 zile."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запускается, когда ты открываешь Phase Wake начиная со времени отхода ко сну (без будильника — с 21:00). Только короткие фрагменты; они остаются на телефоне и удаляются через 7 дней."
          }
        },
        "si": {
          "stringUnit": {
            "state": "translated",
            "value": "නින්දට යන වේලාවේ සිට Phase Wake විවෘත කළ විට ආරම්භ වේ (එලාමයක් නැතිනම් රාත්‍රී 9 සිට). කෙටි කොටස් පමණි; ඒවා ඔබේ දුරකථනයේම පවතින අතර දින 7 කට පසු මැකේ."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Spustí sa, keď otvoríš Phase Wake od času na spanie (bez budíka od 21:00). Iba krátke záznamy; zostávajú v telefóne a po 7 dňoch sa vymažú."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Začne se, ko odpreš Phase Wake od časa za spanje naprej (brez budilke od 21. ure). Samo kratki posnetki; ostanejo na telefonu in se po 7 dneh izbrišejo."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Nis kur hap Phase Wake nga ora e gjumit e tutje (pa alarm, nga ora 21:00). Vetëm fragmente të shkurtra; mbeten në telefon dhe fshihen pas 7 ditësh."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Покреће се када отвориш Phase Wake од свог времена за спавање (без аларма од 21:00). Само кратки исечци; остају на твом телефону и бришу се после 7 дана."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Startar när du öppnar Phase Wake från din läggtid (utan alarm från kl. 21). Bara korta klipp; de stannar på telefonen och raderas efter 7 dagar."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Inaanza unapofungua Phase Wake kuanzia muda wako wa kulala (bila kengele kuanzia saa 3 usiku). Vipande vifupi tu; vinabaki kwenye simu yako na hufutwa baada ya siku 7."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உறங்கும் நேரத்திலிருந்து Phase Wake ஐத் திறக்கும்போது தொடங்கும் (அலாரம் இல்லையெனில் இரவு 9 மணியிலிருந்து). சிறு கிளிப்புகள் மட்டும்; அவை உங்கள் ஃபோனிலேயே இருக்கும், 7 நாட்களுக்குப் பிறகு நீக்கப்படும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ నిద్ర సమయం నుంచి Phase Wake తెరిచినప్పుడు మొదలవుతుంది (అలారం లేకపోతే రాత్రి 9 నుంచి). చిన్న క్లిప్‌లు మాత్రమే; అవి మీ ఫోన్‌లోనే ఉంటాయి, 7 రోజుల తర్వాత తొలగిపోతాయి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เริ่มเมื่อคุณเปิด Phase Wake ตั้งแต่เวลาเข้านอน (ถ้าไม่ตั้งปลุก เริ่มตั้งแต่ 21:00 น.) เก็บแค่ช่วงสั้น ๆ อยู่ในโทรศัพท์และลบหลัง 7 วัน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yatma saatinden itibaren Phase Wake’i açtığında başlar (alarm yoksa 21:00’den itibaren). Yalnızca kısa parçalar; telefonunda kalır ve 7 gün sonra silinir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Запускається, коли ти відкриваєш Phase Wake від часу сну (без будильника — з 21:00). Лише короткі фрагменти; вони залишаються на телефоні й видаляються через 7 днів."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "جب تم اپنے سونے کے وقت سے Phase Wake کھولو تو شروع ہوتی ہے (الارم کے بغیر رات 9 بجے سے)۔ صرف چھوٹے کلپس؛ یہ تمہارے فون پر رہتے ہیں اور 7 دن بعد حذف ہو جاتے ہیں۔"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wakeʼni uxlash vaqtingdan boshlab ochganingda ishga tushadi (budilniksiz – 21:00 dan). Faqat qisqa parchalar; ular telefoningda qoladi va 7 kundan keyin oʻchiriladi."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bắt đầu khi bạn mở Phase Wake từ giờ đi ngủ (không đặt báo thức thì từ 21:00). Chỉ những đoạn ngắn; chúng ở lại trên điện thoại và bị xóa sau 7 ngày."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "由就寢時間起開啟 Phase Wake 時開始（無鬧鐘時由 21:00 起）。只錄短片段；片段留在你的手機上，7 日後刪除。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从你的就寝时间起打开 Phase Wake 时开始（未设闹钟则从 21:00 起）。只保存短片段；片段留在手机上，7 天后删除。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "從你的就寢時間起開啟 Phase Wake 時開始（未設鬧鐘則從 21:00 起）。只保存短片段；片段留在手機上，7 天後刪除。"
          }
        },
        "zu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuqala lapho uvula i-Phase Wake kusukela esikhathini sakho sokulala (ngaphandle kwe-alamu kusukela ngo-21:00). Iziqeshana ezimfushane kuphela; zihlala efonini yakho futhi zisuswa ngemva kwezinsuku ezi-7."
          }
        }
      }
    },
