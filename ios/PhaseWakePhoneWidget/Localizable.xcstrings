        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Health Connect থেকে এখনো ঘুমের ডেটা নেই। Samsung Health-কে শেয়ার করতে হবে: Samsung Health → সেটিংস → Health Connect।"
          }
        },
        "bs": {
