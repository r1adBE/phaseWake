    "backup_health_hint": {
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Nagte uit ander apps (bv. Samsung Health) word nie gerugsteun nie – hulle bly daar en verskyn weer sodra toegang gegee is."
          }
        },
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "ከሌሎች መተግበሪያዎች (ለምሳሌ Samsung Health) የመጡ ሌሊቶች አይቀመጡም – እዚያው ይቆያሉ፣ ፈቃድ እንደተሰጠም እንደገና ይታያሉ።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يتم نسخ الليالي من التطبيقات الأخرى (مثل Samsung Health) احتياطيًا – فهي تبقى هناك وتظهر مجددًا بمجرد منح الإذن."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Digər tətbiqlərdən gecələr (məs. Samsung Health) ehtiyat nüsxəyə düşmür – onlar orada qalır və icazə veriləndə yenidən görünür."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Нощите от други приложения (напр. Samsung Health) не се архивират – остават там и се появяват отново, щом бъде дадено разрешение."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অন্য অ্যাপের রাত (যেমন Samsung Health) ব্যাকআপ হয় না – সেগুলো সেখানেই থাকে এবং অনুমতি দিলে আবার দেখা যায়।"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Noći iz drugih aplikacija (npr. Samsung Health) se ne spremaju u sigurnosnu kopiju – ostaju tamo i ponovo se pojave čim se odobri pristup."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Les nits d’altres apps (p. ex. Samsung Health) no es desen a la còpia de seguretat: es queden allà i tornen a aparèixer quan s’hi dona accés."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Noci z jiných aplikací (např. Samsung Health) se nezálohují – zůstávají tam a znovu se objeví, jakmile udělíš přístup."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Nætter fra andre apps (f.eks. Samsung Health) sikkerhedskopieres ikke – de bliver dér og vises igen, så snart adgang er givet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nächte aus anderen Apps (z. B. Samsung Health) werden nicht gesichert – sie bleiben dort und erscheinen wieder, sobald die Freigabe erteilt ist."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι νύχτες από άλλες εφαρμογές (π.χ. Samsung Health) δεν περιλαμβάνονται στο αντίγραφο ασφαλείας – μένουν εκεί και εμφανίζονται ξανά μόλις δοθεί πρόσβαση."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nights from other apps (e.g. Samsung Health) aren’t backed up – they stay there and show up again once access is granted."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las noches de otras apps (p. ej. Samsung Health) no se incluyen en la copia de seguridad: se quedan allí y vuelven a aparecer en cuanto concedas el acceso."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Teiste rakenduste (nt Samsung Health) öid ei varundata – need jäävad sinna ja ilmuvad uuesti, kui juurdepääs on antud."
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "Beste aplikazio batzuetako gauak (adib. Samsung Health) ez dira babeskopian gordetzen: han geratzen dira eta berriro agertzen dira baimena ematen denean."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "شب‌های برنامه‌های دیگر (مثلاً Samsung Health) پشتیبان‌گیری نمی‌شوند – همان‌جا می‌مانند و به‌محض دادن اجازه دوباره نمایش داده می‌شوند."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Muiden sovellusten (esim. Samsung Health) öitä ei varmuuskopioida – ne pysyvät siellä ja näkyvät taas, kun käyttöoikeus on annettu."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi naba-back up ang mga gabi mula sa ibang app (hal. Samsung Health) – nananatili sila roon at lalabas ulit kapag naibigay na ang access."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les nuits d'autres apps (p. ex. Samsung Health) ne sont pas sauvegardées : elles restent là-bas et réapparaissent dès que l'accès est accordé."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Ní dhéantar cúltaca d’oícheanta ó aipeanna eile (m.sh. Samsung Health) – fanann siad ansin agus feicfear arís iad nuair a thugtar rochtain."
          }
        },
        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "As noites doutras apps (p. ex. Samsung Health) non se gardan na copia de seguranza: quedan alí e volven aparecer en canto concedas o acceso."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "અન્ય ઍપની રાતો (દા.ત. Samsung Health) નો બૅકઅપ લેવાતો નથી – તે ત્યાં જ રહે છે અને પરવાનગી મળતાં ફરી દેખાય છે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לילות מאפליקציות אחרות (למשל Samsung Health) לא נכללים בגיבוי – הם נשארים שם ומופיעים שוב ברגע שניתנת הרשאה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "दूसरे ऐप की रातें (जैसे Samsung Health) बैकअप में नहीं जातीं – वे वहीं रहती हैं और अनुमति मिलते ही फिर दिखती हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Noći iz drugih aplikacija (npr. Samsung Health) ne spremaju se u sigurnosnu kopiju – ostaju tamo i ponovno se pojave čim se odobri pristup."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Más alkalmazások éjszakái (pl. Samsung Health) nem kerülnek a biztonsági mentésbe – ott maradnak, és a hozzáférés megadása után újra megjelennek."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Այլ հավելվածների գիշերները (օր.՝ Samsung Health) չեն պահուստավորվում – դրանք մնում են այնտեղ և նորից երևում են, երբ թույլտվությունը տրվի։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Malam dari aplikasi lain (mis. Samsung Health) tidak dicadangkan – tetap tersimpan di sana dan muncul lagi setelah akses diberikan."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Nætur úr öðrum forritum (t.d. Samsung Health) eru ekki afritaðar – þær haldast þar og birtast aftur um leið og aðgangur er veittur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le notti di altre app (ad es. Samsung Health) non vengono incluse nel backup: restano lì e ricompaiono non appena concedi l’accesso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ほかのアプリ（Samsung Health など）の夜はバックアップされません。元のアプリに残り、アクセスを許可すると再び表示されます。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "სხვა აპების ღამეები (მაგ. Samsung Health) სარეზერვო ასლში არ ინახება – ისინი იქ რჩება და წვდომის მიცემისთანავე ისევ გამოჩნდება."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Басқа қолданбалардың түндері (мысалы, Samsung Health) сақтық көшірмеге кірмейді – олар сонда қалады және рұқсат берілгенде қайта көрінеді."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "យប់ពីកម្មវិធីផ្សេង (ឧ. Samsung Health) មិនត្រូវបានបម្រុងទុកទេ – វានៅតែនៅទីនោះ ហើយនឹងបង្ហាញម្ដងទៀតភ្លាមៗពេលផ្ដល់សិទ្ធិ។"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಇತರ ಆ್ಯಪ್‌ಗಳ ರಾತ್ರಿಗಳನ್ನು (ಉದಾ. Samsung Health) ಬ್ಯಾಕಪ್ ಮಾಡಲಾಗುವುದಿಲ್ಲ – ಅವು ಅಲ್ಲಿಯೇ ಇರುತ್ತವೆ ಮತ್ತು ಅನುಮತಿ ನೀಡಿದ ತಕ್ಷಣ ಮತ್ತೆ ಕಾಣಿಸುತ್ತವೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 앱(예: Samsung Health)의 밤은 백업되지 않아요. 그 앱에 그대로 남아 있고, 권한을 허용하면 다시 표시돼요."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ຄືນຈາກແອັບອື່ນ (ເຊັ່ນ Samsung Health) ບໍ່ຖືກສຳຮອງ – ມັນຍັງຢູ່ບ່ອນນັ້ນ ແລະ ຈະສະແດງອີກເມື່ອໃຫ້ສິດແລ້ວ."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Naktys iš kitų programų (pvz., Samsung Health) nėra kopijuojamos – jos lieka ten ir vėl atsiranda, kai suteikiama prieiga."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Naktis no citām lietotnēm (piem., Samsung Health) netiek dublētas – tās paliek tur un atkal parādās, tiklīdz piekļuve ir piešķirta."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ноќите од други апликации (на пр. Samsung Health) не се зачувуваат во резервната копија – остануваат таму и повторно се појавуваат штом ќе се даде пристап."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "മറ്റ് ആപ്പുകളിലെ രാത്രികൾ (ഉദാ. Samsung Health) ബാക്കപ്പ് ചെയ്യില്ല – അവ അവിടെത്തന്നെ തുടരും, അനുമതി നൽകിയാൽ വീണ്ടും കാണാം."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Бусад аппын шөнүүд (жишээ нь Samsung Health) нөөцлөгдөхгүй – тэнд хэвээр үлдэж, зөвшөөрөл өгмөгц дахин харагдана."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "इतर ॲप्समधील रात्री (उदा. Samsung Health) बॅकअपमध्ये जात नाहीत – त्या तिथेच राहतात आणि परवानगी मिळताच पुन्हा दिसतात."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Malam daripada apl lain (cth. Samsung Health) tidak disandarkan – ia kekal di sana dan muncul semula sebaik sahaja akses diberikan."
          }
        },
        "my": {
          "stringUnit": {
            "state": "translated",
            "value": "အခြားအက်ပ်များ (ဥပမာ Samsung Health) မှ ညများကို အရန်မသိမ်းပါ – ၎င်းတို့သည် ထိုနေရာတွင် ရှိနေပြီး ခွင့်ပြုချက်ပေးသည်နှင့် ပြန်ပေါ်လာမည်။"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Netter fra andre apper (f.eks. Samsung Health) sikkerhetskopieres ikke – de blir værende der og vises igjen så snart tilgang er gitt."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "अन्य एपका रातहरू (जस्तै Samsung Health) ब्याकअप हुँदैनन् – ती त्यहीँ रहन्छन् र अनुमति दिनेबित्तिकै फेरि देखिन्छन्।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nachten uit andere apps (bijv. Samsung Health) worden niet geback-upt – ze blijven daar en verschijnen weer zodra er toegang is gegeven."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਹੋਰ ਐਪਾਂ ਦੀਆਂ ਰਾਤਾਂ (ਜਿਵੇਂ Samsung Health) ਦਾ ਬੈਕਅੱਪ ਨਹੀਂ ਹੁੰਦਾ – ਉਹ ਉੱਥੇ ਹੀ ਰਹਿੰਦੀਆਂ ਹਨ ਅਤੇ ਇਜਾਜ਼ਤ ਮਿਲਦੇ ਹੀ ਮੁੜ ਦਿਖਦੀਆਂ ਹਨ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Noce z innych aplikacji (np. Samsung Health) nie trafiają do kopii zapasowej – zostają tam i pojawiają się znowu, gdy tylko udzielisz dostępu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Noites de outros apps (ex.: Samsung Health) não entram no backup – elas ficam lá e aparecem de novo assim que o acesso for concedido."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As noites de outras apps (p. ex. Samsung Health) não entram na cópia de segurança – ficam lá e voltam a aparecer assim que o acesso for concedido."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nopțile din alte aplicații (de ex. Samsung Health) nu sunt incluse în backup – rămân acolo și reapar imediat ce acorzi accesul."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ночи из других приложений (например, Samsung Health) не попадают в резервную копию – они остаются там и снова появятся, как только будет дан доступ."
          }
        },
        "si": {
          "stringUnit": {
            "state": "translated",
            "value": "වෙනත් යෙදුම්වල රාත්‍රී (උදා. Samsung Health) උපස්ථ නොවේ – ඒවා එහිම පවතින අතර අවසරය ලබා දුන් විගස නැවත පෙන්වයි."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Noci z iných aplikácií (napr. Samsung Health) sa nezálohujú – zostávajú tam a znova sa zobrazia, len čo udelíš prístup."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Noči iz drugih aplikacij (npr. Samsung Health) se ne varnostno kopirajo – ostanejo tam in se znova prikažejo, takoj ko dovoliš dostop."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Netët nga aplikacione të tjera (p.sh. Samsung Health) nuk ruhen në kopjen rezervë – mbeten atje dhe shfaqen përsëri sapo të jepet qasja."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ноћи из других апликација (нпр. Samsung Health) не чувају се у резервној копији – остају тамо и поново се појаве чим се одобри приступ."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Nätter från andra appar (t.ex. Samsung Health) säkerhetskopieras inte – de ligger kvar där och visas igen så snart åtkomst har getts."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Usiku kutoka programu nyingine (k.m. Samsung Health) hauhifadhiwi nakala – unabaki huko na kuonekana tena mara ruhusa inapotolewa."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "பிற ஆப்களின் இரவுகள் (எ.கா. Samsung Health) காப்புப் பிரதி எடுக்கப்படாது – அவை அங்கேயே இருக்கும், அனுமதி அளித்ததும் மீண்டும் தோன்றும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఇతర యాప్‌ల రాత్రులు (ఉదా. Samsung Health) బ్యాకప్ కావు – అవి అక్కడే ఉంటాయి, అనుమతి ఇచ్చిన వెంటనే మళ్లీ కనిపిస్తాయి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คืนจากแอปอื่น (เช่น Samsung Health) จะไม่ถูกสำรองข้อมูล โดยยังอยู่ที่นั่นและจะแสดงอีกครั้งเมื่ออนุญาตการเข้าถึง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Diğer uygulamalardaki geceler (ör. Samsung Health) yedeklenmez – orada kalır ve erişim izni verilir verilmez yeniden görünür."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ночі з інших застосунків (напр. Samsung Health) не потрапляють до резервної копії – вони залишаються там і знову з'являться, щойно буде надано доступ."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "دوسری ایپس کی راتیں (مثلاً Samsung Health) بیک اپ نہیں ہوتیں – وہ وہیں رہتی ہیں اور اجازت ملتے ہی دوبارہ دکھتی ہیں۔"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Boshqa ilovalardagi tunlar (masalan, Samsung Health) zaxiralanmaydi – ular oʻsha yerda qoladi va ruxsat berilishi bilan yana chiqadi."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các đêm từ ứng dụng khác (vd. Samsung Health) không được sao lưu – chúng vẫn ở đó và hiện lại ngay khi bạn cấp quyền truy cập."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "來自其他 App（例如 Samsung Health）的晚上不會備份——它們會留在原處，授權後會再次顯示。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "来自其他应用（例如 Samsung Health）的夜晚不会被备份——它们保留在原处，授权后会再次显示。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "來自其他 App（例如 Samsung Health）的夜晚不會備份——它們會留在原處，授權後會再次顯示。"
          }
        },
        "zu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ubusuku obuvela kwamanye ama-app (isb. i-Samsung Health) abulondolozwa – buhlala lapho futhi buvele futhi uma sekunikezwe imvume."
          }
        }
      }
    },
    "backup_health_hint_apple": {
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Nagte uit ander apps (bv. Apple Health) word nie gerugsteun nie – hulle bly daar en verskyn weer sodra toegang gegee is."
          }
        },
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "ከሌሎች መተግበሪያዎች (ለምሳሌ Apple Health) የመጡ ሌሊቶች አይቀመጡም – እዚያው ይቆያሉ፣ ፈቃድ እንደተሰጠም እንደገና ይታያሉ።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يتم نسخ الليالي من التطبيقات الأخرى (مثل Apple Health) احتياطيًا – فهي تبقى هناك وتظهر مجددًا بمجرد منح الإذن."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Digər tətbiqlərdən gecələr (məs. Apple Health) ehtiyat nüsxəyə düşmür – onlar orada qalır və icazə veriləndə yenidən görünür."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Нощите от други приложения (напр. Apple Health) не се архивират – остават там и се появяват отново, щом бъде дадено разрешение."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অন্য অ্যাপের রাত (যেমন Apple Health) ব্যাকআপ হয় না – সেগুলো সেখানেই থাকে এবং অনুমতি দিলে আবার দেখা যায়।"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Noći iz drugih aplikacija (npr. Apple Health) se ne spremaju u sigurnosnu kopiju – ostaju tamo i ponovo se pojave čim se odobri pristup."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Les nits d’altres apps (p. ex. Apple Health) no es desen a la còpia de seguretat: es queden allà i tornen a aparèixer quan s’hi dona accés."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Noci z jiných aplikací (např. Apple Health) se nezálohují – zůstávají tam a znovu se objeví, jakmile udělíš přístup."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Nætter fra andre apps (f.eks. Apple Health) sikkerhedskopieres ikke – de bliver dér og vises igen, så snart adgang er givet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nächte aus anderen Apps (z. B. Apple Health) werden nicht gesichert – sie bleiben dort und erscheinen wieder, sobald die Freigabe erteilt ist."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι νύχτες από άλλες εφαρμογές (π.χ. Apple Health) δεν περιλαμβάνονται στο αντίγραφο ασφαλείας – μένουν εκεί και εμφανίζονται ξανά μόλις δοθεί πρόσβαση."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nights from other apps (e.g. Apple Health) aren’t backed up – they stay there and show up again once access is granted."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las noches de otras apps (p. ej. Apple Health) no se incluyen en la copia de seguridad: se quedan allí y vuelven a aparecer en cuanto concedas el acceso."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Teiste rakenduste (nt Apple Health) öid ei varundata – need jäävad sinna ja ilmuvad uuesti, kui juurdepääs on antud."
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "Beste aplikazio batzuetako gauak (adib. Apple Health) ez dira babeskopian gordetzen: han geratzen dira eta berriro agertzen dira baimena ematen denean."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "شب‌های برنامه‌های دیگر (مثلاً Apple Health) پشتیبان‌گیری نمی‌شوند – همان‌جا می‌مانند و به‌محض دادن اجازه دوباره نمایش داده می‌شوند."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Muiden sovellusten (esim. Apple Health) öitä ei varmuuskopioida – ne pysyvät siellä ja näkyvät taas, kun käyttöoikeus on annettu."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi naba-back up ang mga gabi mula sa ibang app (hal. Apple Health) – nananatili sila roon at lalabas ulit kapag naibigay na ang access."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les nuits d'autres apps (p. ex. Apple Health) ne sont pas sauvegardées : elles restent là-bas et réapparaissent dès que l'accès est accordé."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Ní dhéantar cúltaca d’oícheanta ó aipeanna eile (m.sh. Apple Health) – fanann siad ansin agus feicfear arís iad nuair a thugtar rochtain."
          }
        },
        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "As noites doutras apps (p. ex. Apple Health) non se gardan na copia de seguranza: quedan alí e volven aparecer en canto concedas o acceso."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "અન્ય ઍપની રાતો (દા.ત. Apple Health) નો બૅકઅપ લેવાતો નથી – તે ત્યાં જ રહે છે અને પરવાનગી મળતાં ફરી દેખાય છે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לילות מאפליקציות אחרות (למשל Apple Health) לא נכללים בגיבוי – הם נשארים שם ומופיעים שוב ברגע שניתנת הרשאה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "दूसरे ऐप की रातें (जैसे Apple Health) बैकअप में नहीं जातीं – वे वहीं रहती हैं और अनुमति मिलते ही फिर दिखती हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Noći iz drugih aplikacija (npr. Apple Health) ne spremaju se u sigurnosnu kopiju – ostaju tamo i ponovno se pojave čim se odobri pristup."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Más alkalmazások éjszakái (pl. Apple Health) nem kerülnek a biztonsági mentésbe – ott maradnak, és a hozzáférés megadása után újra megjelennek."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Այլ հավելվածների գիշերները (օր.՝ Apple Health) չեն պահուստավորվում – դրանք մնում են այնտեղ և նորից երևում են, երբ թույլտվությունը տրվի։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Malam dari aplikasi lain (mis. Apple Health) tidak dicadangkan – tetap tersimpan di sana dan muncul lagi setelah akses diberikan."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Nætur úr öðrum forritum (t.d. Apple Health) eru ekki afritaðar – þær haldast þar og birtast aftur um leið og aðgangur er veittur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le notti di altre app (ad es. Apple Health) non vengono incluse nel backup: restano lì e ricompaiono non appena concedi l’accesso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ほかのアプリ（Apple Health など）の夜はバックアップされません。元のアプリに残り、アクセスを許可すると再び表示されます。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "სხვა აპების ღამეები (მაგ. Apple Health) სარეზერვო ასლში არ ინახება – ისინი იქ რჩება და წვდომის მიცემისთანავე ისევ გამოჩნდება."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Басқа қолданбалардың түндері (мысалы, Apple Health) сақтық көшірмеге кірмейді – олар сонда қалады және рұқсат берілгенде қайта көрінеді."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "យប់ពីកម្មវិធីផ្សេង (ឧ. Apple Health) មិនត្រូវបានបម្រុងទុកទេ – វានៅតែនៅទីនោះ ហើយនឹងបង្ហាញម្ដងទៀតភ្លាមៗពេលផ្ដល់សិទ្ធិ។"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಇತರ ಆ್ಯಪ್‌ಗಳ ರಾತ್ರಿಗಳನ್ನು (ಉದಾ. Apple Health) ಬ್ಯಾಕಪ್ ಮಾಡಲಾಗುವುದಿಲ್ಲ – ಅವು ಅಲ್ಲಿಯೇ ಇರುತ್ತವೆ ಮತ್ತು ಅನುಮತಿ ನೀಡಿದ ತಕ್ಷಣ ಮತ್ತೆ ಕಾಣಿಸುತ್ತವೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 앱(예: Apple Health)의 밤은 백업되지 않아요. 그 앱에 그대로 남아 있고, 권한을 허용하면 다시 표시돼요."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ຄືນຈາກແອັບອື່ນ (ເຊັ່ນ Apple Health) ບໍ່ຖືກສຳຮອງ – ມັນຍັງຢູ່ບ່ອນນັ້ນ ແລະ ຈະສະແດງອີກເມື່ອໃຫ້ສິດແລ້ວ."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Naktys iš kitų programų (pvz., Apple Health) nėra kopijuojamos – jos lieka ten ir vėl atsiranda, kai suteikiama prieiga."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Naktis no citām lietotnēm (piem., Apple Health) netiek dublētas – tās paliek tur un atkal parādās, tiklīdz piekļuve ir piešķirta."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ноќите од други апликации (на пр. Apple Health) не се зачувуваат во резервната копија – остануваат таму и повторно се појавуваат штом ќе се даде пристап."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "മറ്റ് ആപ്പുകളിലെ രാത്രികൾ (ഉദാ. Apple Health) ബാക്കപ്പ് ചെയ്യില്ല – അവ അവിടെത്തന്നെ തുടരും, അനുമതി നൽകിയാൽ വീണ്ടും കാണാം."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Бусад аппын шөнүүд (жишээ нь Apple Health) нөөцлөгдөхгүй – тэнд хэвээр үлдэж, зөвшөөрөл өгмөгц дахин харагдана."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "इतर ॲप्समधील रात्री (उदा. Apple Health) बॅकअपमध्ये जात नाहीत – त्या तिथेच राहतात आणि परवानगी मिळताच पुन्हा दिसतात."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Malam daripada apl lain (cth. Apple Health) tidak disandarkan – ia kekal di sana dan muncul semula sebaik sahaja akses diberikan."
          }
        },
        "my": {
          "stringUnit": {
            "state": "translated",
            "value": "အခြားအက်ပ်များ (ဥပမာ Apple Health) မှ ညများကို အရန်မသိမ်းပါ – ၎င်းတို့သည် ထိုနေရာတွင် ရှိနေပြီး ခွင့်ပြုချက်ပေးသည်နှင့် ပြန်ပေါ်လာမည်။"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Netter fra andre apper (f.eks. Apple Health) sikkerhetskopieres ikke – de blir værende der og vises igjen så snart tilgang er gitt."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "अन्य एपका रातहरू (जस्तै Apple Health) ब्याकअप हुँदैनन् – ती त्यहीँ रहन्छन् र अनुमति दिनेबित्तिकै फेरि देखिन्छन्।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nachten uit andere apps (bijv. Apple Health) worden niet geback-upt – ze blijven daar en verschijnen weer zodra er toegang is gegeven."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਹੋਰ ਐਪਾਂ ਦੀਆਂ ਰਾਤਾਂ (ਜਿਵੇਂ Apple Health) ਦਾ ਬੈਕਅੱਪ ਨਹੀਂ ਹੁੰਦਾ – ਉਹ ਉੱਥੇ ਹੀ ਰਹਿੰਦੀਆਂ ਹਨ ਅਤੇ ਇਜਾਜ਼ਤ ਮਿਲਦੇ ਹੀ ਮੁੜ ਦਿਖਦੀਆਂ ਹਨ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Noce z innych aplikacji (np. Apple Health) nie trafiają do kopii zapasowej – zostają tam i pojawiają się znowu, gdy tylko udzielisz dostępu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Noites de outros apps (ex.: Apple Health) não entram no backup – elas ficam lá e aparecem de novo assim que o acesso for concedido."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As noites de outras apps (p. ex. Apple Health) não entram na cópia de segurança – ficam lá e voltam a aparecer assim que o acesso for concedido."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nopțile din alte aplicații (de ex. Apple Health) nu sunt incluse în backup – rămân acolo și reapar imediat ce acorzi accesul."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ночи из других приложений (например, Apple Health) не попадают в резервную копию – они остаются там и снова появятся, как только будет дан доступ."
          }
        },
        "si": {
          "stringUnit": {
            "state": "translated",
            "value": "වෙනත් යෙදුම්වල රාත්‍රී (උදා. Apple Health) උපස්ථ නොවේ – ඒවා එහිම පවතින අතර අවසරය ලබා දුන් විගස නැවත පෙන්වයි."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Noci z iných aplikácií (napr. Apple Health) sa nezálohujú – zostávajú tam a znova sa zobrazia, len čo udelíš prístup."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Noči iz drugih aplikacij (npr. Apple Health) se ne varnostno kopirajo – ostanejo tam in se znova prikažejo, takoj ko dovoliš dostop."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Netët nga aplikacione të tjera (p.sh. Apple Health) nuk ruhen në kopjen rezervë – mbeten atje dhe shfaqen përsëri sapo të jepet qasja."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ноћи из других апликација (нпр. Apple Health) не чувају се у резервној копији – остају тамо и поново се појаве чим се одобри приступ."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Nätter från andra appar (t.ex. Apple Health) säkerhetskopieras inte – de ligger kvar där och visas igen så snart åtkomst har getts."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Usiku kutoka programu nyingine (k.m. Apple Health) hauhifadhiwi nakala – unabaki huko na kuonekana tena mara ruhusa inapotolewa."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "பிற ஆப்களின் இரவுகள் (எ.கா. Apple Health) காப்புப் பிரதி எடுக்கப்படாது – அவை அங்கேயே இருக்கும், அனுமதி அளித்ததும் மீண்டும் தோன்றும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఇతర యాప్‌ల రాత్రులు (ఉదా. Apple Health) బ్యాకప్ కావు – అవి అక్కడే ఉంటాయి, అనుమతి ఇచ్చిన వెంటనే మళ్లీ కనిపిస్తాయి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คืนจากแอปอื่น (เช่น Apple Health) จะไม่ถูกสำรองข้อมูล โดยยังอยู่ที่นั่นและจะแสดงอีกครั้งเมื่ออนุญาตการเข้าถึง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Diğer uygulamalardaki geceler (ör. Apple Health) yedeklenmez – orada kalır ve erişim izni verilir verilmez yeniden görünür."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ночі з інших застосунків (напр. Apple Health) не потрапляють до резервної копії – вони залишаються там і знову з'являться, щойно буде надано доступ."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "دوسری ایپس کی راتیں (مثلاً Apple Health) بیک اپ نہیں ہوتیں – وہ وہیں رہتی ہیں اور اجازت ملتے ہی دوبارہ دکھتی ہیں۔"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Boshqa ilovalardagi tunlar (masalan, Apple Health) zaxiralanmaydi – ular oʻsha yerda qoladi va ruxsat berilishi bilan yana chiqadi."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các đêm từ ứng dụng khác (vd. Apple Health) không được sao lưu – chúng vẫn ở đó và hiện lại ngay khi bạn cấp quyền truy cập."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "來自其他 App（例如 Apple Health）的晚上不會備份——它們會留在原處，授權後會再次顯示。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "来自其他应用（例如 Apple Health）的夜晚不会被备份——它们保留在原处，授权后会再次显示。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "來自其他 App（例如 Apple Health）的夜晚不會備份——它們會留在原處，授權後會再次顯示。"
          }
        },
        "zu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ubusuku obuvela kwamanye ama-app (isb. i-Apple Health) abulondolozwa – buhlala lapho futhi buvele futhi uma sekunikezwe imvume."
          }
        }
      }
    },
