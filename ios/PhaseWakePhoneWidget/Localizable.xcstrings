        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS 26 ಕ್ಕಿಂತ ಮೊದಲು ಬ್ಯಾಕಪ್ ಅಲಾರಾಂ ಒಂದು ಅಧಿಸೂಚನೆ: ಸೈಲೆಂಟ್ ಸ್ವಿಚ್ ಅದನ್ನು ನಿಶ್ಶಬ್ದಗೊಳಿಸುತ್ತದೆ. ಧ್ವನಿಯನ್ನು ಆನ್‌ನಲ್ಲಿಡಿ ಅಥವಾ iOS 26 ಗೆ ಅಪ್‌ಡೇಟ್ ಮಾಡಿ."
