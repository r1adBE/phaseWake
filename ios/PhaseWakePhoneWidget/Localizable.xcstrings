        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Søvnlængde og regelmæssighed kommer fra Health Connect."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schlafdauer und Regelmässigkeit kommen aus Health Connect."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η διάρκεια και η κανονικότητα του ύπνου προέρχονται από το Health Connect."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sleep duration and regularity come from Health Connect."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La duración y la regularidad del sueño provienen de Health Connect."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Une kestus ja regulaarsus pärinevad Health Connectist."
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo-iraupena eta erregulartasuna Health Connect-etik datoz."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "مدت و نظم خواب از Health Connect می‌آید."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Unen kesto ja säännöllisyys tulevat Health Connectista."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Galing sa Health Connect ang haba at regularidad ng tulog."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La durée et la régularité du sommeil proviennent de Health Connect."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Tagann fad agus rialtacht an chodlata ó Health Connect."
          }
        },
        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "A duración e a regularidade do sono veñen de Health Connect."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ઊંઘનો સમય અને નિયમિતતા Health Connect પરથી આવે છે."
