          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Носи часовника малко по-стегнато през нощта и провери дали Phase Wake има право да мери пулса ти."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "রাতে ঘড়িটা একটু শক্ত করে পরো, আর দেখো Phase Wake তোমার নাড়ি মাপার অনুমতি পেয়েছে কি না।"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Noću nosi sat malo čvršće i provjeri da li Phase Wake smije mjeriti tvoj puls."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Porta el rellotge una mica més ajustat a la nit i comprova que Phase Wake pugui mesurar-te el pols."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nos hodinky v noci trochu těsněji a zkontroluj, jestli Phase Wake smí měřit tvůj tep."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Bær uret lidt strammere om natten, og tjek, at Phase Wake må måle din puls."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Trag die Uhr nachts etwas enger und prüfe, ob Phase Wake den Puls messen darf."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Φόρα το ρολόι λίγο πιο σφιχτά τη νύχτα και έλεγξε ότι το Phase Wake επιτρέπεται να μετρά τον σφυγμό σου."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wear the watch a little snugger at night and check that Phase Wake may measure your pulse."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Por la noche, lleva el reloj un poco más ajustado y comprueba que Phase Wake pueda medir tu pulso."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kanna kella öösel veidi tihedamalt ja kontrolli, kas Phase Wake tohib su pulssi mõõta."
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "Gauez eraman erlojua pixka bat estuago eta egiaztatu Phase Wake-k zure pultsua neur dezakeela."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "شب‌ها ساعت را کمی محکم‌تر ببند و بررسی کن که Phase Wake اجازهٔ اندازه‌گیری نبضت را دارد."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pidä kelloa yöllä hieman tiukemmalla ja tarkista, että Phase Wake saa mitata sykettäsi."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Isuot ang relo nang medyo mas mahigpit sa gabi at tingnan kung pinapayagan ang Phase Wake na sukatin ang pulso mo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La nuit, porte la montre un peu plus serrée et vérifie que Phase Wake peut mesurer ton pouls."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Caith an t-uaireadóir beagán níos teinne san oíche agus seiceáil go bhfuil cead ag Phase Wake do chuisle a thomhas."
          }
        },
        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pola noite, leva o reloxo un pouco máis axustado e comproba que Phase Wake poida medirche o pulso."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "રાત્રે ઘડિયાળ થોડી કસીને પહેરો અને તપાસો કે Phase Wake ને તમારી નાડી માપવાની પરવાનગી છે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כדאי לענוד את השעון בלילה קצת יותר הדוק ולבדוק ש-Phase Wake מורשה למדוד את הדופק שלך."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रात को घड़ी थोड़ी कसकर पहनें और जाँचें कि Phase Wake को आपकी नब्ज़ मापने की अनुमति है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Noću nosi sat malo čvršće i provjeri smije li Phase Wake mjeriti tvoj puls."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Éjszakára viseld kicsit szorosabban az órát, és nézd meg, hogy a Phase Wake mérheti-e a pulzusodat."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Գիշերը ժամացույցը մի փոքր ավելի ամուր կրիր և ստուգիր, որ Phase Wake-ը կարող է չափել զարկերակդ։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pakai jam sedikit lebih ketat di malam hari dan periksa apakah Phase Wake boleh mengukur denyut nadimu."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Hafðu úrið aðeins þéttar á nóttunni og athugaðu hvort Phase Wake megi mæla púlsinn þinn."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Di notte porta l’orologio un po’ più stretto e verifica che Phase Wake possa misurare il tuo polso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "夜はウォッチを少しきつめに着け、Phase Wake が脈拍を測定できるか確認してください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ღამით საათი ცოტა უფრო მჭიდროდ გაიკეთე და შეამოწმე, აქვს თუ არა Phase Wake-ს პულსის გაზომვის ნებართვა."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Түнде сағатты сәл тығызырақ тақ және Phase Wake-ке пульсіңді өлшеуге рұқсат бар-жоғын тексер."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "នៅពេលយប់ ពាក់នាឡិកាឲ្យតឹងបន្តិច ហើយពិនិត្យថា Phase Wake អាចវាស់ជីពចររបស់អ្នកបាន។"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ರಾತ್ರಿ ವಾಚ್ ಅನ್ನು ಸ್ವಲ್ಪ ಬಿಗಿಯಾಗಿ ಧರಿಸಿ ಮತ್ತು Phase Wake ಗೆ ನಿಮ್ಮ ನಾಡಿ ಅಳೆಯಲು ಅನುಮತಿ ಇದೆಯೇ ಎಂದು ಪರಿಶೀಲಿಸಿ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "밤에는 시계를 조금 더 꼭 맞게 차고, Phase Wake가 맥박을 측정할 수 있는지 확인하세요."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ໃນຕອນກາງຄືນ ໃສ່ໂມງໃຫ້ແໜ້ນຂຶ້ນໜ້ອຍໜຶ່ງ ແລະ ກວດເບິ່ງວ່າ Phase Wake ວັດຊີບພະຈອນຂອງເຈົ້າໄດ້."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Naktį užsisek laikrodį šiek tiek tvirčiau ir patikrink, ar Phase Wake gali matuoti tavo pulsą."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Naktī nēsā pulksteni mazliet ciešāk un pārbaudi, vai Phase Wake drīkst mērīt tavu pulsu."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ноќе носи го часовникот малку поцврсто и провери дали Phase Wake смее да ти го мери пулсот."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "രാത്രിയിൽ വാച്ച് അൽപ്പം മുറുക്കി ധരിക്കുക, Phase Wake-ന് നിങ്ങളുടെ നാഡി അളക്കാൻ അനുമതിയുണ്ടോ എന്ന് പരിശോധിക്കുക."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Шөнө цагаа арай чанга зүүж, Phase Wake таны судасны цохилтыг хэмжих зөвшөөрөлтэй эсэхийг шалгаарай."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "रात्री घड्याळ थोडे घट्ट घाला आणि Phase Wake ला तुमची नाडी मोजण्याची परवानगी आहे का ते तपासा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pakai jam sedikit lebih ketat pada waktu malam dan semak sama ada Phase Wake dibenarkan mengukur nadi anda."
          }
        },
        "my": {
          "stringUnit": {
            "state": "translated",
            "value": "ညဘက်တွင် နာရီကို နည်းနည်း ပိုတင်းအောင် ဝတ်ပြီး Phase Wake က သင့်သွေးခုန်နှုန်းကို တိုင်းခွင့်ရှိမရှိ စစ်ဆေးပါ။"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bruk klokken litt strammere om natten, og sjekk at Phase Wake får måle pulsen din."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "राति घडी अलि कसिलो गरी लगाउनुहोस् र Phase Wake लाई तपाईंको नाडी नाप्ने अनुमति छ कि छैन जाँच्नुहोस्।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Draag het horloge ’s nachts iets strakker en controleer of Phase Wake je hartslag mag meten."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਰਾਤ ਨੂੰ ਘੜੀ ਥੋੜ੍ਹੀ ਕੱਸ ਕੇ ਪਹਿਨੋ ਅਤੇ ਜਾਂਚੋ ਕਿ Phase Wake ਨੂੰ ਤੁਹਾਡੀ ਨਬਜ਼ ਮਾਪਣ ਦੀ ਇਜਾਜ਼ਤ ਹੈ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Noś zegarek w nocy nieco ciaśniej i sprawdź, czy Phase Wake może mierzyć twoje tętno."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "À noite, use o relógio um pouco mais justo e confira se o Phase Wake pode medir seu pulso."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "À noite, usa o relógio um pouco mais apertado e verifica se o Phase Wake pode medir o teu pulso."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Noaptea, poartă ceasul puțin mai strâns și verifică dacă Phase Wake are voie să-ți măsoare pulsul."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ночью носи часы чуть плотнее и проверь, может ли Phase Wake измерять твой пульс."
          }
        },
        "si": {
          "stringUnit": {
            "state": "translated",
            "value": "රාත්‍රියේ ඔරලෝසුව ටිකක් තදින් පළඳින්න, Phase Wake ට ඔබේ නාඩිය මැනීමට අවසර ඇත්දැයි බලන්න."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "V noci nos hodinky trochu tesnejšie a skontroluj, či Phase Wake smie merať tvoj pulz."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ponoči nosi uro malo tesneje in preveri, ali Phase Wake sme meriti tvoj utrip."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Natën vishe orën pak më ngushtë dhe kontrollo nëse Phase Wake lejohet të matë pulsin tënd."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ноћу носи сат мало чвршће и провери да ли Phase Wake сме да мери твој пулс."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Bär klockan lite stramare på natten och kontrollera att Phase Wake får mäta din puls."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Usiku, vaa saa kwa kubana kidogo zaidi na uhakikishe kuwa Phase Wake inaruhusiwa kupima mapigo yako."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இரவில் கடிகாரத்தைச் சற்று இறுக்கமாக அணிந்து, Phase Wake உங்கள் நாடித்துடிப்பை அளக்க அனுமதி உள்ளதா எனச் சரிபாருங்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "రాత్రి వాచ్‌ను కొంచెం బిగుతుగా ధరించండి, Phase Wake‌కు మీ నాడి కొలిచే అనుమతి ఉందో లేదో చూడండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตอนกลางคืนให้สวมนาฬิกาให้กระชับขึ้นเล็กน้อย และตรวจสอบว่า Phase Wake วัดชีพจรของคุณได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Geceleri saati biraz daha sıkı tak ve Phase Wake'in nabzını ölçme izni olup olmadığını kontrol et."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Уночі носи годинник трохи щільніше й перевір, чи Phase Wake може вимірювати твій пульс."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "رات کو گھڑی تھوڑی کس کر پہنیں اور دیکھیں کہ Phase Wake کو آپ کی نبض ناپنے کی اجازت ہے۔"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Tunda soatni biroz mahkamroq taq va Phase Wake pulsingni o‘lchashga ruxsat borligini tekshir."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ban đêm hãy đeo đồng hồ chặt hơn một chút và kiểm tra xem Phase Wake có được phép đo nhịp tim của bạn không."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "夜晚將手錶戴得緊少少，再檢查 Phase Wake 係咪可以量度你嘅心跳。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "夜里把手表戴得稍紧一些，并检查 Phase Wake 是否有权测量心率。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "夜裡把手錶戴得稍緊一些，並檢查 Phase Wake 是否有權測量心率。"
          }
        },
        "zu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ebusuku gqoka iwashi liqine kancane futhi uhlole ukuthi i-Phase Wake ivunyelwe yini ukukala ukushaya kwenhliziyo yakho."
          }
        }
      }
    },
