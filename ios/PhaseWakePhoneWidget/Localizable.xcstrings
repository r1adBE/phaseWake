        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutaj mogą się też pojawiać noce z aplikacji Apple Health i innych aplikacji. Aby je zobaczyć, porównaj z danymi zdrowotnymi."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Noites do Apple Health e de outros apps também podem aparecer aqui. Para vê-las, compare com dados de saúde."
