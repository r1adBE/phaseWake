        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "પહેલી %1$lld મિ. માપી નથી – Apple Watch લક્ષ્ય પહેલાંની ફક્ત છેલ્લી %2$lld મિ. માપે છે."
