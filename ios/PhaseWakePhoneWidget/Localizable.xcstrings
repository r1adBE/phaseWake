        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ყველაფერი რჩება შენს ტელეფონსა და საათზე. არც ანგარიში, არც სერვერი, არც თვალთვალი."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бәрі телефоныңда және сағатыңда қалады. Аккаунт жоқ, сервер жоқ, бақылау жоқ."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "អ្វីៗទាំងអស់នៅលើទូរសព្ទ និងនាឡិការបស់អ្នក។ គ្មានគណនី គ្មានម៉ាស៊ីនមេ គ្មានការតាមដាន។"
