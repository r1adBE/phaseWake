          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Реши 3 сметки, преди будилникът да спре. Отлагането става и без задача."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অ্যালার্ম থামার আগে ৩টি যোগ অঙ্ক করো। স্নুজ কাজ ছাড়াই চলে।"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Riješi 3 sabiranja prije nego što alarm utihne. Odgoda radi i bez zadatka."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Resol 3 sumes perquè l’alarma calli. Posposar funciona sense tasca."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyřeš 3 příklady, než budík utichne. Odložení funguje bez příkladu."
