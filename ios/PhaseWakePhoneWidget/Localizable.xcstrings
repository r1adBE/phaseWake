        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Քնելու ժամից 1 ժամ առաջ ժամացույցդ կարճ ժամանակով չափում է շարժումը, մինչև քնես։ Միայն Galaxy Watch։"
          }
        },
        "id": {
          "stringUnit": {
