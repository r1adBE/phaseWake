    "night_unmeasured_apple": {
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Eerste %1$lld min nie gemeet nie – die Apple Watch meet net die laaste %2$lld min voor die teikentyd."
          }
        },
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "የመጀመሪያዎቹ %1$lld ደቂቃዎች አልተለኩም – Apple Watch የሚለካው ከታለመው ሰዓት በፊት ያሉትን የመጨረሻ %2$lld ደቂቃዎች ብቻ ነው።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أول %1$lld د لم تُقس – لا تقيس Apple Watch إلا آخر %2$lld د قبل الموعد."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "İlk %1$lld dəq ölçülməyib – Apple Watch yalnız hədəfdən əvvəlki son %2$lld dəqiqəni ölçür."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Първите %1$lld мин не са измерени – Apple Watch измерва само последните %2$lld мин преди целевия час."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "প্রথম %1$lld মি. মাপা হয়নি – Apple Watch শুধু লক্ষ্যের আগের শেষ %2$lld মি. মাপে।"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Prvih %1$lld min nije izmjereno – Apple Watch mjeri samo zadnjih %2$lld min prije ciljnog vremena."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Els primers %1$lld min no s’han mesurat – l’Apple Watch només mesura els últims %2$lld min abans de l’hora objectiu."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Prvních %1$lld min neměřeno – Apple Watch měří jen posledních %2$lld min před cílovým časem."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Første %1$lld min ikke målt – Apple Watch måler kun de sidste %2$lld min før ønsket tid."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erste %1$lld Min nicht gemessen – die Apple Watch misst nur die letzten %2$lld Min vor der Zielzeit."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τα πρώτα %1$lld λ. δεν μετρήθηκαν – το Apple Watch μετρά μόνο τα τελευταία %2$lld λ. πριν τον στόχο."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "First %1$lld min not measured – the Apple Watch only measures the last %2$lld min before the target."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Primeros %1$lld min sin medir: el Apple Watch solo mide los últimos %2$lld min antes de la hora objetivo."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Esimesed %1$lld min mõõtmata – Apple Watch mõõdab ainult viimast %2$lld min enne sihtaega."
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "Lehen %1$lld minutuak neurtu gabe – Apple Watch-ek helburuaren aurreko azken %2$lld minutuak bakarrik neurtzen ditu."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld دق اول اندازه‌گیری نشد – Apple Watch فقط %2$lld دق آخر پیش از زمان هدف را اندازه می‌گیرد."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ensimmäiset %1$lld min mittaamatta – Apple Watch mittaa vain viimeiset %2$lld min ennen tavoiteaikaa."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi nasukat ang unang %1$lld min – sinusukat lang ng Apple Watch ang huling %2$lld min bago ang target."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld premières min non mesurées – l’Apple Watch ne mesure que les %2$lld dernières min avant l’heure cible."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Na chéad %1$lld nóim gan tomhas – ní thomhaiseann an Apple Watch ach na %2$lld nóim deireanacha roimh an sprioc."
          }
        },
        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "Primeiros %1$lld min sen medir – o Apple Watch só mide os últimos %2$lld min antes da hora prevista."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "પહેલી %1$lld મિ. માપી નથી – Apple Watch લક્ષ્ય પહેલાંની ફક્ત છેલ્લી %2$lld મિ. માપે છે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld הדק׳ הראשונות לא נמדדו – Apple Watch מודד רק את %2$lld הדק׳ האחרונות לפני היעד."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पहले %1$lld मि. मापे नहीं गए – Apple Watch लक्ष्य से पहले के केवल आख़िरी %2$lld मि. मापती है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prvih %1$lld min nije izmjereno – Apple Watch mjeri samo zadnjih %2$lld min prije ciljnog vremena."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az első %1$lld p nincs mérve – az Apple Watch csak a célidő előtti utolsó %2$lld percet méri."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Առաջին %1$lld ր-ն չի չափվել – Apple Watch-ը չափում է միայն նպատակային ժամից առաջ վերջին %2$lld ր-ն։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld mnt pertama tidak diukur – Apple Watch hanya mengukur %2$lld mnt terakhir sebelum target."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Fyrstu %1$lld mín ekki mældar – Apple Watch mælir aðeins síðustu %2$lld mín fyrir markmiðið."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Primi %1$lld min non misurati – l’Apple Watch misura solo gli ultimi %2$lld min prima dell’orario obiettivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最初の%1$lld分は未計測 – Apple Watchが計測するのは目標時刻前の最後の%2$lld分だけです。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "პირველი %1$lld წთ არ გაიზომა – Apple Watch ზომავს მხოლოდ ბოლო %2$lld წთ-ს სამიზნემდე."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Алғашқы %1$lld мин өлшенбеді – Apple Watch мақсатты уақытқа дейінгі соңғы %2$lld минутты ғана өлшейді."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld នាទីដំបូងមិនបានវាស់ – Apple Watch វាស់តែ %2$lld នាទីចុងក្រោយមុនម៉ោងគោលដៅ។"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಮೊದಲ %1$lld ನಿಮಿ. ಅಳೆಯಲಾಗಿಲ್ಲ – Apple Watch ಗುರಿಗೆ ಮುಂಚಿನ ಕೊನೆಯ %2$lld ನಿಮಿ. ಮಾತ್ರ ಅಳೆಯುತ್ತದೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "처음 %1$lld분은 측정되지 않음 – Apple Watch는 목표 전 마지막 %2$lld분만 측정합니다."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld ນາທີທຳອິດບໍ່ໄດ້ວັດແທກ – Apple Watch ວັດແທກສະເພາະ %2$lld ນາທີສຸດທ້າຍກ່ອນເວລາເປົ້າໝາຍ"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pirmosios %1$lld min neišmatuotos – Apple Watch matuoja tik paskutines %2$lld min iki tikslinio laiko."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Pirmās %1$lld min nav izmērītas – Apple Watch mēra tikai pēdējās %2$lld min pirms mērķa laika."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Првите %1$lld мин не се измерени – Apple Watch ги мери само последните %2$lld мин пред целта."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ആദ്യ %1$lld മി. അളന്നില്ല – ലക്ഷ്യത്തിനു മുമ്പുള്ള അവസാന %2$lld മി. മാത്രമേ Apple Watch അളക്കൂ."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Эхний %1$lld мин хэмжигдээгүй – Apple Watch зөвхөн зорилтот цагаас өмнөх сүүлийн %2$lld минутыг хэмждэг."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "पहिली %1$lld मि. मोजली नाहीत – Apple Watch लक्ष्यापूर्वीची फक्त शेवटची %2$lld मि. मोजते."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld min pertama tidak diukur – Apple Watch hanya mengukur %2$lld min terakhir sebelum sasaran."
          }
        },
        "my": {
          "stringUnit": {
            "state": "translated",
            "value": "ပထမ %1$lld မိနစ် မတိုင်းရ – Apple Watch သည် ပစ်မှတ်မတိုင်မီ နောက်ဆုံး %2$lld မိနစ်ကိုသာ တိုင်းသည်။"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Første %1$lld min ikke målt – Apple Watch måler bare de siste %2$lld min før ønsket tid."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "पहिलो %1$lld मि. मापन भएन – Apple Watch ले लक्षित समयअघिको अन्तिम %2$lld मिनेट मात्र मापन गर्छ।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Eerste %1$lld min niet gemeten – de Apple Watch meet alleen de laatste %2$lld min voor de doeltijd."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਪਹਿਲੇ %1$lld ਮਿੰ. ਨਹੀਂ ਮਾਪੇ – Apple Watch ਟੀਚੇ ਤੋਂ ਪਹਿਲਾਂ ਸਿਰਫ਼ ਆਖਰੀ %2$lld ਮਿੰ. ਮਾਪਦੀ ਹੈ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pierwsze %1$lld min bez pomiaru – Apple Watch mierzy tylko ostatnie %2$lld min przed czasem docelowym."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Primeiros %1$lld min sem medição – o Apple Watch só mede os últimos %2$lld min antes do horário-alvo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Primeiros %1$lld min sem medição – o Apple Watch só mede os últimos %2$lld min antes da hora-alvo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Primele %1$lld min nemăsurate – Apple Watch măsoară doar ultimele %2$lld min dinainte de ora țintă."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Первые %1$lld мин не измерены – Apple Watch измеряют только последние %2$lld мин до цели."
          }
        },
        "si": {
          "stringUnit": {
            "state": "translated",
            "value": "පළමු මිනි. %1$lld මැනුණේ නැත – Apple Watch මනින්නේ ඉලක්ක වේලාවට පෙර අවසන් මිනිත්තු %2$lld පමණි."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Prvých %1$lld min nemerané – Apple Watch meria iba posledných %2$lld min pred cieľovým časom."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Prvih %1$lld min ni izmerjenih – Apple Watch meri le zadnjih %2$lld min pred ciljnim časom."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld min e para pa matje – Apple Watch mat vetëm %2$lld min e fundit para orës së synuar."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Првих %1$lld мин није измерено – Apple Watch мери само последњих %2$lld мин пре циљног времена."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Första %1$lld min inte uppmätta – Apple Watch mäter bara de sista %2$lld min före önskad tid."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Dak %1$lld za kwanza hazikupimwa – Apple Watch hupima dak %2$lld za mwisho tu kabla ya muda lengwa."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "முதல் %1$lld நிமி. அளவிடப்படவில்லை – Apple Watch இலக்குக்கு முந்தைய கடைசி %2$lld நிமி. மட்டுமே அளவிடும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మొదటి %1$lld ని. కొలవలేదు – Apple Watch లక్ష్యానికి ముందు చివరి %2$lld ని. మాత్రమే కొలుస్తుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld นาทีแรกไม่ได้วัด – Apple Watch วัดเฉพาะ %2$lld นาทีสุดท้ายก่อนเวลาเป้าหมาย"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İlk %1$lld dk ölçülmedi – Apple Watch yalnızca hedef saatten önceki son %2$lld dk’yı ölçer."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перші %1$lld хв не виміряно – Apple Watch вимірює лише останні %2$lld хв до цілі."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "پہلے %1$lld منٹ کی پیمائش نہیں ہوئی – Apple Watch صرف ہدف سے پہلے کے آخری %2$lld منٹ ناپتی ہے۔"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Birinchi %1$lld daq oʻlchanmadi – Apple Watch faqat belgilangan vaqtdan oldingi oxirgi %2$lld daqiqani oʻlchaydi."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld phút đầu không được đo – Apple Watch chỉ đo %2$lld phút cuối trước giờ mục tiêu."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "首 %1$lld 分鐘未有測量 – Apple Watch 只會測量目標時間前最後 %2$lld 分鐘。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
