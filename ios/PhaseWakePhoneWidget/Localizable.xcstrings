    "learn_nights_empty": {
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Nog geen nag nie. Die eerste verskyn hier die oggend daarna."
          }
        },
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "እስካሁን ምንም ሌሊት የለም። የመጀመሪያው በማግስቱ ጠዋት እዚህ ይታያል።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا توجد ليلة بعد. تظهر الأولى هنا في الصباح التالي."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Hələ gecə yoxdur. Birincisi səhəri gün burada görünəcək."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Още няма нощ. Първата ще се появи тук на следващата сутрин."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এখনো কোনো রাত নেই। প্রথমটি পরের দিন সকালে এখানে দেখা যাবে।"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Još nema noći. Prva se ovdje pojavljuje sljedećeg jutra."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Encara no hi ha cap nit. La primera apareixerà aquí l’endemà al matí."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zatím žádná noc. První se tu objeví ráno po ní."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen nat endnu. Den første vises her morgenen efter."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch keine Nacht. Die erste erscheint hier am Morgen danach."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν υπάρχει ακόμη νύχτα. Η πρώτη εμφανίζεται εδώ το επόμενο πρωί."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No night yet. The first one shows up here the morning after."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todavía no hay ninguna noche. La primera aparecerá aquí a la mañana siguiente."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Veel pole ühtegi ööd. Esimene ilmub siia järgmisel hommikul."
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "Oraindik ez dago gaurik. Lehena biharamun goizean agertuko da hemen."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "هنوز شبی نیست. اولین شب صبح روز بعد اینجا نشان داده می‌شود."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ei vielä yhtään yötä. Ensimmäinen näkyy täällä seuraavana aamuna."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Wala pang gabi. Lalabas dito ang una kinaumagahan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune nuit pour l’instant. La première apparaîtra ici le lendemain matin."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Níl oíche ar bith ann fós. Taispeánfar an chéad cheann anseo an mhaidin dar gcionn."
          }
        },
        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aínda non hai ningunha noite. A primeira aparecerá aquí á mañá seguinte."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "હજુ કોઈ રાત નથી. પહેલી રાત બીજા દિવસે સવારે અહીં દેખાશે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "עדיין אין לילה. הראשון יופיע כאן למחרת בבוקר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अभी कोई रात नहीं है। पहली रात अगली सुबह यहाँ दिखेगी।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Još nema noći. Prva se ovdje pojavljuje sljedećeg jutra."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Még nincs éjszaka. Az első másnap reggel jelenik meg itt."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Դեռ գիշեր չկա։ Առաջինը կհայտնվի այստեղ հաջորդ առավոտ։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Belum ada malam. Malam pertama muncul di sini keesokan paginya."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Engin nótt enn. Sú fyrsta birtist hér morguninn eftir."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ancora nessuna notte. La prima apparirà qui la mattina dopo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まだ夜がありません。最初の夜は翌朝ここに表示されます。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ჯერ ღამე არ არის. პირველი აქ მეორე დილით გამოჩნდება."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Әзірге түн жоқ. Біріншісі келесі күні таңертең осында көрінеді."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "មិនទាន់មានយប់ណាមួយទេ។ យប់ដំបូងនឹងបង្ហាញនៅទីនេះនៅព្រឹកបន្ទាប់។"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಇನ್ನೂ ಯಾವುದೇ ರಾತ್ರಿ ಇಲ್ಲ. ಮೊದಲನೆಯದು ಮರುದಿನ ಬೆಳಿಗ್ಗೆ ಇಲ್ಲಿ ಕಾಣಿಸುತ್ತದೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 밤이 없습니다. 첫 밤은 다음 날 아침 여기에 표시됩니다."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ຍັງບໍ່ມີຄືນໃດ. ຄືນທຳອິດຈະສະແດງຢູ່ນີ້ໃນຕອນເຊົ້າມື້ຕໍ່ມາ."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Dar nėra nakties. Pirmoji čia pasirodys kitą rytą."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vēl nav nevienas nakts. Pirmā šeit parādīsies nākamajā rītā."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сè уште нема ноќ. Првата ќе се појави тука следното утро."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഇതുവരെ രാത്രിയൊന്നുമില്ല. ആദ്യത്തേത് പിറ്റേന്ന് രാവിലെ ഇവിടെ കാണാം."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Одоогоор шөнө алга. Эхнийх нь дараагийн өглөө энд харагдана."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "अजून एकही रात्र नाही. पहिली रात्र दुसऱ्या दिवशी सकाळी इथे दिसेल."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Belum ada malam lagi. Malam pertama dipaparkan di sini pada pagi berikutnya."
          }
        },
        "my": {
          "stringUnit": {
            "state": "translated",
            "value": "ည မရှိသေးပါ။ ပထမညကို နောက်တစ်နေ့ မနက် ဒီမှာ ပြပါမည်။"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen natt ennå. Den første vises her morgenen etter."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "अहिलेसम्म कुनै रात छैन। पहिलो रात भोलिपल्ट बिहान यहाँ देखिन्छ।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nog geen nacht. De eerste verschijnt hier de ochtend erna."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਹਾਲੇ ਕੋਈ ਰਾਤ ਨਹੀਂ। ਪਹਿਲੀ ਰਾਤ ਅਗਲੀ ਸਵੇਰ ਇੱਥੇ ਦਿਖੇਗੀ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie ma jeszcze żadnej nocy. Pierwsza pojawi się tu następnego ranka."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda não há nenhuma noite. A primeira aparece aqui na manhã seguinte."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda não há nenhuma noite. A primeira aparece aqui na manhã seguinte."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Încă nicio noapte. Prima apare aici în dimineața următoare."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пока нет ни одной ночи. Первая появится здесь на следующее утро."
          }
        },
        "si": {
          "stringUnit": {
            "state": "translated",
            "value": "තවම රාත්‍රියක් නැත. පළමු රාත්‍රිය පසුදා උදෑසන මෙහි පෙන්වයි."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zatiaľ žiadna noc. Prvá sa tu zobrazí na druhý deň ráno."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Še ni nobene noči. Prva se tukaj prikaže naslednje jutro."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Ende asnjë natë. E para shfaqet këtu mëngjesin pas."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Још нема ноћи. Прва се овде појављује следећег јутра."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen natt än. Den första visas här morgonen efter."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Bado hakuna usiku. Wa kwanza utaonekana hapa asubuhi inayofuata."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இன்னும் இரவு இல்லை. முதல் இரவு மறுநாள் காலை இங்கே தோன்றும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఇంకా రాత్రి ఏదీ లేదు. మొదటిది మరుసటి రోజు ఉదయం ఇక్కడ కనిపిస్తుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยังไม่มีคืนใด คืนแรกจะแสดงที่นี่ในเช้าวันถัดไป"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Henüz gece yok. İlki ertesi sabah burada görünür."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Поки немає жодної ночі. Перша з’явиться тут наступного ранку."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ابھی کوئی رات نہیں۔ پہلی رات اگلی صبح یہاں نظر آئے گی۔"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Hali tun yo‘q. Birinchisi ertasi kuni ertalab shu yerda ko‘rinadi."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chưa có đêm nào. Đêm đầu tiên sẽ hiện ở đây vào sáng hôm sau."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "仲未有夜晚。第一晚會喺第二朝喺度顯示。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "还没有夜晚。第一晚会在第二天早上显示在这里。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "還沒有夜晚。第一晚會在隔天早上顯示在這裡。"
          }
        },
        "zu": {
          "stringUnit": {
            "state": "translated",
            "value": "Abukho ubusuku okwamanje. Obokuqala buzovela lapha ekuseni okulandelayo."
          }
        }
      }
    },
    "learn_nights_intro": {
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Elke nag sedert die leerfase begin het – of dit getel het en, indien nie, hoekom en wat help. Phase Wake het %1$lld getelde nagte nodig."
          }
        },
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "የመማሪያ ጊዜው ከጀመረ ጀምሮ እያንዳንዱ ሌሊት – ተቆጥሮ እንደሆነ፣ ካልሆነ ደግሞ ለምን እና ምን እንደሚረዳ። Phase Wake %1$lld የተቆጠሩ ሌሊቶች ያስፈልጉታል።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كل ليلة منذ بدء مرحلة التعلّم – هل احتُسبت، وإن لم تُحتسب فلماذا وما الذي يساعد. يحتاج Phase Wake إلى %1$lld ليالٍ محتسبة."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Öyrənmə mərhələsi başlayandan bəri hər gecə – sayılıb, ya yox; sayılmayıbsa, niyə və nə kömək edər. Phase Wake-ə %1$lld sayılmış gecə lazımdır."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Всяка нощ от началото на фазата на учене – дали е отчетена и ако не, защо и какво помага. Phase Wake се нуждае от %1$lld отчетени нощи."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "শেখার পর্ব শুরু হওয়ার পর থেকে প্রতিটি রাত – গণনা হয়েছে কি না, আর না হলে কেন এবং কী সাহায্য করবে। Phase Wake-এর %1$lldটি গণনা করা রাত দরকার।"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Svaka noć od početka faze učenja – da li je uračunata i, ako nije, zašto i šta pomaže. Phase Wake treba %1$lld uračunatih noći."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada nit des que va començar la fase d’aprenentatge: si ha comptat i, si no, per què i què hi ajuda. Phase Wake necessita %1$lld nits comptades."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Každá noc od začátku fáze učení – zda se započítala, a pokud ne, proč a co pomůže. Phase Wake potřebuje %1$lld započítaných nocí."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hver nat siden læringsfasen startede – om den talte med, og hvis ikke, hvorfor og hvad der hjælper. Phase Wake skal bruge %1$lld nætter, der tæller."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jede Nacht seit dem Beginn der Lernphase – ob sie gezählt hat und, wenn nicht, warum und was hilft. Phase Wake braucht %1$lld gezählte Nächte."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κάθε νύχτα από την αρχή της φάσης εκμάθησης – αν μέτρησε και, αν όχι, γιατί και τι βοηθά. Το Phase Wake χρειάζεται %1$lld νύχτες που μετράνε."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every night since the learning phase started – whether it counted and, if not, why and what helps. Phase Wake needs %1$lld counted nights."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada noche desde que empezó la fase de aprendizaje: si contó y, si no, por qué y qué ayuda. Phase Wake necesita %1$lld noches contadas."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Iga öö õppefaasi algusest – kas see läks arvesse ja kui ei, siis miks ja mis aitab. Phase Wake vajab %1$lld arvesse läinud ööd."
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ikasketa-fasea hasi zenetik gau bakoitza: zenbatu den ala ez, eta ez bada, zergatik eta zerk laguntzen duen. Phase Wake-k %1$lld gau zenbatu behar ditu."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "هر شب از آغاز مرحلهٔ یادگیری – آیا حساب شد و اگر نه، چرا و چه چیزی کمک می‌کند. Phase Wake به %1$lld شبِ حساب‌شده نیاز دارد."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jokainen yö oppimisvaiheen alusta – laskettiinko se ja jos ei, miksi ja mikä auttaa. Phase Wake tarvitsee %1$lld laskettua yötä."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Bawat gabi mula nang magsimula ang yugto ng pagkatuto – kung nabilang ito at, kung hindi, bakit at ano ang makakatulong. Kailangan ng Phase Wake ng %1$lld nabilang na gabi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque nuit depuis le début de la phase d’apprentissage : si elle a compté et, sinon, pourquoi et ce qui aide. Phase Wake a besoin de %1$lld nuits comptées."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Gach oíche ó thosaigh an chéim foghlama – ar comhaireadh í agus, mura ndearnadh, cén fáth agus cad a chabhródh. Tá %1$lld oíche chomhairthe de dhíth ar Phase Wake."
          }
        },
        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada noite desde que comezou a fase de aprendizaxe: se contou e, se non, por que e que axuda. Phase Wake necesita %1$lld noites contadas."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "શીખવાનો તબક્કો શરૂ થયો ત્યારથી દરેક રાત – તે ગણાઈ કે નહીં, અને ન ગણાઈ તો શા માટે અને શું મદદ કરે. Phase Wake ને %1$lld ગણાયેલી રાતો જોઈએ."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כל לילה מאז תחילת שלב הלמידה – האם נספר, ואם לא, למה ומה עוזר. Phase Wake צריך %1$lld לילות שנספרו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सीखने का चरण शुरू होने के बाद से हर रात – वह गिनी गई या नहीं, और अगर नहीं, तो क्यों और क्या मदद करेगा। Phase Wake को %1$lld गिनी गई रातें चाहिए।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Svaka noć od početka faze učenja – je li uračunata i, ako nije, zašto i što pomaže. Phase Wake treba %1$lld uračunatih noći."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Minden éjszaka a tanulási szakasz kezdete óta – beszámított-e, és ha nem, miért, és mi segít. A Phase Wake-nek %1$lld beszámított éjszakára van szüksége."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ամեն գիշեր ուսուցման փուլի սկզբից – հաշվվե՞լ է, և եթե ոչ, ինչու և ինչն է օգնում։ Phase Wake-ին պետք է %1$lld հաշվված գիշեր։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Setiap malam sejak fase belajar dimulai – apakah terhitung dan, jika tidak, apa sebabnya dan apa yang membantu. Phase Wake memerlukan %1$lld malam yang terhitung."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Hver nótt frá upphafi námsfasans – hvort hún taldist með og, ef ekki, hvers vegna og hvað hjálpar. Phase Wake þarf %1$lld nætur sem teljast með."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni notte dall’inizio della fase di apprendimento: se è stata conteggiata e, se no, perché e cosa aiuta. Phase Wake ha bisogno di %1$lld notti conteggiate."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "学習期間が始まってからの各夜――カウントされたか、されなかった場合はその理由と対策。Phase Wake にはカウントされた夜が %1$lld 夜必要です。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ყოველი ღამე სწავლის ფაზის დაწყებიდან – ჩაითვალა თუ არა, და თუ არა, რატომ და რა დაგეხმარება. Phase Wake-ს %1$lld ჩათვლილი ღამე სჭირდება."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Үйрену кезеңі басталғаннан бергі әр түн – есепке алынды ма, алынбаса, неге және не көмектеседі. Phase Wake-ке есепке алынған %1$lld түн керек."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "យប់នីមួយៗ តាំងពីដំណាក់កាលរៀនចាប់ផ្ដើម – តើវាត្រូវបានរាប់ឬអត់ ហើយបើមិនរាប់ ហេតុអ្វី និងអ្វីអាចជួយបាន។ Phase Wake ត្រូវការ %1$lld យប់ដែលបានរាប់។"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಕಲಿಕೆಯ ಹಂತ ಆರಂಭವಾದಾಗಿನಿಂದ ಪ್ರತಿ ರಾತ್ರಿ – ಅದು ಎಣಿಕೆಯಾಯಿತೇ, ಇಲ್ಲದಿದ್ದರೆ ಏಕೆ ಮತ್ತು ಏನು ಸಹಾಯ ಮಾಡುತ್ತದೆ. Phase Wake ಗೆ %1$lld ಎಣಿಕೆಯಾದ ರಾತ್ರಿಗಳು ಬೇಕು."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "학습 단계가 시작된 뒤의 모든 밤 – 반영되었는지, 아니라면 이유와 도움이 되는 방법. Phase Wake에는 반영된 밤이 %1$lld번 필요합니다."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ທຸກຄືນນັບແຕ່ໄລຍະຮຽນຮູ້ເລີ່ມຕົ້ນ – ນັບແລ້ວບໍ່ ແລະ ຖ້າບໍ່ ເປັນຫຍັງ ແລະ ຫຍັງຊ່ວຍໄດ້. Phase Wake ຕ້ອງການ %1$lld ຄືນທີ່ນັບແລ້ວ."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Kiekviena naktis nuo mokymosi etapo pradžios – ar ji įskaityta, o jei ne, kodėl ir kas padės. Phase Wake reikia %1$lld įskaitytų naktų."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Katra nakts kopš mācīšanās posma sākuma – vai tā ieskaitīta un, ja nē, kāpēc un kas palīdz. Phase Wake vajag %1$lld ieskaitītas naktis."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Секоја ноќ од почетокот на фазата на учење – дали е пресметана и, ако не, зошто и што помага. На Phase Wake му требаат %1$lld пресметани ноќи."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "പഠന ഘട്ടം തുടങ്ങിയതുമുതൽ ഓരോ രാത്രിയും – അത് എണ്ണപ്പെട്ടോ, ഇല്ലെങ്കിൽ എന്തുകൊണ്ട്, എന്ത് സഹായിക്കും. Phase Wake-ന് എണ്ണപ്പെട്ട %1$lld രാത്രികൾ വേണം."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Суралцах үе эхэлснээс хойших шөнө бүр – тоологдсон эсэх, тоологдоогүй бол яагаад, юу туслах вэ. Phase Wake-д тоологдсон %1$lld шөнө хэрэгтэй."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "शिकण्याचा टप्पा सुरू झाल्यापासून प्रत्येक रात्र – ती मोजली गेली का, आणि नसेल तर का आणि काय मदत करेल. Phase Wake ला %1$lld मोजलेल्या रात्री लागतात."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Setiap malam sejak fasa pembelajaran bermula – sama ada dikira dan, jika tidak, sebabnya dan apa yang membantu. Phase Wake memerlukan %1$lld malam yang dikira."
          }
        },
        "my": {
          "stringUnit": {
            "state": "translated",
            "value": "သင်ယူမှုအဆင့် စတင်ကတည်းက ည တစ်ညစီ – ရေတွက်ခဲ့သလား၊ မရေတွက်ရင် ဘာကြောင့်လဲ၊ ဘာက ကူညီနိုင်လဲ။ Phase Wake အတွက် ရေတွက်ထားသော ည %1$lld ည လိုအပ်သည်။"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hver natt siden læringsfasen startet – om den telte med, og hvis ikke, hvorfor og hva som hjelper. Phase Wake trenger %1$lld netter som teller."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "सिक्ने चरण सुरु भएदेखि हरेक रात – गनियो कि गनिएन, र गनिएन भने किन र के ले मद्दत गर्छ। Phase Wake लाई %1$lld गनिएका रात चाहिन्छ।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Elke nacht sinds de leerfase begon – of hij meetelde en, zo niet, waarom en wat helpt. Phase Wake heeft %1$lld getelde nachten nodig."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਸਿੱਖਣ ਦਾ ਪੜਾਅ ਸ਼ੁਰੂ ਹੋਣ ਤੋਂ ਬਾਅਦ ਹਰ ਰਾਤ – ਕੀ ਉਹ ਗਿਣੀ ਗਈ, ਅਤੇ ਜੇ ਨਹੀਂ ਤਾਂ ਕਿਉਂ ਅਤੇ ਕੀ ਮਦਦ ਕਰੇਗਾ। Phase Wake ਨੂੰ %1$lld ਗਿਣੀਆਂ ਰਾਤਾਂ ਚਾਹੀਦੀਆਂ ਹਨ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Każda noc od początku fazy nauki – czy została zaliczona, a jeśli nie, to dlaczego i co pomoże. Phase Wake potrzebuje %1$lld zaliczonych nocy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada noite desde o início da fase de aprendizado: se contou e, se não, por quê e o que ajuda. O Phase Wake precisa de %1$lld noites contadas."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada noite desde o início da fase de aprendizagem: se contou e, se não, porquê e o que ajuda. O Phase Wake precisa de %1$lld noites contadas."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Fiecare noapte de la începutul fazei de învățare – dacă a contat și, dacă nu, de ce și ce ajută. Phase Wake are nevoie de %1$lld nopți numărate."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Каждая ночь с начала этапа обучения – засчитана ли она, а если нет, то почему и что поможет. Phase Wake нужно %1$lld засчитанных ночей."
          }
        },
        "si": {
          "stringUnit": {
            "state": "translated",
            "value": "ඉගෙනීමේ අදියර ආරම්භ වූ දා සිට සෑම රාත්‍රියක්ම – එය ගණන් ගත්තාද, නැතිනම් ඇයි සහ උදව් වන්නේ කුමක්ද. Phase Wake ට ගණන් ගත් රාත්‍රී %1$lld ක් අවශ්‍යයි."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Každá noc od začiatku fázy učenia – či sa započítala, a ak nie, prečo a čo pomôže. Phase Wake potrebuje %1$lld započítaných nocí."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vsaka noč od začetka faze učenja – ali je štela in, če ni, zakaj in kaj pomaga. Phase Wake potrebuje %1$lld štetih noči."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Çdo natë që nga fillimi i fazës së të mësuarit – nëse u numërua dhe, nëse jo, pse dhe çfarë ndihmon. Phase Wake ka nevojë për %1$lld net të numëruara."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Свака ноћ од почетка фазе учења – да ли је урачуната и, ако није, зашто и шта помаже. Phase Wake треба %1$lld урачунатих ноћи."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Varje natt sedan inlärningsfasen började – om den räknades och, om inte, varför och vad som hjälper. Phase Wake behöver %1$lld räknade nätter."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Kila usiku tangu hatua ya kujifunza ilipoanza – kama ulihesabiwa na, kama sivyo, kwa nini na nini kinasaidia. Phase Wake inahitaji usiku %1$lld uliohesabiwa."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "கற்றல் நிலை தொடங்கியதிலிருந்து ஒவ்வொரு இரவும் – அது கணக்கிடப்பட்டதா, இல்லையெனில் ஏன், எது உதவும். Phase Wake-க்கு கணக்கிடப்பட்ட %1$lld இரவுகள் தேவை."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "నేర్చుకునే దశ మొదలైనప్పటి నుంచి ప్రతి రాత్రి – అది లెక్కలోకి వచ్చిందా, రాకపోతే ఎందుకు, ఏది సహాయపడుతుంది. Phase Wake‌కు లెక్కలోకి వచ్చిన %1$lld రాత్రులు కావాలి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทุกคืนตั้งแต่ช่วงเรียนรู้เริ่มต้น – นับแล้วหรือไม่ และถ้าไม่นับ เพราะอะไรและอะไรช่วยได้ Phase Wake ต้องการคืนที่นับแล้ว %1$lld คืน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Öğrenme aşaması başladığından beri her gece – sayıldı mı, sayılmadıysa neden ve ne yardımcı olur. Phase Wake'in %1$lld sayılmış geceye ihtiyacı var."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кожна ніч від початку етапу навчання – чи її зараховано, а якщо ні, то чому і що допоможе. Phase Wake потребує %1$lld зарахованих ночей."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "سیکھنے کا مرحلہ شروع ہونے کے بعد سے ہر رات – کیا وہ گنی گئی، اور اگر نہیں تو کیوں اور کیا مدد کرے گا۔ Phase Wake کو %1$lld گنی ہوئی راتیں چاہییں۔"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "O‘rganish bosqichi boshlanganidan beri har bir tun – hisobga olindimi, olinmagan bo‘lsa, nega va nima yordam beradi. Phase Wake uchun %1$lld ta hisobga olingan tun kerak."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mỗi đêm kể từ khi giai đoạn học bắt đầu – đêm đó có được tính không, và nếu không thì vì sao và điều gì giúp ích. Phase Wake cần %1$lld đêm được tính."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "學習階段開始以來嘅每一晚——有冇計入；如果冇，原因係乜、點樣改善。Phase Wake 需要 %1$lld 晚計入咗嘅夜晚。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "学习阶段开始以来的每一晚——是否已计入；如果没有，原因是什么、怎样改善。Phase Wake 需要 %1$lld 个计入的夜晚。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "學習階段開始以來的每一晚——是否已計入；若沒有，原因為何、怎樣改善。Phase Wake 需要 %1$lld 個計入的夜晚。"
          }
        },
        "zu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ubusuku ngabunye kusukela isigaba sokufunda saqala – ukuthi babalwa yini futhi, uma kungenjalo, kungani nokuthi yini esizayo. I-Phase Wake idinga ubusuku obubaliwe obungu-%1$lld."
          }
        }
      }
    },
    "learn_point_battery": {
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit gebruik ’n bietjie battery – laai die horlosie voor jy gaan slaap."
          }
        },
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "ይህ ትንሽ ባትሪ ይጠቀማል – ከመተኛትህ በፊት ሰዓቱን ቻርጅ አድርግ።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يستهلك ذلك بعض البطارية – اشحن الساعة قبل النوم."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu, bir az batareya sərf edir – yatmazdan əvvəl saatı doldur."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Това изразходва малко батерия – зареди часовника преди сън."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এতে কিছুটা ব্যাটারি লাগে – ঘুমানোর আগে ঘড়ি চার্জ করো।"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "To troši nešto baterije – napuni sat prije spavanja."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Això gasta una mica de bateria – carrega el rellotge abans de dormir."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Spotřebuje to trochu baterie – nabij hodinky před spaním."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Det bruger lidt batteri – oplad uret, før du sover."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das kostet etwas Akku – lade die Uhr vor dem Schlafen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτό καταναλώνει λίγη μπαταρία – φόρτισε το ρολόι πριν κοιμηθείς."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This uses some battery – charge the watch before you go to sleep."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto gasta algo de batería: carga el reloj antes de dormir."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "See kulutab veidi akut – lae kell enne magamaminekut."
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "Horrek bateria pixka bat gastatzen du – kargatu erlojua lo egin aurretik."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "این کار کمی باتری مصرف می‌کند – قبل از خواب ساعت را شارژ کن."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Se kuluttaa hieman akkua – lataa kello ennen nukkumaanmenoa."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Gumagamit ito ng kaunting baterya – i-charge ang relo bago matulog."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela consomme un peu de batterie – recharge la montre avant de dormir."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Úsáideann sé seo beagán ceallra – luchtaigh an t-uaireadóir sula dtéann tú a chodladh."
          }
        },
        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "Isto gasta algo de batería: carga o reloxo antes de durmir."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "આમાં થોડી બેટરી વપરાય છે – સૂતા પહેલાં ઘડિયાળ ચાર્જ કરો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "זה צורך מעט סוללה – כדאי לטעון את השעון לפני השינה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इसमें थोड़ी बैटरी लगती है – सोने से पहले घड़ी चार्ज करो।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "To troši nešto baterije – napuni sat prije spavanja."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez némi akkumulátort fogyaszt – alvás előtt töltsd fel az órát."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Սա որոշ չափով մարտկոց է ծախսում – քնելուց առաջ լիցքավորիր ժամացույցը։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ini memakai sedikit baterai – isi daya jam sebelum tidur."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Það notar dálítið af rafhlöðunni – hladdu úrið áður en þú ferð að sofa."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Consuma un po’ di batteria – ricarica l’orologio prima di dormire."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バッテリーを少し使います – 寝る前に時計を充電してください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ეს ცოტა ბატარეას ხარჯავს – დაძინებამდე დატენე საათი."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бұл біраз батарея жұмсайды – ұйықтар алдында сағатты зарядта."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "វាប្រើថ្មខ្លះ – សាកថ្មនាឡិកាមុនពេលគេង។"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಇದಕ್ಕೆ ಸ್ವಲ್ಪ ಬ್ಯಾಟರಿ ಬೇಕು – ಮಲಗುವ ಮೊದಲು ವಾಚ್ ಚಾರ್ಜ್ ಮಾಡಿ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "배터리를 조금 사용합니다 – 자기 전에 시계를 충전하세요."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ມັນໃຊ້ແບັດເຕີຣີບາງສ່ວນ – ສາກໂມງກ່ອນນອນ."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Tai sunaudoja šiek tiek baterijos – įkrauk laikrodį prieš miegą."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tas patērē nedaudz akumulatora – uzlādē pulksteni pirms gulētiešanas."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тоа троши малку батерија – наполни го часовникот пред спиење."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഇതിന് കുറച്ച് ബാറ്ററി വേണം – ഉറങ്ങുന്നതിന് മുമ്പ് വാച്ച് ചാർജ് ചെയ്യുക."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Энэ нь бага зэрэг батерей зарцуулна – унтахын өмнө цагаа цэнэглээрэй."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "यासाठी थोडी बॅटरी लागते – झोपण्यापूर्वी घड्याळ चार्ज करा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ini menggunakan sedikit bateri – cas jam sebelum tidur."
          }
        },
        "my": {
          "stringUnit": {
            "state": "translated",
            "value": "၎င်းသည် ဘက်ထရီ အနည်းငယ် သုံးသည် – မအိပ်မီ နာရီကို အားသွင်းပါ။"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Det bruker litt batteri – lad klokken før du legger deg."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "यसले केही ब्याट्री खपत गर्छ – सुत्नुअघि घडी चार्ज गर।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dat kost wat batterij – laad het horloge op voordat je gaat slapen."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਇਸ ਵਿੱਚ ਕੁਝ ਬੈਟਰੀ ਲੱਗਦੀ ਹੈ – ਸੌਣ ਤੋਂ ਪਹਿਲਾਂ ਘੜੀ ਚਾਰਜ ਕਰੋ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zużywa to trochę baterii – naładuj zegarek przed snem."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso gasta um pouco de bateria – carregue o relógio antes de dormir."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Isto gasta um pouco de bateria – carrega o relógio antes de dormir."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Asta consumă puțină baterie – încarcă ceasul înainte de culcare."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это расходует немного заряда – заряди часы перед сном."
          }
        },
        "si": {
          "stringUnit": {
            "state": "translated",
            "value": "මෙයට බැටරියෙන් ටිකක් වැය වේ – නින්දට පෙර ඔරලෝසුව ආරෝපණය කරන්න."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Spotrebuje to trochu batérie – nabi hodinky pred spaním."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "To porabi nekaj baterije – napolni uro pred spanjem."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Kjo harxhon pak bateri – karikoje orën para se të flesh."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "То троши нешто батерије – напуни сат пре спавања."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det drar lite batteri – ladda klockan innan du sover."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Hii hutumia betri kidogo – chaji saa kabla ya kulala."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இதற்குச் சிறிது பேட்டரி செலவாகும் – தூங்கும் முன் கடிகாரத்தை சார்ஜ் செய்யுங்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "దీనికి కొంత బ్యాటరీ ఖర్చవుతుంది – నిద్రపోయే ముందు వాచ్‌ను ఛార్జ్ చేయండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใช้แบตเตอรี่อยู่บ้าง – ชาร์จนาฬิกาก่อนนอน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu biraz pil harcar – uyumadan önce saati şarj et."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це витрачає трохи заряду – заряди годинник перед сном."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس میں کچھ بیٹری لگتی ہے – سونے سے پہلے گھڑی چارج کریں۔"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu biroz batareya sarflaydi – uxlashdan oldin soatni quvvatla."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Việc này tốn một ít pin – hãy sạc đồng hồ trước khi ngủ."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "咁樣會用一啲電量——瞓覺前記得幫手錶充電。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
