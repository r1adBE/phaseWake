    "nap_hint": {
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Maak jou ná hierdie tyd wakker, in die laaste minute al as jy onrustig word. Tel nie as ’n nag nie."
          }
        },
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "ከዚህ ጊዜ በኋላ ይቀሰቅስዎታል፣ በመጨረሻዎቹ ደቂቃዎች ውስጥ እረፍት ማጣት ከጀመሩ ቀደም ብሎ። እንደ ሌሊት አይቆጠርም።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يوقظك بعد هذه المدة، وفي الدقائق الأخيرة أبكر إذا بدأت بالتململ. لا تُحتسب ليلة."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu müddətdən sonra oyadır, son dəqiqələrdə isə narahat olsan, daha tez. Gecə kimi sayılmır."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Събужда те след това време, а в последните минути – по-рано, ако сънят ти стане неспокоен. Не се брои за нощ."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই সময়ের পরে জাগায়, শেষ কয়েক মিনিটে অস্থির হলে আগেই। রাত হিসেবে গোনা হয় না।"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Budi te nakon tog vremena, u zadnjim minutama već ako ti san postane nemiran. Ne računa se kao noć."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Et desperta passat aquest temps, i en els últims minuts ja si el son es torna inquiet. No compta com a nit."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vzbudí tě po této době, v posledních minutách už tehdy, když je tvůj spánek neklidný. Nepočítá se jako noc."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vækker dig efter denne tid, de sidste minutter allerede hvis du bliver urolig. Tæller ikke som en nat."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Weckt dich nach dieser Zeit, in den letzten Minuten schon, wenn du unruhig wirst. Zählt nicht als Nacht."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Σε ξυπνά μετά από αυτόν τον χρόνο, στα τελευταία λεπτά ήδη αν ο ύπνος σου γίνει ανήσυχος. Δεν μετράει ως νύχτα."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wakes you after this time, in the last minutes already if you get restless. Doesn’t count as a night."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Te despierta tras este tiempo, en los últimos minutos ya si te inquietas. No cuenta como noche."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Äratab pärast seda aega, viimastel minutitel juba siis, kui su uni muutub rahutuks. Ei loeta ööks."
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "Denbora hori igarotakoan esnatzen zaitu; azken minutuetan, ezinegona hasten bazaizu, lehenago. Ez da gau gisa zenbatzen."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "بعد از این مدت بیدارت می‌کند، در دقیقه‌های آخر هم اگر بی‌قرار شوی. شب حساب نمی‌شود."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Herättää sinut tämän ajan jälkeen, viimeisinä minuutteina jo silloin, kun unesi muuttuu levottomaksi. Ei lasketa yöksi."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Gigisingin ka pagkatapos ng oras na ito, at sa mga huling minuto ay mas maaga kung hindi ka na mapakali. Hindi binibilang bilang gabi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Te réveille après ce délai, dans les dernières minutes déjà si ton sommeil devient agité. Ne compte pas comme une nuit."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Dúiseoidh sé thú tar éis an ama seo, sna nóiméid dheireanacha cheana má éiríonn tú corrthónach. Ní áirítear é mar oíche."
          }
        },
        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "Espértate pasado este tempo, nos últimos minutos xa se te inquietas. Non conta como noite."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "આ સમય પછી જગાડે છે, છેલ્લી મિનિટોમાં બેચેન થાઓ તો પહેલેથી. રાત તરીકે ગણાતું નથી."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מעיר אתכם אחרי הזמן הזה, בדקות האחרונות כבר אם השינה נעשית חסרת מנוחה. לא נחשב כלילה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस समय के बाद जगाता है, आखिरी मिनटों में बेचैन होने पर पहले ही। रात के रूप में नहीं गिना जाता।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Budi te nakon tog vremena, u zadnjim minutama već ako ti san postane nemiran. Ne računa se kao noć."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ennyi idő után ébreszt, az utolsó percekben már akkor, ha nyugtalan leszel. Nem számít éjszakának."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Արթնացնում է այս ժամանակից հետո, վերջին րոպեներին՝ արդեն, եթե անհանգիստ դառնաս։ Չի հաշվվում որպես գիշեր։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Membangunkanmu setelah waktu ini, di menit-menit terakhir sudah jika kamu mulai gelisah. Tidak dihitung sebagai malam."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Vekur þig eftir þennan tíma, síðustu mínúturnar strax ef svefninn verður órólegur. Telst ekki sem nótt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ti sveglia dopo questo tempo, negli ultimi minuti già se il sonno si fa agitato. Non conta come notte."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この時間の後に起こします。最後の数分は、眠りが落ち着かなくなれば先に起こします。夜としては記録されません。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "გაგაღვიძებს ამ დროის შემდეგ, ბოლო წუთებში უკვე, თუ მოუსვენარი გახდები. ღამედ არ ითვლება."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Осы уақыттан кейін оятады, соңғы минуттарда мазасыздана бастасаң, ертерек. Түн ретінде саналмайды."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ដាស់អ្នកក្រោយរយៈពេលនេះ ហើយក្នុងនាទីចុងក្រោយ ដាស់មុនបើអ្នកដេកមិនស្ងប់។ មិនរាប់ជាយប់ទេ។"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಈ ಸಮಯದ ನಂತರ ಎಬ್ಬಿಸುತ್ತದೆ, ಕೊನೆಯ ನಿಮಿಷಗಳಲ್ಲಿ ಚಡಪಡಿಸಿದರೆ ಮೊದಲೇ. ರಾತ್ರಿ ಎಂದು ಎಣಿಸುವುದಿಲ್ಲ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 시간 후에 깨워 줘요. 마지막 몇 분은 뒤척이면 미리 깨워요. 밤으로 기록되지 않아요."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ປຸກເຈົ້າຫຼັງເວລານີ້ ແລະ ໃນນາທີສຸດທ້າຍ ຈະປຸກກ່ອນຖ້າເຈົ້ານອນບໍ່ສະຫງົບ ບໍ່ນັບເປັນຄືນ"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pažadina po šio laiko, paskutinėmis minutėmis – jau tada, kai miegas tampa neramus. Neskaičiuojama kaip naktis."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Pamodina pēc šī laika, pēdējās minūtēs jau tad, ja miegs kļūst nemierīgs. Netiek skaitīts kā nakts."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Те буди по ова време, во последните минути веќе ако сонот ти стане немирен. Не се брои како ноќ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഈ സമയം കഴിഞ്ഞ് ഉണർത്തും, അവസാന മിനിറ്റുകളിൽ അസ്വസ്ഥരായാൽ നേരത്തേ. ഒരു രാത്രിയായി കണക്കാക്കില്ല."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Энэ хугацааны дараа сэрээнэ, сүүлийн минутуудад тайван бус унтаж эхэлбэл эрт. Шөнөд тооцохгүй."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "या वेळेनंतर उठवते, शेवटच्या मिनिटांत अस्वस्थ झाल्यास आधीच. रात्र म्हणून मोजली जात नाही."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Mengejutkan awak selepas masa ini, pada minit-minit terakhir lebih awal jika awak mula gelisah. Tidak dikira sebagai malam."
          }
        },
        "my": {
          "stringUnit": {
            "state": "translated",
            "value": "ဤအချိန်ပြီးလျှင် နှိုးမည်၊ နောက်ဆုံးမိနစ်များတွင် မငြိမ်မသက် ဖြစ်လာလျှင် စောနှိုးမည်။ ညအဖြစ် မရေတွက်ပါ။"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Vekker deg etter denne tiden, de siste minuttene allerede hvis du blir urolig. Teller ikke som en natt."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "यति समयपछि ब्युँझाउँछ, अन्तिम मिनेटहरूमा छटपटिन थाले पहिल्यै। रातको रूपमा गनिँदैन।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wekt je na deze tijd, in de laatste minuten al als je onrustig wordt. Telt niet als nacht."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਇਸ ਸਮੇਂ ਤੋਂ ਬਾਅਦ ਜਗਾਉਂਦਾ ਹੈ, ਆਖਰੀ ਮਿੰਟਾਂ ਵਿੱਚ ਬੇਚੈਨ ਹੋਵੋ ਤਾਂ ਪਹਿਲਾਂ ਹੀ। ਰਾਤ ਵਜੋਂ ਨਹੀਂ ਗਿਣਿਆ ਜਾਂਦਾ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Budzi Cię po tym czasie, w ostatnich minutach już wtedy, gdy sen stanie się niespokojny. Nie liczy się jako noc."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Acorda você após esse tempo, nos últimos minutos já se o sono ficar agitado. Não conta como noite."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Acorda-te após este tempo, nos últimos minutos já se o sono ficar agitado. Não conta como noite."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Te trezește după acest timp, în ultimele minute deja dacă somnul devine agitat. Nu contează ca noapte."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Будит тебя через это время, в последние минуты уже тогда, когда сон станет беспокойным. Не считается ночью."
          }
        },
        "si": {
          "stringUnit": {
            "state": "translated",
            "value": "මෙම කාලයෙන් පසු අවදි කරයි, අවසන් මිනිත්තුවලදී නොසන්සුන් වුවහොත් ඊටත් කලින්. රාත්‍රියක් ලෙස ගණන් නොගැනේ."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zobudí ťa po uplynutí času, v posledných minútach už vtedy, keď sa spánok stane nepokojným. Nepočíta sa ako noc."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zbudi te po tem času, v zadnjih minutah že, če postane spanec nemiren. Ne šteje kot noč."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Të zgjon pas kësaj kohe, në minutat e fundit që kur gjumi bëhet i shqetësuar. Nuk llogaritet si natë."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Буди те после овог времена, у последњим минутима већ ако ти сан постане немиран. Не рачуна се као ноћ."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Väcker dig efter den här tiden, de sista minuterna redan om sömnen blir orolig. Räknas inte som en natt."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Inakuamsha baada ya muda huu, au mapema katika dakika za mwisho ukianza kutotulia. Haihesabiwi kama usiku."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்த நேரத்துக்குப் பிறகு எழுப்பும்; கடைசி நிமிடங்களில் அமைதியின்றி அசைந்தால் முன்னதாகவே. இரவாகக் கணக்கிடப்படாது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఈ సమయం తర్వాత లేపుతుంది, చివరి నిమిషాల్లో అశాంతిగా కదిలితే ముందుగానే. రాత్రిగా లెక్కించబడదు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ปลุกคุณหลังเวลานี้ ในไม่กี่นาทีสุดท้ายจะปลุกก่อนถ้าคุณนอนกระสับกระส่าย ไม่นับเป็นคืน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu sürenin sonunda uyandırır, son dakikalarda huzursuzlanırsan daha önce. Gece sayılmaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Будить тебе після цього часу, в останні хвилини вже тоді, коли сон стане неспокійним. Не вважається ніччю."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس وقت کے بعد جگاتا ہے، آخری چند منٹوں میں بے چین ہو تو پہلے ہی۔ رات میں شمار نہیں ہوتا۔"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Shu vaqtdan keyin uygʻotadi, oxirgi daqiqalarda esa bezovtalansang, ertaroq. Tun sifatida hisoblanmaydi."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đánh thức bạn sau khoảng thời gian này, trong vài phút cuối sớm hơn nếu bạn trằn trọc. Không tính là một đêm."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "在這段時間後叫醒你，最後幾分鐘內一旦睡得不安穩會提早叫醒。不計作一晚。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在这段时间后叫醒你，最后几分钟内一旦睡得不安稳就会提前叫醒。不计为一晚。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在這段時間後叫醒你，最後幾分鐘內一旦睡得不安穩就會提前叫醒。不計為一晚。"
          }
        },
        "zu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ikuvusa ngemva kwalesi sikhathi, emizuzwini yokugcina kakade uma uqala ukungazinzi. Ayibalwa njengobusuku."
          }
        }
      }
    },
