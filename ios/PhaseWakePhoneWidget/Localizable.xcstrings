        },
        "my": {
          "stringUnit": {
            "state": "translated",
            "value": "ခန့်မှန်း ရုံးပိတ်ရက်- %1$@ – နှိုးစက် မြည်ပါမည်။ အားလပ်ရက်ဖြစ်ပါက ကိုယ်တိုင် ကျော်ပါ။"
