            "value": "אשרו שעונים מעוררים ותזכורות כדי שהשעון המעורר הגיבוי יצלצל בזמן."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अलार्म और रिमाइंडर की अनुमति दें ताकि बैकअप अलार्म समय पर बजे।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dopusti „Alarmi i podsjetnici“ kako bi rezervni alarm zvonio na vrijeme."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Engedélyezd az ébresztéseket és emlékeztetőket, hogy a tartalék ébresztés pontosan szóljon."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Թույլատրիր «Զարթուցիչներ և հիշեցումներ», որպեսզի պահուստային զարթուցիչը ժամանակին զանգի։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Izinkan alarm & pengingat agar alarm cadangan berbunyi tepat waktu."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Leyfðu „Vekjarar og áminningar“ svo varavekjarinn hringi á réttum tíma."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Consenti sveglie e promemoria perché la sveglia di riserva suoni puntuale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "予備のアラームが時間どおりに鳴るよう、「アラームとリマインダー」を許可してください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "დაუშვი „მაღვიძარები და შეხსენებები“, რომ სარეზერვო მაღვიძარამ დროზე დარეკოს."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Қосалқы оятқыш уақытында шырылдауы үшін «Оятқыштар мен еске салғыштарға» рұқсат бер."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "អនុញ្ញាត «ម៉ោងរោទ៍ & ការរំលឹក» ដើម្បីឲ្យម៉ោងរោទ៍បម្រុងរោទ៍ទាន់ពេល។"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಬ್ಯಾಕಪ್ ಅಲಾರಾಂ ಸಮಯಕ್ಕೆ ಸರಿಯಾಗಿ ರಿಂಗ್ ಆಗಲು ಅಲಾರಾಂಗಳು & ಜ್ಞಾಪನೆಗಳನ್ನು ಅನುಮತಿಸಿ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보조 알람이 제시간에 울리도록 알람 및 리마인더를 허용해 주세요."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ອະນຸຍາດ “ໂມງປຸກ & ການແຈ້ງເຕືອນ” ເພື່ອໃຫ້ໂມງປຸກສຳຮອງດັງຕົງເວລາ"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Leisk „Žadintuvai ir priminimai“, kad atsarginis žadintuvas suskambėtų laiku."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Atļauj „Signāli un atgādinājumi“, lai rezerves modinātājs zvanītu laikā."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дозволи „Аларми и потсетници“ за резервниот аларм да ѕвони навреме."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ബാക്കപ്പ് അലാറം കൃത്യസമയത്ത് അടിക്കാൻ അലാറങ്ങളും & റിമൈൻഡറുകളും അനുവദിക്കുക."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Нөөц сэрүүлэг цагтаа дуугарахын тулд «Сэрүүлэг ба сануулга»-ыг зөвшөөр."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "बॅकअप अलार्म वेळेवर वाजावा म्हणून “अलार्म आणि रिमाइंडर” ला परवानगी द्या."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Benarkan penggera & peringatan supaya penggera sandaran berbunyi tepat pada masanya."
          }
        },
        "my": {
          "stringUnit": {
            "state": "translated",
            "value": "အရန်နှိုးစက် အချိန်မှန်မြည်စေရန် “နှိုးစက်များ & သတိပေးချက်များ” ကို ခွင့်ပြုပါ။"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Tillat alarmer og påminnelser slik at reservealarmen ringer i tide."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "ब्याकअप अलार्म समयमै बजोस् भन्नका लागि “अलार्म र रिमाइन्डर” लाई अनुमति देऊ।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sta wekkers en herinneringen toe zodat de reservewekker op tijd afgaat."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "“ਅਲਾਰਮ ਅਤੇ ਰਿਮਾਈਂਡਰ” ਦੀ ਇਜਾਜ਼ਤ ਦਿਓ ਤਾਂ ਜੋ ਬੈਕਅੱਪ ਅਲਾਰਮ ਸਮੇਂ ਸਿਰ ਵੱਜੇ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zezwól na alarmy i przypomnienia, aby zapasowy budzik zadzwonił na czas."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Permita alarmes e lembretes para que o alarme reserva toque na hora certa."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite alarmes e lembretes para que o alarme de reserva toque à hora certa."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite alarmele și mementourile pentru ca alarma de rezervă să sune la timp."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разреши будильники и напоминания, чтобы резервный будильник звонил вовремя."
          }
        },
        "si": {
          "stringUnit": {
            "state": "translated",
            "value": "උපස්ථ එලාමය නියමිත වේලාවට නාද වීමට “එලාම සහ සිහිකැඳවීම්” වලට ඉඩ දෙන්න."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Povoľ „Budíky a pripomenutia“, aby záložný budík zazvonil načas."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dovoli »Budilke in opomniki«, da rezervna budilka zazvoni pravočasno."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Lejo „Alarmet dhe rikujtuesit“, që alarmi rezervë të bjerë në kohë."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Дозволи „Аларми и подсетници“ да би резервни аларм звонио на време."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tillåt alarm och påminnelser så att reservalarmet ringer i tid."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Ruhusu “Kengele na vikumbusho” ili kengele ya akiba ilie kwa wakati."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "மாற்று அலாரம் சரியான நேரத்தில் ஒலிக்க “அலாரங்களும் நினைவூட்டல்களும்” என்பதை அனுமதியுங்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "బ్యాకప్ అలారం సమయానికి మోగేలా “అలారాలు & రిమైండర్‌లు”ను అనుమతించండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อนุญาตการปลุกและการช่วยเตือนเพื่อให้นาฬิกาปลุกสำรองดังตรงเวลา"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yedek alarmın zamanında çalması için alarmlara ve hatırlatıcılara izin ver."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дозволь будильники й нагадування, щоб резервний будильник дзвонив вчасно."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
