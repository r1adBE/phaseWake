    "diag_hint": {
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Tegniese logboek van die afgelope 7 dae, net op jou toestelle. Dit bevat tye en meetwaardes (bv. beweging, wanneer jy aan die slaap geraak het) – deel dit net as jy wil."
          }
        },
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "ያለፉት 7 ቀናት ቴክኒካዊ መዝገብ፣ በመሣሪያዎችህ ላይ ብቻ። ሰዓቶችንና መለኪያዎችን ይዟል (ለምሳሌ እንቅስቃሴ፣ የእንቅልፍ ጊዜ) – ከፈለግህ ብቻ አጋራው።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سجل تقني لآخر ٧ أيام، على أجهزتك فقط. يحتوي على أوقات وقيم قياس (مثل الحركة ووقت النوم) – شاركه فقط إذا أردت."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Son 7 günün texniki jurnalı, yalnız sənin cihazlarında. Vaxtları və ölçü dəyərlərini ehtiva edir (məs. hərəkət, yuxuya getmə vaxtı) – yalnız istəsən paylaş."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Технически дневник за последните 7 дни, само на твоите устройства. Съдържа часове и измерени стойности (напр. движение, време на заспиване) – споделяй го само ако искаш."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "গত ৭ দিনের প্রযুক্তিগত লগ, শুধু তোমার ডিভাইসে। এতে সময় ও পরিমাপের মান আছে (যেমন নড়াচড়া, ঘুমিয়ে পড়ার সময়) – চাইলে তবেই শেয়ার করো।"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tehnički dnevnik zadnjih 7 dana, samo na tvojim uređajima. Sadrži vremena i izmjerene vrijednosti (npr. pokret, vrijeme uspavljivanja) – dijeli ga samo ako želiš."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Registre tècnic dels últims 7 dies, només als teus dispositius. Conté hores i valors mesurats (p. ex. moviment, hora d’adormir-te) – comparteix-lo només si vols."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Technický záznam za posledních 7 dní, jen ve tvých zařízeních. Obsahuje časy a naměřené hodnoty (např. pohyb, čas usnutí) – sdílej ho, jen když chceš."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Teknisk log for de seneste 7 dage, kun på dine enheder. Den indeholder tidspunkter og måleværdier (f.eks. bevægelse, indsovningstid) – del den kun, hvis du vil."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Technisches Protokoll der letzten 7 Tage, nur auf deinen Geräten. Es enthält Zeiten und Messwerte (z. B. Bewegung, Einschlafzeit) – teile es nur, wenn du willst."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τεχνικό αρχείο καταγραφής των τελευταίων 7 ημερών, μόνο στις συσκευές σου. Περιέχει ώρες και μετρήσεις (π.χ. κίνηση, ώρα που αποκοιμήθηκες) – μοιράσου το μόνο αν θέλεις."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Technical log of the last 7 days, only on your devices. It contains times and measurements (e.g. motion, when you fell asleep) – share it only if you want to."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Registro técnico de los últimos 7 días, solo en tus dispositivos. Contiene horas y valores medidos (p. ej., movimiento, hora en que te dormiste): compártelo solo si quieres."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Viimase 7 päeva tehniline logi, ainult sinu seadmetes. See sisaldab aegu ja mõõteväärtusi (nt liikumine, uinumise aeg) – jaga seda ainult siis, kui tahad."
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "Azken 7 egunetako erregistro teknikoa, zure gailuetan soilik. Orduak eta neurketak ditu (adib. mugimendua, lokartzeko ordua); partekatu nahi baduzu bakarrik."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "گزارش فنی ۷ روز گذشته، فقط روی دستگاه‌های تو. شامل زمان‌ها و مقادیر اندازه‌گیری‌شده است (مثلاً حرکت، زمان به خواب رفتن) – فقط اگر خواستی آن را به اشتراک بگذار."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Viimeisten 7 päivän tekninen loki, vain laitteillasi. Se sisältää aikoja ja mittausarvoja (esim. liike, nukahtamisaika) – jaa se vain, jos haluat."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Teknikal na log ng huling 7 araw, sa mga device mo lang. May mga oras at sukat ito (hal. galaw, oras ng pagtulog) – ibahagi lang kung gusto mo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Journal technique des 7 derniers jours, uniquement sur tes appareils. Il contient des heures et des valeurs mesurées (p. ex. mouvement, heure d’endormissement) – ne le partage que si tu le veux."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Loga teicniúil na 7 lá deiridh, ar do ghléasanna amháin. Tá amanna agus luachanna tomhaiste ann (m.sh. gluaiseacht, am titim i do chodladh) – ná roinn é ach más mian leat."
          }
        },
        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rexistro técnico dos últimos 7 días, só nos teus dispositivos. Contén horas e valores medidos (p. ex. movemento, hora de adormecer) – compárteo só se queres."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "છેલ્લા 7 દિવસનો ટેકનિકલ લૉગ, ફક્ત તમારા ડિવાઇસ પર. તેમાં સમય અને માપેલા મૂલ્યો છે (દા.ત. હલનચલન, ઊંઘ આવવાનો સમય) – તમે ઇચ્છો તો જ શેર કરો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יומן טכני של 7 הימים האחרונים, רק במכשירים שלך. הוא מכיל זמנים וערכי מדידה (למשל תנועה, שעת הירדמות) – שתף אותו רק אם תרצה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पिछले 7 दिनों का तकनीकी लॉग, सिर्फ़ तुम्हारे डिवाइस पर। इसमें समय और मापे गए मान हैं (जैसे हलचल, नींद आने का समय) – चाहो तभी शेयर करो।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tehnički zapisnik zadnjih 7 dana, samo na tvojim uređajima. Sadrži vremena i izmjerene vrijednosti (npr. pokret, vrijeme uspavljivanja) – dijeli ga samo ako želiš."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az elmúlt 7 nap technikai naplója, csak a készülékeiden. Időpontokat és mért értékeket tartalmaz (pl. mozgás, elalvás ideje) – csak akkor oszd meg, ha szeretnéd."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Վերջին 7 օրվա տեխնիկական մատյան՝ միայն քո սարքերում։ Պարունակում է ժամեր և չափված արժեքներ (օր.՝ շարժում, քնելու ժամ)․ կիսվիր միայն, եթե ուզում ես։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Log teknis 7 hari terakhir, hanya di perangkatmu. Berisi waktu dan nilai ukur (mis. gerakan, waktu tertidur) – bagikan hanya jika kamu mau."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Tæknileg skráning síðustu 7 daga, aðeins á tækjunum þínum. Hún inniheldur tíma og mæligildi (t.d. hreyfingu, hvenær þú sofnaðir) – deildu henni aðeins ef þú vilt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Registro tecnico degli ultimi 7 giorni, solo sui tuoi dispositivi. Contiene orari e valori misurati (ad es. movimento, ora in cui ti sei addormentato) – condividilo solo se vuoi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "過去 7 日間の技術ログで、あなたのデバイスにのみ保存されます。時刻や測定値（例：動き、入眠時刻）が含まれます。共有するのは必要なときだけにしてください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ბოლო 7 დღის ტექნიკური ჟურნალი, მხოლოდ შენს მოწყობილობებზე. შეიცავს დროებს და გაზომილ მნიშვნელობებს (მაგ. მოძრაობა, ჩაძინების დრო) – გააზიარე მხოლოდ თუ გინდა."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Соңғы 7 күннің техникалық журналы, тек сенің құрылғыларыңда. Онда уақыттар мен өлшем мәндері бар (мыс. қозғалыс, ұйықтап кеткен уақыт) – қаласаң ғана бөліс."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "កំណត់ហេតុបច្ចេកទេសនៃ 7 ថ្ងៃចុងក្រោយ មានតែនៅលើឧបករណ៍របស់អ្នកប៉ុណ្ណោះ។ វាមានពេលវេលា និងតម្លៃវាស់ (ឧ. ចលនា ពេលងងុយគេង) – ចែករំលែកវាតែពេលអ្នកចង់ប៉ុណ្ណោះ។"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಕಳೆದ 7 ದಿನಗಳ ತಾಂತ್ರಿಕ ಲಾಗ್, ನಿಮ್ಮ ಸಾಧನಗಳಲ್ಲಿ ಮಾತ್ರ. ಇದರಲ್ಲಿ ಸಮಯಗಳು ಮತ್ತು ಅಳತೆ ಮೌಲ್ಯಗಳಿವೆ (ಉದಾ. ಚಲನೆ, ನಿದ್ರೆ ಬಂದ ಸಮಯ) – ನೀವು ಬಯಸಿದರೆ ಮಾತ್ರ ಹಂಚಿಕೊಳ್ಳಿ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "최근 7일간의 기술 로그로, 내 기기에만 저장됩니다. 시간과 측정값(예: 움직임, 잠든 시각)이 들어 있으니 원할 때만 공유하세요."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ບັນທຶກທາງເທັກນິກຂອງ 7 ມື້ຫຼ້າສຸດ, ຢູ່ໃນອຸປະກອນຂອງເຈົ້າເທົ່ານັ້ນ. ມີເວລາ ແລະ ຄ່າທີ່ວັດໄດ້ (ເຊັ່ນ ການເຄື່ອນໄຫວ, ເວລານອນຫຼັບ) – ແບ່ງປັນສະເພາະເມື່ອເຈົ້າຕ້ອງການ."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Paskutinių 7 dienų techninis žurnalas, tik tavo įrenginiuose. Jame yra laikai ir išmatuotos vertės (pvz., judesys, užmigimo laikas) – bendrink jį tik jei nori."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Pēdējo 7 dienu tehniskais žurnāls, tikai tavās ierīcēs. Tajā ir laiki un izmērītās vērtības (piem., kustība, iemigšanas laiks) – kopīgo to tikai tad, ja vēlies."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Технички дневник за последните 7 дена, само на твоите уреди. Содржи времиња и измерени вредности (на пр. движење, време на заспивање) – сподели го само ако сакаш."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "കഴിഞ്ഞ 7 ദിവസത്തെ സാങ്കേതിക ലോഗ്, നിങ്ങളുടെ ഉപകരണങ്ങളിൽ മാത്രം. ഇതിൽ സമയങ്ങളും അളന്ന മൂല്യങ്ങളും ഉണ്ട് (ഉദാ. ചലനം, ഉറങ്ങിയ സമയം) – വേണമെങ്കിൽ മാത്രം പങ്കിടുക."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Сүүлийн 7 хоногийн техникийн бүртгэл, зөвхөн чиний төхөөрөмжүүд дээр. Цаг болон хэмжсэн утгууд агуулна (жишээ нь хөдөлгөөн, унтсан цаг) – хүсвэл л хуваалц."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "मागील 7 दिवसांचा तांत्रिक लॉग, फक्त तुमच्या डिव्हाइसवर. यात वेळा आणि मोजलेली मूल्ये आहेत (उदा. हालचाल, झोप लागण्याची वेळ) – तुम्हाला हवे असेल तरच शेअर करा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Log teknikal 7 hari terakhir, hanya pada peranti anda. Ia mengandungi masa dan nilai ukuran (cth. pergerakan, masa tertidur) – kongsi hanya jika anda mahu."
          }
        },
        "my": {
          "stringUnit": {
            "state": "translated",
            "value": "နောက်ဆုံး ၇ ရက်၏ နည်းပညာမှတ်တမ်း၊ သင့်စက်များပေါ်တွင်သာ။ အချိန်များနှင့် တိုင်းတာထားသောတန်ဖိုးများ (ဥပမာ လှုပ်ရှားမှု၊ အိပ်ပျော်ချိန်) ပါဝင်သည် – လိုချင်မှသာ မျှဝေပါ။"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Teknisk logg for de siste 7 dagene, bare på enhetene dine. Den inneholder tidspunkter og måleverdier (f.eks. bevegelse, innsovningstid) – del den bare hvis du vil."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "पछिल्ला ७ दिनको प्राविधिक लग, तिम्रा उपकरणमा मात्र। यसमा समय र मापन गरिएका मानहरू छन् (जस्तै चाल, निदाएको समय) – चाहेमा मात्र साझा गर।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Technisch logboek van de afgelopen 7 dagen, alleen op je apparaten. Het bevat tijden en meetwaarden (bijv. beweging, inslaaptijd) – deel het alleen als je dat wilt."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਪਿਛਲੇ 7 ਦਿਨਾਂ ਦਾ ਤਕਨੀਕੀ ਲੌਗ, ਸਿਰਫ਼ ਤੁਹਾਡੇ ਡੀਵਾਈਸਾਂ ’ਤੇ। ਇਸ ਵਿੱਚ ਸਮੇਂ ਅਤੇ ਮਾਪੇ ਮੁੱਲ ਹਨ (ਜਿਵੇਂ ਹਿਲਜੁਲ, ਨੀਂਦ ਆਉਣ ਦਾ ਸਮਾਂ) – ਚਾਹੋ ਤਾਂ ਹੀ ਸਾਂਝਾ ਕਰੋ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dziennik techniczny z ostatnich 7 dni, tylko na twoich urządzeniach. Zawiera godziny i zmierzone wartości (np. ruch, porę zaśnięcia) – udostępniaj go tylko, jeśli chcesz."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Registro técnico dos últimos 7 dias, só nos seus dispositivos. Contém horários e valores medidos (ex.: movimento, hora em que você adormeceu) – compartilhe só se quiser."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Registo técnico dos últimos 7 dias, só nos teus dispositivos. Contém horas e valores medidos (p. ex. movimento, hora a que adormeceste) – partilha-o só se quiseres."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Jurnal tehnic al ultimelor 7 zile, doar pe dispozitivele tale. Conține ore și valori măsurate (de ex. mișcare, ora adormirii) – partajează-l doar dacă vrei."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Технический журнал за последние 7 дней, только на твоих устройствах. Он содержит время и измеренные значения (например, движение, время засыпания) – делись им, только если хочешь."
          }
        },
        "si": {
          "stringUnit": {
            "state": "translated",
            "value": "පසුගිය දින 7 හි තාක්ෂණික ලොගය, ඔබේ උපාංගවල පමණි. එහි වේලාවන් සහ මනින ලද අගයන් ඇත (උදා. චලනය, නින්දට ගිය වේලාව) – ඔබට අවශ්‍ය නම් පමණක් බෙදාගන්න."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Technický záznam za posledných 7 dní, len v tvojich zariadeniach. Obsahuje časy a namerané hodnoty (napr. pohyb, čas zaspania) – zdieľaj ho, len ak chceš."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tehnični dnevnik zadnjih 7 dni, samo v tvojih napravah. Vsebuje čase in izmerjene vrednosti (npr. gibanje, čas uspavanja) – deli ga le, če želiš."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Regjistër teknik i 7 ditëve të fundit, vetëm në pajisjet e tua. Përmban orare dhe vlera të matura (p.sh. lëvizje, ora e rënies në gjumë) – ndaje vetëm nëse do."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Технички дневник последњих 7 дана, само на твојим уређајима. Садржи времена и измерене вредности (нпр. покрет, време успављивања) – дели га само ако желиш."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Teknisk logg för de senaste 7 dagarna, bara på dina enheter. Den innehåller tider och mätvärden (t.ex. rörelse, insomningstid) – dela den bara om du vill."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Kumbukumbu ya kiufundi ya siku 7 zilizopita, kwenye vifaa vyako tu. Ina nyakati na thamani zilizopimwa (k.m. mwendo, muda wa kulala) – ishiriki tu ukitaka."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "கடந்த 7 நாட்களின் தொழில்நுட்பப் பதிவு, உங்கள் சாதனங்களில் மட்டும். இதில் நேரங்களும் அளவிடப்பட்ட மதிப்புகளும் உள்ளன (எ.கா. அசைவு, தூங்கிய நேரம்) – விரும்பினால் மட்டும் பகிருங்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "గత 7 రోజుల సాంకేతిక లాగ్, మీ పరికరాల్లో మాత్రమే. ఇందులో సమయాలు, కొలిచిన విలువలు ఉన్నాయి (ఉదా. కదలిక, నిద్రపోయిన సమయం) – మీకు కావాలంటేనే షేర్ చేయండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บันทึกทางเทคนิคของ 7 วันล่าสุด อยู่บนอุปกรณ์ของคุณเท่านั้น มีเวลาและค่าที่วัดได้ (เช่น การเคลื่อนไหว เวลาที่หลับ) – แชร์เฉพาะเมื่อคุณต้องการ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Son 7 günün teknik kaydı, yalnızca cihazlarında. Saatler ve ölçüm değerleri içerir (ör. hareket, uykuya dalma saati) – yalnızca istersen paylaş."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Технічний журнал за останні 7 днів, лише на твоїх пристроях. Він містить час і виміряні значення (наприклад, рух, час засинання) – ділися ним, лише якщо хочеш."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "پچھلے 7 دنوں کا تکنیکی لاگ، صرف آپ کے آلات پر۔ اس میں اوقات اور ناپی گئی قدریں ہیں (مثلاً حرکت، سونے کا وقت) – صرف چاہیں تو شیئر کریں۔"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Oxirgi 7 kunlik texnik jurnal, faqat qurilmalaringda. Unda vaqtlar va o‘lchangan qiymatlar bor (masalan, harakat, uxlab qolish vaqti) – faqat xohlasang ulash."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhật ký kỹ thuật của 7 ngày gần nhất, chỉ trên thiết bị của bạn. Nhật ký có thời gian và giá trị đo (vd. chuyển động, giờ ngủ thiếp đi) – chỉ chia sẻ khi bạn muốn."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "最近 7 日嘅技術記錄，只存喺你部裝置度。入面有時間同量度數值（例如動作、入睡時間）——你想先好分享。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "最近 7 天的技术日志，仅保存在你的设备上。其中包含时间和测量值（例如动作、入睡时间）——只在你愿意时分享。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "最近 7 天的技術記錄，只存在你的裝置上。其中包含時間和測量值（例如動作、入睡時間）——只在你願意時分享。"
          }
        },
        "zu": {
          "stringUnit": {
            "state": "translated",
            "value": "Irekhodi lobuchwepheshe lezinsuku eziyi-7 ezedlule, kumadivayisi akho kuphela. Liqukethe izikhathi namanani alinganisiwe (isb. ukunyakaza, isikhathi sokulala) – yabelana ngalo kuphela uma ufuna."
          }
        }
      }
    },
