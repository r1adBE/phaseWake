          "stringUnit": {
            "state": "translated",
            "value": "Deine Daten bleiben auf deinen Geräten."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τα δεδομένα σου μένουν στις συσκευές σου."
