    "check_watch_update_problem": {
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Tot dan sal jou horlosie nie wekkers oorslaan nie en jou ook op vakansiedae wakker maak."
          }
        },
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "እስከዚያ ድረስ ሰዓትዎ ማንቂያዎችን አይዘልም፣ በበዓላትም ይቀሰቅስዎታል።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حتى ذلك الحين لن تتخطى الساعة أي منبّه وستوقظك أيضًا في العطل."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "O vaxta qədər saatın siqnalları ötürməyəcək və bayramlarda da səni oyadacaq."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Дотогава часовникът няма да пропуска будилници и ще те буди и в празници."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ততদিন তোমার ঘড়ি অ্যালার্ম এড়াবে না আর ছুটির দিনেও জাগাবে।"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Do tada sat neće preskakati alarme i budit će te i na praznike."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Fins aleshores, el rellotge no ometrà alarmes i també et despertarà els festius."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Do té doby hodinky nic nepřeskočí a budí tě i o svátcích."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Indtil da springer uret ingen alarmer over og vækker dig også på helligdage."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bis dahin überspringt die Uhr keine Termine und weckt auch an Feiertagen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μέχρι τότε το ρολόι δεν παραλείπει καμία αφύπνιση και σε ξυπνά και τις αργίες."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Until then, your watch won’t skip alarms and will also wake you on holidays."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hasta entonces, el reloj no saltará ninguna alarma y también te despertará en festivos."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Seni ei jäta kell äratusi vahele ja äratab sind ka pühadel."
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitartean, erlojuak ez ditu alarmak saltatuko eta jaiegunetan ere esnatuko zaitu."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "تا آن موقع ساعت هیچ زنگی را رد نمی‌کند و روزهای تعطیل هم بیدارت می‌کند."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Siihen asti kello ei ohita herätyksiä ja herättää myös juhlapäivinä."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanggang doon, hindi lalaktawan ng relo mo ang mga alarm at gigisingin ka rin nito tuwing holiday."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "D'ici là, ta montre ne saute aucun réveil et te réveille aussi les jours fériés."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Go dtí sin, ní scipeálfaidh d’uaireadóir aláraim agus dúiseoidh sé thú ar laethanta saoire freisin."
          }
        },
        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ata entón, o reloxo non omitirá alarmas e tamén te espertará nos festivos."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ત્યાં સુધી તમારી ઘડિયાળ એલાર્મ છોડશે નહીં અને રજાના દિવસે પણ તમને જગાડશે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "עד אז השעון לא ידלג על אף השכמה ויעיר אתכם גם בחגים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "तब तक वॉच कोई अलार्म नहीं छोड़ेगी और छुट्टियों पर भी आपको जगाएगी।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Do tada sat neće preskakati alarme i budit će te i na praznike."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Addig az óra nem hagy ki ébresztést, és ünnepnapokon is felébreszt."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Մինչ այդ ժամացույցդ զարթուցիչներ բաց չի թողնի և քեզ կարթնացնի նաև տոներին։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sampai saat itu, jam tanganmu tidak akan melewati alarm dan tetap membangunkanmu saat hari libur."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Þangað til sleppir úrið ekki vekjurum og vekur þig líka á frídögum."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fino ad allora l'orologio non salta nessuna sveglia e ti sveglia anche nei festivi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "それまでウォッチはアラームをスキップせず、祝日にも起こします。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "მანამდე საათი მაღვიძარებს არ გამოტოვებს და დღესასწაულებზეც გაგაღვიძებს."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Оған дейін сағатың оятқыштарды өткізіп жібермейді және мерекелерде де оятады."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "រហូតដល់ពេលនោះ នាឡិកានឹងមិនរំលងម៉ោងរោទ៍ ហើយក៏នឹងដាស់អ្នកនៅថ្ងៃឈប់សម្រាកដែរ។"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಅಲ್ಲಿಯವರೆಗೆ ನಿಮ್ಮ ವಾಚ್ ಅಲಾರಾಂಗಳನ್ನು ಬಿಡುವುದಿಲ್ಲ ಮತ್ತು ರಜಾದಿನಗಳಲ್ಲೂ ಎಬ್ಬಿಸುತ್ತದೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그때까지 워치는 알람을 건너뛰지 않고 공휴일에도 깨워요."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ຈົນກວ່າຈະອັບເດດ ໂມງຈະບໍ່ຂ້າມໂມງປຸກ ແລະ ຈະປຸກເຈົ້າໃນວັນພັກນຳ"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Iki tol laikrodis nepraleis žadintuvų ir žadins tave net per šventes."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Līdz tam pulkstenis neizlaidīs modinātājus un modinās tevi arī svētku dienās."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дотогаш часовникот нема да прескокнува аларми и ќе те буди и на празници."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "അതുവരെ വാച്ച് അലാറങ്ങൾ ഒഴിവാക്കില്ല, അവധിദിനങ്ങളിലും ഉണർത്തും."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Тэр болтол цаг чинь сэрүүлгийг алгасахгүй бөгөөд баярын өдөр ч сэрээнэ."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तोपर्यंत तुमचे घड्याळ अलार्म वगळणार नाही आणि सुट्टीच्या दिवशीही तुम्हाला उठवेल."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sehingga itu, jam tangan tidak akan melangkau penggera dan tetap mengejutkan awak pada cuti umum."
          }
        },
        "my": {
          "stringUnit": {
            "state": "translated",
            "value": "ထိုအချိန်အထိ နာရီက နှိုးစက်များကို မကျော်ဘဲ ရုံးပိတ်ရက်များတွင်လည်း နှိုးမည်။"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Frem til da hopper ikke klokken over noen alarmer og vekker deg også på helligdager."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "त्यतिन्जेल तिम्रो घडीले अलार्म छोड्दैन र बिदामा पनि ब्युँझाउँछ।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tot die tijd slaat het horloge geen wekker over en wekt het je ook op feestdagen."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਉਦੋਂ ਤੱਕ ਤੁਹਾਡੀ ਘੜੀ ਅਲਾਰਮ ਨਹੀਂ ਛੱਡੇਗੀ ਅਤੇ ਛੁੱਟੀਆਂ ’ਤੇ ਵੀ ਤੁਹਾਨੂੰ ਜਗਾਏਗੀ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Do tego czasu zegarek nie pominie żadnego budzika i obudzi cię także w święta."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Até lá, o relógio não vai pular alarmes e também vai te acordar em feriados."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Até lá, o relógio não salta nenhum alarme e também te acorda nos feriados."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Până atunci, ceasul nu sare peste nicio alarmă și te trezește și în sărbători."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "До этого часы не пропускают будильники и будят тебя и в праздники."
          }
        },
        "si": {
          "stringUnit": {
            "state": "translated",
            "value": "එතෙක් ඔබේ ඔරලෝසුව එලාම මඟ නොහරින අතර නිවාඩු දිනවලදීත් අවදි කරයි."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Dovtedy hodinky nebudú budíky preskakovať a zobudia ťa aj počas sviatkov."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Do takrat ura ne bo preskakovala budilk in te bo budila tudi ob praznikih."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Deri atëherë, ora nuk i kapërcen alarmet dhe të zgjon edhe në festa."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Дотле сат неће прескакати аларме и будиће те и празницима."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tills dess hoppar klockan inte över några alarm och väcker dig även på helgdagar."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Hadi wakati huo, saa yako haitaruka kengele na itakuamsha pia siku za sikukuu."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "அதுவரை உங்கள் வாட்ச் அலாரங்களைத் தவிர்க்காது, விடுமுறை நாட்களிலும் எழுப்பும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "అప్పటి వరకు మీ వాచ్ అలారాలను దాటవేయదు, సెలవు రోజుల్లోనూ మిమ్మల్ని లేపుతుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "จนกว่าจะอัปเดต นาฬิกาจะไม่ข้ามการปลุกใดและจะปลุกคุณในวันหยุดด้วย"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "O zamana kadar saat hiçbir alarmı atlamaz ve tatillerde de seni uyandırır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "До того часу годинник не пропускає будильники й будить тебе навіть у свята."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "تب تک تمہاری گھڑی الارم نہیں چھوڑے گی اور تعطیلات پر بھی جگائے گی۔"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Shungacha soating budilniklarni oʻtkazib yubormaydi va bayramlarda ham uygʻotadi."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cho đến lúc đó, đồng hồ sẽ không bỏ qua báo thức nào và vẫn đánh thức bạn vào ngày lễ."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "在此之前，手錶不會略過鬧鐘，假期也會叫醒你。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在此之前，手表不会跳过任何闹钟，节假日也会叫醒你。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在此之前，手錶不會略過任何鬧鐘，假日也會叫醒你。"
          }
        },
        "zu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuze kube yilapho, iwashi lakho ngeke leqe ama-alamu futhi lizokuvusa nangamaholide."
          }
        }
      }
    },
