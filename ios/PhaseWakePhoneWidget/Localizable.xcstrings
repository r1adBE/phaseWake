        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your health data has no sleep stages for this night."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus datos de salud no tienen fases de sueño para esta noche."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Sinu terviseandmetes pole selle öö unefaase."
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "Zure osasun-datuek ez dute gau honetako lo-faserik."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "داده‌های سلامت تو برای این شب مراحل خواب ندارد."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Terveystiedoissasi ei ole tämän yön univaiheita."
