            "value": "حلّ ٣ عمليات قبل أن يصمت المنبه. الغفوة تعمل بدون عملية."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Siqnal susmazdan əvvəl 3 misal həll et. Təxirə salmaq tapşırıqsız işləyir."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Реши 3 сметки, преди будилникът да спре. Отлагането става и без задача."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অ্যালার্ম থামার আগে ৩টি যোগ অঙ্ক করো। স্নুজ কাজ ছাড়াই চলে।"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Riješi 3 sabiranja prije nego što alarm utihne. Odgoda radi i bez zadatka."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Resol 3 sumes perquè l’alarma calli. Posposar funciona sense tasca."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyřeš 3 příklady, než budík utichne. Odložení funguje bez příkladu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Løs 3 opgaver, før alarmen tier. Udsæt virker uden opgave."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "3 Aufgaben lösen, bevor der Wecker verstummt. Schlummern geht ohne Aufgabe."
