        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy cho phép báo thức và lời nhắc để báo thức dự phòng reo đúng giờ."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "請允許「鬧鐘和提醒」，讓備用鬧鐘準時響鬧。"
