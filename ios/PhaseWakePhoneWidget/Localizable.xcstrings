            "value": "ಸೆಟ್ಟಿಂಗ್‌ಗಳಲ್ಲಿ ದೇಶ ಮತ್ತು ಪ್ರದೇಶ ಆಯ್ಕೆಮಾಡಿ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "국가와 지역은 설정에서 선택해요."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ເລືອກປະເທດ ແລະ ພາກພື້ນໃນການຕັ້ງຄ່າ"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Šalį ir regioną pasirink nustatymuose."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Valsti un reģionu izvēlies iestatījumos."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Избери земја и регион во поставките."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ക്രമീകരണത്തിൽ രാജ്യവും പ്രദേശവും തിരഞ്ഞെടുക്കുക."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Улс, бүс нутгаа тохиргооноос сонго."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "सेटिंग्जमध्ये देश आणि प्रदेश निवडा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih negara dan wilayah dalam tetapan."
          }
        },
        "my": {
          "stringUnit": {
            "state": "translated",
            "value": "ဆက်တင်များတွင် နိုင်ငံနှင့် ဒေသ ရွေးပါ။"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Velg land og region i innstillingene."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "सेटिङमा देश र क्षेत्र छान।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies land en regio in de instellingen."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਸੈਟਿੰਗਾਂ ਵਿੱਚ ਦੇਸ਼ ਅਤੇ ਖੇਤਰ ਚੁਣੋ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kraj i region wybierzesz w ustawieniach."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha país e região nas configurações."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolhe o país e a região nas definições."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Alege țara și regiunea în setări."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Страну и регион выбери в настройках."
          }
        },
        "si": {
          "stringUnit": {
            "state": "translated",
            "value": "සැකසීම්වල රට සහ කලාපය තෝරන්න."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Krajinu a región vyberieš v nastaveniach."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Državo in regijo izbereš v nastavitvah."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Zgjidh shtetin dhe rajonin te cilësimet."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Државу и регион изабери у подешавањима."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Välj land och region i inställningarna."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Chagua nchi na eneo kwenye mipangilio."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "அமைப்புகளில் நாட்டையும் பகுதியையும் தேர்ந்தெடுங்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "సెట్టింగ్‌లలో దేశం, ప్రాంతం ఎంచుకోండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เลือกประเทศและภูมิภาคในการตั้งค่า"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ülke ve bölgeyi ayarlardan seç."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Країну й регіон вибери в налаштуваннях."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ملک اور علاقہ ترتیبات میں چنو۔"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Mamlakat va hududni sozlamalarda tanla."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn quốc gia và vùng trong cài đặt."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "請在設定中選擇國家和地區。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在设置中选择国家和地区。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在設定中選擇國家和地區。"
          }
        },
        "zu": {
