    "nightstand_hint": {
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Vir die sonsopkoms, laat Phase Wake oornag oop op die laaier. Die skerm bly donker totdat die lig begin."
          }
        },
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "ለፀሐይ መውጫው Phase Wakeን ሌሊቱን ሙሉ ኃይል መሙያ ላይ ክፍት አድርገው ይተዉት። ብርሃኑ እስኪጀምር ድረስ ማያ ገጹ ጨለማ ይቆያል።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لشروق الشمس، اترك Phase Wake مفتوحًا على الشاحن طوال الليل. تبقى الشاشة معتمة حتى يبدأ الضوء."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Gündoğumu üçün Phase Wake-i gecə boyu şarjda açıq qoy. İşıq başlayana qədər ekran qaranlıq qalır."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "За изгрева остави Phase Wake отворено на зарядното през нощта. Екранът остава тъмен, докато започне светлината."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সূর্যোদয়ের জন্য সারা রাত চার্জারে Phase Wake খোলা রাখো। আলো শুরু না হওয়া পর্যন্ত স্ক্রিন অন্ধকার থাকে।"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Za izlazak sunca ostavi Phase Wake otvoren na punjaču preko noći. Ekran ostaje taman dok svjetlo ne počne."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Per a la sortida del sol, deixa Phase Wake obert al carregador tota la nit. La pantalla es queda fosca fins que comença la llum."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro východ slunce nech Phase Wake přes noc otevřenou na nabíječce. Displej zůstane tmavý, dokud nezačne světlo."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Til solopgangen skal du lade Phase Wake være åben på opladeren natten over. Skærmen forbliver mørk, indtil lyset begynder."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für den Sonnenaufgang Phase Wake über Nacht am Ladekabel offen lassen. Der Bildschirm bleibt dunkel, bis das Licht beginnt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Για την ανατολή, άφησε το Phase Wake ανοιχτό στον φορτιστή όλη νύχτα. Η οθόνη μένει σκοτεινή μέχρι να αρχίσει το φως."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For the sunrise, leave Phase Wake open on the charger overnight. The screen stays dark until the light begins."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para el amanecer, deja Phase Wake abierta toda la noche en el cargador. La pantalla permanece oscura hasta que empieza la luz."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Päikesetõusu jaoks jäta Phase Wake ööseks laadijal avatuks. Ekraan jääb pimedaks, kuni valgus algab."
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "Egunsentirako, utzi Phase Wake irekita kargagailuan gau osoan. Pantaila ilun geratzen da argia hasi arte."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "برای طلوع، Phase Wake را تمام شب روی شارژر باز بگذار. صفحه تا شروع نور تاریک می‌ماند."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Auringonnousua varten jätä Phase Wake auki laturissa yön yli. Näyttö pysyy pimeänä, kunnes valo alkaa."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Para sa pagsikat ng araw, iwanang bukas ang Phase Wake sa charger magdamag. Mananatiling madilim ang screen hanggang magsimula ang liwanag."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour le lever de soleil, laisse Phase Wake ouverte toute la nuit sur le chargeur. L’écran reste noir jusqu’au début de la lumière."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Don éirí gréine, fág Phase Wake oscailte ar an luchtaire thar oíche. Fanann an scáileán dorcha go dtí go dtosaíonn an solas."
          }
        },
        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "Para o amencer, deixa Phase Wake aberto no cargador durante a noite. A pantalla queda escura ata que comeza a luz."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "સૂર્યોદય માટે Phase Wakeને આખી રાત ચાર્જર પર ખુલ્લું રાખો. પ્રકાશ શરૂ થાય ત્યાં સુધી સ્ક્રીન અંધારી રહે છે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לזריחה, השאירו את Phase Wake פתוחה על המטען לאורך הלילה. המסך נשאר חשוך עד שהאור מתחיל."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सूर्योदय के लिए Phase Wake को रात भर चार्जर पर खुला छोड़ें। रोशनी शुरू होने तक स्क्रीन अँधेरी रहती है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Za izlazak sunca ostavi Phase Wake otvoren na punjaču preko noći. Zaslon ostaje taman dok svjetlo ne počne."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A napfelkeltéhez hagyd nyitva a Phase Wake-et a töltőn egész éjjel. A kijelző sötét marad, amíg a fény el nem kezdődik."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Արևածագի համար գիշերը Phase Wake-ը բաց թող լիցքավորիչի վրա։ Էկրանը մութ է մնում, մինչև լույսը սկսվի։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Untuk matahari terbit, biarkan Phase Wake terbuka di pengisi daya semalaman. Layar tetap gelap sampai cahaya mulai menyala."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Fyrir sólarupprásina skaltu hafa Phase Wake opið í hleðslutækinu yfir nóttina. Skjárinn helst dimmur þar til ljósið byrjar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per l’alba, lascia Phase Wake aperta tutta la notte sul caricabatterie. Lo schermo resta buio finché non inizia la luce."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サンライズを使うには、Phase Wakeを開いたまま一晩充電器につないでおいてください。ライトが始まるまで画面は暗いままです。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "მზის ამოსვლისთვის Phase Wake ღამით დამტენზე ღია დატოვე. ეკრანი ბნელი რჩება, სანამ სინათლე არ დაიწყება."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Күннің шығуы үшін Phase Wake-ті түні бойы зарядта ашық қалдыр. Жарық басталғанша экран қараңғы болады."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "សម្រាប់ថ្ងៃរះ ទុក Phase Wake ឲ្យបើកលើឆ្នាំងសាកពេញមួយយប់។ អេក្រង់នៅងងឹត រហូតដល់ពន្លឺចាប់ផ្ដើម។"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಸೂರ್ಯೋದಯಕ್ಕಾಗಿ ರಾತ್ರಿಯಿಡೀ ಚಾರ್ಜರ್‌ನಲ್ಲಿ Phase Wake ತೆರೆದಿಡಿ. ಬೆಳಕು ಶುರುವಾಗುವವರೆಗೆ ಪರದೆ ಕತ್ತಲಾಗಿರುತ್ತದೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일출 효과를 쓰려면 밤새 충전기에 연결한 채 Phase Wake를 열어 두세요. 빛이 시작될 때까지 화면은 어두운 상태로 유지돼요."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ສຳລັບຕາເວັນຂຶ້ນ ເປີດ Phase Wake ໄວ້ໃນຂະນະສາກໄຟຕະຫຼອດຄືນ ໜ້າຈໍຈະມືດຈົນກວ່າແສງຈະເລີ່ມ"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Kad būtų saulėtekis, palik Phase Wake atidarytą ant įkroviklio per naktį. Ekranas lieka tamsus, kol prasideda šviesa."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lai būtu saullēkts, atstāj Phase Wake atvērtu uz lādētāja visu nakti. Ekrāns paliek tumšs, līdz sākas gaisma."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "За изгрејсонцето, остави го Phase Wake отворен на полначот преку ноќта. Екранот останува темен додека не почне светлото."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "സൂര്യോദയത്തിനായി രാത്രി മുഴുവൻ ചാർജറിൽ Phase Wake തുറന്നുവയ്ക്കുക. വെളിച്ചം തുടങ്ങും വരെ സ്‌ക്രീൻ ഇരുണ്ടിരിക്കും."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Нар мандахын тулд Phase Wake-ийг шөнөжин цэнэглэгч дээр нээлттэй үлдээ. Гэрэл эхлэх хүртэл дэлгэц харанхуй байна."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "सूर्योदयासाठी Phase Wake रात्रभर चार्जरवर उघडे ठेवा. प्रकाश सुरू होईपर्यंत स्क्रीन गडद राहते."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Untuk matahari terbit, biarkan Phase Wake terbuka pada pengecas sepanjang malam. Skrin kekal gelap sehingga cahaya bermula."
          }
        },
        "my": {
          "stringUnit": {
            "state": "translated",
            "value": "နေထွက်အတွက် Phase Wake ကို ညလုံးပေါက် အားသွင်းကြိုးပေါ်တွင် ဖွင့်ထားပါ။ အလင်း မစမီအထိ မျက်နှာပြင် မှောင်နေမည်။"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "For soloppgangen lar du Phase Wake stå åpen på laderen over natten. Skjermen forblir mørk til lyset begynner."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "सूर्योदयका लागि Phase Wake लाई रातभर चार्जरमा खुला छोड। प्रकाश सुरु नहुँदासम्म स्क्रिन अँध्यारो रहन्छ।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Laat Phase Wake voor de zonsopgang ’s nachts open staan op de oplader. Het scherm blijft donker tot het licht begint."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਸੂਰਜ ਚੜ੍ਹਨ ਦੀ ਰੌਸ਼ਨੀ ਲਈ Phase Wake ਨੂੰ ਸਾਰੀ ਰਾਤ ਚਾਰਜਰ ’ਤੇ ਖੁੱਲ੍ਹਾ ਛੱਡੋ। ਰੌਸ਼ਨੀ ਸ਼ੁਰੂ ਹੋਣ ਤੱਕ ਸਕ੍ਰੀਨ ਹਨੇਰੀ ਰਹਿੰਦੀ ਹੈ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aby korzystać ze wschodu słońca, zostaw Phase Wake otwarty na ładowarce na całą noc. Ekran pozostaje ciemny, aż zacznie się światło."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para o nascer do sol, deixe o Phase Wake aberto no carregador durante a noite. A tela fica escura até a luz começar."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Para o nascer do sol, deixa o Phase Wake aberto no carregador durante a noite. O ecrã fica escuro até a luz começar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Pentru răsărit, lasă Phase Wake deschis pe încărcător peste noapte. Ecranul rămâne întunecat până începe lumina."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для рассвета оставь Phase Wake открытым на зарядке на всю ночь. Экран остаётся тёмным, пока не начнётся свет."
          }
        },
        "si": {
          "stringUnit": {
            "state": "translated",
            "value": "හිරු උදාව සඳහා, Phase Wake රාත්‍රිය පුරා ආරෝපකයේ විවෘතව තබන්න. ආලෝකය ආරම්භ වන තුරු තිරය අඳුරුව පවතී."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pre východ slnka nechaj Phase Wake cez noc otvorený na nabíjačke. Obrazovka zostane tmavá, kým sa nezačne svetlo."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Za sončni vzhod pusti Phase Wake čez noč odprt na polnilniku. Zaslon ostane temen, dokler se svetloba ne začne."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Për lindjen e diellit, lëre Phase Wake të hapur në karikues gjatë natës. Ekrani mbetet i errët derisa të nisë drita."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "За излазак сунца остави Phase Wake отворен на пуњачу преко ноћи. Екран остаје таман док светло не почне."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "För soluppgången, låt Phase Wake vara öppen på laddaren över natten. Skärmen förblir mörk tills ljuset börjar."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Kwa macheo, acha Phase Wake ikiwa wazi kwenye chaja usiku kucha. Skrini inabaki giza hadi mwanga uanze."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "சூரிய உதயத்துக்கு, இரவு முழுவதும் சார்ஜரில் Phase Wake ஐத் திறந்தே வையுங்கள். ஒளி தொடங்கும் வரை திரை இருட்டாக இருக்கும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "సూర్యోదయం కోసం Phase Wakeను రాత్రంతా ఛార్జర్‌పై తెరిచి ఉంచండి. వెలుగు మొదలయ్యే వరకు స్క్రీన్ చీకటిగా ఉంటుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สำหรับแสงอาทิตย์ขึ้น ให้เปิด Phase Wake ทิ้งไว้บนที่ชาร์จตลอดคืน หน้าจอจะมืดจนกว่าแสงจะเริ่ม"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gün doğumu için Phase Wake’i gece boyunca şarjda açık bırak. Işık başlayana kadar ekran karanlık kalır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Для світанку залиш Phase Wake відкритим на зарядці на всю ніч. Екран залишається темним, доки не почнеться світло."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "طلوعِ آفتاب کے لیے رات بھر Phase Wake کو چارجر پر کھلا رہنے دو۔ روشنی شروع ہونے تک اسکرین تاریک رہتی ہے۔"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Quyosh chiqishi uchun Phase Wakeʼni tun boʻyi quvvatlagichda ochiq qoldir. Yorugʻlik boshlanguncha ekran qorongʻi turadi."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Để dùng bình minh, hãy để Phase Wake mở trên đế sạc suốt đêm. Màn hình vẫn tối cho đến khi ánh sáng bắt đầu."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "如要使用日出，請整晚讓 Phase Wake 在充電時保持開啟。螢幕會保持黑暗，直至光線開始亮起。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为了日出唤醒，请让 Phase Wake 整晚在充电器上保持打开。屏幕会保持黑暗，直到光线开始亮起。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "為了日出喚醒，請讓 Phase Wake 整晚在充電器上保持開啟。螢幕會保持黑暗，直到光線開始亮起。"
          }
        },
        "zu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ukuze uthole ukuphuma kwelanga, shiya i-Phase Wake ivuliwe kushaja ubusuku bonke. Isikrini sihlala simnyama kuze kuqale ukukhanya."
          }
        }
      }
    },
