        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake: MIT ፈቃድ፣ © r1adBE።\nManrope ፊደል: SIL Open Font License 1.1፣ © The Manrope Project Authors።\nየድምፅ ማወቂያ: MediaPipe Tasks Audio እና የYAMNet ሞዴል፣ Apache License 2.0፣ © Google LLC።\nድምፆች: ከopengameart.org ነፃ ቅጂዎች (CC0)"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake: ترخيص MIT، © r1adBE.\nخط Manrope: SIL Open Font License 1.1، © The Manrope Project Authors.\nالتعرّف على الأصوات: MediaPipe Tasks Audio ونموذج YAMNet، Apache License 2.0، © Google LLC.\nالأصوات: تسجيلات حرة (CC0) من opengameart.org"
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake: MIT lisenziyası, © r1adBE.\nManrope şrifti: SIL Open Font License 1.1, © The Manrope Project Authors.\nSəs tanıma: MediaPipe Tasks Audio və YAMNet modeli, Apache License 2.0, © Google LLC.\nSəslər: opengameart.org saytından sərbəst yazılar (CC0)"
          }
