        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் வாட்ச் அலாரத்தைத் தயார்செய்ய, தூங்கச் செல்லும் முன் Phase Wake ஐத் திறவுங்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ వాచ్ అలారాన్ని సిద్ధం చేయగలిగేలా నిద్రపోయే ముందు Phase Wake తెరవండి."
          }
        },
        "th": {
          "stringUnit": {
