    "settings_data_text": {
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles bly op jou foon en horlosie. Geen rekening, geen bediener, geen nasporing nie."
          }
        },
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "ሁሉም ነገር በስልክዎና በሰዓትዎ ላይ ይቆያል። መለያ የለም፣ አገልጋይ የለም፣ ክትትል የለም።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كل شيء يبقى على هاتفك وساعتك. بلا حساب ولا خادم ولا تتبّع."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Hər şey telefonunda və saatında qalır. Hesab yox, server yox, izləmə yox."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Всичко остава на телефона и часовника. Без акаунт, без сървър, без проследяване."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সবকিছু তোমার ফোন আর ঘড়িতেই থাকে। কোনো অ্যাকাউন্ট নেই, সার্ভার নেই, ট্র্যাকিং নেই।"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Sve ostaje na tvom telefonu i satu. Bez računa, bez servera, bez praćenja."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Tot es queda al telèfon i al rellotge. Sense compte, sense servidor, sense seguiment."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vše zůstává v telefonu a hodinkách. Bez účtu, bez serveru, bez sledování."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Alt bliver på din telefon og dit ur. Ingen konto, ingen server, ingen sporing."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles bleibt auf Handy und Uhr. Kein Konto, kein Server, keine Auswertung."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Όλα μένουν στο κινητό και στο ρολόι. Χωρίς λογαριασμό, χωρίς διακομιστή, χωρίς παρακολούθηση."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Everything stays on your phone and watch. No account, no server, no tracking."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo se queda en tu móvil y tu reloj. Sin cuenta, sin servidor, sin seguimiento."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kõik jääb sinu telefoni ja kella. Pole kontot, serverit ega jälgimist."
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "Dena telefonoan eta erlojuan geratzen da. Konturik, zerbitzaririk eta jarraipenik gabe."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "همه‌چیز روی گوشی و ساعتت می‌ماند. بدون حساب، بدون سرور، بدون ردیابی."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaikki pysyy puhelimessa ja kellossa. Ei tiliä, ei palvelinta, ei seurantaa."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Nananatili ang lahat sa telepono at relo mo. Walang account, walang server, walang tracking."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout reste sur ton téléphone et ta montre. Pas de compte, pas de serveur, pas de suivi."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Fanann gach rud ar do fhón agus ar d’uaireadóir. Gan chuntas, gan fhreastalaí, gan rianú."
          }
        },
        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo queda no teléfono e no reloxo. Sen conta, sen servidor, sen seguimento."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "બધું તમારા ફોન અને ઘડિયાળ પર જ રહે છે. કોઈ એકાઉન્ટ નહીં, કોઈ સર્વર નહીં, કોઈ ટ્રેકિંગ નહીં."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הכול נשאר בטלפון ובשעון. בלי חשבון, בלי שרת, בלי מעקב."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सब कुछ तुम्हारे फ़ोन और घड़ी में रहता है। न खाता, न सर्वर, न ट्रैकिंग।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sve ostaje na tvom telefonu i satu. Bez računa, bez poslužitelja, bez praćenja."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Minden a telefonodon és az órádon marad. Nincs fiók, nincs szerver, nincs követés."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ամեն ինչ մնում է հեռախոսիդ ու ժամացույցիդ վրա։ Ո՛չ հաշիվ, ո՛չ սերվեր, ո՛չ հետևում։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Semua tetap di ponsel dan jam tanganmu. Tanpa akun, tanpa server, tanpa pelacakan."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Allt verður eftir í símanum og úrinu. Enginn aðgangur, enginn þjónn, engin rakning."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutto resta sul telefono e sullo smartwatch. Nessun account, nessun server, nessun tracciamento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべてスマートフォンとウォッチ内に保存されます。アカウントもサーバーもトラッキングもありません。"
