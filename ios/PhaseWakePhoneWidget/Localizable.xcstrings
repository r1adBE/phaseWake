        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Тук могат да се появят и нощи от Apple Health и други приложения. За да ги видиш, сравни със здравните данни."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Health ও অন্য অ্যাপের রাতগুলোও এখানে দেখা যেতে পারে। দেখতে চাইলে স্বাস্থ্য ডেটার সঙ্গে মেলাও।"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovdje se mogu prikazati i noći iz aplikacije Apple Health i drugih aplikacija. Da ih vidiš, uporedi sa zdravstvenim podacima."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Aquí també poden aparèixer nits de Apple Health i altres apps. Per veure-les, compara amb les dades de salut."
