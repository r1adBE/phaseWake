    "learn_intro": {
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Sodat Phase Wake die wekker by jou kan aanpas, meet jou horlosie snags beweging en polsslag."
          }
        },
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake ማንቂያውን ለአንተ እንዲያስተካክል ሰዓትህ ሌሊት እንቅስቃሴና የልብ ምት ይለካል።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لكي يضبط Phase Wake المنبّه حسبك، تقيس ساعتك الحركة والنبض ليلًا."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake zəngli saatı sənə uyğunlaşdırsın deyə, saatın gecələr hərəkəti və nəbzi ölçür."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "За да нагласи Phase Wake алармата според теб, часовникът ти измерва движение и пулс през нощта."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake যাতে অ্যালার্ম তোমার মতো করে নিতে পারে, তোমার ঘড়ি রাতে নড়াচড়া ও পালস মাপে।"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Da bi Phase Wake prilagodio alarm tebi, tvoj sat noću mjeri pokrete i puls."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Perquè Phase Wake adapti l’alarma a tu, el rellotge mesura moviment i pols durant la nit."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Aby Phase Wake mohl přizpůsobit budík tobě, hodinky v noci měří pohyb a tep."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "For at Phase Wake kan tilpasse alarmen til dig, måler dit ur bevægelse og puls om natten."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Damit Phase Wake den Wecker an dich anpasst, misst deine Uhr nachts Bewegung und Puls."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Για να προσαρμόσει το Phase Wake το ξυπνητήρι σε σένα, το ρολόι σου μετρά κίνηση και παλμούς τη νύχτα."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "So Phase Wake can adapt the alarm to you, your watch measures motion and pulse at night."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para que Phase Wake adapte la alarma a ti, tu reloj mide movimiento y pulso por la noche."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Et Phase Wake saaks äratuse sinu järgi kohandada, mõõdab su kell öösel liikumist ja pulssi."
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake-k alarma zuri egokitzeko, erlojuak mugimendua eta pultsua neurtzen ditu gauez."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "برای اینکه Phase Wake زنگ را با تو هماهنگ کند، ساعتت شب‌ها حرکت و نبض را اندازه می‌گیرد."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jotta Phase Wake voi mukauttaa herätyksen sinulle, kellosi mittaa öisin liikettä ja sykettä."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Para maiangkop ng Phase Wake ang alarm sa iyo, sinusukat ng relo mo ang galaw at pulso sa gabi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour que Phase Wake adapte le réveil à toi, ta montre mesure mouvements et pouls pendant la nuit."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Ionas gur féidir le Phase Wake an t-aláram a oiriúnú duit, tomhaiseann d’uaireadóir gluaiseacht agus cuisle san oíche."
          }
        },
        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "Para que Phase Wake adapte a alarma a ti, o teu reloxo mide movemento e pulso pola noite."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake એલાર્મને તમારા મુજબ ગોઠવી શકે તે માટે, તમારી ઘડિયાળ રાત્રે હલનચલન અને પલ્સ માપે છે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כדי ש-Phase Wake יוכל להתאים את השעון המעורר אליך, השעון שלך מודד תנועה ודופק בלילה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ताकि Phase Wake अलार्म को तुम्हारे हिसाब से ढाल सके, तुम्हारी घड़ी रात में हलचल और पल्स मापती है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kako bi Phase Wake prilagodio alarm tebi, tvoj sat noću mjeri pokrete i puls."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Hogy a Phase Wake hozzád igazíthassa az ébresztést, az órád éjjel méri a mozgást és a pulzust."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Որպեսզի Phase Wake-ը զարթուցիչը հարմարեցնի քեզ, ժամացույցդ գիշերը չափում է շարժումն ու զարկերակը։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Agar Phase Wake bisa menyesuaikan alarm denganmu, jam tanganmu mengukur gerakan dan denyut nadi di malam hari."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Til að Phase Wake geti lagað vekjarann að þér mælir úrið hreyfingu og púls á nóttunni."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Perché Phase Wake possa adattare la sveglia a te, il tuo orologio misura movimento e battito di notte."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake がアラームをあなたに合わせられるように、時計が夜のあいだ体の動きと脈拍を計測します。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "იმისთვის, რომ Phase Wake-მა მაღვიძარა შენზე მოარგოს, შენი საათი ღამით ზომავს მოძრაობას და პულსს."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake оятқышты саған бейімдеуі үшін сағатың түнде қозғалыс пен пульсті өлшейді."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ដើម្បីឱ្យ Phase Wake អាចសម្រួលម៉ោងរោទ៍ឱ្យសមនឹងអ្នក នាឡិការបស់អ្នកវាស់ចលនា និងជីពចរនៅពេលយប់។"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake ಅಲಾರಾಂ ಅನ್ನು ನಿಮಗೆ ಹೊಂದಿಸಲು, ನಿಮ್ಮ ವಾಚ್ ರಾತ್ರಿ ಚಲನೆ ಮತ್ತು ನಾಡಿಯನ್ನು ಅಳೆಯುತ್ತದೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake가 알람을 당신에게 맞출 수 있도록 시계가 밤에 움직임과 맥박을 측정합니다."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ເພື່ອໃຫ້ Phase Wake ປັບໂມງປຸກໃຫ້ເໝາະກັບເຈົ້າ, ໂມງຂອງເຈົ້າຈະວັດການເຄື່ອນໄຫວ ແລະ ຊີບພະຈອນໃນຕອນກາງຄືນ."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Kad Phase Wake galėtų pritaikyti žadintuvą tau, tavo laikrodis naktį matuoja judesį ir pulsą."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lai Phase Wake varētu pielāgot modinātāju tev, tavs pulkstenis naktī mēra kustību un pulsu."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "За Phase Wake да го прилагоди алармот кон тебе, твојот часовник ноќе мери движење и пулс."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake അലാറം നിങ്ങൾക്ക് അനുസരിച്ച് ക്രമീകരിക്കാൻ, നിങ്ങളുടെ വാച്ച് രാത്രിയിൽ ചലനവും പൾസും അളക്കുന്നു."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake сэрүүлгийг чамд тохируулахын тулд цаг чинь шөнө хөдөлгөөн ба судасны цохилтыг хэмжинэ."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake ला अलार्म तुमच्यानुसार जुळवता यावा म्हणून, तुमचे घड्याळ रात्री हालचाल आणि नाडी मोजते."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Supaya Phase Wake dapat menyesuaikan penggera dengan anda, jam tangan anda mengukur pergerakan dan nadi pada waktu malam."
          }
        },
        "my": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake က နှိုးစက်ကို သင့်နှင့်ကိုက်ညီအောင် ချိန်ညှိနိုင်ရန် သင့်နာရီသည် ညဘက်တွင် လှုပ်ရှားမှုနှင့် သွေးခုန်နှုန်းကို တိုင်းတာသည်။"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "For at Phase Wake skal kunne tilpasse alarmen til deg, måler klokken din bevegelse og puls om natten."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake ले अलार्मलाई तिमी अनुसार मिलाउन सकोस् भनेर तिम्रो घडीले राति चाल र नाडी नाप्छ।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zodat Phase Wake de wekker op jou kan afstemmen, meet je horloge 's nachts beweging en hartslag."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਤਾਂ ਜੋ Phase Wake ਅਲਾਰਮ ਨੂੰ ਤੁਹਾਡੇ ਮੁਤਾਬਕ ਢਾਲ ਸਕੇ, ਤੁਹਾਡੀ ਘੜੀ ਰਾਤ ਨੂੰ ਹਿਲਜੁਲ ਅਤੇ ਨਬਜ਼ ਮਾਪਦੀ ਹੈ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aby Phase Wake mógł dopasować budzik do ciebie, zegarek mierzy w nocy ruch i tętno."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para o Phase Wake adaptar o alarme a você, seu relógio mede movimento e pulso durante a noite."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Para o Phase Wake adaptar o alarme a ti, o teu relógio mede movimento e pulso durante a noite."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ca Phase Wake să poată adapta alarma la tine, ceasul tău măsoară noaptea mișcarea și pulsul."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чтобы Phase Wake мог подстроить будильник под тебя, часы ночью измеряют движение и пульс."
          }
        },
        "si": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake හට එලාමය ඔබට ගැලපෙන ලෙස සකස් කිරීමට, ඔබේ ඔරලෝසුව රාත්‍රියේ චලනය සහ නාඩිය මනියි."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Aby Phase Wake mohol prispôsobiť budík tebe, hodinky v noci merajú pohyb a pulz."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Da lahko Phase Wake alarm prilagodi tebi, ura ponoči meri gibanje in utrip."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Që Phase Wake ta përshtatë alarmin për ty, ora jote mat lëvizjen dhe pulsin gjatë natës."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Да би Phase Wake прилагодио аларм теби, твој сат ноћу мери покрете и пулс."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "För att Phase Wake ska kunna anpassa larmet efter dig mäter din klocka rörelse och puls på natten."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Ili Phase Wake iweze kurekebisha kengele kwa ajili yako, saa yako hupima mwendo na mapigo ya moyo usiku."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake அலாரத்தை உங்களுக்கு ஏற்ப மாற்ற, உங்கள் கடிகாரம் இரவில் அசைவையும் நாடியையும் அளக்கிறது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake అలారాన్ని మీకు తగ్గట్టు మార్చడానికి, మీ వాచ్ రాత్రి వేళ కదలిక మరియు నాడిని కొలుస్తుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เพื่อให้ Phase Wake ปรับนาฬิกาปลุกให้เข้ากับคุณ นาฬิกาของคุณจะวัดการเคลื่อนไหวและชีพจรในตอนกลางคืน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake alarmı sana göre ayarlayabilsin diye saatin gece hareketi ve nabzı ölçer."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Щоб Phase Wake міг підлаштувати будильник під тебе, годинник уночі вимірює рух і пульс."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "تاکہ Phase Wake الارم کو آپ کے مطابق ڈھال سکے، آپ کی گھڑی رات کو حرکت اور نبض ناپتی ہے۔"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake budilnikni senga moslashi uchun soating tunda harakat va pulsni o‘lchaydi."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Để Phase Wake điều chỉnh báo thức theo bạn, đồng hồ của bạn đo chuyển động và nhịp tim vào ban đêm."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "為咗等 Phase Wake 按你調整鬧鐘，你嘅手錶會喺夜間測量動作同脈搏。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为了让 Phase Wake 根据你调整闹钟，你的手表会在夜间测量动作和脉搏。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "為了讓 Phase Wake 依你調整鬧鐘，你的手錶會在夜間測量動作和脈搏。"
          }
        },
        "zu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ukuze i-Phase Wake ikwazi ukulungisa i-alamu ikufanele, iwashi lakho lilinganisa ukunyakaza nokushaya kwenhliziyo ebusuku."
          }
        }
      }
    },
