        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ამ ტელეფონზე მაღვიძარები, ისტორია, შენიშვნები და პარამეტრები სარეზერვო ასლით ჩანაცვლდება."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бұл телефондағы оятқыштар, тарих, жазбалар мен параметрлер сақтық көшірмемен ауыстырылады."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ម៉ោងរោទ៍ ប្រវត្តិ កំណត់ចំណាំ និងការកំណត់លើទូរសព្ទនេះ នឹងត្រូវជំនួសដោយការបម្រុងទុក។"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಈ ಫೋನ್‌ನಲ್ಲಿರುವ ಅಲಾರಾಂಗಳು, ಇತಿಹಾಸ, ಟಿಪ್ಪಣಿಗಳು ಮತ್ತು ಸೆಟ್ಟಿಂಗ್‌ಗಳನ್ನು ಬ್ಯಾಕಪ್‌ನಿಂದ ಬದಲಿಸಲಾಗುತ್ತದೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
