        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake: лиценз MIT, © r1adBE.\nШрифт Manrope: SIL Open Font License 1.1, © The Manrope Project Authors.\nРазпознаване на звуци: MediaPipe Tasks Audio и моделът YAMNet, Apache License 2.0, © Google LLC.\nЗвуци: свободни записи (CC0) от opengameart.org"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake: MIT লাইসেন্স, © r1adBE।\nManrope ফন্ট: SIL Open Font License 1.1, © The Manrope Project Authors।\nশব্দ শনাক্তকরণ: MediaPipe Tasks Audio ও YAMNet মডেল, Apache License 2.0, © Google LLC।\nশব্দ: opengameart.org-এর ফ্রি রেকর্ডিং (CC0)"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake: MIT licenca, © r1adBE.\nFont Manrope: SIL Open Font License 1.1, © The Manrope Project Authors.\nPrepoznavanje zvukova: MediaPipe Tasks Audio i model YAMNet, Apache License 2.0, © Google LLC.\nZvukovi: slobodni snimci (CC0) s opengameart.org"
          }
