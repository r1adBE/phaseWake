        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "تمہارے لیے الارم ڈھالنے کو Phase Wake تمہاری گھڑی سے %1$lld راتیں ناپتا ہے۔ رات کو کم از کم %2$lld %% بیٹری کے ساتھ پہنو۔"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake budilnikni senga moslash uchun soating bilan %1$lld tun o‘lchaydi. Kechasi kamida %2$lld %% batareya bilan taqib yur."
