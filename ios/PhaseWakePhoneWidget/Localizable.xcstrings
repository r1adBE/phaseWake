    "editor_sunrise_hint": {
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Die skerm begin met ’n dowwe oranje gloed en word helder, warm lig teen volle helderheid."
          }
        },
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "ማያ ገጹ በደካማ ብርቱካናማ ብርሃን ይጀምርና በሙሉ ብሩህነት ወደ ደማቅ፣ ሞቅ ያለ ብርሃን ይቀየራል።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تبدأ الشاشة بتوهج برتقالي خافت ثم تتحول إلى ضوء دافئ ساطع بأقصى سطوع."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekran zəif narıncı parıltı ilə başlayır və tam parlaqlıqda parlaq, isti işığa çevrilir."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Екранът започва със слабо оранжево сияние и преминава в ярка, топла светлина при пълна яркост."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "স্ক্রিন শুরু হয় হালকা কমলা আভা দিয়ে, তারপর পূর্ণ উজ্জ্বলতায় উজ্জ্বল উষ্ণ আলো হয়ে যায়।"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekran počinje slabim narandžastim sjajem i prelazi u jako, toplo svjetlo pune svjetline."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "La pantalla comença amb una lleugera resplendor taronja i passa a una llum clara i càlida amb la brillantor al màxim."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Displej nejdřív slabě zoranží a pak přejde v jasné, teplé světlo na plný jas."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Skærmen starter med et svagt orange skær og bliver til klart, varmt lys ved fuld lysstyrke."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Bildschirm leuchtet erst schwach orange und wird dann zu hellem, warmem Licht bei voller Helligkeit."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η οθόνη ξεκινά με ένα αχνό πορτοκαλί φως και γίνεται έντονο, ζεστό φως στη μέγιστη φωτεινότητα."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The screen starts with a faint orange glow and turns into bright, warm light at full brightness."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La pantalla empieza con un tenue brillo naranja y se convierte en una luz cálida e intensa a pleno brillo."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekraan algab nõrga oranži kumaga ja muutub täisheleduse juures eredaks soojaks valguseks."
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "Pantaila distira laranja ahul batekin hasten da, eta argi bizi eta epel bihurtzen da distira osoan."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "صفحه با درخششی کم‌رنگ و نارنجی شروع می‌شود و با نور کامل به نوری روشن و گرم تبدیل می‌شود."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Näyttö alkaa himmeänä oranssina hehkuna ja muuttuu kirkkaaksi, lämpimäksi valoksi täydellä kirkkaudella."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Nagsisimula ang screen sa mahinang kulay-kahel na liwanag at nagiging maliwanag at mainit na ilaw sa buong liwanag."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’écran démarre avec une faible lueur orange, puis se transforme en lumière chaude et vive à pleine luminosité."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Tosaíonn an scáileán le loinnir lag oráiste agus éiríonn sé ina sholas geal te ag an ngile iomlán."
          }
        },
        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "A pantalla comeza cun leve brillo laranxa e pasa a unha luz clara e cálida co brillo ao máximo."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "સ્ક્રીન આછા નારંગી પ્રકાશથી શરૂ થાય છે અને પૂરી બ્રાઇટનેસ પર તેજ, ગરમ પ્રકાશમાં બદલાય છે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "המסך מתחיל בזוהר כתום חלש והופך לאור חם ובהיר בבהירות מלאה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्क्रीन हल्की नारंगी चमक से शुरू होती है और पूरी ब्राइटनेस पर तेज़, गर्म रोशनी बन जाती है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaslon počinje slabim narančastim sjajem i prelazi u jako, toplo svjetlo pune svjetline."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A képernyő halvány narancsszínű fénnyel indul, majd teljes fényerőn erős, meleg fénnyé válik."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Էկրանը սկսում է թույլ նարնջագույն շողով և լրիվ պայծառությամբ դառնում է վառ, տաք լույս։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Layar mulai dengan cahaya oranye redup, lalu berubah menjadi cahaya hangat yang terang dengan kecerahan penuh."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Skjárinn byrjar með daufum appelsínugulum bjarma og verður að björtu, hlýju ljósi á fullri birtu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo schermo parte con un tenue bagliore arancione e diventa una luce calda e intensa alla massima luminosità."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画面はかすかなオレンジ色の光から始まり、最大輝度の明るく暖かい光に変わります。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ეკრანი იწყებს მკრთალი ნარინჯისფერი ნათებით და სრული სიკაშკაშით ხდება ნათელი, თბილი სინათლე."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Экран әлсіз қызғылт сары жарықтан басталып, толық жарықтықта жарық, жылы жарыққа айналады."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "អេក្រង់ចាប់ផ្ដើមដោយពន្លឺទឹកក្រូចស្រអាប់ ហើយប្រែជាពន្លឺកក់ក្ដៅភ្លឺច្បាស់ នៅពន្លឺពេញ។"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಪರದೆ ಮಂದವಾದ ಕಿತ್ತಳೆ ಹೊಳಪಿನಿಂದ ಶುರುವಾಗಿ, ಪೂರ್ಣ ಪ್ರಕಾಶದಲ್ಲಿ ಉಜ್ವಲ, ಬೆಚ್ಚಗಿನ ಬೆಳಕಾಗುತ್ತದೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "화면이 희미한 주황빛으로 시작해 최대 밝기의 밝고 따뜻한 빛으로 바뀌어요."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ໜ້າຈໍເລີ່ມດ້ວຍແສງສີສົ້ມອ່ອນໆ ແລ້ວກາຍເປັນແສງອົບອຸ່ນສະຫວ່າງ ເມື່ອຄວາມສະຫວ່າງເຕັມທີ່"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekranas pradeda nuo silpno oranžinio švytėjimo ir virsta ryškia, šilta šviesa visu ryškumu."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekrāns sāk ar vāju oranžu mirdzumu un pāriet spilgtā, siltā gaismā ar pilnu spilgtumu."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Екранот почнува со слаб портокалов сјај и преминува во јасна, топла светлина при полна осветленост."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "മങ്ങിയ ഓറഞ്ച് തിളക്കത്തോടെ തുടങ്ങി, പൂർണ തെളിച്ചത്തിൽ ശോഭയുള്ള ഊഷ്മള വെളിച്ചമായി മാറും."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Дэлгэц бүдэг улбар шар туяагаар эхэлж, бүрэн гэрэлтэлтэд тод, дулаан гэрэл болно."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "स्क्रीन मंद केशरी प्रकाशाने सुरू होते आणि पूर्ण ब्राइटनेसवर तेजस्वी, उबदार प्रकाशात बदलते."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Skrin bermula dengan cahaya oren yang malap, kemudian bertukar menjadi cahaya hangat yang cerah pada kecerahan penuh."
          }
        },
        "my": {
          "stringUnit": {
            "state": "translated",
            "value": "မျက်နှာပြင်သည် မှိန်သော လိမ္မော်ရောင်ဖြင့် စပြီး အပြည့်အလင်းတွင် တောက်ပနွေးထွေးသော အလင်းဖြစ်လာသည်။"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Skjermen starter med et svakt oransje skjær og blir til sterkt, varmt lys ved full lysstyrke."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "स्क्रिन मधुरो सुन्तला चमकबाट सुरु हुन्छ र पूरा उज्यालोमा चम्किलो, न्यानो प्रकाश बन्छ।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het scherm begint met een zwakke oranje gloed en wordt helder, warm licht op volle helderheid."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਸਕ੍ਰੀਨ ਹਲਕੀ ਸੰਤਰੀ ਲੋਅ ਨਾਲ ਸ਼ੁਰੂ ਹੁੰਦੀ ਹੈ ਅਤੇ ਪੂਰੀ ਚਮਕ ’ਤੇ ਤੇਜ਼, ਨਿੱਘੀ ਰੌਸ਼ਨੀ ਬਣ ਜਾਂਦੀ ਹੈ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekran zaczyna od słabej pomarańczowej poświaty i zmienia się w jasne, ciepłe światło przy pełnej jasności."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A tela começa com um brilho laranja fraco e se torna uma luz quente e intensa com o brilho no máximo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O ecrã começa com um brilho laranja fraco e torna-se uma luz quente e intensa com o brilho no máximo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ecranul începe cu o strălucire portocalie slabă și devine o lumină caldă și intensă la luminozitate maximă."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Экран начинает слабо светиться оранжевым, а затем становится ярким тёплым светом на полной яркости."
          }
        },
        "si": {
          "stringUnit": {
            "state": "translated",
            "value": "තිරය මඳ තැඹිලි දීප්තියකින් ආරම්භ වී පූර්ණ දීප්තියේදී දීප්තිමත්, උණුසුම් ආලෝකයක් බවට පත් වේ."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Obrazovka začne slabou oranžovou žiarou a prejde do jasného, teplého svetla pri plnom jase."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaslon začne s šibkim oranžnim sijem in preide v svetlo, toplo svetlobo pri polni svetlosti."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekrani nis me një shkëlqim të zbehtë portokalli dhe kthehet në dritë të fortë e të ngrohtë me ndriçim të plotë."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Екран почиње слабим наранџастим сјајем и прелази у јако, топло светло пуне осветљености."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Skärmen börjar med ett svagt orange sken och blir ett starkt, varmt ljus med full ljusstyrka."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Skrini inaanza na mng’ao hafifu wa rangi ya chungwa na kugeuka kuwa mwanga mkali na wa joto kwa mwangaza kamili."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "திரை மங்கலான ஆரஞ்சு ஒளியுடன் தொடங்கி, முழுப் பிரகாசத்தில் வெதுவெதுப்பான வெளிச்சமாக மாறும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "స్క్రీన్ మసక నారింజ కాంతితో మొదలై, పూర్తి బ్రైట్‌నెస్‌లో ప్రకాశవంతమైన, వెచ్చని వెలుగుగా మారుతుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หน้าจอเริ่มจากแสงสีส้มจาง ๆ แล้วค่อยเป็นแสงอุ่นสว่างที่ความสว่างเต็มที่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekran soluk bir turuncu parıltıyla başlar ve tam parlaklıkta parlak, sıcak bir ışığa dönüşür."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Екран починає слабо світитися помаранчевим, а потім стає яскравим теплим світлом на повній яскравості."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اسکرین ہلکی نارنجی چمک سے شروع ہوتی ہے اور پوری چمک پر تیز، گرم روشنی بن جاتی ہے۔"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekran xira toʻq sariq nur bilan boshlanadi va toʻliq yorqinlikda yorqin, iliq yorugʻlikka aylanadi."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Màn hình bắt đầu bằng ánh cam mờ rồi chuyển thành ánh sáng ấm, rực rỡ ở độ sáng tối đa."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "螢幕先發出微弱的橙光，然後漸漸變成最高亮度的明亮暖光。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "屏幕先泛起微弱的橙色光，再逐渐变为全亮度的明亮暖光。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "螢幕先泛起微弱的橙色光，再逐漸變為全亮度的明亮暖光。"
          }
        },
        "zu": {
          "stringUnit": {
            "state": "translated",
            "value": "Isikrini siqala ngokukhanya okuwolintshi okufiphele bese siba ukukhanya okufudumele, okugqamile ekukhanyeni okugcwele."
          }
        }
      }
    },
    "editor_sunrise_ios_hint": {
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Jou iPhone kan die lig net wys terwyl Phase Wake oop is – begin bedkassiemodus voor jy gaan slaap."
          }
        },
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhoneዎ ብርሃኑን ማሳየት የሚችለው Phase Wake ክፍት ሲሆን ብቻ ነው – ከመተኛትዎ በፊት የአልጋ ዳር ሁነታን ይጀምሩ።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يستطيع الـ iPhone عرض الضوء إلا أثناء فتح Phase Wake – ابدأ وضع المنضدة قبل النوم."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone-un işığı yalnız Phase Wake açıq olanda göstərə bilər – yatmazdan əvvəl gecə masası rejimini başlat."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone може да показва светлината само докато Phase Wake е отворено – пусни режим нощно шкафче, преди да заспиш."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake খোলা থাকলেই শুধু তোমার iPhone আলো দেখাতে পারে – ঘুমাতে যাওয়ার আগে নাইটস্ট্যান্ড মোড শুরু করো।"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tvoj iPhone može prikazivati svjetlo samo dok je Phase Wake otvoren – pokreni način za noćni ormarić prije spavanja."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "L’iPhone només pot mostrar la llum mentre Phase Wake està obert – activa el mode tauleta de nit abans d’anar a dormir."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tvůj iPhone může zobrazit světlo, jen když je Phase Wake otevřená – před spaním spusť noční režim."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Din iPhone kan kun vise lyset, mens Phase Wake er åben – start natbordstilstand, før du går i seng."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das iPhone kann das Licht nur zeigen, solange Phase Wake offen ist – starte vor dem Schlafen den Nachttisch-Modus."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το iPhone σου μπορεί να δείξει το φως μόνο όσο το Phase Wake είναι ανοιχτό – ξεκίνα τη λειτουργία κομοδίνου πριν κοιμηθείς."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your iPhone can only show the light while Phase Wake is open – start nightstand mode before you go to sleep."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu iPhone solo puede mostrar la luz mientras Phase Wake esté abierta: inicia el modo mesita de noche antes de dormir."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Su iPhone saab valgust näidata ainult siis, kui Phase Wake on avatud – lülita enne magamaminekut sisse öökapirežiim."
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone-ak Phase Wake irekita dagoen bitartean bakarrik erakuts dezake argia – hasi gaumahai modua lo egin aurretik."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone فقط تا وقتی Phase Wake باز است می‌تواند نور را نشان بدهد – پیش از خواب حالت پاتختی را شروع کن."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhonesi voi näyttää valon vain Phase Waken ollessa auki – käynnistä yöpöytätila ennen nukkumaanmenoa."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Maipapakita lang ng iPhone mo ang liwanag habang bukas ang Phase Wake – simulan ang nightstand mode bago ka matulog."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ton iPhone ne peut afficher la lumière que tant que Phase Wake est ouverte – démarre le mode table de chevet avant de dormir."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Ní féidir le d’iPhone an solas a thaispeáint ach fad atá Phase Wake oscailte – tosaigh mód taobh leapa sula dtéann tú a chodladh."
          }
        },
        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "O iPhone só pode mostrar a luz mentres Phase Wake está aberto – inicia o modo mesa de noite antes de durmir."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake ખુલ્લું હોય ત્યારે જ તમારો iPhone પ્રકાશ બતાવી શકે છે – સૂતાં પહેલાં નાઇટસ્ટૅન્ડ મોડ શરૂ કરો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ה-iPhone יכול להציג את האור רק כש-Phase Wake פתוחה – הפעילו מצב שידת לילה לפני השינה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका iPhone रोशनी तभी दिखा सकता है जब Phase Wake खुला हो – सोने से पहले बेडसाइड मोड शुरू करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tvoj iPhone može prikazivati svjetlo samo dok je Phase Wake otvoren – pokreni način za noćni ormarić prije spavanja."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az iPhone csak akkor tudja megjeleníteni a fényt, amíg a Phase Wake nyitva van – lefekvés előtt indítsd el az éjjeliszekrény-módot."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone-դ կարող է լույսը ցույց տալ միայն, երբ Phase Wake-ը բաց է – քնելուց առաջ սկսիր գիշերային սեղանի ռեժիմը։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone-mu hanya bisa menampilkan cahaya selama Phase Wake terbuka – mulai mode samping tempat tidur sebelum tidur."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone getur aðeins sýnt ljósið á meðan Phase Wake er opið – byrjaðu náttborðsstillingu áður en þú ferð að sofa."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo iPhone può mostrare la luce solo finché Phase Wake è aperta – avvia la modalità comodino prima di dormire."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhoneはPhase Wakeを開いている間しかライトを表示できません – 眠る前にナイトスタンドモードを開始してください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone სინათლეს მხოლოდ მაშინ აჩვენებს, როცა Phase Wake ღიაა – დაძინებამდე ჩართე ღამის მაგიდის რეჟიმი."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone жарықты тек Phase Wake ашық кезде көрсете алады – ұйықтар алдында түнгі үстел режимін баста."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone អាចបង្ហាញពន្លឺបានតែពេល Phase Wake បើកប៉ុណ្ណោះ – ចាប់ផ្ដើមមុខងារតុក្បាលគ្រែមុនពេលចូលដេក។"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake ತೆರೆದಿರುವಾಗ ಮಾತ್ರ iPhone ಬೆಳಕು ತೋರಿಸಬಲ್ಲದು – ಮಲಗುವ ಮೊದಲು ನೈಟ್‌ಸ್ಟ್ಯಾಂಡ್ ಮೋಡ್ ಶುರು ಮಾಡಿ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone은 Phase Wake가 열려 있는 동안에만 빛을 보여줄 수 있어요 – 자기 전에 탁상 모드를 시작하세요."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone ສະແດງແສງໄດ້ສະເພາະຕອນ Phase Wake ເປີດຢູ່ – ເລີ່ມໂໝດຂ້າງຕຽງກ່ອນເຈົ້າເຂົ້ານອນ"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone gali rodyti šviesą tik tada, kai Phase Wake atidaryta – prieš miegą įjunk naktinio staliuko režimą."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone var rādīt gaismu tikai tad, kad Phase Wake ir atvērts – pirms gulētiešanas ieslēdz naktsgaldiņa režīmu."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone може да го прикаже светлото само додека Phase Wake е отворен – почни ноќен режим пред да заспиеш."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake തുറന്നിരിക്കുമ്പോൾ മാത്രമേ iPhone-ന് വെളിച്ചം കാണിക്കാനാകൂ – ഉറങ്ങും മുമ്പ് നൈറ്റ്‌സ്റ്റാൻഡ് മോഡ് തുടങ്ങുക."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone гэрлийг зөвхөн Phase Wake нээлттэй үед харуулж чадна – унтахаасаа өмнө орны дэргэдэх горимыг эхлүүл."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake उघडे असतानाच तुमचा iPhone प्रकाश दाखवू शकतो – झोपण्यापूर्वी नाइटस्टँड मोड सुरू करा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone hanya boleh menunjukkan cahaya semasa Phase Wake terbuka – mulakan mod meja sisi katil sebelum awak tidur."
          }
        },
        "my": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake ဖွင့်ထားစဉ်သာ iPhone က အလင်း ပြနိုင်သည် – မအိပ်မီ ခေါင်းရင်းစားပွဲ မုဒ်ကို စပါ။"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone kan bare vise lyset mens Phase Wake er åpen – start nattbordmodus før du legger deg."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake खुला हुँदा मात्र iPhone ले प्रकाश देखाउन सक्छ – सुत्नुअघि नाइटस्ट्यान्ड मोड सुरु गर।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je iPhone kan het licht alleen tonen zolang Phase Wake open is – start de nachtkastmodus voordat je gaat slapen."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਤੁਹਾਡਾ iPhone ਸਿਰਫ਼ Phase Wake ਖੁੱਲ੍ਹਾ ਹੋਣ ’ਤੇ ਹੀ ਰੌਸ਼ਨੀ ਦਿਖਾ ਸਕਦਾ ਹੈ – ਸੌਣ ਤੋਂ ਪਹਿਲਾਂ ਨਾਈਟਸਟੈਂਡ ਮੋਡ ਸ਼ੁਰੂ ਕਰੋ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone może pokazywać światło tylko przy otwartym Phase Wake – włącz tryb nocnego stolika przed snem."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O iPhone só pode mostrar a luz enquanto o Phase Wake estiver aberto – inicie o modo de mesa de cabeceira antes de dormir."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O iPhone só pode mostrar a luz enquanto o Phase Wake estiver aberto – inicia o modo de mesa de cabeceira antes de dormires."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone-ul poate arăta lumina doar cât timp Phase Wake este deschis – pornește modul noptieră înainte de culcare."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone может показывать свет, только пока Phase Wake открыт – включи режим прикроватных часов перед сном."
          }
        },
        "si": {
          "stringUnit": {
            "state": "translated",
            "value": "ඔබේ iPhone හට ආලෝකය පෙන්විය හැක්කේ Phase Wake විවෘතව ඇති විට පමණි – නින්දට යාමට පෙර ඇඳ අසල ප්‍රකාරය අරඹන්න."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone vie ukázať svetlo, len kým je Phase Wake otvorený – pred spaním spusti režim nočného stolíka."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone lahko prikaže svetlobo le, dokler je Phase Wake odprt – pred spanjem začni način nočne omarice."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone-i yt mund ta shfaqë dritën vetëm kur Phase Wake është i hapur – nis modalitetin e komodinës para se të flesh."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Твој iPhone може да приказује светло само док је Phase Wake отворен – покрени режим ноћног ормарића пре спавања."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone kan bara visa ljuset medan Phase Wake är öppen – starta nattduksbordsläge innan du somnar."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone yako inaweza kuonyesha mwanga tu Phase Wake ikiwa wazi – anza hali ya meza ya kitanda kabla ya kulala."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake திறந்திருக்கும்போது மட்டுமே உங்கள் iPhone ஒளியைக் காட்ட முடியும் – தூங்கச் செல்லும் முன் படுக்கையோர மேசைப் பயன்முறையைத் தொடங்குங்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake తెరిచి ఉన్నప్పుడు మాత్రమే మీ iPhone వెలుగు చూపగలదు – నిద్రపోయే ముందు నైట్‌స్టాండ్ మోడ్ మొదలుపెట్టండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone แสดงแสงได้ก็ต่อเมื่อเปิด Phase Wake อยู่ – เริ่มโหมดข้างเตียงก่อนเข้านอน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone ışığı yalnızca Phase Wake açıkken gösterebilir – uyumadan önce komodin modunu başlat."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone може показувати світло, лише поки Phase Wake відкритий – увімкни режим нічного столика перед сном."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "تمہارا iPhone روشنی صرف تب دکھا سکتا ہے جب Phase Wake کھلا ہو – سونے سے پہلے نائٹ اسٹینڈ موڈ شروع کرو۔"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone yorugʻlikni faqat Phase Wake ochiq boʻlganda koʻrsata oladi – uxlashdan oldin tungi stol rejimini boshla."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone chỉ hiển thị được ánh sáng khi Phase Wake đang mở – hãy bắt đầu chế độ đầu giường trước khi đi ngủ."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "你的 iPhone 只會在 Phase Wake 開啟時顯示光線 – 請在睡覺前開始床頭模式。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的 iPhone 只有在 Phase Wake 打开时才能显示光线 – 请在睡觉前开始床头模式。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的 iPhone 只有在 Phase Wake 開啟時才能顯示光線 – 請在睡覺前開始床頭模式。"
          }
        },
        "zu": {
          "stringUnit": {
            "state": "translated",
            "value": "I-iPhone yakho ingakhombisa ukukhanya kuphela lapho i-Phase Wake ivuliwe – qala imodi yetafula lasembhedeni ngaphambi kokulala."
          }
        }
      }
    },
