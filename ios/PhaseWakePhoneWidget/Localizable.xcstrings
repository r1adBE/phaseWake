    "history_empty_connect": {
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Nagte uit Samsung Health en ander apps kan ook hier verskyn. Vergelyk met gesondheidsdata om hulle te sien."
          }
        },
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "ከSamsung Health እና ከሌሎች መተግበሪያዎች የመጡ ሌሊቶችም እዚህ ሊታዩ ይችላሉ። ለማየት ከጤና ውሂብ ጋር ያወዳድሩ።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكن أن تظهر هنا أيضًا ليالٍ من Samsung Health وتطبيقات أخرى. لرؤيتها، قارن ببيانات الصحة."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Samsung Health və digər tətbiqlərdən gecələr də burada görünə bilər. Onları görmək üçün sağlamlıq məlumatları ilə müqayisə et."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Тук могат да се появят и нощи от Samsung Health и други приложения. За да ги видиш, сравни със здравните данни."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Samsung Health ও অন্য অ্যাপের রাতগুলোও এখানে দেখা যেতে পারে। দেখতে চাইলে স্বাস্থ্য ডেটার সঙ্গে মেলাও।"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovdje se mogu prikazati i noći iz aplikacije Samsung Health i drugih aplikacija. Da ih vidiš, uporedi sa zdravstvenim podacima."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Aquí també poden aparèixer nits de Samsung Health i altres apps. Per veure-les, compara amb les dades de salut."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zobrazit se tu mohou i noci z aplikace Samsung Health a dalších aplikací. Chceš-li je vidět, porovnej se zdravotními daty."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Nætter fra Samsung Health og andre apps kan også vises her. Sammenlign med sundhedsdata for at se dem."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auch Nächte aus Samsung Health und anderen Apps können hier erscheinen. Dafür mit Gesundheitsdaten abgleichen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Εδώ μπορούν να εμφανίζονται και νύχτες από το Samsung Health και άλλες εφαρμογές. Για να τις δεις, κάνε σύγκριση με τα δεδομένα υγείας."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nights from Samsung Health and other apps can show up here too. To see them, compare with health data."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aquí también pueden aparecer noches de Samsung Health y otras apps. Para verlas, compara con datos de salud."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Siin võivad ilmuda ka ööd rakendusest Samsung Health ja teistest rakendustest. Nende nägemiseks võrdle terviseandmetega."
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "Samsung Health eta beste aplikazio batzuetako gauak ere ager daitezke hemen. Ikusteko, alderatu osasun-datuekin."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "شب‌های Samsung Health و برنامه‌های دیگر هم می‌توانند اینجا نمایش داده شوند. برای دیدنشان، با داده‌های سلامت مقایسه کن."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Täällä voi näkyä myös öitä sovelluksesta Samsung Health ja muista sovelluksista. Näet ne, kun vertaat terveystietoihin."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Puwede ring lumabas dito ang mga gabi mula sa Samsung Health at ibang app. Para makita ang mga ito, ikumpara sa health data."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les nuits de Samsung Health et d'autres apps peuvent aussi apparaître ici. Pour les voir, compare avec les données santé."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Is féidir le hoícheanta ó Samsung Health agus ó aipeanna eile a bheith le feiceáil anseo freisin. Le hiad a fheiceáil, cuir i gcomparáid le sonraí sláinte."
          }
        },
        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aquí tamén poden aparecer noites de Samsung Health e doutras apps. Para velas, compara cos datos de saúde."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "Samsung Health અને અન્ય ઍપની રાતો પણ અહીં દેખાઈ શકે છે. તે જોવા માટે, હેલ્થ ડેટા સાથે સરખાવો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "גם לילות מ־Samsung Health ומאפליקציות אחרות יכולים להופיע כאן. כדי לראות אותם, השוו לנתוני בריאות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Samsung Health और दूसरे ऐप की रातें भी यहाँ दिख सकती हैं। उन्हें देखने के लिए हेल्थ डेटा से मिलान करो।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovdje se mogu prikazati i noći iz aplikacije Samsung Health i drugih aplikacija. Da ih vidiš, usporedi sa zdravstvenim podacima."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Samsung Health és más alkalmazások éjszakái is megjelenhetnek itt. Ha látni szeretnéd őket, vesd össze az egészségügyi adatokkal."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Այստեղ կարող են երևալ նաև Samsung Health-ի և այլ հավելվածների գիշերները։ Դրանք տեսնելու համար համեմատիր առողջության տվյալների հետ։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Malam dari Samsung Health dan aplikasi lain juga bisa muncul di sini. Untuk melihatnya, cocokkan dengan data kesehatan."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Nætur úr Samsung Health og öðrum forritum geta líka birst hér. Berðu saman við heilsugögn til að sjá þær."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Qui possono comparire anche le notti di Samsung Health e di altre app. Per vederle, confronta con i dati di salute."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Samsung Health やほかのアプリの夜もここに表示できます。表示するには、ヘルスデータと照合してください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "აქ შეიძლება გამოჩნდეს Samsung Health-ისა და სხვა აპების ღამეებიც. მათ სანახავად შეადარე ჯანმრთელობის მონაცემებს."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Мұнда Samsung Health және басқа қолданбалардың түндері де көрсетілуі мүмкін. Оларды көру үшін денсаулық деректерімен салыстыр."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "យប់ពី Samsung Health និងកម្មវិធីផ្សេងទៀតក៏អាចបង្ហាញនៅទីនេះដែរ។ ដើម្បីមើលវា សូមប្រៀបធៀបជាមួយទិន្នន័យសុខភាព។"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "Samsung Health ಮತ್ತು ಇತರ ಆ್ಯಪ್‌ಗಳ ರಾತ್ರಿಗಳೂ ಇಲ್ಲಿ ಕಾಣಿಸಬಹುದು. ಅವುಗಳನ್ನು ನೋಡಲು, ಆರೋಗ್ಯ ಡೇಟಾದೊಂದಿಗೆ ಹೋಲಿಸಿ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Samsung Health와 다른 앱의 밤도 여기에 표시될 수 있어요. 보려면 건강 데이터와 비교하세요."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ຄືນຈາກ Samsung Health ແລະ ແອັບອື່ນກໍສາມາດສະແດງຢູ່ນີ້ໄດ້. ເພື່ອເບິ່ງ ໃຫ້ປຽບທຽບກັບຂໍ້ມູນສຸຂະພາບ."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Čia gali būti rodomos ir naktys iš programos Samsung Health bei kitų programų. Kad jas matytum, palygink su sveikatos duomenimis."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Šeit var parādīties arī naktis no lietotnes Samsung Health un citām lietotnēm. Lai tās redzētu, salīdzini ar veselības datiem."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тука може да се појават и ноќи од Samsung Health и други апликации. За да ги видиш, спореди со здравствените податоци."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "Samsung Health-ൽ നിന്നും മറ്റ് ആപ്പുകളിൽ നിന്നുമുള്ള രാത്രികളും ഇവിടെ കാണാം. അവ കാണാൻ, ആരോഗ്യ ഡാറ്റയുമായി താരതമ്യം ചെയ്യുക."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Samsung Health болон бусад аппын шөнүүд ч энд харагдаж болно. Тэдгээрийг харахын тулд эрүүл мэндийн өгөгдөлтэй харьцуул."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "Samsung Health आणि इतर ॲप्समधील रात्रीही इथे दिसू शकतात. त्या पाहण्यासाठी हेल्थ डेटाशी तुलना करा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Malam daripada Samsung Health dan apl lain juga boleh muncul di sini. Untuk melihatnya, banding dengan data kesihatan."
          }
        },
        "my": {
          "stringUnit": {
            "state": "translated",
            "value": "Samsung Health နှင့် အခြားအက်ပ်များမှ ညများကိုလည်း ဤနေရာတွင် ပြနိုင်သည်။ ကြည့်ရန် ကျန်းမာရေးဒေတာနှင့် နှိုင်းယှဉ်ပါ။"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Netter fra Samsung Health og andre apper kan også vises her. Sammenlign med helsedata for å se dem."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "Samsung Health र अन्य एपका रातहरू पनि यहाँ देखिन सक्छन्। तिनलाई हेर्न स्वास्थ्य डेटासँग तुलना गर।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nachten uit Samsung Health en andere apps kunnen hier ook verschijnen. Vergelijk met gezondheidsgegevens om ze te zien."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "Samsung Health ਅਤੇ ਹੋਰ ਐਪਾਂ ਦੀਆਂ ਰਾਤਾਂ ਵੀ ਇੱਥੇ ਦਿਖ ਸਕਦੀਆਂ ਹਨ। ਉਨ੍ਹਾਂ ਨੂੰ ਦੇਖਣ ਲਈ ਸਿਹਤ ਡਾਟੇ ਨਾਲ ਤੁਲਨਾ ਕਰੋ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutaj mogą się też pojawiać noce z aplikacji Samsung Health i innych aplikacji. Aby je zobaczyć, porównaj z danymi zdrowotnymi."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Noites do Samsung Health e de outros apps também podem aparecer aqui. Para vê-las, compare com dados de saúde."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Noites do Samsung Health e de outras apps também podem aparecer aqui. Para as veres, compara com dados de saúde."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Aici pot apărea și nopți din Samsung Health și din alte aplicații. Ca să le vezi, compară cu datele de sănătate."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Здесь могут появляться и ночи из приложения Samsung Health и других приложений. Чтобы их увидеть, включи сверку с данными о здоровье."
          }
        },
        "si": {
          "stringUnit": {
            "state": "translated",
            "value": "Samsung Health සහ වෙනත් යෙදුම්වල රාත්‍රීද මෙහි පෙන්විය හැක. ඒවා බැලීමට, සෞඛ්‍ය දත්ත සමඟ සසඳන්න."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zobraziť sa tu môžu aj noci z aplikácie Samsung Health a ďalších aplikácií. Ak ich chceš vidieť, porovnaj so zdravotnými údajmi."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu se lahko prikažejo tudi noči iz aplikacije Samsung Health in drugih aplikacij. Če jih želiš videti, primerjaj z zdravstvenimi podatki."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Këtu mund të shfaqen edhe net nga Samsung Health dhe aplikacione të tjera. Për t’i parë, krahaso me të dhënat e shëndetit."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Овде се могу приказати и ноћи из апликације Samsung Health и других апликација. Да их видиш, упореди са здравственим подацима."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Nätter från Samsung Health och andra appar kan också visas här. Jämför med hälsodata för att se dem."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Usiku kutoka Samsung Health na programu nyingine unaweza pia kuonekana hapa. Ili kuuona, linganisha na data ya afya."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "Samsung Health மற்றும் பிற ஆப்களின் இரவுகளும் இங்கே தோன்றலாம். அவற்றைப் பார்க்க, ஆரோக்கியத் தரவுடன் ஒப்பிடுங்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "Samsung Health మరియు ఇతర యాప్‌ల రాత్రులు కూడా ఇక్కడ కనిపించవచ్చు. వాటిని చూడటానికి, హెల్త్ డేటాతో పోల్చండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คืนจาก Samsung Health และแอปอื่นก็แสดงที่นี่ได้ หากต้องการดู ให้เปรียบเทียบกับข้อมูลสุขภาพ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Samsung Health ve diğer uygulamalardaki geceler de burada görünebilir. Onları görmek için sağlık verileriyle karşılaştır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тут можуть з'являтися й ночі із застосунку Samsung Health та інших застосунків. Щоб їх побачити, увімкни звіряння з даними про здоров'я."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Samsung Health اور دوسری ایپس کی راتیں بھی یہاں دکھ سکتی ہیں۔ انہیں دیکھنے کے لیے صحت کے ڈیٹا سے موازنہ کرو۔"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu yerda Samsung Health va boshqa ilovalardagi tunlar ham chiqishi mumkin. Ularni koʻrish uchun sogʻliq maʼlumotlari bilan solishtir."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các đêm từ Samsung Health và ứng dụng khác cũng có thể hiện ở đây. Để xem, hãy so sánh với dữ liệu sức khỏe."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "來自 Samsung Health 及其他 App 的晚上也可以在這裏顯示。如要查看，請與健康數據比對。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "来自 Samsung Health 和其他应用的夜晚也可以显示在这里。要查看它们，请与健康数据对比。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "來自 Samsung Health 和其他 App 的夜晚也能顯示在這裡。若要查看，請與健康資料比對。"
          }
        },
        "zu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ubusuku obuvela ku-Samsung Health nakwamanye ama-app nabo bungavela lapha. Ukuze ububone, qhathanisa nedatha yezempilo."
          }
        }
      }
    },
    "history_empty_connect_apple": {
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Nagte uit Apple Health en ander apps kan ook hier verskyn. Vergelyk met gesondheidsdata om hulle te sien."
          }
        },
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "ከApple Health እና ከሌሎች መተግበሪያዎች የመጡ ሌሊቶችም እዚህ ሊታዩ ይችላሉ። ለማየት ከጤና ውሂብ ጋር ያወዳድሩ።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكن أن تظهر هنا أيضًا ليالٍ من Apple Health وتطبيقات أخرى. لرؤيتها، قارن ببيانات الصحة."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Health və digər tətbiqlərdən gecələr də burada görünə bilər. Onları görmək üçün sağlamlıq məlumatları ilə müqayisə et."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Тук могат да се появят и нощи от Apple Health и други приложения. За да ги видиш, сравни със здравните данни."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Health ও অন্য অ্যাপের রাতগুলোও এখানে দেখা যেতে পারে। দেখতে চাইলে স্বাস্থ্য ডেটার সঙ্গে মেলাও।"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovdje se mogu prikazati i noći iz aplikacije Apple Health i drugih aplikacija. Da ih vidiš, uporedi sa zdravstvenim podacima."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Aquí també poden aparèixer nits de Apple Health i altres apps. Per veure-les, compara amb les dades de salut."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zobrazit se tu mohou i noci z aplikace Apple Health a dalších aplikací. Chceš-li je vidět, porovnej se zdravotními daty."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Nætter fra Apple Health og andre apps kan også vises her. Sammenlign med sundhedsdata for at se dem."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auch Nächte aus Apple Health und anderen Apps können hier erscheinen. Dafür mit Gesundheitsdaten abgleichen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Εδώ μπορούν να εμφανίζονται και νύχτες από το Apple Health και άλλες εφαρμογές. Για να τις δεις, κάνε σύγκριση με τα δεδομένα υγείας."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nights from Apple Health and other apps can show up here too. To see them, compare with health data."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aquí también pueden aparecer noches de Apple Health y otras apps. Para verlas, compara con datos de salud."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Siin võivad ilmuda ka ööd rakendusest Apple Health ja teistest rakendustest. Nende nägemiseks võrdle terviseandmetega."
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Health eta beste aplikazio batzuetako gauak ere ager daitezke hemen. Ikusteko, alderatu osasun-datuekin."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "شب‌های Apple Health و برنامه‌های دیگر هم می‌توانند اینجا نمایش داده شوند. برای دیدنشان، با داده‌های سلامت مقایسه کن."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Täällä voi näkyä myös öitä sovelluksesta Apple Health ja muista sovelluksista. Näet ne, kun vertaat terveystietoihin."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Puwede ring lumabas dito ang mga gabi mula sa Apple Health at ibang app. Para makita ang mga ito, ikumpara sa health data."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les nuits de Apple Health et d'autres apps peuvent aussi apparaître ici. Pour les voir, compare avec les données santé."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Is féidir le hoícheanta ó Apple Health agus ó aipeanna eile a bheith le feiceáil anseo freisin. Le hiad a fheiceáil, cuir i gcomparáid le sonraí sláinte."
