          }
        },
        "zu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ubusuku obungu-%1$lld, i-Phase Wake ikala ngewashi lakho ukuze ilungise i-alamu ikufanele. Ligqoke ebusuku nebhethri okungenani elingu-%2$lld %%."
