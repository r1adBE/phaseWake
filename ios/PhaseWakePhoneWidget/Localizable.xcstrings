        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Ionas go dtiocfaidh an t-aláram chun tosaigh fiú agus tú ag úsáid an fhóin."
          }
        },
        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "Para que a alarma apareza diante mesmo mentres usas o teléfono."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "જેથી ફોન વાપરતા હો ત્યારે પણ એલાર્મ એકદમ આગળ દેખાય."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כדי שהשעון המעורר יופיע ממש בחזית גם כשאתם משתמשים בטלפון."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ताकि फ़ोन इस्तेमाल करते समय भी अलार्म बिल्कुल सामने आए।"
