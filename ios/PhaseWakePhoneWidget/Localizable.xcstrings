        },
        "si": {
          "stringUnit": {
            "state": "translated",
            "value": "නිරෝගී වැඩිහිටියන් සඳහා යොමු අගයන් (Ohayon සහ අන්අය, Sleep 2004). ඔරලෝසු අදියර දළ වශයෙන් පමණක් ඇස්තමේන්තු කරයි."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Orientačné hodnoty pre zdravých dospelých (Ohayon a kol., Sleep 2004). Hodinky odhadujú fázy len približne."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Referenčne vrednosti za zdrave odrasle (Ohayon in sod., Sleep 2004). Ure faze ocenijo le približno."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Vlera referuese për të rritur të shëndetshëm (Ohayon et al., Sleep 2004). Orët i vlerësojnë fazat vetëm përafërsisht."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Референтне вредности за здраве одрасле (Ohayon и сар., Sleep 2004). Сатови фазе процењују само оквирно."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Riktvärden för friska vuxna (Ohayon m.fl., Sleep 2004). Klockor uppskattar faserna bara ungefärligt."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Viwango vya marejeleo kwa watu wazima wenye afya (Ohayon na wenzake, Sleep 2004). Saa hukadiria hatua za usingizi kwa takriban tu."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஆரோக்கியமான பெரியவர்களுக்கான குறிப்பு மதிப்புகள் (Ohayon மற்றும் பலர், Sleep 2004). வாட்சுகள் நிலைகளைத் தோராயமாக மட்டுமே மதிப்பிடுகின்றன."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఆరోగ్యవంతులైన పెద్దలకు సూచన విలువలు (Ohayon మరియు ఇతరులు, Sleep 2004). వాచ్‌లు దశలను సుమారుగా మాత్రమే అంచనా వేస్తాయి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ค่าอ้างอิงสำหรับผู้ใหญ่ที่สุขภาพดี (Ohayon และคณะ, Sleep 2004) นาฬิกาประเมินระยะการนอนได้เพียงคร่าว ๆ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sağlıklı yetişkinler için referans değerler (Ohayon ve ark., Sleep 2004). Saatler evreleri yalnızca kabaca tahmin eder."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Орієнтовні значення для здорових дорослих (Ohayon та ін., Sleep 2004). Годинники оцінюють фази лише приблизно."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "صحت مند بالغوں کے لیے حوالہ اقدار (Ohayon وغیرہ، Sleep 2004)۔ گھڑیاں مراحل کا صرف موٹا اندازہ لگاتی ہیں۔"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Sogʻlom kattalar uchun moʻljal qiymatlari (Ohayon va boshq., Sleep 2004). Soatlar bosqichlarni faqat taxminan baholaydi."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giá trị tham chiếu cho người trưởng thành khỏe mạnh (Ohayon và cộng sự, Sleep 2004). Đồng hồ chỉ ước tính các giai đoạn một cách tương đối."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "健康成年人的參考範圍（Ohayon 等，Sleep 2004）。手錶只能粗略估算睡眠階段。"
