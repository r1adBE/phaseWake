          "stringUnit": {
            "state": "translated",
            "value": "ಚಿಕ್ಕ ಕ್ಲಿಪ್‌ಗಳು ಮಾತ್ರ. ಅವು ನಿಮ್ಮ ಫೋನ್‌ನಲ್ಲೇ ಇರುತ್ತವೆ ಮತ್ತು 7 ದಿನಗಳ ನಂತರ ಅಳಿಸಲಾಗುತ್ತವೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "짧은 조각만 저장해요. 휴대폰에만 남고 7일 뒤 삭제돼요."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ສະເພາະຄລິບສັ້ນ ຢູ່ໃນໂທລະສັບຂອງເຈົ້າ ແລະ ຖືກລຶບຫຼັງ 7 ມື້"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik trumpi įrašai. Jie lieka tavo telefone ir ištrinami po 7 dienų."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tikai īsi fragmenti. Tie paliek tavā tālrunī un tiek dzēsti pēc 7 dienām."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Само кратки снимки. Остануваат на телефонот и се бришат по 7 дена."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ചെറിയ ക്ലിപ്പുകൾ മാത്രം. അവ ഫോണിൽ തന്നെ ഇരിക്കും, 7 ദിവസത്തിനു ശേഷം ഇല്ലാതാകും."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Зөвхөн богино хэсгүүд. Утсан дээр чинь үлдэж, 7 хоногийн дараа устна."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "फक्त छोट्या क्लिप. त्या तुमच्या फोनवरच राहतात आणि ७ दिवसांनी हटवल्या जातात."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya keratan pendek. Kekal di telefon anda dan dipadam selepas 7 hari."
          }
        },
        "my": {
          "stringUnit": {
            "state": "translated",
            "value": "အတိုလေးများသာ။ သင့်ဖုန်းပေါ်တွင်သာ ရှိပြီး 7 ရက်အကြာတွင် ဖျက်သည်။"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bare korte klipp. De blir på telefonen og slettes etter 7 dager."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "छोटा क्लिप मात्र। यी तिम्रो फोनमै रहन्छन् र ७ दिनपछि मेटिन्छन्।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alleen korte fragmenten. Ze blijven op je telefoon en worden na 7 dagen gewist."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਸਿਰਫ਼ ਛੋਟੀਆਂ ਕਲਿੱਪਾਂ। ਇਹ ਤੁਹਾਡੇ ਫ਼ੋਨ ’ਤੇ ਹੀ ਰਹਿੰਦੀਆਂ ਹਨ ਅਤੇ 7 ਦਿਨਾਂ ਬਾਅਦ ਮਿਟ ਜਾਂਦੀਆਂ ਹਨ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tylko krótkie fragmenty. Zostają na telefonie i są usuwane po 7 dniach."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Só trechos curtos. Ficam no seu celular e são apagados depois de 7 dias."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Só excertos curtos. Ficam no teu telemóvel e são apagados ao fim de 7 dias."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Doar fragmente scurte. Rămân pe telefon și se șterg după 7 zile."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Только короткие фрагменты. Они остаются на телефоне и удаляются через 7 дней."
          }
        },
        "si": {
          "stringUnit": {
            "state": "translated",
            "value": "කෙටි කොටස් පමණි. ඒවා ඔබේ දුරකථනයේම පවතින අතර දින 7 කට පසු මැකේ."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Iba krátke záznamy. Zostávajú v telefóne a po 7 dňoch sa vymažú."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Samo kratki posnetki. Ostanejo na telefonu in se po 7 dneh izbrišejo."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Vetëm fragmente të shkurtra. Mbeten në telefon dhe fshihen pas 7 ditësh."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Само кратки исечци. Остају на твом телефону и бришу се после 7 дана."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Bara korta klipp. De stannar på telefonen och raderas efter 7 dagar."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Vipande vifupi tu. Vinabaki kwenye simu yako na hufutwa baada ya siku 7."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "சிறு கிளிப்புகள் மட்டும். அவை உங்கள் ஃபோனிலேயே இருக்கும், 7 நாட்களுக்குப் பிறகு நீக்கப்படும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "చిన్న క్లిప్‌లు మాత్రమే. అవి మీ ఫోన్‌లోనే ఉంటాయి, 7 రోజుల తర్వాత తొలగిపోతాయి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เก็บแค่ช่วงสั้น ๆ อยู่ในโทรศัพท์และลบหลัง 7 วัน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca kısa parçalar. Telefonunda kalır ve 7 gün sonra silinir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Лише короткі фрагменти. Вони залишаються на телефоні й видаляються через 7 днів."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "صرف چھوٹے کلپس۔ یہ تمہارے فون پر رہتے ہیں اور 7 دن بعد حذف ہو جاتے ہیں۔"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Faqat qisqa parchalar. Ular telefoningda qoladi va 7 kundan keyin oʻchiriladi."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ những đoạn ngắn. Chúng ở lại trên điện thoại và bị xóa sau 7 ngày."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "只錄短片段。片段留在你的手機上，7 日後刪除。"
