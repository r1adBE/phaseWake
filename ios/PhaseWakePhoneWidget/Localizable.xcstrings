        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Телефонды қолданып отырсаң да, оятқыш ең алдыңғы жақта көрінуі үшін."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ដើម្បីឲ្យម៉ោងរោទ៍បង្ហាញនៅខាងមុខបង្អស់ ទោះបីអ្នកកំពុងប្រើទូរសព្ទក៏ដោយ។"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಫೋನ್ ಬಳಸುತ್ತಿರುವಾಗಲೂ ಅಲಾರಾಂ ಎಲ್ಲಕ್ಕಿಂತ ಮುಂದೆ ಕಾಣಿಸಲು."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "휴대폰을 사용하는 중에도 알람이 맨 앞에 나타나도록 해요."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ເພື່ອໃຫ້ໂມງປຸກສະແດງຢູ່ທາງໜ້າສຸດ ເຖິງວ່າເຈົ້າກຳລັງໃຊ້ໂທລະສັບຢູ່"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Kad žadintuvas atsirastų pačiame priekyje, net kai naudojiesi telefonu."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lai modinātājs parādītos pašā priekšā arī tad, kad izmanto tālruni."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "За алармот да се појави најнапред и додека го користиш телефонот."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഫോൺ ഉപയോഗിക്കുമ്പോഴും അലാറം ഏറ്റവും മുന്നിൽ വരാൻ."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Утсаа ашиглаж байхад ч сэрүүлэг хамгийн урд гарч ирэхийн тулд."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "फोन वापरत असतानाही अलार्म अगदी समोर यावा म्हणून."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Supaya penggera muncul paling hadapan walaupun awak sedang menggunakan telefon."
          }
        },
        "my": {
          "stringUnit": {
            "state": "translated",
            "value": "ဖုန်းသုံးနေစဉ်မှာပင် နှိုးစက်သည် ရှေ့ဆုံးတွင် ပေါ်လာစေရန်။"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Så alarmen kommer helt frem, også mens du bruker telefonen."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "फोन चलाइरहेको बेला पनि अलार्म एकदमै अगाडि आओस् भन्नका लागि।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zodat de wekker helemaal vooraan verschijnt, ook terwijl je je telefoon gebruikt."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਤਾਂ ਜੋ ਫ਼ੋਨ ਵਰਤਦੇ ਸਮੇਂ ਵੀ ਅਲਾਰਮ ਬਿਲਕੁਲ ਸਾਹਮਣੇ ਆਵੇ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aby budzik pojawiał się na samym przodzie, nawet gdy używasz telefonu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para que o alarme apareça na frente mesmo enquanto você usa o celular."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Para que o alarme apareça à frente mesmo enquanto usas o telemóvel."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ca alarma să apară în prim-plan chiar și când folosești telefonul."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чтобы будильник появлялся на переднем плане, даже когда ты пользуешься телефоном."
          }
        },
        "si": {
          "stringUnit": {
            "state": "translated",
            "value": "දුරකථනය භාවිත කරන අතරතුරත් එලාමය ඉදිරියෙන්ම පෙනෙන්නට."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Aby sa budík zobrazil úplne vpredu, aj keď práve používaš telefón."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Da se budilka prikaže čisto spredaj, tudi ko uporabljaš telefon."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Që alarmi të dalë krejt përpara edhe kur je duke përdorur telefonin."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Да би се аларм приказао скроз напред и док користиш телефон."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Så att alarmet kommer längst fram även medan du använder telefonen."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Ili kengele ionekane mbele kabisa hata unapotumia simu."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஃபோனைப் பயன்படுத்தும்போதும் அலாரம் எல்லாவற்றுக்கும் முன்னால் தோன்ற."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఫోన్ వాడుతున్నప్పుడు కూడా అలారం అన్నిటికంటే ముందు కనిపించేలా."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เพื่อให้นาฬิกาปลุกแสดงขึ้นด้านหน้าสุดแม้ขณะที่คุณใช้โทรศัพท์อยู่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Telefonu kullanırken bile alarm en önde görünsün diye."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Щоб будильник з’являвся на передньому плані, навіть коли ти користуєшся телефоном."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "تاکہ فون استعمال کرتے ہوئے بھی الارم بالکل سامنے آئے۔"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Telefondan foydalanayotganingda ham budilnik eng oldinda chiqishi uchun."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Để báo thức hiện ra ngay phía trước kể cả khi bạn đang dùng điện thoại."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "這樣即使你正在使用手機，鬧鐘也會在最前面顯示。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这样即使你正在使用手机，闹钟也会显示在最前面。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這樣即使你正在使用手機，鬧鐘也會顯示在最前面。"
          }
        },
        "zu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ukuze i-alamu ivele phambili ngisho nalapho usebenzisa ifoni."
          }
        }
      }
    },
