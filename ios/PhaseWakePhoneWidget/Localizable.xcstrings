    "editor_sleep_hint": {
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Tel vanaf wanneer jy aan die slaap raak. Jou horlosie bespeur dit outomaties; tik “Goeienag” op die horlosie om dadelik te begin."
          }
        },
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "ከተኙበት ጊዜ ጀምሮ ይቆጥራል። ሰዓትዎ በራስ-ሰር ይለየዋል፤ ወዲያውኑ ለመጀመር በሰዓቱ ላይ «ደህና እደሩ»ን ይንኩ።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يبدأ العدّ من لحظة نومكم. تكتشف ساعتكم ذلك تلقائيًا؛ اضغطوا على “ليلة سعيدة” في الساعة للبدء فورًا."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Yuxuya getdiyin andan sayır. Saatın bunu avtomatik aşkarlayır; dərhal başlamaq üçün saatda “Gecən xeyrə” düyməsinə toxun."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Отброява се от заспиването. Часовникът го разпознава автоматично; докосни „Лека нощ“ на часовника, за да започне веднага."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ঘুমিয়ে পড়ার সময় থেকে গোনা হয়। ঘড়ি নিজেই তা শনাক্ত করে; এখনই শুরু করতে ঘড়িতে “শুভরাত্রি” ট্যাপ করো।"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Broji od trenutka kad zaspiš. Sat to prepoznaje automatski; dodirni „Laku noć“ na satu da odmah počne."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Compta des que t’adorms. El rellotge ho detecta automàticament; toca «Bona nit» al rellotge per començar ara mateix."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Počítá se od usnutí. Hodinky ho poznají automaticky; klepnutím na „Dobrou noc“ na hodinkách začneš hned."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tæller fra du falder i søvn. Uret registrerer det automatisk; tryk på »Godnat« på uret for at starte med det samme."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zählt ab dem Einschlafen. Die Uhr erkennt es automatisch; mit «Gute Nacht» auf der Uhr startet sie sofort."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μετράει από τη στιγμή που αποκοιμιέσαι. Το ρολόι το αναγνωρίζει αυτόματα· πάτα «Καληνύχτα» στο ρολόι για να ξεκινήσει αμέσως."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Counts from when you fall asleep. Your watch detects it automatically; tap “Good night” on the watch to start right away."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuenta desde que te duermes. Tu reloj lo detecta automáticamente; toca «Buenas noches» en el reloj para empezar ya."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Loeb uinumisest alates. Kell tuvastab selle automaatselt; puuduta kellal „Head ööd“, et kohe alustada."
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "Lokartzen zarenetik kontatzen du. Erlojuak automatikoki hautematen du; sakatu «Gabon» erlojuan berehala hasteko."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "از لحظهٔ به خواب رفتنت شمرده می‌شود. ساعتت آن را خودکار تشخیص می‌دهد؛ برای شروع فوری، روی ساعت «شب بخیر» را بزن."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Laskee nukahtamisesta alkaen. Kello tunnistaa sen automaattisesti; napauta kellossa ”Hyvää yötä”, niin se alkaa heti."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Bibilang mula nang makatulog ka. Awtomatiko itong natutukoy ng relo mo; i-tap ang “Matutulog na” sa relo para magsimula agad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Compte à partir de l’endormissement. Ta montre le détecte automatiquement ; appuie sur « Bonne nuit » sur la montre pour démarrer tout de suite."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Áirítear ón am a thiteann tú i do chodladh. Aithníonn an t-uaireadóir é go huathoibríoch; tapáil “Oíche mhaith” ar an uaireadóir chun tosú láithreach."
          }
        },
        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "Conta desde que adormeces. O reloxo detéctao automaticamente; toca «Boas noites» no reloxo para comezar xa."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તમે ઊંઘી જાઓ ત્યારથી ગણે છે. ઘડિયાળ તે આપમેળે ઓળખે છે; તરત શરૂ કરવા ઘડિયાળ પર “શુભ રાત્રિ” ટૅપ કરો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הספירה מתחילה מההירדמות. השעון מזהה זאת אוטומטית; הקישו על “לילה טוב” בשעון כדי להתחיל מיד."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सोने के समय से गिनती होती है। घड़ी इसे अपने आप पहचान लेती है; तुरंत शुरू करने के लिए घड़ी पर “शुभ रात्रि” दबाओ।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Broji od trenutka kad zaspiš. Sat to prepoznaje automatski; dodirni „Laku noć“ na satu da odmah počne."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az elalvástól számít. Az óra automatikusan felismeri; koppints az órán a „Jó éjszakát” gombra, és azonnal indul."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Հաշվում է քնելու պահից։ Ժամացույցն այն ինքնաշխատ է ճանաչում. անմիջապես սկսելու համար ժամացույցում հպիր «Բարի գիշեր»։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Dihitung sejak kamu tertidur. Jam tanganmu mendeteksinya otomatis; ketuk “Selamat tidur” di jam untuk langsung mulai."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Telur frá því að þú sofnar. Úrið greinir það sjálfkrafa; ýttu á „Góða nótt“ á úrinu til að byrja strax."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Conta da quando ti addormenti. Lo smartwatch lo rileva in automatico; tocca «Buonanotte» sullo smartwatch per iniziare subito."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "眠りについた時点から数えます。ウォッチが自動で検出します。すぐに始めるにはウォッチで「おやすみ」をタップしてください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ითვლის ჩაძინების მომენტიდან. საათი ამას ავტომატურად ცნობს; დაუყოვნებლივ დასაწყებად შეეხე საათზე „ძილი ნებისა“."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ұйықтап кеткен сәттен бастап санайды. Сағат оны автоматты түрде анықтайды; бірден бастау үшін сағаттағы «Қайырлы түн» түймесін түрт."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "រាប់ចាប់ពីពេលអ្នកលង់លក់។ នាឡិការកឃើញដោយស្វ័យប្រវត្តិ ចុច «រាត្រីសួស្តី» លើនាឡិកាដើម្បីចាប់ផ្ដើមភ្លាម។"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನೀವು ನಿದ್ರೆಗೆ ಜಾರಿದಾಗಿನಿಂದ ಎಣಿಸುತ್ತದೆ. ವಾಚ್ ಅದನ್ನು ಸ್ವಯಂಚಾಲಿತವಾಗಿ ಗುರುತಿಸುತ್ತದೆ; ಕೂಡಲೇ ಶುರು ಮಾಡಲು ವಾಚ್‌ನಲ್ಲಿ “ಶುಭ ರಾತ್ರಿ” ಟ್ಯಾಪ್ ಮಾಡಿ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "잠든 순간부터 계산해요. 워치가 자동으로 감지하며, 바로 시작하려면 워치에서 “잘 자요”를 탭하세요."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ນັບຕັ້ງແຕ່ເຈົ້າຫຼັບ ໂມງກວດພົບໄດ້ເອງ; ແຕະ “ລາຕີສະຫວັດ” ຢູ່ໂມງເພື່ອເລີ່ມທັນທີ"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Skaičiuojama nuo užmigimo. Laikrodis tai atpažįsta automatiškai; bakstelėk laikrodyje „Labanakt“, kad pradėtum iškart."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Skaita no aizmigšanas brīža. Pulkstenis to nosaka automātiski; pieskaries pulkstenī „Ar labu nakti“, lai sāktu uzreiz."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Брои од моментот кога ќе заспиеш. Часовникот го препознава автоматски; допри „Добра ноќ“ на часовникот за да почне веднаш."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഉറങ്ങിത്തുടങ്ങുമ്പോൾ മുതൽ എണ്ണുന്നു. വാച്ച് അത് സ്വയം തിരിച്ചറിയും; ഉടൻ തുടങ്ങാൻ വാച്ചിൽ “ശുഭരാത്രി” ടാപ്പ് ചെയ്യുക."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Унтсан цагаас чинь тоолно. Цаг үүнийг автоматаар илрүүлнэ; шууд эхлүүлэхийн тулд цаган дээрээ «Сайхан амраарай»-г дар."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुम्हाला झोप लागल्यापासून मोजते. घड्याळ ते आपोआप ओळखते; लगेच सुरू करण्यासाठी घड्याळावर “शुभ रात्री” वर टॅप करा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Dikira dari saat awak tertidur. Jam tangan mengesannya secara automatik; ketik “Selamat malam” pada jam untuk mula serta-merta."
          }
        },
        "my": {
          "stringUnit": {
            "state": "translated",
            "value": "အိပ်ပျော်ချိန်မှစ၍ ရေတွက်သည်။ နာရီက အလိုအလျောက် သိရှိသည်၊ ချက်ချင်းစရန် နာရီပေါ်တွင် “ကောင်းသောညပါ” ကို တို့ပါ။"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Teller fra du sovner. Klokka oppdager det automatisk; trykk på «God natt» på klokka for å starte med en gang."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "तिमी निदाएदेखि गनिन्छ। घडीले यो आफैँ पत्ता लगाउँछ; तुरुन्तै सुरु गर्न घडीमा “शुभ रात्रि” थिच।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Telt vanaf het moment dat je in slaap valt. Je horloge herkent het automatisch; tik op het horloge op “Welterusten” om meteen te starten."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਤੁਹਾਡੇ ਸੌਂ ਜਾਣ ਤੋਂ ਗਿਣਦਾ ਹੈ। ਘੜੀ ਇਸਨੂੰ ਆਪਣੇ-ਆਪ ਪਛਾਣਦੀ ਹੈ; ਤੁਰੰਤ ਸ਼ੁਰੂ ਕਰਨ ਲਈ ਘੜੀ ’ਤੇ “ਸ਼ੁਭ ਰਾਤ” ’ਤੇ ਟੈਪ ਕਰੋ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Liczy od zaśnięcia. Zegarek wykrywa to automatycznie; dotknij „Dobranoc” na zegarku, aby zacząć od razu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Conta a partir de quando você adormece. O relógio detecta isso automaticamente; toque em “Boa noite” no relógio para começar na hora."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Conta a partir de quando adormeces. O relógio deteta-o automaticamente; toca em “Boa noite” no relógio para começar já."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Numără de când adormi. Ceasul detectează automat; atinge „Noapte bună” pe ceas ca să înceapă imediat."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отсчёт идёт с момента засыпания. Часы определяют его автоматически; нажми «Спокойной ночи» на часах, чтобы начать сразу."
          }
        },
        "si": {
          "stringUnit": {
            "state": "translated",
            "value": "ඔබ නින්දට ගිය මොහොතේ සිට ගණන් කරයි. ඔරලෝසුව එය ස්වයංක්‍රීයව හඳුනා ගනී; වහාම ආරම්භ කිරීමට ඔරලෝසුවේ “සුබ රාත්‍රියක්” තට්ටු කරන්න."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Počíta sa od zaspatia. Hodinky ho rozpoznajú automaticky; ťuknutím na „Dobrú noc“ na hodinkách začneš hneď."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Šteje od trenutka, ko zaspiš. Ura to zazna samodejno; tapni »Lahko noč« na uri, da začne takoj."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Numëron që kur të zë gjumi. Ora e dallon automatikisht; prek „Natën e mirë“ në orë për të nisur menjëherë."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Броји од тренутка када заспиш. Сат то препознаје аутоматски; додирни „Лаку ноћ“ на сату да одмах почне."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Räknas från att du somnar. Klockan känner av det automatiskt; tryck på ”Godnatt” på klockan för att starta direkt."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Huhesabu tangu unapolala. Saa yako hulitambua kiotomatiki; gusa “Usiku mwema” kwenye saa ili kuanza mara moja."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நீங்கள் தூங்கியதிலிருந்து கணக்கிடும். வாட்ச் அதைத் தானாகக் கண்டறியும்; உடனே தொடங்க வாட்ச்சில் “இனிய இரவு” என்பதைத் தட்டுங்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీరు నిద్రపోయినప్పటి నుంచి లెక్కిస్తుంది. వాచ్ దాన్ని ఆటోమేటిక్‌గా గుర్తిస్తుంది; వెంటనే మొదలుపెట్టడానికి వాచ్‌లో “శుభ రాత్రి” నొక్కండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "นับตั้งแต่คุณหลับ นาฬิกาตรวจจับได้เอง แตะ “ราตรีสวัสดิ์” บนนาฬิกาเพื่อเริ่มทันที"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uykuya daldığın andan itibaren sayar. Saatin bunu otomatik algılar; hemen başlatmak için saatte “İyi geceler”e dokun."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відлік іде від моменту засинання. Годинник визначає його автоматично; натисни «На добраніч» на годиннику, щоб почати одразу."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "تمہارے سونے کے وقت سے گنتی ہوتی ہے۔ گھڑی اسے خود پہچان لیتی ہے؛ فوراً شروع کرنے کے لیے گھڑی پر “شب بخیر” پر ٹیپ کرو۔"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Uxlab qolganingdan boshlab hisoblaydi. Soat buni avtomatik aniqlaydi; darhol boshlash uchun soatda «Xayrli tun» tugmasini bos."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tính từ lúc bạn ngủ. Đồng hồ tự động nhận biết; chạm vào “Ngủ ngon” trên đồng hồ để bắt đầu ngay."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "由你入睡時開始計時。手錶會自動偵測；在手錶上點按「晚安」即可立即開始。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从你入睡时开始计时。手表会自动识别；在手表上点按“晚安”即可立即开始。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "從你入睡時開始計時。手錶會自動辨識；在手錶上點選「晚安」即可立即開始。"
          }
        },
        "zu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ibala kusukela lapho ulala. Iwashi lakho likubona ngokuzenzakalelayo; thepha “Ulale kahle” ewashini ukuze uqale ngokushesha."
          }
        }
      }
    },
    "editor_sleep_hint_apple": {
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Tel vanaf wanneer jy aan die slaap raak – tik “Goeienag” op jou horlosie wanneer jy gaan slaap. Op die Apple Watch skat Phase Wake wanneer jy aan die slaap raak uit jou aangeleerde insluimertyd. Sonder die tik geld die ingestelde tyd."
          }
        },
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "ከተኛህበት ጊዜ ይቆጠራል – ስትተኛ በሰዓትህ ላይ «ደህና እደሩ»ን ንካ። በApple Watch ላይ Phase Wake መቼ እንደምትተኛ ከተማረው ለመተኛት የሚወስድብህ ጊዜ ይገምታል። ሳትነካ ከቀረህ የተቀመጠው ሰዓት ይሠራል።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُحسب من وقت نومك – اضغط «ليلة سعيدة» على الساعة عندما تذهب إلى السرير. على Apple Watch يقدّر Phase Wake وقت نومك من مدة الخلود إلى النوم التي تعلّمها. دون الضغط يسري الوقت المضبوط."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Yuxuya getdiyin andan sayılır – yatanda saatda «Gecən xeyrə» toxun. Apple Watch-da Phase Wake yuxuya getmə vaxtını öyrəndiyi yuxuya getmə müddətinə görə təxmin edir. Toxunmasan, qurulmuş vaxt keçərlidir."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Отброява се от заспиването – докосни „Лека нощ“ на часовника, когато си лягаш. На Apple Watch Phase Wake преценява кога заспиваш по наученото ти време за заспиване. Без докосване важи зададеното време."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ঘুমিয়ে পড়ার সময় থেকে গোনা হয় – শুতে যাওয়ার সময় ঘড়িতে «শুভরাত্রি» চাপো। Apple Watch-এ Phase Wake তোমার শেখা ঘুমিয়ে পড়ার সময় থেকে অনুমান করে তুমি কখন ঘুমিয়ে পড়ো। না চাপলে সেট করা সময়ই প্রযোজ্য।"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Računa se od uspavljivanja – dodirni „Laku noć“ na satu kada ideš u krevet. Na Apple Watchu Phase Wake procjenjuje kada zaspiš na osnovu tvog naučenog vremena uspavljivanja. Bez dodira vrijedi postavljeno vrijeme."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Compta des que t’adorms – toca «Bona nit» al rellotge quan te’n vagis al llit. A l’Apple Watch, Phase Wake estima quan t’adorms a partir del temps per adormir-te que ha après. Sense tocar-lo, val l’hora definida."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Počítá se od usnutí – když jdeš spát, klepni na hodinkách na „Dobrou noc“. Na Apple Watch odhaduje Phase Wake, kdy usneš, podle tvé naučené doby usínání. Bez klepnutí platí nastavený čas."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tæller fra, når du falder i søvn – tryk på “Godnat” på uret, når du går i seng. På Apple Watch anslår Phase Wake, hvornår du falder i søvn, ud fra din lærte indsovningstid. Uden tryk gælder det indstillede tidspunkt."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zählt ab dem Einschlafen – tippe beim Zubettgehen auf der Uhr auf «Gute Nacht». Auf der Apple Watch schätzt Phase Wake die Einschlafzeit aus deiner gelernten Einschlafdauer. Ohne Tippen gilt die eingestellte Uhrzeit."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μετρά από τη στιγμή που αποκοιμιέσαι – πάτησε «Καληνύχτα» στο ρολόι όταν πας για ύπνο. Στο Apple Watch, το Phase Wake εκτιμά πότε αποκοιμιέσαι από τον χρόνο αποκοίμισης που έχει μάθει. Χωρίς πάτημα ισχύει η ώρα που έχεις ορίσει."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Counts from when you fall asleep – tap “Good night” on your watch when you go to bed. On Apple Watch, Phase Wake estimates when you fall asleep from your learned time to fall asleep. Without the tap, the set time applies."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuenta desde que te duermes: toca «Buenas noches» en el reloj al acostarte. En el Apple Watch, Phase Wake estima cuándo te duermes a partir del tiempo en dormirte que ha aprendido. Si no lo tocas, se aplica la hora configurada."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Loetakse uinumisest – puuduta magama minnes kellal „Head ööd“. Apple Watchil hindab Phase Wake sinu uinumise aega õpitud uinumisaja põhjal. Puudutuseta kehtib määratud aeg."
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "Lokartzen zarenetik zenbatzen da – sakatu «Gabon» erlojuan ohera zoazenean. Apple Watch-en, Phase Wake-k noiz lokartzen zaren kalkulatzen du ikasitako lokartzeko denboratik. Sakatu gabe, ezarritako ordua aplikatzen da."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "از زمان به خواب رفتن حساب می‌شود – هنگام رفتن به رختخواب روی ساعت «شب بخیر» را بزن. روی Apple Watch، Phase Wake زمان به خواب رفتنت را از مدت به خواب رفتنی که آموخته تخمین می‌زند. اگر نزنی، زمان تنظیم‌شده اعمال می‌شود."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lasketaan nukahtamisesta – napauta kellosta ”Hyvää yötä”, kun menet nukkumaan. Apple Watchissa Phase Wake arvioi nukahtamisesi ajankohdan oppimasi nukahtamisajan perusteella. Ilman napautusta käytetään asetettua aikaa."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Binibilang mula nang makatulog ka – i-tap ang “Matutulog na” sa iyong relo kapag matutulog ka na. Sa Apple Watch, tinatantya ng Phase Wake kung kailan ka makakatulog batay sa natutunang tagal ng iyong pagkakatulog. Kung walang tap, ang nakatakdang oras ang masusunod."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Compte à partir de l’endormissement – appuie sur « Bonne nuit » sur ta montre en te couchant. Sur l’Apple Watch, Phase Wake estime l’heure à laquelle tu t’endors à partir de ta durée d’endormissement apprise. Sans appui, l’heure réglée s’applique."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Áirítear ón am a dtiteann tú i do chodladh – tapáil “Oíche mhaith” ar d’uaireadóir nuair a théann tú a luí. Ar an Apple Watch, measann Phase Wake cathain a thiteann tú i do chodladh ón am titim i do chodladh atá foghlamtha aige. Gan an tapáil, beidh an t-am socraithe i bhfeidhm."
          }
        },
        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "Conta desde que adormeces: toca «Boas noites» no reloxo ao deitarte. No Apple Watch, Phase Wake estima cando adormeces a partir do tempo para durmir que aprendeu. Se non o tocas, aplícase a hora configurada."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ઊંઘી જાઓ ત્યારથી ગણાય છે – સૂવા જાઓ ત્યારે ઘડિયાળ પર «શુભ રાત્રિ» ટૅપ કરો. Apple Watch પર Phase Wake શીખેલા ઊંઘ આવવાના સમય પરથી તમે ક્યારે ઊંઘી જાઓ છો તેનો અંદાજ લગાવે છે. ટૅપ ન કરો તો સેટ કરેલો સમય લાગુ થાય છે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "נספר מרגע ההירדמות – הקישו על ״לילה טוב״ בשעון כשאתם הולכים לישון. ב-Apple Watch, Phase Wake מעריך מתי נרדמתם לפי זמן ההירדמות שנלמד. בלי הקשה חלה השעה שהוגדרה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नींद आने के समय से गिना जाता है – सोने जाते समय घड़ी पर «शुभ रात्रि» टैप करें। Apple Watch पर Phase Wake सीखे गए नींद आने के समय से अनुमान लगाता है कि आप कब सो जाते हैं। टैप न करने पर सेट किया गया समय लागू होता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Računa se od uspavljivanja – dodirni „Laku noć” na satu kad ideš u krevet. Na Apple Watchu Phase Wake procjenjuje kada zaspiš prema tvom naučenom vremenu uspavljivanja. Bez dodira vrijedi postavljeno vrijeme."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az elalvástól számít – lefekvéskor koppints az órán a „Jó éjszakát” gombra. Az Apple Watchon a Phase Wake a megtanult elalvási idődből becsüli meg, mikor alszol el. Koppintás nélkül a beállított idő érvényes."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Հաշվվում է քնելու պահից – պառկելիս ժամացույցի վրա հպիր «Բարի գիշեր»։ Apple Watch-ում Phase Wake-ը գնահատում է, թե երբ ես քնում, քո սովորած քնելու ժամանակից։ Առանց հպման գործում է սահմանված ժամը։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Dihitung sejak kamu tertidur – ketuk “Selamat tidur” di jam saat kamu tidur. Di Apple Watch, Phase Wake memperkirakan kapan kamu tertidur dari waktu untuk tertidur yang sudah dipelajarinya. Tanpa ketukan, waktu yang diatur yang berlaku."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Telst frá því að þú sofnar – ýttu á „Góða nótt“ á úrinu þegar þú ferð að sofa. Á Apple Watch áætlar Phase Wake hvenær þú sofnar út frá lærðum tíma sem það tekur þig að sofna. Án þess gildir stilltur tími."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Conta da quando ti addormenti – tocca «Buonanotte» sull’orologio quando vai a letto. Su Apple Watch, Phase Wake stima quando ti addormenti in base al tempo per addormentarti che ha imparato. Senza il tocco vale l’orario impostato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "眠りについた時点から数えます。寝るときにウォッチで「おやすみ」をタップしてください。Apple Watchでは、Phase Wakeが学習した入眠までの時間から寝付いた時刻を推定します。タップしない場合は設定した時刻になります。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ითვლება ჩაძინებიდან – დაწოლისას საათზე შეეხე «ძილი ნებისა»-ს. Apple Watch-ზე Phase Wake ჩაძინების დროს ნასწავლი ჩაძინების ხანგრძლივობით აფასებს. შეხების გარეშე მოქმედებს დაყენებული დრო."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ұйықтап кеткен сәттен бастап есептеледі – төсекке жатқанда сағаттан «Қайырлы түн» түймесін түрт. Apple Watch-та Phase Wake қашан ұйықтап кететініңді үйренген ұйықтап кету уақытыңнан бағалайды. Түртпесең, орнатылған уақыт қолданылады."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "រាប់ពីពេលអ្នកដេកលក់ – ចុច «រាត្រីសួស្តី» នៅលើនាឡិកា ពេលអ្នកចូលគេង។ នៅលើ Apple Watch, Phase Wake ប៉ាន់ស្មានពេលដែលអ្នកលង់លក់ ពីរយៈពេលលង់លក់ដែលវាបានរៀន។ បើមិនចុច ពេលវេលាដែលបានកំណត់នឹងត្រូវប្រើ។"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನಿದ್ರೆಗೆ ಜಾರಿದಾಗಿನಿಂದ ಎಣಿಸಲಾಗುತ್ತದೆ – ಮಲಗುವಾಗ ವಾಚ್‌ನಲ್ಲಿ «ಶುಭ ರಾತ್ರಿ» ಟ್ಯಾಪ್ ಮಾಡಿ. Apple Watch ನಲ್ಲಿ Phase Wake ಕಲಿತ ನಿದ್ರೆ ಬರಲು ಬೇಕಾದ ಸಮಯದಿಂದ ನೀವು ಯಾವಾಗ ನಿದ್ರಿಸುತ್ತೀರಿ ಎಂದು ಅಂದಾಜಿಸುತ್ತದೆ. ಟ್ಯಾಪ್ ಮಾಡದಿದ್ದರೆ ಹೊಂದಿಸಿದ ಸಮಯ ಅನ್ವಯಿಸುತ್ತದೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "잠든 시점부터 계산해요. 잠자리에 들 때 워치에서 ‘잘 자요’를 탭하세요. Apple Watch에서는 Phase Wake가 학습한 잠드는 데 걸리는 시간으로 잠든 시각을 추정해요. 탭하지 않으면 설정한 시간이 적용돼요."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ນັບຈາກເວລາທີ່ເຈົ້າຫຼັບ – ແຕະ «ລາຕີສະຫວັດ» ໃນໂມງເມື່ອເຂົ້ານອນ. ໃນ Apple Watch, Phase Wake ຄາດຄະເນເວລາທີ່ເຈົ້າຫຼັບ ຈາກເວລາກວ່າຈະຫຼັບທີ່ມັນໄດ້ຮຽນຮູ້. ຖ້າບໍ່ແຕະ ຈະໃຊ້ເວລາທີ່ຕັ້ງໄວ້."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Skaičiuojama nuo užmigimo – eidamas miegoti laikrodyje paliesk „Labanakt“. Apple Watch laikrodyje Phase Wake įvertina, kada užmiegi, pagal išmoktą tavo užmigimo trukmę. Nepalietus galioja nustatytas laikas."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Skaita no aizmigšanas – ejot gulēt, pulkstenī pieskaries “Ar labu nakti”. Apple Watch pulkstenī Phase Wake novērtē, kad tu iemiegi, pēc apgūtā iemigšanas ilguma. Bez pieskāriena ir spēkā iestatītais laiks."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Се брои од заспивањето – допри „Добра ноќ“ на часовникот кога легнуваш. На Apple Watch, Phase Wake проценува кога заспиваш според наученото време за заспивање. Без допир важи поставеното време."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഉറങ്ങിയ സമയം മുതൽ എണ്ണുന്നു – കിടക്കുമ്പോൾ വാച്ചിൽ «ശുഭരാത്രി» ടാപ്പ് ചെയ്യുക. Apple Watch-ൽ, പഠിച്ചെടുത്ത ഉറങ്ങാനെടുക്കുന്ന സമയത്തിൽ നിന്ന് നിങ്ങൾ എപ്പോൾ ഉറങ്ങുന്നുവെന്ന് Phase Wake കണക്കാക്കുന്നു. ടാപ്പ് ചെയ്തില്ലെങ്കിൽ സജ്ജീകരിച്ച സമയം ബാധകമാകും."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Унтсан цагаас тоолно – орондоо ороходоо цаган дээр «Сайхан амраарай»-г дар. Apple Watch дээр Phase Wake сурсан унтах хүртэлх хугацаагаар чамайг хэзээ унтсаныг тооцоолдог. Дарахгүй бол тохируулсан цаг хүчинтэй."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "झोप लागल्यापासून मोजले जाते – झोपायला जाताना घड्याळावर «शुभ रात्री» टॅप करा. Apple Watch वर Phase Wake शिकलेल्या झोप लागण्याच्या वेळेवरून तुम्ही कधी झोपता याचा अंदाज लावते. टॅप न केल्यास सेट केलेली वेळ लागू होते."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Dikira sejak awak tertidur – ketik “Selamat malam” pada jam apabila awak masuk tidur. Pada Apple Watch, Phase Wake menganggarkan bila awak tertidur berdasarkan masa untuk tertidur yang telah dipelajarinya. Tanpa ketikan, masa yang ditetapkan digunakan."
          }
        },
        "my": {
          "stringUnit": {
            "state": "translated",
            "value": "အိပ်ပျော်ချိန်မှ စတင်ရေတွက်သည် – အိပ်ယာဝင်ချိန်တွင် နာရီပေါ်ရှိ «ကောင်းသောညပါ» ကို နှိပ်ပါ။ Apple Watch တွင် Phase Wake သည် သင်ယူထားသော အိပ်ပျော်ရန် ကြာချိန်မှ သင်အိပ်ပျော်သည့်အချိန်ကို ခန့်မှန်းပါသည်။ မနှိပ်ပါက သတ်မှတ်ထားသော အချိန်ကို အသုံးပြုမည်။"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Telles fra du sovner – trykk på «God natt» på klokken når du legger deg. På Apple Watch anslår Phase Wake når du sovner, ut fra den lærte innsovningstiden din. Uten trykk gjelder den innstilte tiden."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "निदाएदेखि गनिन्छ – सुत्न जाँदा घडीमा «शुभ रात्रि» थिच। Apple Watch मा Phase Wake ले सिकेको निदाउन लाग्ने समयबाट तिमी कहिले निदायौ भनी अनुमान गर्छ। नथिचे सेट गरिएको समय लागू हुन्छ।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Telt vanaf het inslapen – tik bij het naar bed gaan op ‘Welterusten’ op je horloge. Op de Apple Watch schat Phase Wake wanneer je in slaap valt op basis van je geleerde inslaaptijd. Zonder tik geldt de ingestelde tijd."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਸੌਂ ਜਾਣ ਤੋਂ ਗਿਣਿਆ ਜਾਂਦਾ ਹੈ – ਸੌਣ ਜਾਂਦੇ ਸਮੇਂ ਘੜੀ ’ਤੇ «ਸ਼ੁਭ ਰਾਤ» ਟੈਪ ਕਰੋ। Apple Watch ’ਤੇ Phase Wake ਸਿੱਖੇ ਹੋਏ ਨੀਂਦ ਆਉਣ ਦੇ ਸਮੇਂ ਤੋਂ ਅੰਦਾਜ਼ਾ ਲਗਾਉਂਦਾ ਹੈ ਕਿ ਤੁਸੀਂ ਕਦੋਂ ਸੌਂਦੇ ਹੋ। ਟੈਪ ਨਾ ਕਰਨ ’ਤੇ ਸੈੱਟ ਕੀਤਾ ਸਮਾਂ ਲਾਗੂ ਹੁੰਦਾ ਹੈ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Liczy się od zaśnięcia – kładąc się spać, stuknij na zegarku „Dobranoc”. Na Apple Watch Phase Wake szacuje, kiedy zasypiasz, na podstawie nauczonego czasu zasypiania. Bez stuknięcia obowiązuje ustawiona godzina."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Conta a partir de quando você adormece – toque em “Boa noite” no relógio ao ir para a cama. No Apple Watch, o Phase Wake estima quando você adormece a partir do tempo para adormecer que aprendeu. Sem o toque, vale o horário definido."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Conta a partir de quando adormeces – toca em «Boa noite» no relógio ao deitares-te. No Apple Watch, o Phase Wake estima quando adormeces a partir do tempo até adormecer que aprendeu. Sem o toque, vale a hora definida."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Se numără de la adormire – atinge „Noapte bună” pe ceas când te culci. Pe Apple Watch, Phase Wake estimează când adormi pe baza duratei de adormire învățate. Fără atingere se aplică ora setată."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отсчитывается от засыпания – ложась спать, нажми на часах «Спокойной ночи». На Apple Watch Phase Wake оценивает, когда ты засыпаешь, по изученному времени засыпания. Без нажатия действует установленное время."
          }
        },
        "si": {
          "stringUnit": {
            "state": "translated",
            "value": "නින්දට ගිය වේලාවේ සිට ගණන් කෙරේ – නිදාගන්නා විට ඔරලෝසුවේ «සුබ රාත්‍රියක්» තට්ටු කරන්න. Apple Watch හි Phase Wake ඉගෙන ගත් නින්දට යාමට ගතවන කාලයෙන් ඔබ නින්දට යන වේලාව ඇස්තමේන්තු කරයි. තට්ටු නොකළහොත් සැකසූ වේලාව අදාළ වේ."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Počíta sa od zaspania – keď ideš spať, ťukni na hodinkách na „Dobrú noc“. Na Apple Watch odhaduje Phase Wake, kedy zaspíš, podľa naučenej doby zaspávania. Bez ťuknutia platí nastavený čas."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Šteje od uspavanja – ko greš spat, na uri tapni »Lahko noč«. Na uri Apple Watch Phase Wake oceni, kdaj zaspiš, iz naučenega časa uspavanja. Brez tapa velja nastavljeni čas."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Llogaritet nga koha kur bie në gjumë – prek «Natën e mirë» në orë kur shkon të flesh. Në Apple Watch, Phase Wake vlerëson kur bie në gjumë nga koha e mësuar që të duhet për të fjetur. Pa prekje vlen ora e caktuar."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Рачуна се од успављивања – додирни „Лаку ноћ“ на сату када идеш у кревет. На Apple Watch-у Phase Wake процењује када заспиш на основу наученог времена успављивања. Без додира важи подешено време."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Räknas från när du somnar – tryck på ”Godnatt” på klockan när du lägger dig. På Apple Watch uppskattar Phase Wake när du somnar utifrån din inlärda insomningstid. Utan tryck gäller den inställda tiden."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Huhesabiwa kuanzia unaposinzia – gusa “Usiku mwema” kwenye saa unapoenda kulala. Kwenye Apple Watch, Phase Wake inakadiria wakati unapolala kutokana na muda wa kupata usingizi ilioujifunza. Usipogusa, muda uliowekwa ndio hutumika."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "தூங்கியதிலிருந்து எண்ணப்படும் – படுக்கும்போது கடிகாரத்தில் «இனிய இரவு» தட்டவும். Apple Watch இல் Phase Wake கற்றுக்கொண்ட தூங்க ஆகும் நேரத்திலிருந்து நீங்கள் எப்போது தூங்குகிறீர்கள் என மதிப்பிடுகிறது. தட்டாவிட்டால் அமைத்த நேரம் பொருந்தும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "నిద్రపోయినప్పటి నుండి లెక్కిస్తుంది – పడుకునేటప్పుడు వాచ్‌లో «శుభ రాత్రి» నొక్కండి. Apple Watchలో Phase Wake నేర్చుకున్న నిద్రపట్టడానికి పట్టే సమయం నుండి మీరు ఎప్పుడు నిద్రపోతారో అంచనా వేస్తుంది. నొక్కకపోతే సెట్ చేసిన సమయం వర్తిస్తుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "นับตั้งแต่ตอนที่คุณหลับ – แตะ «ราตรีสวัสดิ์» บนนาฬิกาเมื่อเข้านอน บน Apple Watch, Phase Wake ประมาณเวลาที่คุณหลับจากเวลาจนหลับที่เรียนรู้ไว้ หากไม่แตะ จะใช้เวลาที่ตั้งไว้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uykuya daldığın andan itibaren sayılır – yatarken saatte «İyi geceler»e dokun. Apple Watch’ta Phase Wake ne zaman uykuya daldığını öğrendiği uykuya dalma süresinden tahmin eder. Dokunmazsan ayarlanan saat geçerli olur."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відлічується від засинання – лягаючи спати, натисни на годиннику «На добраніч». На Apple Watch Phase Wake оцінює, коли ти засинаєш, за вивченим часом засинання. Без натискання діє встановлений час."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "سونے کے وقت سے گنا جاتا ہے – سونے جاتے وقت گھڑی پر «شب بخیر» ٹیپ کرو۔ Apple Watch پر Phase Wake سیکھے گئے نیند آنے کے وقت سے اندازہ لگاتا ہے کہ تم کب سوتے ہو۔ ٹیپ نہ کرو تو سیٹ کیا گیا وقت لاگو ہوتا ہے۔"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Uxlab qolgan paytdan hisoblanadi – yotayotganda soatda «Xayrli tun»ga bos. Apple Watchʼda Phase Wake qachon uxlab qolishingni oʻrgangan uxlab qolish vaqtingdan taxmin qiladi. Bosmasang, o‘rnatilgan vaqt amal qiladi."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tính từ lúc bạn ngủ thiếp đi – chạm “Ngủ ngon” trên đồng hồ khi đi ngủ. Trên Apple Watch, Phase Wake ước tính thời điểm bạn ngủ dựa trên thời gian vào giấc đã học được. Nếu không chạm, thời gian đã đặt sẽ được áp dụng."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "由入睡時開始計算——上床時在手錶上點一下「晚安」。在 Apple Watch 上，Phase Wake 會根據學到的入睡時間估算你何時入睡。如果不點，則按設定的時間。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从入睡时开始计算——上床时在手表上轻点“晚安”。在 Apple Watch 上，Phase Wake 会根据学到的入睡时长估算你的入睡时间。如果不轻点，则按设定的时间。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "從入睡時開始計算——上床時在手錶上點一下「晚安」。在 Apple Watch 上，Phase Wake 會根據學到的入睡時間估算你何時入睡。如果不點，則按設定的時間。"
          }
        },
        "zu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kubalwa kusukela lapho uzumeka – thepha u-“Ulale kahle” ewashini lakho lapho uyolala. Ku-Apple Watch, i-Phase Wake ilinganisela ukuthi uzumeka nini ngesikhathi sokuzumeka esiyifundile. Ngaphandle kokuthepha, kusebenza isikhathi esisethiwe."
          }
        }
      }
    },
