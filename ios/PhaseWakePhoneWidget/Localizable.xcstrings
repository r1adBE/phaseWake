    "learn_point_private": {
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Die data bly op jou toestelle. Jy kan die leerfase enige tyd in die instellings afskakel."
          }
        },
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "ውሂቡ በመሣሪያዎችህ ላይ ይቆያል። የመማሪያ ጊዜውን በማንኛውም ጊዜ በቅንብሮች ውስጥ ማጥፋት ትችላለህ።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تبقى البيانات على أجهزتك. يمكنك إيقاف مرحلة التعلّم في الإعدادات في أي وقت."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Məlumatlar cihazlarında qalır. Öyrənmə mərhələsini istənilən vaxt ayarlarda söndürə bilərsən."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Данните остават на твоите устройства. Можеш да изключиш фазата на учене по всяко време в настройките."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ডেটা তোমার ডিভাইসেই থাকে। সেটিংসে যেকোনো সময় শেখার পর্ব বন্ধ করতে পারো।"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Podaci ostaju na tvojim uređajima. Fazu učenja možeš bilo kada isključiti u postavkama."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Les dades es queden als teus dispositius. Pots desactivar la fase d’aprenentatge a la configuració en qualsevol moment."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Data zůstávají ve tvých zařízeních. Fázi učení můžeš kdykoli vypnout v nastavení."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dataene bliver på dine enheder. Du kan altid slå læringsfasen fra i indstillingerne."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Daten bleiben auf deinen Geräten. Du kannst die Lernphase jederzeit in den Einstellungen ausschalten."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τα δεδομένα μένουν στις συσκευές σου. Μπορείς να απενεργοποιήσεις τη φάση εκμάθησης στις ρυθμίσεις οποιαδήποτε στιγμή."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The data stays on your devices. You can turn the learning phase off in the settings at any time."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los datos se quedan en tus dispositivos. Puedes desactivar la fase de aprendizaje en los ajustes cuando quieras."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Andmed jäävad sinu seadmetesse. Õppefaasi saad seadetes igal ajal välja lülitada."
