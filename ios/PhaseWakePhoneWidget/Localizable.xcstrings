    "learn_tip_sensors": {
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Gee Phase Wake in die horlosie se instellings toegang tot die sensors en bewegingsdata."
          }
        },
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "በሰዓቱ ቅንብሮች ውስጥ Phase Wake ዳሳሾቹን እና የእንቅስቃሴ ውሂብን እንዲጠቀም ፍቀድ።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اسمح لـ Phase Wake باستخدام المستشعرات وبيانات الحركة في إعدادات الساعة."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Saatın ayarlarında Phase Wake-ə sensorlardan və hərəkət məlumatlarından istifadəyə icazə ver."
