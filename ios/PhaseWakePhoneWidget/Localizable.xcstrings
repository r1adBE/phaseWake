        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Malam dari Apple Health dan aplikasi lain juga bisa muncul di sini. Untuk melihatnya, cocokkan dengan data kesehatan."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Nætur úr Apple Health og öðrum forritum geta líka birst hér. Berðu saman við heilsugögn til að sjá þær."
