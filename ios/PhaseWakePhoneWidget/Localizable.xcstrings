        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הנתונים נשארים במכשירים שלך. אפשר לכבות את שלב הלמידה בהגדרות בכל עת."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "डेटा तुम्हारे डिवाइस पर ही रहता है। सीखने का चरण तुम सेटिंग्स में कभी भी बंद कर सकते हो।"
