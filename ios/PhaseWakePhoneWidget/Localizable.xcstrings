            "state": "translated",
            "value": "Ikke en medisinsk vurdering."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "यो चिकित्सकीय मूल्याङ्कन होइन।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen medisch oordeel."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਇਹ ਡਾਕਟਰੀ ਮੁਲਾਂਕਣ ਨਹੀਂ ਹੈ।"
