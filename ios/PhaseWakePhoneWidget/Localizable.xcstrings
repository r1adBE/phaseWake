            "value": "Atkurti nepavyko. Niekas nepakeista."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Atjaunošana neizdevās. Nekas netika mainīts."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Враќањето не успеа. Ништо не е променето."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "പുനഃസ്ഥാപിക്കൽ പരാജയപ്പെട്ടു. ഒന്നും മാറ്റിയിട്ടില്ല."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Сэргээж чадсангүй. Юу ч өөрчлөгдсөнгүй."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "पुनर्संचयित करणे अयशस्वी झाले. काहीही बदलले नाही."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pemulihan gagal. Tiada apa-apa yang diubah."
          }
        },
        "my": {
          "stringUnit": {
            "state": "translated",
            "value": "ပြန်ယူခြင်း မအောင်မြင်ပါ။ ဘာမှ မပြောင်းလဲပါ။"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Gjenopprettingen mislyktes. Ingenting ble endret."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "पुनर्स्थापना असफल भयो। केही पनि बदलिएन।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Herstellen is mislukt. Er is niets gewijzigd."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਮੁੜ-ਬਹਾਲੀ ਅਸਫਲ ਰਹੀ। ਕੁਝ ਵੀ ਨਹੀਂ ਬਦਲਿਆ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przywracanie nie powiodło się. Nic nie zostało zmienione."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Falha ao restaurar. Nada foi alterado."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O restauro falhou. Nada foi alterado."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Restaurarea a eșuat. Nu s-a modificat nimic."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось восстановить. Ничего не изменено."
          }
        },
        "si": {
          "stringUnit": {
            "state": "translated",
            "value": "ප්‍රතිසාධනය අසාර්ථක විය. කිසිවක් වෙනස් නොකළා."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Obnovenie zlyhalo. Nič sa nezmenilo."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Obnovitev ni uspela. Nič ni bilo spremenjeno."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Rikthimi dështoi. Asgjë nuk u ndryshua."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Враћање није успело. Ништа није промењено."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Återställningen misslyckades. Inget ändrades."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Imeshindwa kurejesha. Hakuna kilichobadilishwa."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "மீட்டமைப்பு தோல்வியடைந்தது. எதுவும் மாற்றப்படவில்லை."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "పునరుద్ధరణ విఫలమైంది. ఏమీ మారలేదు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กู้คืนไม่สำเร็จ ไม่มีการเปลี่ยนแปลงใดๆ"
