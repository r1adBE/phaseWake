    "channel_alarm_description": {
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Lui saam met jou horlosie op jou foon."
          }
        },
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "ከሰዓትዎ ጋር በስልክዎ ላይ ይደውላል።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يرنّ على هاتفك مع ساعتك."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Saatınla birlikdə telefonunda da çalır."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Звъни на телефона заедно с часовника."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ঘড়ির সঙ্গে ফোনেও বাজে।"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zvoni na telefonu zajedno sa satom."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Sona al telèfon juntament amb el rellotge."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zvoní v telefonu spolu s hodinkami."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ringer på telefonen sammen med uret."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Klingelt auf dem Handy zusammen mit der Uhr."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Χτυπά στο κινητό μαζί με το ρολόι σου."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rings on your phone together with your watch."
          }
        },
        "es": {
          "stringUnit": {
