        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "មិនអាចភ្ជាប់ទៅនាឡិកាបានទេ។ ពាក់វា បើក Bluetooth ហើយបើក Phase Wake លើនាឡិកាម្ដង។"
