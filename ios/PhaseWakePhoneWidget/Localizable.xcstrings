    "check_watch_notifications_problem": {
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Laat tydsensitiewe kennisgewings vir Phase Wake op jou Apple Watch toe. Anders kan dit jou nie per kennisgewing wek as geen meting loop nie."
          }
        },
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "በApple Watchህ ላይ ለPhase Wake ጊዜ-ተኮር ማሳወቂያዎችን ፍቀድ። አለበለዚያ ልኬት በማይካሄድበት ጊዜ በማሳወቂያ ሊያነቃህ አይችልም።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اسمح بالإشعارات الحساسة للوقت لتطبيق Phase Wake على Apple Watch. وإلا فلن تتمكن من إيقاظك بإشعار عندما لا يكون هناك قياس جارٍ."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Watch-da Phase Wake üçün vaxta həssas bildirişlərə icazə ver. Əks halda ölçmə getmədikdə saat səni bildirişlə oyada bilməz."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Разреши известията с времева чувствителност за Phase Wake на своя Apple Watch. Иначе той не може да те събуди с известие, когато не тече измерване."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "তোমার Apple Watch-এ Phase Wake-এর জন্য সময়-সংবেদনশীল নোটিফিকেশন চালু করো। নইলে কোনো পরিমাপ না চললে ঘড়ি তোমাকে নোটিফিকেশন দিয়ে জাগাতে পারবে না।"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Dozvoli vremenski osjetljiva obavještenja za Phase Wake na svom Apple Watchu. U suprotnom te ne može probuditi obavještenjem kada mjerenje ne teče."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Permet les notificacions urgents de Phase Wake a l’Apple Watch. Si no, no et pot despertar amb una notificació quan no hi ha cap mesura en curs."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Povol pro Phase Wake na Apple Watch časově citlivá oznámení. Jinak tě hodinky nemohou probudit oznámením, když neběží měření."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tillad tidsfølsomme notifikationer fra Phase Wake på dit Apple Watch. Ellers kan uret ikke vække dig med en notifikation, når der ikke kører en måling."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erlaube zeitkritische Mitteilungen von Phase Wake auf deiner Apple Watch. Sonst kann sie dich ohne laufende Messung nicht per Mitteilung wecken."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επίτρεψε τις χρονικά ευαίσθητες ειδοποιήσεις του Phase Wake στο Apple Watch σου. Αλλιώς δεν μπορεί να σε ξυπνήσει με ειδοποίηση όταν δεν γίνεται μέτρηση."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow time-sensitive notifications for Phase Wake on your Apple Watch. Otherwise it can’t wake you by notification when no measurement is running."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite las notificaciones urgentes de Phase Wake en tu Apple Watch. Si no, no puede despertarte con una notificación cuando no hay ninguna medición en curso."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Luba Phase Wake’ile oma Apple Watchis ajatundlikud märguanded. Muidu ei saa kell sind märguandega äratada, kui mõõtmine ei käi."
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "Baimendu Phase Wake-ren jakinarazpen premiazkoak zure Apple Watchean. Bestela, ezin zaitu jakinarazpen batekin esnatu neurketarik ez dagoenean."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "اعلان‌های حساس به زمان را برای Phase Wake روی Apple Watch خود مجاز کن. وگرنه وقتی اندازه‌گیری‌ای در جریان نیست، نمی‌تواند با اعلان بیدارت کند."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Salli Phase Waken aikasidonnaiset ilmoitukset Apple Watchissasi. Muuten kello ei voi herättää sinua ilmoituksella, kun mittaus ei ole käynnissä."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Payagan ang mga time-sensitive na notification para sa Phase Wake sa iyong Apple Watch. Kung hindi, hindi ka nito magigising gamit ang notification kapag walang tumatakbong pagsukat."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorise les notifications urgentes de Phase Wake sur ton Apple Watch. Sinon, elle ne peut pas te réveiller par une notification quand aucune mesure n’est en cours."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Ceadaigh fógraí atá íogair ó thaobh ama de do Phase Wake ar do Apple Watch. Murach sin, ní féidir leis tú a dhúiseacht le fógra nuair nach bhfuil tomhas ar siúl."
          }
        },
        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite as notificacións urxentes de Phase Wake no teu Apple Watch. Se non, non pode espertarte cunha notificación cando non hai ningunha medición en curso."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તમારી Apple Watch પર Phase Wake માટે સમય-સંવેદનશીલ સૂચનાઓની મંજૂરી આપો. નહીંતર માપન ચાલુ ન હોય ત્યારે તે તમને સૂચના દ્વારા જગાડી શકશે નહીં."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אפשרו התראות רגישות לזמן עבור Phase Wake ב-Apple Watch שלכם. אחרת הוא לא יוכל להעיר אתכם בהתראה כשאין מדידה פעילה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपनी Apple Watch पर Phase Wake के लिए समय-संवेदी सूचनाओं की अनुमति दें। वरना माप न चलने पर वॉच आपको सूचना से नहीं जगा सकती।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dopusti vremenski osjetljive obavijesti za Phase Wake na svom Apple Watchu. Inače te ne može probuditi obaviješću kad mjerenje ne teče."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Engedélyezd a Phase Wake időérzékeny értesítéseit az Apple Watchodon. Különben nem tud értesítéssel ébreszteni, ha nem fut mérés."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Թույլատրիր Phase Wake-ի ժամանակազգայուն ծանուցումները քո Apple Watch-ում։ Այլապես այն չի կարող քեզ ծանուցմամբ արթնացնել, երբ չափում չի ընթանում։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Izinkan notifikasi peka waktu untuk Phase Wake di Apple Watch-mu. Jika tidak, jam tidak bisa membangunkanmu lewat notifikasi saat tidak ada pengukuran yang berjalan."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Leyfðu tímanæmar tilkynningar frá Phase Wake á Apple Watch-úrinu þínu. Annars getur það ekki vakið þig með tilkynningu þegar engin mæling er í gangi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Consenti le notifiche urgenti di Phase Wake sul tuo Apple Watch. Altrimenti non può svegliarti con una notifica quando non è in corso una misurazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple WatchでPhase Wakeの即時通知を許可してください。許可しないと、計測が行われていないときに通知で起こせません。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "დაუშვი Phase Wake-ის დროზე მგრძნობიარე შეტყობინებები შენს Apple Watch-ზე. თორემ, როცა გაზომვა არ მიმდინარეობს, საათი შეტყობინებით ვერ გაგაღვიძებს."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Watch-та Phase Wake үшін уақытқа сезімтал хабарландыруларға рұқсат бер. Әйтпесе өлшеу жүрмей тұрғанда сағат сені хабарландырумен оята алмайды."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "អនុញ្ញាតការជូនដំណឹងដែលពាក់ព័ន្ធនឹងពេលវេលាសម្រាប់ Phase Wake នៅលើ Apple Watch របស់អ្នក។ បើមិនដូច្នោះទេ វាមិនអាចដាស់អ្នកដោយការជូនដំណឹងបានទេ នៅពេលគ្មានការវាស់កំពុងដំណើរការ។"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನಿಮ್ಮ Apple Watch ನಲ್ಲಿ Phase Wake ಗಾಗಿ ಸಮಯ-ಸೂಕ್ಷ್ಮ ಅಧಿಸೂಚನೆಗಳನ್ನು ಅನುಮತಿಸಿ. ಇಲ್ಲದಿದ್ದರೆ ಅಳತೆ ನಡೆಯದಿದ್ದಾಗ ಅದು ನಿಮ್ಮನ್ನು ಅಧಿಸೂಚನೆಯ ಮೂಲಕ ಎಬ್ಬಿಸಲಾರದು."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Watch에서 Phase Wake의 시간 민감 알림을 허용해 주세요. 그렇지 않으면 측정이 진행되지 않을 때 알림으로 깨울 수 없어요."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ອະນຸຍາດການແຈ້ງເຕືອນທີ່ສຳຄັນຕໍ່ເວລາສຳລັບ Phase Wake ໃນ Apple Watch ຂອງເຈົ້າ. ບໍ່ດັ່ງນັ້ນ ມັນຈະປຸກເຈົ້າດ້ວຍການແຈ້ງເຕືອນບໍ່ໄດ້ ເມື່ອບໍ່ມີການວັດແທກ."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Leisk Phase Wake rodyti laikui jautrius pranešimus tavo Apple Watch. Kitaip laikrodis negalės tavęs pažadinti pranešimu, kai nevyksta matavimas."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Atļauj Phase Wake laikjutīgos paziņojumus savā Apple Watch. Citādi tas nevarēs tevi pamodināt ar paziņojumu, kad mērījums nenotiek."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дозволи временски чувствителни известувања за Phase Wake на својот Apple Watch. Инаку не може да те разбуди со известување кога не тече мерење."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Watch-ൽ Phase Wake-ന് സമയബന്ധിത അറിയിപ്പുകൾ അനുവദിക്കുക. അല്ലെങ്കിൽ അളക്കൽ നടക്കാത്തപ്പോൾ അതിന് നിങ്ങളെ അറിയിപ്പിലൂടെ ഉണർത്താനാവില്ല."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Watch дээрээ Phase Wake-ийн цаг хугацааны чухал мэдэгдлийг зөвшөөр. Эс бөгөөс хэмжилт явагдахгүй үед цаг чамайг мэдэгдлээр сэрээж чадахгүй."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुमच्या Apple Watch वर Phase Wake साठी वेळ-संवेदनशील सूचनांना परवानगी द्या. नाहीतर मोजमाप चालू नसताना ते तुम्हाला सूचनेद्वारे उठवू शकणार नाही."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Benarkan pemberitahuan sensitif masa untuk Phase Wake pada Apple Watch awak. Jika tidak, jam tidak dapat membangunkan awak melalui pemberitahuan apabila tiada pengukuran berjalan."
          }
        },
        "my": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Watch ပေါ်တွင် Phase Wake အတွက် အချိန်အရေးကြီး အသိပေးချက်များကို ခွင့်ပြုပါ။ မဟုတ်ပါက တိုင်းတာမှု မလုပ်ဆောင်နေချိန်တွင် အသိပေးချက်ဖြင့် နှိုး၍ မရပါ။"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Tillat tidssensitive varsler fra Phase Wake på Apple Watch. Ellers kan klokken ikke vekke deg med et varsel når ingen måling pågår."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "आफ्नो Apple Watch मा Phase Wake का लागि समय-संवेदनशील सूचनाहरूलाई अनुमति देऊ। नत्र मापन नचलिरहेको बेला घडीले तिमीलाई सूचनाबाट उठाउन सक्दैन।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sta tijdgevoelige meldingen van Phase Wake toe op je Apple Watch. Anders kan hij je niet met een melding wekken als er geen meting loopt."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਆਪਣੀ Apple Watch ’ਤੇ Phase Wake ਲਈ ਸਮਾਂ-ਸੰਵੇਦਨਸ਼ੀਲ ਸੂਚਨਾਵਾਂ ਦੀ ਇਜਾਜ਼ਤ ਦਿਓ। ਨਹੀਂ ਤਾਂ ਮਾਪ ਨਾ ਚੱਲਦੇ ਸਮੇਂ ਇਹ ਤੁਹਾਨੂੰ ਸੂਚਨਾ ਰਾਹੀਂ ਨਹੀਂ ਜਗਾ ਸਕਦੀ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zezwól na powiadomienia wrażliwe na czas od Phase Wake na swoim Apple Watch. W przeciwnym razie zegarek nie obudzi cię powiadomieniem, gdy nie trwa pomiar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Permita as notificações sensíveis ao tempo do Phase Wake no seu Apple Watch. Senão, ele não consegue acordar você com uma notificação quando nenhuma medição está em andamento."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite as notificações urgentes do Phase Wake no teu Apple Watch. Caso contrário, não te consegue acordar com uma notificação quando não está nenhuma medição em curso."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite notificările urgente de la Phase Wake pe Apple Watch-ul tău. Altfel, ceasul nu te poate trezi printr-o notificare când nu rulează nicio măsurare."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разреши срочные уведомления Phase Wake на своих Apple Watch. Иначе часы не смогут разбудить тебя уведомлением, когда измерение не идёт."
          }
        },
        "si": {
          "stringUnit": {
            "state": "translated",
            "value": "ඔබේ Apple Watch හි Phase Wake සඳහා කාල-සංවේදී දැනුම්දීම්වලට ඉඩ දෙන්න. එසේ නොමැති නම් මැනීමක් සිදු නොවන විට එයට ඔබව දැනුම්දීමකින් අවදි කළ නොහැක."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Povoľ pre Phase Wake na Apple Watch časovo citlivé upozornenia. Inak ťa hodinky nemôžu zobudiť upozornením, keď neprebieha meranie."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dovoli časovno občutljiva obvestila za Phase Wake na svoji uri Apple Watch. Sicer te ne more zbuditi z obvestilom, ko meritev ne teče."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Lejo njoftimet me ndjeshmëri kohore për Phase Wake në Apple Watch-in tënd. Përndryshe ora nuk mund të të zgjojë me njoftim kur nuk po kryhet asnjë matje."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Дозволи временски осетљива обавештења за Phase Wake на свом Apple Watch-у. Иначе те не може пробудити обавештењем када мерење не тече."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tillåt tidskänsliga notiser från Phase Wake på din Apple Watch. Annars kan klockan inte väcka dig med en notis när ingen mätning pågår."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Ruhusu arifa zinazozingatia muda kwa Phase Wake kwenye Apple Watch yako. La sivyo, haiwezi kukuamsha kwa arifa wakati hakuna kipimo kinachoendelea."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் Apple Watch இல் Phase Wake க்கு நேர முக்கிய அறிவிப்புகளை அனுமதியுங்கள். இல்லையெனில் அளவீடு நடக்காதபோது அது உங்களை அறிவிப்பின் மூலம் எழுப்ப முடியாது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ Apple Watchలో Phase Wake కోసం సమయ-సున్నితమైన నోటిఫికేషన్‌లను అనుమతించండి. లేకపోతే కొలత జరగనప్పుడు అది మిమ్మల్ని నోటిఫికేషన్‌తో లేపలేదు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อนุญาตการแจ้งเตือนที่มีผลต่อเวลาสำหรับ Phase Wake บน Apple Watch ของคุณ มิฉะนั้นนาฬิกาจะปลุกคุณด้วยการแจ้งเตือนไม่ได้เมื่อไม่มีการวัดอยู่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Watch’unda Phase Wake için zamana duyarlı bildirimlere izin ver. Aksi halde ölçüm yapılmıyorken saat seni bildirimle uyandıramaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дозволь термінові сповіщення Phase Wake на своєму Apple Watch. Інакше годинник не зможе розбудити тебе сповіщенням, коли вимірювання не триває."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اپنی Apple Watch پر Phase Wake کے لیے وقت کی حساس اطلاعات کی اجازت دو۔ ورنہ پیمائش نہ چل رہی ہو تو گھڑی تمہیں اطلاع سے نہیں جگا سکتی۔"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Watchʼingda Phase Wake uchun vaqtga sezgir bildirishnomalarga ruxsat ber. Aks holda oʻlchov ketmayotganda soat seni bildirishnoma bilan uygʻota olmaydi."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy cho phép thông báo nhạy cảm về thời gian của Phase Wake trên Apple Watch của bạn. Nếu không, đồng hồ không thể đánh thức bạn bằng thông báo khi không có phép đo nào đang chạy."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "請在 Apple Watch 上允許 Phase Wake 傳送時效性通知。否則，在沒有進行測量時，手錶無法透過通知叫醒你。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在 Apple Watch 上允许 Phase Wake 发送时间敏感通知。否则，在没有进行测量时，手表无法通过通知叫醒你。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請在 Apple Watch 上允許 Phase Wake 傳送時效性通知。否則，在沒有進行測量時，手錶無法透過通知叫醒你。"
          }
        },
        "zu": {
          "stringUnit": {
            "state": "translated",
            "value": "Vumela izaziso ezibucayi ngesikhathi ze-Phase Wake ku-Apple Watch yakho. Uma kungenjalo, ayikwazi ukukuvusa ngesaziso uma kungekho kukala okuqhubekayo."
          }
        }
      }
    },
    "check_watch_onset_battery": {
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Met minder as %1$lld %% battery meet jou horlosie vannag nie wanneer jy aan die slaap raak nie – laai dit vooraf. Jy sal steeds gewek word."
          }
        },
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "ከ%1$lld %% ባትሪ በታች ሰዓትህ ዛሬ ማታ እንቅልፍ መውሰድህን አይለካም – አስቀድመህ ኃይል ሙላው። ቢሆንም ማንቂያው ይቀሰቅስሃል።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مع بطارية أقل من %1$lld %% لن تقيس ساعتك الليلة متى تنام – اشحنها مسبقًا. سيوقظك المنبّه مع ذلك."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Batareya %1$lld %%-dən aşağı olduqda saat bu gecə yuxuya getməyini ölçməyəcək – onu əvvəlcədən doldur. Zəngli saat səni yenə də oyadacaq."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Под %1$lld %% батерия часовникът няма да измерва довечера кога заспиваш – зареди го предварително. Алармата пак ще те събуди."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ব্যাটারি %1$lld %%-এর নিচে থাকলে ঘড়ি আজ রাতে তুমি কখন ঘুমিয়ে পড়লে তা মাপবে না – আগেই চার্জ দাও। অ্যালার্ম তবুও তোমাকে জাগাবে।"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ispod %1$lld %% baterije sat noćas neće mjeriti kada zaspiš – napuni ga prije toga. Alarm će te ipak probuditi."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Amb menys del %1$lld %% de bateria, el rellotge no mesurarà aquesta nit quan t'adorms – carrega'l abans. L’alarma et despertarà igualment."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pod %1$lld %% baterie hodinky dnes v noci neměří, kdy usneš – nabij je předem. Budík tě přesto vzbudí."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Under %1$lld %% batteri måler uret ikke i nat, hvornår du falder i søvn – oplad det inden. Du bliver stadig vækket."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unter %1$lld %% Akku misst die Uhr heute Nacht dein Einschlafen nicht – lade sie vorher. Geweckt wirst du trotzdem."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Με μπαταρία κάτω από %1$lld %% το ρολόι δεν θα μετρήσει απόψε πότε αποκοιμιέσαι – φόρτισέ το πριν. Το ξυπνητήρι θα σε ξυπνήσει κανονικά."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "With less than %1$lld %% battery, your watch won’t measure when you fall asleep tonight – charge it beforehand. You’ll still be woken."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Con menos del %1$lld %% de batería, el reloj no medirá esta noche cuándo te duermes: cárgalo antes. La alarma te despertará igualmente."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Alla %1$lld %% aku korral ei mõõda kell täna öösel, millal sa uinud – lae see enne. Äratus äratab sind ikkagi."
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "Bateria %%%1$lld baino gutxiago bada, erlojuak ez du gaur gauean neurtuko noiz hartzen zaituen loak – kargatu aurretik. Alarmak esnatuko zaitu hala ere."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "با باتری کمتر از %1$lld %% ساعت امشب زمان به خواب رفتنت را اندازه نمی‌گیرد – از قبل شارژش کن. زنگ هشدار باز هم بیدارت می‌کند."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle %1$lld %% akulla kello ei mittaa tänä yönä, milloin nukahdat – lataa se etukäteen. Herätys herättää sinut silti."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Kapag mas mababa sa %1$lld %% ang baterya, hindi susukatin ng relo mo ngayong gabi kung kailan ka nakatulog – i-charge ito bago matulog. Gigisingin ka pa rin ng alarm."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avec moins de %1$lld %% de batterie, ta montre ne mesurera pas ton endormissement cette nuit – recharge-la avant. L’alarme te réveillera quand même."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Le níos lú ná %1$lld %% ceallra, ní thomhaisfidh d’uaireadóir anocht cathain a thiteann tú i do chodladh – luchtaigh roimh ré é. Dúiseoidh an t-aláram thú mar sin féin."
          }
        },
        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "Con menos do %1$lld %% de batería, o reloxo non medirá esta noite cando adormeces: cárgao antes. A alarma espertarate igualmente."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld %%થી ઓછી બેટરીમાં ઘડિયાળ આજે રાત્રે તને ક્યારે ઊંઘ આવી તે માપશે નહીં – પહેલાં ચાર્જ કર. એલાર્મ તો પણ તને જગાડશે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "עם פחות מ-%1$lld %% סוללה השעון לא ימדוד הלילה מתי נרדמת – טען אותו מראש. ההשכמה תעיר אותך בכל זאת."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld %% से कम बैटरी पर घड़ी आज रात यह नहीं मापेगी कि तुम कब सोए – पहले चार्ज कर लो। अलार्म फिर भी तुम्हें जगाएगा।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ispod %1$lld %% baterije sat noćas neće mjeriti kada zaspiš – napuni ga prije toga. Alarm će te ipak probuditi."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld %% alatti akkumulátorral az óra ma éjjel nem méri, mikor alszol el – töltsd fel előtte. Az ébresztő így is felébreszt."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld %%-ից ցածր մարտկոցով ժամացույցն այս գիշեր չի չափի, թե երբ ես քնում – նախապես լիցքավորիր այն։ Զարթուցիչը միևնույն է կարթնացնի քեզ։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Dengan baterai di bawah %1$lld %%, jam tanganmu tidak akan mengukur kapan kamu tertidur malam ini – isi dayanya lebih dulu. Alarm tetap akan membangunkanmu."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Með undir %1$lld %% rafhlöðu mælir úrið ekki í nótt hvenær þú sofnar – hladdu það fyrir fram. Vekjarinn vekur þig samt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Con meno del %1$lld %% di batteria, stanotte l’orologio non misurerà quando ti addormenti – ricaricalo prima. La sveglia ti sveglierà comunque."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バッテリーが%1$lld %%未満のため、今夜ウォッチは入眠を計測しません – 事前に充電してください。アラームはそれでも鳴ります。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld %%-ზე ნაკლები ბატარეით საათი ამაღამ ვერ გაზომავს, როდის ჩაგეძინება – წინასწარ დატენე. მაღვიძარა მაინც გაგაღვიძებს."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Батарея %1$lld %%-дан төмен болса, сағат бүгін түнде сенің қашан ұйықтағаныңды өлшемейді – алдын ала зарядта. Оятқыш бәрібір сені оятады."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ពេលថ្មទាបជាង %1$lld %% នាឡិកានឹងមិនវាស់ពេលដែលអ្នកដេកលក់នៅយប់នេះទេ – សូមសាកវាជាមុន។ ម៉ោងរោទ៍នឹងនៅតែដាស់អ្នក។"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld %% ಕ್ಕಿಂತ ಕಡಿಮೆ ಬ್ಯಾಟರಿಯಲ್ಲಿ ಇಂದು ರಾತ್ರಿ ನೀನು ಯಾವಾಗ ನಿದ್ರೆಗೆ ಜಾರಿದೆ ಎಂದು ವಾಚ್ ಅಳೆಯುವುದಿಲ್ಲ – ಮೊದಲೇ ಚಾರ್ಜ್ ಮಾಡು. ಅಲಾರಾಂ ಆದರೂ ನಿನ್ನನ್ನು ಎಬ್ಬಿಸುತ್ತದೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "배터리가 %1$lld %% 미만이면 오늘 밤 시계가 잠드는 시점을 측정하지 않아요 – 미리 충전해 주세요. 알람은 그래도 울려요."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ເມື່ອແບັດເຕີຣີຕ່ຳກວ່າ %1$lld %% ໂມງຈະບໍ່ວັດແທກວ່າເຈົ້ານອນຫຼັບເມື່ອໃດໃນຄືນນີ້ – ສາກໄວ້ກ່ອນ. ໂມງປຸກຍັງຈະປຸກເຈົ້າຢູ່."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Kai baterija mažesnė nei %1$lld %%, laikrodis šiąnakt nematuos, kada užmiegi – įkrauk jį iš anksto. Žadintuvas vis tiek tave pažadins."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ja akumulators ir zem %1$lld %%, pulkstenis šonakt nemērīs, kad tu aizmiedz – uzlādē to iepriekš. Modinātājs tevi tik un tā pamodinās."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Под %1$lld %% батерија часовникот вечерва нема да мери кога заспиваш – наполни го однапред. Алармот сепак ќе те разбуди."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld %%-ൽ താഴെ ബാറ്ററിയിൽ നീ എപ്പോൾ ഉറങ്ങിയെന്ന് ഇന്ന് രാത്രി വാച്ച് അളക്കില്ല – മുൻകൂട്ടി ചാർജ് ചെയ്യുക. എന്നാലും അലാറം നിന്നെ ഉണർത്തും."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Батерей %1$lld %%-иас бага бол цаг өнөө шөнө хэзээ унтсаныг чинь хэмжихгүй – урьдчилан цэнэглэ. Сэрүүлэг чамайг ямар ч байсан сэрээнэ."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld %% पेक्षा कमी बॅटरीवर घड्याळ आज रात्री तुला झोप कधी लागली हे मोजणार नाही – आधीच चार्ज कर. अलार्म तरीही तुला उठवेल."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Dengan bateri di bawah %1$lld %%, jam tangan tidak akan mengukur bila awak tertidur malam ini – cas dahulu. Penggera tetap akan mengejutkan awak."
          }
        },
        "my": {
          "stringUnit": {
            "state": "translated",
            "value": "ဘက်ထရီ %1$lld %% အောက်ဆိုလျှင် ယနေ့ည သင်အိပ်ပျော်သွားချိန်ကို နာရီက မတိုင်းတာပါ – ကြိုတင် အားသွင်းပါ။ သို့သော် နိုးစက်က သင့်ကို နှိုးပေးမည်။"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Under %1$lld %% batteri måler ikke klokken i natt når du sovner – lad den før. Du blir vekket likevel."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld %% भन्दा कम ब्याट्रीमा घडीले आज राति तिमी कहिले निदायौ भनेर मापन गर्दैन – पहिल्यै चार्ज गर। अलार्मले तिमीलाई तैपनि उठाउनेछ।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Met minder dan %1$lld %% batterij meet je horloge vannacht niet wanneer je in slaap valt – laad het vooraf op. Je wordt toch gewekt."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld %% ਤੋਂ ਘੱਟ ਬੈਟਰੀ ’ਤੇ ਘੜੀ ਅੱਜ ਰਾਤ ਇਹ ਨਹੀਂ ਮਾਪੇਗੀ ਕਿ ਤੂੰ ਕਦੋਂ ਸੌਂ ਗਿਆ – ਪਹਿਲਾਂ ਚਾਰਜ ਕਰ ਲੈ। ਅਲਾਰਮ ਫਿਰ ਵੀ ਤੈਨੂੰ ਜਗਾਏਗਾ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Poniżej %1$lld %% baterii zegarek nie zmierzy dziś w nocy, kiedy zasypiasz – naładuj go wcześniej. Budzik i tak cię obudzi."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Com menos de %1$lld %% de bateria, o relógio não vai medir hoje à noite quando você adormece – carregue-o antes. O alarme vai te acordar mesmo assim."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Com menos de %1$lld %% de bateria, o relógio não vai medir esta noite quando adormeces – carrega-o antes. O alarme vai acordar-te na mesma."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Sub %1$lld %% baterie, ceasul nu va măsura în noaptea asta când adormi – încarcă-l dinainte. Alarma te va trezi oricum."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "При заряде ниже %1$lld %% часы сегодня ночью не будут измерять, когда ты засыпаешь, – заряди их заранее. Будильник всё равно тебя разбудит."
          }
        },
        "si": {
          "stringUnit": {
            "state": "translated",
            "value": "බැටරිය %1$lld %% ට අඩු නම් අද රාත්‍රියේ ඔබ නින්දට ගිය වේලාව ඔරලෝසුව මනින්නේ නැත – කලින්ම ආරෝපණය කරන්න. එලාමය කෙසේ වෙතත් ඔබව අවදි කරයි."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pod %1$lld %% batérie hodinky dnes v noci nebudú merať, kedy zaspíš – nabi ich vopred. Budík ťa aj tak zobudí."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pod %1$lld %% baterije ura nocoj ne bo merila, kdaj zaspiš – napolni jo vnaprej. Budilka te bo vseeno zbudila."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Me më pak se %1$lld %% bateri, ora sonte nuk do ta matë kur të zë gjumi – karikoje më parë. Alarmi do të të zgjojë gjithsesi."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Испод %1$lld %% батерије сат ноћас неће мерити када заспиш – напуни га пре тога. Аларм ће те ипак пробудити."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Under %1$lld %% batteri mäter klockan inte i natt när du somnar – ladda den innan. Du blir väckt ändå."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Betri ikiwa chini ya %1$lld %%, saa haitapima usiku wa leo unaposinzia – ichaji mapema. Kengele bado itakuamsha."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld %% க்குக் குறைவான பேட்டரியில் இன்றிரவு நீ எப்போது தூங்கினாய் என்பதைக் கடிகாரம் அளக்காது – முன்பே சார்ஜ் செய். அலாரம் எப்படியும் உன்னை எழுப்பும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld %% కంటే తక్కువ బ్యాటరీతో ఈ రాత్రి నువ్వు ఎప్పుడు నిద్రపోయావో వాచ్ కొలవదు – ముందే ఛార్జ్ చెయ్యి. అయినా అలారం నిన్ను లేపుతుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เมื่อแบตเตอรี่ต่ำกว่า %1$lld %% คืนนี้นาฬิกาจะไม่วัดว่าคุณหลับเมื่อไร – ชาร์จไว้ก่อน แต่นาฬิกาปลุกจะยังปลุกคุณตามปกติ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pil %1$lld %% altındayken saat bu gece ne zaman uykuya daldığını ölçmez – önceden şarj et. Alarm seni yine de uyandıracak."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Із зарядом нижче %1$lld %% годинник цієї ночі не вимірюватиме, коли ти засинаєш, – заряди його заздалегідь. Будильник усе одно тебе розбудить."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld %% سے کم بیٹری پر گھڑی آج رات یہ نہیں ناپے گی کہ تم کب سوئے – پہلے سے چارج کر لو۔ الارم پھر بھی تمہیں جگائے گا۔"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Batareya %1$lld %% dan kam bo‘lsa, soat bu kecha qachon uxlab qolganingni o‘lchamaydi – oldindan quvvatla. Budilnik baribir seni uyg‘otadi."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi pin dưới %1$lld %%, đêm nay đồng hồ sẽ không đo lúc bạn ngủ thiếp đi – hãy sạc trước. Báo thức vẫn sẽ đánh thức bạn."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "電量低過 %1$lld %% 嘅時候，手錶今晚唔會量度你幾時瞓着——請預先充電。鬧鐘照樣會叫醒你。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "电量低于 %1$lld %% 时，手表今晚不会测量你何时入睡——请提前充电。闹钟仍会叫醒你。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "電量低於 %1$lld %% 時，手錶今晚不會測量你何時入睡——請提前充電。鬧鐘仍會叫醒你。"
          }
        },
        "zu": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma ibhethri lingaphansi kuka-%1$lld %%, iwashi ngeke lilinganise namuhla ebusuku lapho ulala – lishaje kusenesikhathi. I-alamu isazokuvusa."
          }
        }
      }
    },
    "check_watch_outdated_text": {
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Dateer Phase Wake op jou horlosie op sodat elke wekker lui soos gestel."
          }
        },
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "እያንዳንዱ ማንቂያ እንደተቀናበረው እንዲደውል በሰዓትዎ ላይ Phase Wakeን ያዘምኑ።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حدّث Phase Wake على الساعة حتى يرنّ كل منبّه كما ضبطته."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Hər siqnal qurduğun kimi çalsın deyə saatında Phase Wake-i yenilə."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Актуализирай Phase Wake на часовника, за да звъни всеки будилник както е настроен."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "প্রতিটি অ্যালার্ম যেভাবে সেট করা সেভাবে বাজাতে তোমার ঘড়িতে Phase Wake আপডেট করো।"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ažuriraj Phase Wake na satu kako bi svaki alarm zvonio kako je podešen."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Actualitza Phase Wake al rellotge perquè cada alarma soni tal com l’has configurat."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktualizuj Phase Wake v hodinkách, aby každý budík zvonil tak, jak je nastavený."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Opdater Phase Wake på uret, så hver alarm ringer som indstillet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktualisiere Phase Wake auf der Uhr, damit alle Wecker wie eingestellt klingeln."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ενημέρωσε το Phase Wake στο ρολόι, ώστε κάθε αφύπνιση να χτυπά όπως τη ρύθμισες."
          }
        },
