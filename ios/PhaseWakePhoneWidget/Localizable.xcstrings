            "state": "translated",
            "value": "Ekki læknisfræðilegt mat."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è una valutazione medica."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "医学的な評価ではありません。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ეს არ არის სამედიცინო შეფასება."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Медициналық баға емес."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "មិនមែនជាការវាយតម្លៃវេជ្ជសាស្ត្រទេ។"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಇದು ವೈದ್ಯಕೀಯ ಮೌಲ್ಯಮಾಪನವಲ್ಲ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "의학적 평가가 아니에요."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ບໍ່ແມ່ນການປະເມີນທາງການແພດ."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Tai ne medicininis vertinimas."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tas nav medicīnisks vērtējums."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не е медицинска проценка."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഇതൊരു വൈദ്യ വിലയിരുത്തലല്ല."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Эмнэлгийн үнэлгээ биш."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "हे वैद्यकीय मूल्यमापन नाही."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Bukan penilaian perubatan."
          }
        },
        "my": {
          "stringUnit": {
            "state": "translated",
            "value": "ဆေးပညာဆိုင်ရာ အကဲဖြတ်ချက် မဟုတ်ပါ။"
