    "check_backup_horizon_text": {
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Maak Phase Wake oop sodat jou iPhone die volgende wekkers kan stel."
          }
        },
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhoneዎ ቀጣዮቹን ማንቂያዎች እንዲያዘጋጅ Phase Wakeን ይክፈቱ።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "افتح Phase Wake ليضبط iPhone المنبّهات التالية."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone növbəti siqnalları qursun deyə Phase Wake-i açın."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Отвори Phase Wake, за да може iPhone да настрои следващите будилници."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake খুলুন, যাতে আপনার iPhone পরের অ্যালার্মগুলো সেট করতে পারে।"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Otvori Phase Wake kako bi iPhone postavio sljedeće alarme."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Obre Phase Wake perquè l’iPhone pugui programar les properes alarmes."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Otevři Phase Wake, aby iPhone mohl nastavit další budíky."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Åbn Phase Wake, så din iPhone kan indstille de næste alarmer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne Phase Wake, damit das iPhone die nächsten Wecker stellt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Άνοιξε το Phase Wake, ώστε το iPhone να ορίσει τα επόμενα ξυπνητήρια."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Phase Wake so your iPhone can set the next alarms."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre Phase Wake para que tu iPhone programe las próximas alarmas."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Ava Phase Wake, et iPhone saaks järgmised äratused seada."
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ireki Phase Wake, iPhoneak hurrengo alarmak ezar ditzan."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake را باز کن تا iPhone زنگ‌های بعدی را تنظیم کند."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Avaa Phase Wake, jotta iPhone voi asettaa seuraavat herätykset."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Buksan ang Phase Wake para maitakda ng iPhone mo ang mga susunod na alarm."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvre Phase Wake pour que ton iPhone programme les prochaines alarmes."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Oscail Phase Wake ionas gur féidir le d’iPhone na chéad aláraim eile a shocrú."
          }
        },
        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre Phase Wake para que o iPhone programe as próximas alarmas."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake ખોલો, જેથી તમારો iPhone આગળના એલાર્મ સેટ કરી શકે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "פתח את Phase Wake כדי שה-iPhone יגדיר את המעוררים הבאים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake खोलें, ताकि आपका iPhone अगले अलार्म सेट कर सके।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Otvori Phase Wake kako bi iPhone postavio sljedeće alarme."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nyisd meg a Phase Wake-et, hogy az iPhone beállíthassa a következő ébresztőket."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Բացիր Phase Wake-ը, որպեսզի iPhone-ը սահմանի հաջորդ զարթուցիչները։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Buka Phase Wake agar iPhone dapat menyetel alarm berikutnya."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Opnaðu Phase Wake svo iPhone geti stillt næstu vekjara."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apri Phase Wake perché l’iPhone imposti le prossime sveglie."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone が次のアラームを設定できるよう、Phase Wake を開いてください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "გახსენი Phase Wake, რომ iPhone-მა შემდეგი მაღვიძარები დააყენოს."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
