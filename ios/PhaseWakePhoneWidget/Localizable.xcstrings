    "test_hint": {
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Lui oor 2 minute met die instellings van jou volgende wekker, sonder sluimer. Tel nie as ’n nag nie."
          }
        },
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "በሚቀጥለው ማንቂያዎ ቅንብሮች በ2 ደቂቃ ውስጥ ይደውላል፣ ያለ ማሸለብ። እንደ ሌሊት አይቆጠርም።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يرنّ بعد دقيقتين بإعدادات منبّهك التالي، دون غفوة. لا يُحتسب ليلة."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Növbəti siqnalının ayarları ilə 2 dəqiqədən sonra çalır, təxirəsiz. Gecə kimi sayılmır."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Звъни след 2 минути с настройките на следващия ти будилник, без отлагане. Не се брои за нощ."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "তোমার পরের অ্যালার্মের সেটিংস দিয়ে ২ মিনিটে বাজে, স্নুজ ছাড়া। রাত হিসেবে গোনা হয় না।"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zvoni za 2 minute s postavkama tvog sljedećeg alarma, bez odgode. Ne računa se kao noć."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Sona d’aquí a 2 minuts amb la configuració de la teva alarma següent, sense posposar. No compta com a nit."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zazvoní za 2 minuty s nastavením tvého dalšího budíku, bez odložení. Nepočítá se jako noc."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ringer om 2 minutter med indstillingerne for din næste alarm, uden udsættelse. Tæller ikke som en nat."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Klingelt in 2 Minuten mit den Einstellungen deines nächsten Weckers, ohne Schlummern. Zählt nicht als Nacht."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Χτυπά σε 2 λεπτά με τις ρυθμίσεις της επόμενης αφύπνισής σου, χωρίς αναβολή. Δεν μετράει ως νύχτα."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rings in 2 minutes with the settings of your next alarm, without snoozing. Doesn’t count as a night."
          }
        },
        "es": {
