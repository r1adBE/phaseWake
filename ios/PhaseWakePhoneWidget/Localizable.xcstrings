        },
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "ተቆጥሯል፣ ግን ምት በጣም ትንሽ ነው – ምናልባት አልተለበሰም"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "احتُسبت، لكن النبض شبه معدوم – ربما لم تُرتدَ الساعة"
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Sayıldı, amma nəbz demək olar ki, yoxdur – yəqin taxılmayıb"
