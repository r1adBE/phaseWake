    "hint_calm": {
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Die meting was volledig – jy het eenvoudig rustig geslaap. Phase Wake maak jou dan betroubaar op teikentyd wakker."
          }
        },
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "ልኬቱ የተሟላ ነበር – በቀላሉ በሰላም ተኝተዋል። ያኔ Phase Wake በታለመው ሰዓት በአስተማማኝ ሁኔታ ይቀሰቅስዎታል።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كان القياس كاملًا – لقد نمت نومًا هادئًا ببساطة. عندها يوقظك Phase Wake بدقة في الموعد."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Ölçmə tam idi – sadəcə sakit yatmısan. Belə olanda Phase Wake səni etibarlı şəkildə hədəf vaxtında oyadır."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Измерването беше пълно – просто сънят ти беше спокоен. Тогава Phase Wake те събужда сигурно в целевия час."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "মাপ সম্পূর্ণ ছিল – তুমি শুধু শান্তভাবে ঘুমিয়েছ। তখন Phase Wake তোমাকে নির্ভরযোগ্যভাবে লক্ষ্য সময়ে জাগায়।"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Mjerenje je bilo potpuno – san ti je jednostavno bio miran. Phase Wake te tada pouzdano budi u ciljno vrijeme."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "La mesura era completa – simplement has dormit tranquil·lament. Llavors Phase Wake et desperta amb seguretat a l’hora objectiu."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Měření bylo úplné – prostě jsi spal(a) klidně. Phase Wake tě pak spolehlivě vzbudí v cílový čas."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Målingen var komplet – du sov bare roligt. Så vækker Phase Wake dig pålideligt på ønsket tid."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Messung war vollständig – du hast einfach ruhig geschlafen. Phase Wake weckt dich dann zuverlässig zur Zielzeit."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η μέτρηση ήταν πλήρης – απλώς κοιμήθηκες ήρεμα. Τότε το Phase Wake σε ξυπνά αξιόπιστα στην ώρα στόχου."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The measurement was complete – you simply slept calmly. Phase Wake then reliably wakes you at the target time."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La medición estuvo completa: simplemente dormiste tranquilo. Entonces Phase Wake te despierta de forma fiable a la hora objetivo."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Mõõtmine oli täielik – sa lihtsalt magasid rahulikult. Siis äratab Phase Wake sind kindlalt sihtajal."
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "Neurketa osoa izan zen – lasai egin zenuen lo, besterik ez. Halakoetan, Phase Wake-k helburuko orduan esnatuko zaitu, ziur."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "اندازه‌گیری کامل بود – تو فقط آرام خوابیدی. در این صورت Phase Wake مطمئناً تو را در زمان هدف بیدار می‌کند."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mittaus oli täydellinen – nukuit vain rauhallisesti. Silloin Phase Wake herättää sinut luotettavasti tavoiteaikana."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Kumpleto ang pagsukat – mahimbing lang talaga ang tulog mo. Sa ganitong kaso, maaasahang gigisingin ka ng Phase Wake sa target na oras."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La mesure était complète : tu as simplement dormi d'un sommeil calme. Phase Wake te réveille alors de façon fiable à l'heure cible."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Bhí an tomhas iomlán – chodail tú go suaimhneach, sin an méid. Ansin dúiseoidh Phase Wake thú go cinnte ag an spriocam."
          }
        },
        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "A medición foi completa – simplemente durmiches tranquilo. Nese caso Phase Wake espértate sen falta á hora prevista."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "માપ પૂરું હતું – તમે બસ શાંતિથી ઊંઘ્યા. ત્યારે Phase Wake તમને લક્ષ્ય સમયે ચોક્કસ જગાડે છે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "המדידה הייתה מלאה – פשוט הייתה שינה רגועה. במקרה כזה Phase Wake מעירה בצורה אמינה בשעת היעד."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "माप पूरा था – बस नींद शांत रही। ऐसे में Phase Wake आपको लक्ष्य समय पर भरोसेमंद ढंग से जगाता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mjerenje je bilo potpuno – san ti je jednostavno bio miran. Phase Wake te tada pouzdano budi u ciljno vrijeme."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A mérés teljes volt – egyszerűen nyugodtan aludtál. Ilyenkor a Phase Wake megbízhatóan felébreszt a célidőben."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Չափումն ամբողջական էր – պարզապես հանգիստ ես քնել։ Այդ դեպքում Phase Wake-ը քեզ հուսալիորեն արթնացնում է նպատակային ժամին։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pengukurannya lengkap – kamu hanya tidur dengan tenang. Dalam kasus ini, Phase Wake tetap membangunkanmu dengan andal pada waktu target."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Mælingin var heil – þú svafst einfaldlega rólega. Phase Wake vekur þig þá örugglega á markmiðstíma."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La misurazione era completa: hai semplicemente dormito tranquillo. In questo caso Phase Wake ti sveglia in modo affidabile all'orario obiettivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "計測は完全でした。ただ静かに眠れていたようです。その場合も、Phase Wakeは目標時刻にしっかり起こします。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "გაზომვა სრული იყო – უბრალოდ მშვიდად გეძინა. ასეთ დროს Phase Wake საიმედოდ გაღვიძებს სამიზნე დროს."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Өлшеу толық болды – сен жай ғана тыныш ұйықтадың. Мұндайда Phase Wake сені мақсатты уақытта сенімді түрде оятады."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ការវាស់ពេញលេញ – អ្នកគ្រាន់តែដេកស្ងប់។ ពេលនោះ Phase Wake ដាស់អ្នកដោយទុកចិត្តបាននៅម៉ោងគោលដៅ។"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಅಳತೆ ಪೂರ್ಣವಾಗಿತ್ತು – ನೀವು ಶಾಂತವಾಗಿ ನಿದ್ರಿಸಿದ್ದೀರಿ ಅಷ್ಟೇ. ಆಗ Phase Wake ನಿಮ್ಮನ್ನು ಗುರಿ ಸಮಯದಲ್ಲಿ ಖಚಿತವಾಗಿ ಎಬ್ಬಿಸುತ್ತದೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "측정은 온전했어요. 그냥 편안하게 잤을 뿐이에요. 이럴 땐 Phase Wake가 목표 시간에 확실하게 깨워 줘요."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ການວັດແທກຄົບຖ້ວນ – ເຈົ້າພຽງແຕ່ນອນຫຼັບສະຫງົບ ໃນກໍລະນີນີ້ Phase Wake ຈະປຸກເຈົ້າຕອນເວລາເປົ້າໝາຍຢ່າງແນ່ນອນ"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Matavimas buvo išsamus – tiesiog miegojai ramiai. Tada Phase Wake patikimai pažadina tave tiksliniu laiku."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Mērījums bija pilnīgs – tu vienkārši gulēji mierīgi. Tad Phase Wake tevi droši pamodina mērķa laikā."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Мерењето беше целосно – едноставно мирно спиеше. Тогаш Phase Wake сигурно те буди во целното време."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "അളവ് പൂർണമായിരുന്നു – നിങ്ങൾ ശാന്തമായി ഉറങ്ങി എന്നു മാത്രം. അപ്പോൾ Phase Wake ലക്ഷ്യസമയത്ത് ഉറപ്പായും ഉണർത്തും."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Хэмжилт бүрэн байсан – чи зүгээр л тайван унтсан. Ийм үед Phase Wake чамайг зорилтот цагт найдвартай сэрээнэ."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "मोजमाप पूर्ण होते – तुम्ही फक्त शांत झोपलात. अशा वेळी Phase Wake तुम्हाला लक्ष्य वेळेला नक्की उठवते."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pengukuran lengkap – awak hanya tidur dengan lena. Dalam keadaan ini, Phase Wake tetap mengejutkan awak dengan tepat pada masa sasaran."
          }
        },
        "my": {
          "stringUnit": {
            "state": "translated",
            "value": "တိုင်းတာမှု ပြည့်စုံခဲ့သည် – ငြိမ်ငြိမ်လေး အိပ်ခဲ့ရုံသာ။ ထိုအခါ Phase Wake က ပစ်မှတ်အချိန်တွင် သေချာ နှိုးပေးသည်။"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Målingen var komplett – du sov bare rolig. Da vekker Phase Wake deg pålitelig på ønsket tid."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "मापन पूरा थियो – तिमी बस शान्त भएर सुत्यौ। त्यस्तो बेला Phase Wake ले तिमीलाई लक्षित समयमा भरपर्दो रूपमा ब्युँझाउँछ।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De meting was compleet – je sliep gewoon rustig. Dan wekt Phase Wake je betrouwbaar op de doeltijd."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਮਾਪ ਪੂਰਾ ਸੀ – ਤੁਸੀਂ ਬੱਸ ਸ਼ਾਂਤੀ ਨਾਲ ਸੁੱਤੇ। ਅਜਿਹੇ ਵਿੱਚ Phase Wake ਤੁਹਾਨੂੰ ਟੀਚੇ ਦੇ ਸਮੇਂ ’ਤੇ ਪੱਕਾ ਜਗਾਉਂਦਾ ਹੈ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pomiar był kompletny – po prostu spałeś spokojnie. Wtedy Phase Wake budzi cię niezawodnie w czasie docelowym."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A medição estava completa – você simplesmente dormiu tranquilo. Nesse caso, o Phase Wake acorda você com confiança no horário-alvo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A medição estava completa – simplesmente dormiste descansado. Nesse caso, o Phase Wake acorda-te com fiabilidade à hora-alvo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Măsurătoarea a fost completă – pur și simplu ai dormit liniștit. Atunci Phase Wake te trezește sigur la ora țintă."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Измерение было полным – ты просто спокойно спал. Тогда Phase Wake надёжно разбудит тебя в целевое время."
          }
        },
        "si": {
          "stringUnit": {
            "state": "translated",
            "value": "මිනුම සම්පූර්ණයි – ඔබ හුදෙක් සන්සුන්ව නිදා ගත්තා. එවිට Phase Wake ඔබව ඉලක්ක වේලාවට විශ්වාසදායක ලෙස අවදි කරයි."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Meranie bolo úplné – tvoj spánok bol jednoducho pokojný. Phase Wake ťa potom spoľahlivo zobudí v cieľový čas."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Meritev je bila popolna – spanec je bil preprosto miren. Phase Wake te takrat zanesljivo zbudi ob ciljnem času."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Matja ishte e plotë – thjesht fjete qetë. Në këtë rast Phase Wake të zgjon me siguri në orën e synuar."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Мерење је било потпуно – сан ти је једноставно био миран. Phase Wake те тада поуздано буди у циљно време."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Mätningen var komplett – du sov helt enkelt lugnt. Då väcker Phase Wake dig pålitligt vid önskad tid."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Kipimo kilikuwa kamili – ulilala tu kwa utulivu. Hapo Phase Wake inakuamsha kwa uhakika kwa muda lengwa."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "அளவீடு முழுமையாக இருந்தது – நீங்கள் அமைதியாகத் தூங்கினீர்கள். அப்போது Phase Wake உங்களை இலக்கு நேரத்தில் நம்பகமாக எழுப்பும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "కొలత పూర్తిగా ఉంది – మీరు ప్రశాంతంగా నిద్రపోయారు, అంతే. అలాంటప్పుడు Phase Wake మిమ్మల్ని లక్ష్య సమయానికి కచ్చితంగా లేపుతుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การวัดครบถ้วนดี คุณเพียงแค่หลับสบายเท่านั้น กรณีนี้ Phase Wake จะปลุกคุณได้อย่างแม่นยำตรงเวลาเป้าหมาย"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ölçüm eksiksizdi – sadece sakin uyudun. Bu durumda Phase Wake seni hedef saatte güvenilir şekilde uyandırır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вимірювання було повним – ти просто спокійно спав. Тоді Phase Wake надійно розбудить тебе в цільовий час."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "پیمائش مکمل تھی – تم بس سکون سے سوئے۔ ایسے میں Phase Wake تمہیں ہدف کے وقت پر یقینی طور پر جگاتا ہے۔"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Oʻlchov toʻliq edi – shunchaki tinch uxlading. Bunday holda Phase Wake seni belgilangan vaqtda ishonchli uygʻotadi."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phép đo đầy đủ – bạn chỉ đơn giản là ngủ yên. Khi đó Phase Wake vẫn đánh thức bạn đúng lúc vào giờ mục tiêu."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "測量是完整的 – 你只是睡得很安穩。這時 Phase Wake 會在目標時間準時叫醒你。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "测量是完整的——你只是睡得很安稳。这时 Phase Wake 会在目标时间可靠地叫醒你。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "測量是完整的——你只是睡得很安穩。這時 Phase Wake 會在目標時間可靠地叫醒你。"
          }
        },
        "zu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ukulinganisa bekuphelele – umane walala ngokuthula. I-Phase Wake ibe isikuvusa ngokuthembekile ngesikhathi esihlosiwe."
          }
        }
      }
    },
    "hint_gaps": {
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Daar was gapings in die meting. Het die horlosie snags gelaai of was dit af?"
          }
        },
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "በልኬቱ ውስጥ ክፍተቶች ነበሩ። ሰዓቱ ማታ ኃይል እየሞላ ወይም ጠፍቶ ነበር?"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كانت هناك فجوات في القياس. هل كانت الساعة قيد الشحن أو غير مرتدية ليلًا؟"
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Ölçmədə boşluqlar olub. Saat gecə şarjda idi, yoxsa sönülü?"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "В измерването имаше пропуски. Зареждаше ли се часовникът през нощта, или беше свален?"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "মাপে ফাঁক ছিল। রাতে কি ঘড়ি চার্জে ছিল বা খোলা ছিল?"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "U mjerenju je bilo praznina. Je li se sat noću punio ili je bio skinut?"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Hi va haver buits en la mesura. El rellotge es carregava o te l’havies tret durant la nit?"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Měření mělo mezery. Nabíjely se hodinky přes noc, nebo byly sundané?"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Målingen havde huller. Var uret på opladeren eller taget af om natten?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Messung hatte Lücken. War die Uhr nachts am Laden oder abgelegt?"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η μέτρηση είχε κενά. Το ρολόι φόρτιζε ή ήταν βγαλμένο τη νύχτα;"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There were gaps in the measurement. Was the watch charging or off at night?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La medición tuvo huecos. ¿El reloj estaba cargando o te lo quitaste por la noche?"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Mõõtmises oli lünki. Kas kell laadis öösel või oli väljas?"
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "Hutsuneak egon ziren neurketan. Kargatzen edo itzalita zegoen erlojua gauean?"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "اندازه‌گیری وقفه داشت. ساعت شب شارژ بود یا از مچ درآمده بود؟"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mittauksessa oli aukkoja. Latautuiko kello yöllä vai oliko se pois ranteesta?"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "May mga puwang sa pagsukat. Nagcha-charge ba o naka-off ang relo noong gabi?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La mesure comportait des trous. La montre était-elle en charge ou retirée la nuit ?"
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Bhí bearnaí sa tomhas. An raibh an t-uaireadóir á luchtú nó múchta san oíche?"
          }
        },
        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "Houbo ocos na medición. Estaba o reloxo cargando ou apagado pola noite?"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "માપમાં ખાલી જગ્યાઓ હતી. શું રાત્રે ઘડિયાળ ચાર્જ થઈ રહી હતી કે બંધ હતી?"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "במדידה היו חוסרים. השעון היה בטעינה או לא על היד בלילה?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "माप में कुछ अंतराल थे। क्या रात में घड़ी चार्ज हो रही थी या उतारी हुई थी?"
          }
        },
        "hr": {
          "stringUnit": {
