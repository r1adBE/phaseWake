    "widget_description": {
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Jou volgende wekker en die nagtoets."
          }
        },
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "ቀጣዩ ማንቂያዎ እና የሌሊት ፍተሻ።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "منبّهك التالي وفحص الليل."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Növbəti siqnalın və gecə yoxlaması."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Следващият ти будилник и нощната проверка."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "তোমার পরের অ্যালার্ম আর রাতের চেক।"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tvoj sljedeći alarm i noćna provjera."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "La teva propera alarma i el control nocturn."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tvůj další budík a noční kontrola."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Din næste alarm og nattjekket."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein nächster Wecker und der Nacht-Check."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η επόμενη αφύπνισή σου και ο νυχτερινός έλεγχος."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your next alarm and the night check."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu próxima alarma y la revisión nocturna."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Sinu järgmine äratus ja öine kontroll."
          }
        },
        "eu": {
