        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಅಂದಾಜು ರಜಾದಿನ: %1$@ – ಅಲಾರಂ ಮೊಳಗುತ್ತದೆ. ರಜೆ ಇದ್ದರೆ, ದಿನವನ್ನು ನೀವೇ ಬಿಟ್ಟುಬಿಡಿ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "예상 공휴일: %1$@ – 알람이 울립니다. 쉬는 날이면 직접 건너뛰세요."
