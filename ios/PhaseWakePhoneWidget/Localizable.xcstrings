        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Becsült ünnepnap: %1$@ – az ébresztő megszólal. Ha szabadnapod van, hagyd ki magad a napot."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Մոտավոր տոն՝ %1$@ – զարթուցիչը կզնգա։ Եթե ազատ ես, ինքդ բաց թող այդ օրը։"
