        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld ночей Phase Wake вимірює твоїм годинником, щоб підлаштувати будильник під тебе. Носи його вночі із зарядом щонайменше %2$lld %%."
