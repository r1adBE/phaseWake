    "check_watch_app_problem": {
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Jou horlosie is gekoppel, maar Phase Wake is nog nie daarop geïnstalleer nie."
          }
        },
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "ሰዓትዎ ተገናኝቷል፣ ነገር ግን Phase Wake እስካሁን በላዩ ላይ አልተጫነም።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ساعتك متصلة، لكن Phase Wake غير مثبّت عليها بعد."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Saatın qoşulub, amma Phase Wake hələ ona quraşdırılmayıb."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Часовникът е свързан, но Phase Wake още не е инсталирано на него."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "তোমার ঘড়ি সংযুক্ত, কিন্তু এতে এখনও Phase Wake ইনস্টল করা হয়নি।"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Sat je povezan, ali Phase Wake na njemu još nije instaliran."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "El rellotge està connectat, però encara no hi tens Phase Wake instal·lat."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Hodinky jsou připojené, ale Phase Wake v nich ještě není nainstalovaný."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit ur er forbundet, men Phase Wake er endnu ikke installeret på det."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Uhr ist verbunden, aber Phase Wake ist dort noch nicht installiert."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το ρολόι σου είναι συνδεδεμένο, αλλά το Phase Wake δεν έχει εγκατασταθεί ακόμα σε αυτό."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your watch is connected, but Phase Wake isn't installed on it yet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu reloj está conectado, pero Phase Wake aún no está instalado en él."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kell on ühendatud, kuid Phase Wake pole sinna veel installitud."
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "Erlojua konektatuta dago, baina Phase Wake ez dago oraindik instalatuta bertan."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "ساعتت متصل است، اما Phase Wake هنوز روی آن نصب نشده است."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kellosi on yhdistetty, mutta Phase Wakea ei ole vielä asennettu siihen."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Nakakonekta ang relo mo, pero hindi pa naka-install dito ang Phase Wake."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta montre est connectée, mais Phase Wake n'y est pas encore installé."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Tá d’uaireadóir ceangailte, ach níl Phase Wake suiteáilte air fós."
          }
        },
        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "O reloxo está conectado, pero Phase Wake aínda non está instalado nel."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તમારી ઘડિયાળ કનેક્ટ છે, પણ તેના પર હજી Phase Wake ઇન્સ્ટૉલ નથી."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "השעון שלכם מחובר, אבל Phase Wake עדיין לא מותקן בו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपकी वॉच कनेक्टेड है, लेकिन उस पर अभी Phase Wake इंस्टॉल नहीं है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sat je povezan, ali Phase Wake na njemu još nije instaliran."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az órád csatlakoztatva van, de a Phase Wake még nincs telepítve rá."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ժամացույցդ միացված է, բայց Phase Wake-ը դեռ տեղադրված չէ դրա վրա։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jam tanganmu terhubung, tetapi Phase Wake belum terpasang di jam tangan."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Úrið er tengt en Phase Wake er ekki enn sett upp á því."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo orologio è connesso, ma Phase Wake non è ancora installato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ウォッチは接続されていますが、Phase Wakeがまだインストールされていません。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "საათი დაკავშირებულია, მაგრამ Phase Wake მასზე ჯერ არ არის დაინსტალირებული."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сағатың қосылған, бірақ оған Phase Wake әлі орнатылмаған."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "នាឡិកាបានភ្ជាប់ ប៉ុន្តែមិនទាន់បានដំឡើង Phase Wake លើវាទេ។"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನಿಮ್ಮ ವಾಚ್ ಸಂಪರ್ಕಗೊಂಡಿದೆ, ಆದರೆ ಅದರಲ್ಲಿ Phase Wake ಇನ್ನೂ ಇನ್‌ಸ್ಟಾಲ್ ಆಗಿಲ್ಲ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "워치가 연결되어 있지만 아직 워치에 Phase Wake가 설치되지 않았어요."
          }
        },
        "lo": {
          "stringUnit": {
