        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Festivo stimato: %1$@ – la sveglia suonerà. Se sei libero, salta tu il giorno."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "推定の祝日: %1$@ – アラームは鳴ります。休みの場合は自分でスキップしてください。"
