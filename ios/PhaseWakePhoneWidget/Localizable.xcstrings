        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "मागील %2$lld रात्रीपैकी %1$lld रात्री कालावधीत हलकी झोप नव्हती. %3$lld मि. ठेवल्यास तुम्ही अधिक वेळा योग्य क्षणी उठाल."
