    "settings_backup_hint": {
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Geënkripteerde lêer met wekkers, geskiedenis, notas en instellings. Sonder klanksnitte en gesondheidsdata."
          }
        },
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "ማንቂያዎች፣ ታሪክ፣ ማስታወሻዎች እና ቅንብሮች ያሉት የተመሰጠረ ፋይል። ያለ የድምፅ ቅንጥቦችና የጤና ውሂብ።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ملف مشفّر بالمنبّهات والسجل والملاحظات والإعدادات. دون الأصوات وبيانات الصحة."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Siqnallar, tarixçə, qeydlər və ayarlarla şifrələnmiş fayl. Səs klipləri və sağlamlıq məlumatları olmadan."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Шифрован файл с будилници, история, бележки и настройки. Без звукови записи и здравни данни."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অ্যালার্ম, ইতিহাস, নোট আর সেটিংস সহ এনক্রিপ্ট করা ফাইল। শব্দের ক্লিপ আর স্বাস্থ্য ডেটা ছাড়া।"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Šifrirana datoteka s alarmima, historijom, bilješkama i postavkama. Bez zvučnih isječaka i zdravstvenih podataka."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Fitxer xifrat amb alarmes, historial, notes i configuració. Sense fragments de so ni dades de salut."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Šifrovaný soubor s budíky, historií, poznámkami a nastavením. Bez nahrávek a zdravotních dat."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Krypteret fil med alarmer, historik, noter og indstillinger. Uden lyde og sundhedsdata."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verschlüsselte Datei mit Weckern, Verlauf, Notizen und Einstellungen. Ohne Geräusche und Gesundheitsdaten."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κρυπτογραφημένο αρχείο με αφυπνίσεις, ιστορικό, σημειώσεις και ρυθμίσεις. Χωρίς ήχους και δεδομένα υγείας."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Encrypted file with alarms, history, notes and settings. Without sound clips and health data."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Archivo cifrado con alarmas, historial, notas y ajustes. Sin sonidos ni datos de salud."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Krüpteeritud fail äratuste, ajaloo, märkmete ja seadetega. Ilma heliklippide ja terviseandmeteta."
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "Fitxategi enkriptatua alarmekin, historiarekin, oharrekin eta ezarpenekin. Soinu-klipik eta osasun-daturik gabe."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "فایل رمزگذاری‌شده با زنگ‌ها، سابقه، یادداشت‌ها و تنظیمات. بدون صداها و داده‌های سلامت."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Salattu tiedosto, jossa herätykset, historia, muistiinpanot ja asetukset. Ilman ääniä ja terveystietoja."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Naka-encrypt na file na may mga alarm, kasaysayan, tala, at setting. Walang sound clip at health data."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fichier chiffré avec réveils, historique, notes et réglages. Sans extraits sonores ni données de santé."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Comhad criptithe le haláraim, stair, nótaí agus socruithe. Gan gearrthóga fuaime ná sonraí sláinte."
          }
        },
        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ficheiro cifrado con alarmas, historial, notas e axustes. Sen fragmentos de son nin datos de saúde."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "એલાર્મ, ઇતિહાસ, નોંધો અને સેટિંગ સાથેની એન્ક્રિપ્ટ કરેલી ફાઇલ. અવાજની ક્લિપ અને હેલ્થ ડેટા વગર."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "קובץ מוצפן עם השכמות, היסטוריה, הערות והגדרות. בלי צלילים ונתוני בריאות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अलार्म, इतिहास, नोट और सेटिंग वाली एन्क्रिप्टेड फ़ाइल। आवाज़ों और स्वास्थ्य डेटा के बिना।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Šifrirana datoteka s alarmima, poviješću, bilješkama i postavkama. Bez zvučnih isječaka i zdravstvenih podataka."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Titkosított fájl ébresztőkkel, előzményekkel, jegyzetekkel és beállításokkal. Hangok és egészségügyi adatok nélkül."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Գաղտնագրված ֆայլ՝ զարթուցիչներով, պատմությամբ, նշումներով և կարգավորումներով։ Առանց ձայնային հատվածների և առողջության տվյալների։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "File terenkripsi berisi alarm, riwayat, catatan, dan setelan. Tanpa suara dan data kesehatan."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Dulkóðuð skrá með vekjurum, ferli, athugasemdum og stillingum. Án hljóðupptaka og heilsugagna."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "File cifrato con sveglie, cronologia, note e impostazioni. Senza audio e dati sanitari."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アラーム、履歴、メモ、設定を含む暗号化ファイル。音声と健康データは含みません。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "დაშიფრული ფაილი მაღვიძარებით, ისტორიით, შენიშვნებითა და პარამეტრებით. ხმის ფრაგმენტებისა და ჯანმრთელობის მონაცემების გარეშე."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Оятқыштар, тарих, жазбалар мен параметрлер бар шифрланған файл. Дыбыс үзінділері мен денсаулық деректерінсіз."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ឯកសារដែលបានអ៊ិនគ្រីប មានម៉ោងរោទ៍ ប្រវត្តិ កំណត់ចំណាំ និងការកំណត់។ គ្មានឃ្លីបសំឡេង និងទិន្នន័យសុខភាព។"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಅಲಾರಾಂಗಳು, ಇತಿಹಾಸ, ಟಿಪ್ಪಣಿಗಳು ಮತ್ತು ಸೆಟ್ಟಿಂಗ್‌ಗಳಿರುವ ಎನ್‌ಕ್ರಿಪ್ಟ್ ಮಾಡಿದ ಫೈಲ್. ಶಬ್ದ ಕ್ಲಿಪ್‌ಗಳು ಮತ್ತು ಆರೋಗ್ಯ ಡೇಟಾ ಇಲ್ಲದೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "알람, 기록, 메모, 설정이 담긴 암호화 파일. 소리와 건강 데이터는 제외."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ໄຟລ໌ເຂົ້າລະຫັດທີ່ມີໂມງປຸກ ປະຫວັດ ບັນທຶກ ແລະ ການຕັ້ງຄ່າ ບໍ່ມີຄລິບສຽງ ແລະ ຂໍ້ມູນສຸຂະພາບ"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Užšifruotas failas su žadintuvais, istorija, pastabomis ir nustatymais. Be garso įrašų ir sveikatos duomenų."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Šifrēts fails ar modinātājiem, vēsturi, piezīmēm un iestatījumiem. Bez skaņu fragmentiem un veselības datiem."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Шифрирана датотека со аларми, историја, белешки и поставки. Без снимки на звуци и здравствени податоци."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "അലാറങ്ങൾ, ചരിത്രം, കുറിപ്പുകൾ, ക്രമീകരണം എന്നിവയുള്ള എൻക്രിപ്റ്റ് ചെയ്‌ത ഫയൽ. ശബ്ദ ക്ലിപ്പുകളും ആരോഗ്യ ഡാറ്റയും ഇല്ലാതെ."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Сэрүүлэг, түүх, тэмдэглэл, тохиргоотой шифрлэгдсэн файл. Дууны хэсэг болон эрүүл мэндийн өгөгдөлгүй."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "अलार्म, इतिहास, नोंदी आणि सेटिंग्ज असलेली एन्क्रिप्टेड फाइल. आवाजाच्या क्लिप आणि हेल्थ डेटाशिवाय."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Fail tersulit dengan penggera, sejarah, nota dan tetapan. Tanpa bunyi dan data kesihatan."
          }
        },
        "my": {
          "stringUnit": {
            "state": "translated",
            "value": "နှိုးစက်၊ မှတ်တမ်း၊ မှတ်စုနှင့် ဆက်တင်များပါသော ကုဒ်ပြောင်းထားသည့် ဖိုင်။ အသံဖိုင်နှင့် ကျန်းမာရေးဒေတာ မပါ။"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kryptert fil med alarmer, historikk, notater og innstillinger. Uten lyder og helsedata."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "अलार्म, इतिहास, नोट र सेटिङसहितको इन्क्रिप्टेड फाइल। आवाजका क्लिप र स्वास्थ्य डेटा बिना।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Versleuteld bestand met wekkers, geschiedenis, notities en instellingen. Zonder geluiden en gezondheidsgegevens."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਅਲਾਰਮਾਂ, ਇਤਿਹਾਸ, ਨੋਟਾਂ ਅਤੇ ਸੈਟਿੰਗਾਂ ਵਾਲੀ ਇਨਕ੍ਰਿਪਟ ਕੀਤੀ ਫ਼ਾਈਲ। ਆਵਾਜ਼ ਦੀਆਂ ਕਲਿੱਪਾਂ ਅਤੇ ਸਿਹਤ ਡਾਟੇ ਤੋਂ ਬਿਨਾਂ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaszyfrowany plik z budzikami, historią, notatkami i ustawieniami. Bez nagrań i danych zdrowotnych."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Arquivo criptografado com alarmes, histórico, notas e configurações. Sem sons e dados de saúde."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ficheiro encriptado com alarmes, histórico, notas e definições. Sem sons nem dados de saúde."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Fișier criptat cu alarme, istoric, notițe și setări. Fără sunete și date de sănătate."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Зашифрованный файл с будильниками, историей, заметками и настройками. Без записей звуков и данных о здоровье."
          }
        },
        "si": {
          "stringUnit": {
            "state": "translated",
            "value": "එලාම, ඉතිහාසය, සටහන් සහ සැකසීම් සහිත සංකේතිත ගොනුවක්. ශබ්ද කොටස් සහ සෞඛ්‍ය දත්ත නොමැතිව."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Šifrovaný súbor s budíkmi, históriou, poznámkami a nastaveniami. Bez zvukových záznamov a zdravotných údajov."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Šifrirana datoteka z budilkami, zgodovino, opombami in nastavitvami. Brez zvočnih posnetkov in zdravstvenih podatkov."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Skedar i enkriptuar me alarmet, historikun, shënimet dhe cilësimet. Pa fragmente tingujsh dhe pa të dhëna shëndeti."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Шифрована датотека са алармима, историјом, белешкама и подешавањима. Без звучних исечака и здравствених података."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Krypterad fil med alarm, historik, anteckningar och inställningar. Utan ljud och hälsodata."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Faili iliyosimbwa yenye kengele, historia, madokezo na mipangilio. Bila vipande vya sauti wala data ya afya."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "அலாரங்கள், வரலாறு, குறிப்புகள், அமைப்புகள் அடங்கிய மறைகுறியாக்கப்பட்ட கோப்பு. ஒலி கிளிப்புகளும் ஆரோக்கியத் தரவும் இல்லாமல்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "అలారాలు, చరిత్ర, గమనికలు, సెట్టింగ్‌లతో ఎన్‌క్రిప్ట్ చేసిన ఫైల్. ధ్వని క్లిప్‌లు, హెల్త్ డేటా లేకుండా."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไฟล์เข้ารหัสที่มีการปลุก ประวัติ บันทึก และการตั้งค่า ไม่รวมเสียงและข้อมูลสุขภาพ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Alarmlar, geçmiş, notlar ve ayarlarla şifreli dosya. Ses kayıtları ve sağlık verileri olmadan."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зашифрований файл із будильниками, історією, нотатками й налаштуваннями. Без звуків і даних про здоров’я."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "الارم، تاریخچہ، نوٹس اور ترتیبات والی خفیہ کردہ فائل۔ آواز کے کلپس اور صحت کے ڈیٹا کے بغیر۔"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Budilniklar, tarix, qaydlar va sozlamalar bilan shifrlangan fayl. Tovush parchalari va sogʻliq maʼlumotlarisiz."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tệp mã hóa gồm báo thức, lịch sử, ghi chú và cài đặt. Không có âm thanh và dữ liệu sức khỏe."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "加密檔案，包含鬧鐘、記錄、備註和設定。不含聲音片段和健康數據。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "加密文件，包含闹钟、记录、笔记和设置。不含声音片段和健康数据。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "加密檔案，包含鬧鐘、紀錄、筆記和設定。不含聲音片段和健康資料。"
          }
        },
        "zu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ifayela elibethelwe elinama-alamu, umlando, amanothi nezilungiselelo. Ngaphandle kweziqeshana zomsindo nedatha yezempilo."
          }
        }
      }
    },
