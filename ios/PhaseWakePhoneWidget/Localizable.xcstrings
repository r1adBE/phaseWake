    "wake_task_hint": {
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Los 3 somme op voordat die wekker stil word. Sluimer werk sonder taak."
          }
        },
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "ማንቂያው ጸጥ ከማለቱ በፊት 3 የመደመር ጥያቄዎችን ይፍቱ። ማሸለብ ያለ ተግባር ይሠራል።"
