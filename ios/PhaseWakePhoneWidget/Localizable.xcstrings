        },
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "ሰዓት ተገናኝቷል፣ ማንቂያዎች ተፈቅደዋል። ለዝርዝሮች ይንኩ።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الساعة متصلة والمنبهات مسموحة. اضغط للتفاصيل."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Saat qoşulub, siqnallara icazə var. Təfərrüat üçün toxun."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Часовникът е свързан, будилниците са разрешени. Докосни за подробности."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ঘড়ি সংযুক্ত, অ্যালার্মের অনুমতি আছে। বিস্তারিত দেখতে ট্যাপ করো।"
