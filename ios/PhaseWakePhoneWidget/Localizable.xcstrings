        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಮೊದಲೇ ಏಳುವುದು ನಿಮಗೆ ಒಳ್ಳೆಯದೇ ಎಂದು ಕಾಲಕ್ರಮೇಣ ತಿಳಿಯುತ್ತದೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시간이 지나면 더 일찍 깨는 게 도움이 되는지 알 수 있어요."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ເມື່ອເວລາຜ່ານໄປ ເຈົ້າຈະເຫັນວ່າການປຸກໄວກວ່າດີຕໍ່ເຈົ້າຫຼືບໍ່"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ilgainiui pamatysi, ar ankstesnis pažadinimas tau į naudą."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Laika gaitā redzēsi, vai agrāka modināšana tev nāk par labu."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Со текот на времето ќе видиш дали порано будење ти прија."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നേരത്തേ ഉണരുന്നത് നിങ്ങൾക്ക് ഗുണം ചെയ്യുന്നുണ്ടോ എന്ന് കാലക്രമേണ കാണാം."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Цаг хугацааны явцад эрт сэрэх нь чамд тустай эсэхийг харна."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "लवकर उठवलं जाणं तुम्हाला फायद्याचं आहे का, हे काही काळाने दिसेल."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Lama-kelamaan awak akan nampak sama ada dikejutkan lebih awal memberi manfaat."
          }
        },
        "my": {
          "stringUnit": {
            "state": "translated",
            "value": "စောစော နှိုးခြင်းက သင့်အတွက် ကောင်းသလား အချိန်ကြာလာလျှင် မြင်ရမည်။"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Over tid ser du om det gjør deg godt å bli vekket tidligere."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "समयसँगै, चाँडै ब्युँझाइँदा तिमीलाई फाइदा हुन्छ कि हुँदैन भनेर देख्नेछौ।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Na verloop van tijd zie je of eerder gewekt worden je goed doet."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਸਮੇਂ ਨਾਲ ਤੁਸੀਂ ਦੇਖੋਗੇ ਕਿ ਪਹਿਲਾਂ ਜਾਗਣਾ ਤੁਹਾਡੇ ਲਈ ਚੰਗਾ ਹੈ ਜਾਂ ਨਹੀਂ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Z czasem zobaczysz, czy wcześniejsze budzenie ci służy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Com o tempo, você verá se acordar mais cedo faz bem a você."
