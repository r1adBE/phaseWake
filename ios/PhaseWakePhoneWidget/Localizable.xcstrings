    "settings_clear_history_text": {
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Vee alle aangetekende nagte op jou foon en horlosie uit. Jou wekkers bly. Nagte uit ander apps word hier net versteek en bly in daardie apps."
          }
        },
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "በስልክዎና በሰዓትዎ ላይ የተመዘገቡ ሁሉንም ሌሊቶች ይሰርዛል። ማንቂያዎችዎ ይቆያሉ። ከሌሎች መተግበሪያዎች የመጡ ሌሊቶች እዚህ የሚደበቁት ብቻ ነው፣ በእነዚያ መተግበሪያዎች ውስጥም ይቆያሉ።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحذف كل الليالي المسجّلة على هاتفك وساعتك. تبقى منبّهاتك كما هي. الليالي من التطبيقات الأخرى تُخفى هنا فقط وتبقى في تلك التطبيقات."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Telefonunda və saatında qeydə alınmış bütün gecələri silir. Siqnalların qalır. Digər tətbiqlərdən gecələr burada yalnız gizlədilir və o tətbiqlərdə qalır."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Изтрива всички записани нощи на телефона и часовника. Будилниците остават. Нощите от други приложения само се скриват тук и остават в тези приложения."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ফোন আর ঘড়িতে রেকর্ড করা সব রাত মুছে যাবে। তোমার অ্যালার্মগুলো থাকবে। অন্য অ্যাপের রাতগুলো এখানে শুধু লুকানো হয় এবং সেই অ্যাপগুলোতেই থেকে যায়।"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Briše sve zabilježene noći na telefonu i satu. Tvoji alarmi ostaju. Noći iz drugih aplikacija ovdje se samo sakrivaju i ostaju u tim aplikacijama."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Suprimeix totes les nits registrades al telèfon i al rellotge. Les alarmes es mantenen. Les nits d’altres apps només s’amaguen aquí i es queden en aquestes apps."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Smaže všechny zaznamenané noci v telefonu a hodinkách. Tvoje budíky zůstanou. Noci z jiných aplikací se tu jen skryjí a zůstanou v těchto aplikacích."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Sletter alle optagede nætter på din telefon og dit ur. Dine alarmer bliver. Nætter fra andre apps skjules kun her og bliver i de apps."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Löscht alle aufgezeichneten Nächte auf Handy und Uhr. Deine Wecker bleiben. Nächte aus anderen Apps werden hier nur ausgeblendet und bleiben in diesen Apps."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Διαγράφει όλες τις καταγεγραμμένες νύχτες στο κινητό και στο ρολόι σου. Τα ξυπνητήρια σου παραμένουν. Οι νύχτες από άλλες εφαρμογές απλώς αποκρύπτονται εδώ και παραμένουν σε εκείνες τις εφαρμογές."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Deletes all recorded nights on your phone and watch. Your alarms stay. Nights from other apps are only hidden here and stay in those apps."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Borra todas las noches registradas en tu móvil y tu reloj. Tus alarmas se mantienen. Las noches de otras apps solo se ocultan aquí y se quedan en esas apps."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kustutab kõik salvestatud ööd telefonist ja kellast. Äratused jäävad alles. Teiste rakenduste ööd peidetakse siin ainult ära ja need jäävad neisse rakendustesse."
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "Telefonoan eta erlojuan erregistratutako gau guztiak ezabatzen ditu. Alarmak mantendu egiten dira. Beste aplikazio batzuetako gauak hemen ezkutatu baino ez dira egiten, eta aplikazio horietan geratzen dira."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "همه شب‌های ثبت‌شده در گوشی و ساعتت پاک می‌شود. زنگ‌های هشدارت می‌مانند. شب‌های برنامه‌های دیگر اینجا فقط پنهان می‌شوند و در همان برنامه‌ها می‌مانند."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Poistaa kaikki tallennetut yöt puhelimesta ja kellosta. Herätyksesi säilyvät. Muiden sovellusten yöt vain piilotetaan täällä, ja ne pysyvät niissä sovelluksissa."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Dine-delete ang lahat ng naitalang gabi sa telepono at relo mo. Mananatili ang mga alarm mo. Itinatago lang dito ang mga gabi mula sa ibang app at nananatili sila sa mga app na iyon."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Efface toutes les nuits enregistrées sur ton téléphone et ta montre. Tes alarmes restent. Les nuits d'autres apps sont seulement masquées ici et restent dans ces apps."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Scriosann sé gach oíche taifeadta ar do fhón agus ar d’uaireadóir. Fanann na haláraim. Ní dhéantar ach oícheanta ó aipeanna eile a cheilt anseo agus fanann siad sna haipeanna sin."
          }
        },
        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimina todas as noites rexistradas no teléfono e no reloxo. As alarmas mantéñense. As noites doutras apps só se ocultan aquí e quedan nesas apps."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ફોન અને ઘડિયાળ પરની બધી નોંધાયેલી રાતો કાઢી નાખે છે. તમારા એલાર્મ રહે છે. અન્ય ઍપની રાતો અહીં ફક્ત છુપાવાય છે અને તે ઍપમાં જ રહે છે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מחיקת כל הלילות שהוקלטו בטלפון ובשעון. המעוררים שלך נשארים. לילות מאפליקציות אחרות רק מוסתרים כאן ונשארים באפליקציות האלה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फ़ोन और वॉच पर रिकॉर्ड की गई सभी रातें हट जाएँगी। तुम्हारे अलार्म बने रहेंगे। दूसरे ऐप की रातें यहाँ सिर्फ़ छिपाई जाती हैं और उन्हीं ऐप में रहती हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Briše sve zabilježene noći na telefonu i satu. Tvoji alarmi ostaju. Noći iz drugih aplikacija ovdje se samo skrivaju i ostaju u tim aplikacijama."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Törli az összes rögzített éjszakát a telefonodon és az órádon. Az ébresztőid megmaradnak. A más alkalmazásokból származó éjszakák itt csak el lesznek rejtve, és megmaradnak azokban az alkalmazásokban."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ջնջում է բոլոր գրանցված գիշերները հեռախոսիդ ու ժամացույցիդ վրա։ Զարթուցիչները մնում են։ Այլ հավելվածների գիշերներն այստեղ միայն թաքցվում են և մնում են այդ հավելվածներում։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menghapus semua malam yang tercatat di ponsel dan jam tanganmu. Alarmmu tetap ada. Malam dari aplikasi lain hanya disembunyikan di sini dan tetap ada di aplikasi tersebut."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Eyðir öllum skráðum nóttum í símanum og úrinu. Vekjararnir haldast. Nætur úr öðrum forritum eru aðeins faldar hér og haldast í þeim forritum."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimina tutte le notti registrate su telefono e orologio. Le tue sveglie restano. Le notti di altre app vengono solo nascoste qui e restano in quelle app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スマホとウォッチに記録されたすべての夜のデータを削除します。アラームはそのまま残ります。ほかのアプリの夜はここで非表示になるだけで、元のアプリに残ります。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "შლის ყველა ჩაწერილ ღამეს ტელეფონსა და საათზე. მაღვიძარები რჩება. სხვა აპების ღამეები აქ მხოლოდ იმალება და იმ აპებში რჩება."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Телефон мен сағаттағы барлық жазылған түндерді жояды. Оятқыштарың сақталады. Басқа қолданбалардың түндері мұнда тек жасырылады және сол қолданбаларда қалады."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "លុបយប់ដែលបានកត់ត្រាទាំងអស់លើទូរសព្ទ និងនាឡិកា។ ម៉ោងរោទ៍របស់អ្នកនៅដដែល។ យប់ពីកម្មវិធីផ្សេងត្រូវបានលាក់នៅទីនេះប៉ុណ្ណោះ ហើយនៅតែមាននៅក្នុងកម្មវិធីទាំងនោះ។"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಫೋನ್ ಮತ್ತು ವಾಚ್‌ನಲ್ಲಿ ದಾಖಲಾದ ಎಲ್ಲಾ ರಾತ್ರಿಗಳನ್ನು ಅಳಿಸುತ್ತದೆ. ನಿಮ್ಮ ಅಲಾರಾಂಗಳು ಉಳಿಯುತ್ತವೆ. ಇತರ ಆ್ಯಪ್‌ಗಳ ರಾತ್ರಿಗಳನ್ನು ಇಲ್ಲಿ ಮರೆಮಾಡಲಾಗುತ್ತದೆ ಮಾತ್ರ, ಅವು ಆ ಆ್ಯಪ್‌ಗಳಲ್ಲೇ ಉಳಿಯುತ್ತವೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "휴대폰과 워치에 기록된 모든 밤 데이터를 삭제해요. 알람은 그대로 유지돼요. 다른 앱의 밤은 여기서 숨겨지기만 하고 그 앱에는 그대로 남아 있어요."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ລຶບທຸກຄືນທີ່ບັນທຶກໄວ້ໃນໂທລະສັບ ແລະ ໂມງ ໂມງປຸກຂອງເຈົ້າຍັງຢູ່ ຄືນຈາກແອັບອື່ນຖືກເຊື່ອງໄວ້ຢູ່ນີ້ເທົ່ານັ້ນ ແລະ ຍັງຢູ່ໃນແອັບເຫຼົ່ານັ້ນ"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ištrina visas įrašytas naktis telefone ir laikrodyje. Žadintuvai lieka. Naktys iš kitų programų čia tik paslepiamos ir lieka tose programose."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dzēš visas ierakstītās naktis tālrunī un pulkstenī. Modinātāji paliek. Naktis no citām lietotnēm šeit tiek tikai paslēptas un paliek šajās lietotnēs."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ги брише сите снимени ноќи на телефонот и часовникот. Алармите остануваат. Ноќите од други апликации тука само се скриваат и остануваат во тие апликации."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഫോണിലും വാച്ചിലും രേഖപ്പെടുത്തിയ എല്ലാ രാത്രികളും ഇല്ലാതാക്കും. അലാറങ്ങൾ നിലനിൽക്കും. മറ്റ് ആപ്പുകളിലെ രാത്രികൾ ഇവിടെ മറയ്ക്കുക മാത്രമാണ് ചെയ്യുന്നത്, അവ ആ ആപ്പുകളിൽ തന്നെ തുടരും."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Утас, цаган дээрх бүх бүртгэсэн шөнийг устгана. Сэрүүлгүүд чинь үлдэнэ. Бусад аппын шөнүүд энд зөвхөн нуугдах бөгөөд тэр аппуудад хэвээр үлдэнэ."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "फोन आणि घड्याळावरील सर्व नोंदवलेल्या रात्री हटवते. तुमचे अलार्म राहतात. इतर ॲप्समधील रात्री इथे फक्त लपवल्या जातात आणि त्या ॲप्समध्येच राहतात."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Memadam semua malam yang direkodkan pada telefon dan jam tanganmu. Penggera kekal. Malam daripada apl lain hanya disembunyikan di sini dan kekal dalam apl tersebut."
          }
        },
        "my": {
          "stringUnit": {
            "state": "translated",
            "value": "ဖုန်းနှင့် နာရီပေါ်ရှိ မှတ်တမ်းတင်ထားသော ညအားလုံးကို ဖျက်သည်။ နှိုးစက်များ ကျန်ရှိမည်။ အခြားအက်ပ်များမှ ညများကို ဤနေရာတွင် ဖျောက်ထားရုံသာဖြစ်ပြီး ထိုအက်ပ်များတွင် ဆက်ရှိနေမည်။"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Sletter alle registrerte netter på telefonen og klokka. Alarmene dine blir værende. Netter fra andre apper skjules bare her og blir værende i de appene."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "तिम्रो फोन र घडीमा रेकर्ड भएका सबै रात मेटाउँछ। तिम्रा अलार्म रहन्छन्। अन्य एपका रातहरू यहाँ लुकाइन्छन् मात्र र ती एपहरूमै रहन्छन्।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wist alle opgenomen nachten op je telefoon en horloge. Je wekkers blijven. Nachten uit andere apps worden hier alleen verborgen en blijven in die apps."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਫ਼ੋਨ ਅਤੇ ਘੜੀ ’ਤੇ ਦਰਜ ਸਾਰੀਆਂ ਰਾਤਾਂ ਮਿਟਾ ਦਿੰਦਾ ਹੈ। ਤੁਹਾਡੇ ਅਲਾਰਮ ਰਹਿੰਦੇ ਹਨ। ਹੋਰ ਐਪਾਂ ਦੀਆਂ ਰਾਤਾਂ ਇੱਥੇ ਸਿਰਫ਼ ਲੁਕਾਈਆਂ ਜਾਂਦੀਆਂ ਹਨ ਅਤੇ ਉਨ੍ਹਾਂ ਐਪਾਂ ਵਿੱਚ ਹੀ ਰਹਿੰਦੀਆਂ ਹਨ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Usuwa wszystkie zapisane noce na telefonie i zegarku. Twoje budziki zostają. Noce z innych aplikacji są tu tylko ukrywane i zostają w tych aplikacjach."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Apaga todas as noites registradas no seu celular e no relógio. Seus alarmes continuam. Noites de outros apps são apenas ocultadas aqui e continuam nesses apps."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Apaga todas as noites registadas no teu telemóvel e no relógio. Os teus alarmes mantêm-se. As noites de outras apps são apenas ocultadas aqui e mantêm-se nessas apps."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Șterge toate nopțile înregistrate pe telefon și pe ceas. Alarmele tale rămân. Nopțile din alte aplicații sunt doar ascunse aici și rămân în acele aplicații."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удаляет все записанные ночи на телефоне и часах. Твои будильники останутся. Ночи из других приложений здесь только скрываются и остаются в этих приложениях."
          }
        },
        "si": {
          "stringUnit": {
            "state": "translated",
            "value": "ඔබේ දුරකථනයේ සහ ඔරලෝසුවේ සටහන් වූ සියලු රාත්‍රි මකයි. ඔබේ එලාම ඉතිරි වේ. වෙනත් යෙදුම්වල රාත්‍රී මෙහි සඟවනු ලබන්නේ පමණක් වන අතර ඒවා එම යෙදුම්වල පවතී."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vymaže všetky zaznamenané noci v telefóne aj v hodinkách. Budíky zostanú. Noci z iných aplikácií sa tu iba skryjú a zostanú v týchto aplikáciách."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Izbriše vse zabeležene noči na telefonu in uri. Budilke ostanejo. Noči iz drugih aplikacij se tukaj samo skrijejo in ostanejo v teh aplikacijah."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Fshin të gjitha netët e regjistruara në telefon dhe në orë. Alarmet e tua mbeten. Netët nga aplikacione të tjera këtu vetëm fshihen nga pamja dhe mbeten në ato aplikacione."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Брише све забележене ноћи на телефону и сату. Твоји аларми остају. Ноћи из других апликација овде се само скривају и остају у тим апликацијама."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Raderar alla registrerade nätter på telefonen och klockan. Dina alarm finns kvar. Nätter från andra appar döljs bara här och ligger kvar i de apparna."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Inafuta usiku wote uliorekodiwa kwenye simu na saa yako. Kengele zako zinabaki. Usiku kutoka programu nyingine unafichwa hapa tu na unabaki kwenye programu hizo."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஃபோனிலும் வாட்ச்சிலும் பதிவான எல்லா இரவுகளும் நீக்கப்படும். உங்கள் அலாரங்கள் அப்படியே இருக்கும். பிற ஆப்களின் இரவுகள் இங்கே மறைக்கப்படும் மட்டுமே, அவை அந்த ஆப்களிலேயே இருக்கும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఫోన్, వాచ్‌లో నమోదైన అన్ని రాత్రులను తొలగిస్తుంది. మీ అలారాలు అలాగే ఉంటాయి. ఇతర యాప్‌ల రాత్రులు ఇక్కడ దాచబడతాయి మాత్రమే, అవి ఆ యాప్‌లలోనే ఉంటాయి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลบข้อมูลทุกคืนที่บันทึกไว้บนโทรศัพท์และนาฬิกา การปลุกของคุณจะยังอยู่ คืนจากแอปอื่นจะถูกซ่อนไว้ที่นี่เท่านั้น และยังคงอยู่ในแอปเหล่านั้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Telefonundaki ve saatindeki tüm kayıtlı geceleri siler. Alarmların kalır. Diğer uygulamalardaki geceler burada yalnızca gizlenir ve o uygulamalarda kalır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Видаляє всі записані ночі на телефоні та годиннику. Твої будильники залишаться. Ночі з інших застосунків тут лише приховуються й залишаються в тих застосунках."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "فون اور گھڑی پر ریکارڈ کی گئی تمام راتیں حذف ہو جائیں گی۔ تمہارے الارم باقی رہیں گے۔ دوسری ایپس کی راتیں یہاں صرف چھپائی جاتی ہیں اور انہی ایپس میں رہتی ہیں۔"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Telefon va soatdagi barcha yozilgan tunlarni oʻchiradi. Budilniklaring qoladi. Boshqa ilovalardagi tunlar bu yerda faqat yashiriladi va oʻsha ilovalarda qoladi."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xóa mọi đêm đã ghi trên điện thoại và đồng hồ của bạn. Báo thức của bạn vẫn được giữ. Các đêm từ ứng dụng khác chỉ bị ẩn ở đây và vẫn nằm trong các ứng dụng đó."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "刪除手機和手錶上記錄的所有晚上。你的鬧鐘會保留。來自其他 App 的晚上只會在這裡隱藏，並會保留在那些 App 中。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将删除手机和手表上记录的所有夜晚数据。你的闹钟会保留。来自其他应用的夜晚只会在这里隐藏，仍保留在那些应用中。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將刪除手機和手錶上記錄的所有夜晚資料。你的鬧鐘會保留。來自其他 App 的夜晚只會在這裡隱藏，仍會保留在那些 App 中。"
          }
        },
        "zu": {
          "stringUnit": {
            "state": "translated",
            "value": "Isusa bonke ubusuku obuqoshiwe efonini nasewashini lakho. Ama-alamu akho ayasala. Ubusuku obuvela kwamanye ama-app bufihlwa lapha kuphela futhi buhlala kulawo ma-app."
          }
        }
      }
    },
