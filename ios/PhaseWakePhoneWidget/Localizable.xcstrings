    "editor_alert_hint": {
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Klank kom altyd saam met vibrasie. Wekkers lui ook met Moenie Steur Nie, slaaptydmodus en ’n stil foon."
          }
        },
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "ድምፅ ሁልጊዜ ከንዝረት ጋር ይመጣል። ማንቂያዎች በአትረብሽ፣ በመኝታ ሁነታ እና ጸጥ ባለ ስልክም ይደውላሉ።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يأتي الصوت دائمًا مع الاهتزاز. تعمل المنبّهات أيضًا مع وضع عدم الإزعاج ووضع وقت النوم والهاتف الصامت."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Səs həmişə vibrasiya ilə gəlir. Siqnallar “Narahat etməyin”, yuxu rejimi və səssiz telefonda da çalır."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Звукът винаги е с вибрация. Будилниците звънят и при „Не безпокойте“, режим за сън и тих телефон."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "শব্দের সঙ্গে সবসময় কম্পনও থাকে। “বিরক্ত করবে না”, বেডটাইম মোড আর সাইলেন্ট ফোনেও অ্যালার্ম বাজে।"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zvuk uvijek dolazi s vibracijom. Alarmi zvone i uz „Ne uznemiravaj“, način za spavanje i utišan telefon."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "El so sempre va amb vibració. Les alarmes també sonen amb «No molestis», el mode de descans i el telèfon en silenci."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zvuk vždy doprovází vibrace. Budíky zvoní i v režimu Nerušit, ve spánkovém režimu a při ztlumeném telefonu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Lyd kommer altid med vibration. Alarmer ringer også i Forstyr ikke, sengetidstilstand og med lydløs telefon."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ton kommt immer mit Vibration. Wecker klingeln auch bei «Nicht stören», im Bettzeitmodus und bei lautlosem Handy."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ο ήχος συνοδεύεται πάντα από δόνηση. Τα ξυπνητήρια χτυπούν και με «Μην ενοχλείτε», σε λειτουργία ώρας ύπνου και με σίγαση."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sound always comes with vibration. Alarms also ring with Do Not Disturb, bedtime mode and a silent phone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El sonido siempre va con vibración. Las alarmas suenan también con No molestar, el modo hora de dormir y el móvil en silencio."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Heliga kaasneb alati vibratsioon. Äratused helisevad ka režiimis „Mitte segada“, unerežiimis ja hääletu telefoniga."
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "Soinuak beti dakar bibrazioa. Alarmek «Ez molestatu» moduan, lo-moduan eta telefonoa isilik dagoenean ere jotzen dute."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "صدا همیشه با لرزش همراه است. زنگ‌ها در حالت «مزاحم نشو»، حالت زمان خواب و گوشی بی‌صدا هم به صدا درمی‌آیند."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ääni tulee aina värinän kanssa. Herätykset soivat myös Älä häiritse -tilassa, nukkumaanmenotilassa ja äänettömällä puhelimella."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Laging may kasamang vibration ang tunog. Tumutunog din ang mga alarm kahit naka-Huwag Istorbohin, naka-bedtime mode, o naka-silent ang telepono."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le son s'accompagne toujours de vibrations. Les alarmes sonnent aussi en mode Ne pas déranger, en mode coucher et avec un téléphone en silencieux."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Bíonn creathadh i gcónaí leis an bhfuaim. Buaileann aláraim freisin le “Ná Cuir Isteach Orm”, mód am codlata agus fón ciúin."
          }
        },
        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "O son sempre vai con vibración. As alarmas tamén soan con «Non molestar», modo hora de durmir e o teléfono en silencio."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "અવાજ સાથે હંમેશાં વાઇબ્રેશન પણ હોય છે. “ખલેલ પાડશો નહીં”, બેડટાઇમ મોડ અને સાઇલન્ટ ફોનમાં પણ એલાર્મ વાગે છે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "צליל תמיד מגיע עם רטט. מעוררים מצלצלים גם במצב ‘נא לא להפריע’, במצב שעת שינה ובטלפון מושתק."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आवाज़ हमेशा वाइब्रेशन के साथ आती है। अलार्म डू नॉट डिस्टर्ब, बेडटाइम मोड और साइलेंट फ़ोन में भी बजते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zvuk uvijek dolazi s vibracijom. Alarmi zvone i uz „Ne uznemiravaj“, način za spavanje i utišan telefon."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A hang mindig rezgéssel jár együtt. Az ébresztők Ne zavarjanak módban, lefekvési módban és némított telefonnál is szólnak."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ձայնը միշտ թրթռոցով է։ Զարթուցիչները զանգում են նաև «Չանհանգստացնել», քնի ռեժիմի և անձայն հեռախոսի դեպքում։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Suara selalu disertai getaran. Alarm juga berbunyi saat Jangan Ganggu, mode waktu tidur, dan ponsel senyap."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Hljóði fylgir alltaf titringur. Vekjarar hringja líka í „Ónáðið ekki“, háttatímastillingu og á hljóðlausum síma."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il suono è sempre accompagnato dalla vibrazione. Le sveglie suonano anche con Non disturbare, la modalità riposo e il telefono in silenzioso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音は必ずバイブレーションと一緒に鳴ります。おやすみモードや就寝モード、マナーモード中でもアラームは鳴ります。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ხმა ყოველთვის ვიბრაციასთან ერთადაა. მაღვიძარები რეკავს „არ შემაწუხოთ“, ძილის რეჟიმსა და უხმო ტელეფონზეც."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дыбыс әрқашан дірілмен бірге. Оятқыштар «Мазаламау», ұйқы режимі мен дыбыссыз телефонда да шырылдайды."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "សំឡេងតែងមកជាមួយការញ័រ។ ម៉ោងរោទ៍នៅតែរោទ៍ ទោះបីបើក «កុំរំខាន» មុខងារពេលដេក ឬទូរសព្ទស្ងាត់ក៏ដោយ។"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಶಬ್ದದ ಜೊತೆ ಯಾವಾಗಲೂ ಕಂಪನ ಇರುತ್ತದೆ. ಅಡಚಣೆ ಮಾಡಬೇಡಿ, ಬೆಡ್‌ಟೈಮ್ ಮೋಡ್ ಮತ್ತು ಸೈಲೆಂಟ್ ಫೋನ್‌ನಲ್ಲೂ ಅಲಾರಾಂಗಳು ರಿಂಗ್ ಆಗುತ್ತವೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "소리는 항상 진동과 함께 울려요. 방해 금지 모드, 취침 모드, 무음일 때도 알람은 울려요."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ສຽງມາພ້ອມການສັ່ນສະເໝີ ໂມງປຸກຍັງດັງເຖິງວ່າຈະເປີດ “ຫ້າມລົບກວນ” ໂໝດເວລານອນ ຫຼື ໂທລະສັບປິດສຽງ"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Garsas visada skamba su vibracija. Žadintuvai skamba ir esant režimui „Netrukdyti“, miego režimui ar išjungtam telefono garsui."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Skaņa vienmēr ir kopā ar vibrāciju. Modinātāji zvana arī režīmā „Netraucēt“, gulētiešanas režīmā un tad, ja tālrunim izslēgta skaņa."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Звукот секогаш доаѓа со вибрација. Алармите ѕвонат и при „Не вознемирувај“, режим за спиење и исклучен звук."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ശബ്ദത്തിനൊപ്പം എപ്പോഴും വൈബ്രേഷനും ഉണ്ടാകും. ശല്യപ്പെടുത്തരുത്, ബെഡ്‌ടൈം മോഡ്, സൈലന്റ് ഫോൺ എന്നിവയിലും അലാറം അടിക്കും."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Дуу үргэлж чичиргээтэй хамт. Сэрүүлэг «Бүү саад бол», унтах горим болон дуугүй утсан дээр ч дуугарна."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "आवाजासोबत नेहमी व्हायब्रेशनही असते. “व्यत्यय आणू नका”, बेडटाइम मोड आणि सायलेंट फोनमध्येही अलार्म वाजतात."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Bunyi sentiasa disertai getaran. Penggera juga berbunyi semasa Jangan Ganggu, mod waktu tidur dan telefon senyap."
          }
        },
        "my": {
          "stringUnit": {
            "state": "translated",
            "value": "အသံသည် တုန်ခါမှုနှင့် အမြဲတွဲလာသည်။ မနှောင့်ယှက်ရ၊ အိပ်ချိန်မုဒ်နှင့် အသံပိတ်ဖုန်းတွင်လည်း နှိုးစက်များ မြည်သည်။"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Lyd kommer alltid med vibrasjon. Alarmer ringer også i Ikke forstyrr, sengetidsmodus og med lydløs telefon."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "आवाजसँग सधैँ कम्पन हुन्छ। “बाधा नपुर्‍याउनुहोस्”, सुत्ने मोड र साइलेन्ट फोनमा पनि अलार्म बज्छ।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geluid komt altijd met trillen. Wekkers gaan ook af bij Niet storen, de bedtijdmodus en een telefoon op stil."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਆਵਾਜ਼ ਦੇ ਨਾਲ ਹਮੇਸ਼ਾ ਥਰਥਰਾਹਟ ਵੀ ਹੁੰਦੀ ਹੈ। ਅਲਾਰਮ “ਪਰੇਸ਼ਾਨ ਨਾ ਕਰੋ”, ਬੈੱਡਟਾਈਮ ਮੋਡ ਅਤੇ ਸਾਈਲੈਂਟ ਫ਼ੋਨ ਵਿੱਚ ਵੀ ਵੱਜਦੇ ਹਨ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dźwięk zawsze idzie z wibracją. Budziki dzwonią też w trybie Nie przeszkadzać, w trybie snu i na wyciszonym telefonie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O som sempre vem com vibração. Os alarmes tocam também com Não perturbe, modo hora de dormir e celular no silencioso."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O som vem sempre com vibração. Os alarmes tocam também com Não incomodar, modo de deitar e telemóvel em silêncio."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunetul vine mereu cu vibrație. Alarmele sună și în modul Nu deranja, în modul de culcare și cu telefonul pe silențios."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Звук всегда идёт с вибрацией. Будильники звонят и в режиме «Не беспокоить», в режиме сна и на беззвучном телефоне."
          }
        },
        "si": {
          "stringUnit": {
            "state": "translated",
            "value": "ශබ්දය සැමවිටම කම්පනය සමඟ පැමිණේ. “බාධා නොකරන්න”, නින්දේ ප්‍රකාරය සහ නිහඬ දුරකථනයේදීත් එලාම නාද වේ."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zvuk je vždy s vibráciou. Budíky zvonia aj v režime Nerušiť, v režime spánku aj pri stíšenom telefóne."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zvok je vedno skupaj z vibriranjem. Budilke zvonijo tudi v načinu »Ne moti«, v načinu za spanje in na utišanem telefonu."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Tingulli vjen gjithmonë me dridhje. Alarmet bien edhe me „Mos shqetëso“, në modalitetin e gjumit dhe kur telefoni është në heshtje."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Звук увек долази уз вибрацију. Аларми звоне и уз „Не узнемиравај“, режим спавања и утишан телефон."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ljud kommer alltid med vibration. Larm ringer även i Stör ej, sänggåendeläge och med ljudlös mobil."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Sauti huja na mtetemo kila wakati. Kengele hulia pia ukiwa na “Usinisumbue”, hali ya kulala na simu iliyo kimya."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஒலியுடன் எப்போதும் அதிர்வும் இருக்கும். “தொந்தரவு செய்ய வேண்டாம்”, உறக்க நேரப் பயன்முறை, சைலன்ட் ஃபோன் ஆகியவற்றிலும் அலாரம் ஒலிக்கும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ధ్వనితో పాటు ఎప్పుడూ వైబ్రేషన్ కూడా ఉంటుంది. “అంతరాయం కలిగించవద్దు”, బెడ్‌టైమ్ మోడ్, సైలెంట్ ఫోన్‌లోనూ అలారాలు మోగుతాయి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เสียงจะมาพร้อมการสั่นเสมอ นาฬิกาปลุกดังแม้เปิดโหมดห้ามรบกวน โหมดเวลานอน หรือปิดเสียงโทรศัพท์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ses her zaman titreşimle birlikte gelir. Alarmlar Rahatsız Etme, uyku vakti modu ve sessiz telefonda da çalar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Звук завжди йде з вібрацією. Будильники дзвонять і в режимі «Не турбувати», у режимі сну та на беззвучному телефоні."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آواز ہمیشہ وائبریشن کے ساتھ آتی ہے۔ الارم “ڈسٹرب نہ کریں”، بیڈ ٹائم موڈ اور خاموش فون پر بھی بجتے ہیں۔"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Tovush doim tebranish bilan birga. Budilniklar «Bezovta qilinmasin», uyqu rejimi va ovozsiz telefonda ham jiringlaydi."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Âm thanh luôn đi kèm rung. Báo thức vẫn đổ chuông khi bật Không làm phiền, chế độ giờ đi ngủ hoặc điện thoại im lặng."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "響鬧時一定會同時震動。即使開啟了請勿打擾、睡眠模式或手機靜音，鬧鐘也會響。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "响铃时总会同时振动。即使开启勿扰、就寝模式或手机静音，闹钟也会响。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "響鈴時一定會同時震動。即使開啟勿擾模式、就寢模式或手機靜音，鬧鐘也會響。"
          }
        },
        "zu": {
          "stringUnit": {
            "state": "translated",
            "value": "Umsindo uhlala uza nokudlidliza. Ama-alamu ayakhala nalapho kuvulwe okuthi Ungaphazamisi, imodi yesikhathi sokulala noma ifoni ithulisiwe."
          }
        }
      }
    },
