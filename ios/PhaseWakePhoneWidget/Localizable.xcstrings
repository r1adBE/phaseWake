        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "കണ്ടെത്തൽ മെച്ചപ്പെടുത്താൻ സഹായിക്കൂ: പേരോ തീയതിയോ ഉപകരണ ID-യോ ഇല്ലാത്ത CSV."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Илрүүлэлтийг сайжруулахад туслаарай: нэр, огноо, төхөөрөмжийн ID-гүй CSV."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "ओळख सुधारायला मदत करा: नावे, तारखा किंवा डिव्हाइस आयडी नसलेली CSV."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Bantu tingkatkan pengesanan: CSV tanpa nama, tarikh atau ID peranti."
          }
        },
        "my": {
          "stringUnit": {
            "state": "translated",
            "value": "ရှာဖွေမှု ပိုကောင်းအောင် ကူညီပါ- အမည်၊ ရက်စွဲ သို့မဟုတ် စက် ID မပါသော CSV။"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hjelp til med å forbedre gjenkjenningen: CSV uten navn, datoer eller enhets-ID."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "पहिचान सुधार्न मद्दत गर: नाम, मिति वा डिभाइस ID बिनाको CSV।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Help de herkenning te verbeteren: CSV zonder namen, datums of apparaat-ID's."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਪਛਾਣ ਸੁਧਾਰਨ ਵਿੱਚ ਮਦਦ ਕਰੋ: ਨਾਮਾਂ, ਤਾਰੀਖਾਂ ਜਾਂ ਡੀਵਾਈਸ ID ਤੋਂ ਬਿਨਾਂ CSV।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pomóż ulepszyć wykrywanie: CSV bez imion, dat i identyfikatorów urządzeń."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajude a melhorar a detecção: CSV sem nomes, datas ou ID do dispositivo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajuda a melhorar a deteção: CSV sem nomes, datas nem IDs de dispositivo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajută la îmbunătățirea detectării: CSV fără nume, date sau ID-uri de dispozitiv."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Помоги улучшить распознавание: CSV без имён, дат и ID устройств."
          }
        },
        "si": {
          "stringUnit": {
            "state": "translated",
            "value": "හඳුනාගැනීම වැඩිදියුණු කිරීමට උදව් කරන්න: නම්, දින හෝ උපාංග ID නැති CSV."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pomôž zlepšiť rozpoznávanie: CSV bez mien, dátumov či ID zariadení."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pomagaj izboljšati zaznavanje: CSV brez imen, datumov ali ID-jev naprav."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Ndihmo të përmirësohet dallimi: CSV pa emra, data ose ID pajisjesh."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Помози да се препознавање побољша: CSV без имена, датума и ID-јева уређаја."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Hjälp till att förbättra igenkänningen: CSV utan namn, datum eller enhets-ID."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Saidia kuboresha utambuzi: CSV bila majina, tarehe wala vitambulisho vya kifaa."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "கண்டறிதலை மேம்படுத்த உதவுங்கள்: பெயர், தேதி, சாதன ID இல்லாத CSV."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "గుర్తింపును మెరుగుపరచడంలో సాయపడండి: పేర్లు, తేదీలు లేదా పరికర IDలు లేని CSV."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ช่วยพัฒนาการตรวจจับ: ไฟล์ CSV ที่ไม่มีชื่อ วันที่ หรือรหัสอุปกรณ์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Algılamayı geliştirmeye yardım et: isim, tarih veya cihaz kimliği içermeyen CSV."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Допоможи покращити розпізнавання: CSV без імен, дат та ідентифікаторів пристроїв."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "پہچان بہتر بنانے میں مدد کرو: نام، تاریخ یا ڈیوائس آئی ڈی کے بغیر CSV۔"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Aniqlashni yaxshilashga yordam ber: nomlar, sanalar va qurilma IDlarisiz CSV."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giúp cải thiện khả năng nhận diện: tệp CSV không chứa tên, ngày hay mã thiết bị."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "協助改善偵測：CSV 檔案不含姓名、日期或裝置 ID。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "帮助改进检测：CSV 文件不含姓名、日期或设备 ID。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "協助改善偵測：CSV 檔不含姓名、日期或裝置 ID。"
          }
        },
        "zu": {
          "stringUnit": {
            "state": "translated",
            "value": "Siza ukuthuthukisa ukutholwa: i-CSV ngaphandle kwamagama, izinsuku noma ama-ID edivayisi."
          }
        }
      }
