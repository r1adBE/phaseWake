        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Nën %1$lld %% – karikoje orën, që të mbajë gjithë natën dhe të të zgjojë."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Испод %1$lld %% – напуни сат да би издржао ноћ и пробудио те."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Under %1$lld %% – ladda klockan så att den räcker hela natten och kan väcka dig."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Chini ya %1$lld %% – chaji saa yako ili idumu usiku mzima na iweze kukuamsha."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld %% க்குக் கீழ் – இரவு முழுவதும் நீடித்து உங்களை எழுப்ப வாட்ச்சைச் சார்ஜ் செய்யுங்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld %% కంటే తక్కువ – రాత్రంతా పని చేసి మిమ్మల్ని లేపగలిగేలా వాచ్ ఛార్జ్ చేయండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ต่ำกว่า %1$lld %% – ชาร์จนาฬิกาเพื่อให้ใช้งานได้ตลอดคืนและปลุกคุณได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pil %1$lld %% altında – gece boyunca dayanması ve seni uyandırabilmesi için saatini şarj et."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Нижче %1$lld %% – постав годинник на зарядку, щоб його вистачило на всю ніч і він зміг тебе розбудити."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld %% سے کم – گھڑی چارج کرو تاکہ وہ پوری رات چلے اور تمہیں جگا سکے۔"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld %% dan kam – tun boʻyi yetishi va seni uygʻota olishi uchun soatingni quvvatla."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dưới %1$lld %% – hãy sạc đồng hồ để đồng hồ chạy suốt đêm và có thể đánh thức bạn."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "低於 %1$lld %% – 請為手錶充電，讓它撐過整晚並叫醒你。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "低于 %1$lld %% – 请给手表充电，以便它整夜运行并按时唤醒你。"
