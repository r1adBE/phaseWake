    "auto_onset_hint": {
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Van 1 uur voor slaaptyd meet jou horlosie kortliks beweging totdat jy aan die slaap raak. Slegs Galaxy Watch."
          }
        },
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "ከመኝታ ሰዓት 1 ሰዓት በፊት ጀምሮ ሰዓትህ እስክትተኛ ድረስ እንቅስቃሴን በአጭሩ ይለካል። Galaxy Watch ብቻ።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "من ساعة قبل موعد النوم تقيس ساعتك الحركة لفترة قصيرة حتى تغفو. Galaxy Watch فقط."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Yatma vaxtından 1 saat əvvəldən saatın yuxuya gedənə qədər hərəkəti qısa müddət ölçür. Yalnız Galaxy Watch."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "От 1 час преди лягане часовникът ти измерва за кратко движението, докато заспиш. Само Galaxy Watch."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ঘুমানোর সময়ের ১ ঘণ্টা আগে থেকে তুমি ঘুমিয়ে না পড়া পর্যন্ত তোমার ঘড়ি অল্প সময় নড়াচড়া মাপে। শুধু Galaxy Watch।"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Od 1 sat prije vremena za spavanje sat kratko mjeri pokrete dok ne zaspiš. Samo Galaxy Watch."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Des d'1 hora abans d'anar a dormir, el rellotge mesura breument el moviment fins que t'adorms. Només Galaxy Watch."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Od 1 hodiny před časem spánku hodinky krátce měří pohyb, dokud neusneš. Pouze Galaxy Watch."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Fra 1 time før sengetid måler dit ur kort bevægelse, indtil du falder i søvn. Kun Galaxy Watch."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Uhr misst ab 1 Std. vor der Bettzeit kurz die Bewegung, bis du eingeschlafen bist. Nur Galaxy Watch."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Από 1 ώρα πριν από την ώρα ύπνου το ρολόι σου μετρά σύντομα την κίνηση μέχρι να αποκοιμηθείς. Μόνο Galaxy Watch."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "From 1 hour before bedtime your watch briefly measures movement until you fall asleep. Galaxy Watch only."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desde 1 hora antes de acostarte, tu reloj mide brevemente el movimiento hasta que te duermes. Solo Galaxy Watch."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Alates 1 tund enne magamaminekut mõõdab kell lühidalt liikumist, kuni sa uinud. Ainult Galaxy Watch."
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "Oheratzeko ordua baino ordubete lehenagotik, erlojuak mugimendua neurtzen du laburki lo hartu arte. Galaxy Watch soilik."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "از ۱ ساعت قبل از وقت خواب، ساعتت کوتاه حرکت را اندازه می‌گیرد تا به خواب بروی. فقط Galaxy Watch."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kello mittaa lyhyesti liikettä 1 tunti ennen nukkumaanmenoaikaa, kunnes nukahdat. Vain Galaxy Watch."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Mula 1 oras bago ang oras ng pagtulog, saglit na sinusukat ng relo mo ang galaw hanggang makatulog ka. Galaxy Watch lang."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dès 1 h avant le coucher, ta montre mesure brièvement les mouvements jusqu'à ce que tu t'endormes. Galaxy Watch uniquement."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Ó uair an chloig roimh am codlata, tomhaiseann d'uaireadóir gluaiseacht go hachomair go dtí go dtiteann tú i do chodladh. Galaxy Watch amháin."
          }
        },
        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "Desde 1 hora antes de deitarte, o reloxo mide brevemente o movemento ata que adormeces. Só Galaxy Watch."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "સૂવાના સમયના 1 કલાક પહેલાંથી તું ઊંઘી ન જાય ત્યાં સુધી તારી ઘડિયાળ થોડા સમય માટે હલનચલન માપે છે. ફક્ત Galaxy Watch."
          }
        },
        "he": {
          "stringUnit": {
