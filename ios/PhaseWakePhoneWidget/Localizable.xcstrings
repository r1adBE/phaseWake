        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ວັນພັກໂດຍປະມານ: %1$@ – ໂມງປຸກຈະດັງ. ຖ້າເຈົ້າພັກ, ໃຫ້ຂ້າມມື້ນັ້ນເອງ."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Numatoma šventė: %1$@ – žadintuvas skambės. Jei turi laisvą dieną, praleisk ją pats."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Aptuvena svētku diena: %1$@ – modinātājs zvanīs. Ja tev ir brīvdiena, izlaid to pats."
