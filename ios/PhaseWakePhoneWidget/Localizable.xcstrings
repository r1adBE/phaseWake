    "test_hint": {
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Lui oor 2 minute met die instellings van jou volgende wekker, sonder sluimer. Tel nie as ’n nag nie."
          }
        },
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "በሚቀጥለው ማንቂያዎ ቅንብሮች በ2 ደቂቃ ውስጥ ይደውላል፣ ያለ ማሸለብ። እንደ ሌሊት አይቆጠርም።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يرنّ بعد دقيقتين بإعدادات منبّهك التالي، دون غفوة. لا يُحتسب ليلة."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Növbəti siqnalının ayarları ilə 2 dəqiqədən sonra çalır, təxirəsiz. Gecə kimi sayılmır."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Звъни след 2 минути с настройките на следващия ти будилник, без отлагане. Не се брои за нощ."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "তোমার পরের অ্যালার্মের সেটিংস দিয়ে ২ মিনিটে বাজে, স্নুজ ছাড়া। রাত হিসেবে গোনা হয় না।"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zvoni za 2 minute s postavkama tvog sljedećeg alarma, bez odgode. Ne računa se kao noć."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Sona d’aquí a 2 minuts amb la configuració de la teva alarma següent, sense posposar. No compta com a nit."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zazvoní za 2 minuty s nastavením tvého dalšího budíku, bez odložení. Nepočítá se jako noc."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ringer om 2 minutter med indstillingerne for din næste alarm, uden udsættelse. Tæller ikke som en nat."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Klingelt in 2 Minuten mit den Einstellungen deines nächsten Weckers, ohne Schlummern. Zählt nicht als Nacht."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Χτυπά σε 2 λεπτά με τις ρυθμίσεις της επόμενης αφύπνισής σου, χωρίς αναβολή. Δεν μετράει ως νύχτα."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rings in 2 minutes with the settings of your next alarm, without snoozing. Doesn’t count as a night."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Suena en 2 minutos con los ajustes de tu próxima alarma, sin posponer. No cuenta como noche."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Heliseb 2 minuti pärast järgmise äratuse seadetega, ilma edasilükkamiseta. Ei loeta ööks."
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "2 minutu barru jotzen du hurrengo alarmaren ezarpenekin, atzeratu gabe. Ez da gau gisa zenbatzen."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "۲ دقیقه دیگر با تنظیمات زنگ بعدی‌ات زنگ می‌زند، بدون چرت. شب حساب نمی‌شود."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Soi 2 minuutin päästä seuraavan herätyksesi asetuksilla, ilman torkkua. Ei lasketa yöksi."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutunog sa loob ng 2 minuto gamit ang mga setting ng susunod mong alarm, nang walang snooze. Hindi binibilang bilang gabi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sonne dans 2 minutes avec les réglages de ton prochain réveil, sans répétition. Ne compte pas comme une nuit."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Buaileann sé i gceann 2 nóiméad le socruithe d’aláraim eile, gan cur siar. Ní áirítear é mar oíche."
          }
        },
        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "Soa en 2 minutos cos axustes da túa próxima alarma, sen adiar. Non conta como noite."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તમારા આગલા એલાર્મના સેટિંગ સાથે 2 મિનિટમાં વાગે છે, સ્નૂઝ વગર. રાત તરીકે ગણાતું નથી."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מצלצל בעוד 2 דקות עם ההגדרות של ההשכמה הבאה שלכם, בלי נודניק. לא נחשב כלילה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके अगले अलार्म की सेटिंग के साथ 2 मिनट में बजता है, बिना स्नूज़ के। रात के रूप में नहीं गिना जाता।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zvoni za 2 minute s postavkama tvog sljedećeg alarma, bez odgode. Ne računa se kao noć."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "2 perc múlva szól a következő ébresztőd beállításaival, szundi nélkül. Nem számít éjszakának."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Զանգում է 2 րոպեից՝ հաջորդ զարթուցիչիդ կարգավորումներով, առանց հետաձգման։ Չի հաշվվում որպես գիշեր։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Berbunyi dalam 2 menit dengan setelan alarm berikutnya, tanpa tunda. Tidak dihitung sebagai malam."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Hringir eftir 2 mínútur með stillingum næsta vekjara, án blunds. Telst ekki sem nótt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Suona tra 2 minuti con le impostazioni della tua prossima sveglia, senza posticipo. Non conta come notte."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "次のアラームの設定で2分後に鳴ります。スヌーズなし。夜としては記録されません。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "დარეკავს 2 წუთში შენი შემდეგი მაღვიძარის პარამეტრებით, გადადების გარეშე. ღამედ არ ითვლება."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Келесі оятқышыңның параметрлерімен 2 минуттан кейін шырылдайды, кейінге қалдырусыз. Түн ретінде саналмайды."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "រោទ៍ក្នុង 2 នាទី ជាមួយការកំណត់នៃម៉ោងរោទ៍បន្ទាប់ ដោយគ្មានការផ្អាក។ មិនរាប់ជាយប់ទេ។"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನಿಮ್ಮ ಮುಂದಿನ ಅಲಾರಾಂನ ಸೆಟ್ಟಿಂಗ್‌ಗಳೊಂದಿಗೆ 2 ನಿಮಿಷದಲ್ಲಿ ರಿಂಗ್ ಆಗುತ್ತದೆ, ಸ್ನೂಜ್ ಇಲ್ಲದೆ. ರಾತ್ರಿ ಎಂದು ಎಣಿಸುವುದಿಲ್ಲ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다음 알람 설정으로 2분 후에 울려요. 다시 알림 없이. 밤으로 기록되지 않아요."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ດັງໃນ 2 ນາທີ ດ້ວຍການຕັ້ງຄ່າຂອງໂມງປຸກຖັດໄປ ໂດຍບໍ່ມີການເລື່ອນປຸກ ບໍ່ນັບເປັນຄືນ"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Suskamba po 2 minučių su kito žadintuvo nustatymais, be atidėjimo. Neskaičiuojama kaip naktis."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Zvana pēc 2 minūtēm ar nākamā modinātāja iestatījumiem, bez atlikšanas. Netiek skaitīts kā nakts."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ѕвони за 2 минути со поставките на следниот аларм, без одложување. Не се брои како ноќ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "അടുത്ത അലാറത്തിന്റെ ക്രമീകരണങ്ങളോടെ 2 മിനിറ്റിൽ റിങ് ചെയ്യും, സ്‌നൂസില്ലാതെ. ഒരു രാത്രിയായി കണക്കാക്കില്ല."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Дараагийн сэрүүлгийн чинь тохиргоогоор 2 минутын дараа, хойшлуулахгүйгээр дуугарна. Шөнөд тооцохгүй."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुमच्या पुढच्या अलार्मच्या सेटिंग्जसह २ मिनिटांत वाजतो, स्नूझशिवाय. रात्र म्हणून मोजला जात नाही."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Berbunyi dalam 2 minit dengan tetapan penggera seterusnya, tanpa tunda. Tidak dikira sebagai malam."
          }
        },
        "my": {
          "stringUnit": {
            "state": "translated",
            "value": "နောက်နှိုးစက်၏ ဆက်တင်များဖြင့် 2 မိနစ်အတွင်း မြည်မည်၊ ခဏဆိုင်းခြင်းမပါ။ ညအဖြစ် မရေတွက်ပါ။"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ringer om 2 minutter med innstillingene for den neste alarmen din, uten slumring. Teller ikke som en natt."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "तिम्रो अर्को अलार्मको सेटिङसहित २ मिनेटमा, स्नुज बिना बज्छ। रातको रूपमा गनिँदैन।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gaat over 2 minuten af met de instellingen van je volgende wekker, zonder snoozen. Telt niet als nacht."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਤੁਹਾਡੇ ਅਗਲੇ ਅਲਾਰਮ ਦੀਆਂ ਸੈਟਿੰਗਾਂ ਨਾਲ 2 ਮਿੰਟਾਂ ਵਿੱਚ ਵੱਜਦਾ ਹੈ, ਬਿਨਾਂ ਸਨੂਜ਼। ਰਾਤ ਵਜੋਂ ਨਹੀਂ ਗਿਣਿਆ ਜਾਂਦਾ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zadzwoni za 2 minuty z ustawieniami Twojego następnego budzika, bez drzemki. Nie liczy się jako noc."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca em 2 minutos com as configurações do seu próximo alarme, sem soneca. Não conta como noite."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca em 2 minutos com as definições do teu próximo alarme, sem adiar. Não conta como noite."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Sună în 2 minute cu setările următoarei tale alarme, fără amânare. Nu contează ca noapte."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Зазвонит через 2 минуты с настройками твоего следующего будильника, без повтора. Не считается ночью."
          }
        },
        "si": {
          "stringUnit": {
            "state": "translated",
            "value": "ඔබේ ඊළඟ එලාමයේ සැකසීම් සමඟ මිනිත්තු 2 කින්, ස්නූස් නොමැතිව නාද වේ. රාත්‍රියක් ලෙස ගණන් නොගැනේ."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zazvoní o 2 minúty s nastaveniami tvojho ďalšieho budíka, bez odloženia. Nepočíta sa ako noc."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zazvoni čez 2 minuti z nastavitvami tvoje naslednje budilke, brez dremeža. Ne šteje kot noč."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Bie pas 2 minutash me cilësimet e alarmit tënd të radhës, pa shtyrje. Nuk llogaritet si natë."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Звони за 2 минута са подешавањима твог следећег аларма, без одлагања. Не рачуна се као ноћ."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ringer om 2 minuter med inställningarna för ditt nästa alarm, utan snooze. Räknas inte som en natt."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Inalia baada ya dakika 2 kwa mipangilio ya kengele yako inayofuata, bila kuahirisha. Haihesabiwi kama usiku."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் அடுத்த அலாரத்தின் அமைப்புகளுடன் 2 நிமிடத்தில் ஒலிக்கும், ஸ்னூஸ் இல்லாமல். இரவாகக் கணக்கிடப்படாது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ తదుపరి అలారం సెట్టింగ్‌లతో 2 నిమిషాల్లో మోగుతుంది, స్నూజ్ లేకుండా. రాత్రిగా లెక్కించబడదు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ดังใน 2 นาทีด้วยการตั้งค่าของการปลุกครั้งถัดไป ไม่มีเลื่อนปลุก ไม่นับเป็นคืน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sonraki alarmının ayarlarıyla 2 dakika sonra çalar, ertelemesiz. Gece sayılmaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Задзвонить за 2 хвилини з налаштуваннями твого наступного будильника, без відкладення. Не вважається ніччю."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "تمہارے اگلے الارم کی ترتیبات کے ساتھ 2 منٹ میں بجتا ہے، بغیر اسنوز کے۔ رات میں شمار نہیں ہوتا۔"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Keyingi budilnigingning sozlamalari bilan 2 daqiqada, kechiktirishsiz jiringlaydi. Tun sifatida hisoblanmaydi."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Reo sau 2 phút với cài đặt của báo thức tiếp theo, không báo lại. Không tính là một đêm."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "2 分鐘後按你下一個鬧鐘的設定響鬧，不設貪睡。不計作一晚。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "2 分钟后按你下一个闹钟的设置响铃，不能稍后提醒。不计为一晚。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "2 分鐘後依你下一個鬧鐘的設定響鈴，不能貪睡。不計為一晚。"
          }
        },
        "zu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ikhala emizuzwini emi-2 ngezilungiselelo ze-alamu yakho elandelayo, ngaphandle kokusnuza. Ayibalwa njengobusuku."
          }
        }
      }
    },
