        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Sat povezan, alarmi dozvoljeni. Dodirni za detalje."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Rellotge connectat, alarmes permeses. Toca per veure’n els detalls."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Hodinky jsou připojené, budíky povolené. Klepnutím zobrazíš podrobnosti."
