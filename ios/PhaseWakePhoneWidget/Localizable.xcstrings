    "check_watch_arm_problem": {
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Maak Phase Wake op jou Apple Watch oop voor jy gaan slaap. watchOS aktiveer die wekker net terwyl die app oop is."
          }
        },
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "ከመተኛትዎ በፊት Phase Wakeን በApple Watchዎ ላይ ይክፈቱ። watchOS ማንቂያውን የሚያዘጋጀው መተግበሪያው ክፍት ሲሆን ብቻ ነው።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "افتح Phase Wake على Apple Watch قبل أن تنام. لا يفعّل watchOS المنبه إلا أثناء فتح التطبيق."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Yatmazdan əvvəl Apple Watch-da Phase Wake-i aç. watchOS siqnalı yalnız tətbiq açıq olanda aktivləşdirir."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Отвори Phase Wake на Apple Watch, преди да заспиш. watchOS активира будилника само докато приложението е отворено."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ঘুমাতে যাওয়ার আগে তোমার Apple Watch-এ Phase Wake খোলো। অ্যাপ খোলা থাকলেই শুধু watchOS অ্যালার্ম প্রস্তুত করে।"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Otvori Phase Wake na Apple Watchu prije spavanja. watchOS aktivira alarm samo dok je aplikacija otvorena."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Obre Phase Wake a l’Apple Watch abans d’anar a dormir. El watchOS només activa l’alarma mentre l’app està oberta."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Před spaním otevři Phase Wake na Apple Watch. watchOS aktivuje budík, jen když je aplikace otevřená."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Åbn Phase Wake på dit Apple Watch, før du går i seng. watchOS aktiverer kun alarmen, mens appen er åben."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne Phase Wake vor dem Schlafen auf der Apple Watch. watchOS schaltet den Wecker nur bei offener App scharf."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Άνοιξε το Phase Wake στο Apple Watch σου πριν κοιμηθείς. Το watchOS ενεργοποιεί το ξυπνητήρι μόνο όσο η εφαρμογή είναι ανοιχτή."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Phase Wake on your Apple Watch before you go to sleep. watchOS only arms the alarm while the app is open."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre Phase Wake en tu Apple Watch antes de dormir. watchOS solo activa la alarma mientras la app está abierta."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Ava Phase Wake oma Apple Watchis enne magamaminekut. watchOS seab äratuse valmis ainult siis, kui rakendus on avatud."
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ireki Phase Wake zure Apple Watch-en lo egin aurretik. watchOS-ek aplikazioa irekita dagoen bitartean bakarrik aktibatzen du alarma."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "پیش از خواب Phase Wake را روی Apple Watch خود باز کن. watchOS فقط تا وقتی برنامه باز است زنگ را فعال می‌کند."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Avaa Phase Wake Apple Watchissa ennen nukkumaanmenoa. watchOS aktivoi herätyksen vain, kun sovellus on auki."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Buksan ang Phase Wake sa Apple Watch mo bago ka matulog. Inihahanda lang ng watchOS ang alarm habang bukas ang app."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvre Phase Wake sur ton Apple Watch avant de dormir. watchOS n’active l’alarme que tant que l’app est ouverte."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Oscail Phase Wake ar d’Apple Watch sula dtéann tú a chodladh. Ní ghníomhachtaíonn watchOS an t-aláram ach fad atá an aip oscailte."
          }
        },
        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre Phase Wake no Apple Watch antes de durmir. watchOS só activa a alarma mentres a app está aberta."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "સૂતાં પહેલાં તમારી Apple Watch પર Phase Wake ખોલો. ઍપ ખુલ્લી હોય ત્યારે જ watchOS એલાર્મ સક્રિય કરે છે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "פתחו את Phase Wake ב-Apple Watch שלכם לפני השינה. watchOS מפעיל את המעורר רק כשהאפליקציה פתוחה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सोने से पहले अपनी Apple Watch पर Phase Wake खोलें। watchOS अलार्म को तभी सक्रिय करता है जब ऐप खुला हो।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Otvori Phase Wake na Apple Watchu prije spavanja. watchOS aktivira alarm samo dok je aplikacija otvorena."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Lefekvés előtt nyisd meg a Phase Wake-et az Apple Watchodon. A watchOS csak akkor élesíti az ébresztőt, amíg az alkalmazás nyitva van."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Քնելուց առաջ բացիր Phase Wake-ը Apple Watch-ում։ watchOS-ն ակտիվացնում է զարթուցիչը միայն, երբ հավելվածը բաց է։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Buka Phase Wake di Apple Watch-mu sebelum tidur. watchOS hanya mengaktifkan alarm selama aplikasi terbuka."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Opnaðu Phase Wake á Apple Watch áður en þú ferð að sofa. watchOS virkjar vekjarann aðeins á meðan forritið er opið."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apri Phase Wake sul tuo Apple Watch prima di dormire. watchOS attiva la sveglia solo finché l’app è aperta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "眠る前にApple WatchでPhase Wakeを開いてください。watchOSはアプリが開いている間だけアラームを有効にします。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "დაძინებამდე გახსენი Phase Wake Apple Watch-ზე. watchOS მაღვიძარას მხოლოდ მაშინ ააქტიურებს, როცა აპი ღიაა."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ұйықтар алдында Apple Watch-та Phase Wake-ті аш. watchOS оятқышты тек қолданба ашық кезде іске қосады."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "បើក Phase Wake លើ Apple Watch មុនពេលចូលដេក។ watchOS កំណត់ម៉ោងរោទ៍បានតែពេលកម្មវិធីបើកប៉ុណ្ណោះ។"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಮಲಗುವ ಮೊದಲು ನಿಮ್ಮ Apple Watch ನಲ್ಲಿ Phase Wake ತೆರೆಯಿರಿ. ಆ್ಯಪ್ ತೆರೆದಿರುವಾಗ ಮಾತ್ರ watchOS ಅಲಾರಾಂ ಸಕ್ರಿಯಗೊಳಿಸುತ್ತದೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "잠들기 전에 Apple Watch에서 Phase Wake를 열어 주세요. watchOS는 앱이 열려 있는 동안에만 알람을 활성화해요."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ເປີດ Phase Wake ຢູ່ Apple Watch ກ່ອນເຂົ້ານອນ watchOS ຕັ້ງໂມງປຸກໄດ້ສະເພາະຕອນແອັບເປີດຢູ່"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Prieš miegą atidaryk Phase Wake savo Apple Watch. watchOS parengia žadintuvą tik tada, kai programėlė atidaryta."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Pirms gulētiešanas atver Phase Wake savā Apple Watch. watchOS aktivizē modinātāju tikai tad, kad lietotne ir atvērta."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Отвори го Phase Wake на Apple Watch пред спиење. watchOS го активира алармот само додека апликацијата е отворена."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഉറങ്ങും മുമ്പ് Apple Watch-ൽ Phase Wake തുറക്കുക. ആപ്പ് തുറന്നിരിക്കുമ്പോൾ മാത്രമേ watchOS അലാറം സജ്ജമാക്കൂ."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Унтахаасаа өмнө Apple Watch дээрээ Phase Wake-ийг нээ. watchOS сэрүүлгийг зөвхөн апп нээлттэй үед идэвхжүүлнэ."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "झोपण्यापूर्वी तुमच्या Apple Watch वर Phase Wake उघडा. ॲप उघडे असतानाच watchOS अलार्म सक्रिय करते."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Buka Phase Wake pada Apple Watch sebelum awak tidur. watchOS hanya mengaktifkan penggera semasa apl dibuka."
          }
        },
        "my": {
          "stringUnit": {
            "state": "translated",
            "value": "မအိပ်မီ Apple Watch ပေါ်တွင် Phase Wake ဖွင့်ပါ။ အက်ပ် ဖွင့်ထားစဉ်သာ watchOS က နှိုးစက်ကို အသင့်ပြင်သည်။"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Åpne Phase Wake på Apple Watch før du legger deg. watchOS aktiverer bare alarmen mens appen er åpen."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "सुत्नुअघि Apple Watch मा Phase Wake खोल। एप खुला हुँदा मात्र watchOS ले अलार्म सक्रिय गर्छ।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Phase Wake op je Apple Watch voordat je gaat slapen. watchOS activeert de wekker alleen zolang de app geopend is."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਸੌਣ ਤੋਂ ਪਹਿਲਾਂ ਆਪਣੀ Apple Watch ’ਤੇ Phase Wake ਖੋਲ੍ਹੋ। watchOS ਸਿਰਫ਼ ਐਪ ਖੁੱਲ੍ਹੀ ਹੋਣ ’ਤੇ ਹੀ ਅਲਾਰਮ ਸਰਗਰਮ ਕਰਦਾ ਹੈ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Otwórz Phase Wake na Apple Watch przed snem. watchOS aktywuje budzik tylko wtedy, gdy aplikacja jest otwarta."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra o Phase Wake no seu Apple Watch antes de dormir. O watchOS só ativa o alarme enquanto o app está aberto."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre o Phase Wake no teu Apple Watch antes de dormires. O watchOS só ativa o alarme enquanto a app estiver aberta."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Deschide Phase Wake pe Apple Watch înainte de culcare. watchOS activează alarma doar cât timp aplicația este deschisă."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Открой Phase Wake на Apple Watch перед сном. watchOS активирует будильник, только пока приложение открыто."
          }
        },
        "si": {
          "stringUnit": {
            "state": "translated",
            "value": "නින්දට යාමට පෙර ඔබේ Apple Watch හි Phase Wake විවෘත කරන්න. watchOS එලාමය සක්‍රිය කරන්නේ යෙදුම විවෘතව ඇති විට පමණි."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pred spaním otvor Phase Wake v Apple Watch. watchOS aktivuje budík, len kým je aplikácia otvorená."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pred spanjem odpri Phase Wake na Apple Watch. watchOS aktivira budilko le, ko je aplikacija odprta."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Hap Phase Wake në Apple Watch para se të flesh. watchOS e aktivizon alarmin vetëm kur aplikacioni është i hapur."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Отвори Phase Wake на Apple Watch-у пре спавања. watchOS активира аларм само док је апликација отворена."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Öppna Phase Wake på Apple Watch innan du somnar. watchOS aktiverar bara alarmet medan appen är öppen."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Fungua Phase Wake kwenye Apple Watch yako kabla ya kulala. watchOS huandaa kengele tu programu ikiwa wazi."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "தூங்கச் செல்லும் முன் உங்கள் Apple Watch இல் Phase Wake ஐத் திறவுங்கள். ஆப்ஸ் திறந்திருக்கும்போது மட்டுமே watchOS அலாரத்தைத் தயார்செய்யும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "నిద్రపోయే ముందు మీ Apple Watchలో Phase Wake తెరవండి. యాప్ తెరిచి ఉన్నప్పుడు మాత్రమే watchOS అలారాన్ని సిద్ధం చేస్తుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปิด Phase Wake บน Apple Watch ก่อนเข้านอน watchOS จะเปิดใช้งานนาฬิกาปลุกเฉพาะตอนที่แอปเปิดอยู่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uyumadan önce Apple Watch’ta Phase Wake’i aç. watchOS alarmı yalnızca uygulama açıkken etkinleştirir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відкрий Phase Wake на Apple Watch перед сном. watchOS активує будильник, лише поки застосунок відкритий."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "سونے سے پہلے اپنی Apple Watch پر Phase Wake کھولو۔ watchOS الارم صرف تب تیار کرتا ہے جب ایپ کھلی ہو۔"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Uxlashdan oldin Apple Watchʼingda Phase Wakeʼni och. watchOS budilnikni faqat ilova ochiq boʻlganda faollashtiradi."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy mở Phase Wake trên Apple Watch trước khi đi ngủ. watchOS chỉ kích hoạt báo thức khi ứng dụng đang mở."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "睡覺前請在 Apple Watch 上開啟 Phase Wake。watchOS 只會在 App 開啟時啟用鬧鐘。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "睡觉前请在你的 Apple Watch 上打开 Phase Wake。watchOS 只有在应用打开时才会启用闹钟。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "睡覺前請在你的 Apple Watch 上開啟 Phase Wake。watchOS 只有在 App 開啟時才會啟用鬧鐘。"
          }
        },
        "zu": {
          "stringUnit": {
            "state": "translated",
            "value": "Vula i-Phase Wake ku-Apple Watch yakho ngaphambi kokulala. I-watchOS ilungisa i-alamu kuphela lapho i-app ivuliwe."
          }
        }
      }
    },
