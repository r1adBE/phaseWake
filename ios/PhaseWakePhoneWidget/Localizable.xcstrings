        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nachten uit Apple Health en andere apps kunnen hier ook verschijnen. Vergelijk met gezondheidsgegevens om ze te zien."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Health ਅਤੇ ਹੋਰ ਐਪਾਂ ਦੀਆਂ ਰਾਤਾਂ ਵੀ ਇੱਥੇ ਦਿਖ ਸਕਦੀਆਂ ਹਨ। ਉਨ੍ਹਾਂ ਨੂੰ ਦੇਖਣ ਲਈ ਸਿਹਤ ਡਾਟੇ ਨਾਲ ਤੁਲਨਾ ਕਰੋ।"
          }
