    "record_hint": {
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Jou horlosie meet deur die hele nag beweging en polsslag. Dit gebruik ’n bietjie battery – laai die horlosie voor jy gaan slaap."
          }
        },
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "ሰዓትህ ሌሊቱን ሙሉ እንቅስቃሴና የልብ ምት ይለካል። ይህ ትንሽ ባትሪ ይጠቀማል – ከመተኛትህ በፊት ሰዓቱን ቻርጅ አድርግ።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تقيس ساعتك الحركة والنبض طوال الليل. يستهلك ذلك بعض البطارية – اشحن الساعة قبل النوم."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Saatın bütün gecə boyunca hərəkəti və nəbzi ölçür. Bu, bir az batareya sərf edir – yatmazdan əvvəl saatı doldur."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Часовникът ти измерва движение и пулс през цялата нощ. Това изразходва малко батерия – зареди часовника преди сън."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "তোমার ঘড়ি সারা রাত জুড়ে নড়াচড়া ও পালস মাপে। এতে কিছুটা ব্যাটারি লাগে – ঘুমানোর আগে ঘড়ি চার্জ করো।"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tvoj sat mjeri pokrete i puls tokom cijele noći. To troši nešto baterije – napuni sat prije spavanja."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "El rellotge mesura moviment i pols al llarg de tota la nit. Això gasta una mica de bateria – carrega el rellotge abans de dormir."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tvoje hodinky měří přes celou noc pohyb a tep. Spotřebuje to trochu baterie – nabij hodinky před spaním."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit ur måler bevægelse og puls gennem hele natten. Det bruger lidt batteri – oplad uret, før du sover."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Uhr misst über die ganze Nacht Bewegung und Puls. Das kostet etwas Akku – lade die Uhr vor dem Schlafen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το ρολόι σου μετρά κίνηση και παλμούς σε όλη τη διάρκεια της νύχτας. Αυτό καταναλώνει λίγη μπαταρία – φόρτισε το ρολόι πριν κοιμηθείς."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your watch measures motion and pulse throughout the night. This uses some battery – charge the watch before you go to sleep."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu reloj mide movimiento y pulso a lo largo de toda la noche. Esto gasta algo de batería: carga el reloj antes de dormir."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Sinu kell mõõdab kogu öö jooksul liikumist ja pulssi. See kulutab veidi akut – lae kell enne magamaminekut."
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "Erlojuak mugimendua eta pultsua neurtzen ditu gau osoan zehar. Horrek bateria pixka bat gastatzen du – kargatu erlojua lo egin aurretik."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "ساعتت در طول تمام شب حرکت و نبض را اندازه می‌گیرد. این کار کمی باتری مصرف می‌کند – قبل از خواب ساعت را شارژ کن."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kellosi mittaa liikettä ja sykettä koko yön mittaan. Se kuluttaa hieman akkua – lataa kello ennen nukkumaanmenoa."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Sinusukat ng relo mo ang galaw at pulso sa buong gabi. Gumagamit ito ng kaunting baterya – i-charge ang relo bago matulog."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta montre mesure mouvements et pouls tout au long de la nuit. Cela consomme un peu de batterie – recharge la montre avant de dormir."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Tomhaiseann d’uaireadóir gluaiseacht agus cuisle i rith na hoíche ar fad. Úsáideann sé seo beagán ceallra – luchtaigh an t-uaireadóir sula dtéann tú a chodladh."
          }
        },
        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "O teu reloxo mide movemento e pulso ao longo de toda a noite. Isto gasta algo de batería: carga o reloxo antes de durmir."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તારી ઘડિયાળ આખી રાત દરમિયાન હલનચલન અને પલ્સ માપે છે. આમાં થોડી બેટરી વપરાય છે – સૂતા પહેલાં ઘડિયાળ ચાર્જ કરી લે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "השעון שלך מודד תנועה ודופק לאורך כל הלילה. זה צורך מעט סוללה – כדאי לטעון את השעון לפני השינה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "तुम्हारी घड़ी पूरी रात हलचल और पल्स मापती है। इसमें थोड़ी बैटरी लगती है – सोने से पहले घड़ी चार्ज करो।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tvoj sat mjeri pokrete i puls tijekom cijele noći. To troši nešto baterije – napuni sat prije spavanja."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az órád egész éjszakán át méri a mozgást és a pulzust. Ez némi akkumulátort fogyaszt – alvás előtt töltsd fel az órát."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ժամացույցդ ամբողջ գիշերվա ընթացքում չափում է շարժումն ու զարկերակը։ Սա որոշ չափով մարտկոց է ծախսում – քնելուց առաջ լիցքավորիր ժամացույցը։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jam tanganmu mengukur gerakan dan denyut nadi sepanjang malam. Ini memakai sedikit baterai – isi daya jam sebelum tidur."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Úrið þitt mælir hreyfingu og púls yfir alla nóttina. Það notar dálítið af rafhlöðunni – hladdu úrið áður en þú ferð að sofa."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo orologio misura movimento e battito durante tutta la notte. Consuma un po’ di batteria – ricarica l’orologio prima di dormire."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "時計が夜を通して、体の動きと脈拍を計測します。バッテリーを少し使います – 寝る前に時計を充電してください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "შენი საათი მთელი ღამის განმავლობაში ზომავს მოძრაობას და პულსს. ეს ცოტა ბატარეას ხარჯავს – დაძინებამდე დატენე საათი."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сағатың түні бойы қозғалыс пен пульсті өлшейді. Бұл біраз батарея жұмсайды – ұйықтар алдында сағатты зарядта."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "នាឡិការបស់អ្នកវាស់ចលនា និងជីពចរពេញមួយយប់។ វាប្រើថ្មខ្លះ – សាកថ្មនាឡិកាមុនពេលគេង។"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನಿನ್ನ ವಾಚ್ ರಾತ್ರಿಯಿಡೀ ಚಲನೆ ಮತ್ತು ನಾಡಿಯನ್ನು ಅಳೆಯುತ್ತದೆ. ಇದಕ್ಕೆ ಸ್ವಲ್ಪ ಬ್ಯಾಟರಿ ಬೇಕು – ಮಲಗುವ ಮೊದಲು ವಾಚ್ ಚಾರ್ಜ್ ಮಾಡು."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시계가 밤새 움직임과 맥박을 측정해요. 배터리를 조금 써요 – 자기 전에 시계를 충전하세요."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ໂມງຂອງເຈົ້າວັດການເຄື່ອນໄຫວ ແລະ ຊີບພະຈອນຕະຫຼອດຄືນ. ມັນໃຊ້ແບັດເຕີຣີບາງສ່ວນ – ສາກໂມງກ່ອນນອນ."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Tavo laikrodis visą naktį matuoja judesį ir pulsą. Tai sunaudoja šiek tiek baterijos – įkrauk laikrodį prieš miegą."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tavs pulkstenis visas nakts garumā mēra kustību un pulsu. Tas patērē nedaudz akumulatora – uzlādē pulksteni pirms gulētiešanas."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Твојот часовник мери движење и пулс низ целата ноќ. Тоа троши малку батерија – наполни го часовникот пред спиење."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിന്റെ വാച്ച് രാത്രി മുഴുവൻ ചലനവും പൾസും അളക്കുന്നു. ഇതിന് കുറച്ച് ബാറ്ററി വേണം – ഉറങ്ങുന്നതിന് മുമ്പ് വാച്ച് ചാർജ് ചെയ്യൂ."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Таны цаг шөнөжингөө хөдөлгөөн болон судасны цохилтыг хэмждэг. Энэ нь бага зэрэг батерей зарцуулна – унтахын өмнө цагаа цэнэглээрэй."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुझे घड्याळ रात्रभर हालचाल आणि नाडी मोजते. यासाठी थोडी बॅटरी लागते – झोपण्यापूर्वी घड्याळ चार्ज कर."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Jam tangan anda mengukur pergerakan dan nadi sepanjang malam. Ini menggunakan sedikit bateri – cas jam sebelum tidur."
          }
        },
        "my": {
          "stringUnit": {
            "state": "translated",
            "value": "သင့်နာရီသည် တစ်ညလုံး လှုပ်ရှားမှုနှင့် သွေးခုန်နှုန်းကို တိုင်းတာသည်။ ၎င်းသည် ဘက်ထရီ အနည်းငယ် သုံးသည် – မအိပ်မီ နာရီကို အားသွင်းပါ။"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Klokken din måler bevegelse og puls gjennom hele natten. Det bruker litt batteri – lad klokken før du legger deg."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "तिम्रो घडीले रातभर चाल र नाडी नाप्छ। यसले केही ब्याट्री खपत गर्छ – सुत्नुअघि घडी चार्ज गर।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je horloge meet de hele nacht door beweging en hartslag. Dat kost wat batterij – laad het horloge op voordat je gaat slapen."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਤੇਰੀ ਘੜੀ ਸਾਰੀ ਰਾਤ ਹਿਲਜੁਲ ਅਤੇ ਨਬਜ਼ ਮਾਪਦੀ ਹੈ। ਇਸ ਵਿੱਚ ਕੁਝ ਬੈਟਰੀ ਲੱਗਦੀ ਹੈ – ਸੌਣ ਤੋਂ ਪਹਿਲਾਂ ਘੜੀ ਚਾਰਜ ਕਰ ਲੈ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twój zegarek mierzy ruch i tętno przez całą noc. Zużywa to trochę baterii – naładuj zegarek przed snem."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu relógio mede movimento e pulso ao longo de toda a noite. Isso gasta um pouco de bateria – carregue o relógio antes de dormir."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O teu relógio mede movimento e pulso ao longo de toda a noite. Isto gasta um pouco de bateria – carrega o relógio antes de dormir."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ceasul tău măsoară mișcarea și pulsul de-a lungul întregii nopți. Asta consumă puțină baterie – încarcă ceasul înainte de culcare."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Твои часы измеряют движение и пульс в течение всей ночи. Это расходует немного заряда – заряди часы перед сном."
          }
        },
        "si": {
          "stringUnit": {
            "state": "translated",
            "value": "ඔබේ ඔරලෝසුව රාත්‍රිය පුරා චලනය සහ නාඩිය මනියි. මෙයට බැටරියෙන් ටිකක් වැය වේ – නින්දට පෙර ඔරලෝසුව ආරෝපණය කරන්න."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Tvoje hodinky merajú cez celú noc pohyb a pulz. Spotrebuje to trochu batérie – nabi hodinky pred spaním."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tvoja ura čez vso noč meri gibanje in utrip. To porabi nekaj baterije – napolni uro pred spanjem."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Ora jote mat lëvizjen dhe pulsin gjatë gjithë natës. Kjo harxhon pak bateri – karikoje orën para se të flesh."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Твој сат мери покрете и пулс током целе ноћи. То троши нешто батерије – напуни сат пре спавања."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Din klocka mäter rörelse och puls under hela natten. Det drar lite batteri – ladda klockan innan du sover."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Saa yako hupima mwendo na mapigo ya moyo usiku kucha. Hii hutumia betri kidogo – chaji saa kabla ya kulala."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உன் கடிகாரம் இரவு முழுவதும் அசைவையும் நாடியையும் அளக்கிறது. இதற்குச் சிறிது பேட்டரி செலவாகும் – தூங்கும் முன் கடிகாரத்தை சார்ஜ் செய்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "నీ వాచ్ రాత్రంతా కదలిక, నాడిని కొలుస్తుంది. దీనికి కొంత బ్యాటరీ ఖర్చవుతుంది – నిద్రపోయే ముందు వాచ్‌ను ఛార్జ్ చేయి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "นาฬิกาของคุณวัดการเคลื่อนไหวและชีพจรตลอดทั้งคืน การบันทึกนี้ใช้แบตเตอรี่อยู่บ้าง – ชาร์จนาฬิกาก่อนนอน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saatin bütün gece boyunca hareketi ve nabzı ölçer. Bu biraz pil harcar – uyumadan önce saati şarj et."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Твій годинник вимірює рух і пульс протягом усієї ночі. Це витрачає трохи заряду – заряди годинник перед сном."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "تمہاری گھڑی پوری رات حرکت اور نبض ناپتی ہے۔ اس میں کچھ بیٹری لگتی ہے – سونے سے پہلے گھڑی چارج کر لو۔"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Soating tun bo‘yi harakat va pulsni o‘lchaydi. Bu biroz batareya sarflaydi – uxlashdan oldin soatni quvvatla."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đồng hồ của bạn đo chuyển động và nhịp tim suốt đêm. Việc này tốn một ít pin – hãy sạc đồng hồ trước khi ngủ."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "你部手錶成晚測量動作同脈搏。咁樣會用一啲電量——瞓覺前記得幫手錶充電。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的手表在整个夜间测量动作和脉搏。这会消耗一些电量——睡前请给手表充电。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的手錶在整個夜間測量動作和脈搏。這會消耗一些電量——睡前請替手錶充電。"
          }
        },
        "zu": {
          "stringUnit": {
            "state": "translated",
            "value": "Iwashi lakho lilinganisa ukunyakaza nokushaya kwenhliziyo ubusuku bonke. Lokhu kusebenzisa ibhethri elincane – shaja iwashi ngaphambi kokulala."
          }
        }
      }
    },
