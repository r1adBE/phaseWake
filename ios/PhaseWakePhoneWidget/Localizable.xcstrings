    "editor_advice_text|few": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "في %1$lld من آخر %2$lld ليالٍ لم يظهر نوم خفيف ضمن النافذة. مع %3$lld دقيقة تزداد فرص الاستيقاظ في لحظة مناسبة."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "U %1$lld od posljednje %2$lld noći u intervalu nije bilo laganog sna. S %3$lld min češće ćeš se probuditi u dobrom trenutku."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "V %1$lld z posledních %2$lld nocí se v okně neobjevil žádný lehký spánek. S %3$lld min se budeš častěji budit ve vhodnou chvíli."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Ní raibh codladh éadrom san fhuinneog i %1$lld as na %2$lld oíche dheireanacha. Le %3$lld nóim, is minice a dhúiseoidh tú ag nóiméad maith."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "U %1$lld od posljednje %2$lld noći u intervalu nije bilo laganog sna. S %3$lld min češće ćeš se probuditi u dobrom trenutku."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Per %1$lld iš paskutinių %2$lld naktų lange nebuvo lengvo miego. Su %3$lld min dažniau pabusi tinkamu metu."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "W %1$lld z ostatnich %2$lld nocy w oknie nie było lekkiego snu. Przy %3$lld min częściej obudzisz się w dobrym momencie."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "În %1$lld din ultimele %2$lld nopți nu a fost somn ușor în fereastră. Cu %3$lld min te vei trezi mai des într-un moment bun."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В %1$lld из последних %2$lld ночей в окне не было лёгкого сна. С %3$lld мин ты чаще будешь просыпаться в удачный момент."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "V %1$lld z posledných %2$lld nocí nebol v okne ľahký spánok. S %3$lld min ťa budík častejšie zobudí v dobrej chvíli."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "V %1$lld od zadnjih %2$lld noči v oknu ni bilo lahkega spanca. S %3$lld min te bo ura pogosteje zbudila ob pravem trenutku."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "У %1$lld од последње %2$lld ноћи у интервалу није било лаганог сна. Са %3$lld мин чешће ћеш се будити у добром тренутку."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "У %1$lld з останніх %2$lld ночей у вікні не було легкого сну. З %3$lld хв ти частіше прокидатимешся у слушний момент."
          }
        }
      }
    },
    "editor_advice_text|many": {
