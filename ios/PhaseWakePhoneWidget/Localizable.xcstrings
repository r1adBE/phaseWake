    "night_no_stages": {
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Jou gesondheidsdata het geen slaapfases vir hierdie nag nie."
          }
        },
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "የጤና ውሂብዎ ለዚህ ሌሊት የእንቅልፍ ደረጃዎች የሉትም።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا تتضمن بياناتك الصحية مراحل نوم لهذه الليلة."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Sağlamlıq məlumatlarında bu gecə üçün yuxu mərhələləri yoxdur."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Здравните ти данни нямат фази на съня за тази нощ."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "তোমার স্বাস্থ্য ডেটায় এই রাতের ঘুমের পর্যায় নেই।"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tvoji zdravstveni podaci nemaju faze sna za ovu noć."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Les teves dades de salut no tenen fases de son per a aquesta nit."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tvoje zdravotní data nemají pro tuto noc fáze spánku."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dine helbredsdata har ingen søvnfaser for denne nat."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für diese Nacht liefern die Gesundheitsdaten keine Schlafphasen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τα δεδομένα υγείας σου δεν έχουν φάσεις ύπνου για αυτή τη νύχτα."
