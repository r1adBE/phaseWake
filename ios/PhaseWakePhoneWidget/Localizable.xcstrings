        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "აქ შეიძლება გამოჩნდეს Apple Health-ისა და სხვა აპების ღამეებიც. მათ სანახავად შეადარე ჯანმრთელობის მონაცემებს."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Мұнда Apple Health және басқа қолданбалардың түндері де көрсетілуі мүмкін. Оларды көру үшін денсаулық деректерімен салыстыр."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "យប់ពី Apple Health និងកម្មវិធីផ្សេងទៀតក៏អាចបង្ហាញនៅទីនេះដែរ។ ដើម្បីមើលវា សូមប្រៀបធៀបជាមួយទិន្នន័យសុខភាព។"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Health ಮತ್ತು ಇತರ ಆ್ಯಪ್‌ಗಳ ರಾತ್ರಿಗಳೂ ಇಲ್ಲಿ ಕಾಣಿಸಬಹುದು. ಅವುಗಳನ್ನು ನೋಡಲು, ಆರೋಗ್ಯ ಡೇಟಾದೊಂದಿಗೆ ಹೋಲಿಸಿ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Health와 다른 앱의 밤도 여기에 표시될 수 있어요. 보려면 건강 데이터와 비교하세요."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ຄືນຈາກ Apple Health ແລະ ແອັບອື່ນກໍສາມາດສະແດງຢູ່ນີ້ໄດ້. ເພື່ອເບິ່ງ ໃຫ້ປຽບທຽບກັບຂໍ້ມູນສຸຂະພາບ."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Čia gali būti rodomos ir naktys iš programos Apple Health bei kitų programų. Kad jas matytum, palygink su sveikatos duomenimis."
