    "onb_welcome_text": {
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake maak jou binne jou wekvenster wakker sodra jy onrustig word – dan slaap jy waarskynlik lig. Uiterlik presies op jou teikentyd. Jou horlosie meet, jou foon lui ook."
          }
        },
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake እረፍት ማጣት ሲጀምሩ በመቀስቀሻ ክልልዎ ውስጥ ይቀሰቅስዎታል – ያኔ ምናልባት ቀላል እንቅልፍ ላይ ነዎት። ቢዘገይ በትክክል በታለመው ሰዓት። ሰዓትዎ ይለካል፣ ስልክዎም ይደውላል።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يوقظك Phase Wake ضمن نافذة الاستيقاظ بمجرد أن تبدأ بالتململ – فعندها يكون نومك خفيفًا على الأرجح. وفي أقصى الأحوال في الموعد المحدد تمامًا. الساعة تقيس، والهاتف يرنّ أيضًا."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake narahat olmağa başlayan kimi səni oyanma pəncərəsi daxilində oyadır – o zaman çox güman ki, yüngül yatırsan. Ən gec düz hədəf vaxtında. Saatın ölçür, telefonun da çalır."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake те събужда в прозореца за събуждане, щом сънят ти стане неспокоен – тогава вероятно спиш леко. Най-късно точно в целевия час. Часовникът измерва, телефонът също звъни."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "তুমি অস্থির হতে শুরু করলেই Phase Wake তোমাকে জাগানোর সময়সীমার মধ্যে জাগায় – তখন সম্ভবত তোমার ঘুম হালকা। বড়জোর ঠিক লক্ষ্য সময়ে। ঘড়ি মাপে, ফোনও সঙ্গে বাজে।"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake te budi unutar intervala buđenja čim ti san postane nemiran – tada vjerovatno lagano spavaš. Najkasnije tačno u ciljno vrijeme. Sat mjeri, a zvoni i telefon."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake et desperta dins de la finestra de despertar tan bon punt el son es torna inquiet – aleshores probablement dorms lleuger. Com a molt tard, just a l’hora objectiu. El rellotge mesura i el telèfon també sona."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake tě probudí v okně buzení, jakmile začne být tvůj spánek neklidný – tehdy nejspíš spíš lehce. Nejpozději přesně v cílový čas. Hodinky měří, telefon zvoní také."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake vækker dig inden for dit vækkevindue, så snart du bliver urolig – så sover du sandsynligvis let. Senest præcis på dit ønskede tidspunkt. Uret måler, telefonen ringer også."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake weckt dich in deinem Weckfenster, sobald du unruhig wirst – dann schläfst du wohl leicht. Spätestens pünktlich zur Zielzeit. Die Uhr misst, das Handy klingelt mit."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Phase Wake σε ξυπνά μέσα στο παράθυρο αφύπνισης μόλις ο ύπνος σου γίνει ανήσυχος – τότε μάλλον κοιμάσαι ελαφριά. Το αργότερο ακριβώς στην ώρα στόχου. Το ρολόι μετρά, χτυπά και το κινητό."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake wakes you within your wake window as soon as you get restless – that's when you're likely sleeping lightly. At the latest, right on time. Your watch measures, your phone rings too."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake te despierta dentro de tu ventana de despertar en cuanto te inquietas – entonces probablemente duermes ligero. Como muy tarde, justo a la hora objetivo. El reloj mide, el teléfono también suena."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake äratab sind äratusakna sees kohe, kui su uni muutub rahutuks – siis on su uni tõenäoliselt kerge. Hiljemalt täpselt sihtajal. Kell mõõdab, telefon heliseb ka."
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake-k esnatze-leihoaren barruan esnatzen zaitu, ezinegona hasten zaizun unean – orduan seguruenik lo arinean zaude. Beranduenez, helburuko orduan bertan. Erlojuak neurtzen du, eta telefonoak ere jotzen du."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake به‌محض اینکه بی‌قرار شوی، درون بازهٔ بیداری بیدارت می‌کند – آن موقع احتمالاً خوابت سبک است. حداکثر درست در زمان هدف. ساعت اندازه می‌گیرد، گوشی هم زنگ می‌زند."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake herättää sinut herätysikkunan sisällä heti, kun unesi muuttuu levottomaksi – silloin nukut luultavasti kevyesti. Viimeistään täsmälleen tavoiteaikana. Kello mittaa, puhelin soi myös."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ginigising ka ng Phase Wake sa loob ng window ng paggising mo sa sandaling hindi ka na mapakali – malamang mababaw ang tulog mo noon. Pinakahuli, eksakto sa target na oras. Ang relo ang sumusukat, at tumutunog din ang telepono."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake te réveille dans ta plage de réveil dès que ton sommeil devient agité – c’est alors sans doute un sommeil léger. Au plus tard, pile à l’heure cible. La montre mesure, le téléphone sonne aussi."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Dúisíonn Phase Wake thú laistigh d’fhuinneog dhúisithe chomh luath is a éiríonn tú corrthónach – is dócha go bhfuil tú i gcodladh éadrom ansin. Ar a dhéanaí, díreach ag an spriocam. Tomhaiseann d’uaireadóir, buaileann d’fhón freisin."
          }
        },
        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake espértate dentro da túa xanela de espertar en canto te inquietas – daquela probablemente durmes lixeiro. Como moi tarde, xusto á hora prevista. O reloxo mide e o teléfono tamén soa."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તમે બેચેન થવા લાગો કે તરત Phase Wake તમને જગાડવાના સમયગાળામાં જગાડે છે – ત્યારે તમારી ઊંઘ કદાચ હળવી હોય છે. વધુમાં વધુ બરાબર લક્ષ્ય સમયે. ઘડિયાળ માપે છે, ફોન પણ વાગે છે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake מעיר אתכם בתוך חלון ההשכמה ברגע שהשינה נעשית חסרת מנוחה – אז כנראה השינה קלה. לכל המאוחר בדיוק בשעת היעד. השעון מודד, וגם הטלפון מצלצל."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जैसे ही आप बेचैन होने लगते हैं, Phase Wake आपको जागने की विंडो के भीतर जगाता है – तब आपकी नींद शायद हल्की होती है। ज़्यादा से ज़्यादा ठीक लक्ष्य समय पर। वॉच मापती है, फ़ोन भी बजता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake te budi unutar intervala buđenja čim ti san postane nemiran – tada vjerojatno lagano spavaš. Najkasnije točno u ciljno vrijeme. Sat mjeri, a zvoni i telefon."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Phase Wake az ébresztési ablakon belül ébreszt, amint nyugtalan leszel – ilyenkor valószínűleg éppen könnyen alszol. Legkésőbb pontosan a célidőben. Az óra mér, a telefon is csörög."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake-ը քեզ արթնացնում է արթնացման պատուհանի սահմաններում, հենց որ անհանգիստ ես դառնում – այդ ժամանակ, հավանաբար, թեթև ես քնած։ Ամենաուշը՝ ճիշտ նպատակային ժամին։ Ժամացույցդ չափում է, հեռախոսդ էլ է զանգում։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake membangunkanmu dalam rentang bangun begitu kamu mulai gelisah – saat itu tidurmu kemungkinan sedang ringan. Paling lambat tepat pada waktu target. Jam tangan mengukur, ponsel juga berbunyi."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake vekur þig innan vakningargluggans um leið og svefninn verður órólegur – þá sefur þú líklega létt. Í síðasta lagi nákvæmlega á markmiðstíma. Úrið mælir, síminn hringir líka."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake ti sveglia nella tua finestra di risveglio non appena il tuo sonno si fa agitato – allora probabilmente stai dormendo leggero. Al più tardi, esattamente all’orario obiettivo. L’orologio misura, anche il telefono suona."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wakeは、起床時間幅の中で眠りが落ち着かなくなった時点で起こします。そのときはおそらく眠りが浅いからです。遅くとも目標時刻ちょうどに起こします。ウォッチが測定し、スマホも鳴ります。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake გაღვიძებს გაღვიძების ფანჯარაში, როგორც კი მოუსვენარი გახდები – მაშინ, სავარაუდოდ, მსუბუქად გძინავს. არაუგვიანეს ზუსტად სამიზნე დროს. საათი ზომავს, ტელეფონიც რეკავს."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake сен мазасыздана бастағанда сені ояту терезесі ішінде оятады – сол кезде ұйқың жеңіл болуы ықтимал. Ең кешінде дәл мақсатты уақытта. Сағатың өлшейді, телефоның да шырылдайды."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake ដាស់អ្នកក្នុងចន្លោះពេលដាស់ ភ្លាមៗនៅពេលអ្នកចាប់ផ្ដើមដេកមិនស្ងប់ – ពេលនោះអ្នកប្រហែលជាកំពុងដេកស្រាល។ យឺតបំផុតត្រូវម៉ោងគោលដៅពិតប្រាកដ។ នាឡិកាវាស់ ទូរសព្ទក៏រោទ៍ដែរ។"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನೀವು ಚಡಪಡಿಸಲು ಶುರುಮಾಡಿದ ತಕ್ಷಣ Phase Wake ನಿಮ್ಮನ್ನು ಎಚ್ಚರಿಸುವ ಅವಧಿಯೊಳಗೆ ಎಬ್ಬಿಸುತ್ತದೆ – ಆಗ ನೀವು ಬಹುಶಃ ಹಗುರವಾಗಿ ನಿದ್ರಿಸುತ್ತಿರುತ್ತೀರಿ. ತಡವೆಂದರೆ ಸರಿಯಾಗಿ ಗುರಿ ಸಮಯದಲ್ಲಿ. ವಾಚ್ ಅಳೆಯುತ್ತದೆ, ಫೋನ್ ಕೂಡ ರಿಂಗ್ ಆಗುತ್ತದೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake는 기상 범위 안에서 뒤척이기 시작하면 바로 깨워 줘요. 그때는 잠이 얕을 가능성이 높아요. 늦어도 목표 시간에 정확히 깨워요. 워치가 측정하고 휴대폰도 함께 울려요."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake ປຸກເຈົ້າພາຍໃນຊ່ວງເວລາປຸກ ທັນທີທີ່ເຈົ້າເລີ່ມນອນບໍ່ສະຫງົບ – ຕອນນັ້ນເຈົ້າອາດກຳລັງຫຼັບຕື້ນ ຊ້າສຸດຕົງເວລາເປົ້າໝາຍພໍດີ ໂມງວັດແທກ ໂທລະສັບກໍດັງນຳ"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake pažadina tave žadinimo lange, vos tik tavo miegas tampa neramus – tada tikriausiai miegi lengvai. Vėliausiai – tiksliai tiksliniu laiku. Laikrodis matuoja, telefonas taip pat skamba."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake tevi pamodina modināšanas logā, tiklīdz tavs miegs kļūst nemierīgs – tad tu, visticamāk, guli viegli. Vēlākais – tieši mērķa laikā. Pulkstenis mēra, tālrunis arī zvana."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake те буди во прозорецот за будење штом сонот ти стане немирен – тогаш веројатно спиеш лесно. Најдоцна точно во целното време. Часовникот мери, телефонот исто така ѕвони."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങൾ അസ്വസ്ഥരാകാൻ തുടങ്ങുമ്പോൾത്തന്നെ Phase Wake ഉണർത്തൽ സമയപരിധിക്കുള്ളിൽ നിങ്ങളെ ഉണർത്തും – അപ്പോൾ നിങ്ങൾ മിക്കവാറും നേരിയ ഉറക്കത്തിലായിരിക്കും. പരമാവധി കൃത്യമായി ലക്ഷ്യസമയത്ത്. വാച്ച് അളക്കും, ഫോണും റിങ് ചെയ്യും."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake чамайг тайван бус унтаж эхлэх үед сэрээх хугацааны дотор сэрээнэ – тэр үед чи хөнгөн унтаж байгаа байх магадлалтай. Хамгийн оройдоо яг зорилтот цагт. Цаг чинь хэмжинэ, утас чинь бас дуугарна."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुम्ही अस्वस्थ होऊ लागताच Phase Wake तुम्हाला उठवण्याच्या कालावधीत उठवते – तेव्हा तुमची झोप बहुधा हलकी असते. जास्तीत जास्त अगदी लक्ष्य वेळेवर. घड्याळ मोजते, फोनही वाजतो."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake membangunkan awak dalam tetingkap bangun sebaik sahaja awak mula gelisah – ketika itu tidur awak mungkin ringan. Selewat-lewatnya tepat pada masa sasaran. Jam tangan mengukur, telefon juga berbunyi."
          }
        },
        "my": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake သည် သင် မငြိမ်မသက် ဖြစ်လာသည်နှင့် နှိုးချိန်အပိုင်းအတွင်း နှိုးပေးသည် – ထိုအချိန်တွင် အိပ်ရေးပေါ့နေနိုင်ခြေများသည်။ အနောက်ကျဆုံး ပစ်မှတ်အချိန်တိတိတွင်။ နာရီက တိုင်းတာပြီး ဖုန်းလည်း မြည်သည်။"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake vekker deg innenfor vekkevinduet så snart du blir urolig – da sover du sannsynligvis lett. Senest nøyaktig på ønsket tid. Klokken måler, telefonen ringer også."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "तिमी छटपटिन थाल्नेबित्तिकै Phase Wake ले तिमीलाई ब्युँझाउने अवधिभित्र ब्युँझाउँछ – त्यतिबेला सम्भवतः तिम्रो निद्रा हल्का हुन्छ। बढीमा ठ्याक्कै लक्षित समयमा। घडीले मापन गर्छ, फोन पनि बज्छ।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake wekt je binnen je wekvenster zodra je onrustig wordt – dan slaap je waarschijnlijk licht. Uiterlijk precies op je doeltijd. Het horloge meet, de telefoon gaat ook af."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਜਿਵੇਂ ਹੀ ਤੁਸੀਂ ਬੇਚੈਨ ਹੋਣ ਲੱਗਦੇ ਹੋ, Phase Wake ਤੁਹਾਨੂੰ ਜਗਾਉਣ ਦੀ ਮਿਆਦ ਵਿੱਚ ਜਗਾਉਂਦਾ ਹੈ – ਉਦੋਂ ਤੁਹਾਡੀ ਨੀਂਦ ਸ਼ਾਇਦ ਹਲਕੀ ਹੁੰਦੀ ਹੈ। ਵੱਧ ਤੋਂ ਵੱਧ ਬਿਲਕੁਲ ਟੀਚੇ ਦੇ ਸਮੇਂ ’ਤੇ। ਘੜੀ ਮਾਪਦੀ ਹੈ, ਫ਼ੋਨ ਵੀ ਵੱਜਦਾ ਹੈ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake budzi cię w oknie budzenia, gdy tylko twój sen staje się niespokojny – wtedy prawdopodobnie śpisz płytko. Najpóźniej dokładnie o czasie docelowym. Zegarek mierzy, telefon też dzwoni."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Phase Wake acorda você dentro da sua janela de despertar assim que seu sono fica agitado – nessa hora você provavelmente está dormindo leve. No máximo, exatamente no horário-alvo. O relógio mede, o celular também toca."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O Phase Wake acorda-te dentro da tua janela de despertar assim que o teu sono fica agitado – nessa altura provavelmente estás a dormir leve. No máximo, exatamente à hora-alvo. O relógio mede, o telemóvel também toca."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake te trezește în intervalul de trezire imediat ce somnul tău devine agitat – atunci probabil dormi ușor. Cel târziu exact la ora țintă. Ceasul măsoară, telefonul sună și el."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake будит тебя в пределах окна пробуждения, как только твой сон становится беспокойным – тогда ты, скорее всего, спишь чутко. Не позже чем точно в целевое время. Часы измеряют, телефон тоже звонит."
          }
        },
        "si": {
          "stringUnit": {
            "state": "translated",
            "value": "ඔබ නොසන්සුන් වීමට පටන් ගත් වහාම Phase Wake ඔබව අවදි පරාසය තුළ අවදි කරයි – එවිට ඔබ බොහෝ විට සැහැල්ලුවෙන් නිදයි. අවසන් වශයෙන් හරියටම ඉලක්ක වේලාවට. ඔරලෝසුව මනියි, දුරකථනයද නාද වේ."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake ťa zobudí v okne budenia, len čo sa tvoj spánok stane nepokojným – vtedy pravdepodobne spíš ľahko. Najneskôr presne v cieľový čas. Hodinky merajú, telefón zvoní tiež."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake te zbudi v oknu bujenja, takoj ko postane tvoj spanec nemiren – takrat najverjetneje spiš lahno. Najpozneje natanko ob ciljnem času. Ura meri, telefon zvoni zraven."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake të zgjon brenda intervalit të zgjimit sapo gjumi yt bëhet i shqetësuar – atëherë ka gjasa që fle lehtë. Jo më vonë se saktësisht në orën e synuar. Ora mat, telefoni bie gjithashtu."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake те буди у оквиру интервала буђења чим ти сан постане немиран – тада вероватно лагано спаваш. Најкасније тачно у циљно време. Сат мери, а звони и телефон."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake väcker dig inom ditt väckningsfönster så snart sömnen blir orolig – då sover du troligen lätt. Senast precis på den inställda tiden. Klockan mäter, telefonen ringer också."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake inakuamsha ndani ya kipindi chako cha kuamka mara tu unapoanza kutotulia – wakati huo huenda uko katika usingizi mwepesi. Kwa kuchelewa zaidi, hasa kwa muda lengwa. Saa yako inapima, simu yako inalia pia."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நீங்கள் அமைதியின்றி அசையத் தொடங்கியதும் Phase Wake உங்களை எழுப்பும் வரம்புக்குள் எழுப்புகிறது – அப்போது நீங்கள் பெரும்பாலும் லேசாகத் தூங்குகிறீர்கள். தாமதமானாலும் சரியாக இலக்கு நேரத்தில். வாட்ச் அளவிடும், ஃபோனும் சேர்ந்து ஒலிக்கும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీరు అశాంతిగా కదలడం మొదలుపెట్టగానే Phase Wake మిమ్మల్ని నిద్రలేపే వ్యవధిలో లేపుతుంది – అప్పుడు మీ నిద్ర బహుశా తేలికగా ఉంటుంది. గరిష్ఠంగా సరిగ్గా లక్ష్య సమయానికి. వాచ్ కొలుస్తుంది, ఫోన్ కూడా మోగుతుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake ปลุกคุณภายในช่วงเวลาปลุกทันทีที่คุณเริ่มนอนกระสับกระส่าย – ตอนนั้นคุณน่าจะกำลังหลับตื้น อย่างช้าที่สุดตรงเวลาเป้าหมายพอดี นาฬิกาวัด โทรศัพท์ก็ดังด้วย"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake, huzursuzlanmaya başladığın anda seni uyandırma aralığı içinde uyandırır – o sırada büyük ihtimalle hafif uyuyorsundur. En geç tam hedef saatte. Saat ölçer, telefon da çalar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake будить тебе в межах вікна пробудження, щойно твій сон стає неспокійним – тоді ти, найімовірніше, спиш чутко. Не пізніше ніж точно в цільовий час. Годинник вимірює, телефон теж дзвонить."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "جیسے ہی تم بے چین ہونے لگو، Phase Wake تمہیں جاگنے کی ونڈو کے اندر جگاتا ہے – اس وقت غالباً تمہاری نیند ہلکی ہوتی ہے۔ زیادہ سے زیادہ ٹھیک ہدف کے وقت پر۔ گھڑی پیمائش کرتی ہے، فون بھی ساتھ بجتا ہے۔"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake bezovtalana boshlashing bilan seni uygʻotish oraligʻi ichida uygʻotadi – oʻshanda, ehtimol, yengil uxlayotgan boʻlasan. Eng kechi aynan belgilangan vaqtda. Soating oʻlchaydi, telefoning ham jiringlaydi."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake đánh thức bạn trong khoảng đánh thức ngay khi bạn bắt đầu trằn trọc – lúc đó có lẽ bạn đang ngủ nông. Muộn nhất là đúng giờ mục tiêu. Đồng hồ đo, điện thoại cũng reo."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake 會在喚醒時段內，一旦你睡得不安穩就叫醒你 – 這時你多半睡得較淺。最遲準時在目標時間。手錶負責測量，手機也會一起響。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake 会在唤醒时间窗内，一旦你睡得不安稳就叫醒你——这时你多半睡得较浅。最迟准时在目标时间。手表负责测量，手机也会响。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake 會在喚醒時段內，一旦你睡得不安穩就叫醒你——這時你多半睡得較淺。最晚準時在目標時間。手錶負責測量，手機也會響。"
          }
        },
        "zu": {
          "stringUnit": {
            "state": "translated",
            "value": "I-Phase Wake ikuvusa ngaphakathi kwesikhala sakho sokuvuka lapho uqala ukungazinzi – ngaleso sikhathi kungenzeka ulele kancane. Kamuva kakhulu, ngqo ngesikhathi esihlosiwe. Iwashi lakho liyalinganisa, nefoni yakho iyakhala."
          }
        }
      }
    },
