    "check_watch_setup_problem": {
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Maak Phase Wake een keer op die horlosie oop en laat sensors, kennisgewings en die wekkerskerm toe."
          }
        },
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wakeን በሰዓቱ ላይ አንድ ጊዜ ይክፈቱና ዳሳሾችን፣ ማሳወቂያዎችን እና የማንቂያ ማያ ገጹን ይፍቀዱ።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "افتح Phase Wake على الساعة مرة واحدة واسمح بالمستشعرات والإشعارات وشاشة المنبه."
          }
        },
        "az": {
