          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Nætter fra Apple Health og andre apps kan også vises her. Sammenlign med sundhedsdata for at se dem."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auch Nächte aus Apple Health und anderen Apps können hier erscheinen. Dafür mit Gesundheitsdaten abgleichen."
