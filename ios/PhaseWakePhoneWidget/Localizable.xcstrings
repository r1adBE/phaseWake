    "export_contents_hint": {
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Die lêer bevat bewegings- en hartklopreekse vir elke nag – sonder name, datums of toestel-ID’s."
          }
        },
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "ፋይሉ ለእያንዳንዱ ሌሊት የእንቅስቃሴና የልብ ምት ተከታታዮችን ይዟል – ያለ ስም፣ ቀን ወይም የመሣሪያ መታወቂያ።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحتوي الملف على سلاسل الحركة ونبض القلب لكل ليلة – دون أسماء أو تواريخ أو معرّفات أجهزة."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Faylda hər gecə üçün hərəkət və nəbz sıraları var – adsız, tarixsiz və cihaz ID-siz."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Файлът съдържа данни за движение и пулс за всяка нощ – без имена, дати и ID на устройства."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ফাইলে প্রতি রাতের নড়াচড়া আর হৃদস্পন্দনের ধারা থাকে – নাম, তারিখ বা ডিভাইস আইডি ছাড়া।"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Datoteka sadrži nizove pokreta i pulsa za svaku noć – bez imena, datuma i ID-ova uređaja."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "El fitxer conté sèries de moviment i freqüència cardíaca de cada nit – sense noms, dates ni identificadors de dispositiu."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Soubor obsahuje průběh pohybu a tepu za každou noc – bez jmen, dat a ID zařízení."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Filen indeholder bevægelses- og pulsserier for hver nat – uden navne, datoer eller enheds-id’er."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Datei enthält Bewegungs- und Pulsreihen jeder Nacht – ohne Namen, Datum oder Geräte-IDs."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το αρχείο περιέχει σειρές κίνησης και καρδιακών παλμών για κάθε νύχτα – χωρίς ονόματα, ημερομηνίες ή αναγνωριστικά συσκευών."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The file contains motion and heart rate series for each night – without names, dates or device IDs."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El archivo contiene series de movimiento y frecuencia cardiaca de cada noche, sin nombres, fechas ni identificadores de dispositivos."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Fail sisaldab iga öö liikumise ja pulsi andmeridu – ilma nimede, kuupäevade ja seadme ID-deta."
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "Fitxategiak gau bakoitzeko mugimendu- eta bihotz-maiztasun serieak ditu – izenik, datarik eta gailu-IDrik gabe."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "فایل شامل سری‌های حرکت و ضربان قلب هر شب است – بدون نام، تاریخ یا شناسه دستگاه."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiedosto sisältää jokaisen yön liike- ja sykesarjat – ilman nimiä, päivämääriä tai laitetunnuksia."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Laman ng file ang serye ng galaw at heart rate para sa bawat gabi – walang pangalan, petsa, o ID ng device."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le fichier contient les séries de mouvement et de fréquence cardiaque de chaque nuit – sans noms, dates ni identifiants d’appareil."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Tá sraitheanna gluaiseachta agus ráta croí do gach oíche sa chomhad – gan ainmneacha, dátaí ná aitheantais gléis."
          }
        },
        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "O ficheiro contén series de movemento e pulso de cada noite – sen nomes, datas nin ID de dispositivos."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ફાઇલમાં દરેક રાતની હલનચલન અને હૃદયના ધબકારાની શ્રેણીઓ છે – નામ, તારીખ કે ડિવાઇસ ID વગર."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הקובץ מכיל סדרות של תנועה ודופק לכל לילה – ללא שמות, תאריכים או מזהי מכשירים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फ़ाइल में हर रात की हलचल और हृदय गति की शृंखलाएँ हैं – बिना नाम, तारीख या डिवाइस आईडी के।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Datoteka sadrži nizove pokreta i pulsa za svaku noć – bez imena, datuma i ID-ova uređaja."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A fájl minden éjszaka mozgás- és pulzussorait tartalmazza – nevek, dátumok és eszközazonosítók nélkül."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ֆայլը պարունակում է յուրաքանչյուր գիշերվա շարժման և սրտի զարկերի շարքեր – առանց անունների, ամսաթվերի և սարքի ID-ների։"
          }
