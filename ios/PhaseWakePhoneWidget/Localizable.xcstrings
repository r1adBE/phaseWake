        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kako bi se alarm prikazao skroz naprijed i dok koristiš telefon."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Hogy az ébresztés akkor is legelöl jelenjen meg, amikor használod a telefont."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Որպեսզի զարթուցիչը հայտնվի ամենաառջևում, նույնիսկ երբ հեռախոսն օգտագործում ես։"
