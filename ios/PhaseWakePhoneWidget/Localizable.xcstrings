    "onb_privacy": {
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Jou data bly op jou toestelle."
          }
        },
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "ውሂብዎ በመሣሪያዎችዎ ላይ ይቆያል።"
