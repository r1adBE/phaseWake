        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "В неделя в 18:00 – известие за седмицата ти."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "প্রতি রবিবার সন্ধ্যা ৬টায় তোমার সপ্তাহ নিয়ে একটা বিজ্ঞপ্তি।"
