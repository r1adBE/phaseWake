    "notes_effect_hint": {
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Teken ’n paar aande aan, dan sien jy hier wat ’n verskil maak."
          }
        },
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "ጥቂት ምሽቶችን ይመዝግቡ፣ ከዚያ ልዩነት የሚያመጣውን እዚህ ያያሉ።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "دوّن بضع أمسيات، وسترى هنا ما الذي يؤثر."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir neçə axşam qeyd et, sonra burada nəyin fərq yaratdığını görəcəksən."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Отбележи няколко вечери и тук ще видиш какво има значение."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কয়েকটা সন্ধ্যা নোট করো, তারপর এখানে দেখবে কীসে পার্থক্য হয়।"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zabilježi nekoliko večeri, pa ćeš ovdje vidjeti šta čini razliku."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Anota-ho unes quantes nits i aquí veuràs què hi influeix."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapiš si pár večerů a tady uvidíš, co má vliv."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Skriv et par aftener ned, så ser du her, hvad der virker."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Notiere ein paar Abende, dann siehst du hier, was wirkt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Σημείωσε μερικά βράδια και εδώ θα δεις τι επιδρά."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Note down a few evenings, then you’ll see here what makes a difference."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Anota algunas noches y aquí verás qué tiene efecto."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Märgi üles mõni õhtu, siis näed siin, mis mõjutab."
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "Idatzi ohar batzuk arratsalde batzuetan, eta hemen ikusiko duzu zerk egiten duen alde."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "چند شب یادداشت کن، اینجا می‌بینی چه چیزی اثر دارد."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Merkitse muutama ilta, niin näet täällä, mikä vaikuttaa."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Magtala ng ilang gabi, at makikita mo rito kung ano ang may epekto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Note quelques soirées, puis tu verras ici ce qui a un effet."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Breac síos cúpla tráthnóna, ansin feicfidh tú anseo cad a dhéanann difríocht."
          }
        },
        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "Anota algunhas noites e aquí verás que marca a diferenza."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "થોડી સાંજ નોંધ કરો, પછી અહીં દેખાશે કે શાનાથી ફરક પડે છે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "רשום כמה ערבים, ותראה כאן מה משפיע."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कुछ शामें नोट करो, फिर यहाँ दिखेगा कि किसका असर होता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zabilježi nekoliko večeri, pa ćeš ovdje vidjeti što čini razliku."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Jegyezz fel néhány estét, és itt meglátod, mi hat."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Նշումներ արա մի քանի երեկո, հետո այստեղ կտեսնես, թե ինչն է տարբերություն տալիս։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Catat beberapa malam, lalu di sini kamu akan melihat apa yang berpengaruh."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Skráðu nokkur kvöld, þá sérðu hér hvað skiptir máli."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Annota qualche sera, poi qui vedrai cosa fa effetto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "何晩か記録すると、何が効いているかここでわかります。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "რამდენიმე საღამო ჩაინიშნე და აქ ნახავ, რა ქმნის სხვაობას."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бірнеше кешті белгіле, сонда мұнда не әсер ететінін көресің."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "កត់ចំណាំពីរបីល្ងាច ហើយអ្នកនឹងឃើញនៅទីនេះថាអ្វីធ្វើឲ្យខុសគ្នា។"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಕೆಲವು ಸಂಜೆ ಟಿಪ್ಪಣಿ ಮಾಡಿ, ಆಮೇಲೆ ಯಾವುದು ವ್ಯತ್ಯಾಸ ತರುತ್ತದೆ ಎಂದು ಇಲ್ಲಿ ಕಾಣುತ್ತದೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "며칠 저녁 기록하면 무엇이 효과가 있는지 여기서 볼 수 있어요."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ບັນທຶກສອງສາມຕອນແລງ ແລ້ວເຈົ້າຈະເຫັນຢູ່ນີ້ວ່າຫຍັງເຮັດໃຫ້ແຕກຕ່າງ"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pasižymėk kelis vakarus, tada čia pamatysi, kas turi įtakos."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Atzīmē dažus vakarus, tad šeit redzēsi, kam ir nozīme."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Запиши неколку вечери, па тука ќе видиш што прави разлика."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "കുറച്ച് വൈകുന്നേരങ്ങൾ കുറിച്ചുവയ്ക്കുക, എന്താണ് വ്യത്യാസമുണ്ടാക്കുന്നതെന്ന് ഇവിടെ കാണാം."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Хэдэн орой тэмдэглэ, тэгвэл юу нөлөөлдгийг эндээс харна."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "काही संध्याकाळी नोंद करा, मग काय फरक पडतो ते इथे दिसेल."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Catat beberapa malam, kemudian anda akan nampak di sini apa yang berkesan."
          }
        },
        "my": {
          "stringUnit": {
            "state": "translated",
            "value": "ညနေအနည်းငယ် မှတ်ထားပါ၊ ပြီးလျှင် ဘာက ကွာခြားစေသည်ကို ဤနေရာတွင် မြင်ရမည်။"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Noter noen kvelder, så ser du her hva som virker."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "केही साँझ नोट लेख, त्यसपछि के ले फरक पार्छ भनेर यहाँ देख्नेछौ।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Noteer een paar avonden, dan zie je hier wat werkt."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਕੁਝ ਸ਼ਾਮਾਂ ਨੋਟ ਕਰੋ, ਫਿਰ ਇੱਥੇ ਦਿਖੇਗਾ ਕਿ ਕਿਸ ਨਾਲ ਫ਼ਰਕ ਪੈਂਦਾ ਹੈ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zanotuj kilka wieczorów, a tutaj zobaczysz, co działa."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Anote algumas noites e aqui você vai ver o que faz efeito."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Regista algumas noites e aqui vais ver o que faz efeito."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Notează câteva seri și aici vei vedea ce are efect."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отметь несколько вечеров — и здесь увидишь, что влияет."
          }
        },
        "si": {
          "stringUnit": {
            "state": "translated",
            "value": "සන්ධ්‍යා කිහිපයක් සටහන් කරන්න, එවිට වෙනස ඇති කරන්නේ කුමක්ද කියා මෙහි පෙනේ."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapíš si pár večerov, potom tu uvidíš, čo má vplyv."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zabeleži nekaj večerov, potem se bo tu pokazalo, kaj vpliva."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Shëno disa mbrëmje, pastaj këtu do të shohësh çfarë bën ndryshim."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Забележи неколико вечери, па ћеш овде видети шта прави разлику."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Anteckna några kvällar, så ser du här vad som gör skillnad."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Andika madokezo jioni chache, kisha utaona hapa kinacholeta tofauti."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "சில மாலைகள் குறித்து வையுங்கள், பிறகு எது வேறுபாடு தருகிறது என்று இங்கே பார்ப்பீர்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "కొన్ని సాయంత్రాలు గమనిక రాయండి, తర్వాత ఏది తేడా తెస్తుందో ఇక్కడ కనిపిస్తుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "จดไว้สักสองสามคืน แล้วคุณจะเห็นที่นี่ว่าอะไรได้ผล"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Birkaç akşam not al, burada neyin etkili olduğunu görürsün."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Познач кілька вечорів — і тут побачиш, що впливає."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "چند شامیں نوٹ کرو، پھر یہاں دیکھو گے کہ کس چیز سے فرق پڑتا ہے۔"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir necha kech qayd yoz, keyin bu yerda nima farq qilishini koʻrasan."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ghi lại vài buổi tối, rồi bạn sẽ thấy ở đây điều gì có tác dụng."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "記錄幾個晚上，就可以在這裏看到甚麼有影響。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "记录几个晚上,就能在这里看到什么有影响。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "記錄幾個晚上，就能在這裡看到什麼有影響。"
          }
        },
        "zu": {
          "stringUnit": {
            "state": "translated",
            "value": "Bhala amanothi kusihlwa okumbalwa, bese uzobona lapha ukuthi yini eyenza umehluko."
