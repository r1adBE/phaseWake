        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "شام سے جاگنے کی ونڈو اور رات کے چیک کے ساتھ خاموش اطلاع۔"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Kechqurundan uyg‘onish oynasi va tungi tekshiruv bilan ovozsiz bildirishnoma."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
