        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ჩაწერა ჩართულია. ჯობია, ღამით ტელეფონი დამტენზე შეაერთო."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Жазу қосулы. Түнге телефонды зарядқа қосқаның дұрыс."
