    "home_max_alarms": {
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Tot %1$lld wekkers – vee een uit om ’n nuwe by te voeg."
          }
        },
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "እስከ %1$lld ማንቂያዎች – አዲስ ለማከል አንዱን ይሰርዙ።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld منبّهات كحد أقصى – احذف منبّهًا لإضافة منبّه جديد."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Ən çox %1$lld siqnal – yenisini əlavə etmək üçün birini sil."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "До %1$lld будилника – изтрий един, за да добавиш нов."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সর্বোচ্চ %1$lldটি অ্যালার্ম – নতুন যোগ করতে একটা মুছে ফেলো।"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Najviše %1$lld alarma – izbriši jedan da dodaš novi."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Com a màxim %1$lld alarmes – suprimeix-ne una per afegir-ne una de nova."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nejvýše %1$lld budíků – pro nový nejdřív jeden smaž."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Højst %1$lld alarmer – slet en for at tilføje en ny."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Höchstens %1$lld Wecker – lösche einen, um einen neuen anzulegen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Έως %1$lld ξυπνητήρια – διάγραψε ένα για να προσθέσεις νέο."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Up to %1$lld alarms – delete one to add a new one."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Máximo %1$lld alarmas: elimina una para añadir otra."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuni %1$lld äratust – uue lisamiseks kustuta üks."
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "Gehienez %1$lld alarma – ezabatu bat berri bat gehitzeko."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "حداکثر %1$lld زنگ – برای افزودن زنگ جدید، یکی را حذف کن."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Enintään %1$lld herätystä – poista yksi lisätäksesi uuden."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanggang %1$lld alarm – mag-delete ng isa para magdagdag ng bago."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld réveils au maximum – supprime-en un pour en ajouter un nouveau."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Suas le %1$lld aláram – scrios ceann chun ceann nua a chur leis."
          }
        },
        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ata %1$lld alarmas – elimina unha para engadir outra nova."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
