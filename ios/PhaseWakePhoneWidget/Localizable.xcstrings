    "backup_password_trivial": {
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Te maklik om te raai – vermy herhalings, reekse soos 1234 of abcd, sleutelbordrye en algemene wagwoorde."
          }
        },
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "ለመገመት በጣም ቀላል ነው – ድግግሞሾችን፣ እንደ 1234 ወይም abcd ያሉ ተከታታዮችን፣ የቁልፍ ሰሌዳ ረድፎችን እና የተለመዱ የይለፍ ቃሎችን አስወግድ።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سهلة التخمين جدًا – تجنّب التكرار والتسلسلات مثل 1234 أو abcd وصفوف لوحة المفاتيح وكلمات المرور الشائعة."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Təxmin etmək çox asandır – təkrarlardan, 1234 və ya abcd kimi ardıcıllıqlardan, klaviatura sıralarından və geniş yayılmış parollardan qaç."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Твърде лесна за отгатване – избягвай повторения, поредици като 1234 или abcd, редове от клавиатурата и често срещани пароли."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অনুমান করা খুব সহজ – পুনরাবৃত্তি, 1234 বা abcd-এর মতো ক্রম, কিবোর্ডের সারি এবং প্রচলিত পাসওয়ার্ড এড়িয়ে চলো।"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Previše lako za pogoditi – izbjegavaj ponavljanja, nizove poput 1234 ili abcd, redove tastature i česte lozinke."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Massa fàcil d’endevinar: evita repeticions, seqüències com 1234 o abcd, files del teclat i contrasenyes habituals."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Příliš snadné uhodnout – vyhni se opakování, posloupnostem jako 1234 nebo abcd, řadám kláves a běžným heslům."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "For let at gætte – undgå gentagelser, rækkefølger som 1234 eller abcd, tastaturrækker og almindelige adgangskoder."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zu leicht zu erraten – vermeide Wiederholungen, Folgen wie 1234 oder abcd, Tastaturreihen und häufige Passwörter."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πολύ εύκολο να μαντευτεί – απόφυγε επαναλήψεις, ακολουθίες όπως 1234 ή abcd, σειρές πληκτρολογίου και συνηθισμένους κωδικούς."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Too easy to guess – avoid repeated characters, sequences like 1234 or abcd, keyboard rows and common passwords."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Demasiado fácil de adivinar: evita repeticiones, secuencias como 1234 o abcd, filas del teclado y contraseñas comunes."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Liiga kergesti äraarvatav – väldi kordusi, jadasid nagu 1234 või abcd, klaviatuuriridu ja levinud paroole."
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "Errazegia asmatzeko: saihestu errepikapenak, 1234 edo abcd bezalako segidak, teklatuko errenkadak eta pasahitz ohikoak."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "حدس‌زدنش خیلی آسان است – از تکرار، دنباله‌هایی مثل 1234 یا abcd، ردیف‌های صفحه‌کلید و گذرواژه‌های رایج پرهیز کن."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Liian helppo arvata – vältä toistoja, jonoja kuten 1234 tai abcd, näppäimistön rivejä ja yleisiä salasanoja."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Masyadong madaling hulaan – iwasan ang pag-uulit, mga pagkakasunod tulad ng 1234 o abcd, mga hilera ng keyboard at mga karaniwang password."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trop facile à deviner : évite les répétitions, les suites comme 1234 ou abcd, les rangées du clavier et les mots de passe courants."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Ró-éasca le buille faoi thuairim a thabhairt – seachain athrá, seichimh mar 1234 nó abcd, sraitheanna méarchláir agus pasfhocail choitianta."
          }
        },
        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "Demasiado doado de adiviñar: evita repeticións, secuencias como 1234 ou abcd, filas do teclado e contrasinais habituais."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "અનુમાન લગાવવું ખૂબ સરળ છે – પુનરાવર્તન, 1234 કે abcd જેવી શ્રેણીઓ, કીબોર્ડની હરોળો અને સામાન્ય પાસવર્ડ ટાળો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "קל מדי לניחוש – הימנעו מחזרות, מרצפים כמו 1234 או abcd, משורות במקלדת ומסיסמאות נפוצות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अनुमान लगाना बहुत आसान है – दोहराव, 1234 या abcd जैसे क्रम, कीबोर्ड की पंक्तियाँ और आम पासवर्ड से बचो।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prelako za pogoditi – izbjegavaj ponavljanja, nizove poput 1234 ili abcd, redove tipkovnice i česte lozinke."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Túl könnyen kitalálható – kerüld az ismétléseket, az olyan sorozatokat, mint az 1234 vagy az abcd, a billentyűzetsorokat és a gyakori jelszavakat."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Չափազանց հեշտ է գուշակել – խուսափիր կրկնություններից, 1234 կամ abcd տիպի հաջորդականություններից, ստեղնաշարի շարքերից և տարածված գաղտնաբառերից։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Terlalu mudah ditebak – hindari pengulangan, urutan seperti 1234 atau abcd, baris keyboard, dan kata sandi umum."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Of auðvelt að giska á – forðastu endurtekningar, runur eins og 1234 eða abcd, lyklaborðsraðir og algeng lykilorð."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Troppo facile da indovinare: evita ripetizioni, sequenze come 1234 o abcd, file della tastiera e password comuni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "推測されやすすぎます。同じ文字の繰り返し、1234 や abcd のような連続、キーボードの並び、よく使われるパスワードは避けてください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ძალიან ადვილი გამოსაცნობია – მოერიდე გამეორებებს, 1234-ის ან abcd-ის მსგავს მიმდევრობებს, კლავიატურის რიგებს და გავრცელებულ პაროლებს."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Табу тым оңай – қайталаулардан, 1234 не abcd сияқты тізбектерден, пернетақта қатарларынан және кең тараған құпиясөздерден аулақ бол."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ងាយទាយពេក – ចៀសវាងការដដែលៗ លំដាប់ដូចជា 1234 ឬ abcd ជួរក្ដារចុច និងពាក្យសម្ងាត់ទូទៅ។"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಊಹಿಸಲು ತುಂಬಾ ಸುಲಭ – ಪುನರಾವರ್ತನೆ, 1234 ಅಥವಾ abcd ನಂತಹ ಸರಣಿಗಳು, ಕೀಬೋರ್ಡ್ ಸಾಲುಗಳು ಮತ್ತು ಸಾಮಾನ್ಯ ಪಾಸ್‌ವರ್ಡ್‌ಗಳನ್ನು ತಪ್ಪಿಸಿ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "너무 쉽게 추측할 수 있습니다. 반복, 1234나 abcd 같은 연속, 키보드 줄, 흔한 비밀번호는 피하세요."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ເດົາງ່າຍເກີນໄປ – ຫຼີກລ່ຽງການຊ້ຳກັນ, ລຳດັບເຊັ່ນ 1234 ຫຼື abcd, ແຖວແປ້ນພິມ ແລະ ລະຫັດຜ່ານທີ່ໃຊ້ທົ່ວໄປ"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Per lengva atspėti – venk pasikartojimų, sekų kaip 1234 ar abcd, klaviatūros eilių ir dažnų slaptažodžių."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Pārāk viegli uzminēt – izvairies no atkārtojumiem, virknēm kā 1234 vai abcd, tastatūras rindām un izplatītām parolēm."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Премногу лесно за погодување – избегнувај повторувања, низи како 1234 или abcd, редови од тастатурата и чести лозинки."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഊഹിക്കാൻ വളരെ എളുപ്പമാണ് – ആവർത്തനങ്ങൾ, 1234 അല്ലെങ്കിൽ abcd പോലുള്ള ക്രമങ്ങൾ, കീബോർഡ് വരികൾ, സാധാരണ പാസ്‌വേഡുകൾ എന്നിവ ഒഴിവാക്കുക."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Таахад хэт амархан – давталт, 1234 эсвэл abcd гэх мэт дараалал, гарын мөр болон түгээмэл нууц үгээс зайлсхий."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "अंदाज लावणे खूप सोपे आहे – पुनरावृत्ती, 1234 किंवा abcd सारखे क्रम, कीबोर्डच्या ओळी आणि सामान्य पासवर्ड टाळा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Terlalu mudah diteka – elakkan ulangan, jujukan seperti 1234 atau abcd, baris papan kekunci dan kata laluan biasa."
          }
        },
        "my": {
          "stringUnit": {
            "state": "translated",
            "value": "ခန့်မှန်းရန် လွယ်လွန်းသည် – ထပ်ခါထပ်ခါ စာလုံးများ၊ 1234 သို့မဟုတ် abcd ကဲ့သို့ အစဉ်များ၊ ကီးဘုတ်တန်းများနှင့် အသုံးများသော စကားဝှက်များကို ရှောင်ပါ။"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "For lett å gjette – unngå gjentakelser, rekkefølger som 1234 eller abcd, tastaturrader og vanlige passord."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "अनुमान गर्न धेरै सजिलो – दोहोरिने अक्षर, 1234 वा abcd जस्ता क्रम, किबोर्डका पङ्क्ति र सामान्य पासवर्ड नराख।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Te makkelijk te raden – vermijd herhalingen, reeksen zoals 1234 of abcd, toetsenbordrijen en veelgebruikte wachtwoorden."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਅੰਦਾਜ਼ਾ ਲਾਉਣਾ ਬਹੁਤ ਆਸਾਨ ਹੈ – ਦੁਹਰਾਅ, 1234 ਜਾਂ abcd ਵਰਗੇ ਕ੍ਰਮ, ਕੀਬੋਰਡ ਦੀਆਂ ਕਤਾਰਾਂ ਅਤੇ ਆਮ ਪਾਸਵਰਡਾਂ ਤੋਂ ਬਚੋ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zbyt łatwe do odgadnięcia – unikaj powtórzeń, ciągów jak 1234 czy abcd, rzędów klawiatury i popularnych haseł."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Fácil demais de adivinhar – evite repetições, sequências como 1234 ou abcd, fileiras do teclado e senhas comuns."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Demasiado fácil de adivinhar – evita repetições, sequências como 1234 ou abcd, filas do teclado e palavras-passe comuns."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Prea ușor de ghicit – evită repetările, secvențele ca 1234 sau abcd, rândurile de taste și parolele uzuale."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Слишком легко угадать – избегай повторов, последовательностей вроде 1234 или abcd, рядов клавиатуры и распространённых паролей."
          }
        },
        "si": {
          "stringUnit": {
            "state": "translated",
            "value": "අනුමාන කිරීමට ඉතා පහසුයි – පුනරාවර්තන, 1234 හෝ abcd වැනි අනුපිළිවෙළ, යතුරුපුවරු පේළි සහ සුලබ මුරපද වළක්වන්න."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Príliš ľahko uhádnuteľné – vyhni sa opakovaniu, postupnostiam ako 1234 alebo abcd, radom klávesnice a bežným heslám."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Preveč lahko uganiti – izogibaj se ponavljanju, zaporedjem, kot sta 1234 ali abcd, vrsticam tipkovnice in pogostim geslom."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Shumë e lehtë për t’u gjetur – shmang përsëritjet, vargjet si 1234 ose abcd, rreshtat e tastierës dhe fjalëkalimet e zakonshme."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Превише лако за погађање – избегавај понављања, низове попут 1234 или abcd, редове тастатуре и честе лозинке."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "För lätt att gissa – undvik upprepningar, följder som 1234 eller abcd, tangentbordsrader och vanliga lösenord."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Ni rahisi mno kukisia – epuka marudio, mfuatano kama 1234 au abcd, safu za kibodi na manenosiri ya kawaida."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஊகிக்க மிகவும் எளிது – திரும்பத் திரும்ப வரும் எழுத்துகள், 1234 அல்லது abcd போன்ற வரிசைகள், விசைப்பலகை வரிசைகள் மற்றும் பொதுவான கடவுச்சொற்களைத் தவிர்க்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఊహించడం చాలా సులభం – పునరావృతాలు, 1234 లేదా abcd వంటి వరుసలు, కీబోర్డ్ వరుసలు మరియు సాధారణ పాస్‌వర్డ్‌లను నివారించండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เดาง่ายเกินไป – หลีกเลี่ยงการซ้ำ ลำดับอย่าง 1234 หรือ abcd แถวแป้นพิมพ์ และรหัสผ่านที่ใช้กันทั่วไป"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tahmin etmesi çok kolay – tekrarlardan, 1234 veya abcd gibi dizilerden, klavye sıralarından ve yaygın parolalardan kaçın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Надто легко вгадати – уникай повторів, послідовностей на кшталт 1234 чи abcd, рядів клавіатури й поширених паролів."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اندازہ لگانا بہت آسان ہے – دہراؤ، 1234 یا abcd جیسی ترتیب، کی بورڈ کی قطاروں اور عام پاس ورڈز سے بچو۔"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Taxmin qilish juda oson – takrorlar, 1234 yoki abcd kabi ketma-ketliklar, klaviatura qatorlari va keng tarqalgan parollardan qoch."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Quá dễ đoán – tránh lặp lại, chuỗi như 1234 hay abcd, hàng phím và mật khẩu phổ biến."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "太容易俾人估到——避免重複字元、1234 或 abcd 呢類序列、鍵盤上連續嘅按鍵同常見密碼。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "太容易被猜到——请避免重复字符、1234 或 abcd 之类的序列、键盘上的连续按键和常见密码。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "太容易被猜到——請避免重複字元、1234 或 abcd 之類的序列、鍵盤上的連續按鍵和常見密碼。"
          }
        },
        "zu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kulula kakhulu ukuqagela – gwema ukuphindaphinda, ukulandelana okufana no-1234 noma i-abcd, imigqa yekhibhodi namaphasiwedi ajwayelekile."
          }
        }
      }
    },
