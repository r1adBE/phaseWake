            "value": "პულსი არ იყო. ღამით საათი ცოტა უფრო მჭიდროდ გაიკეთე."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Жүрек соғысы болмады. Түнде сағатты сәл қаттырақ тақ."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "គ្មានចង្វាក់បេះដូង។ ពាក់នាឡិកាឲ្យតឹងបន្តិចនៅពេលយប់។"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನಿಮ್ಮ ಹೃದಯ ಬಡಿತ ಸಿಗಲಿಲ್ಲ. ರಾತ್ರಿ ವಾಚ್ ಅನ್ನು ಸ್ವಲ್ಪ ಬಿಗಿಯಾಗಿ ಧರಿಸಿ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "심박수가 없었어요. 밤에는 워치를 조금 더 꽉 착용해 보세요."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ບໍ່ມີອັດຕາການເຕັ້ນຫົວໃຈ ໃສ່ໂມງໃຫ້ແໜ້ນຂຶ້ນໜ້ອຍໜຶ່ງໃນຕອນກາງຄືນ"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Trūko pulso duomenų. Naktį užsisek laikrodį šiek tiek tvirčiau."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Trūka pulsa. Naktī nēsā pulksteni nedaudz ciešāk."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Пулсот недостасуваше. Носи го часовникот малку поцврсто ноќе."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഹൃദയമിടിപ്പ് ലഭിച്ചില്ല. രാത്രി വാച്ച് അൽപം മുറുക്കി ധരിക്കുക."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Зүрхний цохилт чинь байхгүй байсан. Шөнө цагаа арай чанга зүү."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुमची हृदयगती मिळाली नाही. रात्री घड्याळ थोडे घट्ट घाला."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kadar denyutan jantung tiada. Pakai jam sedikit lebih ketat pada waktu malam."
          }
        },
        "my": {
          "stringUnit": {
            "state": "translated",
            "value": "နှလုံးခုန်နှုန်း မရခဲ့ပါ။ ညဘက် နာရီကို နည်းနည်း ပိုကျပ်ကျပ် ဝတ်ပါ။"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Pulsen manglet. Bruk klokken litt strammere om natten."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "तिम्रो मुटुको धड्कन थिएन। राति घडी अलि कसेर लगाऊ।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je hartslag ontbrak. Draag het horloge 's nachts wat strakker."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਤੁਹਾਡੀ ਦਿਲ ਦੀ ਧੜਕਣ ਨਹੀਂ ਮਿਲੀ। ਰਾਤ ਨੂੰ ਘੜੀ ਥੋੜ੍ਹੀ ਕੱਸ ਕੇ ਪਹਿਨੋ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brakowało tętna. Noś zegarek w nocy nieco ciaśniej."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Faltou a frequência cardíaca. Use o relógio um pouco mais justo à noite."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Faltou a frequência cardíaca. Usa o relógio um pouco mais justo à noite."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Lipsea pulsul. Poartă ceasul puțin mai strâns noaptea."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не хватало данных о пульсе. Надевай часы на ночь чуть плотнее."
          }
        },
        "si": {
          "stringUnit": {
            "state": "translated",
            "value": "ඔබේ හෘද ස්පන්දනය නොතිබුණි. රාත්‍රියේ ඔරලෝසුව ටිකක් තදින් පළඳින්න."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Chýbal tep. Nos hodinky v noci trochu tesnejšie."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Srčnega utripa ni bilo. Ponoči nosi uro malo bolj tesno."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Mungonte pulsi. Natën mbaje orën pak më shtrënguar."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Пулс је недостајао. Ноћу носи сат мало чвршће."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Pulsen saknades. Bär klockan lite tightare på natten."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Mapigo yako ya moyo hayakupatikana. Vaa saa ikubane kidogo zaidi usiku."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் இதயத் துடிப்பு கிடைக்கவில்லை. இரவில் வாட்ச்சைச் சற்று இறுக்கமாக அணியுங்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ గుండె వేగం అందలేదు. రాత్రి వాచ్‌ను కొంచెం బిగుతుగా పెట్టుకోండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่มีข้อมูลอัตราการเต้นของหัวใจ ลองสวมนาฬิกาให้กระชับขึ้นอีกนิดตอนกลางคืน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nabız verisi eksikti. Saati geceleri biraz daha sıkı tak."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бракувало даних про пульс. Одягай годинник на ніч трохи щільніше."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "تمہاری دل کی دھڑکن نہیں ملی۔ رات کو گھڑی تھوڑی کس کر پہنو۔"
