        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Жазу үшін Phase Wake-ке микрофон керек. Ол тек жазу қосулы кезде тыңдайды."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ដើម្បីថត Phase Wake ត្រូវការមីក្រូហ្វូន។ វាស្ដាប់តែពេលការថតបើកប៉ុណ្ណោះ។"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ರೆಕಾರ್ಡ್ ಮಾಡಲು Phase Wake ಗೆ ಮೈಕ್ರೋಫೋನ್ ಬೇಕು. ರೆಕಾರ್ಡಿಂಗ್ ಆನ್ ಇರುವಾಗ ಮಾತ್ರ ಕೇಳುತ್ತದೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "녹음하려면 마이크가 필요해요. 녹음 중에만 들어요."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ເພື່ອບັນທຶກ Phase Wake ຕ້ອງການໄມໂຄຣໂຟນ ມັນຟັງສະເພາະຕອນເປີດການບັນທຶກ"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Kad galėtų įrašyti, Phase Wake reikia mikrofono. Jis klausosi tik tada, kai įrašymas įjungtas."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lai ierakstītu, Phase Wake vajag mikrofonu. Tas klausās tikai tad, kad ierakstīšana ir ieslēgta."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "За снимање, Phase Wake му треба микрофонот. Слуша само додека снимањето е вклучено."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "റെക്കോർഡ് ചെയ്യാൻ Phase Wake-ന് മൈക്രോഫോൺ വേണം. റെക്കോർഡിങ് ഓണായിരിക്കുമ്പോൾ മാത്രമേ കേൾക്കൂ."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Бичихийн тулд Phase Wake-д микрофон хэрэгтэй. Бичлэг асаалттай үед л сонсоно."
          }
        },
        "mr": {
