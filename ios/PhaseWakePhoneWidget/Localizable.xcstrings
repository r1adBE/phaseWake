    "check_exact_alarms_problem": {
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Laat wekkers & herinneringe toe sodat die rugsteunwekker betyds lui."
          }
        },
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "ተጠባባቂ ማንቂያው በሰዓቱ እንዲደውል ማንቂያዎች & አስታዋሾችን ይፍቀዱ።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اسمح بالمنبهات والتذكيرات ليرنّ المنبه الاحتياطي في الوقت المحدد."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Ehtiyat siqnal vaxtında çalsın deyə “Siqnallar və xatırlatmalar”a icazə ver."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Разреши „Будилници и напомняния“, за да звънне резервният будилник навреме."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "“অ্যালার্ম ও রিমাইন্ডার”-এর অনুমতি দাও, যাতে ব্যাকআপ অ্যালার্ম ঠিক সময়ে বাজে।"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Dozvoli „Alarmi i podsjetnici“ kako bi rezervni alarm zvonio na vrijeme."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Permet «Alarmes i recordatoris» perquè l’alarma de reserva soni a l’hora."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Povol budíky a připomenutí, aby záložní budík zazvonil včas."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tillad alarmer og påmindelser, så reservealarmen ringer til tiden."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erlaube «Wecker und Erinnerungen», damit der Zweitwecker pünktlich klingelt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επίτρεψε τα ξυπνητήρια και τις υπενθυμίσεις, ώστε το εφεδρικό ξυπνητήρι να χτυπά στην ώρα του."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow alarms & reminders so the backup alarm rings on time."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite alarmas y recordatorios para que la alarma de respaldo suene a tiempo."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Luba „Äratused ja meeldetuletused“, et varuäratus heliseks õigel ajal."
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "Baimendu «Alarmak eta abisuak», ordezko alarmak garaiz jo dezan."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "زنگ‌ها و یادآوری‌ها را مجاز کن تا زنگ پشتیبان سر وقت به صدا درآید."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Salli herätykset ja muistutukset, jotta varaherätys soi ajallaan."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Payagan ang “Mga alarm at paalala” para tumunog sa oras ang backup na alarm."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorise les alarmes et rappels pour que l’alarme de secours sonne à l’heure."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Ceadaigh “Aláraim & meabhrúcháin” ionas go mbuailfidh an t-aláram cúltaca in am."
          }
        },
        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite «Alarmas e recordatorios» para que a alarma de reserva soe á hora."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "બેકઅપ એલાર્મ સમયસર વાગે તે માટે “એલાર્મ અને રિમાઇન્ડર”ને મંજૂરી આપો."
          }
        },
        "he": {
          "stringUnit": {
