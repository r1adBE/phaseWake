        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Uret er forbundet, alarmer er tilladt. Tryk for detaljer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Uhr verbunden, Wecker erlaubt. Tippen für Details."
