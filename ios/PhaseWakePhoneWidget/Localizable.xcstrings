        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "גם לילות מ־Apple Health ומאפליקציות אחרות יכולים להופיע כאן. כדי לראות אותם, השוו לנתוני בריאות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Health और दूसरे ऐप की रातें भी यहाँ दिख सकती हैं। उन्हें देखने के लिए हेल्थ डेटा से मिलान करो।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovdje se mogu prikazati i noći iz aplikacije Apple Health i drugih aplikacija. Da ih vidiš, usporedi sa zdravstvenim podacima."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Apple Health és más alkalmazások éjszakái is megjelenhetnek itt. Ha látni szeretnéd őket, vesd össze az egészségügyi adatokkal."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Այստեղ կարող են երևալ նաև Apple Health-ի և այլ հավելվածների գիշերները։ Դրանք տեսնելու համար համեմատիր առողջության տվյալների հետ։"
