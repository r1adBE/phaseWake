    "check_notifications_problem": {
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Sonder kennisgewings kan jou foon nie as rugsteunwekker lui nie."
          }
        },
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "ያለ ማሳወቂያዎች ስልክዎ እንደ ተጠባባቂ ማንቂያ መደወል አይችልም።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بدون الإشعارات لن يتمكن هاتفك من الرنين كمنبه احتياطي."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bildirişlər olmadan telefonun ehtiyat siqnal kimi çala bilməz."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Без известия телефонът не може да звъни като резервен будилник."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "বিজ্ঞপ্তি ছাড়া তোমার ফোন ব্যাকআপ অ্যালার্ম হিসেবে বাজতে পারবে না।"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Bez obavještenja telefon ne može zvoniti kao rezervni alarm."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Sense notificacions, el telèfon no pot sonar com a alarma de reserva."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Bez oznámení nemůže telefon zazvonit jako záložní budík."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Uden notifikationer kan din telefon ikke ringe som backup-alarm."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ohne Mitteilungen kann das Handy nicht als Zweitwecker klingeln."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Χωρίς ειδοποιήσεις, το κινητό σου δεν μπορεί να χτυπήσει ως εφεδρικό ξυπνητήρι."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Without notifications, your phone can’t ring as a backup alarm."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin notificaciones, tu teléfono no puede sonar como alarma de respaldo."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Ilma märguanneteta ei saa telefon varuäratusena heliseda."
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "Jakinarazpenik gabe, telefonoak ezin du ordezko alarma gisa jo."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "بدون اعلان، گوشی نمی‌تواند به‌عنوان زنگ پشتیبان زنگ بزند."
          }
        },
        "fi": {
          "stringUnit": {
