        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "तिम्रो लागि अलार्म मिलाउन Phase Wake ले तिम्रो घडीले %1$lld रात नाप्छ। राति कम्तीमा %2$lld %% ब्याट्रीसहित लगाऊ।"
