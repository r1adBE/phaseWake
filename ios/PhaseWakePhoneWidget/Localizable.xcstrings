        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ వాచ్ అందుబాటులో లేదు. దాన్ని పెట్టుకోండి, బ్లూటూత్ ఆన్‌లో ఉంచండి, వాచ్‌లో ఒకసారి Phase Wake తెరవండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ติดต่อนาฬิกาของคุณไม่ได้ ให้สวมนาฬิกา เปิด Bluetooth ไว้ และเปิด Phase Wake บนนาฬิกาสักครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saatine ulaşılamıyor. Tak, Bluetooth’u açık tut ve saatte Phase Wake’i bir kez aç."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Годинник недоступний. Одягни його, не вимикай Bluetooth і один раз відкрий Phase Wake на годиннику."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "تمہاری گھڑی سے رابطہ نہیں ہو رہا۔ اسے پہنو، Bluetooth آن رکھو اور گھڑی پر ایک بار Phase Wake کھولو۔"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Soatingga ulanib boʻlmayapti. Uni taq, Bluetoothʼni yoqiq qoldir va soatda Phase Wakeʼni bir marta och."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể kết nối với đồng hồ. Hãy đeo đồng hồ, bật Bluetooth và mở Phase Wake trên đồng hồ một lần."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "連接不到你的手錶。請戴上手錶、保持藍牙開啟，並在手錶上開啟一次 Phase Wake。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法连接到你的手表。请戴上手表，保持 Bluetooth 开启，并在手表上打开一次 Phase Wake。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法連線到你的手錶。請戴上手錶，保持 Bluetooth 開啟，並在手錶上開啟一次 Phase Wake。"
          }
        },
        "zu": {
          "stringUnit": {
            "state": "translated",
            "value": "Iwashi lakho alifinyeleleki. Lifake, gcina i-Bluetooth ivuliwe bese uvula i-Phase Wake ewashini kanye."
          }
        }
      }
    },
