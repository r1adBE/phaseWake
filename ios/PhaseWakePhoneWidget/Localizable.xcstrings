    "sounds_hint": {
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Speel teen mediavolume en stop uiterlik wanneer jou wekvenster begin."
          }
        },
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "በሚዲያ ድምፅ መጠን ይጫወታል፣ ቢዘገይም የመቀስቀሻ ክልልዎ ሲጀምር ይቆማል።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعمل بمستوى صوت الوسائط ويتوقف على الأكثر عند بدء نافذة الاستيقاظ."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Media səsi ilə oxuyur və ən gec oyanma pəncərən başlayanda dayanır."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Звучи със силата на мултимедията и спира най-късно, когато започне прозорецът за събуждане."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "মিডিয়া ভলিউমে বাজে আর জাগানোর সময়সীমা শুরু হলেই থেমে যায়।"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pušta se jačinom zvuka medija i prestaje najkasnije kad počne interval buđenja."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Sona amb el volum multimèdia i s’atura com a tard quan comença la finestra de despertar."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Hraje hlasitostí médií a skončí nejpozději, když začne tvé okno buzení."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Afspilles med medielydstyrken og stopper senest, når dit vækkevindue begynder."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Spielt mit der Medienlautstärke und hört spätestens auf, wenn dein Weckfenster beginnt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Παίζει με την ένταση πολυμέσων και σταματά το αργότερο όταν αρχίζει το παράθυρο αφύπνισής σου."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Plays at media volume and stops at the latest when your wake window begins."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Suena con el volumen multimedia y se detiene como muy tarde cuando empieza tu ventana de alarma."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Mängib meedia helitugevusel ja lõpetab hiljemalt äratusakna alguses."
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "Multimediaren bolumenean jotzen du, eta beranduenez esnatze-leihoa hastean gelditzen da."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "با صدای رسانه پخش می‌شود و حداکثر با شروع پنجرهٔ بیداری‌ات قطع می‌شود."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Soi median äänenvoimakkuudella ja loppuu viimeistään, kun herätysikkunasi alkaa."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Tumutugtog sa volume ng media at humihinto nang pinakahuli kapag nagsimula ang window ng paggising mo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Joue au volume multimédia et s’arrête au plus tard au début de ta fenêtre de réveil."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Seinntear é ag airde na meán agus stopann sé ar a dhéanaí nuair a thosaíonn d’fhuinneog dhúisithe."
          }
        },
        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "Soa co volume multimedia e para como moi tarde cando comeza a túa xanela de espertar."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "મીડિયા વૉલ્યૂમ પર વાગે છે અને જગાડવાનો સમયગાળો શરૂ થતાં જ બંધ થાય છે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מתנגן בעוצמת המדיה ונעצר לכל המאוחר כשחלון ההשכמה שלך מתחיל."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मीडिया वॉल्यूम पर चलता है और ज़्यादा से ज़्यादा तब रुक जाता है जब तुम्हारी जागने की विंडो शुरू होती है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Reproducira se glasnoćom medija i prestaje najkasnije kad počne interval buđenja."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Médiahangerőn szól, és legkésőbb akkor elhallgat, amikor az ébresztési ablakod kezdődik."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Նվագում է մեդիայի ձայնի ուժգնությամբ և կանգ է առնում ամենաուշը արթնացման պատուհանի սկզբին։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Diputar dengan volume media dan berhenti paling lambat saat jendela bangunmu dimulai."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Spilar á miðlahljóðstyrk og stöðvast í síðasta lagi þegar vakningarglugginn hefst."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Suona al volume multimediale e si ferma al più tardi quando inizia la tua finestra di sveglia."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メディアの音量で再生し、遅くとも起床ウィンドウが始まると止まります。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "უკრავს მედიის ხმით და ჩერდება არაუგვიანეს გაღვიძების ფანჯრის დაწყებისას."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Медиа дыбысымен ойнайды және ең кешінде ояту терезесі басталғанда тоқтайды."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ចាក់តាមកម្រិតសំឡេងមេឌៀ ហើយឈប់យឺតបំផុតនៅពេលចន្លោះពេលដាស់ចាប់ផ្ដើម។"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಮೀಡಿಯಾ ವಾಲ್ಯೂಮ್‌ನಲ್ಲಿ ಪ್ಲೇ ಆಗುತ್ತದೆ, ತಡವೆಂದರೆ ಎಚ್ಚರಿಸುವ ಅವಧಿ ಶುರುವಾದಾಗ ನಿಲ್ಲುತ್ತದೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "미디어 볼륨으로 재생되며 늦어도 기상 시간대가 시작되면 멈춰요."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ຫຼິ້ນດ້ວຍລະດັບສຽງມີເດຍ ແລະ ຢຸດຊ້າສຸດເມື່ອຊ່ວງເວລາປຸກເລີ່ມ"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Groja medijos garsumu ir sustoja vėliausiai prasidėjus žadinimo langui."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Skan multivides skaļumā un apstājas vēlākais tad, kad sākas modināšanas logs."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Свири со јачината за медиуми и запира најдоцна кога ќе почне прозорецот за будење."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "മീഡിയ ശബ്ദനിലയിൽ പ്ലേ ചെയ്യും, പരമാവധി ഉണർത്തൽ സമയപരിധി തുടങ്ങുമ്പോൾ നിൽക്കും."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Медиа дууны түвшинд тоглож, хамгийн оройдоо сэрээх хугацаа эхлэхэд зогсоно."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "मीडिया आवाजावर वाजते आणि उठवण्याचा कालावधी सुरू होताच थांबते."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Dimainkan pada kelantangan media dan berhenti paling lewat apabila tetingkap bangun anda bermula."
          }
        },
        "my": {
          "stringUnit": {
            "state": "translated",
            "value": "မီဒီယာအသံဖြင့် ဖွင့်ပြီး နှိုးချိန်အပိုင်း စချိန်တွင် နောက်ဆုံးထား ရပ်သည်။"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Spilles med medievolumet og stopper senest når vekkevinduet ditt begynner."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "मिडिया भोल्युममा बज्छ र बढीमा ब्युँझाउने अवधि सुरु हुँदा रोकिन्छ।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Speelt op mediavolume en stopt uiterlijk wanneer je wekvenster begint."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਮੀਡੀਆ ਆਵਾਜ਼ ’ਤੇ ਚੱਲਦਾ ਹੈ ਅਤੇ ਜਗਾਉਣ ਦੀ ਮਿਆਦ ਸ਼ੁਰੂ ਹੁੰਦਿਆਂ ਹੀ ਬੰਦ ਹੋ ਜਾਂਦਾ ਹੈ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gra z głośnością multimediów i milknie najpóźniej, gdy zaczyna się twoje okno budzenia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca no volume de mídia e para, no máximo, quando começa sua janela de despertar."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca no volume multimédia e para, no máximo, quando começa a tua janela de despertar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Se aude la volumul media și se oprește cel târziu când începe fereastra ta de trezire."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Играет на громкости медиа и выключается не позже начала твоего окна пробуждения."
          }
        },
        "si": {
          "stringUnit": {
            "state": "translated",
            "value": "මාධ්‍ය ශබ්ද මට්ටමින් වාදනය වී, අවදි පරාසය ආරම්භ වන විට අවසන් වශයෙන් නවතී."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Hrá s hlasitosťou médií a skončí najneskôr na začiatku okna budenia."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Predvaja se z glasnostjo predstavnosti in se ustavi najpozneje, ko se začne okno bujenja."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Luhet me volumin e medias dhe ndalet së voni kur nis intervali i zgjimit."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Пушта се јачином звука медија и престаје најкасније када почне интервал буђења."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Spelas på medievolym och slutar senast när ditt väckningsfönster börjar."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Inacheza kwa sauti ya midia na husimama, mwisho kabisa, pale kipindi chako cha kuamka kinapoanza."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "மீடியா ஒலியளவில் ஒலிக்கும்; எழுப்பும் வரம்பு தொடங்குவதற்குள் நின்றுவிடும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీడియా వాల్యూమ్‌లో ప్లే అవుతుంది, నిద్రలేపే వ్యవధి మొదలవగానే ఆగిపోతుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เล่นด้วยระดับเสียงสื่อ และหยุดอย่างช้าที่สุดเมื่อช่วงเวลาปลุกของคุณเริ่ม"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Medya ses seviyesinde çalar ve en geç uyandırma pencereni başladığında durur."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Грає з гучністю медіа і вимикається не пізніше початку твого вікна пробудження."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "میڈیا والیوم پر چلتی ہیں اور زیادہ سے زیادہ جاگنے کی ونڈو شروع ہوتے ہی رک جاتی ہیں۔"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Media ovozida ijro etiladi va eng kechi uygʻotish oraligʻing boshlanganda toʻxtaydi."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phát theo âm lượng phương tiện và dừng muộn nhất khi khung giờ đánh thức của bạn bắt đầu."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "以媒體音量播放，最遲在喚醒時段開始時停止。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "以媒体音量播放,最迟在你的唤醒时段开始时停止。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "以媒體音量播放，最遲在你的喚醒時段開始時停止。"
          }
        },
        "zu": {
          "stringUnit": {
            "state": "translated",
            "value": "Idlala ngevolumu yemidiya futhi iyama kamuva kakhulu lapho isikhala sakho sokuvuka siqala."
          }
        }
      }
    },
