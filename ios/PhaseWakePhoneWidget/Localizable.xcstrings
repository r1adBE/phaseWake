        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "U %1$lld od posljednjih %2$lld noći u intervalu nije bilo dobrog trenutka. S %3$lld min češće ćeš se probuditi u dobrom trenutku."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az utolsó %2$lld éjszakából %1$lld alkalommal nem volt jó pillanat az ablakban. %3$lld perccel gyakrabban ébredsz jó pillanatban."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Վերջին %2$lld գիշերից %1$lld-ում պատուհանում հարմար պահ չի եղել։ %3$lld ր-ով ավելի հաճախ կարթնանաս հարմար պահին։"
