        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Com o tempo, vais ver se acordar mais cedo te faz bem."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "În timp vei vedea dacă trezirea mai devreme îți face bine."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Со временем ты увидишь, идёт ли тебе на пользу более раннее пробуждение."
          }
        },
        "si": {
          "stringUnit": {
            "state": "translated",
            "value": "කලින් අවදි කිරීම ඔබට යහපත්ද කියා කාලයත් සමඟ ඔබට පෙනේ."
