    "check_watch_recorder_battery": {
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Jou horlosie het nie die meting voor die slaap begin nie – sy battery was te laag. Jy sal steeds gewek word."
          }
        },
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "ሰዓትህ ከእንቅልፍ በፊት ያለውን ልኬት አልጀመረም – ባትሪው በጣም ዝቅተኛ ነበር። ቢሆንም ማንቂያው ይቀሰቅስሃል።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم تبدأ ساعتك القياس قبل النوم – كانت بطاريتها منخفضة جدًا. سيوقظك المنبّه مع ذلك."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Saatın yuxudan əvvəlki ölçməni başlatmadı – batareyası çox zəif idi. Zəngli saat səni yenə də oyadacaq."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Часовникът ти не започна измерването преди сън – батерията му беше твърде слаба. Алармата пак ще те събуди."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "তোমার ঘড়ি ঘুমের আগের পরিমাপ শুরু করেনি – এর ব্যাটারি খুব কম ছিল। অ্যালার্ম তবুও তোমাকে জাগাবে।"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Sat nije pokrenuo mjerenje prije spavanja – baterija mu je bila preslaba. Alarm će te ipak probuditi."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "El rellotge no ha començat la mesura abans de dormir – tenia la bateria massa baixa. L’alarma et despertarà igualment."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Hodinky nezačaly měřit před spaním – baterie byla příliš slabá. Budík tě přesto vzbudí."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Uret startede ikke målingen før søvn – batteriet var for lavt. Du bliver stadig vækket."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Uhr hat die Messung vor dem Schlafen nicht gestartet – ihr Akku war zu schwach. Geweckt wirst du trotzdem."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το ρολόι δεν ξεκίνησε τη μέτρηση πριν από τον ύπνο – η μπαταρία του ήταν πολύ χαμηλή. Το ξυπνητήρι θα σε ξυπνήσει κανονικά."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your watch didn’t start the measurement before sleep – its battery was too low. You’ll still be woken."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu reloj no inició la medición antes de dormir: tenía la batería demasiado baja. La alarma te despertará igualmente."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kell ei alustanud enne magamaminekut mõõtmist – aku oli liiga tühi. Äratus äratab sind ikkagi."
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "Erlojuak ez du lo egin aurreko neurketa hasi – bateria baxuegi zuen. Alarmak esnatuko zaitu hala ere."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "ساعتت اندازه‌گیری پیش از خواب را شروع نکرد – باتری‌اش خیلی کم بود. زنگ هشدار باز هم بیدارت می‌کند."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kello ei aloittanut mittausta ennen nukkumista – sen akku oli liian vähissä. Herätys herättää sinut silti."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi sinimulan ng relo mo ang pagsukat bago matulog – masyadong mahina ang baterya nito. Gigisingin ka pa rin ng alarm."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta montre n’a pas lancé la mesure avant le sommeil – sa batterie était trop faible. L’alarme te réveillera quand même."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Níor thosaigh d’uaireadóir an tomhas roimh chodladh – bhí an ceallra ró-íseal. Dúiseoidh an t-aláram thú mar sin féin."
          }
        },
        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "O teu reloxo non iniciou a medición antes de durmir: tiña a batería demasiado baixa. A alarma espertarate igualmente."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તારી ઘડિયાળે ઊંઘ પહેલાંનું માપન શરૂ ન કર્યું – તેની બેટરી બહુ ઓછી હતી. એલાર્મ તો પણ તને જગાડશે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "השעון לא התחיל את המדידה לפני השינה – הסוללה שלו הייתה חלשה מדי. ההשכמה תעיר אותך בכל זאת."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "तुम्हारी घड़ी ने सोने से पहले का माप शुरू नहीं किया – उसकी बैटरी बहुत कम थी। अलार्म फिर भी तुम्हें जगाएगा।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sat nije pokrenuo mjerenje prije spavanja – baterija mu je bila preslaba. Alarm će te ipak probuditi."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az órád nem indította el az alvás előtti mérést – túl alacsony volt az akkumulátora. Az ébresztő így is felébreszt."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ժամացույցդ չսկսեց քնից առաջ չափումը – մարտկոցը շատ թույլ էր։ Զարթուցիչը միևնույն է կարթնացնի քեզ։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jam tanganmu tidak memulai pengukuran sebelum tidur – baterainya terlalu lemah. Alarm tetap akan membangunkanmu."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Úrið hóf ekki mælinguna fyrir svefn – rafhlaðan var of lág. Vekjarinn vekur þig samt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’orologio non ha avviato la misurazione prima di dormire – la batteria era troppo scarica. La sveglia ti sveglierà comunque."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ウォッチは就寝前の計測を開始しませんでした – バッテリーが少なすぎました。アラームはそれでも鳴ります。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "საათმა ძილის წინა გაზომვა არ დაიწყო – ბატარეა ძალიან დაბალი იყო. მაღვიძარა მაინც გაგაღვიძებს."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сағатың ұйқы алдындағы өлшеуді бастамады – батареясы тым аз болды. Оятқыш бәрібір сені оятады."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "នាឡិការបស់អ្នកមិនបានចាប់ផ្តើមការវាស់មុនពេលគេងទេ – ថ្មរបស់វាទាបពេក។ ម៉ោងរោទ៍នឹងនៅតែដាស់អ្នក។"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನಿನ್ನ ವಾಚ್ ನಿದ್ರೆಗೆ ಮೊದಲಿನ ಅಳತೆಯನ್ನು ಆರಂಭಿಸಲಿಲ್ಲ – ಅದರ ಬ್ಯಾಟರಿ ತುಂಬಾ ಕಡಿಮೆ ಇತ್ತು. ಅಲಾರಾಂ ಆದರೂ ನಿನ್ನನ್ನು ಎಬ್ಬಿಸುತ್ತದೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시계가 잠들기 전 측정을 시작하지 않았어요 – 배터리가 너무 부족했어요. 알람은 그래도 울려요."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ໂມງຂອງເຈົ້າບໍ່ໄດ້ເລີ່ມການວັດແທກກ່ອນນອນ – ແບັດເຕີຣີຕ່ຳເກີນໄປ. ໂມງປຸກຍັງຈະປຸກເຈົ້າຢູ່."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Laikrodis nepradėjo matavimo prieš miegą – baterija buvo per silpna. Žadintuvas vis tiek tave pažadins."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Pulkstenis nesāka mērījumu pirms miega – akumulators bija pārāk tukšs. Modinātājs tevi tik un tā pamodinās."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Часовникот не го започна мерењето пред спиење – батеријата беше преслаба. Алармот сепак ќе те разбуди."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിന്റെ വാച്ച് ഉറക്കത്തിന് മുമ്പുള്ള അളവ് തുടങ്ങിയില്ല – അതിന്റെ ബാറ്ററി വളരെ കുറവായിരുന്നു. എന്നാലും അലാറം നിന്നെ ഉണർത്തും."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Цаг чинь унтахын өмнөх хэмжилтийг эхлүүлээгүй – батерей нь хэт бага байсан. Сэрүүлэг чамайг ямар ч байсан сэрээнэ."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुझ्या घड्याळाने झोपण्यापूर्वीचे मोजमाप सुरू केले नाही – त्याची बॅटरी खूप कमी होती. अलार्म तरीही तुला उठवेल."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Jam awak tidak memulakan pengukuran sebelum tidur – baterinya terlalu lemah. Penggera tetap akan mengejutkan awak."
          }
        },
        "my": {
          "stringUnit": {
            "state": "translated",
            "value": "သင့်နာရီသည် အိပ်ချိန်မတိုင်မီ တိုင်းတာမှုကို မစတင်ခဲ့ပါ – ဘက်ထရီ အလွန်နည်းနေသည်။ သို့သော် နိုးစက်က သင့်ကို နှိုးပေးမည်။"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Klokken startet ikke målingen før søvn – batteriet var for lavt. Du blir vekket likevel."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "तिम्रो घडीले सुत्नुअघिको मापन सुरु गरेन – यसको ब्याट्री धेरै कम थियो। अलार्मले तिमीलाई तैपनि उठाउनेछ।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je horloge is de meting voor het slapen niet gestart – de batterij was te leeg. Je wordt toch gewekt."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਤੇਰੀ ਘੜੀ ਨੇ ਸੌਣ ਤੋਂ ਪਹਿਲਾਂ ਦਾ ਮਾਪ ਸ਼ੁਰੂ ਨਹੀਂ ਕੀਤਾ – ਇਸਦੀ ਬੈਟਰੀ ਬਹੁਤ ਘੱਟ ਸੀ। ਅਲਾਰਮ ਫਿਰ ਵੀ ਤੈਨੂੰ ਜਗਾਏਗਾ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zegarek nie rozpoczął pomiaru przed snem – bateria była zbyt słaba. Budzik i tak cię obudzi."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu relógio não iniciou a medição antes de dormir – a bateria estava fraca demais. O alarme vai te acordar mesmo assim."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O teu relógio não iniciou a medição antes de dormir – a bateria estava demasiado fraca. O alarme vai acordar-te na mesma."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ceasul nu a pornit măsurarea dinainte de somn – bateria era prea descărcată. Alarma te va trezi oricum."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Часы не начали измерение перед сном – заряд был слишком низким. Будильник всё равно тебя разбудит."
          }
        },
        "si": {
          "stringUnit": {
            "state": "translated",
            "value": "ඔබේ ඔරලෝසුව නින්දට පෙර මිනුම ආරම්භ කළේ නැත – එහි බැටරිය ඉතා අඩු විය. එලාමය කෙසේ වෙතත් ඔබව අවදි කරයි."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Hodinky nezačali merať pred spaním – batéria bola príliš slabá. Budík ťa aj tak zobudí."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ura ni začela meritve pred spanjem – baterija je bila preveč prazna. Budilka te bo vseeno zbudila."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Ora jote nuk e nisi matjen para gjumit – bateria ishte shumë e ulët. Alarmi do të të zgjojë gjithsesi."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Сат није покренуо мерење пре спавања – батерија му је била преслаба. Аларм ће те ипак пробудити."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Klockan startade inte mätningen före sömnen – batteriet var för lågt. Du blir väckt ändå."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Saa yako haikuanza kipimo cha kabla ya kulala – betri yake ilikuwa chini mno. Kengele bado itakuamsha."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உன் கடிகாரம் தூக்கத்திற்கு முந்தைய அளவீட்டைத் தொடங்கவில்லை – அதன் பேட்டரி மிகக் குறைவாக இருந்தது. அலாரம் எப்படியும் உன்னை எழுப்பும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "నీ వాచ్ నిద్రకు ముందు కొలతను ప్రారంభించలేదు – దాని బ్యాటరీ చాలా తక్కువగా ఉంది. అయినా అలారం నిన్ను లేపుతుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "นาฬิกาของคุณไม่ได้เริ่มการวัดก่อนนอน – แบตเตอรี่ต่ำเกินไป แต่นาฬิกาปลุกจะยังปลุกคุณตามปกติ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saatin uyku öncesi ölçümü başlatmadı – pili çok zayıftı. Alarm seni yine de uyandıracak."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Годинник не почав вимірювання перед сном – заряд був надто низький. Будильник усе одно тебе розбудить."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "تمہاری گھڑی نے سونے سے پہلے کی پیمائش شروع نہیں کی – اس کی بیٹری بہت کم تھی۔ الارم پھر بھی تمہیں جگائے گا۔"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Soating uyqudan oldingi o‘lchovni boshlamadi – batareyasi juda kam edi. Budilnik baribir seni uyg‘otadi."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đồng hồ không bắt đầu đo trước khi ngủ – pin quá yếu. Báo thức vẫn sẽ đánh thức bạn."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "手錶冇喺瞓覺前開始量度——電量太低。鬧鐘照樣會叫醒你。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "手表没有在睡前开始测量——电量太低。闹钟仍会叫醒你。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "手錶沒有在睡前開始測量——電量太低。鬧鐘仍會叫醒你。"
          }
        },
        "zu": {
          "stringUnit": {
            "state": "translated",
            "value": "Iwashi lakho alizange liqale ukulinganisa ngaphambi kokulala – ibhethri lalo beliphansi kakhulu. I-alamu isazokuvusa."
          }
        }
      }
    },
    "check_watch_recorder_motion": {
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Jou horlosie het nie die meting voor die slaap begin nie – Phase Wake mag nie bewegingsdata daarop lees nie. Laat dit toe in die horlosie se instellings onder Privaatheid. Jy sal steeds gewek word."
          }
        },
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "ሰዓትህ ከእንቅልፍ በፊት ያለውን ልኬት አልጀመረም – Phase Wake በሰዓቱ ላይ የእንቅስቃሴ ውሂብ እንዲያነብ አልተፈቀደለትም። በሰዓቱ ቅንብሮች ውስጥ በግላዊነት ስር ፍቀድለት። ቢሆንም ማንቂያው ይቀሰቅስሃል።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم تبدأ ساعتك القياس قبل النوم – لا يُسمح لـ Phase Wake بقراءة بيانات الحركة عليها. اسمح بذلك في إعدادات الساعة ضمن الخصوصية. سيوقظك المنبّه مع ذلك."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Saatın yuxudan əvvəlki ölçməni başlatmadı – Phase Wake-in orada hərəkət məlumatlarını oxumağa icazəsi yoxdur. Saatın ayarlarında Məxfilik bölməsində icazə ver. Zəngli saat səni yenə də oyadacaq."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Часовникът ти не започна измерването преди сън – Phase Wake няма разрешение да чете данни за движение на него. Разреши го в настройките на часовника под Поверителност. Алармата пак ще те събуди."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "তোমার ঘড়ি ঘুমের আগের পরিমাপ শুরু করেনি – Phase Wake-কে এতে নড়াচড়ার ডেটা পড়ার অনুমতি দেওয়া হয়নি। ঘড়ির সেটিংসে গোপনীয়তা অংশে অনুমতি দাও। অ্যালার্ম তবুও তোমাকে জাগাবে।"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Sat nije pokrenuo mjerenje prije spavanja – Phase Wake na njemu ne smije čitati podatke o pokretu. Dozvoli to u postavkama sata pod Privatnost. Alarm će te ipak probuditi."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "El rellotge no ha començat la mesura abans de dormir – Phase Wake no hi pot llegir dades de moviment. Permet-ho a la configuració del rellotge, a Privadesa. L’alarma et despertarà igualment."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Hodinky nezačaly měřit před spaním – Phase Wake v nich nesmí číst data o pohybu. Povol to v nastavení hodinek v části Soukromí. Budík tě přesto vzbudí."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Uret startede ikke målingen før søvn – Phase Wake må ikke læse bevægelsesdata på det. Tillad det i urets indstillinger under Anonymitet. Du bliver stadig vækket."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Uhr hat die Messung vor dem Schlafen nicht gestartet – Phase Wake darf dort keine Bewegungsdaten lesen. Erlaube es in den Einstellungen der Uhr unter Datenschutz. Geweckt wirst du trotzdem."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το ρολόι δεν ξεκίνησε τη μέτρηση πριν από τον ύπνο – το Phase Wake δεν επιτρέπεται να διαβάζει δεδομένα κίνησης σε αυτό. Επίτρεψέ το στις ρυθμίσεις του ρολογιού, στο Απόρρητο. Το ξυπνητήρι θα σε ξυπνήσει κανονικά."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your watch didn’t start the measurement before sleep – Phase Wake isn’t allowed to read motion data on it. Allow it in the watch’s settings under Privacy. You’ll still be woken."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu reloj no inició la medición antes de dormir: Phase Wake no puede leer datos de movimiento en él. Permítelo en los ajustes del reloj, en Privacidad. La alarma te despertará igualmente."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kell ei alustanud enne magamaminekut mõõtmist – Phase Wake ei tohi kellas liikumisandmeid lugeda. Luba see kella seadetes jaotises Privaatsus. Äratus äratab sind ikkagi."
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "Erlojuak ez du lo egin aurreko neurketa hasi – Phase Wake-k ezin ditu bertan mugimendu-datuak irakurri. Baimendu erlojuaren ezarpenetan, Pribatutasuna atalean. Alarmak esnatuko zaitu hala ere."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "ساعتت اندازه‌گیری پیش از خواب را شروع نکرد – Phase Wake اجازه ندارد داده‌های حرکت را روی آن بخواند. در تنظیمات ساعت، بخش حریم خصوصی، اجازه بده. زنگ هشدار باز هم بیدارت می‌کند."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kello ei aloittanut mittausta ennen nukkumista – Phase Wake ei saa lukea liiketietoja kellosta. Salli se kellon asetuksissa kohdassa Tietosuoja. Herätys herättää sinut silti."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi sinimulan ng relo mo ang pagsukat bago matulog – hindi pinapayagan ang Phase Wake na basahin ang data ng galaw dito. Payagan ito sa settings ng relo sa ilalim ng Privacy. Gigisingin ka pa rin ng alarm."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta montre n’a pas lancé la mesure avant le sommeil – Phase Wake n’a pas le droit d’y lire les données de mouvement. Autorise-le dans les réglages de la montre, sous Confidentialité. L’alarme te réveillera quand même."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Níor thosaigh d’uaireadóir an tomhas roimh chodladh – níl cead ag Phase Wake sonraí gluaiseachta a léamh air. Ceadaigh é i socruithe an uaireadóra faoi Príobháideachas. Dúiseoidh an t-aláram thú mar sin féin."
          }
        },
        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "O teu reloxo non iniciou a medición antes de durmir: Phase Wake non pode ler nel datos de movemento. Permíteo na configuración do reloxo, en Privacidade. A alarma espertarate igualmente."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તારી ઘડિયાળે ઊંઘ પહેલાંનું માપન શરૂ ન કર્યું – Phase Wake ને તેના પર હલનચલનનો ડેટા વાંચવાની મંજૂરી નથી. ઘડિયાળના સેટિંગ્સમાં ગોપનીયતા હેઠળ મંજૂરી આપ. એલાર્મ તો પણ તને જગાડશે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "השעון לא התחיל את המדידה לפני השינה – ל-Phase Wake אין הרשאה לקרוא בו נתוני תנועה. אפשר זאת בהגדרות השעון, תחת פרטיות. ההשכמה תעיר אותך בכל זאת."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "तुम्हारी घड़ी ने सोने से पहले का माप शुरू नहीं किया – Phase Wake को उस पर हलचल का डेटा पढ़ने की अनुमति नहीं है। घड़ी की सेटिंग्स में गोपनीयता के तहत अनुमति दो। अलार्म फिर भी तुम्हें जगाएगा।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sat nije pokrenuo mjerenje prije spavanja – Phase Wake na njemu ne smije čitati podatke o kretanju. Dopusti to u postavkama sata pod Privatnost. Alarm će te ipak probuditi."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az órád nem indította el az alvás előtti mérést – a Phase Wake nem olvashat rajta mozgásadatokat. Engedélyezd az óra beállításaiban az Adatvédelem alatt. Az ébresztő így is felébreszt."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ժամացույցդ չսկսեց քնից առաջ չափումը – Phase Wake-ին թույլատրված չէ դրա վրա կարդալ շարժման տվյալները։ Թույլատրիր ժամացույցի կարգավորումներում՝ Գաղտնիություն բաժնում։ Զարթուցիչը միևնույն է կարթնացնի քեզ։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jam tanganmu tidak memulai pengukuran sebelum tidur – Phase Wake tidak diizinkan membaca data gerakan di jam itu. Izinkan di pengaturan jam pada Privasi. Alarm tetap akan membangunkanmu."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Úrið hóf ekki mælinguna fyrir svefn – Phase Wake má ekki lesa hreyfigögn á því. Leyfðu það í stillingum úrsins undir Persónuvernd. Vekjarinn vekur þig samt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’orologio non ha avviato la misurazione prima di dormire – Phase Wake non può leggere i dati di movimento sull’orologio. Consentilo nelle impostazioni dell’orologio, in Privacy. La sveglia ti sveglierà comunque."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ウォッチは就寝前の計測を開始しませんでした – Phase Wake にはウォッチの動きのデータを読み取る許可がありません。ウォッチの設定の「プライバシー」で許可してください。アラームはそれでも鳴ります。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "საათმა ძილის წინა გაზომვა არ დაიწყო – Phase Wake-ს არ აქვს ნებართვა, წაიკითხოს მასზე მოძრაობის მონაცემები. დაუშვი საათის პარამეტრებში, კონფიდენციალურობის განყოფილებაში. მაღვიძარა მაინც გაგაღვიძებს."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сағатың ұйқы алдындағы өлшеуді бастамады – Phase Wake-ке онда қозғалыс деректерін оқуға рұқсат жоқ. Сағат параметрлеріндегі Құпиялық бөлімінде рұқсат бер. Оятқыш бәрібір сені оятады."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "នាឡិការបស់អ្នកមិនបានចាប់ផ្តើមការវាស់មុនពេលគេងទេ – Phase Wake មិនត្រូវបានអនុញ្ញាតឱ្យអានទិន្នន័យចលនានៅលើវាទេ។ អនុញ្ញាតវានៅក្នុងការកំណត់របស់នាឡិកា ក្រោមភាពឯកជន។ ម៉ោងរោទ៍នឹងនៅតែដាស់អ្នក។"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನಿನ್ನ ವಾಚ್ ನಿದ್ರೆಗೆ ಮೊದಲಿನ ಅಳತೆಯನ್ನು ಆರಂಭಿಸಲಿಲ್ಲ – Phase Wake ಗೆ ಅದರಲ್ಲಿ ಚಲನೆಯ ಡೇಟಾ ಓದಲು ಅನುಮತಿ ಇಲ್ಲ. ವಾಚ್‌ನ ಸೆಟ್ಟಿಂಗ್‌ಗಳಲ್ಲಿ ಗೌಪ್ಯತೆ ಅಡಿಯಲ್ಲಿ ಅನುಮತಿಸು. ಅಲಾರಾಂ ಆದರೂ ನಿನ್ನನ್ನು ಎಬ್ಬಿಸುತ್ತದೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시계가 잠들기 전 측정을 시작하지 않았어요 – Phase Wake가 시계에서 동작 데이터를 읽을 권한이 없어요. 시계 설정의 개인정보 보호에서 허용하세요. 알람은 그래도 울려요."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ໂມງຂອງເຈົ້າບໍ່ໄດ້ເລີ່ມການວັດແທກກ່ອນນອນ – Phase Wake ບໍ່ໄດ້ຮັບອະນຸຍາດໃຫ້ອ່ານຂໍ້ມູນການເຄື່ອນໄຫວໃນໂມງ. ອະນຸຍາດໃນການຕັ້ງຄ່າຂອງໂມງ ພາຍໃຕ້ຄວາມເປັນສ່ວນຕົວ. ໂມງປຸກຍັງຈະປຸກເຈົ້າຢູ່."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Laikrodis nepradėjo matavimo prieš miegą – Phase Wake negali jame skaityti judėjimo duomenų. Leisk tai laikrodžio nustatymuose, skiltyje Privatumas. Žadintuvas vis tiek tave pažadins."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Pulkstenis nesāka mērījumu pirms miega – Phase Wake nedrīkst tajā lasīt kustību datus. Atļauj to pulksteņa iestatījumos sadaļā Privātums. Modinātājs tevi tik un tā pamodinās."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Часовникот не го започна мерењето пред спиење – Phase Wake нема дозвола да чита податоци за движење на него. Дозволи го тоа во поставките на часовникот под Приватност. Алармот сепак ќе те разбуди."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിന്റെ വാച്ച് ഉറക്കത്തിന് മുമ്പുള്ള അളവ് തുടങ്ങിയില്ല – Phase Wake-ന് അതിൽ ചലന ഡാറ്റ വായിക്കാൻ അനുമതിയില്ല. വാച്ചിന്റെ ക്രമീകരണങ്ങളിൽ സ്വകാര്യതയ്ക്ക് കീഴിൽ അനുവദിക്കൂ. എന്നാലും അലാറം നിന്നെ ഉണർത്തും."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Цаг чинь унтахын өмнөх хэмжилтийг эхлүүлээгүй – Phase Wake-д түүн дээрх хөдөлгөөний өгөгдлийг унших зөвшөөрөл алга. Цагны тохиргооны Нууцлал хэсэгт зөвшөөр. Сэрүүлэг чамайг ямар ч байсан сэрээнэ."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुझ्या घड्याळाने झोपण्यापूर्वीचे मोजमाप सुरू केले नाही – Phase Wake ला त्यावर हालचालीचा डेटा वाचण्याची परवानगी नाही. घड्याळाच्या सेटिंग्जमध्ये गोपनीयता अंतर्गत परवानगी दे. अलार्म तरीही तुला उठवेल."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Jam awak tidak memulakan pengukuran sebelum tidur – Phase Wake tidak dibenarkan membaca data pergerakan pada jam itu. Benarkan dalam tetapan jam di bawah Privasi. Penggera tetap akan mengejutkan awak."
          }
        },
        "my": {
          "stringUnit": {
            "state": "translated",
            "value": "သင့်နာရီသည် အိပ်ချိန်မတိုင်မီ တိုင်းတာမှုကို မစတင်ခဲ့ပါ – Phase Wake ကို နာရီပေါ်ရှိ လှုပ်ရှားမှုဒေတာ ဖတ်ရန် ခွင့်မပြုထားပါ။ နာရီ၏ ဆက်တင်များရှိ ကိုယ်ရေးကိုယ်တာ အောက်တွင် ခွင့်ပြုပါ။ သို့သော် နိုးစက်က သင့်ကို နှိုးပေးမည်။"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Klokken startet ikke målingen før søvn – Phase Wake har ikke lov til å lese bevegelsesdata på den. Tillat det i klokkens innstillinger under Personvern. Du blir vekket likevel."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "तिम्रो घडीले सुत्नुअघिको मापन सुरु गरेन – Phase Wake लाई यसमा चालको डेटा पढ्ने अनुमति छैन। घडीको सेटिङमा गोपनीयता अन्तर्गत अनुमति देऊ। अलार्मले तिमीलाई तैपनि उठाउनेछ।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je horloge is de meting voor het slapen niet gestart – Phase Wake mag er geen bewegingsgegevens op lezen. Sta het toe in de instellingen van het horloge onder Privacy. Je wordt toch gewekt."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਤੇਰੀ ਘੜੀ ਨੇ ਸੌਣ ਤੋਂ ਪਹਿਲਾਂ ਦਾ ਮਾਪ ਸ਼ੁਰੂ ਨਹੀਂ ਕੀਤਾ – Phase Wake ਨੂੰ ਇਸ ਉੱਤੇ ਹਿਲਜੁਲ ਦਾ ਡਾਟਾ ਪੜ੍ਹਨ ਦੀ ਇਜਾਜ਼ਤ ਨਹੀਂ ਹੈ। ਘੜੀ ਦੀਆਂ ਸੈਟਿੰਗਾਂ ਵਿੱਚ ਪਰਦੇਦਾਰੀ ਹੇਠ ਇਜਾਜ਼ਤ ਦੇ। ਅਲਾਰਮ ਫਿਰ ਵੀ ਤੈਨੂੰ ਜਗਾਏਗਾ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zegarek nie rozpoczął pomiaru przed snem – Phase Wake nie może odczytywać na nim danych o ruchu. Zezwól na to w ustawieniach zegarka w sekcji Prywatność. Budzik i tak cię obudzi."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu relógio não iniciou a medição antes de dormir – o Phase Wake não tem permissão para ler dados de movimento nele. Permita nos ajustes do relógio, em Privacidade. O alarme vai te acordar mesmo assim."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O teu relógio não iniciou a medição antes de dormir – o Phase Wake não tem permissão para ler dados de movimento nele. Permite-o nas definições do relógio, em Privacidade. O alarme vai acordar-te na mesma."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ceasul nu a pornit măsurarea dinainte de somn – Phase Wake nu are voie să citească date de mișcare pe el. Permite acest lucru în setările ceasului, la Confidențialitate. Alarma te va trezi oricum."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Часы не начали измерение перед сном – Phase Wake не может читать на них данные о движении. Разреши это в настройках часов в разделе «Конфиденциальность». Будильник всё равно тебя разбудит."
          }
        },
        "si": {
          "stringUnit": {
            "state": "translated",
            "value": "ඔබේ ඔරලෝසුව නින්දට පෙර මිනුම ආරම්භ කළේ නැත – Phase Wake හට එහි චලන දත්ත කියවීමට අවසර නැත. ඔරලෝසුවේ සැකසීම්වල පෞද්ගලිකත්වය යටතේ අවසර දෙන්න. එලාමය කෙසේ වෙතත් ඔබව අවදි කරයි."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Hodinky nezačali merať pred spaním – Phase Wake v nich nesmie čítať údaje o pohybe. Povoľ to v nastaveniach hodiniek v časti Súkromie. Budík ťa aj tak zobudí."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ura ni začela meritve pred spanjem – Phase Wake na njej ne sme brati podatkov o gibanju. Dovoli to v nastavitvah ure pod Zasebnost. Budilka te bo vseeno zbudila."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Ora jote nuk e nisi matjen para gjumit – Phase Wake nuk lejohet të lexojë të dhëna lëvizjeje në të. Lejoje te cilësimet e orës, te Privatësia. Alarmi do të të zgjojë gjithsesi."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Сат није покренуо мерење пре спавања – Phase Wake на њему не сме да чита податке о кретању. Дозволи то у подешавањима сата под Приватност. Аларм ће те ипак пробудити."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Klockan startade inte mätningen före sömnen – Phase Wake får inte läsa rörelsedata på den. Tillåt det i klockans inställningar under Integritet. Du blir väckt ändå."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Saa yako haikuanza kipimo cha kabla ya kulala – Phase Wake hairuhusiwi kusoma data ya mwendo kwenye saa hiyo. Ruhusu katika mipangilio ya saa chini ya Faragha. Kengele bado itakuamsha."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உன் கடிகாரம் தூக்கத்திற்கு முந்தைய அளவீட்டைத் தொடங்கவில்லை – அதில் அசைவுத் தரவைப் படிக்க Phase Wake-க்கு அனுமதி இல்லை. கடிகார அமைப்புகளில் தனியுரிமையின் கீழ் அனுமதி கொடு. அலாரம் எப்படியும் உன்னை எழுப்பும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "నీ వాచ్ నిద్రకు ముందు కొలతను ప్రారంభించలేదు – Phase Wake కు దానిలో కదలిక డేటాను చదవడానికి అనుమతి లేదు. వాచ్ సెట్టింగ్‌లలో గోప్యత కింద అనుమతించు. అయినా అలారం నిన్ను లేపుతుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "นาฬิกาของคุณไม่ได้เริ่มการวัดก่อนนอน – Phase Wake ไม่ได้รับอนุญาตให้อ่านข้อมูลการเคลื่อนไหวบนนาฬิกา อนุญาตได้ในการตั้งค่าของนาฬิกาที่หัวข้อความเป็นส่วนตัว แต่นาฬิกาปลุกจะยังปลุกคุณตามปกติ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saatin uyku öncesi ölçümü başlatmadı – Phase Wake’in saatte hareket verilerini okuma izni yok. Saatin ayarlarında Gizlilik altında izin ver. Alarm seni yine de uyandıracak."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Годинник не почав вимірювання перед сном – Phase Wake не може читати на ньому дані про рух. Дозволь це в налаштуваннях годинника в розділі «Конфіденційність». Будильник усе одно тебе розбудить."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "تمہاری گھڑی نے سونے سے پہلے کی پیمائش شروع نہیں کی – Phase Wake کو اس پر حرکت کا ڈیٹا پڑھنے کی اجازت نہیں ہے۔ گھڑی کی ترتیبات میں رازداری کے تحت اجازت دو۔ الارم پھر بھی تمہیں جگائے گا۔"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Soating uyqudan oldingi o‘lchovni boshlamadi – Phase Wake’ga unda harakat ma’lumotlarini o‘qishga ruxsat yo‘q. Soat sozlamalarida Maxfiylik bo‘limida ruxsat ber. Budilnik baribir seni uyg‘otadi."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đồng hồ không bắt đầu đo trước khi ngủ – Phase Wake không được phép đọc dữ liệu chuyển động trên đồng hồ. Hãy cho phép trong cài đặt của đồng hồ, mục Quyền riêng tư. Báo thức vẫn sẽ đánh thức bạn."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "手錶冇喺瞓覺前開始量度——Phase Wake 冇權讀取手錶上面嘅動作資料。請喺手錶設定嘅「私隱」度允許。鬧鐘照樣會叫醒你。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "手表没有在睡前开始测量——Phase Wake 无权读取手表上的运动数据。请在手表设置的“隐私”中允许。闹钟仍会叫醒你。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "手錶沒有在睡前開始測量——Phase Wake 無權讀取手錶上的動作資料。請在手錶設定的「隱私權」中允許。鬧鐘仍會叫醒你。"
          }
        },
        "zu": {
          "stringUnit": {
            "state": "translated",
            "value": "Iwashi lakho alizange liqale ukulinganisa ngaphambi kokulala – i-Phase Wake ayivunyelwe ukufunda idatha yokunyakaza kulo. Kuvumele kumasethingi ewashi ngaphansi kokuthi Ubumfihlo. I-alamu isazokuvusa."
          }
        }
      }
    },
