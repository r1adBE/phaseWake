        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Telefondan istifadə edərkən də siqnal ən öndə görünsün deyə."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "За да се показва будилникът най-отпред, дори докато използваш телефона."
