    "learn_restart_text": {
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake meet weer %1$lld nagte. Tot dan bly die waardes wat tot nou toe aangepas is, geld."
          }
        },
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake እንደገና %1$lld ሌሊቶችን ይለካል። እስከዚያ ድረስ እስካሁን የተስተካከሉት እሴቶች ያገለግላሉ።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يقيس Phase Wake من جديد %1$lld ليالٍ. وحتى ذلك الحين تبقى القيم المكيّفة حتى الآن مستخدمة."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake yenidən %1$lld gecə ölçür. O vaxta qədər indiyədək uyğunlaşdırılmış dəyərlər qüvvədə qalır."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake отново измерва %1$lld нощи. Дотогава остават в сила досега нагласените стойности."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake আবার %1$lld রাত মাপবে। ততক্ষণ এখন পর্যন্ত মানিয়ে নেওয়া মানগুলোই চলবে।"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake ponovo mjeri %1$lld noći. Do tada vrijede dosad prilagođene vrijednosti."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake torna a mesurar %1$lld nits. Fins aleshores, es continuen fent servir els valors adaptats fins ara."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake znovu měří %1$lld nocí. Do té doby platí dosud přizpůsobené hodnoty."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake måler igen %1$lld nætter. Indtil da gælder de hidtil tilpassede værdier."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake misst wieder %1$lld Nächte. Bis dahin gelten die bisher angepassten Werte."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Phase Wake μετρά ξανά %1$lld νύχτες. Μέχρι τότε ισχύουν οι τιμές που έχουν προσαρμοστεί ως τώρα."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake measures %1$lld nights again. Until then, the values adapted so far stay in use."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake vuelve a medir %1$lld noches. Hasta entonces se siguen usando los valores adaptados hasta ahora."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake mõõdab uuesti %1$lld ööd. Seni kehtivad seni kohandatud väärtused."
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wakek berriro %1$lld gau neurtzen ditu. Ordura arte, orain arte egokitutako balioak erabiltzen dira."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake دوباره %1$lld شب اندازه می‌گیرد. تا آن موقع مقادیری که تا حالا تنظیم شده‌اند به کار می‌روند."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake mittaa taas %1$lld yötä. Siihen asti käytetään tähän asti sovitettuja arvoja."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Susukat muli ang Phase Wake ng %1$lld gabi. Hanggang doon, ginagamit pa rin ang mga value na naiangkop na."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake mesure à nouveau %1$lld nuits. D’ici là, les valeurs adaptées jusqu’à présent restent utilisées."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Tomhaiseann Phase Wake %1$lld oíche arís. Go dtí sin, úsáidtear na luachanna atá curtha in oiriúint go dtí seo."
          }
        },
        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake volve medir %1$lld noites. Ata entón seguen a usarse os valores adaptados ata agora."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake ફરીથી %1$lld રાત માપે છે. ત્યાં સુધી અત્યાર સુધી અનુકૂળ કરેલાં મૂલ્યો જ વપરાય છે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake מודד שוב %1$lld לילות. עד אז נשארים בשימוש הערכים שהותאמו עד עכשיו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake फिर से %1$lld रातें मापता है। तब तक अब तक ढाले गए मान ही चलते रहेंगे।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake ponovno mjeri %1$lld noći. Do tada vrijede dosad prilagođene vrijednosti."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Phase Wake újra %1$lld éjszakát mér. Addig az eddig igazított értékek maradnak érvényben."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake-ը նորից չափում է %1$lld գիշեր։ Մինչ այդ գործում են մինչ այժմ հարմարեցված արժեքները։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake mengukur lagi %1$lld malam. Sampai saat itu, nilai yang sudah disesuaikan tetap dipakai."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake mælir aftur %1$lld nætur. Þangað til gilda gildin sem hafa verið aðlöguð hingað til."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake misura di nuovo %1$lld notti. Fino ad allora restano in uso i valori adattati finora."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake はもう一度 %1$lld 夜を測ります。それまでは、これまでに合わせた値をそのまま使います。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake ხელახლა ზომავს %1$lld ღამეს. მანამდე მოქმედებს აქამდე მორგებული მნიშვნელობები."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake қайтадан %1$lld түн өлшейді. Оған дейін осы уақытқа дейін бейімделген мәндер қолданылады."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake វាស់ %1$lld យប់ម្តងទៀត។ រហូតដល់ពេលនោះ តម្លៃដែលបានកែសម្រួលរហូតមកដល់ពេលនេះនៅតែប្រើ។"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake ಮತ್ತೆ %1$lld ರಾತ್ರಿಗಳನ್ನು ಅಳೆಯುತ್ತದೆ. ಅಲ್ಲಿಯವರೆಗೆ ಇದುವರೆಗೆ ಹೊಂದಿಸಿದ ಮೌಲ್ಯಗಳೇ ಬಳಕೆಯಲ್ಲಿರುತ್ತವೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake가 다시 %1$lld일 밤을 측정해요. 그때까지는 지금까지 맞춘 값을 계속 사용해요."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake ວັດແທກອີກ %1$lld ຄືນ. ຈົນກວ່າຈະຮອດຕອນນັ້ນ ຄ່າທີ່ປັບມາແລ້ວຍັງໃຊ້ຢູ່."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake vėl matuoja %1$lld naktis. Iki tol galioja iki šiol pritaikytos vertės."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake atkal mēra %1$lld naktis. Līdz tam paliek spēkā līdz šim pielāgotās vērtības."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake повторно мери %1$lld ноќи. Дотогаш важат досега прилагодените вредности."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake വീണ്ടും %1$lld രാത്രി അളക്കുന്നു. അതുവരെ ഇതുവരെ ക്രമീകരിച്ച മൂല്യങ്ങൾ തന്നെ ഉപയോഗിക്കും."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake дахин %1$lld шөнө хэмжинэ. Тэр болтол одоог хүртэл тохируулсан утгууд хэрэглэгдэнэ."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake पुन्हा %1$lld रात्री मोजतो. तोपर्यंत आतापर्यंत जुळवलेली मूल्येच वापरली जातात."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake mengukur semula %1$lld malam. Sehingga itu, nilai yang telah disesuaikan setakat ini terus digunakan."
          }
        },
        "my": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake သည် %1$lld ညကို ထပ်မံတိုင်းတာသည်။ ထိုအချိန်အထိ ယခုအထိ ချိန်ညှိထားသော တန်ဖိုးများကို ဆက်သုံးသည်။"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake måler %1$lld netter på nytt. Inntil da brukes verdiene som er tilpasset hittil."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake ले फेरि %1$lld रात नाप्छ। त्यतिन्जेल अहिलेसम्म मिलाइएका मानहरू नै चल्छन्।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake meet opnieuw %1$lld nachten. Tot die tijd blijven de tot nu toe aangepaste waarden in gebruik."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake ਦੁਬਾਰਾ %1$lld ਰਾਤਾਂ ਮਾਪਦਾ ਹੈ। ਉਦੋਂ ਤੱਕ ਹੁਣ ਤੱਕ ਢਾਲੇ ਗਏ ਮੁੱਲ ਹੀ ਵਰਤੇ ਜਾਂਦੇ ਹਨ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake ponownie mierzy %1$lld nocy. Do tego czasu obowiązują dotychczas dopasowane wartości."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Phase Wake mede %1$lld noites de novo. Até lá, os valores adaptados até agora continuam valendo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O Phase Wake volta a medir %1$lld noites. Até lá, continuam a valer os valores adaptados até agora."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake măsoară din nou %1$lld nopți. Până atunci rămân valabile valorile adaptate până acum."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake снова измеряет %1$lld ночей. До тех пор действуют значения, подстроенные ранее."
          }
        },
        "si": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake නැවත රාත්‍රී %1$lld ක් මනියි. එතෙක් මේ දක්වා සකස් කළ අගයන් භාවිත වේ."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake znova meria %1$lld nocí. Dovtedy platia doteraz prispôsobené hodnoty."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake znova meri %1$lld noči. Do takrat veljajo doslej prilagojene vrednosti."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake mat përsëri %1$lld net. Deri atëherë mbeten në fuqi vlerat e përshtatura deri tani."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake поново мери %1$lld ноћи. До тада важе досад прилагођене вредности."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake mäter %1$lld nätter igen. Tills dess används de värden som anpassats hittills."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake inapima tena usiku %1$lld. Hadi hapo, thamani zilizorekebishwa hadi sasa zinaendelea kutumika."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake மீண்டும் %1$lld இரவுகளை அளக்கிறது. அதுவரை இதுவரை மாற்றிய மதிப்புகளே பயன்படும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake మళ్లీ %1$lld రాత్రులు కొలుస్తుంది. అప్పటి వరకు ఇప్పటివరకు సర్దిన విలువలే వాడబడతాయి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake จะวัดอีก %1$lld คืน ระหว่างนั้นยังใช้ค่าที่ปรับไว้จนถึงตอนนี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake yeniden %1$lld gece ölçer. O zamana kadar şimdiye kadar ayarlanan değerler kullanılmaya devam eder."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake знову вимірює %1$lld ночей. До того часу діють значення, підлаштовані раніше."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake دوبارہ %1$lld راتیں ناپتا ہے۔ تب تک اب تک ڈھالی گئی قدریں ہی استعمال ہوتی ہیں۔"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake yana %1$lld tun o‘lchaydi. Shu vaqtgacha hozirgacha moslangan qiymatlar amal qiladi."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake đo lại %1$lld đêm. Cho đến lúc đó, các giá trị đã điều chỉnh từ trước vẫn được dùng."
          }
        },
        "zh-HK": {
          "stringUnit": {
