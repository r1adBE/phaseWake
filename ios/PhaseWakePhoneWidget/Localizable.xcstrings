        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reloj conectado, alarmas permitidas. Toca para ver los detalles."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kell ühendatud, äratused lubatud. Puuduta üksikasjade nägemiseks."
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "Erlojua konektatuta, alarmak baimenduta. Sakatu xehetasunetarako."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "ساعت متصل است و هشدارها مجاز است. برای جزئیات بزن."
