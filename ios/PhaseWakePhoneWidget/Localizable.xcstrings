    "watch_not_armed": {
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Maak Phase Wake oop voor jy gaan slaap sodat jou horlosie die wekker kan aktiveer."
          }
        },
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "ሰዓትዎ ማንቂያውን ማዘጋጀት እንዲችል ከመተኛትዎ በፊት Phase Wakeን ይክፈቱ።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "افتح Phase Wake قبل أن تنام لتتمكن ساعتك من تفعيل المنبه."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Saatın siqnalı aktivləşdirə bilsin deyə yatmazdan əvvəl Phase Wake-i aç."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Отвори Phase Wake, преди да заспиш, за да може часовникът да активира будилника."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ঘুমাতে যাওয়ার আগে Phase Wake খোলো, যাতে তোমার ঘড়ি অ্যালার্ম প্রস্তুত করতে পারে।"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Otvori Phase Wake prije spavanja kako bi sat mogao aktivirati alarm."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Obre Phase Wake abans d’anar a dormir perquè el rellotge pugui activar l’alarma."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Před spaním otevři Phase Wake, aby mohly hodinky budík aktivovat."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Åbn Phase Wake, før du går i seng, så dit ur kan aktivere alarmen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne Phase Wake vor dem Schlafen, damit die Uhr den Wecker scharf schaltet."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Άνοιξε το Phase Wake πριν κοιμηθείς, ώστε το ρολόι σου να ενεργοποιήσει το ξυπνητήρι."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Phase Wake before you go to sleep so your watch can arm the alarm."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre Phase Wake antes de dormir para que tu reloj pueda activar la alarma."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Ava Phase Wake enne magamaminekut, et kell saaks äratuse valmis seada."
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ireki Phase Wake lo egin aurretik, erlojuak alarma aktiba dezan."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "پیش از خواب Phase Wake را باز کن تا ساعتت بتواند زنگ را فعال کند."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Avaa Phase Wake ennen nukkumaanmenoa, jotta kellosi voi aktivoida herätyksen."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Buksan ang Phase Wake bago ka matulog para maihanda ng relo mo ang alarm."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvre Phase Wake avant de dormir pour que ta montre puisse activer l’alarme."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Oscail Phase Wake sula dtéann tú a chodladh ionas gur féidir le d’uaireadóir an t-aláram a ghníomhachtú."
          }
        },
        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre Phase Wake antes de durmir para que o reloxo poida activar a alarma."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "સૂતાં પહેલાં Phase Wake ખોલો, જેથી તમારી ઘડિયાળ એલાર્મ સક્રિય કરી શકે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "פתחו את Phase Wake לפני השינה כדי שהשעון יוכל להפעיל את המעורר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सोने से पहले Phase Wake खोलें, ताकि आपकी वॉच अलार्म को सक्रिय कर सके।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Otvori Phase Wake prije spavanja kako bi sat mogao aktivirati alarm."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Lefekvés előtt nyisd meg a Phase Wake-et, hogy az órád élesíthesse az ébresztőt."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Քնելուց առաջ բացիր Phase Wake-ը, որպեսզի ժամացույցդ կարողանա ակտիվացնել զարթուցիչը։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Buka Phase Wake sebelum tidur agar jam tanganmu bisa mengaktifkan alarm."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Opnaðu Phase Wake áður en þú ferð að sofa svo úrið geti virkjað vekjarann."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apri Phase Wake prima di dormire, così il tuo orologio può attivare la sveglia."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "眠る前にPhase Wakeを開いてください。ウォッチがアラームを有効にできるようになります。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "დაძინებამდე გახსენი Phase Wake, რომ საათმა მაღვიძარა გაააქტიუროს."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сағатың оятқышты іске қосуы үшін ұйықтар алдында Phase Wake-ті аш."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "បើក Phase Wake មុនពេលចូលដេក ដើម្បីឲ្យនាឡិកាអាចកំណត់ម៉ោងរោទ៍។"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ವಾಚ್ ಅಲಾರಾಂ ಸಕ್ರಿಯಗೊಳಿಸಲು, ಮಲಗುವ ಮೊದಲು Phase Wake ತೆರೆಯಿರಿ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "잠들기 전에 Phase Wake를 열어 주세요. 그래야 워치가 알람을 활성화할 수 있어요."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ເປີດ Phase Wake ກ່ອນເຂົ້ານອນ ເພື່ອໃຫ້ໂມງຕັ້ງໂມງປຸກໄດ້"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Prieš miegą atidaryk Phase Wake, kad laikrodis galėtų parengti žadintuvą."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Pirms gulētiešanas atver Phase Wake, lai pulkstenis varētu aktivizēt modinātāju."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Отвори го Phase Wake пред спиење за часовникот да може да го активира алармот."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "വാച്ചിന് അലാറം സജ്ജമാക്കാൻ, ഉറങ്ങും മുമ്പ് Phase Wake തുറക്കുക."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Цаг чинь сэрүүлгийг идэвхжүүлж чадахын тулд унтахаасаа өмнө Phase Wake-ийг нээ."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "झोपण्यापूर्वी Phase Wake उघडा, म्हणजे तुमचे घड्याळ अलार्म सक्रिय करू शकेल."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Buka Phase Wake sebelum awak tidur supaya jam tangan boleh mengaktifkan penggera."
          }
        },
        "my": {
          "stringUnit": {
            "state": "translated",
            "value": "နာရီက နှိုးစက်ကို အသင့်ပြင်နိုင်ရန် မအိပ်မီ Phase Wake ကို ဖွင့်ပါ။"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Åpne Phase Wake før du legger deg, så klokken kan aktivere alarmen."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "घडीले अलार्म सक्रिय गर्न सकोस् भनेर सुत्नुअघि Phase Wake खोल।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Phase Wake voordat je gaat slapen, zodat je horloge de wekker kan activeren."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਸੌਣ ਤੋਂ ਪਹਿਲਾਂ Phase Wake ਖੋਲ੍ਹੋ ਤਾਂ ਜੋ ਤੁਹਾਡੀ ਘੜੀ ਅਲਾਰਮ ਸਰਗਰਮ ਕਰ ਸਕੇ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Otwórz Phase Wake przed snem, aby zegarek mógł aktywować budzik."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra o Phase Wake antes de dormir para que seu relógio possa ativar o alarme."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre o Phase Wake antes de dormires para que o relógio possa ativar o alarme."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Deschide Phase Wake înainte de culcare, ca ceasul să poată activa alarma."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Открой Phase Wake перед сном, чтобы часы могли активировать будильник."
          }
        },
        "si": {
          "stringUnit": {
            "state": "translated",
            "value": "ඔරලෝසුවට එලාමය සක්‍රිය කිරීමට, නින්දට යාමට පෙර Phase Wake විවෘත කරන්න."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
