        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಎಚ್ಚರಿಸುವ ಅವಧಿಯೊಂದಿಗೆ ಶುರುವಾಗಿ ಗುರಿ ಸಮಯಕ್ಕೆ ಪೂರ್ಣ ಪ್ರಕಾಶಮಾನವಾಗುತ್ತದೆ."
          }
        },
        "ko": {
          "stringUnit": {
