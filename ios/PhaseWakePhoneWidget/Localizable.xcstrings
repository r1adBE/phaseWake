        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ವಾಚ್ ಸಂಪರ್ಕಗೊಂಡಿದೆ, ಅಲಾರಾಂಗಳಿಗೆ ಅನುಮತಿ ಇದೆ. ವಿವರಗಳಿಗೆ ಟ್ಯಾಪ್ ಮಾಡಿ."
