        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Perquè l’alarma surti al davant fins i tot mentre fas servir el telèfon."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Aby se budík zobrazil úplně vepředu, i když telefon právě používáš."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Så alarmen kommer helt frem, også mens du bruger telefonen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Damit der Wecker auch bei benutztem Handy ganz vorne erscheint."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ώστε το ξυπνητήρι να εμφανίζεται μπροστά, ακόμη κι όταν χρησιμοποιείς το κινητό."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "So the alarm comes right to the front even while you're using your phone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para que la alarma aparezca delante incluso mientras usas el teléfono."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Et äratus tuleks täiesti ette ka siis, kui sa telefoni kasutad."
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "Telefonoa erabiltzen ari zarenean ere alarma aurrean ager dadin."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "تا زنگ حتی وقتی از گوشی استفاده می‌کنی، کاملاً جلو بیاید."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jotta herätys tulee aivan eteen myös silloin, kun käytät puhelinta."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Para lumabas sa harap ang alarm kahit ginagamit mo ang telepono."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour que l’alarme passe au premier plan même quand tu utilises ton téléphone."
