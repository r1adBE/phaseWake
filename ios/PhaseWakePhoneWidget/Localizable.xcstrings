        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld ночей Phase Wake измеряет с помощью твоих часов, чтобы подстроить будильник под тебя. Носи их ночью с зарядом не меньше %2$lld %%."
          }
        },
        "si": {
          "stringUnit": {
            "state": "translated",
            "value": "ඔබට ගැළපෙන ලෙස එලාමය සකසන්න Phase Wake ඔබේ ඔරලෝසුවෙන් රාත්‍රී %1$lld ක් මනිනවා. රාත්‍රියේ අවම වශයෙන් %2$lld %% බැටරියක් සමඟ පළඳින්න."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake meria %1$lld nocí s tvojimi hodinkami, aby budík prispôsobil tebe. Nos ich v noci s aspoň %2$lld %% batérie."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake %1$lld noči meri s tvojo uro, da budilko prilagodi tebi. Nosi jo ponoči z vsaj %2$lld %% baterije."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Për %1$lld net, Phase Wake mat me orën tënde për ta përshtatur zgjuesin me ty. Mbaje natën me të paktën %2$lld %% bateri."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake %1$lld ноћи мери твојим сатом како би будилник прилагодио теби. Носи га ноћу са најмање %2$lld %% батерије."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Under %1$lld nätter mäter Phase Wake med din klocka för att anpassa väckningen till dig. Bär den på natten med minst %2$lld %% batteri."
