            "value": "ਉਸ ਰਾਤ ਦੇ ਨੋਟ ਦੇਖਣ ਲਈ ਬਿੰਦੂ ’ਤੇ ਟੈਪ ਕਰੋ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stuknij punkt, aby zobaczyć notatki z tej nocy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque em um ponto para ver as notas daquela noite."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca num ponto para ver as notas dessa noite."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Atinge un punct pentru notițele din acea noapte."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажми на точку, чтобы увидеть заметки этой ночи."
          }
        },
        "si": {
          "stringUnit": {
            "state": "translated",
            "value": "එම රාත්‍රියේ සටහන් බැලීමට තිතක් තට්ටු කරන්න."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ťukni na bod a uvidíš poznámky z tej noci."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tapni piko za opombe te noči."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Prek një pikë për të parë shënimet e asaj nate."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Додирни тачку за белешке те ноћи."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryck på en punkt för att se nattens anteckningar."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Gusa nukta uone madokezo ya usiku huo."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "அந்த இரவின் குறிப்புகளைப் பார்க்க ஒரு புள்ளியைத் தட்டுங்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఆ రాత్రి గమనికలు చూడటానికి చుక్కను నొక్కండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แตะจุดเพื่อดูบันทึกของคืนนั้น"
          }
        },
        "tr": {
