        "my": {
          "stringUnit": {
            "state": "translated",
            "value": "အသံသွင်းခြင်း ဖွင့်ထားသည်။ ညဘက် ဖုန်းကို အားသွင်းကြိုးတပ်ထားခြင်းက အကောင်းဆုံး။"
