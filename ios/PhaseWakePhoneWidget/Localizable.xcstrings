    "export_contents_hint": {
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Die lêer bevat vir elke nag beweging en hartklop per 30 s, hoe jy gevoel het en jou notas – sonder name, datums of toestel-ID’s."
          }
        },
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "ፋይሉ ለእያንዳንዱ ሌሊት በየ30 ሰከንዱ እንቅስቃሴና የልብ ምት፣ ስሜትህንና ማስታወሻዎችህን ይዟል – ያለ ስም፣ ቀን ወይም የመሣሪያ መታወቂያ።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحتوي الملف لكل ليلة على الحركة ونبض القلب لكل ٣٠ ثانية وشعورك وملاحظاتك – دون أسماء أو تواريخ أو معرّفات أجهزة."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Faylda hər gecə üçün hər 30 s-lik hərəkət və nəbz, özünü necə hiss etdiyin və qeydlərin var – adsız, tarixsiz və cihaz ID-siz."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Файлът съдържа за всяка нощ движение и пулс на всеки 30 s, как си се чувствал и бележките ти – без имена, дати и ID на устройства."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ফাইলে প্রতি রাতের প্রতি 30 সেকেন্ডের নড়াচড়া ও হৃদস্পন্দন, তোমার অনুভূতি আর তোমার নোট থাকে – নাম, তারিখ বা ডিভাইস আইডি ছাড়া।"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Datoteka za svaku noć sadrži pokret i puls svakih 30 s, kako si se osjećao i tvoje bilješke – bez imena, datuma i ID-ova uređaja."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "El fitxer conté, per a cada nit, moviment i freqüència cardíaca cada 30 s, com et vas sentir i les teves notes – sense noms, dates ni identificadors de dispositiu."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Soubor obsahuje za každou noc pohyb a tep po 30 s, jak ses cítil a tvoje poznámky – bez jmen, dat a ID zařízení."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Filen indeholder for hver nat bevægelse og puls pr. 30 s, hvordan du havde det, og dine noter – uden navne, datoer eller enheds-id’er."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Datei enthält je Nacht Bewegung und Puls je 30 s, Befinden und deine Notizen – ohne Namen, Datum oder Gerätekennung."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το αρχείο περιέχει για κάθε νύχτα κίνηση και παλμούς ανά 30 s, πώς ένιωθες και τις σημειώσεις σου – χωρίς ονόματα, ημερομηνίες ή αναγνωριστικά συσκευής."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The file contains motion and heart rate per 30 s, how you felt and your notes for each night – without names, dates or device IDs."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El archivo contiene, de cada noche, movimiento y frecuencia cardíaca cada 30 s, cómo te sentiste y tus notas – sin nombres, fechas ni identificadores de dispositivo."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Fail sisaldab iga öö kohta liikumist ja pulssi iga 30 s kohta, sinu enesetunnet ja märkmeid – ilma nimede, kuupäevade ja seadme-ID-deta."
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "Fitxategiak gau bakoitzeko 30 s-ko mugimendua eta bihotz-maiztasuna, nola sentitu zinen eta zure oharrak ditu – izenik, datarik eta gailu-IDrik gabe."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "فایل برای هر شب حرکت و ضربان قلب هر ۳۰ ثانیه، حالت تو و یادداشت‌هایت را دارد – بدون نام، تاریخ یا شناسهٔ دستگاه."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiedosto sisältää joka yöltä liikkeen ja sykkeen 30 s välein, vointisi ja muistiinpanosi – ilman nimiä, päivämääriä tai laitetunnuksia."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Laman ng file para sa bawat gabi ang galaw at heart rate bawat 30 s, ang pakiramdam mo at ang mga tala mo – walang pangalan, petsa o ID ng device."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le fichier contient pour chaque nuit les mouvements et la fréquence cardiaque toutes les 30 s, ton ressenti et tes notes – sans nom, date ni identifiant d’appareil."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Tá gluaiseacht agus ráta croí in aghaidh 30 s, conas a mhothaigh tú agus do nótaí do gach oíche sa chomhad – gan ainmneacha, dátaí ná aitheantais gléis."
          }
        },
        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "O ficheiro contén, de cada noite, movemento e pulso cada 30 s, como te sentiches e as túas notas – sen nomes, datas nin identificadores do dispositivo."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ફાઇલમાં દરેક રાત માટે દર 30 સેકન્ડનું હલનચલન અને હૃદયના ધબકારા, તમને કેવું લાગ્યું અને તમારી નોંધો છે – નામ, તારીખ કે ઉપકરણ ID વિના."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הקובץ מכיל לכל לילה תנועה ודופק לכל 30 שניות, איך הרגשתם וההערות שלכם – ללא שמות, תאריכים או מזהי מכשירים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फ़ाइल में हर रात के लिए हर 30 सेकंड की गतिविधि और हृदय गति, तुम्हें कैसा लगा और तुम्हारे नोट्स हैं – नाम, तारीख या डिवाइस ID के बिना।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Datoteka za svaku noć sadrži pokret i puls svakih 30 s, kako si se osjećao i tvoje bilješke – bez imena, datuma i ID-ova uređaja."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A fájl minden éjszakára tartalmazza a 30 másodpercenkénti mozgást és pulzust, a közérzetedet és a jegyzeteidet – nevek, dátumok és eszközazonosítók nélkül."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ֆայլը յուրաքանչյուր գիշերվա համար պարունակում է շարժումն ու զարկերը յուրաքանչյուր 30 վրկ-ում, ինքնազգացողությունդ և նշումներդ – առանց անունների, ամսաթվերի կամ սարքի ID-ների։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "File berisi gerakan dan detak jantung per 30 detik, perasaanmu, dan catatanmu untuk setiap malam – tanpa nama, tanggal, atau ID perangkat."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Skráin inniheldur fyrir hverja nótt hreyfingu og púls á 30 s fresti, líðan þína og glósurnar þínar – án nafna, dagsetninga eða auðkenna tækja."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il file contiene per ogni notte movimento e battito ogni 30 s, come ti sentivi e le tue note – senza nomi, date o ID dei dispositivi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイルには各夜の 30 秒ごとの体動と心拍、気分、メモが含まれます。名前・日付・デバイス ID は含みません。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ფაილი ყოველი ღამისთვის შეიცავს მოძრაობასა და პულსს ყოველ 30 წმ-ში, შენს თვითგრძნობასა და ჩანაწერებს – სახელების, თარიღების და მოწყობილობის ID-ების გარეშე."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Файлда әр түн үшін әр 30 с сайынғы қозғалыс пен пульс, көңіл күйің және жазбаларың бар – аты, күні немесе құрылғы ID-і жоқ."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ឯកសារមានចលនា និងចង្វាក់បេះដូងរៀងរាល់ 30 វិនាទី អារម្មណ៍របស់អ្នក និងកំណត់ចំណាំរបស់អ្នកសម្រាប់យប់នីមួយៗ – គ្មានឈ្មោះ កាលបរិច្ឆេទ ឬ ID ឧបករណ៍ទេ។"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಫೈಲ್‌ನಲ್ಲಿ ಪ್ರತಿ ರಾತ್ರಿಗೆ ಪ್ರತಿ 30 ಸೆ. ಚಲನೆ ಮತ್ತು ಹೃದಯ ಬಡಿತ, ನಿಮಗೆ ಹೇಗನಿಸಿತು ಮತ್ತು ನಿಮ್ಮ ಟಿಪ್ಪಣಿಗಳಿವೆ – ಹೆಸರು, ದಿನಾಂಕ ಅಥವಾ ಸಾಧನ ID ಇಲ್ಲದೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파일에는 밤마다 30초 단위의 움직임과 심박수, 컨디션, 메모가 들어 있습니다. 이름, 날짜, 기기 ID는 없습니다."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ໄຟລ໌ມີການເຄື່ອນໄຫວ ແລະ ອັດຕາການເຕັ້ນຂອງຫົວໃຈທຸກ 30 ວິນາທີ, ຄວາມຮູ້ສຶກຂອງເຈົ້າ ແລະ ບັນທຶກຂອງເຈົ້າສຳລັບແຕ່ລະຄືນ – ບໍ່ມີຊື່, ວັນທີ ຫຼື ID ອຸປະກອນ."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Faile yra kiekvienos nakties judėjimas ir pulsas kas 30 s, tavo savijauta ir užrašai – be vardų, datų ir įrenginių ID."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Failā ir katras nakts kustības un pulss ik pēc 30 s, tava pašsajūta un piezīmes – bez vārdiem, datumiem un ierīču ID."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Датотеката за секоја ноќ содржи движење и пулс на секои 30 s, како се чувствуваше и твоите белешки – без имиња, датуми и ID на уреди."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഫയലിൽ ഓരോ രാത്രിക്കും ഓരോ 30 സെക്കൻഡിലെയും ചലനവും ഹൃദയമിടിപ്പും, നിങ്ങളുടെ അനുഭവവും കുറിപ്പുകളും ഉണ്ട് – പേര്, തീയതി, ഉപകരണ ID എന്നിവയില്ലാതെ."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Файлд шөнө бүрийн 30 с тутмын хөдөлгөөн ба зүрхний цохилт, сэтгэгдэл, тэмдэглэл чинь бий – нэр, огноо, төхөөрөмжийн ID-гүй."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "फाइलमध्ये प्रत्येक रात्रीची दर 30 सेकंदांची हालचाल आणि हृदयाचे ठोके, तुम्हाला कसे वाटले आणि तुमच्या नोंदी आहेत – नाव, तारीख किंवा डिव्हाइस ID शिवाय."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Fail ini mengandungi pergerakan dan kadar denyutan jantung setiap 30 s, perasaan awak dan nota awak bagi setiap malam – tanpa nama, tarikh atau ID peranti."
          }
        },
        "my": {
          "stringUnit": {
            "state": "translated",
            "value": "ဖိုင်တွင် ညတိုင်းအတွက် စက္ကန့် 30 တိုင်း လှုပ်ရှားမှုနှင့် နှလုံးခုန်နှုန်း၊ သင့်ခံစားချက်နှင့် သင့်မှတ်စုများ ပါဝင်သည် – အမည်၊ ရက်စွဲ သို့မဟုတ် စက် ID မပါပါ။"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Filen inneholder for hver natt bevegelse og puls per 30 s, hvordan du hadde det og notatene dine – uten navn, datoer eller enhets-ID-er."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "फाइलमा हरेक रातको हरेक 30 सेकेन्डको चालचलन र मुटुको धड्कन, तिमीलाई कस्तो लाग्यो र तिम्रा नोटहरू छन् – नाम, मिति वा उपकरण ID बिना।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het bestand bevat per nacht beweging en hartslag per 30 s, hoe je je voelde en je notities – zonder namen, datums of apparaat-ID’s."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਫ਼ਾਈਲ ਵਿੱਚ ਹਰ ਰਾਤ ਲਈ ਹਰ 30 ਸਕਿੰਟ ਦੀ ਹਿਲਜੁਲ ਅਤੇ ਦਿਲ ਦੀ ਧੜਕਣ, ਤੁਹਾਨੂੰ ਕਿਵੇਂ ਲੱਗਾ ਅਤੇ ਤੁਹਾਡੇ ਨੋਟ ਹਨ – ਨਾਂ, ਤਾਰੀਖ਼ ਜਾਂ ਡਿਵਾਈਸ ID ਤੋਂ ਬਿਨਾਂ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Plik zawiera dla każdej nocy ruch i tętno co 30 s, twoje samopoczucie i notatki – bez imion, dat i identyfikatorów urządzeń."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O arquivo contém, de cada noite, movimento e frequência cardíaca a cada 30 s, como você se sentiu e suas notas – sem nomes, datas ou IDs de dispositivo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O ficheiro contém, de cada noite, movimento e frequência cardíaca a cada 30 s, como te sentiste e as tuas notas – sem nomes, datas ou IDs de dispositivo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Fișierul conține pentru fiecare noapte mișcarea și pulsul la fiecare 30 s, cum te-ai simțit și notițele tale – fără nume, date sau ID-uri de dispozitiv."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Файл содержит для каждой ночи движение и пульс каждые 30 с, твоё самочувствие и заметки – без имён, дат и ID устройств."
          }
        },
        "si": {
          "stringUnit": {
            "state": "translated",
            "value": "ගොනුවේ සෑම රාත්‍රියකටම තත්පර 30 කට වරක් චලනය හා හෘද ස්පන්දනය, ඔබට දැනුණු ආකාරය සහ ඔබේ සටහන් ඇත – නම, දිනය හෝ උපාංග ID නොමැතිව."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Súbor obsahuje za každú noc pohyb a pulz každých 30 s, ako si sa cítil, a tvoje poznámky – bez mien, dátumov a ID zariadení."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Datoteka za vsako noč vsebuje gibanje in utrip na 30 s, tvoje počutje in zapiske – brez imen, datumov in ID-jev naprav."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Skedari përmban për çdo natë lëvizjen dhe pulsin çdo 30 s, si u ndjeve dhe shënimet e tua – pa emra, data apo ID pajisjesh."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Датотека за сваку ноћ садржи покрет и пулс на сваких 30 s, како си се осећао и твоје белешке – без имена, датума и ID-јева уређаја."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Filen innehåller för varje natt rörelse och puls per 30 s, hur du mådde och dina anteckningar – utan namn, datum eller enhets-id."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Faili lina, kwa kila usiku, mwendo na mapigo ya moyo kila sekunde 30, ulivyojisikia na madokezo yako – bila majina, tarehe wala vitambulisho vya kifaa."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "கோப்பில் ஒவ்வொரு இரவுக்கும் ஒவ்வொரு 30 வினாடிக்கான அசைவு மற்றும் இதயத் துடிப்பு, நீங்கள் எப்படி உணர்ந்தீர்கள், உங்கள் குறிப்புகள் உள்ளன – பெயர், தேதி அல்லது சாதன ID இல்லாமல்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఫైల్‌లో ప్రతి రాత్రికి ప్రతి 30 సెకన్ల కదలిక మరియు గుండె వేగం, మీకు ఎలా అనిపించింది, మీ నోట్స్ ఉంటాయి – పేరు, తేదీ లేదా పరికర ID లేకుండా."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไฟล์มีการเคลื่อนไหวและอัตราการเต้นของหัวใจทุก 30 วินาที ความรู้สึกของคุณ และบันทึกของคุณสำหรับแต่ละคืน – ไม่มีชื่อ วันที่ หรือ ID อุปกรณ์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dosya her gece için 30 sn’lik hareket ve nabzı, nasıl hissettiğini ve notlarını içerir – adsız, tarihsiz ve cihaz kimliği olmadan."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Файл містить для кожної ночі рух і пульс кожні 30 с, твоє самопочуття й нотатки – без імен, дат та ID пристроїв."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "فائل میں ہر رات کے لیے ہر 30 سیکنڈ کی حرکت اور دل کی دھڑکن، تمہیں کیسا لگا اور تمہارے نوٹس ہیں – نام، تاریخ یا ڈیوائس ID کے بغیر۔"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Faylda har bir tun uchun har 30 soniyalik harakat va yurak urishi, oʻzingni qanday his qilganing va qaydlaring bor – nomlar, sanalar va qurilma IDlarisiz."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tệp chứa chuyển động và nhịp tim mỗi 30 giây, cảm giác của bạn và ghi chú của bạn cho từng đêm – không có tên, ngày hay ID thiết bị."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "檔案包括每晚每 30 秒的動作和心率、你的感覺同你的備註，不含姓名、日期或裝置 ID。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文件包含每晚每 30 秒的体动和心率、你的感受和你的笔记，不含姓名、日期或设备 ID。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "檔案包含每晚每 30 秒的體動和心率、你的感受和你的筆記，不含姓名、日期或裝置 ID。"
          }
        },
        "zu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ifayela liqukethe, ngobusuku ngabunye, ukunyakaza nokushaya kwenhliziyo njalo ngemizuzwana engu-30, indlela obuzizwa ngayo kanye namanothi akho – ngaphandle kwamagama, izinsuku noma ama-ID edivayisi."
          }
        }
      }
    },
