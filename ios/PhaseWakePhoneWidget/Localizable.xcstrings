    "backup_password_hint": {
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Sonder hierdie wagwoord kan niemand die rugsteun oopmaak nie – selfs nie jy nie."
          }
        },
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "ያለዚህ የይለፍ ቃል ማንም ምትኬውን መክፈት አይችልም – እርስዎም ቢሆኑ።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "دون كلمة المرور هذه لا يستطيع أحد فتح النسخة – ولا أنت."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu parol olmadan ehtiyat nüsxəni heç kim aça bilməz – hətta sən də."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Без тази парола никой не може да отвори копието – дори ти."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই পাসওয়ার্ড ছাড়া কেউ ব্যাকআপ খুলতে পারবে না – তুমিও না।"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Bez ove lozinke niko ne može otvoriti sigurnosnu kopiju – čak ni ti."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Sense aquesta contrasenya, ningú no pot obrir la còpia – ni tan sols tu."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Bez tohoto hesla zálohu nikdo neotevře – ani ty."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Uden denne adgangskode kan ingen åbne kopien – heller ikke dig."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ohne dieses Passwort lässt sich die Sicherung nicht öffnen – auch von dir nicht."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Χωρίς αυτόν τον κωδικό κανείς δεν ανοίγει το αντίγραφο – ούτε εσύ."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Without this password, nobody can open the backup – not even you."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin esta contraseña nadie puede abrir la copia, ni siquiera tú."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Ilma selle paroolita ei saa keegi varukoopiat avada – isegi mitte sina."
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "Pasahitz hau gabe, inork ezin du babeskopia ireki – ezta zuk ere."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "بدون این گذرواژه هیچ‌کس نمی‌تواند پشتیبان را باز کند – حتی خودت."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ilman tätä salasanaa kukaan ei voi avata varmuuskopiota – et sinäkään."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Kung wala ang password na ito, walang makakapagbukas ng backup – kahit ikaw."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sans ce mot de passe, personne ne peut ouvrir la sauvegarde – pas même toi."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Gan an pasfhocal seo, ní féidir le duine ar bith an cúltaca a oscailt – fiú tusa."
          }
        },
        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sen este contrasinal ninguén pode abrir a copia – nin sequera ti."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "આ પાસવર્ડ વગર કોઈ બેકઅપ ખોલી શકતું નથી – તમે પણ નહીં."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בלי הסיסמה הזו איש לא יוכל לפתוח את הגיבוי – גם לא אתם."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस पासवर्ड के बिना कोई भी बैकअप नहीं खोल सकता – आप भी नहीं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bez ove lozinke nitko ne može otvoriti sigurnosnu kopiju – čak ni ti."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "E jelszó nélkül senki sem nyithatja meg a mentést – te sem."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Առանց այս գաղտնաբառի ոչ ոք չի կարող բացել պահուստային պատճենը – նույնիսկ դու։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tanpa kata sandi ini, tidak ada yang bisa membuka cadangan – termasuk kamu."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Án þessa lykilorðs getur enginn opnað afritið – ekki einu sinni þú."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Senza questa password nessuno può aprire il backup – nemmeno tu."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このパスワードがないと、誰もバックアップを開けません（あなたも）。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ამ პაროლის გარეშე სარეზერვო ასლს ვერავინ გახსნის – შენც კი."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бұл құпиясөзсіз сақтық көшірмені ешкім аша алмайды – тіпті сен де."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "បើគ្មានពាក្យសម្ងាត់នេះ គ្មាននរណាអាចបើកការបម្រុងទុកបានទេ – សូម្បីតែអ្នក។"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಈ ಪಾಸ್‌ವರ್ಡ್ ಇಲ್ಲದೆ ಯಾರೂ ಬ್ಯಾಕಪ್ ತೆರೆಯಲಾರರು – ನೀವೂ ಸಹ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 비밀번호 없이는 누구도 백업을 열 수 없어요. 나도요."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ຖ້າບໍ່ມີລະຫັດຜ່ານນີ້ ບໍ່ມີໃຜເປີດໄຟລ໌ສຳຮອງໄດ້ – ແມ່ນແຕ່ເຈົ້າ"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Be šio slaptažodžio niekas negalės atidaryti atsarginės kopijos – net ir tu."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Bez šīs paroles neviens nevar atvērt dublējumu – pat tu ne."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Без оваа лозинка никој не може да ја отвори копијата – ни ти."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഈ പാസ്‌വേഡ് ഇല്ലാതെ ആർക്കും ബാക്കപ്പ് തുറക്കാനാകില്ല – നിങ്ങൾക്കു പോലും."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Энэ нууц үггүйгээр нөөцийг хэн ч нээж чадахгүй – чи ч гэсэн."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "या पासवर्डशिवाय कोणीही बॅकअप उघडू शकत नाही – तुम्हीसुद्धा नाही."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tanpa kata laluan ini, tiada sesiapa boleh membuka sandaran – termasuk awak."
          }
        },
        "my": {
          "stringUnit": {
            "state": "translated",
            "value": "ဤစကားဝှက်မရှိလျှင် မည်သူမျှ အရန်ဖိုင်ကို ဖွင့်၍မရပါ – သင်ကိုယ်တိုင်ပင်။"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Uten dette passordet kan ingen åpne kopien – heller ikke du."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "यो पासवर्ड बिना कसैले ब्याकअप खोल्न सक्दैन – तिमी आफैँले पनि।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zonder dit wachtwoord kan niemand de back-up openen – ook jij niet."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਇਸ ਪਾਸਵਰਡ ਤੋਂ ਬਿਨਾਂ ਕੋਈ ਵੀ ਬੈਕਅੱਪ ਨਹੀਂ ਖੋਲ੍ਹ ਸਕਦਾ – ਤੁਸੀਂ ਵੀ ਨਹੀਂ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bez tego hasła nikt nie otworzy kopii – nawet Ty."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem esta senha ninguém consegue abrir o backup – nem você."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem esta palavra-passe ninguém consegue abrir a cópia – nem tu."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Fără această parolă nimeni nu poate deschide copia – nici tu."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Без этого пароля никто не откроет копию – даже ты."
          }
        },
        "si": {
          "stringUnit": {
            "state": "translated",
            "value": "මෙම මුරපදය නොමැතිව කිසිවෙකුට උපස්ථය විවෘත කළ නොහැක – ඔබටවත්."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Bez tohto hesla zálohu nikto neotvorí – ani ty."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brez tega gesla varnostne kopije ne more odpreti nihče – niti ti."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Pa këtë fjalëkalim, askush nuk mund ta hapë kopjen rezervë – as ti vetë."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Без ове лозинке нико не може да отвори резервну копију – чак ни ти."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Utan det här lösenordet kan ingen öppna kopian – inte ens du."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Bila nenosiri hili, hakuna anayeweza kufungua nakala – hata wewe."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்தக் கடவுச்சொல் இல்லாமல் யாராலும் காப்புப்பிரதியைத் திறக்க முடியாது – உங்களாலும் கூட."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఈ పాస్‌వర్డ్ లేకుండా బ్యాకప్‌ను ఎవరూ తెరవలేరు – మీరు కూడా."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ถ้าไม่มีรหัสผ่านนี้ ไม่มีใครเปิดข้อมูลสำรองได้ แม้แต่คุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu şifre olmadan yedeği kimse açamaz – sen de."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Без цього пароля ніхто не відкриє копію – навіть ти."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس پاس ورڈ کے بغیر کوئی بیک اپ نہیں کھول سکتا – تم بھی نہیں۔"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu parolsiz zaxira nusxani hech kim ocha olmaydi – hatto sen ham."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không có mật khẩu này, không ai mở được bản sao lưu – kể cả bạn."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有這個密碼，任何人都無法開啟備份 – 包括你自己。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有这个密码，谁都无法打开备份，包括你自己。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有這個密碼，誰都無法開啟備份，包括你自己。"
          }
        },
        "zu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ngaphandle kwale phasiwedi, akekho ongavula ikhophi yasenqolobaneni – ngisho nawe."
          }
        }
      }
    },
