          "stringUnit": {
            "state": "translated",
            "value": "எழுவதற்கு முன் உங்கள் திரையைச் சூரிய உதயம் போல ஒளிரச் செய்யும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీరు మేల్కొనే ముందు మీ స్క్రీన్‌ను సూర్యోదయంలా వెలిగిస్తుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทำให้หน้าจอสว่างเหมือนพระอาทิตย์ขึ้นก่อนที่คุณจะตื่น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sen uyanmadan önce ekranı gün doğumu gibi aydınlatır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Підсвічує екран, як світанок, перш ніж ти прокинешся."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "جاگنے سے پہلے تمہاری اسکرین کو طلوعِ آفتاب کی طرح روشن کرتا ہے۔"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygʻonishingdan oldin ekraningni quyosh chiqishidek yoritadi."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Làm sáng màn hình như bình minh trước khi bạn thức dậy."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "在你醒來前，讓螢幕像日出一樣亮起。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在你醒来前，让屏幕像日出一样亮起。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在你醒來前，讓螢幕像日出一樣亮起。"
          }
        },
        "zu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ikhanyisa isikrini sakho njengokuphuma kwelanga ngaphambi kokuthi uvuke."
          }
        }
      }
    },
