        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ក្នុង %1$lld នៃ %2$lld យប់ចុងក្រោយ គ្មានពេលល្អក្នុងចន្លោះពេលទេ។ ជាមួយ %3$lld នាទី អ្នកនឹងភ្ញាក់នៅពេលល្អញឹកញាប់ជាង។"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಕಳೆದ %2$lld ರಾತ್ರಿಗಳಲ್ಲಿ %1$lld ರಲ್ಲಿ ಅವಧಿಯೊಳಗೆ ಒಳ್ಳೆಯ ಕ್ಷಣ ಇರಲಿಲ್ಲ. %3$lld ನಿಮಿ. ಇದ್ದರೆ ಹೆಚ್ಚಾಗಿ ಒಳ್ಳೆಯ ಕ್ಷಣದಲ್ಲಿ ಏಳುತ್ತೀರಿ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "최근 %2$lld일 중 %1$lld일은 구간 안에 좋은 타이밍이 없었어요. %3$lld분으로 하면 좋은 타이밍에 깰 가능성이 높아져요."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ໃນ %1$lld ຈາກ %2$lld ຄືນຜ່ານມາ ບໍ່ມີເວລາທີ່ດີໃນຊ່ວງເວລາ ດ້ວຍ %3$lld ນາທີ ເຈົ້າຈະຕື່ນໃນເວລາທີ່ດີເລື້ອຍຂຶ້ນ"
