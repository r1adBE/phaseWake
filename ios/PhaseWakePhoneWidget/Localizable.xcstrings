            "value": "ගොනුව කියවීමට නොහැකි විය. කිසිවක් වෙනස් නොකළා."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Súbor sa nepodarilo prečítať. Nič sa nezmenilo."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Datoteke ni bilo mogoče prebrati. Nič ni bilo spremenjeno."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Skedari nuk u lexua dot. Asgjë nuk u ndryshua."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Датотеку није могуће прочитати. Ништа није промењено."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Filen kunde inte läsas. Inget ändrades."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Imeshindwa kusoma faili. Hakuna kilichobadilishwa."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "கோப்பைப் படிக்க முடியவில்லை. எதுவும் மாற்றப்படவில்லை."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఫైల్‌ను చదవలేకపోయాం. ఏమీ మారలేదు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อ่านไฟล์ไม่ได้ ไม่มีการเปลี่ยนแปลงใดๆ"
