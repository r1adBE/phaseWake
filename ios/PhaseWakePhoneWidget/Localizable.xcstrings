        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đặt giờ và khoảng thời gian. Đồng hồ sẽ đánh thức bạn trong khoảng đó ngay khi bạn bắt đầu trằn trọc."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "設定時間和喚醒時段。一旦你睡得不安穩，手錶就會在時段內叫醒你。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
