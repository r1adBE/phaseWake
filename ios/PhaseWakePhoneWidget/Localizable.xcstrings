            "value": "新建闹钟"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "新增鬧鐘"
          }
        },
        "zu": {
          "stringUnit": {
            "state": "translated",
            "value": "I-alamu entsha"
          }
        }
      }
    },
    "editor_phone_backup_hint": {
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Lui saam met jou horlosie, en alleen as die horlosie nie reageer nie."
          }
        },
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "ከሰዓትዎ ጋር ይደውላል፣ ሰዓቱ ምላሽ ካልሰጠም ብቻውን ይደውላል።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يرنّ مع الساعة، ويرنّ وحده إن لم تستجب الساعة."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Saatınla birlikdə çalır, saat cavab verməsə, təkbaşına çalır."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Звъни с часовника – и сам, ако часовникът не отговори."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ঘড়ির সঙ্গে বাজে, আর ঘড়ি সাড়া না দিলে নিজেই বাজে।"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zvoni zajedno sa satom, a samostalno ako se sat ne javi."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Sona amb el rellotge, i tot sol si el rellotge no respon."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zvoní s hodinkami – a sám, pokud hodinky nereagují."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ringer sammen med uret, og af sig selv, hvis uret ikke reagerer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Klingelt mit der Uhr – und allein, falls sich die Uhr nicht meldet."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Χτυπά μαζί με το ρολόι και μόνο του, αν το ρολόι δεν απαντήσει."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rings with your watch, and on its own if the watch doesn’t respond."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Suena con tu reloj, y por sí solo si el reloj no responde."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Heliseb koos kellaga ja ka üksi, kui kell ei vasta."
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "Erlojuarekin batera jotzen du, eta bakarrik erlojuak erantzuten ez badu."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "همراه ساعت زنگ می‌خورد، و اگر ساعت جواب نداد، خودش."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Soi kellon kanssa ja itsenäisesti, jos kello ei vastaa."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Tumutunog kasabay ng relo mo, at mag-isa kung hindi sumasagot ang relo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sonne avec ta montre, et seul si elle ne répond pas."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Buaileann sé leis an uaireadóir, agus leis féin mura bhfreagraíonn an t-uaireadóir."
          }
        },
        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "Soa co reloxo e tamén por si só se o reloxo non responde."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ઘડિયાળની સાથે વાગે છે, અને ઘડિયાળ જવાબ ન આપે તો જાતે પણ."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מצלצל יחד עם השעון, ולבד אם השעון לא מגיב."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "घड़ी के साथ बजता है, और घड़ी जवाब न दे तो अकेले भी।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zvoni zajedno sa satom, a samostalno ako se sat ne javi."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az órával együtt csörög, és magától is, ha az óra nem jelez."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Զանգում է ժամացույցի հետ, իսկ եթե ժամացույցը չի արձագանքում՝ ինքնուրույն։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Berdering bersama jam tangan, dan sendiri jika jam tangan tidak merespons."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Hringir með úrinu, og sjálfur ef úrið svarar ekki."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Suona con lo smartwatch, e da sola se lo smartwatch non risponde."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ウォッチと一緒に鳴り、ウォッチが反応しないときはスマートフォンだけで鳴ります。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "რეკავს საათთან ერთად, ხოლო თუ საათი არ პასუხობს – დამოუკიდებლად."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сағатпен бірге шырылдайды, ал сағат жауап бермесе, өзі шырылдайды."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "រោទ៍ជាមួយនាឡិកា ហើយរោទ៍ដោយខ្លួនឯង បើនាឡិកាមិនឆ្លើយតប។"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ವಾಚ್ ಜೊತೆಗೆ ರಿಂಗ್ ಆಗುತ್ತದೆ, ವಾಚ್ ಸ್ಪಂದಿಸದಿದ್ದರೆ ತಾನೇ ರಿಂಗ್ ಆಗುತ್ತದೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "워치와 함께 울리고, 워치가 반응하지 않으면 휴대폰만 울려요."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ດັງພ້ອມໂມງ ແລະ ດັງເອງຖ້າໂມງບໍ່ຕອບສະໜອງ"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Skamba kartu su laikrodžiu, o jei laikrodis neatsako – ir vienas."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Zvana kopā ar pulksteni un arī viens pats, ja pulkstenis neatbild."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ѕвони со часовникот, а и самостојно ако часовникот не одговори."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "വാച്ചിനൊപ്പം റിങ് ചെയ്യും, വാച്ച് പ്രതികരിച്ചില്ലെങ്കിൽ തനിയെയും."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Цагтай чинь хамт дуугарна, цаг хариу өгөхгүй бол дангаараа дуугарна."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "घड्याळासोबत वाजतो, आणि घड्याळाने प्रतिसाद न दिल्यास स्वतःही."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Berbunyi bersama jam tangan, dan sendiri jika jam tangan tidak bertindak balas."
          }
        },
        "my": {
          "stringUnit": {
            "state": "translated",
            "value": "နာရီနှင့်အတူ မြည်ပြီး နာရီက မတုံ့ပြန်ပါက သူ့ဘာသာ မြည်သည်။"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ringer sammen med klokka, og av seg selv hvis klokka ikke svarer."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "तिम्रो घडीसँगै बज्छ, र घडीले जवाफ नदिए आफैँ बज्छ।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gaat af met je horloge, en alleen als het horloge niet reageert."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਘੜੀ ਦੇ ਨਾਲ ਵੱਜਦਾ ਹੈ, ਅਤੇ ਘੜੀ ਜਵਾਬ ਨਾ ਦੇਵੇ ਤਾਂ ਆਪਣੇ ਆਪ ਵੀ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dzwoni razem z zegarkiem, a sam – gdy zegarek nie odpowie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca com o relógio, e sozinho se o relógio não responder."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca com o relógio, e sozinho se o relógio não responder."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Sună împreună cu ceasul și singur, dacă ceasul nu răspunde."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Звонит вместе с часами, а если часы не ответят — сам."
          }
        },
        "si": {
          "stringUnit": {
            "state": "translated",
            "value": "ඔබේ ඔරලෝසුව සමඟ නාද වේ, ඔරලෝසුව ප්‍රතිචාර නොදක්වන්නේ නම් තනියම නාද වේ."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zvoní s hodinkami – a sám, ak hodinky nereagujú."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zvoni skupaj z uro – in sam, če se ura ne odzove."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Bie bashkë me orën, dhe vetë nëse ora nuk përgjigjet."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Звони заједно са сатом, а самостално ако се сат не јави."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ringer med klockan, och på egen hand om klockan inte svarar."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Inalia pamoja na saa yako, na yenyewe ikiwa saa haijibu."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "வாட்ச்சுடன் ஒலிக்கும்; வாட்ச் பதிலளிக்காவிட்டால் தானாகவும் ஒலிக்கும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "వాచ్‌తో పాటు మోగుతుంది, వాచ్ స్పందించకపోతే సొంతంగా కూడా."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ดังพร้อมกับนาฬิกา และดังเองหากนาฬิกาไม่ตอบสนอง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saatle birlikte çalar, saat yanıt vermezse tek başına da çalar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дзвонить разом із годинником, а якщо годинник не відповість — сам."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "گھڑی کے ساتھ بجتا ہے، اور اگر گھڑی جواب نہ دے تو خود بھی۔"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Soating bilan birga jiringlaydi, soat javob bermasa – oʻzi jiringlaydi."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đổ chuông cùng đồng hồ, và tự đổ chuông nếu đồng hồ không phản hồi."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "與手錶一起響鬧；手錶沒有回應時，手機會自行響鬧。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "与手表一起响铃；手表没有响应时，手机会单独响铃。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "與手錶一起響鈴；手錶沒有回應時，手機會單獨響鈴。"
          }
        },
        "zu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ikhala newashi lakho, futhi iyodwa uma iwashi lingaphenduli."
          }
        }
      }
    },
