    "diag_hint": {
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Net op hierdie toestel, niks word gestuur nie. Bevat tye van wekkers en gebeure, geen gesondheidsdata nie."
          }
        },
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "በዚህ መሣሪያ ላይ ብቻ፣ ምንም አይላክም። የማንቂያዎችና የክስተቶች ሰዓቶችን ይዟል፣ የጤና ውሂብ የለውም።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "على هذا الجهاز فقط، لا يُرسل شيء. يحتوي على أوقات المنبّهات والأحداث، دون بيانات صحية."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnız bu cihazda, heç nə göndərilmir. Siqnalların və hadisələrin vaxtlarını saxlayır, sağlamlıq məlumatı yoxdur."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Само на това устройство, нищо не се изпраща. Съдържа часове на будилници и събития, без здравни данни."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "শুধু এই ডিভাইসে, কিছুই পাঠানো হয় না। অ্যালার্ম ও ঘটনার সময় থাকে, স্বাস্থ্য ডেটা নয়।"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Samo na ovom uređaju, ništa se ne šalje. Sadrži vremena alarma i događaja, bez zdravstvenih podataka."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Només en aquest dispositiu, no s’envia res. Conté hores d’alarmes i esdeveniments, cap dada de salut."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jen v tomto zařízení, nic se neodesílá. Obsahuje časy budíků a událostí, žádná zdravotní data."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun på denne enhed, intet sendes. Indeholder tidspunkter for alarmer og hændelser, ingen sundhedsdata."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur auf diesem Gerät, nichts wird gesendet. Enthält Zeiten von Weckern und Ereignissen, keine Gesundheitsdaten."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μόνο σε αυτή τη συσκευή, δεν αποστέλλεται τίποτα. Περιέχει ώρες αφυπνίσεων και συμβάντων, όχι δεδομένα υγείας."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only on this device, nothing is sent. Contains times of alarms and events, no health data."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo en este dispositivo, no se envía nada. Contiene horas de alarmas y eventos, sin datos de salud."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainult selles seadmes, midagi ei saadeta. Sisaldab äratuste ja sündmuste aegu, terviseandmeid mitte."
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "Gailu honetan soilik, ez da ezer bidaltzen. Alarmen eta gertaeren orduak ditu, osasun-daturik ez."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "فقط روی همین دستگاه، چیزی فرستاده نمی‌شود. شامل زمان زنگ‌ها و رویدادهاست، بدون دادهٔ سلامت."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vain tällä laitteella, mitään ei lähetetä. Sisältää herätysten ja tapahtumien ajat, ei terveystietoja."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Sa device na ito lang, walang ipinapadala. May mga oras ng alarm at event, walang health data."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uniquement sur cet appareil, rien n’est envoyé. Contient les heures des réveils et des événements, pas de données de santé."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Ar an ngléas seo amháin, ní sheoltar aon rud. Tá amanna aláram agus imeachtaí ann, gan sonraí sláinte."
          }
        },
        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "Só neste dispositivo, non se envía nada. Contén horas de alarmas e eventos, sen datos de saúde."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ફક્ત આ ડિવાઇસ પર, કંઈ મોકલાતું નથી. એલાર્મ અને ઘટનાઓના સમય છે, હેલ્થ ડેટા નથી."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "רק במכשיר הזה, דבר לא נשלח. מכיל זמני השכמות ואירועים, בלי נתוני בריאות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सिर्फ़ इस डिवाइस पर, कुछ भी भेजा नहीं जाता। अलार्म और घटनाओं के समय होते हैं, स्वास्थ्य डेटा नहीं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Samo na ovom uređaju, ništa se ne šalje. Sadrži vremena alarma i događaja, bez zdravstvenih podataka."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Csak ezen az eszközön, semmit sem küld el. Ébresztők és események időpontjait tartalmazza, egészségügyi adatot nem."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Միայն այս սարքում, ոչինչ չի ուղարկվում։ Պարունակում է զարթուցիչների և իրադարձությունների ժամերը, առողջության տվյալներ չկան։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya di perangkat ini, tidak ada yang dikirim. Berisi waktu alarm dan peristiwa, tanpa data kesehatan."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Aðeins á þessu tæki, ekkert er sent. Inniheldur tíma vekjara og atburða, engin heilsugögn."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo su questo dispositivo, non viene inviato nulla. Contiene orari di sveglie ed eventi, nessun dato sanitario."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイスのみ。何も送信されません。アラームとイベントの時刻を含み、健康データは含みません。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "მხოლოდ ამ მოწყობილობაზე, არაფერი იგზავნება. შეიცავს მაღვიძარებისა და მოვლენების დროს, ჯანმრთელობის მონაცემებს არა."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тек осы құрылғыда, ешнәрсе жіберілмейді. Оятқыштар мен оқиғалардың уақыттары бар, денсаулық деректері жоқ."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "តែលើឧបករណ៍នេះ គ្មានអ្វីត្រូវបានផ្ញើទេ។ មានម៉ោងនៃម៉ោងរោទ៍ និងព្រឹត្តិការណ៍ គ្មានទិន្នន័យសុខភាព។"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಈ ಸಾಧನದಲ್ಲಿ ಮಾತ್ರ, ಏನನ್ನೂ ಕಳುಹಿಸುವುದಿಲ್ಲ. ಅಲಾರಾಂ ಮತ್ತು ಘಟನೆಗಳ ಸಮಯಗಳಿವೆ, ಆರೋಗ್ಯ ಡೇಟಾ ಇಲ್ಲ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기에만 있고 아무것도 보내지 않아요. 알람과 이벤트 시간이 들어 있고 건강 데이터는 없어요."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ສະເພາະໃນອຸປະກອນນີ້ ບໍ່ມີຫຍັງຖືກສົ່ງ ມີເວລາຂອງໂມງປຸກ ແລະ ເຫດການ ບໍ່ມີຂໍ້ມູນສຸຂະພາບ"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik šiame įrenginyje, niekas nesiunčiama. Yra žadintuvų ir įvykių laikai, jokių sveikatos duomenų."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tikai šajā ierīcē, nekas netiek nosūtīts. Satur modinātāju un notikumu laikus, bez veselības datiem."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Само на овој уред, ништо не се испраќа. Содржи времиња на аларми и настани, без здравствени податоци."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഈ ഉപകരണത്തിൽ മാത്രം, ഒന്നും അയയ്ക്കില്ല. അലാറങ്ങളുടെയും ഇവന്റുകളുടെയും സമയങ്ങൾ മാത്രം, ആരോഗ്യ ഡാറ്റയില്ല."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Зөвхөн энэ төхөөрөмж дээр, юу ч илгээхгүй. Сэрүүлэг, үйл явдлын цагийг агуулна, эрүүл мэндийн өгөгдөлгүй."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "फक्त या डिव्हाइसवर, काहीही पाठवले जात नाही. अलार्म आणि घटनांच्या वेळा आहेत, हेल्थ डेटा नाही."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya pada peranti ini, tiada apa-apa dihantar. Mengandungi masa penggera dan peristiwa, tanpa data kesihatan."
          }
        },
        "my": {
          "stringUnit": {
            "state": "translated",
            "value": "ဤစက်ပေါ်တွင်သာ၊ ဘာမှ မပို့ပါ။ နှိုးစက်နှင့် ဖြစ်ရပ်များ၏ အချိန်များ ပါသည်၊ ကျန်းမာရေးဒေတာ မပါ။"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bare på denne enheten, ingenting sendes. Inneholder tidspunkter for alarmer og hendelser, ingen helsedata."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "यो डिभाइसमा मात्र, केही पठाइँदैन। अलार्म र घटनाका समय हुन्छन्, स्वास्थ्य डेटा हुँदैन।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alleen op dit apparaat, er wordt niets verzonden. Bevat tijden van wekkers en gebeurtenissen, geen gezondheidsgegevens."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਸਿਰਫ਼ ਇਸ ਡੀਵਾਈਸ ’ਤੇ, ਕੁਝ ਵੀ ਨਹੀਂ ਭੇਜਿਆ ਜਾਂਦਾ। ਇਸ ਵਿੱਚ ਅਲਾਰਮਾਂ ਅਤੇ ਘਟਨਾਵਾਂ ਦੇ ਸਮੇਂ ਹਨ, ਸਿਹਤ ਡਾਟਾ ਨਹੀਂ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tylko na tym urządzeniu, nic nie jest wysyłane. Zawiera godziny budzików i zdarzeń, bez danych zdrowotnych."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Só neste dispositivo, nada é enviado. Contém horários de alarmes e eventos, sem dados de saúde."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Só neste dispositivo, nada é enviado. Contém horas de alarmes e eventos, sem dados de saúde."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Doar pe acest dispozitiv, nu se trimite nimic. Conține orele alarmelor și ale evenimentelor, fără date de sănătate."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Только на этом устройстве, ничего не отправляется. Содержит время будильников и событий, без данных о здоровье."
          }
        },
        "si": {
          "stringUnit": {
            "state": "translated",
            "value": "මෙම උපාංගයේ පමණි, කිසිවක් යවන්නේ නැත. එලාම සහ සිදුවීම්වල වේලාවන් ඇත, සෞඛ්‍ය දත්ත නැත."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Len v tomto zariadení, nič sa neodosiela. Obsahuje časy budíkov a udalostí, žiadne zdravotné údaje."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Samo na tej napravi, nič se ne pošlje. Vsebuje čase budilk in dogodkov, brez zdravstvenih podatkov."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Vetëm në këtë pajisje, asgjë nuk dërgohet. Përmban kohët e alarmeve dhe të ngjarjeve, pa të dhëna shëndeti."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Само на овом уређају, ништа се не шаље. Садржи времена аларма и догађаја, без здравствених података."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Bara på den här enheten, inget skickas. Innehåller tider för alarm och händelser, inga hälsodata."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Kwenye kifaa hiki tu, hakuna kinachotumwa. Una nyakati za kengele na matukio, si data ya afya."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்தச் சாதனத்தில் மட்டும், எதுவும் அனுப்பப்படாது. அலாரங்கள், நிகழ்வுகளின் நேரங்கள் உள்ளன, ஆரோக்கியத் தரவு இல்லை."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఈ పరికరంలో మాత్రమే, ఏమీ పంపబడదు. అలారాలు, ఈవెంట్‌ల సమయాలు ఉంటాయి, హెల్త్ డేటా ఉండదు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อยู่บนอุปกรณ์นี้เท่านั้น ไม่ส่งอะไรออกไป มีเวลาการปลุกและเหตุการณ์ ไม่มีข้อมูลสุขภาพ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca bu cihazda, hiçbir şey gönderilmez. Alarm ve olay saatlerini içerir, sağlık verisi içermez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Лише на цьому пристрої, нічого не надсилається. Містить час будильників і подій, без даних про здоров’я."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "صرف اس ڈیوائس پر، کچھ بھیجا نہیں جاتا۔ اس میں الارم اور واقعات کے اوقات ہوتے ہیں، صحت کا ڈیٹا نہیں۔"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Faqat shu qurilmada, hech narsa yuborilmaydi. Budilnik va hodisalar vaqtlarini oʻz ichiga oladi, sogʻliq maʼlumotlarisiz."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ trên thiết bị này, không gửi gì đi. Chứa thời gian báo thức và sự kiện, không có dữ liệu sức khỏe."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "只在這部裝置上，不會傳送任何內容。包含鬧鐘和事件的時間，不含健康數據。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅在此设备上，不会发送任何内容。包含闹钟和事件的时间，不含健康数据。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅在此裝置上，不會傳送任何內容。包含鬧鐘和事件的時間，不含健康資料。"
          }
        },
        "zu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kule divayisi kuphela, akukho okuthunyelwayo. Kuqukethe izikhathi zama-alamu nezehlakalo, ayikho idatha yezempilo."
          }
        }
      }
    },
