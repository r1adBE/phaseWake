    "check_companion_problem": {
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Terwyl jy jou foon gebruik, verskyn die wekker anders net as 'n kennisgewing bo."
          }
        },
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "ስልክዎን እየተጠቀሙ ሳሉ፣ ያለዚህ ማንቂያው ከላይ እንደ ማሳወቂያ ብቻ ይታያል።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أثناء استخدامك للهاتف، يظهر المنبه بدون ذلك كإشعار في الأعلى فقط."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Telefondan istifadə edərkən siqnal əks halda yalnız yuxarıda bildiriş kimi görünür."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Иначе, докато използваш телефона, будилникът се показва само като известие горе."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "নইলে ফোন ব্যবহার করার সময় অ্যালার্ম শুধু উপরে একটি বিজ্ঞপ্তি হিসেবে দেখা যায়।"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Dok koristiš telefon, alarm se inače prikazuje samo kao obavještenje na vrhu."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Si no, mentre fas servir el telèfon, l’alarma només apareix com a notificació a dalt."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Když telefon používáš, budík se jinak zobrazí jen jako oznámení nahoře."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Mens du bruger telefonen, vises alarmen ellers kun som en notifikation øverst."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Benutzt du gerade das Handy, erscheint der Wecker sonst nur als Mitteilung oben."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αλλιώς, όσο χρησιμοποιείς το κινητό, το ξυπνητήρι εμφανίζεται μόνο ως ειδοποίηση επάνω."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "While you're using your phone, the alarm otherwise only shows as a notification at the top."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si no, mientras usas el teléfono, la alarma solo aparece como notificación arriba."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Muidu kuvatakse äratus telefoni kasutamise ajal ainult teavitusena üleval."
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "Bestela, telefonoa erabiltzen ari zarenean, alarma goiko jakinarazpen gisa bakarrik agertzen da."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "در غیر این صورت، وقتی از گوشی استفاده می‌کنی، زنگ فقط به‌صورت اعلان در بالا نمایش داده می‌شود."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Muuten herätys näkyy puhelinta käyttäessäsi vain ilmoituksena ylhäällä."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Habang ginagamit mo ang telepono, lalabas lang ang alarm bilang notification sa itaas kung wala ito."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sinon, quand tu utilises ton téléphone, l’alarme ne s’affiche qu’en notification en haut."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Murach seo, agus tú ag úsáid an fhóin, ní thaispeántar an t-aláram ach mar fhógra ag an mbarr."
          }
        },
        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "Se non, mentres usas o teléfono, a alarma só aparece como notificación arriba."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "નહીં તો ફોન વાપરતા હો ત્યારે એલાર્મ ફક્ત ઉપર સૂચના તરીકે દેખાય છે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אחרת, בזמן שימוש בטלפון השעון המעורר מופיע רק כהתראה למעלה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वरना फ़ोन इस्तेमाल करते समय अलार्म सिर्फ़ ऊपर एक सूचना के रूप में दिखता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dok koristiš telefon, alarm se inače prikazuje samo kao obavijest na vrhu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Különben a telefon használata közben az ébresztés csak értesítésként jelenik meg felül."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Այլապես, երբ հեռախոսն օգտագործում ես, զարթուցիչը երևում է միայն որպես ծանուցում վերևում։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jika tidak, saat kamu memakai ponsel, alarm hanya muncul sebagai notifikasi di atas."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Annars birtist vekjarinn aðeins sem tilkynning efst meðan þú notar símann."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Altrimenti, mentre usi il telefono, la sveglia compare solo come notifica in alto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "接続しないと、スマートフォンの使用中はアラームが上部の通知としてのみ表示されます。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "სხვა შემთხვევაში, ტელეფონის გამოყენებისას მაღვიძარა მხოლოდ შეტყობინებად ჩანს ზემოთ."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Әйтпесе телефонды қолданып отырғанда оятқыш тек жоғарыда хабарландыру ретінде көрінеді."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "បើមិនដូច្នោះទេ ពេលអ្នកកំពុងប្រើទូរសព្ទ ម៉ោងរោទ៍បង្ហាញតែជាការជូនដំណឹងនៅខាងលើប៉ុណ្ណោះ។"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಇಲ್ಲದಿದ್ದರೆ ಫೋನ್ ಬಳಸುತ್ತಿರುವಾಗ ಅಲಾರಾಂ ಮೇಲೆ ಅಧಿಸೂಚನೆಯಾಗಿ ಮಾತ್ರ ಕಾಣಿಸುತ್ತದೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "연결하지 않으면 휴대폰을 사용하는 동안 알람이 위쪽 알림으로만 표시돼요."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ຖ້າບໍ່ດັ່ງນັ້ນ ຂະນະທີ່ເຈົ້າໃຊ້ໂທລະສັບ ໂມງປຸກຈະສະແດງເປັນການແຈ້ງເຕືອນຢູ່ທາງເທິງເທົ່ານັ້ນ"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Kitaip, kai naudojiesi telefonu, žadintuvas rodomas tik kaip pranešimas viršuje."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Citādi, kamēr izmanto tālruni, modinātājs parādās tikai kā paziņojums augšā."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Инаку, додека го користиш телефонот, алармот се појавува само како известување горе."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "അല്ലെങ്കിൽ ഫോൺ ഉപയോഗിക്കുമ്പോൾ അലാറം മുകളിൽ ഒരു അറിയിപ്പായി മാത്രമേ കാണൂ."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Эс бөгөөс утсаа ашиглаж байхад сэрүүлэг зөвхөн дээд талд мэдэгдэл болж харагдана."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "नाहीतर फोन वापरत असताना अलार्म फक्त वर सूचना म्हणून दिसतो."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Jika tidak, semasa awak menggunakan telefon, penggera hanya dipaparkan sebagai pemberitahuan di atas."
          }
        },
        "my": {
          "stringUnit": {
            "state": "translated",
            "value": "မဟုတ်ပါက ဖုန်းသုံးနေစဉ် နှိုးစက်သည် အပေါ်ရှိ အကြောင်းကြားချက်အဖြစ်သာ ပေါ်ပါသည်။"
