        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Në %1$lld nga %2$lld netët e fundit nuk pati moment të mirë në interval. Me %3$lld min do të zgjohesh më shpesh në një moment të mirë."
          }
