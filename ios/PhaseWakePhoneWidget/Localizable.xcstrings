        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "வாட்ச் இணைக்கப்பட்டது, அலாரங்கள் அனுமதிக்கப்பட்டன. விவரங்களுக்குத் தட்டுங்கள்."
