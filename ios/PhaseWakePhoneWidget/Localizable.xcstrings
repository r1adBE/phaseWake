          "stringUnit": {
            "state": "translated",
            "value": "“Usinisumbue” imewashwa"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "“தொந்தரவு செய்ய வேண்டாம்” ஆனில் உள்ளது"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "“అంతరాయం కలిగించవద్దు” ఆన్‌లో ఉంది"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โหมดห้ามรบกวนเปิดอยู่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rahatsız Etme açık"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Режим «Не турбувати» увімкнено"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "“ڈسٹرب نہ کریں” آن ہے"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "«Bezovta qilinmasin» yoqilgan"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chế độ Không làm phiền đang bật"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "「請勿打擾」已開啟"
          }
        },
        "zh-Hans": {
