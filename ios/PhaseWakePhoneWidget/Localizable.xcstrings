        },
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "ሰዓቱን አብርተህ ከስልክህ ጋር ተገናኝቶ ተወው – ከማንቂያው በኋላ ቀረጻውን ይልካል።"
