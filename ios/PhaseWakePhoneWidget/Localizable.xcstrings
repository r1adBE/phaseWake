        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Podaci ostaju na tvojim uređajima. Fazu učenja možeš bilo kada isključiti u postavkama."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az adatok a készülékeiden maradnak. A tanulási szakaszt bármikor kikapcsolhatod a beállításokban."
