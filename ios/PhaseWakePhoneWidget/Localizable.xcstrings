            "value": "Kurekodi kumewashwa. Ni bora uchomeke simu yako kwenye chaja usiku."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "பதிவு ஆனில் உள்ளது. இரவுக்கு ஃபோனைச் சார்ஜரில் இணைப்பது நல்லது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "రికార్డింగ్ ఆన్‌లో ఉంది. రాత్రికి ఫోన్‌ను ఛార్జర్‌కు పెట్టడం మంచిది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กำลังบันทึก ควรเสียบชาร์จโทรศัพท์ไว้ตลอดคืน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kayıt sürüyor. Telefonu gece şarja takman en iyisi."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Запис триває. Краще постав телефон на ніч заряджатися."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ریکارڈنگ آن ہے۔ بہتر ہے رات کے لیے فون چارجر پر لگا دو۔"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Yozish yoqilgan. Telefonni tunga quvvatga ulab qoʻy."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đang ghi âm. Tốt nhất là cắm sạc điện thoại qua đêm."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "錄音已開啟。晚上最好將手機接上充電器。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在录音。夜里最好给手机接上充电器。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
