        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pada %1$lld dari %2$lld malam terakhir, tidak ada saat yang tepat di dalam jendela. Dengan %3$lld mnt, kamu lebih sering bangun di saat yang tepat."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Í %1$lld af síðustu %2$lld nóttum var ekkert gott augnablik í glugganum. Með %3$lld mín vaknarðu oftar á góðu augnabliki."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In %1$lld delle ultime %2$lld notti non c’era un momento giusto nella finestra. Con %3$lld min ti sveglierai più spesso al momento giusto."
