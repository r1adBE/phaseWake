        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਰਿਕਾਰਡਿੰਗ ਚਾਲੂ ਹੈ। ਰਾਤ ਲਈ ਫ਼ੋਨ ਨੂੰ ਚਾਰਜਰ ’ਤੇ ਲਾਉਣਾ ਬਿਹਤਰ ਹੈ।"
