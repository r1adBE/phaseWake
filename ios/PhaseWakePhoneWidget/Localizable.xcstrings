        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "Reloxo conectado, alarmas permitidas. Toca para ver detalles."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ઘડિયાળ કનેક્ટ, એલાર્મને મંજૂરી. વિગતો માટે ટૅપ કરો."
