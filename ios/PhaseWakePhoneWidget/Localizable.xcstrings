        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "משך השינה והסדירות שלה מגיעים מ-Health Connect."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नींद की अवधि और नियमितता Health Connect से आती है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trajanje i redovitost sna dolaze iz Health Connecta."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az alvás időtartama és rendszeressége a Health Connectből származik."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Քնի տևողությունը և կանոնավորությունը վերցվում են Health Connect-ից։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Durasi dan keteraturan tidur berasal dari Health Connect."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Svefnlengd og regla koma frá Health Connect."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Durata e regolarità del sonno provengono da Health Connect."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "睡眠時間と規則性は Health Connect から取得されます。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ძილის ხანგრძლივობა და რეგულარულობა Health Connect-დან მოდის."
