          "stringUnit": {
            "state": "translated",
            "value": "Yuxu müddəti və müntəzəmlik Health Connect-dən gəlir."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Продължителността и редовността на съня идват от Health Connect."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
