        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਰਿਕਾਰਡ ਕਰਨ ਲਈ Phase Wake ਨੂੰ ਮਾਈਕ੍ਰੋਫ਼ੋਨ ਚਾਹੀਦਾ ਹੈ। ਇਹ ਸਿਰਫ਼ ਰਿਕਾਰਡਿੰਗ ਚਾਲੂ ਹੋਣ ’ਤੇ ਹੀ ਸੁਣਦਾ ਹੈ।"
          }
        },
        "pl": {
