        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只保存短片段。片段留在手机上，7 天后删除。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只保存短片段。片段留在手機上，7 天後刪除。"
          }
        },
        "zu": {
          "stringUnit": {
            "state": "translated",
            "value": "Iziqeshana ezimfushane kuphela. Zihlala efonini yakho futhi zisuswa ngemva kwezinsuku ezi-7."
