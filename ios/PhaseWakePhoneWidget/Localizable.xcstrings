        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "अलार्म शान्त हुनुअघि ३ वटा जोड हल गर। स्नुज प्रश्न बिनै हुन्छ।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Los 3 sommen op voordat de wekker stil wordt. Sluimeren kan zonder som."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਅਲਾਰਮ ਚੁੱਪ ਹੋਣ ਤੋਂ ਪਹਿਲਾਂ 3 ਜੋੜ ਹੱਲ ਕਰੋ। ਸਨੂਜ਼ ਬਿਨਾਂ ਸਵਾਲ ਦੇ ਹੁੰਦਾ ਹੈ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rozwiąż 3 działania, zanim budzik ucichnie. Drzemka działa bez zadania."
