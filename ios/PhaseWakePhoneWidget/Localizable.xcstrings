            "value": "Atinge un punct pentru notițele din acea noapte."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажми на точку, чтобы увидеть заметки этой ночи."
          }
        },
        "si": {
          "stringUnit": {
            "state": "translated",
            "value": "එම රාත්‍රියේ සටහන් බැලීමට තිතක් තට්ටු කරන්න."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ťukni na bod a uvidíš poznámky z tej noci."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tapni piko za opombe te noči."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Prek një pikë për të parë shënimet e asaj nate."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Додирни тачку за белешке те ноћи."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryck på en punkt för att se nattens anteckningar."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Gusa nukta uone madokezo ya usiku huo."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "அந்த இரவின் குறிப்புகளைப் பார்க்க ஒரு புள்ளியைத் தட்டுங்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఆ రాత్రి గమనికలు చూడటానికి చుక్కను నొక్కండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แตะจุดเพื่อดูบันทึกของคืนนั้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "O gecenin notları için bir noktaya dokun."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Торкнися точки, щоб побачити нотатки цієї ночі."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس رات کے نوٹس دیکھنے کے لیے کسی نقطے پر ٹیپ کرو۔"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Oʻsha tunning qaydlarini koʻrish uchun nuqtani bos."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chạm vào một điểm để xem ghi chú của đêm đó."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
