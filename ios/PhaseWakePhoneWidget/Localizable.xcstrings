    "history_health_live": {
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Uit %1$@. Phase Wake neem veranderinge en skrappings daar outomaties oor."
          }
        },
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "ከ%1$@። እዚያ የሚደረጉ ለውጦችንና ስረዛዎችን Phase Wake በራስ-ሰር ይከተላል።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "من %1$@. يطبّق Phase Wake التغييرات وعمليات الحذف هناك تلقائيًا."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Mənbə: %1$@. Orada edilən dəyişiklikləri və silinmələri Phase Wake avtomatik tətbiq edir."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "От %1$@. Phase Wake прилага автоматично промените и изтриванията там."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ থেকে। সেখানে করা বদল ও মুছে ফেলা Phase Wake নিজে থেকেই মেনে নেয়।"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Iz aplikacije %1$@. Phase Wake automatski preuzima izmjene i brisanja napravljena tamo."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "De %1$@. Phase Wake aplica automàticament els canvis i les eliminacions que s’hi facin."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Z aplikace %1$@. Změny a smazání provedená tam Phase Wake převezme automaticky."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Fra %1$@. Phase Wake overtager automatisk ændringer og sletninger dér."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aus %1$@. Änderungen und Löschungen dort übernimmt Phase Wake automatisch."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Από %1$@. Το Phase Wake εφαρμόζει αυτόματα τις αλλαγές και τις διαγραφές που γίνονται εκεί."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "From %1$@. Phase Wake applies changes and deletions made there automatically."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "De %1$@. Phase Wake aplica automáticamente los cambios y eliminaciones que hagas allí."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Allikas: %1$@. Phase Wake võtab sealsed muudatused ja kustutamised automaatselt üle."
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "Iturria: %1$@. Han egindako aldaketak eta ezabaketak automatikoki aplikatzen ditu Phase Wake-k."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "از %1$@. Phase Wake تغییرات و حذف‌های آنجا را خودکار اعمال می‌کند."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lähde: %1$@. Phase Wake ottaa siellä tehdyt muutokset ja poistot automaattisesti huomioon."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
