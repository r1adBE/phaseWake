    "restore_confirm_text": {
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Wekkers, geskiedenis, notas en instellings op hierdie foon sal deur die rugsteun vervang word."
          }
        },
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "በዚህ ስልክ ላይ ያሉ ማንቂያዎች፣ ታሪክ፣ ማስታወሻዎች እና ቅንብሮች በምትኬው ይተካሉ።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ستُستبدل المنبّهات والسجل والملاحظات والإعدادات على هذا الهاتف بالنسخة."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu telefondakı siqnallar, tarixçə, qeydlər və ayarlar ehtiyat nüsxə ilə əvəz ediləcək."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Будилниците, историята, бележките и настройките на този телефон ще бъдат заменени с копието."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই ফোনের অ্যালার্ম, ইতিহাস, নোট আর সেটিংস ব্যাকআপ দিয়ে প্রতিস্থাপিত হবে।"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Alarmi, historija, bilješke i postavke na ovom telefonu bit će zamijenjeni sigurnosnom kopijom."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "La còpia substituirà les alarmes, l’historial, les notes i la configuració d’aquest telèfon."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Budíky, historie, poznámky a nastavení v tomto telefonu budou nahrazeny zálohou."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Alarmer, historik, noter og indstillinger på denne telefon erstattes af kopien."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wecker, Verlauf, Notizen und Einstellungen auf diesem Handy werden durch die Sicherung ersetzt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι αφυπνίσεις, το ιστορικό, οι σημειώσεις και οι ρυθμίσεις αυτού του κινητού θα αντικατασταθούν από το αντίγραφο."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Alarms, history, notes and settings on this phone will be replaced by the backup."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las alarmas, el historial, las notas y los ajustes de este teléfono se reemplazarán por la copia."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Selle telefoni äratused, ajalugu, märkmed ja seaded asendatakse varukoopiaga."
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "Telefono honetako alarmak, historia, oharrak eta ezarpenak babeskopiakoekin ordeztuko dira."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "زنگ‌ها، سابقه، یادداشت‌ها و تنظیمات این گوشی با پشتیبان جایگزین می‌شوند."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämän puhelimen herätykset, historia, muistiinpanot ja asetukset korvataan varmuuskopiolla."
          }
