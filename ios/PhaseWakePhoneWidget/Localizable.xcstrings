    "check_dnd_unknown_problem": {
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Android sê nie vir apps of wekkers deurkom nie. Gaan na dat wekkers in Moenie Steur Nie toegelaat word."
          }
        },
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "Android ማንቂያዎች ማለፍ አለማለፋቸውን ለመተግበሪያዎች አይነግርም። በአትረብሽ ውስጥ ማንቂያዎች መፈቀዳቸውን ያረጋግጡ።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يخبر Android التطبيقات ما إذا كانت المنبهات تمر. تأكد من السماح بالمنبهات في وضع عدم الإزعاج."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Android tətbiqlərə siqnalların keçib-keçmədiyini demir. “Narahat etməyin” rejimində siqnallara icazə verildiyini yoxla."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Android не казва на приложенията дали будилниците минават. Провери дали будилниците са разрешени при „Не безпокойте“."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অ্যালার্ম বাজবে কি না, Android তা অ্যাপকে জানায় না। দেখে নাও “বিরক্ত করবে না”-তে অ্যালার্মের অনুমতি আছে কি না।"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Android ne otkriva aplikacijama prolaze li alarmi. Provjeri jesu li alarmi dozvoljeni u načinu „Ne uznemiravaj“."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Android no diu a les apps si les alarmes passen. Comprova que les alarmes estiguin permeses amb «No molestis»."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Android aplikacím neříká, zda budíky projdou. Zkontroluj, že jsou budíky v režimu Nerušit povolené."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Android fortæller ikke apps, om alarmer kommer igennem. Tjek, at alarmer er tilladt i Forstyr ikke."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Android verrät Apps nicht, ob Wecker durchkommen. Prüfe, ob Wecker bei «Nicht stören» erlaubt sind."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Android δεν ενημερώνει τις εφαρμογές αν περνούν τα ξυπνητήρια. Έλεγξε ότι τα ξυπνητήρια επιτρέπονται στο «Μην ενοχλείτε»."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Android doesn’t tell apps whether alarms get through. Check that alarms are allowed in Do Not Disturb."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Android no informa a las apps de si las alarmas se dejan pasar. Comprueba que las alarmas estén permitidas en No molestar."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Android ei ütle rakendustele, kas äratused pääsevad läbi. Kontrolli, et äratused oleksid režiimis „Mitte segada“ lubatud."
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "Android-ek ez die aplikazioei esaten alarmak pasatzen diren. Egiaztatu alarmak baimenduta daudela «Ez molestatu» moduan."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "Android به برنامه‌ها نمی‌گوید که زنگ‌ها عبور می‌کنند یا نه. بررسی کن که زنگ‌ها در حالت «مزاحم نشو» مجاز باشند."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Android ei kerro sovelluksille, päästetäänkö herätykset läpi. Tarkista, että herätykset on sallittu Älä häiritse -tilassa."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi sinasabi ng Android sa mga app kung nakakalusot ang mga alarm. Tingnan kung pinapayagan ang mga alarm sa Huwag Istorbohin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Android n’indique pas aux apps si les alarmes passent. Vérifie que les alarmes sont autorisées dans Ne pas déranger."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Ní insíonn Android d’aipeanna an dtagann aláraim tríd. Seiceáil go bhfuil aláraim ceadaithe in “Ná Cuir Isteach Orm”."
          }
        },
        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "Android non lles di ás apps se as alarmas pasan. Comproba que as alarmas estean permitidas en «Non molestar»."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "Android ઍપને જણાવતું નથી કે એલાર્મ વાગવા દેવાય છે કે નહીં. “ખલેલ પાડશો નહીં”માં એલાર્મને મંજૂરી છે કે નહીં તે તપાસો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "Android לא מדווח לאפליקציות אם שעונים מעוררים עוברים. ודאו ששעונים מעוררים מותרים ב״נא לא להפריע״."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Android ऐप्स को नहीं बताता कि अलार्म आगे जाते हैं या नहीं। जाँच लें कि डू नॉट डिस्टर्ब में अलार्म की अनुमति है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Android ne otkriva aplikacijama prolaze li alarmi. Provjeri jesu li alarmi dopušteni u načinu „Ne uznemiravaj“."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az Android nem jelzi az alkalmazásoknak, hogy az ébresztők átjutnak-e. Ellenőrizd, hogy az ébresztők engedélyezve vannak-e a Ne zavarjanak módban."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Android-ը հավելվածներին չի ասում՝ զարթուցիչներն անցնում են, թե ոչ։ Ստուգիր, որ «Չանհանգստացնել»-ում զարթուցիչները թույլատրված են։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Android tidak memberi tahu aplikasi apakah alarm diloloskan. Pastikan alarm diizinkan di Jangan Ganggu."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Android segir forritum ekki hvort vekjarar komist í gegn. Athugaðu hvort vekjarar séu leyfðir í „Ónáðið ekki“."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Android non comunica alle app se le sveglie passano. Controlla che le sveglie siano consentite in Non disturbare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Androidでは、アラームが鳴るかどうかをアプリから確認できません。サイレントモードでアラームが許可されているか確認してください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "Android აპებს არ ეუბნება, გადის თუ არა მაღვიძარები. შეამოწმე, რომ „არ შემაწუხოთ“ რეჟიმში მაღვიძარები დაშვებულია."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Android қолданбаларға оятқыштардың өтетінін айтпайды. «Мазаламау» режимінде оятқыштарға рұқсат барын тексер."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "Android មិនប្រាប់កម្មវិធីថាម៉ោងរោទ៍អាចឆ្លងកាត់បានឬទេ។ ពិនិត្យថាម៉ោងរោទ៍ត្រូវបានអនុញ្ញាតក្នុង «កុំរំខាន»។"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಅಲಾರಾಂಗಳು ಬರುತ್ತವೆಯೇ ಎಂದು Android ಆ್ಯಪ್‌ಗಳಿಗೆ ತಿಳಿಸುವುದಿಲ್ಲ. ಅಡಚಣೆ ಮಾಡಬೇಡಿ ಯಲ್ಲಿ ಅಲಾರಾಂಗಳಿಗೆ ಅನುಮತಿ ಇದೆಯೇ ಪರಿಶೀಲಿಸಿ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Android는 알람이 울릴 수 있는지 앱에 알려 주지 않아요. 방해 금지 모드에서 알람이 허용되어 있는지 확인해 주세요."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "Android ບໍ່ບອກແອັບວ່າໂມງປຸກຜ່ານໄດ້ຫຼືບໍ່ ກວດເບິ່ງວ່າອະນຸຍາດໂມງປຸກໃນ “ຫ້າມລົບກວນ” ແລ້ວ"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Android nepraneša programėlėms, ar žadintuvai praleidžiami. Patikrink, ar režime „Netrukdyti“ žadintuvai leidžiami."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Android nepasaka lietotnēm, vai modinātāji tiek cauri. Pārbaudi, vai režīmā „Netraucēt“ modinātāji ir atļauti."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Android не им кажува на апликациите дали алармите минуваат. Провери дали алармите се дозволени при „Не вознемирувај“."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "അലാറങ്ങൾ കടന്നുവരുമോ എന്ന് Android ആപ്പുകളോട് പറയില്ല. ശല്യപ്പെടുത്തരുത് മോഡിൽ അലാറങ്ങൾ അനുവദിച്ചിട്ടുണ്ടോ എന്ന് പരിശോധിക്കുക."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Android сэрүүлэг нэвтрэх эсэхийг аппуудад хэлдэггүй. «Бүү саад бол»-д сэрүүлэг зөвшөөрөгдсөн эсэхийг шалга."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "अलार्म वाजू दिले जातात की नाही हे Android ॲप्सना सांगत नाही. “व्यत्यय आणू नका” मध्ये अलार्मना परवानगी आहे का ते तपासा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Android tidak memberitahu apl sama ada penggera dibenarkan. Semak sama ada penggera dibenarkan dalam Jangan Ganggu."
          }
        },
        "my": {
          "stringUnit": {
            "state": "translated",
            "value": "နှိုးစက်များ ဖြတ်သန်းနိုင်မနိုင် Android က အက်ပ်များကို မပြောပါ။ မနှောင့်ယှက်ရ တွင် နှိုးစက်များ ခွင့်ပြုထားကြောင်း စစ်ဆေးပါ။"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Android forteller ikke apper om alarmer slipper gjennom. Sjekk at alarmer er tillatt i Ikke forstyrr."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "अलार्म बज्छ कि बज्दैन, Android ले एपहरूलाई बताउँदैन। “बाधा नपुर्‍याउनुहोस्” मा अलार्मलाई अनुमति छ कि जाँच।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Android laat apps niet weten of wekkers doorkomen. Controleer of wekkers zijn toegestaan bij Niet storen."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "Android ਐਪਾਂ ਨੂੰ ਨਹੀਂ ਦੱਸਦਾ ਕਿ ਅਲਾਰਮ ਵੱਜਣ ਦਿੱਤੇ ਜਾਂਦੇ ਹਨ ਜਾਂ ਨਹੀਂ। ਜਾਂਚੋ ਕਿ “ਪਰੇਸ਼ਾਨ ਨਾ ਕਰੋ” ਵਿੱਚ ਅਲਾਰਮਾਂ ਦੀ ਇਜਾਜ਼ਤ ਹੈ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Android nie informuje aplikacji, czy budziki są przepuszczane. Sprawdź, czy budziki są dozwolone w trybie Nie przeszkadzać."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Android não informa aos apps se os alarmes são permitidos. Verifique se os alarmes estão permitidos no Não perturbe."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O Android não informa as apps se os alarmes são permitidos. Verifica se os alarmes estão permitidos em Não incomodar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Android nu spune aplicațiilor dacă alarmele sunt lăsate să treacă. Verifică dacă alarmele sunt permise în modul Nu deranja."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Android не сообщает приложениям, пропускаются ли будильники. Проверь, что будильники разрешены в режиме «Не беспокоить»."
          }
        },
        "si": {
          "stringUnit": {
            "state": "translated",
            "value": "එලාම පැමිණේද කියා Android යෙදුම්වලට නොකියයි. “බාධා නොකරන්න” තුළ එලාමවලට ඉඩ ඇත්දැයි පරීක්ෂා කරන්න."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Android aplikáciám neprezradí, či budíky prejdú. Skontroluj, či sú budíky v režime Nerušiť povolené."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Android aplikacijam ne pove, ali budilke pridejo skozi. Preveri, ali so budilke v načinu »Ne moti« dovoljene."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Android nuk u tregon aplikacioneve nëse alarmet kalojnë. Kontrollo që alarmet të jenë të lejuara te „Mos shqetëso“."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Android не открива апликацијама да ли аларми пролазе. Провери да ли су аларми дозвољени у режиму „Не узнемиравај“."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Android talar inte om för appar om alarm släpps igenom. Kontrollera att alarm är tillåtna i Stör ej."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Android haziambii programu kama kengele zitapita. Hakikisha kengele zimeruhusiwa katika “Usinisumbue”."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "அலாரங்கள் ஒலிக்குமா என்று Android ஆப்ஸுக்குச் சொல்லாது. “தொந்தரவு செய்ய வேண்டாம்” இல் அலாரங்கள் அனுமதிக்கப்பட்டுள்ளனவா எனச் சரிபாருங்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "అలారాలు మోగుతాయో లేదో Android యాప్‌లకు చెప్పదు. “అంతరాయం కలిగించవద్దు”లో అలారాలకు అనుమతి ఉందో లేదో చూడండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Android ไม่แจ้งแอปว่านาฬิกาปลุกดังได้หรือไม่ โปรดตรวจสอบว่าอนุญาตนาฬิกาปลุกในโหมดห้ามรบกวนแล้ว"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Android, alarmların çalıp çalmayacağını uygulamalara bildirmez. Rahatsız Etme'de alarmlara izin verildiğini kontrol et."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Android не повідомляє застосункам, чи пропускаються будильники. Перевір, чи дозволено будильники в режимі «Не турбувати»."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Android ایپس کو نہیں بتاتا کہ الارم بجیں گے یا نہیں۔ دیکھ لو کہ “ڈسٹرب نہ کریں” میں الارم کی اجازت ہے۔"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Android budilniklar oʻtadimi-yoʻqmi, ilovalarga aytmaydi. «Bezovta qilinmasin»da budilniklarga ruxsat borligini tekshir."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Android không cho ứng dụng biết báo thức có được phép kêu hay không. Hãy kiểm tra xem báo thức đã được cho phép trong chế độ Không làm phiền chưa."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "Android 不會告訴 App 鬧鐘能否響起。請檢查「請勿打擾」是否允許鬧鐘。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Android 不会告诉应用闹钟能否响起。请检查勿扰模式下是否允许闹钟。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Android 不會告訴 App 鬧鐘能否響起。請檢查勿擾模式下是否允許鬧鐘。"
          }
        },
        "zu": {
          "stringUnit": {
            "state": "translated",
            "value": "I-Android ayitsheli ama-app ukuthi ama-alamu ayadlula yini. Hlola ukuthi ama-alamu avunyelwe ku-Ungaphazamisi."
          }
        }
      }
    },
