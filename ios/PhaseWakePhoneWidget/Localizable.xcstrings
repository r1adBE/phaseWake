    "check_alarmkit_problem": {
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Laat Phase Wake toe om wekkers te stel sodat jou iPhone as rugsteunwekker kan lui."
          }
        },
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhoneዎ እንደ ተጠባባቂ ማንቂያ መደወል እንዲችል Phase Wake ማንቂያዎችን እንዲያዘጋጅ ይፍቀዱ።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اسمح لـ Phase Wake بضبط المنبهات ليتمكن الـ iPhone من الرنين كمنبه احتياطي."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone-un ehtiyat siqnal kimi çala bilsin deyə Phase Wake-ə siqnal qurmağa icazə ver."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Разреши на Phase Wake да задава будилници, за да може iPhone да звъни като резервен будилник."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake-কে অ্যালার্ম সেট করার অনুমতি দাও, যাতে তোমার iPhone ব্যাকআপ অ্যালার্ম হিসেবে বাজতে পারে।"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Dozvoli aplikaciji Phase Wake postavljanje alarma kako bi iPhone mogao zvoniti kao rezervni alarm."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Permet que Phase Wake configuri alarmes perquè l’iPhone pugui sonar com a alarma de reserva."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Povol Phase Wake nastavovat budíky, aby tvůj iPhone mohl zazvonit jako záložní budík."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tillad Phase Wake at indstille alarmer, så din iPhone kan ringe som backup-alarm."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erlaube Phase Wake Wecker, damit dein iPhone als Zweitwecker klingeln kann."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επίτρεψε στο Phase Wake να ορίζει ξυπνητήρια, ώστε το iPhone σου να χτυπά ως εφεδρικό ξυπνητήρι."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow Phase Wake to set alarms so your iPhone can ring as a backup alarm."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite que Phase Wake programe alarmas para que tu iPhone pueda sonar como alarma de respaldo."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Luba Phase Wake’il äratusi määrata, et su iPhone saaks varuäratusena heliseda."
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "Baimendu Phase Wake-ri alarmak ezartzen, iPhone-ak ordezko alarma gisa jo dezan."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "به Phase Wake اجازه بده زنگ تنظیم کند تا iPhone بتواند به‌عنوان زنگ پشتیبان زنگ بزند."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Salli Phase Waken asettaa herätyksiä, jotta iPhonesi voi soida varaherätyksenä."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Payagan ang Phase Wake na magtakda ng mga alarm para makatunog ang iPhone mo bilang backup na alarm."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorise Phase Wake à programmer des alarmes pour que ton iPhone puisse sonner comme alarme de secours."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Ceadaigh do Phase Wake aláraim a shocrú ionas gur féidir le d’iPhone bualadh mar aláram cúltaca."
          }
        },
        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite que Phase Wake configure alarmas para que o iPhone poida soar como alarma de reserva."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તમારો iPhone બેકઅપ એલાર્મ તરીકે વાગી શકે તે માટે Phase Wakeને એલાર્મ સેટ કરવાની મંજૂરી આપો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אשרו ל-Phase Wake להגדיר שעונים מעוררים, כדי שה-iPhone שלכם יוכל לצלצל כשעון גיבוי."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake को अलार्म सेट करने की अनुमति दें ताकि आपका iPhone बैकअप अलार्म के रूप में बज सके।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dopusti aplikaciji Phase Wake postavljanje alarma kako bi iPhone mogao zvoniti kao rezervni alarm."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Engedélyezd a Phase Wake-nek az ébresztők beállítását, hogy az iPhone-od tartalék ébresztőként megszólalhasson."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Թույլատրիր Phase Wake-ին զարթուցիչներ դնել, որպեսզի iPhone-դ կարողանա զանգել որպես պահուստային զարթուցիչ։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Izinkan Phase Wake mengatur alarm agar iPhone-mu bisa berbunyi sebagai alarm cadangan."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Leyfðu Phase Wake að stilla vekjara svo iPhone geti hringt sem varavekjari."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Consenti a Phase Wake di impostare sveglie, così il tuo iPhone può suonare come sveglia di riserva."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhoneがバックアップのアラームを鳴らせるよう、Phase Wakeにアラームの設定を許可してください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "დაუშვი, რომ Phase Wake-მა მაღვიძარები დააყენოს, რათა iPhone-მა სარეზერვო მაღვიძარად დარეკოს."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone қосалқы оятқыш ретінде шырылдай алуы үшін Phase Wake-ке оятқыш орнатуға рұқсат бер."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "អនុញ្ញាតឲ្យ Phase Wake កំណត់ម៉ោងរោទ៍ ដើម្បីឲ្យ iPhone អាចរោទ៍ជាម៉ោងរោទ៍បម្រុង។"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone ಬ್ಯಾಕಪ್ ಅಲಾರಾಂ ಆಗಿ ರಿಂಗ್ ಆಗಲು, Phase Wake ಗೆ ಅಲಾರಾಂ ಹೊಂದಿಸಲು ಅನುಮತಿಸಿ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone이 예비 알람으로 울릴 수 있도록 Phase Wake에 알람 설정을 허용해 주세요."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ອະນຸຍາດໃຫ້ Phase Wake ຕັ້ງໂມງປຸກ ເພື່ອໃຫ້ iPhone ດັງເປັນໂມງປຸກສຳຮອງໄດ້"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Leisk Phase Wake nustatyti žadintuvus, kad iPhone galėtų skambėti kaip atsarginis žadintuvas."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Atļauj Phase Wake iestatīt modinātājus, lai iPhone varētu zvanīt kā rezerves modinātājs."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дозволи му на Phase Wake да поставува аларми за iPhone да може да ѕвони како резервен аларм."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone ബാക്കപ്പ് അലാറമായി റിങ് ചെയ്യാൻ, അലാറങ്ങൾ സജ്ജമാക്കാൻ Phase Wake-നെ അനുവദിക്കുക."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone чинь нөөц сэрүүлэг болж дуугарахын тулд Phase Wake-д сэрүүлэг тохируулахыг зөвшөөр."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुमचा iPhone बॅकअप अलार्म म्हणून वाजू शकेल म्हणून Phase Wake ला अलार्म सेट करण्याची परवानगी द्या."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Benarkan Phase Wake menetapkan penggera supaya iPhone awak boleh berdering sebagai penggera sandaran."
          }
        },
        "my": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone အရန်နှိုးစက်အဖြစ် မြည်နိုင်ရန် Phase Wake ကို နှိုးစက်သတ်မှတ်ခွင့် ပေးပါ။"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Tillat Phase Wake å stille alarmer slik at iPhone kan ringe som reservealarm."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "तिम्रो iPhone ब्याकअप अलार्मको रूपमा बज्न सकोस् भनेर Phase Wake लाई अलार्म सेट गर्न अनुमति देऊ।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sta Phase Wake toe wekkers in te stellen zodat je iPhone als back-upwekker kan overgaan."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake ਨੂੰ ਅਲਾਰਮ ਸੈੱਟ ਕਰਨ ਦੀ ਇਜਾਜ਼ਤ ਦਿਓ ਤਾਂ ਜੋ ਤੁਹਾਡਾ iPhone ਬੈਕਅੱਪ ਅਲਾਰਮ ਵਜੋਂ ਵੱਜ ਸਕੇ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zezwól Phase Wake na ustawianie budzików, aby iPhone mógł zadzwonić jako zapasowy budzik."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Permita que o Phase Wake defina alarmes para que seu iPhone possa tocar como alarme reserva."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite que o Phase Wake defina alarmes para que o teu iPhone possa tocar como alarme de reserva."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite Phase Wake să seteze alarme pentru ca iPhone-ul tău să poată suna ca alarmă de rezervă."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разреши Phase Wake ставить будильники, чтобы iPhone мог зазвонить как резервный будильник."
          }
        },
        "si": {
          "stringUnit": {
            "state": "translated",
            "value": "ඔබේ iPhone හට උපස්ථ එලාමයක් ලෙස නාද වීමට, Phase Wake හට එලාම සැකසීමට ඉඩ දෙන්න."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Povoľ Phase Wake nastavovať budíky, aby mohol iPhone zvoniť ako záložný budík."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dovoli aplikaciji Phase Wake nastavljanje budilk, da lahko iPhone zvoni kot rezervna budilka."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Lejo Phase Wake të caktojë alarme, që iPhone-i yt të bjerë si alarm rezervë."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Дозволи апликацији Phase Wake да подешава аларме да би iPhone могао да звони као резервни аларм."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tillåt Phase Wake att ställa alarm så att din iPhone kan ringa som reservalarm."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Ruhusu Phase Wake iweke kengele ili iPhone yako iweze kulia kama kengele ya akiba."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் iPhone மாற்று அலாரமாக ஒலிக்க, அலாரங்களை அமைக்க Phase Wake ஐ அனுமதியுங்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ iPhone బ్యాకప్ అలారంగా మోగగలిగేలా Phase Wakeకి అలారాలు సెట్ చేసే అనుమతి ఇవ్వండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อนุญาตให้ Phase Wake ตั้งการปลุก เพื่อให้ iPhone ของคุณส่งเสียงเป็นนาฬิกาปลุกสำรองได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone’un yedek alarm olarak çalabilmesi için Phase Wake’in alarm kurmasına izin ver."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дозволь Phase Wake ставити будильники, щоб iPhone міг задзвонити як резервний будильник."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake کو الارم لگانے کی اجازت دو تاکہ تمہارا iPhone بیک اپ الارم کے طور پر بج سکے۔"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone zaxira budilnik sifatida jiringlay olishi uchun Phase Wakeʼga budilnik qoʻyishga ruxsat ber."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy cho phép Phase Wake đặt báo thức để iPhone của bạn có thể reo làm báo thức dự phòng."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "請允許 Phase Wake 設定鬧鐘，讓你的 iPhone 可以作為備用鬧鐘響鬧。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请允许 Phase Wake 设置闹钟，这样你的 iPhone 可以作为备用闹钟响铃。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請允許 Phase Wake 設定鬧鐘，這樣你的 iPhone 可以作為備用鬧鐘響鈴。"
          }
        },
        "zu": {
          "stringUnit": {
            "state": "translated",
            "value": "Vumela i-Phase Wake ukuthi isethe ama-alamu ukuze i-iPhone yakho ikwazi ukukhala njenge-alamu yokwesekwa."
          }
        }
      }
    },
