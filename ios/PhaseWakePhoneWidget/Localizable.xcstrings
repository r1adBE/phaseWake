        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Միացրու «Ինքնաշխատ հայտնաբերել քնելը»-ը – այդ դեպքում ժամացույցն ինքը կհայտնաբերի, թե երբ ես քնում, և գիշերները կհաշվվեն։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktifkan “Deteksi saat tertidur secara otomatis” – jam tanganmu akan mendeteksi sendiri kapan kamu tertidur, dan malamnya dihitung."
