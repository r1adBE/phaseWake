    "onb_alarm_text": {
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Wanneer wil jy uiterlik wakker wees? Die horlosie maak jou in die venster daarvoor wakker sodra jy onrustig word."
          }
        },
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "ቢዘገይ መቼ መንቃት ይፈልጋሉ? እረፍት ማጣት ሲጀምሩ ሰዓትዎ ከዚያ በፊት ባለው ክልል ውስጥ ይቀሰቅስዎታል።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "متى تريد أن تستيقظ على أبعد تقدير؟ توقظك الساعة ضمن النافذة التي تسبقه بمجرد أن تبدأ بالتململ."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Ən gec nə vaxt oyaq olmaq istəyirsən? Narahat olmağa başlayan kimi saatın səni ondan əvvəlki pəncərədə oyadır."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Кога най-късно искаш да станеш? Часовникът ще те събуди в прозореца преди това, щом сънят ти стане неспокоен."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সবচেয়ে দেরিতে কখন জেগে উঠতে চাও? তুমি অস্থির হতে শুরু করলেই ঘড়ি তার আগের সময়সীমায় তোমাকে জাগাবে।"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Kada se najkasnije želiš probuditi? Sat te budi u intervalu prije toga, čim ti san postane nemiran."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "A quina hora vols despertar-te com a molt tard? El rellotge et desperta en la finestra d’abans tan bon punt el son es torna inquiet."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Kdy chceš být nejpozději vzhůru? Hodinky tě vzbudí v okně před tím, jakmile začne být tvůj spánek neklidný."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvornår vil du senest være vågen? Uret vækker dig i vinduet før, så snart du bliver urolig."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wann willst du spätestens wach sein? Die Uhr weckt dich im Fenster davor, sobald du unruhig wirst."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μέχρι πότε θέλεις το αργότερο να έχεις ξυπνήσει; Το ρολόι σε ξυπνά στο παράθυρο πριν από αυτό, μόλις ο ύπνος σου γίνει ανήσυχος."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When do you want to be awake at the latest? Your watch wakes you in the window before, once you get restless."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿A qué hora quieres estar despierto como muy tarde? El reloj te despierta en la ventana previa en cuanto te inquietas."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Millal tahad hiljemalt ärkvel olla? Kell äratab sind sellele eelnevas aknas kohe, kui su uni muutub rahutuks."
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "Noiz nahi duzu esna egon beranduenez? Erlojuak aurreko leihoan esnatuko zaitu, ezinegona hasten zaizun unean."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "حداکثر تا کی می‌خواهی بیدار شوی؟ ساعت در بازهٔ پیش از آن، به‌محض اینکه بی‌قرار شوی، بیدارت می‌کند."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Milloin haluat olla viimeistään hereillä? Kello herättää sinut sitä edeltävässä ikkunassa heti, kun unesi muuttuu levottomaksi."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Anong oras mo gustong gising ka na sa pinakahuli? Gigisingin ka ng relo sa window bago iyon, sa sandaling hindi ka na mapakali."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À quelle heure veux-tu être réveillé au plus tard ? La montre te réveille dans la fenêtre qui précède, dès que ton sommeil devient agité."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Cén t-am is déanaí ar mhaith leat a bheith i do dhúiseacht? Dúiseoidh d’uaireadóir thú san fhuinneog roimhe sin chomh luath is a éiríonn tú corrthónach."
          }
        },
        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "Cando queres estar esperto como moi tarde? O reloxo espértate na xanela anterior en canto te inquietas."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તમારે વધુમાં વધુ ક્યારે જાગી જવું છે? તમે બેચેન થવા લાગો કે તરત ઘડિયાળ તમને તે પહેલાંના સમયગાળામાં જગાડે છે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "עד מתי לכל המאוחר אתם רוצים להיות ערים? השעון יעיר אתכם בחלון שלפני כן, ברגע שהשינה נעשית חסרת מנוחה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप ज़्यादा से ज़्यादा कब तक जागना चाहते हैं? जैसे ही आप बेचैन होने लगते हैं, वॉच आपको उससे पहले की विंडो में जगा देगी।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kada se najkasnije želiš probuditi? Sat te budi u intervalu prije toga, čim ti san postane nemiran."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Legkésőbb mikor akarsz ébren lenni? Az óra az előtte lévő ablakban ébreszt, amint nyugtalan leszel."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ամենաուշը ե՞րբ ես ուզում արթուն լինել։ Ժամացույցդ քեզ կարթնացնի դրանից առաջ՝ պատուհանի ներսում, հենց որ անհանգիստ դառնաս։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Paling lambat kapan kamu ingin bangun? Jam tangan membangunkanmu dalam jendela sebelumnya begitu kamu mulai gelisah."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvenær viltu vera vakandi í síðasta lagi? Úrið vekur þig í glugganum á undan um leið og svefninn verður órólegur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Entro quando vuoi essere sveglio? L’orologio ti sveglia nella finestra precedente non appena il sonno si fa agitato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "遅くとも何時に起きたいですか？眠りが落ち着かなくなったら、ウォッチがその前の時間幅の中で起こします。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "არაუგვიანეს როდის გინდა გაღვიძება? საათი მანამდე, ფანჯარაში გაგაღვიძებს, როგორც კი მოუსვენარი გახდები."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ең кешінде қашан ояу болғың келеді? Мазасыздана бастасаң, сағатың сені оған дейінгі терезе ішінде оятады."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "តើអ្នកចង់ភ្ញាក់យឺតបំផុតនៅពេលណា? នាឡិកានឹងដាស់អ្នកក្នុងចន្លោះពេលមុននោះ ភ្លាមៗនៅពេលអ្នកចាប់ផ្ដើមដេកមិនស្ងប់។"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ತಡವೆಂದರೆ ಯಾವಾಗ ಎದ್ದಿರಬೇಕು? ನೀವು ಚಡಪಡಿಸಲು ಶುರುಮಾಡಿದ ತಕ್ಷಣ ವಾಚ್ ಅದಕ್ಕಿಂತ ಮೊದಲಿನ ಅವಧಿಯೊಳಗೆ ಎಬ್ಬಿಸುತ್ತದೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "늦어도 언제 일어나고 싶나요? 뒤척이기 시작하면 워치가 그 전 범위 안에서 깨워 줘요."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ເຈົ້າຢາກຕື່ນຊ້າສຸດຕອນໃດ? ໂມງຈະປຸກເຈົ້າໃນຊ່ວງເວລາກ່ອນນັ້ນ ທັນທີທີ່ເຈົ້າເລີ່ມນອນບໍ່ສະຫງົບ"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Kada vėliausiai nori keltis? Laikrodis pažadins tave prieš tai esančiame lange, vos tik tavo miegas taps neramus."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Cikos vēlākais vēlies celties? Pulkstenis tevi pamodina logā pirms tam, tiklīdz tavs miegs kļūst nemierīgs."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кога сакаш да бидеш буден најдоцна? Часовникот те буди во прозорецот пред тоа, штом сонот ти стане немирен."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "പരമാവധി എപ്പോൾ ഉണർന്നിരിക്കണം? നിങ്ങൾ അസ്വസ്ഥരാകാൻ തുടങ്ങുമ്പോൾത്തന്നെ വാച്ച് അതിനു മുമ്പുള്ള സമയപരിധിക്കുള്ളിൽ ഉണർത്തും."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Хамгийн оройдоо хэдэн цагт сэрүүн байхыг хүсэж байна? Тайван бус унтаж эхлэхэд цаг чинь түүнээс өмнөх хугацааны дотор сэрээнэ."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुम्हाला जास्तीत जास्त किती वाजता जागे व्हायचे आहे? तुम्ही अस्वस्थ होऊ लागताच घड्याळ त्याआधीच्या कालावधीत तुम्हाला उठवते."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Selewat-lewatnya bila awak mahu bangun? Jam tangan mengejutkan awak dalam tetingkap sebelumnya sebaik sahaja awak mula gelisah."
          }
        },
        "my": {
          "stringUnit": {
            "state": "translated",
            "value": "အနောက်ကျဆုံး ဘယ်အချိန်မှာ နိုးနေချင်သလဲ။ မငြိမ်မသက် ဖြစ်လာသည်နှင့် နာရီက ယင်းမတိုင်မီ အချိန်အပိုင်းအတွင်း နှိုးပေးမည်။"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Når vil du senest være våken? Klokken vekker deg i vinduet før, så snart du blir urolig."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "बढीमा कति बजे ब्युँझिसक्न चाहन्छौ? तिमी छटपटिन थाल्नेबित्तिकै घडीले त्योभन्दा अघिको अवधिभित्र ब्युँझाउँछ।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wanneer wil je uiterlijk wakker zijn? Het horloge wekt je in het venster daarvoor, zodra je onrustig wordt."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਤੁਸੀਂ ਵੱਧ ਤੋਂ ਵੱਧ ਕਦੋਂ ਤੱਕ ਜਾਗਣਾ ਚਾਹੁੰਦੇ ਹੋ? ਜਿਵੇਂ ਹੀ ਤੁਸੀਂ ਬੇਚੈਨ ਹੋਣ ਲੱਗਦੇ ਹੋ, ਘੜੀ ਤੁਹਾਨੂੰ ਉਸ ਤੋਂ ਪਹਿਲਾਂ ਦੀ ਮਿਆਦ ਵਿੱਚ ਜਗਾ ਦਿੰਦੀ ਹੈ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "O której najpóźniej chcesz wstać? Zegarek obudzi Cię w oknie przed tą godziną, gdy tylko Twój sen stanie się niespokojny."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Até que horas você quer estar acordado? O relógio acorda você na janela anterior assim que seu sono fica agitado."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Até que horas queres estar acordado? O relógio acorda-te na janela anterior assim que o teu sono fica agitado."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Cel mai târziu când vrei să fii treaz? Ceasul te trezește în fereastra dinainte, imediat ce somnul tău devine agitat."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Когда ты хочешь проснуться самое позднее? Часы разбудят тебя в окне до этого, как только сон станет беспокойным."
          }
        },
        "si": {
          "stringUnit": {
            "state": "translated",
            "value": "අවසන් වශයෙන් ඔබට අවදිව සිටීමට අවශ්‍ය කවදාද? ඔබ නොසන්සුන් වීමට පටන් ගත් වහාම ඔරලෝසුව ඊට පෙර පරාසය තුළ අවදි කරයි."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Kedy chceš byť najneskôr hore? Hodinky ťa zobudia v okne pred tým, len čo sa tvoj spánok stane nepokojným."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kdaj želiš biti najpozneje pokonci? Ura te zbudi v oknu pred tem, takoj ko postane tvoj spanec nemiren."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Kur do të jesh zgjuar së voni? Ora të zgjon në intervalin para saj, sapo gjumi yt bëhet i shqetësuar."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Када најкасније желиш да се пробудиш? Сат те буди у интервалу пре тога, чим ти сан постане немиран."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "När vill du vara vaken senast? Klockan väcker dig i fönstret innan, så snart sömnen blir orolig."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Unataka kuwa macho kabla ya saa ngapi? Saa yako itakuamsha ndani ya kipindi kilichotangulia mara tu unapoanza kutotulia."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "அதிகபட்சம் எப்போது எழுந்திருக்க வேண்டும்? நீங்கள் அமைதியின்றி அசையத் தொடங்கியதும் வாட்ச் அதற்கு முந்தைய வரம்புக்குள் எழுப்பும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీరు గరిష్ఠంగా ఎప్పటికల్లా మేల్కోవాలి? మీరు అశాంతిగా కదలడం మొదలుపెట్టగానే వాచ్ దానికి ముందున్న వ్యవధిలో లేపుతుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณอยากตื่นช้าที่สุดเมื่อไร นาฬิกาจะปลุกคุณในช่วงเวลาก่อนหน้านั้นทันทีที่คุณเริ่มนอนกระสับกระส่าย"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "En geç ne zaman uyanık olmak istiyorsun? Saat, huzursuzlanmaya başladığın anda seni öncesindeki pencerede uyandırır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Коли ти хочеш прокинутися найпізніше? Годинник розбудить тебе у вікні перед цим, щойно сон стане неспокійним."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "زیادہ سے زیادہ کب تک جاگنا چاہتے ہو؟ جیسے ہی تم بے چین ہونے لگو، گھڑی تمہیں اس سے پہلے کی ونڈو میں جگا دے گی۔"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Eng kechi soat nechada uygʻoq boʻlishni xohlaysan? Bezovtalana boshlashing bilan soating seni undan oldingi oraliq ichida uygʻotadi."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Muộn nhất bạn muốn thức dậy lúc nào? Đồng hồ sẽ đánh thức bạn trong khung giờ trước đó ngay khi bạn bắt đầu trằn trọc."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "你最遲想幾點起床？一旦你睡得不安穩，手錶會在此前的喚醒時段內叫醒你。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你最晚想几点醒来？一旦你睡得不安稳，手表会在此前的窗口内叫醒你。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你最晚想幾點醒來？一旦你睡得不安穩，手錶會在此前的喚醒時段內叫醒你。"
          }
        },
        "zu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ufuna ukuvuka nini kamuva kakhulu? Iwashi lakho likuvusa esikhaleni esingaphambi kwalokho lapho uqala ukungazinzi."
          }
        }
      }
    },
