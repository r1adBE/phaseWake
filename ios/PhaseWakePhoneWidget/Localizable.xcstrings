    "check_watch_problem": {
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Jou horlosie is nie bereikbaar nie. Dra dit, hou Bluetooth aan en maak Phase Wake een keer op die horlosie oop."
          }
        },
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "ሰዓትዎ ሊደረስበት አልቻለም። ያድርጉት፣ Bluetooth እንደበራ ያቆዩ እና Phase Wakeን በሰዓቱ ላይ አንድ ጊዜ ይክፈቱ።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذر الوصول إلى ساعتك. ارتدِها، وأبقِ Bluetooth قيد التشغيل، وافتح Phase Wake على الساعة مرة واحدة."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Saatın əlçatan deyil. Onu tax, Bluetooth-u açıq saxla və saatda Phase Wake-i bir dəfə aç."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Часовникът не е достъпен. Носи го, остави Bluetooth включен и отвори веднъж Phase Wake на часовника."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "তোমার ঘড়ির সঙ্গে যোগাযোগ হচ্ছে না। ঘড়িটা পরো, Bluetooth চালু রাখো আর ঘড়িতে একবার Phase Wake খোলো।"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Sat nije dostupan. Nosi ga, drži Bluetooth uključen i jednom otvori Phase Wake na satu."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "No es pot connectar amb el rellotge. Porta’l posat, mantén el Bluetooth activat i obre Phase Wake al rellotge una vegada."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Hodinky nejsou dostupné. Nasaď si je, nech zapnuté Bluetooth a jednou na hodinkách otevři Phase Wake."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit ur kan ikke nås. Tag det på, hold Bluetooth slået til, og åbn Phase Wake på uret én gang."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Uhr ist nicht erreichbar. Trag sie, lass Bluetooth an und öffne Phase Wake einmal auf der Uhr."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το ρολόι σου δεν είναι προσβάσιμο. Φόρεσέ το, κράτα το Bluetooth ενεργό και άνοιξε το Phase Wake στο ρολόι μία φορά."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your watch isn’t reachable. Wear it, keep Bluetooth on and open Phase Wake on the watch once."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se puede acceder a tu reloj. Póntelo, mantén el Bluetooth activado y abre Phase Wake en el reloj una vez."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kell pole kättesaadav. Kanna seda, hoia Bluetooth sees ja ava Phase Wake kellas üks kord."
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ezin da erlojura iritsi. Jantzi, utzi Bluetootha aktibatuta eta ireki Phase Wake erlojuan behin."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "به ساعتت دسترسی ندارم. آن را ببند، Bluetooth را روشن نگه دار و یک بار Phase Wake را روی ساعت باز کن."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kelloasi ei tavoiteta. Pidä se ranteessa, pidä Bluetooth päällä ja avaa Phase Wake kellossa kerran."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi maabot ang relo mo. Isuot ito, panatilihing naka-on ang Bluetooth, at buksan nang isang beses ang Phase Wake sa relo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta montre est injoignable. Mets-la au poignet, garde le Bluetooth activé et ouvre Phase Wake une fois sur la montre."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Ní féidir teacht ar d’uaireadóir. Caith é, coinnigh Bluetooth ar siúl agus oscail Phase Wake ar an uaireadóir uair amháin."
          }
        },
        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "Non se pode acceder ao reloxo. Pono, deixa o Bluetooth activado e abre Phase Wake no reloxo unha vez."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તમારી ઘડિયાળ સુધી પહોંચાતું નથી. તેને પહેરો, Bluetooth ચાલુ રાખો અને ઘડિયાળ પર એક વાર Phase Wake ખોલો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אי אפשר להגיע לשעון שלכם. ענדו אותו, השאירו את ה-Bluetooth פעיל ופתחו את Phase Wake בשעון פעם אחת."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपकी वॉच तक पहुँचा नहीं जा सकता। उसे पहनें, Bluetooth चालू रखें और वॉच पर एक बार Phase Wake खोलें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sat nije dostupan. Nosi ga, drži Bluetooth uključen i jednom otvori Phase Wake na satu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az órád nem érhető el. Vedd fel, tartsd bekapcsolva a Bluetooth-t, és nyisd meg egyszer a Phase Wake-et az órán."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ժամացույցդ հասանելի չէ։ Կրիր այն, Bluetooth-ը միացված պահիր և մեկ անգամ բացիր Phase Wake-ը ժամացույցում։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jam tanganmu tidak terjangkau. Kenakan, biarkan Bluetooth menyala, dan buka Phase Wake di jam tangan sekali."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekki næst í úrið. Hafðu það á þér, hafðu kveikt á Bluetooth og opnaðu Phase Wake einu sinni á úrinu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo orologio non è raggiungibile. Indossalo, tieni attivo il Bluetooth e apri Phase Wake sull’orologio una volta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ウォッチに接続できません。ウォッチを装着し、Bluetoothをオンにして、ウォッチでPhase Wakeを一度開いてください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "საათი მიუწვდომელია. გაიკეთე, Bluetooth ჩართული დატოვე და ერთხელ გახსენი Phase Wake საათზე."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сағатың қолжетімсіз. Оны тағып ал, Bluetooth-ты қосулы ұста және сағатта Phase Wake-ті бір рет аш."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "មិនអាចភ្ជាប់ទៅនាឡិកាបានទេ។ ពាក់វា បើក Bluetooth ហើយបើក Phase Wake លើនាឡិកាម្ដង។"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನಿಮ್ಮ ವಾಚ್ ತಲುಪುತ್ತಿಲ್ಲ. ಅದನ್ನು ಧರಿಸಿ, Bluetooth ಆನ್ ಇಡಿ ಮತ್ತು ವಾಚ್‌ನಲ್ಲಿ Phase Wake ಅನ್ನು ಒಮ್ಮೆ ತೆರೆಯಿರಿ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "워치에 연결할 수 없어요. 워치를 착용하고 Bluetooth를 켠 뒤, 워치에서 Phase Wake를 한 번 열어 주세요."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ບໍ່ສາມາດເຊື່ອມຫາໂມງໄດ້ ໃສ່ໂມງໄວ້ ເປີດ Bluetooth ແລະ ເປີດ Phase Wake ຢູ່ໂມງໜຶ່ງເທື່ອ"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Laikrodis nepasiekiamas. Užsidėk jį, palik įjungtą Bluetooth ir vieną kartą atidaryk Phase Wake laikrodyje."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Pulkstenis nav sasniedzams. Uzliec to, atstāj ieslēgtu Bluetooth un vienreiz atver Phase Wake pulkstenī."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Часовникот не е достапен. Носи го, остави го Bluetooth вклучен и еднаш отвори го Phase Wake на часовникот."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "വാച്ചുമായി ബന്ധപ്പെടാനാകുന്നില്ല. അത് ധരിക്കുക, Bluetooth ഓണാക്കി വയ്ക്കുക, വാച്ചിൽ Phase Wake ഒരിക്കൽ തുറക്കുക."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Цагтай чинь холбогдож чадахгүй байна. Цагаа зүүж, Bluetooth-ээ асаалттай байлгаад цаган дээрээ Phase Wake-ийг нэг удаа нээ."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुमचे घड्याळ पोहोचण्यायोग्य नाही. ते घाला, ब्लूटूथ चालू ठेवा आणि घड्याळावर एकदा Phase Wake उघडा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Jam tangan tidak dapat dicapai. Pakai jam tangan, biarkan Bluetooth hidup dan buka Phase Wake pada jam tangan sekali."
          }
        },
        "my": {
          "stringUnit": {
            "state": "translated",
            "value": "နာရီကို ဆက်သွယ်၍ မရပါ။ ဝတ်ထားပါ၊ Bluetooth ဖွင့်ထားပြီး နာရီပေါ်တွင် Phase Wake ကို တစ်ကြိမ် ဖွင့်ပါ။"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Klokken er ikke tilgjengelig. Ha den på deg, la Bluetooth stå på og åpne Phase Wake på klokken én gang."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "तिम्रो घडीसम्म पुग्न सकिएन। घडी लगाऊ, Bluetooth अन राख र घडीमा एक पटक Phase Wake खोल।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je horloge is niet bereikbaar. Draag het, laat Bluetooth aan en open Phase Wake één keer op het horloge."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਤੁਹਾਡੀ ਘੜੀ ਨਾਲ ਸੰਪਰਕ ਨਹੀਂ ਹੋ ਰਿਹਾ। ਇਸ ਨੂੰ ਪਹਿਨੋ, ਬਲੂਟੁੱਥ ਚਾਲੂ ਰੱਖੋ ਅਤੇ ਘੜੀ ’ਤੇ ਇੱਕ ਵਾਰ Phase Wake ਖੋਲ੍ਹੋ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zegarek jest niedostępny. Załóż go, zostaw włączony Bluetooth i raz otwórz Phase Wake na zegarku."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível alcançar seu relógio. Use-o, mantenha o Bluetooth ligado e abra o Phase Wake no relógio uma vez."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O relógio não está acessível. Usa-o, mantém o Bluetooth ativado e abre o Phase Wake no relógio uma vez."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ceasul nu este accesibil. Poartă-l, ține Bluetooth pornit și deschide Phase Wake pe ceas o dată."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Часы недоступны. Надень их, не выключай Bluetooth и один раз открой Phase Wake на часах."
          }
        },
        "si": {
          "stringUnit": {
            "state": "translated",
            "value": "ඔබේ ඔරලෝසුවට ළඟා විය නොහැක. එය පැළඳ, Bluetooth සක්‍රියව තබා ඔරලෝසුවේ Phase Wake එක් වරක් විවෘත කරන්න."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Hodinky nie sú dostupné. Nos ich, nechaj zapnutý Bluetooth a raz otvor Phase Wake v hodinkách."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ura ni dosegljiva. Nosi jo, pusti Bluetooth vklopljen in enkrat odpri Phase Wake na uri."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Ora jote nuk arrihet. Vendose në dorë, mbaje Bluetooth-in të ndezur dhe hap një herë Phase Wake në orë."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Сат није доступан. Носи га, држи Bluetooth укључен и једном отвори Phase Wake на сату."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Klockan går inte att nå. Ta på den, låt Bluetooth vara på och öppna Phase Wake på klockan en gång."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Saa yako haipatikani. Ivae, acha Bluetooth ikiwa imewashwa na ufungue Phase Wake kwenye saa mara moja."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் வாட்ச்சை அணுக முடியவில்லை. அதை அணிந்து, Bluetooth ஐ ஆனில் வைத்து, வாட்ச்சில் ஒருமுறை Phase Wake ஐத் திறவுங்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ వాచ్ అందుబాటులో లేదు. దాన్ని పెట్టుకోండి, బ్లూటూత్ ఆన్‌లో ఉంచండి, వాచ్‌లో ఒకసారి Phase Wake తెరవండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ติดต่อนาฬิกาของคุณไม่ได้ ให้สวมนาฬิกา เปิด Bluetooth ไว้ และเปิด Phase Wake บนนาฬิกาสักครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saatine ulaşılamıyor. Tak, Bluetooth’u açık tut ve saatte Phase Wake’i bir kez aç."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Годинник недоступний. Одягни його, не вимикай Bluetooth і один раз відкрий Phase Wake на годиннику."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "تمہاری گھڑی سے رابطہ نہیں ہو رہا۔ اسے پہنو، Bluetooth آن رکھو اور گھڑی پر ایک بار Phase Wake کھولو۔"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Soatingga ulanib boʻlmayapti. Uni taq, Bluetoothʼni yoqiq qoldir va soatda Phase Wakeʼni bir marta och."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể kết nối với đồng hồ. Hãy đeo đồng hồ, bật Bluetooth và mở Phase Wake trên đồng hồ một lần."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "連接不到你的手錶。請戴上手錶、保持藍牙開啟，並在手錶上開啟一次 Phase Wake。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法连接到你的手表。请戴上手表，保持 Bluetooth 开启，并在手表上打开一次 Phase Wake。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法連線到你的手錶。請戴上手錶，保持 Bluetooth 開啟，並在手錶上開啟一次 Phase Wake。"
          }
        },
        "zu": {
          "stringUnit": {
            "state": "translated",
            "value": "Iwashi lakho alifinyeleleki. Lifake, gcina i-Bluetooth ivuliwe bese uvula i-Phase Wake ewashini kanye."
          }
        }
      }
    },
