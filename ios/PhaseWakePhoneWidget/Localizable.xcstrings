        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ទិន្នន័យនៅលើឧបករណ៍របស់អ្នក។ អ្នកអាចបិទដំណាក់កាលរៀននៅក្នុងការកំណត់បានគ្រប់ពេល។"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಡೇಟಾ ನಿಮ್ಮ ಸಾಧನಗಳಲ್ಲೇ ಇರುತ್ತದೆ. ಕಲಿಕೆಯ ಹಂತವನ್ನು ಸೆಟ್ಟಿಂಗ್‌ಗಳಲ್ಲಿ ಯಾವಾಗ ಬೇಕಾದರೂ ಆಫ್ ಮಾಡಬಹುದು."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "데이터는 당신의 기기에 남습니다. 학습 단계는 설정에서 언제든지 끌 수 있습니다."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ຂໍ້ມູນຢູ່ໃນອຸປະກອນຂອງເຈົ້າ. ເຈົ້າສາມາດປິດໄລຍະຮຽນຮູ້ໃນການຕັ້ງຄ່າໄດ້ທຸກເວລາ."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Duomenys lieka tavo įrenginiuose. Mokymosi etapą gali bet kada išjungti nustatymuose."
