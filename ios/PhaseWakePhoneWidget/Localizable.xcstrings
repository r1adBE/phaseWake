        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "ከ%1$lld %% ባትሪ በታች ሰዓትህ ዛሬ ማታ ለመማሪያ ጊዜ አይቀርጽም – አስቀድመህ ኃይል ሙላው። ቢሆንም ማንቂያው ይቀሰቅስሃል።"
