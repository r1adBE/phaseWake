          "stringUnit": {
            "state": "translated",
            "value": "ລະຫັດຜ່ານຜິດ ຫຼື ບໍ່ແມ່ນໄຟລ໌ສຳຮອງ Phase Wake ບໍ່ມີຫຍັງປ່ຽນແປງ"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Neteisingas slaptažodis arba tai ne Phase Wake atsarginė kopija. Niekas nepakeista."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Nepareiza parole vai tas nav Phase Wake dublējums. Nekas netika mainīts."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Погрешна лозинка или не е копија од Phase Wake. Ништо не е променето."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "തെറ്റായ പാസ്‌വേഡ്, അല്ലെങ്കിൽ ഇത് Phase Wake ബാക്കപ്പ് അല്ല. ഒന്നും മാറ്റിയിട്ടില്ല."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Нууц үг буруу эсвэл Phase Wake-ийн нөөц биш. Юу ч өөрчлөгдсөнгүй."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "चुकीचा पासवर्ड किंवा हा Phase Wake बॅकअप नाही. काहीही बदलले नाही."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kata laluan salah atau bukan sandaran Phase Wake. Tiada apa-apa diubah."
          }
        },
        "my": {
          "stringUnit": {
            "state": "translated",
            "value": "စကားဝှက် မှားနေသည် သို့မဟုတ် Phase Wake အရန်ဖိုင် မဟုတ်ပါ။ ဘာမှ မပြောင်းလဲပါ။"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Feil passord eller ikke en Phase Wake-kopi. Ingenting er endret."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "पासवर्ड गलत छ वा यो Phase Wake ब्याकअप होइन। केही पनि बदलिएन।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verkeerd wachtwoord of geen Phase Wake-back-up. Er is niets gewijzigd."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਗ਼ਲਤ ਪਾਸਵਰਡ ਜਾਂ ਇਹ Phase Wake ਬੈਕਅੱਪ ਨਹੀਂ ਹੈ। ਕੁਝ ਵੀ ਨਹੀਂ ਬਦਲਿਆ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Złe hasło lub to nie jest kopia Phase Wake. Nic nie zostało zmienione."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Senha incorreta ou não é um backup do Phase Wake. Nada foi alterado."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Palavra-passe errada ou não é uma cópia do Phase Wake. Nada foi alterado."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Parolă greșită sau nu e o copie Phase Wake. Nu s-a schimbat nimic."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Неверный пароль или это не копия Phase Wake. Ничего не изменено."
          }
        },
        "si": {
          "stringUnit": {
            "state": "translated",
            "value": "මුරපදය වැරදියි, නැතහොත් මෙය Phase Wake උපස්ථයක් නොවේ. කිසිවක් වෙනස් නොකළා."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Nesprávne heslo alebo to nie je záloha Phase Wake. Nič sa nezmenilo."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Napačno geslo ali to ni varnostna kopija Phase Wake. Nič ni bilo spremenjeno."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Fjalëkalim i gabuar ose nuk është kopje rezervë e Phase Wake. Asgjë nuk u ndryshua."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Погрешна лозинка или ово није резервна копија апликације Phase Wake. Ништа није промењено."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Fel lösenord eller ingen Phase Wake-kopia. Inget har ändrats."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenosiri si sahihi au si nakala ya Phase Wake. Hakuna kilichobadilishwa."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "தவறான கடவுச்சொல் அல்லது இது Phase Wake காப்புப்பிரதி அல்ல. எதுவும் மாற்றப்படவில்லை."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "తప్పు పాస్‌వర్డ్ లేదా ఇది Phase Wake బ్యాకప్ కాదు. ఏమీ మారలేదు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รหัสผ่านผิดหรือไม่ใช่ข้อมูลสำรองของ Phase Wake ไม่มีอะไรเปลี่ยน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yanlış şifre veya Phase Wake yedeği değil. Hiçbir şey değişmedi."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Неправильний пароль або це не копія Phase Wake. Нічого не змінено."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "غلط پاس ورڈ یا یہ Phase Wake کا بیک اپ نہیں۔ کچھ نہیں بدلا گیا۔"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Parol notoʻgʻri yoki bu Phase Wake zaxira nusxasi emas. Hech narsa oʻzgartirilmadi."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sai mật khẩu hoặc không phải bản sao lưu Phase Wake. Không có gì thay đổi."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "密碼錯誤或不是 Phase Wake 備份。沒有作出任何更改。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "密码错误或不是 Phase Wake 备份。没有任何更改。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "密碼錯誤或不是 Phase Wake 備份。沒有任何變更。"
          }
        },
        "zu": {
          "stringUnit": {
            "state": "translated",
            "value": "Iphasiwedi engalungile noma akuyona ikhophi ye-Phase Wake. Akukho okushintshiwe."
          }
        }
      }
    },
