        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Реши 3 примера, прежде чем будильник замолчит. Отложить можно без примера."
          }
        },
        "si": {
          "stringUnit": {
            "state": "translated",
            "value": "එලාමය නිහඬ වීමට පෙර එකතු කිරීම් 3 ක් විසඳන්න. ස්නූස් කිරීමට ගැටලුවක් අවශ්‍ය නැත."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyrieš 3 príklady, kým budík stíchne. Odloženie funguje bez úlohy."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Reši 3 račune, preden budilka utihne. Dremež deluje brez naloge."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Zgjidh 3 mbledhje para se alarmi të heshtë. Shtyrja funksionon pa detyrë."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Реши 3 сабирања пре него што аларм утихне. Одлагање ради и без задатка."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lös 3 uppgifter innan larmet tystnar. Snooza går utan uppgift."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Tatua hesabu 3 za kujumlisha kabla kengele haijanyamaza. Kuahirisha hakuhitaji swali."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "அலாரம் அமைதியாகும் முன் 3 கூட்டல் கணக்குகளைத் தீருங்கள். ஸ்னூஸுக்குக் கணக்கு தேவையில்லை."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "అలారం ఆగే ముందు 3 కూడికలు చేయండి. స్నూజ్‌కు లెక్క అవసరం లేదు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แก้โจทย์บวก 3 ข้อก่อนนาฬิกาปลุกเงียบ เลื่อนปลุกได้โดยไม่ต้องทำโจทย์"
