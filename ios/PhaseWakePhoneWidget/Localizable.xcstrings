        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wagi: Czas snu 35, Głęboki 20, REM 20, Czuwanie 15, Zasypianie 10. Brakujące wartości nie są liczone."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Peso: Duração do sono 35, Profundo 20, REM 20, Acordado 15, Tempo para adormecer 10. Valores ausentes não contam."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ponderação: Duração do sono 35, Profundo 20, REM 20, Acordado 15, Tempo até adormecer 10. Os valores em falta não contam."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ponderare: Durata somnului 35, Profund 20, REM 20, Treaz 15, Adormire 10. Valorile lipsă nu se iau în calcul."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Веса: Длительность сна 35, Глубокий 20, REM 20, Бодрствование 15, Засыпание 10. Отсутствующие значения не учитываются."
          }
        },
        "si": {
          "stringUnit": {
            "state": "translated",
            "value": "බර: නින්දේ කාලය 35, ගැඹුරු 20, REM 20, අවදියි 15, නින්දට යාමට ගතවූ කාලය 10. නැති අගයන් ගණන් නොගනී."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Váhy: Dĺžka spánku 35, Hlboký 20, REM 20, Bdenie 15, Zaspávanie 10. Chýbajúce hodnoty sa nerátajú."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uteži: Trajanje spanja 35, Globok 20, REM 20, Budnost 15, Uspavanje 10. Manjkajoče vrednosti se ne štejejo."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Pesha: Kohëzgjatja e gjumit 35, I thellë 20, REM 20, Zgjuar 15, Koha për të fjetur 10. Vlerat që mungojnë nuk numërohen."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Тежина: Трајање сна 35, Дубоки 20, REM 20, Будно 15, Успављивање 10. Вредности које недостају се не рачунају."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Viktning: Sömnlängd 35, Djup 20, REM 20, Vaken 15, Insomning 10. Saknade värden räknas inte."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Uzito: Muda wa usingizi 35, Mzito 20, REM 20, Macho 15, Muda wa kupata usingizi 10. Thamani zinazokosekana hazihesabiwi."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "எடை: தூக்க நேரம் 35, ஆழ்ந்த 20, REM 20, விழிப்பு 15, தூங்க ஆன நேரம் 10. இல்லாத மதிப்புகள் கணக்கில் வராது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "బరువు: నిద్ర వ్యవధి 35, గాఢ 20, REM 20, మేల్కొని 15, నిద్రపట్టడానికి పట్టిన సమయం 10. లేని విలువలు లెక్కలోకి రావు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "น้ำหนัก: ระยะเวลานอน 35, ลึก 20, REM 20, ตื่น 15, เวลาจนหลับ 10. ค่าที่ขาดหายไม่นับ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ağırlık: Uyku süresi 35, Derin 20, REM 20, Uyanık 15, Uykuya dalma süresi 10. Eksik değerler sayılmaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваги: Тривалість сну 35, Глибокий 20, REM 20, Неспання 15, Засинання 10. Відсутні значення не враховуються."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "وزن: نیند کا دورانیہ 35, گہری 20, REM 20, جاگتے 15, نیند آنے کا وقت 10. غائب قدریں شمار نہیں ہوتیں۔"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Vazn: Uyqu davomiyligi 35, Chuqur 20, REM 20, Uygʻoq 15, Uxlab qolish vaqti 10. Yetishmayotgan qiymatlar hisoblanmaydi."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trọng số: Thời lượng ngủ 35, Sâu 20, REM 20, Thức 15, Thời gian vào giấc 10. Giá trị thiếu không được tính."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "權重: 睡眠時長 35, 深睡 20, REM 20, 清醒 15, 入睡時間 10. 缺少的數值唔計。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "权重: 睡眠时长 35, 深睡 20, 快速眼动 20, 清醒 15, 入睡时长 10. 缺少的数值不计入。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "權重: 睡眠時長 35, 深眠 20, 快速動眼 20, 清醒 15, 入睡時間 10. 缺少的數值不計入。"
          }
        },
        "zu": {
          "stringUnit": {
            "state": "translated",
            "value": "Isisindo: Isikhathi sokulala 35, Obujulile 20, REM 20, Uvukile 15, Isikhathi sokuzumeka 10. Amanani angekho awabalwa."
          }
        }
