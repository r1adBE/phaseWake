        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Alt blir på telefonen og klokka. Ingen konto, ingen server, ingen sporing."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "सबै कुरा तिम्रो फोन र घडीमै रहन्छ। न खाता, न सर्भर, न ट्र्याकिङ।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles blijft op je telefoon en horloge. Geen account, geen server, geen tracking."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਸਭ ਕੁਝ ਤੁਹਾਡੇ ਫ਼ੋਨ ਅਤੇ ਘੜੀ ’ਤੇ ਹੀ ਰਹਿੰਦਾ ਹੈ। ਕੋਈ ਖਾਤਾ ਨਹੀਂ, ਕੋਈ ਸਰਵਰ ਨਹੀਂ, ਕੋਈ ਟਰੈਕਿੰਗ ਨਹੀਂ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wszystko zostaje na telefonie i zegarku. Bez konta, serwera i śledzenia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tudo fica no seu celular e no relógio. Sem conta, sem servidor, sem rastreamento."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Tudo fica no telemóvel e no relógio. Sem conta, sem servidor, sem rastreio."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Totul rămâne pe telefon și pe ceas. Fără cont, fără server, fără urmărire."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Всё остаётся на телефоне и часах. Без аккаунта, сервера и слежки."
          }
        },
        "si": {
          "stringUnit": {
            "state": "translated",
            "value": "සියල්ල ඔබේ දුරකථනයේ සහ ඔරලෝසුවේම පවතී. ගිණුමක් නැත, සේවාදායකයක් නැත, ලුහුබැඳීමක් නැත."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Všetko zostáva v telefóne a hodinkách. Žiadny účet, žiadny server, žiadne sledovanie."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vse ostane na telefonu in uri. Brez računa, brez strežnika, brez sledenja."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Gjithçka mbetet në telefon dhe në orë. Pa llogari, pa server, pa gjurmim."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Све остаје на твом телефону и сату. Без налога, без сервера, без праћења."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Allt stannar på mobilen och klockan. Inget konto, ingen server, ingen spårning."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Kila kitu kinabaki kwenye simu na saa yako. Hakuna akaunti, hakuna seva, hakuna ufuatiliaji."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "எல்லாம் உங்கள் ஃபோனிலும் வாட்ச்சிலும் மட்டுமே இருக்கும். கணக்கு இல்லை, சர்வர் இல்லை, கண்காணிப்பு இல்லை."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "అంతా మీ ఫోన్‌లో, వాచ్‌లోనే ఉంటుంది. ఖాతా లేదు, సర్వర్ లేదు, ట్రాకింగ్ లేదు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทุกอย่างอยู่บนโทรศัพท์และนาฬิกาของคุณเท่านั้น ไม่มีบัญชี ไม่มีเซิร์ฟเวอร์ ไม่มีการติดตาม"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her şey telefonunda ve saatinde kalır. Hesap yok, sunucu yok, takip yok."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Усе залишається на телефоні та годиннику. Без облікового запису, сервера й стеження."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "سب کچھ تمہارے فون اور گھڑی پر رہتا ہے۔ نہ اکاؤنٹ، نہ سرور، نہ ٹریکنگ۔"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Hammasi telefoning va soatingda qoladi. Hisob yoʻq, server yoʻq, kuzatuv yoʻq."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mọi thứ chỉ nằm trên điện thoại và đồng hồ của bạn. Không tài khoản, không máy chủ, không theo dõi."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "所有資料只會留在你的手機和手錶上。無帳戶、無伺服器、無追蹤。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所有数据都只保存在手机和手表上。无需账号，没有服务器，不做跟踪。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
