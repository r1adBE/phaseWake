    "editor_advice_text|one": {
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "In %1$lld van die laaste %2$lld nag was daar geen ligte slaap in die venster nie. Met %3$lld min word jy meer dikwels op ’n goeie oomblik wakker."
          }
        },
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "ካለፉት %2$lld ሌሊት ውስጥ በ%1$lld ሌሊት በክልሉ ውስጥ ቀላል እንቅልፍ አልነበረም። በ%3$lld ደቂቃ ብዙ ጊዜ በጥሩ ቅጽበት ይነቃሉ።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "في %1$lld من آخر %2$lld ليلة لم يظهر نوم خفيف ضمن النافذة. مع %3$lld دقيقة تزداد فرص الاستيقاظ في لحظة مناسبة."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Son %2$lld gecənin %1$lld gecəsində pəncərədə yüngül yuxu olmayıb. %3$lld dəq ilə daha tez-tez doğru anda oyanacaqsan."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "В %1$lld от последната %2$lld нощ нямаше лек сън в прозореца. С %3$lld мин по-често ще се будиш в добър момент."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "গত %2$lldটি রাতের %1$lldটিতে সময়সীমার মধ্যে হালকা ঘুম ছিল না। %3$lld মি. নিলে আরও প্রায়ই ভালো মুহূর্তে জাগবে।"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "U %1$lld od posljednje %2$lld noći u intervalu nije bilo laganog sna. S %3$lld min češće ćeš se probuditi u dobrom trenutku."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "En %1$lld de l’última %2$lld nit no hi va haver son lleuger a la finestra. Amb %3$lld min et despertaràs més sovint en un bon moment."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "V %1$lld z poslední %2$lld noci se v okně neobjevil žádný lehký spánek. S %3$lld min se budeš častěji budit ve vhodnou chvíli."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "I %1$lld af den seneste %2$lld nat var der ingen let søvn i vinduet. Med %3$lld min vågner du oftere på et godt tidspunkt."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In %1$lld der letzten %2$lld Nacht kam kein leichter Schlaf ins Fenster. Mit %3$lld Min erwischst du öfter einen guten Moment."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Σε %1$lld από την τελευταία %2$lld νύχτα δεν υπήρχε ελαφρύς ύπνος στο παράθυρο. Με %3$lld λεπτά θα ξυπνάς πιο συχνά την κατάλληλη στιγμή."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In %1$lld of the last %2$lld night there was no light sleep in the window. With %3$lld min you’ll more often wake at a good moment."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En %1$lld de la última noche (%2$lld) no hubo sueño ligero dentro de la ventana. Con %3$lld min te despertarás más a menudo en un buen momento."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Viimasest %2$lld ööst %1$lld ööl polnud aknas kerget und. %3$lld minutiga ärkad sagedamini heal hetkel."
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "Azken %2$lld gauetik %1$lld gauetan ez zen lo arinik izan leihoan. %3$lld minutuarekin maizago esnatuko zara une onean."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "در %1$lld شب از %2$lld شب اخیر، در بازه خواب سبک نبود. با %3$lld دقیقه بیشتر در لحظه‌ای مناسب بیدار می‌شوی."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld viimeisestä %2$lld yöstä ikkunassa ei ollut kevyttä unta. Kun ikkuna on %3$lld min, heräät useammin hyvällä hetkellä."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Sa %1$lld sa huling %2$lld gabi, walang mababaw na tulog sa window. Sa %3$lld min, mas madalas kang magigising sa magandang sandali."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dans %1$lld de la dernière nuit (%2$lld), il n’y avait pas de sommeil léger dans la fenêtre. Avec %3$lld min, tu te réveilleras plus souvent au bon moment."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Ní raibh codladh éadrom san fhuinneog i %1$lld as na %2$lld oíche dheireanacha. Le %3$lld nóim, is minice a dhúiseoidh tú ag nóiméad maith."
          }
        },
        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "En %1$lld da última %2$lld noite non houbo sono lixeiro na xanela. Con %3$lld min espertarás máis veces nun bo momento."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "છેલ્લી %2$lld રાતમાંથી %1$lld રાતે સમયગાળામાં હળવી ઊંઘ નહોતી. %3$lld મિ. સાથે તમે વધુ વાર યોગ્ય ક્ષણે જાગશો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ב-%1$lld מתוך הלילה האחרון (%2$lld) לא הייתה שינה קלה בחלון. עם %3$lld דק׳ יהיו יותר התעוררויות ברגע טוב."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पिछली %2$lld रात में से %1$lld रात में विंडो के दौरान हल्की नींद नहीं आई। %3$lld मिनट से तुम अक्सर सही समय पर जागोगे।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "U %1$lld od posljednje %2$lld noći u intervalu nije bilo laganog sna. S %3$lld min češće ćeš se probuditi u dobrom trenutku."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az utolsó %2$lld éjszakából %1$lld alkalommal nem volt könnyű alvás az ablakban. %3$lld perccel gyakrabban ébredsz jó pillanatban."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Վերջին %2$lld գիշերից %1$lld-ում պատուհանում թեթև քուն չի եղել։ %3$lld ր-ով ավելի հաճախ կարթնանաս հարմար պահին։"
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Í %1$lld af síðustu %2$lld nótt var enginn léttur svefn í glugganum. Með %3$lld mín vaknarðu oftar á góðu augnabliki."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In %1$lld dell’ultima notte (%2$lld) non c’era sonno leggero nella finestra. Con %3$lld min ti sveglierai più spesso al momento giusto."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ბოლო %2$lld ღამიდან %1$lld-ში ფანჯარაში მსუბუქი ძილი არ იყო. %3$lld წთ-ით უფრო ხშირად გაიღვიძებ კარგ მომენტში."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Соңғы %2$lld түннің %1$lld түнінде терезеде жеңіл ұйқы болмады. %3$lld минутпен жиірек дәл кезінде оянасың."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಕಳೆದ %2$lld ರಾತ್ರಿಯಲ್ಲಿ %1$lld ರಲ್ಲಿ ಅವಧಿಯೊಳಗೆ ಹಗುರ ನಿದ್ರೆ ಇರಲಿಲ್ಲ. %3$lld ನಿಮಿ. ಇದ್ದರೆ ಹೆಚ್ಚಾಗಿ ಒಳ್ಳೆಯ ಕ್ಷಣದಲ್ಲಿ ಏಳುತ್ತೀರಿ."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
