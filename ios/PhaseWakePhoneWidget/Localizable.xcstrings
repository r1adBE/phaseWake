    "check_watch_battery_problem": {
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Onder %1$lld %% – laai jou horlosie sodat dit die nag hou en jou wakker kan maak."
          }
        },
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "ከ%1$lld %% በታች – ሌሊቱን እንዲቆይና እንዲቀሰቅስዎ ሰዓትዎን ኃይል ይሙሉ።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أقل من %1$lld %% – اشحن ساعتك لتصمد طوال الليل وتوقظك."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld %%-dən aşağı – gecəyə çatsın və səni oyada bilsin deyə saatını doldur."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Под %1$lld %% – зареди часовника, за да издържи през нощта и да те събуди."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld %%-এর নিচে – ঘড়ি চার্জ দাও, যাতে সারা রাত চলে আর তোমাকে জাগাতে পারে।"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ispod %1$lld %% – napuni sat kako bi izdržao noć i probudio te."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Menys del %1$lld %% – carrega el rellotge perquè aguanti tota la nit i et pugui despertar."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pod %1$lld %% – nabij hodinky, aby vydržely celou noc a mohly tě vzbudit."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Under %1$lld %% – oplad dit ur, så det holder natten igennem og kan vække dig."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unter %1$lld %% – lade die Uhr, damit sie die Nacht durchhält und dich weckt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κάτω από %1$lld %% – φόρτισε το ρολόι σου, ώστε να αντέξει όλη τη νύχτα και να σε ξυπνήσει."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Below %1$lld %% – charge your watch so it lasts the night and can wake you."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Menos del %1$lld %% – carga tu reloj para que aguante toda la noche y pueda despertarte."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
