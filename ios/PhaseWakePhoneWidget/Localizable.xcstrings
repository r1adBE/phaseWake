        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Papalitan ng backup ang mga alarm, kasaysayan, tala, at setting sa teleponong ito."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les réveils, l’historique, les notes et les réglages de ce téléphone seront remplacés par la sauvegarde."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuirfear an cúltaca in ionad na n-aláram, na staire, na nótaí agus na socruithe ar an bhfón seo."
          }
        },
        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "As alarmas, o historial, as notas e os axustes deste teléfono substituiranse pola copia."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "આ ફોન પરના એલાર્મ, ઇતિહાસ, નોંધો અને સેટિંગની જગ્યાએ બેકઅપનો ડેટા આવશે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ההשכמות, ההיסטוריה, ההערות וההגדרות בטלפון הזה יוחלפו בגיבוי."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस फ़ोन के अलार्म, इतिहास, नोट और सेटिंग बैकअप से बदल दिए जाएंगे।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Alarmi, povijest, bilješke i postavke na ovom telefonu bit će zamijenjeni sigurnosnom kopijom."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A telefon ébresztőit, előzményeit, jegyzeteit és beállításait a mentés váltja fel."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Այս հեռախոսի զարթուցիչները, պատմությունը, նշումները և կարգավորումները կփոխարինվեն պահուստային պատճենով։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Alarm, riwayat, catatan, dan setelan di ponsel ini akan diganti dengan cadangan."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Vekjurum, ferli, athugasemdum og stillingum í þessum síma verður skipt út fyrir afritið."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sveglie, cronologia, note e impostazioni su questo telefono saranno sostituite dal backup."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このスマホのアラーム、履歴、メモ、設定がバックアップで置き換えられます。"
