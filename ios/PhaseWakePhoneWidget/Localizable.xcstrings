    "channel_sunrise_description": {
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Verlig jou skerm soos ’n sonsopkoms voordat jy wakker word."
          }
        },
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "ከመንቃትዎ በፊት ማያ ገጽዎን እንደ ፀሐይ መውጫ ያበራል።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يضيء شاشتك مثل شروق الشمس قبل أن تستيقظ."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Oyanmazdan əvvəl ekranını gündoğumu kimi işıqlandırır."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Осветява екрана като изгрев преди събуждането."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "জাগার আগে তোমার স্ক্রিন সূর্যোদয়ের মতো আলোকিত করে।"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Osvjetljava ekran poput izlaska sunca prije buđenja."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Il·lumina la pantalla com una sortida del sol abans de despertar-te."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Rozsvítí displej jako východ slunce, než se probudíš."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tænder skærmen som en solopgang, før du vågner."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lässt den Bildschirm vor dem Wecken wie einen Sonnenaufgang leuchten."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Φωτίζει την οθόνη σου σαν ανατολή ηλίου πριν ξυπνήσεις."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lights up your screen like a sunrise before you wake."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ilumina tu pantalla como un amanecer antes de despertarte."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Valgustab enne ärkamist ekraani nagu päikesetõus."
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "Esnatu aurretik pantaila argitzen du, egunsenti bat bezala."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "پیش از بیدار شدنت، صفحه را مثل طلوع خورشید روشن می‌کند."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Valaisee näytön kuin auringonnousun ennen heräämistäsi."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Pinapaliwanag ang screen mo na parang pagsikat ng araw bago ka gumising."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Illumine ton écran comme un lever de soleil avant ton réveil."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Lasann sé do scáileán cosúil le héirí gréine sula ndúisíonn tú."
          }
        },
        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ilumina a pantalla coma un amencer antes de espertares."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તમે જાગો તે પહેલાં તમારી સ્ક્રીનને સૂર્યોદયની જેમ પ્રકાશિત કરે છે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מאיר את המסך כמו זריחה לפני שתתעוררו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जगाने से पहले आपकी स्क्रीन को सूर्योदय की तरह रोशन करता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Osvjetljava zaslon poput izlaska sunca prije buđenja."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Napfelkeltéhez hasonlóan világítja meg a képernyőt ébredés előtt."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Արթնանալուց առաջ էկրանդ լուսավորում է արևածագի պես։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menyalakan layar seperti matahari terbit sebelum kamu bangun."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Lýsir upp skjáinn eins og sólarupprás áður en þú vaknar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Illumina lo schermo come un’alba prima che ti svegli."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "起きる前に、日の出のように画面を明るくします。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "გაღვიძებამდე ეკრანს მზის ამოსვლასავით ანათებს."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Оянар алдында экранды күннің шығуындай жарықтандырады."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "បំភ្លឺអេក្រង់ដូចថ្ងៃរះ មុនពេលអ្នកភ្ញាក់។"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನೀವು ಏಳುವ ಮೊದಲು ಸೂರ್ಯೋದಯದಂತೆ ಪರದೆಯನ್ನು ಬೆಳಗಿಸುತ್ತದೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "깨우기 전에 화면을 일출처럼 밝혀요."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ເຮັດໃຫ້ໜ້າຈໍສະຫວ່າງຄືຕາເວັນຂຶ້ນ ກ່ອນເຈົ້າຕື່ນ"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Prieš pabudimą apšviečia ekraną kaip saulėtekis."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Pirms pamošanās izgaismo ekrānu kā saullēkts."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Пред будењето го осветлува екранот како изгрејсонце."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഉണരുന്നതിന് മുമ്പ് സൂര്യോദയം പോലെ സ്‌ക്രീൻ പ്രകാശിപ്പിക്കും."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Сэрэхээс чинь өмнө дэлгэцийг нар мандах мэт гэрэлтүүлнэ."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "उठण्यापूर्वी तुमची स्क्रीन सूर्योदयासारखी उजळवते."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Menyalakan skrin seperti matahari terbit sebelum awak bangun."
          }
        },
        "my": {
          "stringUnit": {
            "state": "translated",
            "value": "မနိုးမီ မျက်နှာပြင်ကို နေထွက်သလို လင်းစေသည်။"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Lyser opp skjermen som en soloppgang før du våkner."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "तिमी ब्युँझनुअघि स्क्रिनलाई सूर्योदयझैँ उज्यालो बनाउँछ।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Laat je scherm oplichten als een zonsopgang voordat je wakker wordt."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਜਾਗਣ ਤੋਂ ਪਹਿਲਾਂ ਤੁਹਾਡੀ ਸਕ੍ਰੀਨ ਨੂੰ ਚੜ੍ਹਦੇ ਸੂਰਜ ਵਾਂਗ ਰੌਸ਼ਨ ਕਰਦਾ ਹੈ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rozjaśnia ekran jak wschód słońca, zanim się obudzisz."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ilumina sua tela como um nascer do sol antes de você acordar."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ilumina o ecrã como um nascer do sol antes de acordares."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Luminează ecranul ca un răsărit înainte să te trezești."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подсвечивает экран, как рассвет, перед твоим пробуждением."
          }
        },
        "si": {
          "stringUnit": {
            "state": "translated",
            "value": "ඔබ අවදි වීමට පෙර තිරය හිරු උදාවක් මෙන් ආලෝකමත් කරයි."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pred budením rozsvieti obrazovku ako východ slnka."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pred bujenjem osvetli zaslon kot sončni vzhod."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Ndriçon ekranin si një lindje dielli para zgjimit."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Осветљава екран попут изласка сунца пре буђења."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tänder skärmen som en soluppgång innan du vaknar."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Huangaza skrini yako kama macheo kabla hujaamka."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "எழுவதற்கு முன் உங்கள் திரையைச் சூரிய உதயம் போல ஒளிரச் செய்யும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీరు మేల్కొనే ముందు మీ స్క్రీన్‌ను సూర్యోదయంలా వెలిగిస్తుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทำให้หน้าจอสว่างเหมือนพระอาทิตย์ขึ้นก่อนที่คุณจะตื่น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sen uyanmadan önce ekranı gün doğumu gibi aydınlatır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Підсвічує екран, як світанок, перш ніж ти прокинешся."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "جاگنے سے پہلے تمہاری اسکرین کو طلوعِ آفتاب کی طرح روشن کرتا ہے۔"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygʻonishingdan oldin ekraningni quyosh chiqishidek yoritadi."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Làm sáng màn hình như bình minh trước khi bạn thức dậy."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "在你醒來前，讓螢幕像日出一樣亮起。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在你醒来前，让屏幕像日出一样亮起。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在你醒來前，讓螢幕像日出一樣亮起。"
          }
        },
        "zu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ikhanyisa isikrini sakho njengokuphuma kwelanga ngaphambi kokuthi uvuke."
          }
        }
      }
    },
