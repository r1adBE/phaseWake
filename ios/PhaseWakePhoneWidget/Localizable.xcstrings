    "settings_export_hint": {
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Help om die bespeuring te verbeter: CSV sonder name, datums of toestel-ID’s; bevat beweging en hartklop per 30 s, hoe jy gevoel het en jou notas."
          }
        },
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "መለየትን ለማሻሻል እርዳ፦ ያለ ስም፣ ቀን ወይም የመሣሪያ መታወቂያ CSV፤ በየ30 ሰከንዱ እንቅስቃሴና የልብ ምት፣ ስሜትህንና ማስታወሻዎችህን ይዟል።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ساعد في تحسين الاكتشاف: ملف CSV دون أسماء أو تواريخ أو معرّفات أجهزة؛ يحتوي على الحركة ونبض القلب لكل ٣٠ ثانية وشعورك وملاحظاتك."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Aşkarlamanı yaxşılaşdırmağa kömək et: adsız, tarixsiz və cihaz ID-siz CSV; hər 30 s üçün hərəkət və nəbz, özünü necə hiss etdiyin və qeydlərin daxildir."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Помогни да подобрим разпознаването: CSV без имена, дати и ID на устройства; съдържа движение и пулс на всеки 30 s, как си се чувствал и бележките ти."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "শনাক্তকরণ উন্নত করতে সাহায্য করো: নাম, তারিখ বা ডিভাইস আইডি ছাড়া CSV; এতে প্রতি 30 সেকেন্ডের নড়াচড়া ও হৃদস্পন্দন, তোমার অনুভূতি আর তোমার নোট থাকে।"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pomozi da poboljšamo prepoznavanje: CSV bez imena, datuma i ID-ova uređaja; sadrži pokret i puls svakih 30 s, kako si se osjećao i tvoje bilješke."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajuda a millorar la detecció: CSV sense noms, dates ni identificadors de dispositiu; conté moviment i freqüència cardíaca cada 30 s, com et vas sentir i les teves notes."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pomoz zlepšit rozpoznávání: CSV bez jmen, dat a ID zařízení; obsahuje pohyb a tep po 30 s, jak ses cítil a tvoje poznámky."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hjælp med at forbedre registreringen: CSV uden navne, datoer eller enheds-id’er; indeholder bevægelse og puls pr. 30 s, hvordan du havde det, og dine noter."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hilf mit, die Erkennung zu verbessern: CSV ohne Namen, Datum oder Gerätekennung; enthält Bewegung und Puls je 30 s, Befinden und deine Notizen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Βοήθησε να βελτιωθεί η ανίχνευση: CSV χωρίς ονόματα, ημερομηνίες ή αναγνωριστικά συσκευής· περιέχει κίνηση και παλμούς ανά 30 s, πώς ένιωθες και τις σημειώσεις σου."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Help improve detection: CSV without names, dates or device IDs; contains motion and heart rate per 30 s, how you felt and your notes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayuda a mejorar la detección: CSV sin nombres, fechas ni identificadores de dispositivo; contiene movimiento y frecuencia cardíaca cada 30 s, cómo te sentiste y tus notas."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Aita tuvastamist parandada: CSV ilma nimede, kuupäevade ja seadme-ID-deta; sisaldab liikumist ja pulssi iga 30 s kohta, sinu enesetunnet ja märkmeid."
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "Lagundu detekzioa hobetzen: CSVa izenik, datarik eta gailu-IDrik gabe; 30 s-ko mugimendua eta bihotz-maiztasuna, nola sentitu zinen eta zure oharrak ditu."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "به بهتر شدن تشخیص کمک کن: CSV بدون نام، تاریخ یا شناسهٔ دستگاه؛ شامل حرکت و ضربان قلب هر ۳۰ ثانیه، حالت تو و یادداشت‌هایت."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Auta parantamaan tunnistusta: CSV ilman nimiä, päivämääriä tai laitetunnuksia; sisältää liikkeen ja sykkeen 30 s välein, vointisi ja muistiinpanosi."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Tumulong na pahusayin ang pagtukoy: CSV na walang pangalan, petsa o ID ng device; may galaw at heart rate bawat 30 s, ang pakiramdam mo at ang mga tala mo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aide à améliorer la détection : CSV sans nom, date ni identifiant d’appareil ; contient les mouvements et la fréquence cardiaque toutes les 30 s, ton ressenti et tes notes."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuidigh leis an mbrath a fheabhsú: CSV gan ainmneacha, dátaí ná aitheantais gléis; tá gluaiseacht agus ráta croí in aghaidh 30 s, conas a mhothaigh tú agus do nótaí ann."
          }
        },
        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "Axuda a mellorar a detección: CSV sen nomes, datas nin identificadores do dispositivo; contén movemento e pulso cada 30 s, como te sentiches e as túas notas."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ઓળખ સુધારવામાં મદદ કરો: નામ, તારીખ કે ઉપકરણ ID વિનાની CSV; તેમાં દર 30 સેકન્ડનું હલનચલન અને હૃદયના ધબકારા, તમને કેવું લાગ્યું અને તમારી નોંધો છે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "עזרו לשפר את הזיהוי: CSV ללא שמות, תאריכים או מזהי מכשירים; מכיל תנועה ודופק לכל 30 שניות, איך הרגשתם וההערות שלכם."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पहचान बेहतर बनाने में मदद करो: नाम, तारीख या डिवाइस ID के बिना CSV; इसमें हर 30 सेकंड की गतिविधि और हृदय गति, तुम्हें कैसा लगा और तुम्हारे नोट्स हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pomozi poboljšati prepoznavanje: CSV bez imena, datuma i ID-ova uređaja; sadrži pokret i puls svakih 30 s, kako si se osjećao i tvoje bilješke."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Segíts javítani a felismerést: CSV nevek, dátumok és eszközazonosítók nélkül; 30 másodpercenkénti mozgást és pulzust, a közérzetedet és a jegyzeteidet tartalmazza."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Օգնիր բարելավել ճանաչումը՝ CSV առանց անունների, ամսաթվերի կամ սարքի ID-ների․ պարունակում է շարժումն ու զարկերը յուրաքանչյուր 30 վրկ-ում, ինքնազգացողությունդ և նշումներդ։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Bantu tingkatkan deteksi: CSV tanpa nama, tanggal, atau ID perangkat; berisi gerakan dan detak jantung per 30 detik, perasaanmu, dan catatanmu."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Hjálpaðu til við að bæta greininguna: CSV án nafna, dagsetninga eða auðkenna tækja; inniheldur hreyfingu og púls á 30 s fresti, líðan þína og glósurnar þínar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aiuta a migliorare il rilevamento: CSV senza nomi, date o ID dei dispositivi; contiene movimento e battito ogni 30 s, come ti sentivi e le tue note."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "検出の改善に協力：名前・日付・デバイス ID を含まない CSV。30 秒ごとの体動と心拍、気分、メモを含みます。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "დაგვეხმარე ამოცნობის გაუმჯობესებაში: CSV სახელების, თარიღების და მოწყობილობის ID-ების გარეშე; შეიცავს მოძრაობასა და პულსს ყოველ 30 წმ-ში, შენს თვითგრძნობასა და ჩანაწერებს."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Анықтауды жақсартуға көмектес: аты, күні немесе құрылғы ID-і жоқ CSV; әр 30 с сайынғы қозғалыс пен пульс, көңіл күйің және жазбаларың бар."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ជួយកែលម្អការរកឃើញ៖ CSV គ្មានឈ្មោះ កាលបរិច្ឆេទ ឬ ID ឧបករណ៍ទេ។ វាមានចលនា និងចង្វាក់បេះដូងរៀងរាល់ 30 វិនាទី អារម្មណ៍របស់អ្នក និងកំណត់ចំណាំរបស់អ្នក។"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಗುರುತಿಸುವಿಕೆ ಸುಧಾರಿಸಲು ಸಹಾಯ ಮಾಡಿ: ಹೆಸರು, ದಿನಾಂಕ ಅಥವಾ ಸಾಧನ ID ಇಲ್ಲದ CSV; ಪ್ರತಿ 30 ಸೆ. ಚಲನೆ ಮತ್ತು ಹೃದಯ ಬಡಿತ, ನಿಮಗೆ ಹೇಗನಿಸಿತು ಮತ್ತು ನಿಮ್ಮ ಟಿಪ್ಪಣಿಗಳನ್ನು ಒಳಗೊಂಡಿದೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "감지 개선에 도움 주기: 이름, 날짜, 기기 ID가 없는 CSV이며, 30초마다의 움직임과 심박수, 컨디션, 메모가 포함됩니다."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ຊ່ວຍປັບປຸງການກວດຈັບ: CSV ທີ່ບໍ່ມີຊື່, ວັນທີ ຫຼື ID ອຸປະກອນ; ມີການເຄື່ອນໄຫວ ແລະ ອັດຕາການເຕັ້ນຂອງຫົວໃຈທຸກ 30 ວິນາທີ, ຄວາມຮູ້ສຶກຂອງເຈົ້າ ແລະ ບັນທຶກຂອງເຈົ້າ."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Padėk tobulinti atpažinimą: CSV be vardų, datų ir įrenginių ID; jame yra judėjimas ir pulsas kas 30 s, tavo savijauta ir užrašai."
          }
