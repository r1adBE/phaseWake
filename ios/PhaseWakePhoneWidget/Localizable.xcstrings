    "settings_clear_history_also": {
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Notas, gevoel, aandroetine-merkies en klankgrepe word ook uitgevee."
          }
        },
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "ማስታወሻዎች፣ ስሜት፣ የምሽት ልማድ ምልክቶች እና የድምፅ ቅንጥቦችም ይሰረዛሉ።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُحذف أيضًا الملاحظات والشعور وعلامات روتين المساء ومقاطع الأصوات."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Qeydlər, əhval, axşam rutini işarələri və səs parçaları da silinir."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Изтриват се и бележките, усещането, отметките от вечерната рутина и звуковите откъси."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "নোট, অনুভূতি, সন্ধ্যার রুটিনের টিক আর শব্দের ক্লিপও মুছে যাবে।"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Brišu se i bilješke, osjećaj, kvačice večernje rutine i zvučni isječci."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "També s’esborren les notes, l’estat, les marques de la rutina del vespre i els fragments de so."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Smažou se i poznámky, pocit, zaškrtnutí večerní rutiny a zvukové úryvky."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Noter, følelse, flueben i aftenrutinen og lydklip slettes også."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auch Notizen, Befinden, Haken der Abendroutine und Geräusch-Ausschnitte werden gelöscht."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Διαγράφονται επίσης σημειώσεις, αίσθηση, σημάδια της βραδινής ρουτίνας και αποσπάσματα ήχου."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notes, how you felt, evening routine ticks and sound clips are deleted too."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "También se eliminan las notas, la sensación, las marcas de la rutina nocturna y los fragmentos de sonido."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kustutatakse ka märkmed, enesetunne, õhturutiini linnukesed ja helilõigud."
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "Oharrak, sentipena, gaueko errutinaren markak eta soinu-zatiak ere ezabatzen dira."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "یادداشت‌ها، حس، تیک‌های روال شب و تکه‌های صدا هم حذف می‌شوند."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Myös muistiinpanot, olo, iltarutiinin rastit ja äänileikkeet poistetaan."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Mabubura rin ang mga tala, pakiramdam, tsek sa routine sa gabi at mga sound clip."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les notes, le ressenti, les coches de la routine du soir et les extraits sonores sont aussi supprimés."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Scriostar nótaí, mothú, ticeanna an ghnáthaimh tráthnóna agus gearrthóga fuaime freisin."
          }
        },
        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tamén se eliminan as notas, o estado, as marcas da rutina nocturna e os fragmentos de son."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "નોંધો, મૂડ, સાંજની દિનચર્યાના ટિક અને અવાજની ક્લિપ પણ કાઢી નખાય છે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "גם הערות, תחושה, סימונים בשגרת הערב וקטעי קול נמחקים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नोट्स, एहसास, शाम की दिनचर्या के टिक और आवाज़ के अंश भी हट जाते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Brišu se i bilješke, osjećaj, kvačice večernje rutine i zvučni isječci."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A jegyzetek, az érzés, az esti rutin pipái és a hangrészletek is törlődnek."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ջնջվում են նաև նշումները, ինքնազգացումը, երեկոյան ծեսի նշիչները և ձայնային հատվածները։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Catatan, perasaan, centang rutinitas malam, dan potongan suara juga dihapus."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Athugasemdir, líðan, hök í kvöldrútínu og hljóðbútar eyðast líka."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Vengono eliminati anche note, sensazione, spunte della routine serale e clip audio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メモ、気分、夜のルーティンのチェック、音のクリップも削除されます。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "იშლება ჩანაწერები, თვითგრძნობა, საღამოს რუტინის მონიშვნები და ხმის ფრაგმენტებიც."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Жазбалар, көңіл-күй, кешкі рәсім белгілері және дыбыс үзінділері де жойылады."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "កំណត់ចំណាំ អារម្មណ៍ សញ្ញាធីកនៃទម្លាប់ពេលល្ងាច និងឃ្លីបសំឡេងក៏ត្រូវលុបដែរ។"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಟಿಪ್ಪಣಿಗಳು, ಅನಿಸಿಕೆ, ಸಂಜೆಯ ದಿನಚರಿಯ ಟಿಕ್‌ಗಳು ಮತ್ತು ಶಬ್ದದ ತುಣುಕುಗಳೂ ಅಳಿಸಲ್ಪಡುತ್ತವೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "메모, 기분, 저녁 루틴 체크, 소리 클립도 함께 삭제돼요."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ບັນທຶກ, ຄວາມຮູ້ສຶກ, ເຄື່ອງໝາຍກິດຈະວັດຕອນແລງ ແລະ ຄລິບສຽງກໍຖືກລຶບນຳ."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Taip pat ištrinamos pastabos, savijauta, vakaro ritualo varnelės ir garso ištraukos."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiek dzēstas arī piezīmes, pašsajūta, vakara rituāla atzīmes un skaņu fragmenti."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Се бришат и белешките, чувството, ознаките од вечерната рутина и звучните исечоци."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "കുറിപ്പുകൾ, അനുഭവം, വൈകുന്നേരത്തെ ദിനചര്യയിലെ ടിക്കുകൾ, ശബ്ദ ക്ലിപ്പുകൾ എന്നിവയും ഇല്ലാതാകും."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Тэмдэглэл, мэдрэмж, оройн дэглэмийн тэмдэг, дууны хэсгүүд мөн устгагдана."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "नोंदी, मूड, संध्याकाळच्या दिनक्रमाच्या खुणा आणि आवाजाच्या क्लिप्सही हटतात."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Nota, perasaan, tanda rutin malam dan klip bunyi juga dipadam."
          }
        },
        "my": {
          "stringUnit": {
            "state": "translated",
            "value": "မှတ်စုများ၊ ခံစားမှု၊ ညနေ လုပ်ရိုးလုပ်စဉ် အမှတ်အသားများနှင့် အသံအပိုင်းများကိုလည်း ဖျက်မည်။"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Notater, følelse, haker i kveldsrutinen og lydklipp slettes også."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "टिपोट, अनुभूति, साँझको दिनचर्याका चिनो र आवाजका अंश पनि मेटिन्छन्।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ook notities, gevoel, vinkjes van de avondroutine en geluidsfragmenten worden verwijderd."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਨੋਟ, ਮੂਡ, ਸ਼ਾਮ ਦੀ ਰੁਟੀਨ ਦੇ ਨਿਸ਼ਾਨ ਅਤੇ ਆਵਾਜ਼ ਦੀਆਂ ਕਲਿੱਪਾਂ ਵੀ ਮਿਟ ਜਾਂਦੀਆਂ ਹਨ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Usuwane są też notatki, samopoczucie, odhaczenia wieczornej rutyny i fragmenty dźwięków."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Notas, sensação, marcações da rotina da noite e trechos de som também são excluídos."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Notas, sensação, marcações da rotina da noite e excertos de som também são eliminados."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Se șterg și notițele, starea, bifele rutinei de seară și fragmentele de sunet."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Также удаляются заметки, самочувствие, отметки вечернего ритуала и фрагменты звуков."
          }
        },
        "si": {
          "stringUnit": {
            "state": "translated",
            "value": "සටහන්, හැඟීම, සවස් චර්යාවේ ලකුණු සහ ශබ්ද කොටස් ද මැකේ."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Odstránia sa aj poznámky, pocit, zaškrtnutia večernej rutiny a zvukové úryvky."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Izbrišejo se tudi zapiski, počutje, kljukice večerne rutine in zvočni izseki."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Fshihen edhe shënimet, gjendja, shenjat e rutinës së mbrëmjes dhe copat e tingujve."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Бришу се и белешке, осећај, ознаке вечерње рутине и звучни исечци."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Anteckningar, känsla, bockar i kvällsrutinen och ljudklipp tas också bort."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Madokezo, hali, alama za ratiba ya jioni na vipande vya sauti pia vinafutwa."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "குறிப்புகள், உணர்வு, மாலை வழக்கத்தின் குறிகள் மற்றும் ஒலித் துணுக்குகளும் நீக்கப்படும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "గమనికలు, మూడ్, సాయంత్రపు దినచర్య టిక్‌లు, ధ్వని క్లిప్‌లు కూడా తొలగించబడతాయి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บันทึก ความรู้สึก เครื่องหมายกิจวัตรตอนเย็น และคลิปเสียงจะถูกลบด้วย"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Notlar, hissediş, akşam rutini işaretleri ve ses parçaları da silinir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Також видаляються нотатки, самопочуття, позначки вечірнього ритуалу й фрагменти звуків."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "نوٹس، کیفیت، شام کے معمول کے نشان اور آواز کے کلپس بھی حذف ہو جاتے ہیں۔"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Qaydlar, kayfiyat, kechki odat belgilari va tovush parchalari ham oʻchiriladi."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ghi chú, cảm giác, dấu tích thói quen buổi tối và đoạn âm thanh cũng bị xóa."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "筆記、感覺、晚間習慣的剔選和聲音片段亦會一併刪除。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "笔记、感觉、晚间习惯的勾选和声音片段也会一并删除。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "筆記、感覺、晚間習慣的勾選和聲音片段也會一併刪除。"
          }
        },
        "zu": {
          "stringUnit": {
            "state": "translated",
            "value": "Amanothi, umuzwa, amamaki enqubo yakusihlwa nezingcezu zemisindo nakho kuyasuswa."
          }
        }
      }
    },
