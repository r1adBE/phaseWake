        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Semuanya kekal pada telefon dan jam tangan. Tiada akaun, tiada pelayan, tiada penjejakan."
          }
        },
        "my": {
          "stringUnit": {
            "state": "translated",
            "value": "အားလုံး သင့်ဖုန်းနှင့် နာရီပေါ်တွင်သာ ရှိသည်။ အကောင့်မလို၊ ဆာဗာမရှိ၊ ခြေရာခံခြင်းမရှိ။"
