            "value": "Začni fazo učenja"
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Nis fazën e të mësuarit"
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Покрени фазу учења"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Starta inlärningsfas"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Anza hatua ya kujifunza"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "கற்றல் நிலையைத் தொடங்கு"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "నేర్చుకునే దశను ప్రారంభించు"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เริ่มช่วงเรียนรู้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Öğrenme aşamasını başlat"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Почати етап навчання"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "سیکھنے کا مرحلہ شروع کریں"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "O‘rganish bosqichini boshlash"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bắt đầu giai đoạn học"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "開始學習階段"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开始学习阶段"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開始學習階段"
          }
        },
        "zu": {
