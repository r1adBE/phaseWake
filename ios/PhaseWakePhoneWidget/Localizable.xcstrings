        "si": {
          "stringUnit": {
            "state": "translated",
            "value": "පටිගත කිරීමට Phase Wake හට මයික්‍රෆෝනය අවශ්‍යයි. එය සවන් දෙන්නේ පටිගත කිරීම සක්‍රිය විට පමණි."
