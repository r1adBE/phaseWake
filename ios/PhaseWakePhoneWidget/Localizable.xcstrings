    "companion_failed": {
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen horlosie gevind nie. Kyk of dit gekoppel is en Bluetooth aan is, en probeer weer."
          }
        },
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "ምንም ሰዓት አልተገኘም። መገናኘቱንና ብሉቱዝ መብራቱን ያረጋግጡ፣ ከዚያ እንደገና ይሞክሩ።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يتم العثور على ساعة. تأكد من أنها متصلة وأن البلوتوث مفعّل، ثم حاول مرة أخرى."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Saat tapılmadı. Qoşulduğunu və Bluetooth-un açıq olduğunu yoxla, sonra yenidən cəhd et."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Не е намерен часовник. Провери дали е свързан и Bluetooth е включен, после опитай отново."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কোনো ঘড়ি পাওয়া যায়নি। ঘড়ি সংযুক্ত আছে আর ব্লুটুথ চালু আছে কিনা দেখো, তারপর আবার চেষ্টা করো।"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Sat nije pronađen. Provjeri je li povezan i je li Bluetooth uključen, pa pokušaj ponovo."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "No s’ha trobat cap rellotge. Comprova que estigui connectat i que el Bluetooth estigui activat, i torna-ho a provar."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Hodinky nenalezeny. Zkontroluj, že jsou připojené a Bluetooth je zapnutý, a zkus to znovu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Intet ur fundet. Tjek, at det er forbundet, og at Bluetooth er slået til, og prøv igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Uhr gefunden. Prüfe, ob sie verbunden und Bluetooth an ist, und versuch es noch einmal."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν βρέθηκε ρολόι. Έλεγξε ότι είναι συνδεδεμένο και ότι το Bluetooth είναι ενεργό και δοκίμασε ξανά."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No watch found. Check that it's connected and Bluetooth is on, then try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se encontró ningún reloj. Comprueba que esté conectado y que el Bluetooth esté activado, y vuelve a intentarlo."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kella ei leitud. Kontrolli, et see on ühendatud ja Bluetooth on sees, ning proovi uuesti."
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez da erlojurik aurkitu. Egiaztatu konektatuta dagoela eta Bluetootha aktibatuta dagoela, eta saiatu berriro."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "ساعتی پیدا نشد. بررسی کن که متصل باشد و بلوتوث روشن باشد، بعد دوباره امتحان کن."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kelloa ei löytynyt. Tarkista, että se on yhdistetty ja Bluetooth on päällä, ja yritä uudelleen."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Walang nakitang relo. Tingnan kung nakakonekta ito at naka-on ang Bluetooth, saka subukan ulit."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune montre trouvée. Vérifie qu’elle est connectée et que le Bluetooth est activé, puis réessaie."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Níor aimsíodh uaireadóir. Seiceáil go bhfuil sé ceangailte agus Bluetooth air, agus bain triail eile as."
          }
        },
        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "Non se atopou ningún reloxo. Comproba que estea conectado e que o Bluetooth estea activado, e téntao de novo."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "કોઈ ઘડિયાળ મળી નથી. તે કનેક્ટ છે અને બ્લૂટૂથ ચાલુ છે કે નહીં તે તપાસો, પછી ફરી પ્રયાસ કરો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא נמצא שעון. בדקו שהוא מחובר ושה-Bluetooth פועל, ונסו שוב."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कोई वॉच नहीं मिली। देखें कि वह जुड़ी है और ब्लूटूथ चालू है, फिर दोबारा कोशिश करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sat nije pronađen. Provjeri je li povezan i je li Bluetooth uključen pa pokušaj ponovno."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nem található óra. Ellenőrizd, hogy csatlakoztatva van-e és be van-e kapcsolva a Bluetooth, majd próbáld újra."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ժամացույց չի գտնվել։ Ստուգիր, որ այն միացված է, և Bluetooth-ը միացված է, ապա նորից փորձիր։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jam tangan tidak ditemukan. Periksa apakah sudah terhubung dan Bluetooth aktif, lalu coba lagi."
