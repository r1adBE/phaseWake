    "editor_window_exact_hint": {
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Lui presies op teikentyd, nooit vroeër nie. Jou horlosie meet steeds vir jou geskiedenis."
          }
        },
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "በትክክል በታለመው ሰዓት ይደውላል፣ ፈጽሞ ቀደም ብሎ አይደለም። ሰዓትዎ ለታሪክዎ አሁንም ይለካል።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يرنّ في الموعد المحدد تمامًا، لا قبله أبدًا. ومع ذلك تقيس ساعتك من أجل سجلّك."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Düz hədəf vaxtında zəng çalır, heç vaxt tez yox. Saatın yenə də tarixçən üçün ölçür."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Звъни точно в целевия час, никога по-рано. Часовникът ти пак мери за историята."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ঠিক লক্ষ্য সময়ে বাজবে, কখনো আগে নয়। তোমার ঘড়ি তবুও তোমার ইতিহাসের জন্য মাপবে।"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zvoni tačno u ciljno vrijeme, nikad ranije. Sat i dalje mjeri za tvoju historiju."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Sona just a l’hora objectiu, mai abans. El rellotge continua mesurant per al teu historial."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zazvoní přesně v cílový čas, nikdy dřív. Hodinky přesto měří pro tvou historii."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ringer præcis på ønsket tid, aldrig før. Dit ur måler stadig til din historik."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Klingelt genau zur Zielzeit, nie früher. Die Uhr misst trotzdem für den Verlauf."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Χτυπά ακριβώς στην ώρα στόχου, ποτέ νωρίτερα. Το ρολόι σου μετρά ακόμη για το ιστορικό σου."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rings exactly at the target time, never earlier. Your watch still measures for your history."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Suena justo a la hora objetivo, nunca antes. Tu reloj sigue midiendo para tu historial."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Heliseb täpselt sihtajal, mitte kunagi varem. Kell mõõdab ikkagi sinu ajaloo jaoks."
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "Helburuko orduan bertan joko du, inoiz ez lehenago. Erlojuak zure historialerako neurtzen jarraitzen du."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "دقیقاً در زمان هدف زنگ می‌زند، هرگز زودتر. ساعتت همچنان برای سابقه‌ات اندازه می‌گیرد."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Soi täsmälleen tavoiteaikana, ei koskaan aiemmin. Kello mittaa silti historiaasi varten."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutunog eksakto sa target na oras, hindi kailanman mas maaga. Sumusukat pa rin ang relo mo para sa iyong history."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sonne pile à l’heure cible, jamais avant. Ta montre mesure quand même pour ton historique."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Buailfidh sé díreach ag an spriocam, riamh níos luaithe. Tomhaiseann d’uaireadóir fós do do stair."
          }
        },
        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "Soa xusto á hora prevista, nunca antes. O reloxo segue medindo para o teu historial."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "બરાબર લક્ષ્ય સમયે વાગશે, ક્યારેય વહેલું નહીં. તમારી ઘડિયાળ તેમ છતાં તમારા ઇતિહાસ માટે માપે છે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מצלצל בדיוק בשעת היעד, אף פעם לא מוקדם יותר. השעון עדיין מודד עבור ההיסטוריה שלכם."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ठीक लक्ष्य समय पर बजेगा, कभी पहले नहीं। तुम्हारी वॉच फिर भी तुम्हारे इतिहास के लिए मापती है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zvoni točno u ciljno vrijeme, nikad ranije. Sat i dalje mjeri za tvoju povijest."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Pontosan célidőben szól, sosem korábban. Az órád ettől még mér az előzményeidhez."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Զանգում է ճիշտ նպատակային ժամին, երբեք ավելի շուտ։ Ժամացույցդ միևնույն է չափում է պատմությանդ համար։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Berbunyi tepat pada waktu target, tidak pernah lebih awal. Jam tanganmu tetap mengukur untuk riwayatmu."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Hringir nákvæmlega á markmiðstíma, aldrei fyrr. Úrið mælir samt fyrir ferilinn þinn."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Suona esattamente all’orario obiettivo, mai prima. L’orologio misura comunque per la tua cronologia."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "目標時刻ちょうどに鳴り、早まることはありません。記録のための計測はウォッチが続けます。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "რეკავს ზუსტად სამიზნე დროს, არასდროს ადრე. საათი მაინც ზომავს შენი ისტორიისთვის."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дәл мақсатты уақытта шырылдайды, ешқашан ертерек емес. Сағат бәрібір тарихың үшін өлшейді."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "រោទ៍ត្រូវម៉ោងគោលដៅពិតប្រាកដ មិនដែលមុនទេ។ នាឡិការបស់អ្នកនៅតែវាស់សម្រាប់ប្រវត្តិរបស់អ្នក។"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಸರಿಯಾಗಿ ಗುರಿ ಸಮಯದಲ್ಲಿ ಬಾರಿಸುತ್ತದೆ, ಎಂದಿಗೂ ಮುಂಚೆ ಅಲ್ಲ. ನಿಮ್ಮ ವಾಚ್ ಆದರೂ ನಿಮ್ಮ ಇತಿಹಾಸಕ್ಕಾಗಿ ಅಳೆಯುತ್ತದೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "목표 시간에 정확히 울리고, 더 일찍 울리지 않아요. 워치는 기록을 위해 계속 측정해요."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ດັງຕົງເວລາເປົ້າໝາຍພໍດີ ບໍ່ເຄີຍກ່ອນ. ໂມງຂອງເຈົ້າຍັງວັດແທກເພື່ອປະຫວັດຂອງເຈົ້າ."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Skamba tiksliai tiksliniu laiku, niekada anksčiau. Laikrodis vis tiek matuoja tavo istorijai."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Zvana tieši mērķa laikā, nekad agrāk. Pulkstenis tik un tā mēra tavai vēsturei."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ѕвони точно во целното време, никогаш порано. Часовникот сепак мери за твојата историја."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "കൃത്യമായി ലക്ഷ്യസമയത്ത് മുഴങ്ങും, ഒരിക്കലും നേരത്തേയല്ല. നിങ്ങളുടെ വാച്ച് എന്നിട്ടും ചരിത്രത്തിനായി അളക്കും."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Яг зорилтот цагт дуугарна, хэзээ ч эрт биш. Цаг чинь түүхэнд чинь зориулж хэмжсээр байна."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "अगदी लक्ष्य वेळेवर वाजेल, कधीही आधी नाही. तुमचे घड्याळ तरीही तुमच्या इतिहासासाठी मोजते."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Berbunyi tepat pada masa sasaran, tidak pernah lebih awal. Jam tangan awak tetap mengukur untuk sejarah awak."
          }
        },
        "my": {
          "stringUnit": {
            "state": "translated",
            "value": "ပစ်မှတ်အချိန်တိတိတွင် မြည်မည်၊ ဘယ်တော့မှ စောမည်မဟုတ်။ သင့်နာရီသည် မှတ်တမ်းအတွက် ဆက်လက်တိုင်းတာမည်။"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ringer nøyaktig på ønsket tid, aldri før. Klokken måler likevel for historikken din."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "ठ्याक्कै लक्षित समयमा बज्छ, कहिल्यै अघि होइन। तिम्रो घडीले तैपनि तिम्रो इतिहासका लागि नाप्छ।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gaat precies op de doeltijd af, nooit eerder. Je horloge meet toch voor je geschiedenis."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਬਿਲਕੁਲ ਟੀਚੇ ਦੇ ਸਮੇਂ ’ਤੇ ਵੱਜੇਗਾ, ਕਦੇ ਪਹਿਲਾਂ ਨਹੀਂ। ਤੁਹਾਡੀ ਘੜੀ ਫਿਰ ਵੀ ਤੁਹਾਡੇ ਇਤਿਹਾਸ ਲਈ ਮਾਪਦੀ ਹੈ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dzwoni dokładnie o czasie docelowym, nigdy wcześniej. Zegarek i tak mierzy na potrzeby twojej historii."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca exatamente no horário-alvo, nunca antes. Seu relógio continua medindo para o seu histórico."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca exatamente à hora-alvo, nunca antes. O relógio continua a medir para o teu histórico."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Sună exact la ora țintă, niciodată mai devreme. Ceasul măsoară totuși pentru istoricul tău."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Звонит точно в целевое время, никогда раньше. Часы всё равно измеряют для твоей истории."
          }
        },
        "si": {
          "stringUnit": {
            "state": "translated",
            "value": "හරියටම ඉලක්ක වේලාවට නාද වේ, කිසිදා කලින් නොවේ. ඔබේ ඔරලෝසුව තවමත් ඔබේ ඉතිහාසය සඳහා මනිනවා."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zazvoní presne v cieľový čas, nikdy skôr. Hodinky aj tak merajú pre tvoju históriu."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zazvoni natanko ob ciljnem času, nikoli prej. Ura vseeno meri za tvojo zgodovino."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Bie saktësisht në orën e synuar, kurrë më herët. Ora jote vazhdon të masë për historikun tënd."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Звони тачно у циљно време, никад раније. Сат ипак мери за твоју историју."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ringer precis vid önskad tid, aldrig tidigare. Klockan mäter ändå för din historik."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Inalia hasa kwa muda lengwa, kamwe mapema. Saa yako bado inapima kwa ajili ya historia yako."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "சரியாக இலக்கு நேரத்தில் ஒலிக்கும், ஒருபோதும் முன்பு அல்ல. உங்கள் வாட்ச் இருந்தாலும் உங்கள் வரலாற்றுக்காக அளவிடும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "సరిగ్గా లక్ష్య సమయానికి మోగుతుంది, ఎప్పుడూ ముందు కాదు. మీ వాచ్ అయినా మీ చరిత్ర కోసం కొలుస్తుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ดังตรงเวลาเป้าหมายพอดี ไม่ก่อนเวลาเลย นาฬิกายังคงวัดเพื่อประวัติของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tam hedef saatte çalar, asla daha erken değil. Saatin yine de geçmişin için ölçer."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дзвонить точно в цільовий час, ніколи раніше. Годинник однаково вимірює для твоєї історії."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "عین ہدف کے وقت پر بجے گا، کبھی پہلے نہیں۔ تمہاری گھڑی پھر بھی تمہاری ہسٹری کے لیے پیمائش کرتی ہے۔"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Aynan belgilangan vaqtda jiringlaydi, hech qachon erta emas. Soating baribir tarixing uchun oʻlchaydi."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Reo đúng giờ mục tiêu, không bao giờ sớm hơn. Đồng hồ vẫn đo để lưu vào lịch sử của bạn."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "準時於目標時間響鬧，絕不提早。手錶仍會為你的記錄進行量度。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
