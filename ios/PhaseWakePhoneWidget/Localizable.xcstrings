        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ರೆಕಾರ್ಡಿಂಗ್ ಆನ್ ಆಗಿದೆ. ರಾತ್ರಿಗೆ ಫೋನ್ ಅನ್ನು ಚಾರ್ಜರ್‌ಗೆ ಹಾಕುವುದು ಒಳ್ಳೆಯದು."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "녹음 중이에요. 밤새 휴대폰을 충전기에 연결해 두는 게 좋아요."
