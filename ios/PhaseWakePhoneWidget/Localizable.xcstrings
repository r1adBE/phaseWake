        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Бүх зүйл утас, цаган дээр чинь үлдэнэ. Бүртгэлгүй, сервергүй, хянахгүй."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "सगळं तुमच्या फोनवर आणि घड्याळावरच राहतं. खातं नाही, सर्व्हर नाही, ट्रॅकिंग नाही."
