        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Alarm susmadan önce 3 işlem çöz. Erteleme işlemsiz çalışır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Розв’яжи 3 приклади, перш ніж будильник замовкне. Відкласти можна без прикладу."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "الارم خاموش ہونے سے پہلے 3 جمع کے سوال حل کرو۔ اسنوز بغیر سوال کے ہو جاتا ہے۔"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Budilnik jim boʻlishi uchun 3 ta misol yech. Kechiktirish masalasiz ishlaydi."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giải 3 phép cộng trước khi báo thức im. Báo lại không cần giải."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "解答 3 道加數題，鬧鐘才會停止。貪睡不用答題。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "闹钟停止前要解 3 道加法题。贪睡无需答题。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "鬧鐘停止前要解 3 道加法題。貪睡無需答題。"
          }
        },
        "zu": {
          "stringUnit": {
            "state": "translated",
            "value": "Xazulula izibalo ezi-3 ngaphambi kokuthi i-alamu ithule. Ukusnuza kusebenza ngaphandle komsebenzi."
          }
        }
      }
    },
