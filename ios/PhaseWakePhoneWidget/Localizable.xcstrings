    "editor_advice_text|few": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "في %1$lld من آخر %2$lld ليالٍ لم تظهر لحظة مناسبة ضمن النافذة. مع %3$lld دقيقة تزداد فرص الاستيقاظ في لحظة مناسبة."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "U %1$lld od posljednje %2$lld noći u intervalu nije bilo dobrog trenutka. S %3$lld min češće ćeš se probuditi u dobrom trenutku."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "V %1$lld z posledních %2$lld nocí se v okně neobjevila žádná vhodná chvíle. S %3$lld min se budeš častěji budit ve vhodnou chvíli."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Ní raibh nóiméad maith san fhuinneog i %1$lld as na %2$lld oíche dheireanacha. Le %3$lld nóim, is minice a dhúiseoidh tú ag nóiméad maith."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "U %1$lld od posljednje %2$lld noći u intervalu nije bilo dobrog trenutka. S %3$lld min češće ćeš se probuditi u dobrom trenutku."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Per %1$lld iš paskutinių %2$lld naktų lange nebuvo tinkamo momento. Su %3$lld min dažniau pabusi tinkamu metu."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "W %1$lld z ostatnich %2$lld nocy w oknie nie było dobrego momentu. Przy %3$lld min częściej obudzisz się w dobrym momencie."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "În %1$lld din ultimele %2$lld nopți nu a fost niciun moment bun în fereastră. Cu %3$lld min te vei trezi mai des într-un moment bun."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В %1$lld из последних %2$lld ночей в окне не было удачного момента. С %3$lld мин ты чаще будешь просыпаться в удачный момент."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "V %1$lld z posledných %2$lld nocí nebola v okne vhodná chvíľa. S %3$lld min ťa budík častejšie zobudí v dobrej chvíli."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "V %1$lld od zadnjih %2$lld noči v oknu ni bilo pravega trenutka. S %3$lld min te bo ura pogosteje zbudila ob pravem trenutku."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "У %1$lld од последње %2$lld ноћи у интервалу није било доброг тренутка. Са %3$lld мин чешће ћеш се будити у добром тренутку."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "У %1$lld з останніх %2$lld ночей у вікні не було слушного моменту. З %3$lld хв ти частіше прокидатимешся у слушний момент."
          }
        }
      }
    },
    "editor_advice_text|many": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "في %1$lld من آخر %2$lld ليلة لم تظهر لحظة مناسبة ضمن النافذة. مع %3$lld دقيقة تزداد فرص الاستيقاظ في لحظة مناسبة."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "En %1$lld de les últimes %2$lld nits no hi va haver cap bon moment a la finestra. Amb %3$lld min et despertaràs més sovint en un bon moment."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "V %1$lld z posledních %2$lld nocí se v okně neobjevila žádná vhodná chvíle. S %3$lld min se budeš častěji budit ve vhodnou chvíli."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En %1$lld de las últimas %2$lld noches no hubo un buen momento dentro de la ventana. Con %3$lld min te despertarás más a menudo en un buen momento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dans %1$lld des %2$lld dernières nuits, il n’y avait pas de bon moment dans la fenêtre. Avec %3$lld min, tu te réveilleras plus souvent au bon moment."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Ní raibh nóiméad maith san fhuinneog i %1$lld as na %2$lld n-oíche dheireanacha. Le %3$lld nóim, is minice a dhúiseoidh tú ag nóiméad maith."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In %1$lld delle ultime %2$lld notti non c’era un momento giusto nella finestra. Con %3$lld min ti sveglierai più spesso al momento giusto."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Per %1$lld iš paskutinių %2$lld nakties lange nebuvo tinkamo momento. Su %3$lld min dažniau pabusi tinkamu metu."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "W %1$lld z ostatnich %2$lld nocy w oknie nie było dobrego momentu. Przy %3$lld min częściej obudzisz się w dobrym momencie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Em %1$lld das últimas %2$lld noites não houve um bom momento na janela. Com %3$lld min, você vai acordar mais vezes num bom momento."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Em %1$lld das últimas %2$lld noites não houve um bom momento na janela. Com %3$lld min, vais acordar mais vezes num bom momento."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В %1$lld из последних %2$lld ночей в окне не было удачного момента. С %3$lld мин ты чаще будешь просыпаться в удачный момент."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "V %1$lld z posledných %2$lld noci nebola v okne vhodná chvíľa. S %3$lld min ťa budík častejšie zobudí v dobrej chvíli."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "У %1$lld з останніх %2$lld ночей у вікні не було слушного моменту. З %3$lld хв ти частіше прокидатимешся у слушний момент."
          }
        }
      }
    },
    "editor_advice_text|one": {
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "In %1$lld van die laaste %2$lld nag was daar geen goeie oomblik in die venster nie. Met %3$lld min word jy meer dikwels op ’n goeie oomblik wakker."
          }
        },
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "ካለፉት %2$lld ሌሊት ውስጥ በ%1$lld ሌሊት በክልሉ ውስጥ ጥሩ ቅጽበት አልነበረም። በ%3$lld ደቂቃ ብዙ ጊዜ በጥሩ ቅጽበት ይነቃሉ።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "في %1$lld من آخر %2$lld ليلة لم تظهر لحظة مناسبة ضمن النافذة. مع %3$lld دقيقة تزداد فرص الاستيقاظ في لحظة مناسبة."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Son %2$lld gecənin %1$lld gecəsində pəncərədə doğru an olmayıb. %3$lld dəq ilə daha tez-tez doğru anda oyanacaqsan."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "В %1$lld от последната %2$lld нощ нямаше добър момент в прозореца. С %3$lld мин по-често ще се будиш в добър момент."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "গত %2$lldটি রাতের %1$lldটিতে সময়সীমার মধ্যে ভালো মুহূর্ত ছিল না। %3$lld মি. নিলে আরও প্রায়ই ভালো মুহূর্তে জাগবে।"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "U %1$lld od posljednje %2$lld noći u intervalu nije bilo dobrog trenutka. S %3$lld min češće ćeš se probuditi u dobrom trenutku."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "En %1$lld de l’última %2$lld nit no hi va haver cap bon moment a la finestra. Amb %3$lld min et despertaràs més sovint en un bon moment."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "V %1$lld z poslední %2$lld noci se v okně neobjevila žádná vhodná chvíle. S %3$lld min se budeš častěji budit ve vhodnou chvíli."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "I %1$lld af den seneste %2$lld nat var der intet godt tidspunkt i vinduet. Med %3$lld min vågner du oftere på et godt tidspunkt."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In %1$lld der letzten %2$lld Nacht kam kein guter Moment ins Fenster. Mit %3$lld Min erwischst du öfter einen guten Moment."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Σε %1$lld από την τελευταία %2$lld νύχτα δεν υπήρχε κατάλληλη στιγμή στο παράθυρο. Με %3$lld λεπτά θα ξυπνάς πιο συχνά την κατάλληλη στιγμή."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In %1$lld of the last %2$lld night there was no good moment in the window. With %3$lld min you’ll more often wake at a good moment."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En %1$lld de la última noche (%2$lld) no hubo un buen momento dentro de la ventana. Con %3$lld min te despertarás más a menudo en un buen momento."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Viimasest %2$lld ööst %1$lld ööl polnud aknas head hetke. %3$lld minutiga ärkad sagedamini heal hetkel."
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "Azken %2$lld gauetik %1$lld gauetan ez zen une onik izan leihoan. %3$lld minutuarekin maizago esnatuko zara une onean."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "در %1$lld شب از %2$lld شب اخیر، در بازه لحظهٔ مناسبی نبود. با %3$lld دقیقه بیشتر در لحظه‌ای مناسب بیدار می‌شوی."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld viimeisestä %2$lld yöstä ikkunassa ei ollut hyvää hetkeä. Kun ikkuna on %3$lld min, heräät useammin hyvällä hetkellä."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Sa %1$lld sa huling %2$lld gabi, walang magandang sandali sa window. Sa %3$lld min, mas madalas kang magigising sa magandang sandali."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dans %1$lld de la dernière nuit (%2$lld), il n’y avait pas de bon moment dans la fenêtre. Avec %3$lld min, tu te réveilleras plus souvent au bon moment."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Ní raibh nóiméad maith san fhuinneog i %1$lld as na %2$lld oíche dheireanacha. Le %3$lld nóim, is minice a dhúiseoidh tú ag nóiméad maith."
          }
        },
        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "En %1$lld da última %2$lld noite non houbo un bo momento na xanela. Con %3$lld min espertarás máis veces nun bo momento."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "છેલ્લી %2$lld રાતમાંથી %1$lld રાતે સમયગાળામાં યોગ્ય ક્ષણ નહોતી. %3$lld મિ. સાથે તમે વધુ વાર યોગ્ય ક્ષણે જાગશો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ב-%1$lld מתוך הלילה האחרון (%2$lld) לא היה רגע טוב בחלון. עם %3$lld דק׳ יהיו יותר התעוררויות ברגע טוב."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पिछली %2$lld रात में से %1$lld रात में विंडो के दौरान सही पल नहीं आया। %3$lld मिनट से तुम अक्सर सही समय पर जागोगे।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "U %1$lld od posljednje %2$lld noći u intervalu nije bilo dobrog trenutka. S %3$lld min češće ćeš se probuditi u dobrom trenutku."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az utolsó %2$lld éjszakából %1$lld alkalommal nem volt jó pillanat az ablakban. %3$lld perccel gyakrabban ébredsz jó pillanatban."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Վերջին %2$lld գիշերից %1$lld-ում պատուհանում հարմար պահ չի եղել։ %3$lld ր-ով ավելի հաճախ կարթնանաս հարմար պահին։"
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Í %1$lld af síðustu %2$lld nótt var ekkert gott augnablik í glugganum. Með %3$lld mín vaknarðu oftar á góðu augnabliki."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In %1$lld dell’ultima notte (%2$lld) non c’era un momento giusto nella finestra. Con %3$lld min ti sveglierai più spesso al momento giusto."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ბოლო %2$lld ღამიდან %1$lld-ში ფანჯარაში კარგი მომენტი არ იყო. %3$lld წთ-ით უფრო ხშირად გაიღვიძებ კარგ მომენტში."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Соңғы %2$lld түннің %1$lld түнінде терезеде қолайлы сәт болмады. %3$lld минутпен жиірек дәл кезінде оянасың."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಕಳೆದ %2$lld ರಾತ್ರಿಯಲ್ಲಿ %1$lld ರಲ್ಲಿ ಅವಧಿಯೊಳಗೆ ಒಳ್ಳೆಯ ಕ್ಷಣ ಇರಲಿಲ್ಲ. %3$lld ನಿಮಿ. ಇದ್ದರೆ ಹೆಚ್ಚಾಗಿ ಒಳ್ಳೆಯ ಕ್ಷಣದಲ್ಲಿ ಏಳುತ್ತೀರಿ."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Per %1$lld iš paskutinės %2$lld nakties lange nebuvo tinkamo momento. Su %3$lld min dažniau pabusi tinkamu metu."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld no pēdējās %2$lld nakts logā nebija laba brīža. Ar %3$lld min biežāk pamodīsies labā brīdī."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Во %1$lld од последната %2$lld ноќ немаше добар миг во прозорецот. Со %3$lld мин почесто ќе се будиш во добар миг."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "കഴിഞ്ഞ %2$lld രാത്രിയിൽ %1$lld എണ്ണത്തിൽ സമയപരിധിയിൽ നല്ല നിമിഷമുണ്ടായില്ല. %3$lld മി. ആണെങ്കിൽ കൂടുതൽ തവണ നല്ല നിമിഷത്തിൽ ഉണരും."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Сүүлийн %2$lld шөнийн %1$lld-д нь хугацаанд тохиромжтой мөч байгаагүй. %3$lld минуттай бол илүү олон удаа тохиромжтой мөчид сэрнэ."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "मागील %2$lld रात्रीपैकी %1$lld रात्री कालावधीत योग्य क्षण नव्हता. %3$lld मि. ठेवल्यास तुम्ही अधिक वेळा योग्य क्षणी उठाल."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "I %1$lld av den siste %2$lld natten var det ikke noe godt tidspunkt i vinduet. Med %3$lld min våkner du oftere på et godt tidspunkt."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "पछिल्ला %2$lld रातमध्ये %1$lld रात अवधिभित्र राम्रो क्षण आएन। %3$lld मिनेट राख्दा तिमी धेरैपटक राम्रो क्षणमा ब्युँझनेछौ।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "In %1$lld van de laatste %2$lld nacht zat er geen goed moment in het venster. Met %3$lld min word je vaker op een goed moment wakker."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਪਿਛਲੀ %2$lld ਰਾਤ ਵਿੱਚੋਂ %1$lld ਰਾਤ ਮਿਆਦ ਵਿੱਚ ਸਹੀ ਪਲ ਨਹੀਂ ਸੀ। %3$lld ਮਿੰ. ਨਾਲ ਤੁਸੀਂ ਵੱਧ ਵਾਰ ਸਹੀ ਪਲ ’ਤੇ ਜਾਗੋਗੇ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "W %1$lld z ostatniej %2$lld nocy w oknie nie było dobrego momentu. Przy %3$lld min częściej obudzisz się w dobrym momencie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Em %1$lld de %2$lld noite recente não houve um bom momento na janela. Com %3$lld min, você vai acordar mais vezes num bom momento."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Em %1$lld de %2$lld noite recente não houve um bom momento na janela. Com %3$lld min, vais acordar mais vezes num bom momento."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "În %1$lld din %2$lld noapte recentă nu a fost niciun moment bun în fereastră. Cu %3$lld min te vei trezi mai des într-un moment bun."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В %1$lld из последних %2$lld ночи в окне не было удачного момента. С %3$lld мин ты чаще будешь просыпаться в удачный момент."
          }
        },
        "si": {
          "stringUnit": {
            "state": "translated",
            "value": "අවසන් රාත්‍රි %2$lld න් %1$lld ක පරාසය තුළ හොඳ මොහොතක් නොතිබුණි. මිනිත්තු %3$lld ක් සමඟ ඔබ නිතර හොඳ මොහොතක අවදි වනු ඇත."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "V %1$lld z poslednej %2$lld noci nebola v okne vhodná chvíľa. S %3$lld min ťa budík častejšie zobudí v dobrej chvíli."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "V %1$lld od zadnje %2$lld noči v oknu ni bilo pravega trenutka. S %3$lld min te bo ura pogosteje zbudila ob pravem trenutku."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Në %1$lld nga %2$lld nata e fundit nuk pati moment të mirë në interval. Me %3$lld min do të zgjohesh më shpesh në një moment të mirë."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "У %1$lld од последње %2$lld ноћи у интервалу није било доброг тренутка. Са %3$lld мин чешће ћеш се будити у добром тренутку."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Under %1$lld av den senaste %2$lld natten fanns inget bra tillfälle i fönstret. Med %3$lld min vaknar du oftare vid ett bra tillfälle."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Katika %1$lld kati ya usiku %2$lld uliopita hakukuwa na wakati mzuri ndani ya kipindi. Ukiwa na dak %3$lld utaamka mara nyingi zaidi wakati mzuri."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "கடந்த %2$lld இரவில் %1$lld இல் வரம்புக்குள் நல்ல தருணம் இல்லை. %3$lld நிமி. வைத்தால் அடிக்கடி நல்ல தருணத்தில் எழுவீர்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "గత %2$lld రాత్రిలో %1$lld రాత్రి వ్యవధిలో సరైన క్షణం లేదు. %3$lld ని.తో మీరు ఎక్కువసార్లు సరైన క్షణంలో మేల్కొంటారు."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Son %2$lld gecenin %1$lld tanesinde aralıkta uygun an yoktu. %3$lld dk ile daha sık uygun bir anda uyanırsın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "У %1$lld з останніх %2$lld ночі у вікні не було слушного моменту. З %3$lld хв ти частіше прокидатимешся у слушний момент."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "پچھلی %2$lld رات میں سے %1$lld میں ونڈو کے اندر اچھا لمحہ نہیں تھا۔ %3$lld منٹ کے ساتھ تم زیادہ تر اچھے لمحے پر جاگو گے۔"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Oxirgi %2$lld tundan %1$lld tasida oraliqda qulay payt boʻlmadi. %3$lld daqiqa bilan koʻproq qulay paytda uygʻonasan."
          }
        },
        "zu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ebusuku obungu-%1$lld kobungu-%2$lld bokugcina bekungekho isikhathi esihle esikhaleni. Nge-%3$lld min uzovuka kaningi ngesikhathi esihle."
          }
        }
      }
    },
