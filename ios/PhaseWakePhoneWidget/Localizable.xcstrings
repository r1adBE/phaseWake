          "stringUnit": {
            "state": "translated",
            "value": "醒來後從 Health Connect 讀取睡眠階段，用於檢查並改善偵測。"
          }
        },
        "zu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ifunda izigaba zokulala ku-Health Connect ngemva kokuvuka, ukuze ihlole futhi ithuthukise ukutholwa."
          }
        }
      }
    },
