    "dnd_text": {
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Laat wekkers in Moenie Steur Nie toe, anders bly jou foon stil."
          }
        },
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "በአትረብሽ ውስጥ ማንቂያዎችን ይፍቀዱ፣ አለበለዚያ ስልክዎ ጸጥ ይላል።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اسمحوا بالمنبّهات في وضع عدم الإزعاج، وإلا سيبقى هاتفك صامتًا."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "“Narahat etməyin” rejimində siqnallara icazə ver, yoxsa telefonun səssiz qalacaq."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Разреши будилниците при „Не безпокойте“, иначе телефонът ще остане тих."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "“বিরক্ত করবে না”-তে অ্যালার্মের অনুমতি দাও, নইলে তোমার ফোন চুপ থাকবে।"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Dozvoli alarme u načinu „Ne uznemiravaj“, inače tvoj telefon ostaje tih."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Permet les alarmes amb «No molestis»; si no, el telèfon no sonarà."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Povol budíky v režimu Nerušit, jinak bude telefon zticha."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tillad alarmer i Forstyr ikke, ellers forbliver din telefon stille."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erlaube Wecker bei «Nicht stören», sonst bleibt dein Handy still."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επίτρεψε ξυπνητήρια στο «Μην ενοχλείτε», αλλιώς το κινητό σου θα μένει σιωπηλό."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow alarms in Do Not Disturb, otherwise your phone stays silent."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite las alarmas en No molestar; si no, tu móvil seguirá en silencio."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Luba äratused režiimis „Mitte segada“, muidu jääb telefon vaikseks."
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "Baimendu alarmak «Ez molestatu» moduan; bestela, telefonoa isilik geratuko da."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "در حالت «مزاحم نشو» اجازهٔ زنگ بده، وگرنه گوشی‌ات ساکت می‌ماند."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Salli herätykset Älä häiritse -tilassa, muuten puhelimesi pysyy hiljaa."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Payagan ang mga alarm sa Huwag Istorbohin, kung hindi ay mananatiling tahimik ang telepono mo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorise les alarmes dans Ne pas déranger, sinon ton téléphone reste silencieux."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Ceadaigh aláraim in “Ná Cuir Isteach Orm”, nó fanfaidh do fhón ciúin."
          }
        },
        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite as alarmas en «Non molestar»; se non, o teléfono quedará en silencio."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "“ખલેલ પાડશો નહીં”માં એલાર્મને મંજૂરી આપો, નહીંતર તમારો ફોન શાંત રહેશે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אפשרו מעוררים במצב ‘נא לא להפריע’, אחרת הטלפון יישאר שקט."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "डू नॉट डिस्टर्ब में अलार्म की अनुमति दो, वरना फ़ोन चुप रहेगा।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dopusti alarme u načinu „Ne uznemiravaj“, inače tvoj telefon ostaje tih."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Engedélyezd az ébresztőket Ne zavarjanak módban, különben a telefonod néma marad."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Թույլատրիր զարթուցիչները «Չանհանգստացնել» ռեժիմում, այլապես հեռախոսդ լուռ կմնա։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Izinkan alarm saat Jangan Ganggu, kalau tidak ponselmu tetap senyap."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Leyfðu vekjara í „Ónáðið ekki“, annars er síminn hljóður."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Consenti le sveglie in Non disturbare, altrimenti il telefono resta muto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サイレントモード中もアラームを許可してください。許可しないとスマートフォンは鳴りません。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "დაუშვი მაღვიძარები „არ შემაწუხოთ“ რეჟიმში, თორემ ტელეფონი ჩუმად დარჩება."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "«Мазаламау» режимінде оятқыштарға рұқсат бер, әйтпесе телефон үнсіз қалады."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "អនុញ្ញាតម៉ោងរោទ៍ក្នុង «កុំរំខាន» បើមិនដូច្នោះទេ ទូរសព្ទនឹងនៅស្ងាត់។"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಅಡಚಣೆ ಮಾಡಬೇಡಿ ಮೋಡ್‌ನಲ್ಲಿ ಅಲಾರಾಂಗಳನ್ನು ಅನುಮತಿಸಿ, ಇಲ್ಲದಿದ್ದರೆ ಫೋನ್ ಮೌನವಾಗಿರುತ್ತದೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "방해 금지 모드에서 알람을 허용해 주세요. 그렇지 않으면 휴대폰이 울리지 않아요."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ອະນຸຍາດໂມງປຸກໃນ “ຫ້າມລົບກວນ” ບໍ່ດັ່ງນັ້ນໂທລະສັບຈະງຽບ"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Leisk žadintuvus režimu „Netrukdyti“, kitaip telefonas tylės."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Atļauj modinātājus režīmā „Netraucēt“, citādi tālrunis paliks kluss."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дозволи аларми при „Не вознемирувај“, инаку телефонот ќе молчи."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ശല്യപ്പെടുത്തരുത് മോഡിൽ അലാറങ്ങൾ അനുവദിക്കുക, അല്ലെങ്കിൽ ഫോൺ നിശബ്ദമായിരിക്കും."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "«Бүү саад бол» горимд сэрүүлгийг зөвшөөр, эс бөгөөс утас чинь дуугарахгүй."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "“व्यत्यय आणू नका” मध्ये अलार्मना परवानगी द्या, नाहीतर तुमचा फोन शांतच राहील."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Benarkan penggera dalam Jangan Ganggu, jika tidak telefon awak kekal senyap."
          }
        },
        "my": {
          "stringUnit": {
            "state": "translated",
            "value": "မနှောင့်ယှက်ရ တွင် နှိုးစက်များကို ခွင့်ပြုပါ၊ မဟုတ်ပါက ဖုန်း အသံတိတ်နေမည်။"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Tillat alarmer i Ikke forstyrr, ellers blir telefonen stille."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "“बाधा नपुर्‍याउनुहोस्” मा अलार्मलाई अनुमति देऊ, नत्र तिम्रो फोन चुप रहन्छ।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sta wekkers toe bij Niet storen, anders blijft je telefoon stil."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "“ਪਰੇਸ਼ਾਨ ਨਾ ਕਰੋ” ਵਿੱਚ ਅਲਾਰਮਾਂ ਦੀ ਇਜਾਜ਼ਤ ਦਿਓ, ਨਹੀਂ ਤਾਂ ਤੁਹਾਡਾ ਫ਼ੋਨ ਚੁੱਪ ਰਹੇਗਾ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zezwól na budziki w trybie Nie przeszkadzać, inaczej telefon będzie milczał."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Permita alarmes no Não perturbe; senão seu celular fica em silêncio."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite alarmes em Não incomodar; caso contrário, o telemóvel fica em silêncio."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite alarmele în modul Nu deranja, altfel telefonul tău rămâne mut."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разреши будильники в режиме «Не беспокоить», иначе телефон будет молчать."
          }
        },
        "si": {
          "stringUnit": {
            "state": "translated",
            "value": "“බාධා නොකරන්න” තුළ එලාමවලට ඉඩ දෙන්න, නැතහොත් ඔබේ දුරකථනය නිහඬව පවතී."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Povoľ budíky v režime Nerušiť, inak telefón zostane ticho."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dovoli budilke v načinu »Ne moti«, sicer telefon ostane tiho."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Lejo alarmet te „Mos shqetëso“, përndryshe telefoni yt mbetet në heshtje."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Дозволи аларме у режиму „Не узнемиравај“, иначе твој телефон остаје тих."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tillåt larm i Stör ej, annars förblir mobilen tyst."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Ruhusu kengele katika “Usinisumbue”, la sivyo simu yako itabaki kimya."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "“தொந்தரவு செய்ய வேண்டாம்” பயன்முறையில் அலாரங்களை அனுமதியுங்கள், இல்லையெனில் ஃபோன் அமைதியாக இருக்கும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "“అంతరాయం కలిగించవద్దు”లో అలారాలను అనుమతించండి, లేకపోతే మీ ఫోన్ నిశ్శబ్దంగా ఉంటుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อนุญาตให้นาฬิกาปลุกดังในโหมดห้ามรบกวน มิฉะนั้นโทรศัพท์จะเงียบ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rahatsız Etme'de alarmlara izin ver, yoksa telefonun sessiz kalır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дозволь будильники в режимі «Не турбувати», інакше телефон мовчатиме."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "“ڈسٹرب نہ کریں” میں الارم کی اجازت دو، ورنہ تمہارا فون خاموش رہے گا۔"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "«Bezovta qilinmasin» rejimida budilniklarga ruxsat ber, aks holda telefoning jim qoladi."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy cho phép báo thức trong chế độ Không làm phiền, nếu không điện thoại sẽ im lặng."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "請在「請勿打擾」中允許鬧鐘，否則手機不會響。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在勿扰模式下允许闹钟，否则手机不会响铃。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請在勿擾模式下允許鬧鐘，否則手機不會響鈴。"
          }
        },
        "zu": {
          "stringUnit": {
            "state": "translated",
            "value": "Vumela ama-alamu ku-Ungaphazamisi, uma kungenjalo ifoni yakho izothula."
          }
        }
      }
    },
