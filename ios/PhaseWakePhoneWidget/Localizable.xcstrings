    "settings_backup_hint": {
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Lêer wat met jou wagwoord geënkripteer is: wekkers, nagte met beweging en hartklop, notas en instellings. Sonder klanksnitte."
          }
        },
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "በይለፍ ቃልህ የተመሰጠረ ፋይል፦ ማንቂያዎች፣ እንቅስቃሴና የልብ ምት ያላቸው ሌሊቶች፣ ማስታወሻዎች እና ቅንብሮች። ያለ የድምፅ ቅንጥቦች።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ملف مشفّر بكلمة مرورك: المنبّهات، والليالي مع الحركة ونبض القلب، والملاحظات والإعدادات. دون الأصوات."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Parolunla şifrələnmiş fayl: siqnallar, hərəkət və nəbzlə birlikdə gecələr, qeydlər və ayarlar. Səs klipləri olmadan."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Файл, шифрован с твоята парола: будилници, нощи с движение и пулс, бележки и настройки. Без звукови записи."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "তোমার পাসওয়ার্ড দিয়ে এনক্রিপ্ট করা ফাইল: অ্যালার্ম, নড়াচড়া ও হৃদস্পন্দন সহ রাত, নোট আর সেটিংস। শব্দের ক্লিপ ছাড়া।"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Datoteka šifrirana tvojom lozinkom: alarmi, noći s pokretom i pulsom, bilješke i postavke. Bez zvučnih isječaka."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Fitxer xifrat amb la teva contrasenya: alarmes, nits amb moviment i freqüència cardíaca, notes i configuració. Sense fragments de so."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Soubor šifrovaný tvým heslem: budíky, noci včetně pohybu a tepu, poznámky a nastavení. Bez nahrávek zvuků."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Fil krypteret med din adgangskode: alarmer, nætter med bevægelse og puls, noter og indstillinger. Uden lyde."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit deinem Passwort verschlüsselte Datei: Wecker, Nächte samt Bewegung und Puls, Notizen und Einstellungen. Ohne Geräusche."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αρχείο κρυπτογραφημένο με τον κωδικό σου: ξυπνητήρια, νύχτες μαζί με κίνηση και παλμούς, σημειώσεις και ρυθμίσεις. Χωρίς ήχους."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "File encrypted with your password: alarms, nights incl. motion and heart rate, notes and settings. No sound clips."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Archivo cifrado con tu contraseña: alarmas, noches con movimiento y frecuencia cardíaca, notas y ajustes. Sin fragmentos de sonido."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Sinu parooliga krüpteeritud fail: äratused, ööd koos liikumise ja pulsiga, märkmed ja seaded. Ilma helilõikudeta."
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "Zure pasahitzarekin zifratutako fitxategia: alarmak, gauak mugimendu eta bihotz-maiztasunarekin, oharrak eta ezarpenak. Soinu-zatirik gabe."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "فایلی که با گذرواژه‌ات رمزگذاری شده: هشدارها، شب‌ها همراه با حرکت و ضربان قلب، یادداشت‌ها و تنظیمات. بدون صداها."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Salasanallasi salattu tiedosto: herätykset, yöt liikkeineen ja sykkeineen, muistiinpanot ja asetukset. Ilman ääniä."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "File na naka-encrypt gamit ang password mo: mga alarm, mga gabi kasama ang galaw at heart rate, tala at setting. Walang sound clip."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fichier chiffré avec ton mot de passe : alarmes, nuits avec mouvements et fréquence cardiaque, notes et réglages. Sans extraits sonores."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Comhad criptithe le do phasfhocal: aláraim, oícheanta le gluaiseacht agus ráta croí, nótaí agus socruithe. Gan gearrthóga fuaime."
          }
        },
        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ficheiro cifrado co teu contrasinal: alarmas, noites con movemento e pulso, notas e axustes. Sen fragmentos de son."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તમારા પાસવર્ડથી એન્ક્રિપ્ટ કરેલી ફાઇલ: એલાર્મ, હલનચલન અને હૃદયના ધબકારા સાથેની રાતો, નોંધો અને સેટિંગ્સ. અવાજની ક્લિપ વિના."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "קובץ מוצפן בסיסמה שלכם: השכמות, לילות כולל תנועה ודופק, הערות והגדרות. בלי צלילים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "तुम्हारे पासवर्ड से एन्क्रिप्ट की गई फ़ाइल: अलार्म, गतिविधि और हृदय गति सहित रातें, नोट्स और सेटिंग्स। आवाज़ की क्लिप के बिना।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Datoteka šifrirana tvojom lozinkom: alarmi, noći s pokretom i pulsom, bilješke i postavke. Bez zvučnih isječaka."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A jelszavaddal titkosított fájl: ébresztők, éjszakák mozgással és pulzussal, jegyzetek és beállítások. Hangrészletek nélkül."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Քո գաղտնաբառով գաղտնագրված ֆայլ՝ զարթուցիչներ, գիշերներ՝ շարժումով և զարկերով, նշումներ և կարգավորումներ։ Առանց ձայնային հատվածների։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "File terenkripsi dengan kata sandimu: alarm, malam beserta gerakan dan detak jantung, catatan, dan setelan. Tanpa klip suara."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Skrá dulkóðuð með lykilorðinu þínu: vekjarar, nætur með hreyfingu og púls, glósur og stillingar. Án hljóðbúta."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "File cifrato con la tua password: sveglie, notti con movimento e battito, note e impostazioni. Senza clip audio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "パスワードで暗号化されたファイル：アラーム、体動と心拍を含む夜の記録、メモ、設定。音声クリップは含みません。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "შენი პაროლით დაშიფრული ფაილი: მაღვიძარები, ღამეები მოძრაობითა და პულსით, ჩანაწერები და პარამეტრები. ხმოვანი ფრაგმენტების გარეშე."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Құпиясөзіңмен шифрланған файл: оятқыштар, қозғалыс пен пульсі бар түндер, жазбалар және параметрлер. Дыбыс үзінділерінсіз."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ឯកសារដែលបានអ៊ិនគ្រីបដោយពាក្យសម្ងាត់របស់អ្នក៖ នាឡិការោទ៍ យប់ៗរួមទាំងចលនា និងចង្វាក់បេះដូង កំណត់ចំណាំ និងការកំណត់។ គ្មានឃ្លីបសំឡេងទេ។"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನಿಮ್ಮ ಪಾಸ್‌ವರ್ಡ್‌ನಿಂದ ಎನ್‌ಕ್ರಿಪ್ಟ್ ಮಾಡಿದ ಫೈಲ್: ಅಲಾರಂಗಳು, ಚಲನೆ ಮತ್ತು ಹೃದಯ ಬಡಿತ ಸಹಿತ ರಾತ್ರಿಗಳು, ಟಿಪ್ಪಣಿಗಳು ಮತ್ತು ಸೆಟ್ಟಿಂಗ್‌ಗಳು. ಧ್ವನಿ ಕ್ಲಿಪ್‌ಗಳಿಲ್ಲದೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "비밀번호로 암호화된 파일: 알람, 움직임과 심박수가 포함된 밤 기록, 메모, 설정. 소리 클립은 제외됩니다."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ໄຟລ໌ທີ່ເຂົ້າລະຫັດດ້ວຍລະຫັດຜ່ານຂອງເຈົ້າ: ໂມງປຸກ, ຄືນຕ່າງໆພ້ອມການເຄື່ອນໄຫວ ແລະ ອັດຕາການເຕັ້ນຂອງຫົວໃຈ, ບັນທຶກ ແລະ ການຕັ້ງຄ່າ. ບໍ່ມີຄລິບສຽງ."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Tavo slaptažodžiu užšifruotas failas: žadintuvai, naktys su judėjimu ir pulsu, užrašai ir nustatymai. Be garso įrašų."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ar tavu paroli šifrēts fails: modinātāji, naktis ar kustībām un pulsu, piezīmes un iestatījumi. Bez skaņu fragmentiem."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Датотека шифрирана со твојата лозинка: аларми, ноќи со движење и пулс, белешки и поставки. Без звучни снимки."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങളുടെ പാസ്‌വേഡ് കൊണ്ട് എൻക്രിപ്റ്റ് ചെയ്ത ഫയൽ: അലാറങ്ങൾ, ചലനവും ഹൃദയമിടിപ്പും ഉൾപ്പെടെയുള്ള രാത്രികൾ, കുറിപ്പുകൾ, ക്രമീകരണങ്ങൾ. ശബ്ദ ക്ലിപ്പുകൾ ഇല്ലാതെ."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Таны нууц үгээр шифрлэсэн файл: сэрүүлэг, хөдөлгөөн ба зүрхний цохилттой шөнүүд, тэмдэглэл ба тохиргоо. Дууны хэсэггүй."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुमच्या पासवर्डने एन्क्रिप्ट केलेली फाइल: अलार्म, हालचाल आणि हृदयाचे ठोके असलेल्या रात्री, नोंदी आणि सेटिंग्ज. आवाजाच्या क्लिपशिवाय."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Fail yang disulitkan dengan kata laluan awak: penggera, malam berserta pergerakan dan kadar denyutan jantung, nota dan tetapan. Tanpa keratan bunyi."
          }
        },
        "my": {
          "stringUnit": {
            "state": "translated",
            "value": "သင့်စကားဝှက်ဖြင့် ကုဒ်ဝှက်ထားသော ဖိုင်- နှိုးစက်များ၊ လှုပ်ရှားမှုနှင့် နှလုံးခုန်နှုန်းပါသော ညများ၊ မှတ်စုများနှင့် ဆက်တင်များ။ အသံအပိုင်းအစများ မပါပါ။"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Fil kryptert med passordet ditt: alarmer, netter med bevegelse og puls, notater og innstillinger. Uten lydklipp."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "तिम्रो पासवर्डले इन्क्रिप्ट गरिएको फाइल: अलार्म, चालचलन र मुटुको धड्कनसहितका रातहरू, नोट र सेटिङ। आवाजका क्लिपबिना।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Met je wachtwoord versleuteld bestand: wekkers, nachten inclusief beweging en hartslag, notities en instellingen. Zonder geluidsfragmenten."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਤੁਹਾਡੇ ਪਾਸਵਰਡ ਨਾਲ ਇਨਕ੍ਰਿਪਟ ਕੀਤੀ ਫ਼ਾਈਲ: ਅਲਾਰਮ, ਹਿਲਜੁਲ ਅਤੇ ਦਿਲ ਦੀ ਧੜਕਣ ਸਮੇਤ ਰਾਤਾਂ, ਨੋਟ ਅਤੇ ਸੈਟਿੰਗਾਂ। ਆਵਾਜ਼ ਦੀਆਂ ਕਲਿੱਪਾਂ ਤੋਂ ਬਿਨਾਂ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Plik zaszyfrowany twoim hasłem: budziki, noce wraz z ruchem i tętnem, notatki i ustawienia. Bez nagrań dźwięków."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Arquivo criptografado com sua senha: alarmes, noites com movimento e frequência cardíaca, notas e configurações. Sem trechos de som."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ficheiro encriptado com a tua palavra-passe: alarmes, noites com movimento e frequência cardíaca, notas e definições. Sem excertos de som."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Fișier criptat cu parola ta: alarme, nopți cu mișcare și puls, notițe și setări. Fără fragmente audio."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Файл, зашифрованный твоим паролем: будильники, ночи с движением и пульсом, заметки и настройки. Без звуковых фрагментов."
          }
        },
        "si": {
          "stringUnit": {
            "state": "translated",
            "value": "ඔබේ මුරපදයෙන් සංකේතනය කළ ගොනුව: එලාම්, චලනය හා හෘද ස්පන්දනය සහිත රාත්‍රි, සටහන් සහ සැකසුම්. ශබ්ද කොටස් නොමැතිව."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Súbor zašifrovaný tvojím heslom: budíky, noci vrátane pohybu a pulzu, poznámky a nastavenia. Bez zvukových záznamov."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Datoteka, šifrirana s tvojim geslom: alarmi, noči z gibanjem in utripom, zapiski in nastavitve. Brez zvočnih posnetkov."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Skedar i enkriptuar me fjalëkalimin tënd: alarme, netë me lëvizje dhe puls, shënime dhe cilësime. Pa fragmente zanore."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Датотека шифрована твојом лозинком: аларми, ноћи са покретом и пулсом, белешке и подешавања. Без звучних исечака."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Fil krypterad med ditt lösenord: alarm, nätter med rörelse och puls, anteckningar och inställningar. Utan ljudklipp."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Faili iliyosimbwa kwa nenosiri lako: kengele, usiku pamoja na mwendo na mapigo ya moyo, madokezo na mipangilio. Bila vipande vya sauti."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் கடவுச்சொல்லால் மறையாக்கப்பட்ட கோப்பு: அலாரங்கள், அசைவு மற்றும் இதயத் துடிப்புடன் கூடிய இரவுகள், குறிப்புகள், அமைப்புகள். ஒலித் துணுக்குகள் இல்லாமல்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ పాస్‌వర్డ్‌తో ఎన్‌క్రిప్ట్ చేసిన ఫైల్: అలారాలు, కదలిక మరియు గుండె వేగంతో కూడిన రాత్రులు, నోట్స్, సెట్టింగ్‌లు. శబ్ద క్లిప్‌లు లేకుండా."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไฟล์ที่เข้ารหัสด้วยรหัสผ่านของคุณ: นาฬิกาปลุก คืนต่าง ๆ พร้อมการเคลื่อนไหวและอัตราการเต้นของหัวใจ บันทึก และการตั้งค่า ไม่มีคลิปเสียง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Parolanla şifrelenmiş dosya: alarmlar, hareket ve nabız dahil geceler, notlar ve ayarlar. Ses kayıtları olmadan."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Файл, зашифрований твоїм паролем: будильники, ночі з рухом і пульсом, нотатки та налаштування. Без звукових фрагментів."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "تمہارے پاس ورڈ سے انکرپٹ کی گئی فائل: الارم، حرکت اور دل کی دھڑکن سمیت راتیں، نوٹس اور ترتیبات۔ آواز کے کلپس کے بغیر۔"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Parolingiz bilan shifrlangan fayl: budilniklar, harakat va yurak urishi bilan tunlar, qaydlar va sozlamalar. Tovush parchalarisiz."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tệp được mã hóa bằng mật khẩu của bạn: báo thức, các đêm kèm chuyển động và nhịp tim, ghi chú và cài đặt. Không có đoạn âm thanh."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "用你的密碼加密的檔案：鬧鐘、連動作和心率的夜晚記錄、備註和設定。不含聲音片段。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用你的密码加密的文件：闹钟、含体动和心率的夜晚记录、笔记和设置。不含声音片段。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "以你的密碼加密的檔案：鬧鐘、含體動和心率的夜晚紀錄、筆記和設定。不含聲音片段。"
          }
        },
        "zu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ifayela elibethelwe ngephasiwedi yakho: ama-alamu, ubusuku kanye nokunyakaza nokushaya kwenhliziyo, amanothi kanye nezilungiselelo. Ngaphandle kweziqeshana zomsindo."
          }
        }
      }
    },
