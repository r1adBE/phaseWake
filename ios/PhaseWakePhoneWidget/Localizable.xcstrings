        },
        "si": {
          "stringUnit": {
            "state": "translated",
            "value": "එලාමය නිහඬ වීමට පෙර එකතු කිරීම් 3 ක් විසඳන්න. ස්නූස් කිරීමට ගැටලුවක් අවශ්‍ය නැත."
