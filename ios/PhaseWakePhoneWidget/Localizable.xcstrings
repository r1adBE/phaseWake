    "settings_licenses_text": {
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake: MIT-lisensie, © r1adBE.\nManrope-lettertipe: SIL Open Font License 1.1, © The Manrope Project Authors.\nKlankherkenning: MediaPipe Tasks Audio en die YAMNet-model, Apache License 2.0, © Google LLC.\nKlanke: gratis opnames (CC0) van opengameart.org"
