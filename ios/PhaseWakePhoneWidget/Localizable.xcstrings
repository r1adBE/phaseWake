    "learn_auto_hint": {
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik saans op jou horlosie op “Goeienag” of skakel “Bespeur outomaties wanneer jy aan die slaap raak” aan sodat die nagte tel."
          }
        },
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "ሌሊቶቹ እንዲቆጠሩ ማታ በሰዓትህ ላይ «ደህና እደሩ»ን ንካ ወይም «እንቅልፍ መውሰድን በራስ-ሰር ለይ»ን አብራ።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط مساءً على “ليلة سعيدة” في ساعتك أو شغّل “اكتشاف النوم تلقائيًا” لكي تُحتسب الليالي."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Gecələrin sayılması üçün axşam saatında “Gecən xeyrə” düyməsinə toxun və ya “Yuxuya getməyi avtomatik aşkar et” funksiyasını aç."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Вечер докосни „Лека нощ“ на часовника или включи „Автоматично разпознаване на заспиването“, за да се броят нощите."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "রাতগুলো গোনার জন্য সন্ধ্যায় ঘড়িতে “শুভরাত্রি” ট্যাপ করো বা “ঘুমিয়ে পড়া স্বয়ংক্রিয়ভাবে শনাক্ত করো” চালু করো।"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Navečer dodirni „Laku noć“ na satu ili uključi „Automatski prepoznaj uspavljivanje“ da bi se noći brojale."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Al vespre, toca «Bona nit» al rellotge o activa «Detecta automàticament quan t'adorms» perquè les nits comptin."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Večer klepni na hodinkách na „Dobrou noc“ nebo zapni „Automaticky rozpoznat usnutí“, aby se noci počítaly."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryk om aftenen på »Godnat« på uret, eller slå »Registrér automatisk, når du falder i søvn« til, så nætterne tæller."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe abends auf der Uhr auf «Gute Nacht» oder schalte «Einschlafen automatisch erkennen» ein, damit die Nächte zählen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πάτησε το βράδυ «Καληνύχτα» στο ρολόι ή ενεργοποίησε το «Αυτόματος εντοπισμός αποκοίμισης», για να μετρούν οι νύχτες."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap “Good night” on your watch in the evening or turn on “Detect falling asleep automatically” so the nights count."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Por la noche, toca «Buenas noches» en el reloj o activa «Detectar automáticamente cuándo te duermes» para que las noches cuenten."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Puuduta õhtul kellal „Head ööd“ või lülita sisse „Tuvasta uinumine automaatselt“, et ööd loeksid."
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "Arratsean, sakatu «Gabon» erlojuan edo aktibatu «Loak hartzea automatikoki hauteman», gauak kontatu daitezen."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "شب‌ها روی ساعت «شب بخیر» را بزن یا «تشخیص خودکار به خواب رفتن» را روشن کن تا شب‌ها شمرده شوند."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Napauta illalla kellossa ”Hyvää yötä” tai ota ”Tunnista nukahtaminen automaattisesti” käyttöön, jotta yöt lasketaan."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Sa gabi, i-tap ang “Matutulog na” sa relo mo o i-on ang “Awtomatikong tukuyin ang pagkakatulog” para mabilang ang mga gabi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le soir, appuie sur « Bonne nuit » sur ta montre ou active « Détecter l'endormissement automatiquement » pour que les nuits comptent."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Tapáil “Oíche mhaith” ar d’uaireadóir tráthnóna nó cas air “Braith titim i do chodladh go huathoibríoch” ionas go gcomhairtear na hoícheanta."
          }
        },
        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pola noite, toca «Boas noites» no reloxo ou activa «Detectar automaticamente cando adormeces» para que as noites conten."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "રાતો ગણાય તે માટે સાંજે ઘડિયાળ પર “શુભ રાત્રિ” ટૅપ કર અથવા “ઊંઘ આવવાનું આપમેળે ઓળખો” ચાલુ કર."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בערב הקש על “לילה טוב” בשעון או הפעל את “זיהוי הירדמות אוטומטי” כדי שהלילות ייספרו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रातें गिनी जाएँ, इसके लिए शाम को घड़ी पर “शुभ रात्रि” टैप करो या “सो जाने का अपने आप पता लगाओ” चालू करो।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Navečer dodirni „Laku noć“ na satu ili uključi „Automatski prepoznaj uspavljivanje“ kako bi se noći brojale."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Este koppints az órán a(z) „Jó éjszakát” gombra, vagy kapcsold be: „Elalvás automatikus felismerése”, hogy az éjszakák számítsanak."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Երեկոյան ժամացույցի վրա հպիր «Բարի գիշեր»-ին կամ միացրու «Ինքնաշխատ հայտնաբերել քնելը»-ը, որպեսզի գիշերները հաշվվեն։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pada malam hari, ketuk “Selamat tidur” di jam tangan atau aktifkan “Deteksi saat tertidur secara otomatis” agar malamnya dihitung."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Ýttu á kvöldin á „Góða nótt“ á úrinu eða kveiktu á „Greina sjálfkrafa þegar þú sofnar“ svo næturnar teljist."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La sera tocca «Buonanotte» sull’orologio o attiva «Rileva automaticamente l'addormentamento», così le notti contano."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "夜をカウントするには、夜にウォッチで「おやすみ」をタップするか、「入眠を自動で検出」をオンにしてください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "საღამოს შეეხე საათზე „ძილი ნებისა“-ს ან ჩართე „ჩაძინების ავტომატური ამოცნობა“, რომ ღამეები ჩაითვალოს."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Түндер есептелуі үшін кешке сағатта «Қайырлы түн» түймесін түрт немесе «Ұйықтап кетуді автоматты түрде анықтау» функциясын қос."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "នៅពេលល្ងាច សូមប៉ះ «រាត្រីសួស្តី» នៅលើនាឡិកា ឬបើក «រកឃើញការដេកលក់ដោយស្វ័យប្រវត្តិ» ដើម្បីឱ្យយប់ត្រូវបានរាប់។"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ರಾತ್ರಿಗಳು ಎಣಿಕೆಯಾಗಲು ಸಂಜೆ ವಾಚ್‌ನಲ್ಲಿ “ಶುಭ ರಾತ್ರಿ” ಟ್ಯಾಪ್ ಮಾಡು ಅಥವಾ “ನಿದ್ರೆಗೆ ಜಾರುವುದನ್ನು ಸ್ವಯಂಚಾಲಿತವಾಗಿ ಪತ್ತೆಹಚ್ಚು” ಆನ್ ಮಾಡು."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "밤이 계산되도록 저녁에 시계에서 “잘 자요”을 탭하거나 “잠드는 시점 자동 감지”을 켜 주세요."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ຕອນແລງ ແຕະ “ລາຕີສະຫວັດ” ຢູ່ໂມງ ຫຼື ເປີດ “ກວດຫາການນອນຫຼັບໂດຍອັດຕະໂນມັດ” ເພື່ອໃຫ້ນັບຄືນ."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Vakare bakstelėk laikrodyje „Labanakt“ arba įjunk „Automatiškai atpažinti užmigimą“, kad naktys būtų skaičiuojamos."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vakarā pulkstenī pieskaries „Ar labu nakti“ vai ieslēdz „Automātiski noteikt aizmigšanu“, lai naktis tiktu skaitītas."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Навечер допри „Добра ноќ“ на часовникот или вклучи „Автоматски препознај заспивање“ за ноќите да се бројат."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "രാത്രികൾ എണ്ണപ്പെടാൻ വൈകുന്നേരം വാച്ചിൽ “ശുഭരാത്രി” ടാപ്പ് ചെയ്യുക അല്ലെങ്കിൽ “ഉറങ്ങിപ്പോകുന്നത് സ്വയമേവ കണ്ടെത്തുക” ഓണാക്കുക."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Шөнүүд тоологдохын тулд орой цаг дээрээ «Сайхан амраарай» дээр дар эсвэл «Унтаж эхлэхийг автоматаар илрүүлэх»-г асаа."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "रात्री मोजल्या जाव्यात म्हणून संध्याकाळी घड्याळावर “शुभ रात्री” टॅप कर किंवा “झोप लागणे आपोआप ओळखा” चालू कर."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pada waktu petang, ketik “Selamat malam” pada jam tangan atau hidupkan “Kesan bila awak tertidur secara automatik” supaya malam dikira."
          }
        },
        "my": {
          "stringUnit": {
            "state": "translated",
            "value": "ညများကို ရေတွက်နိုင်ရန် ညနေတွင် နာရီပေါ်ရှိ “ကောင်းသောညပါ” ကို တို့ပါ သို့မဟုတ် “အိပ်ပျော်သွားခြင်းကို အလိုအလျောက် သိရှိရန်” ကို ဖွင့်ပါ။"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Trykk på «God natt» på klokken om kvelden, eller slå på «Registrer automatisk når du sovner», så nettene teller."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "रातहरू गनिऊन् भन्नाका लागि साँझ घडीमा “शुभ रात्रि” ट्याप गर वा “निदाएको आफैँ पत्ता लगाऊ” सक्रिय गर।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik ’s avonds op je horloge op “Welterusten” of zet “Inslapen automatisch herkennen” aan, zodat de nachten meetellen."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਰਾਤਾਂ ਗਿਣੀਆਂ ਜਾਣ, ਇਸ ਲਈ ਸ਼ਾਮ ਨੂੰ ਘੜੀ ’ਤੇ “ਸ਼ੁਭ ਰਾਤ” ਟੈਪ ਕਰ ਜਾਂ “ਸੌਂ ਜਾਣ ਦਾ ਆਪਣੇ-ਆਪ ਪਤਾ ਲਗਾਓ” ਚਾਲੂ ਕਰ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wieczorem stuknij na zegarku „Dobranoc” lub włącz „Automatycznie wykrywaj zasypianie”, aby noce się liczyły."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "À noite, toque em “Boa noite” no relógio ou ative “Detectar automaticamente quando você adormece” para que as noites contem."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "À noite, toca em “Boa noite” no relógio ou ativa “Detetar automaticamente quando adormeces” para que as noites contem."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Seara, atinge „Noapte bună” pe ceas sau activează „Detectează automat adormirea”, ca nopțile să fie numărate."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вечером нажми «Спокойной ночи» на часах или включи «Автоматически определять засыпание», чтобы ночи засчитывались."
          }
        },
        "si": {
          "stringUnit": {
            "state": "translated",
            "value": "රාත්‍රී ගණන් වීමට සවස ඔරලෝසුවේ “සුබ රාත්‍රියක්” තට්ටු කරන්න හෝ “නින්දට යාම ස්වයංක්‍රීයව හඳුනාගන්න” සක්‍රිය කරන්න."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Večer ťukni na hodinkách na „Dobrú noc“ alebo zapni „Automaticky rozpoznať zaspávanie“, aby sa noci rátali."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zvečer na uri tapni »Lahko noč« ali vklopi »Samodejno zaznaj uspavanje«, da se noči štejejo."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Në mbrëmje prek „Natën e mirë“ në orë ose aktivizo „Dallo automatikisht kur fle“, që netët të numërohen."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Увече додирни „Лаку ноћ“ на сату или укључи „Аутоматски препознај заспивање“ да би се ноћи бројале."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryck på ”Godnatt” på klockan på kvällen eller slå på ”Känn av automatiskt när du somnar” så att nätterna räknas."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Jioni gusa “Usiku mwema” kwenye saa au washa “Tambua kiotomatiki unaposinzia” ili usiku uhesabiwe."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இரவுகள் கணக்கில் வர, மாலையில் கடிகாரத்தில் “இனிய இரவு” தட்டு அல்லது “தூங்குவதைத் தானாகக் கண்டறி” இயக்கு."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "రాత్రులు లెక్కలోకి రావడానికి సాయంత్రం వాచ్‌లో “శుభ రాత్రి” నొక్కు లేదా “నిద్రపోవడాన్ని ఆటోమేటిక్‌గా గుర్తించు” ఆన్ చెయ్యి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตอนเย็นให้แตะ “ราตรีสวัสดิ์” บนนาฬิกา หรือเปิด “ตรวจจับการหลับโดยอัตโนมัติ” เพื่อให้นับคืน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gecelerin sayılması için akşam saatinde “İyi geceler” öğesine dokun veya “Uykuya dalmayı otomatik algıla” seçeneğini aç."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Увечері натисни «На добраніч» на годиннику або увімкни «Автоматично визначати засинання», щоб ночі зараховувалися."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "راتیں گنی جائیں، اس لیے شام کو گھڑی پر “شب بخیر” ٹیپ کرو یا “سو جانے کا خودکار طور پر پتا لگائیں” آن کرو۔"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Tunlar hisoblanishi uchun kechqurun soatda «Xayrli tun» tugmasini bos yoki «Uxlab qolishni avtomatik aniqlash» funksiyasini yoq."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Buổi tối, hãy nhấn “Ngủ ngon” trên đồng hồ hoặc bật “Tự động nhận biết khi bạn ngủ thiếp đi” để các đêm được tính."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "夜晚請喺手錶上撳「晚安」，或者開啟「自動偵測入睡」，咁啲晚先會計入。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "晚上请在手表上点按“晚安”，或打开“自动检测入睡”，这样夜晚才会被计入。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "晚上請在手錶上輕觸「晚安」，或開啟「自動偵測入睡」，這樣夜晚才會被計入。"
          }
        },
        "zu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kusihlwa thepha “Ulale kahle” ewashini noma uvule “Bona ngokuzenzakalela lapho ulala” ukuze ubusuku bubalwe."
          }
        }
      }
    },
    "learn_auto_hint_clock": {
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Skakel “Bespeur outomaties wanneer jy aan die slaap raak” aan – dan bespeur jou horlosie self wanneer jy aan die slaap raak, en die nagte tel."
          }
        },
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "«እንቅልፍ መውሰድን በራስ-ሰር ለይ»ን አብራ – ከዚያ ሰዓትህ እንቅልፍ መውሰድህን ራሱ ይለያል፣ ሌሊቶቹም ይቆጠራሉ።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "شغّل “اكتشاف النوم تلقائيًا” – عندها تكتشف ساعتك بنفسها متى تنام، وتُحتسب الليالي."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "“Yuxuya getməyi avtomatik aşkar et” funksiyasını aç – onda saat yuxuya getməyini özü aşkar edəcək və gecələr sayılacaq."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Включи „Автоматично разпознаване на заспиването“ – тогава часовникът сам ще разпознава кога заспиваш и нощите ще се броят."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "“ঘুমিয়ে পড়া স্বয়ংক্রিয়ভাবে শনাক্ত করো” চালু করো – তাহলে ঘড়ি নিজেই বুঝবে তুমি কখন ঘুমিয়ে পড়লে, আর রাতগুলো গোনা হবে।"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Uključi „Automatski prepoznaj uspavljivanje“ – tada sat sam prepoznaje kada zaspiš, i noći se broje."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa «Detecta automàticament quan t'adorms» – així el rellotge detectarà tot sol quan t'adorms, i les nits comptaran."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapni „Automaticky rozpoznat usnutí“ – hodinky pak samy rozpoznají, kdy usneš, a noci se budou počítat."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Slå »Registrér automatisk, når du falder i søvn« til – så registrerer uret selv, hvornår du falder i søvn, og nætterne tæller."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schalte «Einschlafen automatisch erkennen» ein – dann erkennt die Uhr dein Einschlafen selbst, und die Nächte zählen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ενεργοποίησε το «Αυτόματος εντοπισμός αποκοίμισης» – τότε το ρολόι εντοπίζει μόνο του πότε αποκοιμιέσαι και οι νύχτες μετρούν."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn on “Detect falling asleep automatically” – then your watch detects on its own when you fall asleep, and the nights count."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa «Detectar automáticamente cuándo te duermes»: así el reloj detectará por sí solo cuándo te duermes y las noches contarán."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Lülita sisse „Tuvasta uinumine automaatselt“ – siis tuvastab kell ise, millal sa uinud, ja ööd loevad."
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktibatu «Loak hartzea automatikoki hauteman» – horrela, erlojuak berak hautemango du noiz hartzen zaituen loak, eta gauak kontatuko dira."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "«تشخیص خودکار به خواب رفتن» را روشن کن – آن‌وقت ساعت خودش تشخیص می‌دهد کی به خواب می‌روی و شب‌ها شمرده می‌شوند."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ota ”Tunnista nukahtaminen automaattisesti” käyttöön – silloin kello tunnistaa itse, milloin nukahdat, ja yöt lasketaan."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "I-on ang “Awtomatikong tukuyin ang pagkakatulog” – sa gayon, ang relo mo mismo ang tutukoy kung kailan ka nakatulog, at mabibilang ang mga gabi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Active « Détecter l'endormissement automatiquement » – ta montre détectera alors elle-même quand tu t’endors, et les nuits compteront."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Cas air “Braith titim i do chodladh go huathoibríoch” – ansin braithfidh d’uaireadóir féin cathain a thiteann tú i do chodladh, agus comhairfear na hoícheanta."
          }
        },
        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa «Detectar automaticamente cando adormeces»: así o reloxo detectará por si só cando adormeces e as noites contarán."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "“ઊંઘ આવવાનું આપમેળે ઓળખો” ચાલુ કર – પછી ઘડિયાળ જાતે ઓળખશે કે તને ક્યારે ઊંઘ આવી, અને રાતો ગણાશે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הפעל את “זיהוי הירדמות אוטומטי” – כך השעון יזהה בעצמו מתי נרדמת, והלילות ייספרו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "“सो जाने का अपने आप पता लगाओ” चालू करो – फिर घड़ी खुद पता लगाएगी कि तुम कब सोए, और रातें गिनी जाएँगी।"
