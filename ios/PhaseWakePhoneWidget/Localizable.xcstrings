        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Viskas lieka tavo telefone ir laikrodyje. Jokios paskyros, jokio serverio, jokio sekimo."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Viss paliek tavā tālrunī un pulkstenī. Bez konta, bez servera, bez izsekošanas."
