        "si": {
          "stringUnit": {
            "state": "translated",
            "value": "නින්දට යන වේලාවට පැය 1කට පෙර සිට ඔබ නින්දට යන තුරු ඔරලෝසුව කෙටි වේලාවක් චලනය මනියි. Galaxy Watch පමණි."
          }
        },
        "sk": {
          "stringUnit": {
