        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dosya okunamadı. Hiçbir şey değiştirilmedi."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося прочитати файл. Нічого не змінено."
