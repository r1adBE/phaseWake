        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "“தூங்குவதைத் தானாகக் கண்டறி” இயக்கு – அப்போது நீ எப்போது தூங்கினாய் என்பதைக் கடிகாரமே கண்டறியும், இரவுகள் கணக்கில் வரும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "“నిద్రపోవడాన్ని ఆటోమేటిక్‌గా గుర్తించు” ఆన్ చెయ్యి – అప్పుడు నువ్వు ఎప్పుడు నిద్రపోయావో వాచ్ స్వయంగా గుర్తిస్తుంది, రాత్రులు లెక్కలోకి వస్తాయి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปิด “ตรวจจับการหลับโดยอัตโนมัติ” – แล้วนาฬิกาจะตรวจจับเองว่าคุณหลับเมื่อไร และนับคืนให้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "“Uykuya dalmayı otomatik algıla” seçeneğini aç – böylece saat ne zaman uykuya daldığını kendisi algılar ve geceler sayılır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Увімкни «Автоматично визначати засинання» – тоді годинник сам визначатиме, коли ти засинаєш, і ночі зараховуватимуться."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "“سو جانے کا خودکار طور پر پتا لگائیں” آن کرو – پھر گھڑی خود پتا لگائے گی کہ تم کب سوئے، اور راتیں گنی جائیں گی۔"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "«Uxlab qolishni avtomatik aniqlash» funksiyasini yoq – shunda soat qachon uxlab qolganingni o‘zi aniqlaydi va tunlar hisoblanadi."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy bật “Tự động nhận biết khi bạn ngủ thiếp đi” – khi đó đồng hồ sẽ tự nhận biết lúc bạn ngủ thiếp đi, và các đêm được tính."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟「自動偵測入睡」——咁手錶會自己偵測你幾時瞓着，啲晚亦會計入。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开“自动检测入睡”——这样手表会自己检测你何时入睡，夜晚也会被计入。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟「自動偵測入睡」——這樣手錶會自己偵測你何時入睡，夜晚也會被計入。"
          }
        },
        "zu": {
          "stringUnit": {
            "state": "translated",
            "value": "Vula “Bona ngokuzenzakalela lapho ulala” – khona-ke iwashi lizobona ngokwalo lapho ulala, futhi ubusuku buzobalwa."
          }
        }
      }
    },
