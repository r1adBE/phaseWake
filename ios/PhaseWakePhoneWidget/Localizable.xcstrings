          }
        },
        "zu": {
          "stringUnit": {
            "state": "translated",
            "value": "Setha isikhathi nesikhala sokuvuka. Iwashi lakho likuvusa ngaphakathi kwaso lapho uqala ukungazinzi."
          }
        }
      }
    },
