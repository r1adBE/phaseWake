    "sunrise_text": {
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Jou skerm word stadig helderder totdat jy wakker word."
          }
        },
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "እስኪነቁ ድረስ ማያ ገጽዎ ቀስ በቀስ ይደምቃል።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تزداد الشاشة سطوعًا ببطء حتى تستيقظ."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Oyanana qədər ekranın yavaş-yavaş işıqlanır."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Екранът бавно става по-светъл, докато се събудиш."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "তুমি জেগে না ওঠা পর্যন্ত স্ক্রিন ধীরে ধীরে উজ্জ্বল হয়।"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekran polako postaje svjetliji dok se ne probudiš."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "La pantalla es va il·luminant a poc a poc fins que et despertes."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Displej se pomalu rozjasňuje, dokud se neprobudíš."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Skærmen bliver langsomt lysere, indtil du vågner."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Bildschirm wird langsam heller, bis du geweckt wirst."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η οθόνη φωτίζεται σιγά σιγά μέχρι να ξυπνήσεις."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your screen slowly gets brighter until you wake up."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La pantalla se va iluminando poco a poco hasta que te despiertes."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekraan muutub aeglaselt heledamaks, kuni sa ärkad."
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "Pantaila poliki argitzen da esnatu arte."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "صفحه کم‌کم روشن‌تر می‌شود تا بیدار شوی."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Näyttö kirkastuu hitaasti, kunnes heräät."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Unti-unting lumiliwanag ang screen mo hanggang magising ka."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’écran devient peu à peu plus lumineux jusqu’à ton réveil."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Éiríonn do scáileán níos gile go mall go dtí go ndúisíonn tú."
          }
        },
        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "A pantalla vaise iluminando aos poucos ata que espertes."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તમે જાગો ત્યાં સુધી તમારી સ્ક્રીન ધીમે ધીમે તેજ થાય છે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "המסך מתבהר לאט עד שתתעוררו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके जागने तक स्क्रीन धीरे-धीरे तेज़ होती जाती है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaslon polako postaje svjetliji dok se ne probudiš."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A képernyő lassan egyre világosabb lesz, amíg fel nem ébredsz."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Էկրանդ դանդաղ պայծառանում է, մինչև արթնանաս։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Layar perlahan menjadi lebih terang sampai kamu bangun."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Skjárinn verður hægt bjartari þar til þú vaknar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo schermo diventa lentamente più luminoso finché non ti svegli."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "起きるまで、画面がゆっくり明るくなります。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ეკრანი ნელ-ნელა ნათდება, სანამ არ გაიღვიძებ."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Оянғанша экран баяу жарықтана береді."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "អេក្រង់ភ្លឺបន្តិចម្ដងៗ រហូតដល់អ្នកភ្ញាក់។"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನೀವು ಏಳುವವರೆಗೆ ಪರದೆ ನಿಧಾನವಾಗಿ ಪ್ರಕಾಶಮಾನವಾಗುತ್ತದೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "깨어날 때까지 화면이 서서히 밝아져요."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ໜ້າຈໍຄ່ອຍໆສະຫວ່າງຂຶ້ນຈົນກວ່າເຈົ້າຈະຕື່ນ"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekranas pamažu šviesėja, kol pabundi."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekrāns lēnām kļūst gaišāks, līdz tu pamosties."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Екранот полека станува посветол додека не се разбудиш."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങൾ ഉണരുന്നതുവരെ സ്‌ക്രീൻ പതിയെ തെളിഞ്ഞുവരും."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Чамайг сэртэл дэлгэц аажмаар гэрэлтэнэ."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुम्ही उठेपर्यंत तुमची स्क्रीन हळूहळू उजळत जाते."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Skrin perlahan-lahan menjadi lebih cerah sehingga awak bangun."
          }
        },
        "my": {
          "stringUnit": {
            "state": "translated",
            "value": "နိုးလာသည်အထိ မျက်နှာပြင် ဖြည်းဖြည်းချင်း လင်းလာမည်။"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Skjermen blir sakte lysere helt til du våkner."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "तिमी नब्युँझेसम्म स्क्रिन बिस्तारै उज्यालो हुँदै जान्छ।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je scherm wordt langzaam helderder tot je wakker wordt."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਤੁਹਾਡੇ ਜਾਗਣ ਤੱਕ ਤੁਹਾਡੀ ਸਕ੍ਰੀਨ ਹੌਲੀ-ਹੌਲੀ ਚਮਕਦਾਰ ਹੁੰਦੀ ਜਾਂਦੀ ਹੈ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekran powoli się rozjaśnia, aż się obudzisz."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A tela fica mais clara aos poucos até você acordar."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O ecrã fica mais claro aos poucos até acordares."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ecranul devine treptat mai luminos până te trezești."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Экран медленно становится ярче, пока ты не проснёшься."
          }
        },
        "si": {
          "stringUnit": {
            "state": "translated",
            "value": "ඔබ අවදි වන තුරු තිරය සෙමින් දීප්තිමත් වේ."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Obrazovka pomaly svetlie, kým sa nezobudíš."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaslon počasi postaja svetlejši, dokler se ne zbudiš."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekrani ndriçohet ngadalë derisa të zgjohesh."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Екран полако постаје светлији док се не пробудиш."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Skärmen blir långsamt ljusare tills du vaknar."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Skrini yako inang’aa polepole hadi uamke."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நீங்கள் எழும் வரை திரை மெதுவாகப் பிரகாசமாகும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీరు మేల్కొనే వరకు మీ స్క్రీన్ నెమ్మదిగా ప్రకాశవంతమవుతుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หน้าจอจะค่อย ๆ สว่างขึ้นจนกว่าคุณจะตื่น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sen uyanana kadar ekran yavaşça parlaklaşır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Екран повільно яскравішає, поки ти не прокинешся."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "تمہارے جاگنے تک اسکرین آہستہ آہستہ روشن ہوتی جاتی ہے۔"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygʻonguningcha ekraning asta-sekin yorishadi."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Màn hình sáng dần cho đến khi bạn thức dậy."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "螢幕會慢慢變亮，直至你醒來。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
