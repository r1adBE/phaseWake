        }
      }
    },
    "sound_rec_permission": {
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Om op te neem, het Phase Wake die mikrofoon nodig. Dit luister net terwyl opname aan is."
          }
        },
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "ለመቅዳት Phase Wake ማይክሮፎኑን ይፈልጋል። የሚያዳምጠው መቅዳት ሲበራ ብቻ ነው።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "للتسجيل يحتاج Phase Wake إلى الميكروفون. لا يستمع إلا أثناء التسجيل."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Yazmaq üçün Phase Wake-ə mikrofon lazımdır. O, yalnız yazma açıq olanda dinləyir."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "За записа Phase Wake има нужда от микрофона. Слуша само докато записът е включен."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "রেকর্ড করতে Phase Wake-এর মাইক্রোফোন লাগবে। রেকর্ডিং চালু থাকলেই শুধু শোনে।"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Za snimanje Phase Wake treba mikrofon. Sluša samo dok je snimanje uključeno."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Per enregistrar, Phase Wake necessita el micròfon. Només escolta mentre l’enregistrament està activat."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "K nahrávání potřebuje Phase Wake mikrofon. Poslouchá jen, dokud nahrávání běží."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "For at optage skal Phase Wake bruge mikrofonen. Den lytter kun, mens optagelsen kører."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für die Aufnahme braucht Phase Wake das Mikrofon. Es hört nur zu, solange die Aufnahme läuft."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Για την καταγραφή το Phase Wake χρειάζεται το μικρόφωνο. Ακούει μόνο όσο τρέχει η καταγραφή."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To record, Phase Wake needs the microphone. It only listens while recording is on."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para grabar, Phase Wake necesita el micrófono. Solo escucha mientras la grabación está activa."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Salvestamiseks vajab Phase Wake mikrofoni. See kuulab ainult siis, kui salvestamine on sees."
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "Grabatzeko, Phase Wake-k mikrofonoa behar du. Grabazioa aktibatuta dagoenean bakarrik entzuten du."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "برای ضبط، Phase Wake به میکروفون نیاز دارد. فقط تا وقتی ضبط روشن است گوش می‌دهد."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tallentamiseen Phase Wake tarvitsee mikrofonin. Se kuuntelee vain tallennuksen aikana."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Para makapag-record, kailangan ng Phase Wake ang mikropono. Nakikinig lang ito habang naka-on ang pagre-record."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour enregistrer, Phase Wake a besoin du micro. Il n’écoute que pendant l’enregistrement."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Chun taifeadadh, teastaíonn an micreafón ó Phase Wake. Ní éisteann sé ach fad atá an taifeadadh ar siúl."
          }
        },
        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "Para gravar, Phase Wake necesita o micrófono. Só escoita mentres a gravación está activada."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "રેકોર્ડ કરવા માટે Phase Wakeને માઇક્રોફોનની જરૂર છે. રેકોર્ડિંગ ચાલુ હોય ત્યારે જ તે સાંભળે છે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כדי להקליט, Phase Wake צריך את המיקרופון. הוא מקשיב רק כשההקלטה פועלת."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रिकॉर्ड करने के लिए Phase Wake को माइक्रोफ़ोन चाहिए। यह सिर्फ़ रिकॉर्डिंग के दौरान सुनता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Za snimanje Phase Wake treba mikrofon. Sluša samo dok je snimanje uključeno."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A rögzítéshez a Phase Wake-nek kell a mikrofon. Csak a rögzítés alatt figyel."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ձայնագրելու համար Phase Wake-ին պետք է խոսափող։ Այն լսում է միայն, երբ ձայնագրումը միացված է։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Untuk merekam, Phase Wake butuh mikrofon. Mikrofon hanya mendengar selama perekaman aktif."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Til að taka upp þarf Phase Wake hljóðnemann. Hann hlustar aðeins á meðan upptaka er á."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per registrare, Phase Wake ha bisogno del microfono. Ascolta solo mentre la registrazione è attiva."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "録音にはマイクが必要です。録音中だけ聞き取ります。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ჩასაწერად Phase Wake-ს მიკროფონი სჭირდება. ის მხოლოდ მაშინ უსმენს, როცა ჩაწერა ჩართულია."
