    "channel_sunrise_description": {
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Verlig jou skerm soos ’n sonsopkoms voordat jy wakker word."
          }
        },
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "ከመንቃትዎ በፊት ማያ ገጽዎን እንደ ፀሐይ መውጫ ያበራል።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يضيء شاشتك مثل شروق الشمس قبل أن تستيقظ."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Oyanmazdan əvvəl ekranını gündoğumu kimi işıqlandırır."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Осветява екрана като изгрев преди събуждането."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "জাগার আগে তোমার স্ক্রিন সূর্যোদয়ের মতো আলোকিত করে।"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Osvjetljava ekran poput izlaska sunca prije buđenja."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Il·lumina la pantalla com una sortida del sol abans de despertar-te."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Rozsvítí displej jako východ slunce, než se probudíš."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tænder skærmen som en solopgang, før du vågner."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lässt den Bildschirm vor dem Wecken wie einen Sonnenaufgang leuchten."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Φωτίζει την οθόνη σου σαν ανατολή ηλίου πριν ξυπνήσεις."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lights up your screen like a sunrise before you wake."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ilumina tu pantalla como un amanecer antes de despertarte."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Valgustab enne ärkamist ekraani nagu päikesetõus."
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "Esnatu aurretik pantaila argitzen du, egunsenti bat bezala."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "پیش از بیدار شدنت، صفحه را مثل طلوع خورشید روشن می‌کند."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Valaisee näytön kuin auringonnousun ennen heräämistäsi."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Pinapaliwanag ang screen mo na parang pagsikat ng araw bago ka gumising."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Illumine ton écran comme un lever de soleil avant ton réveil."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Lasann sé do scáileán cosúil le héirí gréine sula ndúisíonn tú."
          }
        },
        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ilumina a pantalla coma un amencer antes de espertares."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તમે જાગો તે પહેલાં તમારી સ્ક્રીનને સૂર્યોદયની જેમ પ્રકાશિત કરે છે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מאיר את המסך כמו זריחה לפני שתתעוררו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जगाने से पहले आपकी स्क्रीन को सूर्योदय की तरह रोशन करता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Osvjetljava zaslon poput izlaska sunca prije buđenja."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Napfelkeltéhez hasonlóan világítja meg a képernyőt ébredés előtt."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Արթնանալուց առաջ էկրանդ լուսավորում է արևածագի պես։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menyalakan layar seperti matahari terbit sebelum kamu bangun."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Lýsir upp skjáinn eins og sólarupprás áður en þú vaknar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Illumina lo schermo come un’alba prima che ti svegli."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "起きる前に、日の出のように画面を明るくします。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "გაღვიძებამდე ეკრანს მზის ამოსვლასავით ანათებს."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Оянар алдында экранды күннің шығуындай жарықтандырады."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "បំភ្លឺអេក្រង់ដូចថ្ងៃរះ មុនពេលអ្នកភ្ញាក់។"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನೀವು ಏಳುವ ಮೊದಲು ಸೂರ್ಯೋದಯದಂತೆ ಪರದೆಯನ್ನು ಬೆಳಗಿಸುತ್ತದೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "깨우기 전에 화면을 일출처럼 밝혀요."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ເຮັດໃຫ້ໜ້າຈໍສະຫວ່າງຄືຕາເວັນຂຶ້ນ ກ່ອນເຈົ້າຕື່ນ"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Prieš pabudimą apšviečia ekraną kaip saulėtekis."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Pirms pamošanās izgaismo ekrānu kā saullēkts."
