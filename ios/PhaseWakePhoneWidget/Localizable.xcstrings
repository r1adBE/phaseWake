    "watch_evening_reminder": {
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik om jou wekker vir vanaand te aktiveer."
          }
        },
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "ለዛሬ ሌሊት ማንቂያህን ለማዘጋጀት ንካ።"
          }
        },
        "ar": {
          "stringUnit": {
