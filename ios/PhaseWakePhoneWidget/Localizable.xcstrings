    "backup_password_hint": {
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Sonder hierdie wagwoord kan niemand die rugsteun oopmaak nie – selfs nie jy nie."
          }
        },
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "ያለዚህ የይለፍ ቃል ማንም ምትኬውን መክፈት አይችልም – እርስዎም ቢሆኑ።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "دون كلمة المرور هذه لا يستطيع أحد فتح النسخة – ولا أنت."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu parol olmadan ehtiyat nüsxəni heç kim aça bilməz – hətta sən də."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Без тази парола никой не може да отвори копието – дори ти."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই পাসওয়ার্ড ছাড়া কেউ ব্যাকআপ খুলতে পারবে না – তুমিও না।"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Bez ove lozinke niko ne može otvoriti sigurnosnu kopiju – čak ni ti."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Sense aquesta contrasenya, ningú no pot obrir la còpia – ni tan sols tu."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Bez tohoto hesla zálohu nikdo neotevře – ani ty."
