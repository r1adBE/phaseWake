    "stages_source": {
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Riglyne vir gesonde volwassenes (Ohayon e.a., Sleep 2004). Horlosies skat fases net rofweg."
          }
        },
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "ለጤናማ አዋቂዎች የማጣቀሻ ክልሎች (Ohayon እና ሌሎች፣ Sleep 2004)። ሰዓቶች ደረጃዎችን በግምት ብቻ ይገምታሉ።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قيم مرجعية للبالغين الأصحاء (Ohayon وآخرون، Sleep 2004). الساعات تقدّر المراحل تقديرًا تقريبيًا فقط."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Sağlam yetkinlər üçün istinad dəyərləri (Ohayon və b., Sleep 2004). Saatlar mərhələləri yalnız təxminən qiymətləndirir."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ориентировъчни стойности за здрави възрастни (Ohayon и др., Sleep 2004). Часовниците оценяват фазите само приблизително."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সুস্থ প্রাপ্তবয়স্কদের জন্য নির্দেশক মান (Ohayon ও অন্যান্য, Sleep 2004)। ঘড়ি ঘুমের পর্যায় শুধু মোটামুটি অনুমান করে।"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Referentne vrijednosti za zdrave odrasle (Ohayon i sar., Sleep 2004). Satovi faze procjenjuju samo okvirno."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Valors de referència per a adults sans (Ohayon et al., Sleep 2004). Els rellotges només estimen les fases de manera aproximada."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Orientační hodnoty pro zdravé dospělé (Ohayon a kol., Sleep 2004). Hodinky fáze odhadují jen přibližně."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Referenceværdier for raske voksne (Ohayon m.fl., Sleep 2004). Ure anslår kun faserne groft."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Richtwerte für gesunde Erwachsene (Ohayon u. a., Sleep 2004). Uhren schätzen Phasen nur ungefähr."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τιμές αναφοράς για υγιείς ενήλικες (Ohayon κ.ά., Sleep 2004). Τα ρολόγια εκτιμούν τις φάσεις μόνο κατά προσέγγιση."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reference ranges for healthy adults (Ohayon et al., Sleep 2004). Watches only estimate stages roughly."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Valores de referencia para adultos sanos (Ohayon et al., Sleep 2004). Los relojes solo estiman las fases de forma aproximada."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Võrdlusväärtused tervetele täiskasvanutele (Ohayon jt, Sleep 2004). Kellad hindavad unefaase vaid ligikaudu."
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "Erreferentziazko balioak heldu osasuntsuentzat (Ohayon et al., Sleep 2004). Erlojuek faseak gutxi gorabehera baino ez dituzte kalkulatzen."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "مقادیر مرجع برای بزرگسالان سالم (Ohayon و همکاران، Sleep 2004). ساعت‌ها مراحل خواب را فقط تقریبی تخمین می‌زنند."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Viitearvot terveille aikuisille (Ohayon ym., Sleep 2004). Kellot arvioivat univaiheet vain karkeasti."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Mga sanggunian para sa malulusog na adulto (Ohayon et al., Sleep 2004). Halos lang ang tantiya ng mga relo sa mga yugto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Valeurs de référence pour adultes en bonne santé (Ohayon et al., Sleep 2004). Les montres n’estiment les phases qu’approximativement."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Luachanna tagartha do dhaoine fásta sláintiúla (Ohayon et al., Sleep 2004). Ní dhéanann uaireadóirí ach meastachán garbh ar na céimeanna."
          }
        },
        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "Valores de referencia para adultos sans (Ohayon et al., Sleep 2004). Os reloxos só estiman as fases de xeito aproximado."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "સ્વસ્થ પુખ્ત વયના લોકો માટે સંદર્ભ મૂલ્યો (Ohayon વગેરે, Sleep 2004). ઘડિયાળો તબક્કાઓનો માત્ર અંદાજ લગાવે છે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ערכי ייחוס למבוגרים בריאים (Ohayon ועמיתים, Sleep 2004). שעונים מעריכים שלבי שינה רק בקירוב."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्वस्थ वयस्कों के लिए संदर्भ मान (Ohayon व अन्य, Sleep 2004)। वॉच चरणों का केवल मोटा अनुमान लगाती हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Referentne vrijednosti za zdrave odrasle (Ohayon i sur., Sleep 2004). Satovi faze procjenjuju samo okvirno."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Irányértékek egészséges felnőtteknek (Ohayon és mtsai, Sleep 2004). Az órák csak durván becslik a fázisokat."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ուղենիշային արժեքներ առողջ մեծահասակների համար (Ohayon և ուրիշներ, Sleep 2004)։ Ժամացույցները փուլերը գնահատում են միայն մոտավորապես։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Nilai acuan untuk orang dewasa sehat (Ohayon dkk., Sleep 2004). Jam tangan hanya memperkirakan tahap tidur secara kasar."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Viðmiðunargildi fyrir heilbrigða fullorðna (Ohayon o.fl., Sleep 2004). Úr áætla svefnstig aðeins gróflega."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Valori di riferimento per adulti sani (Ohayon et al., Sleep 2004). Gli orologi stimano le fasi solo in modo approssimativo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "健康な成人の目安（Ohayon ほか、Sleep 2004）。ウォッチは睡眠段階をおおまかに推定するだけです。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "საორიენტაციო მნიშვნელობები ჯანმრთელი ზრდასრულებისთვის (Ohayon და სხვ., Sleep 2004). საათები ფაზებს მხოლოდ მიახლოებით აფასებს."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сау ересектерге арналған бағдарлы мәндер (Ohayon және т.б., Sleep 2004). Сағаттар кезеңдерді тек шамамен бағалайды."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "តម្លៃយោងសម្រាប់មនុស្សពេញវ័យដែលមានសុខភាពល្អ (Ohayon និងអ្នកដទៃ, Sleep 2004)។ នាឡិកាគ្រាន់តែប៉ាន់ស្មានដំណាក់កាលប្រហាក់ប្រហែល។"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಆರೋಗ್ಯವಂತ ವಯಸ್ಕರಿಗೆ ಉಲ್ಲೇಖ ಮೌಲ್ಯಗಳು (Ohayon ಮತ್ತು ಇತರರು, Sleep 2004). ವಾಚ್‌ಗಳು ಹಂತಗಳನ್ನು ಸ್ಥೂಲವಾಗಿ ಮಾತ್ರ ಅಂದಾಜಿಸುತ್ತವೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "건강한 성인 기준값(Ohayon 외, Sleep 2004). 워치는 수면 단계를 대략적으로만 추정해요."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ຄ່າອ້າງອີງສຳລັບຜູ້ໃຫຍ່ທີ່ມີສຸຂະພາບດີ (Ohayon ແລະ ຄະນະ, Sleep 2004). ໂມງປະເມີນໄລຍະການນອນແບບປະມານເທົ່ານັ້ນ."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Orientacinės vertės sveikiems suaugusiesiems (Ohayon ir kt., Sleep 2004). Laikrodžiai fazes įvertina tik apytiksliai."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Atsauces vērtības veseliem pieaugušajiem (Ohayon u. c., Sleep 2004). Pulksteņi fāzes novērtē tikai aptuveni."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Референтни вредности за здрави возрасни (Ohayon и др., Sleep 2004). Часовниците фазите ги проценуваат само приближно."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ആരോഗ്യമുള്ള മുതിർന്നവർക്കുള്ള സൂചക മൂല്യങ്ങൾ (Ohayon തുടങ്ങിയവർ, Sleep 2004). വാച്ചുകൾ ഘട്ടങ്ങൾ ഏകദേശം മാത്രമേ കണക്കാക്കൂ."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Эрүүл насанд хүрэгчдийн жишиг утга (Ohayon нар, Sleep 2004). Цагнууд үе шатыг зөвхөн ойролцоогоор тооцоолдог."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "निरोगी प्रौढांसाठी संदर्भ मूल्ये (Ohayon आणि इतर, Sleep 2004). घड्याळे टप्प्यांचा फक्त ढोबळ अंदाज लावतात."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Nilai rujukan untuk orang dewasa sihat (Ohayon et al., Sleep 2004). Jam tangan hanya menganggar peringkat tidur secara kasar."
          }
        },
        "my": {
          "stringUnit": {
            "state": "translated",
            "value": "ကျန်းမာသော လူကြီးများအတွက် ကိုးကားတန်ဖိုးများ (Ohayon နှင့်အဖွဲ့, Sleep 2004)။ နာရီများသည် အဆင့်များကို အကြမ်းဖျင်းသာ ခန့်မှန်းနိုင်သည်။"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Referanseverdier for friske voksne (Ohayon mfl., Sleep 2004). Klokker anslår fasene bare grovt."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "स्वस्थ वयस्कहरूका लागि सन्दर्भ मानहरू (Ohayon र अन्य, Sleep 2004)। घडीहरूले चरणहरू मोटामोटी मात्र अनुमान गर्छन्।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Richtwaarden voor gezonde volwassenen (Ohayon e.a., Sleep 2004). Horloges schatten fasen maar ruwweg in."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਤੰਦਰੁਸਤ ਬਾਲਗਾਂ ਲਈ ਹਵਾਲਾ ਮੁੱਲ (Ohayon ਅਤੇ ਹੋਰ, Sleep 2004)। ਘੜੀਆਂ ਪੜਾਵਾਂ ਦਾ ਸਿਰਫ਼ ਮੋਟਾ ਅੰਦਾਜ਼ਾ ਲਾਉਂਦੀਆਂ ਹਨ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wartości orientacyjne dla zdrowych dorosłych (Ohayon i in., Sleep 2004). Zegarki szacują fazy tylko w przybliżeniu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Valores de referência para adultos saudáveis (Ohayon et al., Sleep 2004). Relógios só estimam as fases de forma aproximada."
