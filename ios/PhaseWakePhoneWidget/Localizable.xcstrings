        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uključi „Automatski prepoznaj uspavljivanje“ – tada sat sam prepoznaje kada zaspiš, i noći se broje."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kapcsold be: „Elalvás automatikus felismerése” – így az óra magától felismeri, mikor alszol el, és az éjszakák számítanak."
