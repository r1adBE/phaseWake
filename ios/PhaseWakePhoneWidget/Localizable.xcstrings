    "feeling_hint": {
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Met tyd sien jy of dit jou goed doen om vroeër wakker gemaak te word."
          }
        },
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "ከጊዜ በኋላ ቀደም ብሎ መቀስቀስ ይጠቅምዎት እንደሆነ ያያሉ።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مع الوقت سترى ما إذا كان الإيقاظ الأبكر يفيدك."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Zamanla daha tez oyanmağın sənə xeyir edib-etmədiyini görəcəksən."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "С времето ще видиш дали по-ранното събуждане ти се отразява добре."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সময়ের সঙ্গে দেখবে আগে জাগানো তোমার জন্য ভালো কি না।"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "S vremenom ćeš vidjeti godi li ti ranije buđenje."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Amb el temps veuràs si despertar-te abans et fa bé."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Časem uvidíš, jestli ti dřívější buzení dělá dobře."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Med tiden kan du se, om det gør dig godt at blive vækket tidligere."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "So siehst du mit der Zeit, ob dir das frühere Wecken guttut."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Με τον καιρό θα δεις αν σου κάνει καλό το νωρίτερο ξύπνημα."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Over time you’ll see whether waking earlier does you good."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Con el tiempo verás si despertar antes te sienta bien."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Aja jooksul näed, kas varasem äratus teeb sulle head."
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "Denborarekin ikusiko duzu lehenago esnatzeak onura ematen dizun."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "با گذشت زمان می‌بینی که زودتر بیدارشدن برایت خوب است یا نه."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajan myötä näet, tekeekö aiempi herätys sinulle hyvää."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Sa paglipas ng panahon, makikita mo kung nakakabuti sa iyo ang mas maagang paggising."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avec le temps, tu verras si un réveil plus tôt te fait du bien."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Le himeacht ama feicfidh tú an ndéanann dúiseacht níos luaithe maitheas duit."
          }
        },
        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "Co tempo verás se espertar antes che senta ben."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "સમય જતાં તમે જોશો કે વહેલા જાગવું તમને ફાયદો કરે છે કે નહીં."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "עם הזמן תראו אם השכמה מוקדמת יותר עושה לכם טוב."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "समय के साथ आप देखेंगे कि पहले जगना आपके लिए अच्छा है या नहीं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "S vremenom ćeš vidjeti godi li ti ranije buđenje."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Idővel látni fogod, jót tesz-e neked a korábbi ébresztés."
          }
        },
        "hy": {
