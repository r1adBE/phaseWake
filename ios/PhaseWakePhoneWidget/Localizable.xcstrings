        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Per %1$lld iš paskutinių %2$lld naktų lange nebuvo tinkamo momento. Su %3$lld min dažniau pabusi tinkamu metu."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
