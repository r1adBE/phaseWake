        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy để đồng hồ bật và kết nối với điện thoại – đồng hồ gửi bản ghi sau báo thức."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "保持手錶開機同連住手機——佢會喺鬧鐘之後傳送記錄。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
