        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Здесь могут появляться и ночи из приложения Apple Health и других приложений. Чтобы их увидеть, включи сверку с данными о здоровье."
          }
        },
        "si": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Health සහ වෙනත් යෙදුම්වල රාත්‍රීද මෙහි පෙන්විය හැක. ඒවා බැලීමට, සෞඛ්‍ය දත්ත සමඟ සසඳන්න."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zobraziť sa tu môžu aj noci z aplikácie Apple Health a ďalších aplikácií. Ak ich chceš vidieť, porovnaj so zdravotnými údajmi."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu se lahko prikažejo tudi noči iz aplikacije Apple Health in drugih aplikacij. Če jih želiš videti, primerjaj z zdravstvenimi podatki."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Këtu mund të shfaqen edhe net nga Apple Health dhe aplikacione të tjera. Për t’i parë, krahaso me të dhënat e shëndetit."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Овде се могу приказати и ноћи из апликације Apple Health и других апликација. Да их видиш, упореди са здравственим подацима."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Nätter från Apple Health och andra appar kan också visas här. Jämför med hälsodata för att se dem."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Usiku kutoka Apple Health na programu nyingine unaweza pia kuonekana hapa. Ili kuuona, linganisha na data ya afya."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Health மற்றும் பிற ஆப்களின் இரவுகளும் இங்கே தோன்றலாம். அவற்றைப் பார்க்க, ஆரோக்கியத் தரவுடன் ஒப்பிடுங்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Health మరియు ఇతర యాప్‌ల రాత్రులు కూడా ఇక్కడ కనిపించవచ్చు. వాటిని చూడటానికి, హెల్త్ డేటాతో పోల్చండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คืนจาก Apple Health และแอปอื่นก็แสดงที่นี่ได้ หากต้องการดู ให้เปรียบเทียบกับข้อมูลสุขภาพ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Health ve diğer uygulamalardaki geceler de burada görünebilir. Onları görmek için sağlık verileriyle karşılaştır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тут можуть з'являтися й ночі із застосунку Apple Health та інших застосунків. Щоб їх побачити, увімкни звіряння з даними про здоров'я."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Health اور دوسری ایپس کی راتیں بھی یہاں دکھ سکتی ہیں۔ انہیں دیکھنے کے لیے صحت کے ڈیٹا سے موازنہ کرو۔"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu yerda Apple Health va boshqa ilovalardagi tunlar ham chiqishi mumkin. Ularni koʻrish uchun sogʻliq maʼlumotlari bilan solishtir."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các đêm từ Apple Health và ứng dụng khác cũng có thể hiện ở đây. Để xem, hãy so sánh với dữ liệu sức khỏe."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "來自 Apple Health 及其他 App 的晚上也可以在這裏顯示。如要查看，請與健康數據比對。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "来自 Apple Health 和其他应用的夜晚也可以显示在这里。要查看它们，请与健康数据对比。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "來自 Apple Health 和其他 App 的夜晚也能顯示在這裡。若要查看，請與健康資料比對。"
          }
        },
        "zu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ubusuku obuvela ku-Apple Health nakwamanye ama-app nabo bungavela lapha. Ukuze ububone, qhathanisa nedatha yezempilo."
          }
        }
      }
    },
    "history_empty_no_data": {
