            "value": "ግምታዊ በዓል: %1$@ – ማንቂያው ይደውላል። ዕረፍት ከሆንክ ቀኑን ራስህ ዝለል።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عطلة تقديرية: %1$@ – سيرنّ المنبّه. إن كان يوم عطلتك فتخطَّه بنفسك."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Təxmini bayram: %1$@ – zəngli saat çalacaq. İstirahət günündürsə, günü özün ötür."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Приблизителен празник: %1$@ – алармата ще звъни. Ако почиваш, пропусни деня сам."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আনুমানিক ছুটি: %1$@ – অ্যালার্ম বাজবে। ছুটি থাকলে দিনটি নিজেই এড়িয়ে যাও।"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Procijenjeni praznik: %1$@ – alarm će zvoniti. Ako si slobodan, sam preskoči taj dan."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Festiu estimat: %1$@ – l’alarma sonarà. Si fas festa, omet el dia tu mateix."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Odhadovaný svátek: %1$@ – budík zazvoní. Pokud máš volno, přeskoč ten den sám."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Anslået helligdag: %1$@ – alarmen ringer. Har du fri, så spring dagen over selv."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geschätzter Feiertag: %1$@ – der Wecker klingelt. Hast du frei, überspring den Tag selbst."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Εκτιμώμενη αργία: %1$@ – το ξυπνητήρι θα χτυπήσει. Αν έχεις ρεπό, παράλειψε μόνος σου την ημέρα."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Estimated holiday: %1$@ – the alarm rings. If you have the day off, skip it yourself."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Festivo estimado: %1$@ – la alarma sonará. Si libras, salta el día tú mismo."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Hinnanguline püha: %1$@ – äratus heliseb. Kui sul on vaba päev, jäta see ise vahele."
