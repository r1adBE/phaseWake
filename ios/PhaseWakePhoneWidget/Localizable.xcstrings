        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Пред будењето го осветлува екранот како изгрејсонце."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഉണരുന്നതിന് മുമ്പ് സൂര്യോദയം പോലെ സ്‌ക്രീൻ പ്രകാശിപ്പിക്കും."
