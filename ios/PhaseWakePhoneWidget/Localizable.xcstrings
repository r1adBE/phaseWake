        },
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "ማወቂያውን ለማረጋገጥና ለማሻሻል ከነቁ በኋላ የእንቅልፍ ደረጃዎችን ከHealth Connect ያነባል።"
