        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "სავარაუდო დღესასწაული: %1$@ – მაღვიძარა დარეკავს. თუ დასვენების დღეა, თავად გამოტოვე."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Болжамды мереке: %1$@ – оятқыш шырылдайды. Демалыс болса, күнді өзің өткізіп жібер."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ថ្ងៃឈប់សម្រាកប៉ាន់ស្មាន៖ %1$@ – នាឡិការោទិ៍នឹងរោទ៍។ បើអ្នកឈប់សម្រាក សូមរំលងថ្ងៃនោះដោយខ្លួនឯង។"
