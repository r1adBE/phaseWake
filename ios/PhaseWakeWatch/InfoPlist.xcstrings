        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake-k zure mugimendua eta bihotz-maiztasuna neurtzen ditu esnatze-leihoan, une egokian esnatzeko."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake در بازه بیدارسازی حرکت و ضربان قلبت را اندازه می‌گیرد تا در لحظهٔ مناسبی بیدارت کند."
