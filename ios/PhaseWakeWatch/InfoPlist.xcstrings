        "si": {
          "stringUnit": {
            "state": "translated",
            "value": "හොඳ මොහොතක ඔබව අවදි කිරීමට Phase Wake අවදි පරාසය තුළ ඔබේ චලනය සහ හෘද ස්පන්දනය මනියි."
