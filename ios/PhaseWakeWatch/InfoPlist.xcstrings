{
  "sourceLanguage": "en",
  "strings": {
    "NSHealthShareUsageDescription": {
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake meet jou beweging en hartklop in die wekvenster om jou op ’n goeie oomblik wakker te maak."
          }
        },
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake በጥሩ ጊዜ ለመቀስቀስዎ በመቀስቀሻ ክልሉ ውስጥ እንቅስቃሴዎን እና የልብ ምትዎን ይለካል።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يقيس Phase Wake حركتك ومعدل نبضات قلبك خلال فترة الاستيقاظ ليوقظك في لحظة مناسبة."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake səni yaxşı anda oyatmaq üçün oyanma pəncərəsində hərəkətini və nəbzini ölçür."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake измерва движенията и пулса ти в прозореца за събуждане, за да те събуди в подходящ момент."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ভালো মুহূর্তে তোমাকে জাগাতে Phase Wake জাগানোর সময়সীমায় তোমার নড়াচড়া ও হৃদস্পন্দন মাপে।"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake mjeri tvoje pokrete i puls u intervalu buđenja kako bi te probudio u dobrom trenutku."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake mesura el teu moviment i la teva freqüència cardíaca durant la finestra de despertar per despertar-te en un bon moment."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake měří tvůj pohyb a srdeční tep během okna buzení, aby tě probudil ve vhodnou chvíli."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake måler din bevægelse og puls i vækningsvinduet for at vække dig i et godt øjeblik."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake misst Bewegung und Puls in deinem Weckfenster, um dich in einem guten Moment zu wecken."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Phase Wake μετρά την κίνηση και τον καρδιακό σου ρυθμό κατά το παράθυρο αφύπνισης, για να σε ξυπνήσει την κατάλληλη στιγμή."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake mide tu movimiento y tu frecuencia cardíaca durante la ventana de despertar para despertarte en un buen momento."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake mõõdab äratusaknas sinu liikumist ja pulssi, et äratada sind heal hetkel."
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake-k zure mugimendua eta bihotz-maiztasuna neurtzen ditu esnatze-leihoan, une egokian esnatzeko."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake در بازه بیدارسازی حرکت و ضربان قلبت را اندازه می‌گیرد تا در لحظهٔ مناسبی بیدارت کند."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake mittaa liikettäsi ja sykettäsi heräämisikkunan aikana herättääkseen sinut sopivalla hetkellä."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Sinusukat ng Phase Wake ang galaw at heart rate mo sa window ng paggising para gisingin ka sa magandang sandali."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake mesure tes mouvements et ta fréquence cardiaque pendant la fenêtre de réveil pour te réveiller au bon moment."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Tomhaiseann Phase Wake do ghluaiseacht agus do ráta croí san fhuinneog dhúisithe chun tú a dhúiseacht ag nóiméad maith."
          }
        },
        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake mide o teu movemento e o teu pulso na xanela de espertar para espertarte nun bo momento."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "સારી ક્ષણે તમને જગાડવા Phase Wake જગાડવાના સમયગાળામાં તમારું હલનચલન અને હૃદયના ધબકારા માપે છે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "‏Phase Wake מודד את התנועה והדופק שלך בחלון ההתעוררות כדי להעיר אותך ברגע טוב."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake तुम्हें सही पल पर जगाने के लिए जागने की अवधि में तुम्हारी गतिविधि और हृदय गति मापता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake mjeri tvoje pokrete i puls u intervalu buđenja kako bi te probudio u dobrom trenutku."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Phase Wake az ébresztési ablak alatt méri a mozgásodat és a pulzusodat, hogy jó pillanatban ébresszen fel."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake-ը արթնացման պատուհանում չափում է շարժումներդ և սրտի զարկերդ՝ քեզ հարմար պահի արթնացնելու համար։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake mengukur gerakan dan detak jantungmu selama jendela bangun untuk membangunkanmu di saat yang tepat."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake mælir hreyfingu þína og púls í vakningarglugganum til að vekja þig á góðu augnabliki."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake misura i tuoi movimenti e la tua frequenza cardiaca durante la finestra di risveglio per svegliarti in un buon momento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wakeは、良いタイミングで起こすため、起床ウィンドウ中の動きと心拍数を測定します。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake გაღვიძების ფანჯარაში ზომავს შენს მოძრაობასა და პულსს, რათა კარგ მომენტში გაგაღვიძოს."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сені қолайлы сәтте ояту үшін Phase Wake ояту терезесінде қозғалысың мен жүрек соғысыңды өлшейді."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake វាស់ចលនា និងចង្វាក់បេះដូងរបស់អ្នកក្នុងចន្លោះពេលដាស់ ដើម្បីដាស់អ្នកនៅពេលល្អ។"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಸೂಕ್ತ ಕ್ಷಣದಲ್ಲಿ ನಿಮ್ಮನ್ನು ಎಬ್ಬಿಸಲು Phase Wake ಎಚ್ಚರಿಸುವ ಅವಧಿಯಲ್ಲಿ ನಿಮ್ಮ ಚಲನೆ ಮತ್ತು ಹೃದಯ ಬಡಿತವನ್ನು ಅಳೆಯುತ್ತದೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake는 좋은 순간에 깨우기 위해 기상 구간 동안 움직임과 심박수를 측정합니다."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake ວັດແທກການເຄື່ອນໄຫວ ແລະ ອັດຕາການເຕັ້ນຫົວໃຈຂອງເຈົ້າໃນຊ່ວງເວລາປຸກ ເພື່ອປຸກເຈົ້າໃນຈັງຫວະທີ່ດີ"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake žadinimo lange matuoja tavo judesius ir pulsą, kad pažadintų tave tinkamą akimirką."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake modināšanas logā mēra tavas kustības un pulsu, lai pamodinātu tevi piemērotā brīdī."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake ги мери твоите движења и пулс во прозорецот за будење за да те разбуди во добар момент."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നല്ല നിമിഷത്തിൽ നിങ്ങളെ ഉണർത്താൻ Phase Wake ഉണർത്തൽ സമയപരിധിയിൽ നിങ്ങളുടെ ചലനവും ഹൃദയമിടിപ്പും അളക്കുന്നു."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Чамайг тохиромжтой мөчид сэрээхийн тулд Phase Wake сэрээх хугацаанд хөдөлгөөн болон зүрхний цохилтыг чинь хэмжинэ."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुम्हाला योग्य क्षणी उठवण्यासाठी Phase Wake उठवण्याच्या कालावधीत तुमची हालचाल आणि हृदयगती मोजते."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake mengukur pergerakan dan kadar denyutan jantungmu semasa tetingkap bangun untuk mengejutkanmu pada saat yang sesuai."
          }
        },
        "my": {
          "stringUnit": {
            "state": "translated",
            "value": "သင့်တော်သည့်အချိန်တွင် နှိုးရန် Phase Wake သည် နှိုးချိန်အပိုင်းအတွင်း သင့်လှုပ်ရှားမှုနှင့် နှလုံးခုန်နှုန်းကို တိုင်းတာသည်။"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake måler bevegelsene og pulsen din i våknevinduet for å vekke deg i et godt øyeblikk."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "तिमीलाई राम्रो पलमा ब्युँझाउन Phase Wake ले ब्युँझाउने अवधिमा तिम्रो चाल र मुटुको धड्कन मापन गर्छ।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake meet je beweging en hartslag tijdens het wekvenster om je op een goed moment te wekken."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਤੁਹਾਨੂੰ ਸਹੀ ਪਲ ’ਤੇ ਜਗਾਉਣ ਲਈ Phase Wake ਜਗਾਉਣ ਦੀ ਮਿਆਦ ਵਿੱਚ ਤੁਹਾਡੀ ਹਿਲਜੁਲ ਅਤੇ ਦਿਲ ਦੀ ਧੜਕਣ ਮਾਪਦਾ ਹੈ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake mierzy twój ruch i tętno w oknie budzenia, aby obudzić cię w dobrym momencie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Phase Wake mede seus movimentos e batimentos cardíacos durante a janela de despertar para acordar você em um bom momento."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O Phase Wake mede os teus movimentos e a tua frequência cardíaca durante a janela de despertar para te acordar num bom momento."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake îți măsoară mișcările și pulsul în intervalul de trezire ca să te trezească într-un moment bun."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake измеряет твои движения и пульс в окне пробуждения, чтобы разбудить тебя в подходящий момент."
          }
        },
        "si": {
          "stringUnit": {
            "state": "translated",
            "value": "හොඳ මොහොතක ඔබව අවදි කිරීමට Phase Wake අවදි පරාසය තුළ ඔබේ චලනය සහ හෘද ස්පන්දනය මනියි."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake v okne budenia meria tvoj pohyb a tep, aby ťa zobudil vo vhodnej chvíli."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake v oknu bujenja meri tvoje gibanje in srčni utrip, da te zbudi ob pravem trenutku."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake mat lëvizjen dhe pulsin tënd gjatë intervalit të zgjimit për të të zgjuar në një moment të mirë."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake мери твоје покрете и пулс у интервалу буђења да би те пробудио у добром тренутку."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake mäter dina rörelser och din puls under väckningsfönstret för att väcka dig vid ett bra tillfälle."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake hupima mwendo wako na mapigo yako ya moyo katika kipindi cha kuamka ili ikuamshe wakati mzuri."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நல்ல தருணத்தில் உங்களை எழுப்ப, Phase Wake எழுப்பும் வரம்பில் உங்கள் அசைவையும் இதயத் துடிப்பையும் அளவிடும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మంచి క్షణంలో మిమ్మల్ని లేపడానికి Phase Wake నిద్రలేపే వ్యవధిలో మీ కదలికను, గుండె వేగాన్ని కొలుస్తుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake วัดการเคลื่อนไหวและอัตราการเต้นของหัวใจของคุณในช่วงเวลาปลุก เพื่อปลุกคุณในจังหวะที่ดี"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake, seni iyi bir anda uyandırmak için uyanma aralığında hareketlerini ve kalp atış hızını ölçer."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake вимірює твої рухи й пульс у вікні пробудження, щоб розбудити тебе в слушну мить."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "تمہیں اچھے لمحے پر جگانے کے لیے Phase Wake جاگنے کی ونڈو میں تمہاری حرکت اور دل کی دھڑکن ناپتا ہے۔"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Seni yaxshi lahzada uygʻotish uchun Phase Wake uygʻotish oraligʻida harakating va yurak urishingni oʻlchaydi."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake đo chuyển động và nhịp tim của bạn trong khung giờ thức dậy để đánh thức bạn vào thời điểm tốt."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake 會在喚醒時段內測量你的動作和心率，以便在合適的時機喚醒你。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake会在唤醒时段内测量你的动作和心率，以便在合适的时机唤醒你。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake會在喚醒時段內測量你的動作和心率，以便在合適的時機喚醒你。"
          }
        },
        "zu": {
          "stringUnit": {
            "state": "translated",
            "value": "I-Phase Wake ilinganisa ukunyakaza kwakho nokushaya kwenhliziyo yakho esikhaleni sokuvuka ukuze ikuvuse ngesikhathi esihle."
          }
        }
      }
    },
    "NSMotionUsageDescription": {
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake meet jou beweging en hartklop in die wekvenster om jou op ’n goeie oomblik wakker te maak."
          }
        },
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake በጥሩ ጊዜ ለመቀስቀስዎ በመቀስቀሻ ክልሉ ውስጥ እንቅስቃሴዎን እና የልብ ምትዎን ይለካል።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يقيس Phase Wake حركتك ومعدل نبضات قلبك خلال فترة الاستيقاظ ليوقظك في لحظة مناسبة."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake səni yaxşı anda oyatmaq üçün oyanma pəncərəsində hərəkətini və nəbzini ölçür."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake измерва движенията и пулса ти в прозореца за събуждане, за да те събуди в подходящ момент."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ভালো মুহূর্তে তোমাকে জাগাতে Phase Wake জাগানোর সময়সীমায় তোমার নড়াচড়া ও হৃদস্পন্দন মাপে।"
          }
