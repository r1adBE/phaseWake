        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake mjeri tvoje pokrete i puls u intervalu buđenja kako bi te probudio u dobrom trenutku."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake mesura el teu moviment i la teva freqüència cardíaca durant la finestra de despertar per despertar-te en un bon moment."
