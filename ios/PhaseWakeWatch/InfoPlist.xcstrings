        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "‏Phase Wake מודד את התנועה והדופק שלך בחלון ההתעוררות כדי להעיר אותך ברגע טוב."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake तुम्हें सही पल पर जगाने के लिए जागने की अवधि में तुम्हारी गतिविधि और हृदय गति मापता है।"
