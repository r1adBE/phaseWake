          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake mõõdab äratusaknas sinu liikumist, et tuvastada kerget und."
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
