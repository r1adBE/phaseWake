        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Чамайг тохиромжтой мөчид сэрээхийн тулд Phase Wake сэрээх хугацаанд хөдөлгөөн болон зүрхний цохилтыг чинь хэмжинэ."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुम्हाला योग्य क्षणी उठवण्यासाठी Phase Wake उठवण्याच्या कालावधीत तुमची हालचाल आणि हृदयगती मोजते."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake mengukur pergerakan dan kadar denyutan jantungmu semasa tetingkap bangun untuk mengejutkanmu pada saat yang sesuai."
