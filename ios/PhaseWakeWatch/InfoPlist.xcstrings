          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Phase Wake μετρά την κίνησή σου κατά το παράθυρο αφύπνισης για να εντοπίσει τον ελαφρύ ύπνο."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
