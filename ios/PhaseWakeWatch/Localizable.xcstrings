        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Watch: అలారం సక్రియంగా లేదు – నోటిఫికేషన్ మాత్రమే, నిద్ర దశలు లేవు. వాచ్ యాప్‌ను తెరవండి."
          }
