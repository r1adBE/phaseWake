    "check_watch_setup_problem": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "افتح Phase Wake على الساعة مرة واحدة واسمح بالمستشعرات والإشعارات وشاشة المنبه."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jednou otevři Phase Wake v hodinkách a povol senzory, oznámení a obrazovku budíku."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Åbn Phase Wake på uret én gang, og tillad sensorer, notifikationer og alarmskærmen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne Phase Wake einmal auf der Uhr und erlaube Sensoren, Mitteilungen und den Weckbildschirm."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Άνοιξε το Phase Wake στο ρολόι μία φορά και επίτρεψε αισθητήρες, ειδοποιήσεις και την οθόνη ξυπνητηριού."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Phase Wake on the watch once and allow sensors, notifications and the alarm screen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre Phase Wake en el reloj una vez y permite los sensores, las notificaciones y la pantalla de alarma."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "یک بار Phase Wake را روی ساعت باز کن و حسگرها، اعلان‌ها و صفحهٔ زنگ را مجاز کن."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Avaa Phase Wake kellossa kerran ja salli anturit, ilmoitukset ja herätysnäyttö."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvre Phase Wake une fois sur la montre et autorise les capteurs, les notifications et l'écran de réveil."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "פתחו את Phase Wake בשעון פעם אחת ואפשרו חיישנים, התראות ומסך מעורר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वॉच पर एक बार Phase Wake खोलें और सेंसर, नोटिफ़िकेशन व अलार्म स्क्रीन की अनुमति दें।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nyisd meg egyszer a Phase Wake-et az órán, és engedélyezd az érzékelőket, az értesítéseket és az ébresztőképernyőt."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Buka Phase Wake di jam tangan sekali dan izinkan sensor, notifikasi, serta layar alarm."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apri Phase Wake sull’orologio una volta e consenti sensori, notifiche e la schermata della sveglia."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ウォッチでPhase Wakeを一度開き、センサー、通知、アラーム画面を許可してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "워치에서 Phase Wake를 한 번 열고 센서, 알림, 알람 화면을 허용해 주세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Buka Phase Wake pada jam tangan sekali dan benarkan penderia, pemberitahuan serta skrin penggera."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Åpne Phase Wake på klokken én gang og tillat sensorer, varsler og alarmskjermen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Phase Wake één keer op het horloge en sta sensoren, meldingen en het wekkerscherm toe."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Raz otwórz Phase Wake na zegarku i zezwól na czujniki, powiadomienia oraz ekran budzika."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra o Phase Wake no relógio uma vez e permita sensores, notificações e a tela de alarme."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre o Phase Wake no relógio uma vez e permite sensores, notificações e o ecrã de alarme."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Deschide Phase Wake pe ceas o dată și permite senzorii, notificările și ecranul alarmei."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Один раз открой Phase Wake на часах и разреши датчики, уведомления и экран будильника."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Öppna Phase Wake på klockan en gång och tillåt sensorer, aviseringar och larmskärmen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปิด Phase Wake บนนาฬิกาสักครั้ง แล้วอนุญาตเซนเซอร์ การแจ้งเตือน และหน้าจอปลุก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saatte Phase Wake’i bir kez aç; sensörlere, bildirimlere ve alarm ekranına izin ver."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Один раз відкрий Phase Wake на годиннику та дозволь датчики, сповіщення й екран будильника."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy mở Phase Wake trên đồng hồ một lần và cho phép cảm biến, thông báo cùng màn hình báo thức."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在手表上打开一次 Phase Wake，并允许使用传感器、通知和闹钟界面。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請在手錶上開啟一次 Phase Wake，並允許使用感測器、通知和鬧鐘畫面。"
          }
        }
      }
    },
