    "notification_good_night_text": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بانتظار النوم"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Čekám, až usneš"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Venter på, at du falder i søvn"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wartet, bis du eingeschlafen bist"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Περιμένω να κοιμηθείς"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Waiting for you to fall asleep"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esperando a que te duermas"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "منتظر به خواب رفتنت"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Odottaa, että nukahdat"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Attend que tu t'endormes"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ממתין להירדמות"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "तुम्हारे सोने का इंतज़ार"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Várja, hogy elaludj"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menunggu kamu tertidur"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In attesa che tu ti addormenti"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
