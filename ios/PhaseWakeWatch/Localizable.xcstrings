        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Watch: alarm nije aktiviran – samo obavijest, bez faza sna. Otvori aplikaciju na satu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Watch: az ébresztő nincs élesítve – csak értesítés, alvási fázisok nélkül. Nyisd meg az óra alkalmazást."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Watch՝ զարթուցիչը միացված չէ – միայն ծանուցում, առանց քնի փուլերի։ Բացիր ժամացույցի հավելվածը։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Watch: alarm belum aktif – hanya notifikasi, tanpa fase tidur. Buka aplikasi jam."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Watch: vekjari ekki virkur – aðeins tilkynning, engin svefnstig. Opnaðu appið á úrinu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Watch: sveglia non attiva – solo notifica, niente fasi del sonno. Apri l’app dell’orologio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Watch：アラームが有効になっていません – 通知のみで、睡眠段階はありません。ウォッチのアプリを開いてください。"
