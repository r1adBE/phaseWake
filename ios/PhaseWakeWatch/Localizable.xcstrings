    "diag_hint": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "على هذا الجهاز فقط، لا يُرسل شيء. يحتوي على أوقات المنبّهات والأحداث، دون بيانات صحية."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jen v tomto zařízení, nic se neodesílá. Obsahuje časy budíků a událostí, žádná zdravotní data."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun på denne enhed, intet sendes. Indeholder tidspunkter for alarmer og hændelser, ingen sundhedsdata."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur auf diesem Gerät, nichts wird gesendet. Enthält Zeiten von Weckern und Ereignissen, keine Gesundheitsdaten."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μόνο σε αυτή τη συσκευή, δεν αποστέλλεται τίποτα. Περιέχει ώρες αφυπνίσεων και συμβάντων, όχι δεδομένα υγείας."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only on this device, nothing is sent. Contains times of alarms and events, no health data."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo en este dispositivo, no se envía nada. Contiene horas de alarmas y eventos, sin datos de salud."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "فقط روی همین دستگاه، چیزی فرستاده نمی‌شود. شامل زمان زنگ‌ها و رویدادهاست، بدون دادهٔ سلامت."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vain tällä laitteella, mitään ei lähetetä. Sisältää herätysten ja tapahtumien ajat, ei terveystietoja."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uniquement sur cet appareil, rien n’est envoyé. Contient les heures des réveils et des événements, pas de données de santé."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "רק במכשיר הזה, דבר לא נשלח. מכיל זמני השכמות ואירועים, בלי נתוני בריאות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सिर्फ़ इस डिवाइस पर, कुछ भी भेजा नहीं जाता। अलार्म और घटनाओं के समय होते हैं, स्वास्थ्य डेटा नहीं।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Csak ezen az eszközön, semmit sem küld el. Ébresztők és események időpontjait tartalmazza, egészségügyi adatot nem."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya di perangkat ini, tidak ada yang dikirim. Berisi waktu alarm dan peristiwa, tanpa data kesehatan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo su questo dispositivo, non viene inviato nulla. Contiene orari di sveglie ed eventi, nessun dato sanitario."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイスのみ。何も送信されません。アラームとイベントの時刻を含み、健康データは含みません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기에만 있고 아무것도 보내지 않아요. 알람과 이벤트 시간이 들어 있고 건강 데이터는 없어요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya pada peranti ini, tiada apa-apa dihantar. Mengandungi masa penggera dan peristiwa, tanpa data kesihatan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bare på denne enheten, ingenting sendes. Inneholder tidspunkter for alarmer og hendelser, ingen helsedata."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alleen op dit apparaat, er wordt niets verzonden. Bevat tijden van wekkers en gebeurtenissen, geen gezondheidsgegevens."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tylko na tym urządzeniu, nic nie jest wysyłane. Zawiera godziny budzików i zdarzeń, bez danych zdrowotnych."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Só neste dispositivo, nada é enviado. Contém horários de alarmes e eventos, sem dados de saúde."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Só neste dispositivo, nada é enviado. Contém horas de alarmes e eventos, sem dados de saúde."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Doar pe acest dispozitiv, nu se trimite nimic. Conține orele alarmelor și ale evenimentelor, fără date de sănătate."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Только на этом устройстве, ничего не отправляется. Содержит время будильников и событий, без данных о здоровье."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Bara på den här enheten, inget skickas. Innehåller tider för alarm och händelser, inga hälsodata."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อยู่บนอุปกรณ์นี้เท่านั้น ไม่ส่งอะไรออกไป มีเวลาการปลุกและเหตุการณ์ ไม่มีข้อมูลสุขภาพ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca bu cihazda, hiçbir şey gönderilmez. Alarm ve olay saatlerini içerir, sağlık verisi içermez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Лише на цьому пристрої, нічого не надсилається. Містить час будильників і подій, без даних про здоров’я."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ trên thiết bị này, không gửi gì đi. Chứa thời gian báo thức và sự kiện, không có dữ liệu sức khỏe."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅在此设备上，不会发送任何内容。包含闹钟和事件的时间，不含健康数据。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅在此裝置上，不會傳送任何內容。包含鬧鐘和事件的時間，不含健康資料。"
          }
        }
      }
    },
