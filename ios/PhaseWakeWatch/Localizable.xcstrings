    "check_watch_arm_tonight": {
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Watch: wekker nie geaktiveer nie – net ’n kennisgewing, geen slaapfases. Maak die horlosie-app oop."
          }
        },
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Watch፦ ማንቂያው አልተዘጋጀም – ማሳወቂያ ብቻ፣ የእንቅልፍ ደረጃዎች የሉም። የሰዓቱን መተግበሪያ ክፈት።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Watch: المنبّه غير مفعّل – إشعار فقط، دون مراحل النوم. افتح تطبيق الساعة."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Watch: siqnal aktiv deyil – yalnız bildiriş, yuxu fazaları yoxdur. Saat tətbiqini aç."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Watch: будилникът не е активиран – само известие, без фази на съня. Отвори приложението на часовника."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Watch: অ্যালার্ম প্রস্তুত নয় – শুধু বিজ্ঞপ্তি, ঘুমের পর্যায় নেই। ঘড়ির অ্যাপ খোলো।"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Watch: alarm nije aktiviran – samo obavijest, bez faza sna. Otvori aplikaciju na satu."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Watch: alarma no activada – només notificació, sense fases del son. Obre l’app del rellotge."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Watch: budík není aktivní – jen oznámení, bez fází spánku. Otevři aplikaci na hodinkách."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Watch: alarm ikke aktiveret – kun notifikation, ingen søvnfaser. Åbn appen på uret."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Watch: Wecker nicht scharf – nur Mitteilung, keine Phasen. Öffne die Uhr-App."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Watch: το ξυπνητήρι δεν είναι ενεργό – μόνο ειδοποίηση, χωρίς φάσεις ύπνου. Άνοιξε την εφαρμογή του ρολογιού."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Watch: alarm not armed – notification only, no sleep phases. Open the watch app."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Watch: alarma no activada – solo notificación, sin fases del sueño. Abre la app del reloj."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Watch: äratus pole aktiveeritud – ainult teavitus, unefaase pole. Ava kella rakendus."
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Watch: alarma ez dago aktibatuta – jakinarazpena bakarrik, lo-faserik gabe. Ireki erlojuko aplikazioa."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Watch: هشدار فعال نیست – فقط اعلان، بدون مراحل خواب. برنامهٔ ساعت را باز کن."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Watch: herätys ei ole käytössä – vain ilmoitus, ei unen vaiheita. Avaa kellon sovellus."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Watch: hindi nakahanda ang alarm – notification lang, walang sleep phase. Buksan ang app sa relo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Watch : alarme non activée – notification seulement, sans phases de sommeil. Ouvre l’app de la montre."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Watch: níl an t-aláram gníomhach – fógra amháin, gan céimeanna codlata. Oscail aip na huaireadóra."
          }
        },
        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Watch: alarma non activada – só notificación, sen fases do sono. Abre a app do reloxo."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Watch: એલાર્મ સક્રિય નથી – માત્ર સૂચના, ઊંઘના તબક્કા નહીં. ઘડિયાળની ઍપ ખોલો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Watch: ההשכמה לא מופעלת – התראה בלבד, בלי שלבי שינה. פתחו את האפליקציה בשעון."
