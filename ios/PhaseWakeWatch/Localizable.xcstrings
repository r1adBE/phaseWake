    "onb_alarm_text": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "متى تريد أن تستيقظ على أبعد تقدير؟ توقظك الساعة أبكر ضمن النافذة إذا كان نومك خفيفًا."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Kdy chceš být nejpozději vzhůru? Hodinky tě vzbudí dřív v okně, když spíš lehce."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvornår vil du senest være vågen? Uret vækker dig tidligere inden for vinduet, hvis du sover let."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wann willst du spätestens wach sein? Die Uhr weckt dich im Fenster davor, wenn du leicht schläfst."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μέχρι πότε θέλεις το αργότερο να έχεις ξυπνήσει; Το ρολόι σε ξυπνά νωρίτερα μέσα στο παράθυρο αν κοιμάσαι ελαφριά."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When do you want to be awake at the latest? Your watch wakes you earlier within the window if you sleep lightly."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿A qué hora quieres estar despierto como muy tarde? El reloj te despierta antes dentro de la ventana si duermes ligero."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "حداکثر تا کی می‌خواهی بیدار شوی؟ اگر خوابت سبک باشد، ساعت زودتر در بازه بیدارت می‌کند."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Milloin haluat olla viimeistään hereillä? Kello herättää sinut aiemmin ikkunan sisällä, jos nukut kevyesti."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À quelle heure veux-tu être réveillé au plus tard ? La montre te réveille plus tôt dans la fenêtre si ton sommeil est léger."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "עד מתי לכל המאוחר אתם רוצים להיות ערים? השעון יעיר אתכם מוקדם יותר בתוך החלון אם השינה קלה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप ज़्यादा से ज़्यादा कब तक जागना चाहते हैं? नींद हल्की हो तो वॉच आपको विंडो में पहले जगा देगी।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Legkésőbb mikor akarsz ébren lenni? Az óra korábban, az ablakon belül ébreszt, ha éberen alszol."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Paling lambat kapan kamu ingin bangun? Jika tidurmu ringan, jam tangan membangunkanmu lebih awal dalam jendela."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Entro quando vuoi essere sveglio? L’orologio ti sveglia prima nella finestra se dormi leggero."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "遅くとも何時に起きたいですか？眠りが浅ければ、ウォッチがウィンドウ内で早めに起こします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "늦어도 언제 일어나고 싶나요? 잠이 얕으면 워치가 창 안에서 더 일찍 깨워 줘요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Selewat-lewatnya bila awak mahu bangun? Jika tidur ringan, jam tangan mengejutkan awak lebih awal dalam tetingkap."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Når vil du senest være våken? Klokken vekker deg tidligere innenfor vinduet hvis du sover lett."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wanneer wil je uiterlijk wakker zijn? Het horloge wekt je eerder binnen het venster als je licht slaapt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "O której najpóźniej chcesz wstać? Zegarek obudzi Cię wcześniej w oknie, jeśli śpisz płytko."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Até que horas você quer estar acordado? O relógio acorda você antes, dentro da janela, se o sono estiver leve."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Até que horas queres estar acordado? O relógio acorda-te antes, dentro da janela, se o sono estiver leve."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Cel mai târziu când vrei să fii treaz? Ceasul te trezește mai devreme în fereastră dacă dormi ușor."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Когда ты хочешь проснуться самое позднее? Часы разбудят тебя раньше в пределах окна, если сон чуткий."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "När vill du vara vaken senast? Klockan väcker dig tidigare inom fönstret om du sover lätt."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณอยากตื่นช้าที่สุดเมื่อไร ถ้าหลับตื้น นาฬิกาจะปลุกเร็วขึ้นในช่วงเวลานั้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "En geç ne zaman uyanık olmak istiyorsun? Hafif uyuyorsan saat seni pencere içinde daha erken uyandırır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Коли ти хочеш прокинутися найпізніше? Годинник розбудить тебе раніше в межах вікна, якщо сон чуткий."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Muộn nhất bạn muốn thức dậy lúc nào? Nếu ngủ nông, đồng hồ sẽ đánh thức bạn sớm hơn trong khung giờ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你最晚想几点醒来？如果睡得浅，手表会在窗口内更早叫醒你。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你最晚想幾點醒來？如果睡得淺，手錶會在窗口內更早叫醒你。"
          }
        }
      }
    },
