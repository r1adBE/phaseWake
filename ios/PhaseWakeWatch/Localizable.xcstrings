    "watch_learn_warn": {
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Laai jou horlosie, anders tel vannag nie vir die leerfase nie (battery %1$lld %%, nodig %2$lld %%)."
          }
        },
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "ሰዓትህን ቻርጅ አድርግ፣ አለበለዚያ የዛሬ ሌሊት ለመማሪያ ጊዜው አይቆጠርም (ባትሪ %1$lld %%፣ ያስፈልጋል %2$lld %%)።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اشحن ساعتك، وإلا فلن تُحتسب هذه الليلة لمرحلة التعلّم (البطارية %1$lld %%، والمطلوب %2$lld %%)."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Saatını doldur, yoxsa bu gecə öyrənmə mərhələsi üçün sayılmayacaq (batareya %1$lld %%, lazımdır %2$lld %%)."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Зареди часовника, иначе тази нощ няма да се отчете за фазата на учене (батерия %1$lld %%, нужни %2$lld %%)."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ঘড়ি চার্জ করো, নইলে আজ রাত শেখার পর্বে গণনা হবে না (ব্যাটারি %1$lld %%, দরকার %2$lld %%)।"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Napuni sat, inače se ova noć neće uračunati u fazu učenja (baterija %1$lld %%, potrebno %2$lld %%)."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Carrega el rellotge; si no, aquesta nit no comptarà per a la fase d’aprenentatge (bateria %1$lld %%, cal %2$lld %%)."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nabij hodinky, jinak se dnešní noc do fáze učení nezapočítá (baterie %1$lld %%, potřeba %2$lld %%)."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Oplad dit ur, ellers tæller i nat ikke med i læringsfasen (batteri %1$lld %%, kræver %2$lld %%)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lade die Uhr, sonst zählt die Lernnacht nicht (Akku %1$lld %%, nötig %2$lld %%)."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Φόρτισε το ρολόι, αλλιώς απόψε δεν θα μετρήσει για τη φάση εκμάθησης (μπαταρία %1$lld %%, χρειάζεται %2$lld %%)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Charge your watch, or tonight won’t count for the learning phase (battery %1$lld %%, needs %2$lld %%)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Carga el reloj o esta noche no contará para la fase de aprendizaje (batería %1$lld %%, se necesita %2$lld %%)."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Lae kella, muidu ei lähe tänane öö õppefaasis arvesse (aku %1$lld %%, vaja %2$lld %%)."
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kargatu erlojua; bestela, gaur gauak ez du ikasketa-faserako balioko (bateria %1$lld %%, behar da %2$lld %%)."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "ساعتت را شارژ کن، وگرنه امشب برای مرحلهٔ یادگیری حساب نمی‌شود (باتری %1$lld %%، لازم %2$lld %%)."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lataa kello, muuten tätä yötä ei lasketa oppimisvaiheeseen (akku %1$lld %%, tarvitaan %2$lld %%)."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "I-charge ang relo mo, kung hindi ay hindi mabibilang ang gabing ito sa yugto ng pagkatuto (baterya %1$lld %%, kailangan %2$lld %%)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Recharge ta montre, sinon cette nuit ne comptera pas pour la phase d’apprentissage (batterie %1$lld %%, il faut %2$lld %%)."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Luchtaigh d’uaireadóir, nó ní chomhairfear anocht don chéim foghlama (ceallra %1$lld %%, ag teastáil %2$lld %%)."
          }
        },
        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "Carga o reloxo ou esta noite non contará para a fase de aprendizaxe (batería %1$lld %%, precísase %2$lld %%)."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ઘડિયાળ ચાર્જ કરો, નહીં તો આજની રાત શીખવાના તબક્કામાં ગણાશે નહીં (બેટરી %1$lld %%, જોઈએ %2$lld %%)."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כדאי לטעון את השעון, אחרת הלילה לא ייספר לשלב הלמידה (סוללה %1$lld %%, נדרש %2$lld %%)."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "घड़ी चार्ज करें, वरना आज की रात सीखने के चरण में नहीं गिनी जाएगी (बैटरी %1$lld %%, चाहिए %2$lld %%)।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Napuni sat, inače se ova noć neće uračunati u fazu učenja (baterija %1$lld %%, potrebno %2$lld %%)."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Töltsd fel az órát, különben a mai éjszaka nem számít bele a tanulási szakaszba (akku %1$lld %%, kell %2$lld %%)."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Լիցքավորիր ժամացույցը, այլապես այս գիշերը չի հաշվվի ուսուցման փուլի համար (մարտկոց %1$lld %%, պետք է %2$lld %%)։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Isi daya jammu, kalau tidak malam ini tidak terhitung untuk fase belajar (baterai %1$lld %%, perlu %2$lld %%)."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Hladdu úrið, annars telst nóttin ekki með í námsfasanum (rafhlaða %1$lld %%, þarf %2$lld %%)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ricarica l’orologio, altrimenti stanotte non conterà per la fase di apprendimento (batteria %1$lld %%, serve %2$lld %%)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ウォッチを充電してください。このままでは今夜は学習期間にカウントされません（バッテリー %1$lld %%、必要 %2$lld %%）。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "დატენე საათი, თორემ ეს ღამე სწავლის ფაზაში არ ჩაითვლება (ბატარეა %1$lld %%, საჭიროა %2$lld %%)."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сағатты зарядта, әйтпесе бүгінгі түн үйрену кезеңіне есептелмейді (батарея %1$lld %%, керек %2$lld %%)."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "សាកថ្មនាឡិកា បើមិនដូច្នោះទេ យប់នេះមិនរាប់សម្រាប់ដំណាក់កាលរៀនទេ (ថ្ម %1$lld %% ត្រូវការ %2$lld %%)។"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ವಾಚ್ ಚಾರ್ಜ್ ಮಾಡಿ, ಇಲ್ಲದಿದ್ದರೆ ಇಂದಿನ ರಾತ್ರಿ ಕಲಿಕೆಯ ಹಂತಕ್ಕೆ ಎಣಿಕೆಯಾಗುವುದಿಲ್ಲ (ಬ್ಯಾಟರಿ %1$lld %%, ಬೇಕು %2$lld %%)."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시계를 충전하세요. 그렇지 않으면 오늘 밤은 학습 단계에 반영되지 않습니다(배터리 %1$lld %%, 필요 %2$lld %%)."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ສາກໂມງຂອງເຈົ້າ ບໍ່ດັ່ງນັ້ນຄືນນີ້ຈະບໍ່ນັບສຳລັບໄລຍະຮຽນຮູ້ (ແບັດເຕີຣີ %1$lld %%, ຕ້ອງການ %2$lld %%)."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Įkrauk laikrodį, kitaip ši naktis nebus įskaityta mokymosi etapui (baterija %1$lld %%, reikia %2$lld %%)."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Uzlādē pulksteni, citādi šī nakts netiks ieskaitīta mācīšanās posmā (akumulators %1$lld %%, vajag %2$lld %%)."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Наполни го часовникот, инаку оваа ноќ нема да се пресмета за фазата на учење (батерија %1$lld %%, потребно %2$lld %%)."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "വാച്ച് ചാർജ് ചെയ്യുക, അല്ലെങ്കിൽ ഇന്ന് രാത്രി പഠന ഘട്ടത്തിൽ എണ്ണപ്പെടില്ല (ബാറ്ററി %1$lld %%, വേണ്ടത് %2$lld %%)."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Цагаа цэнэглээрэй, эс бөгөөс өнөө шөнө суралцах үед тоологдохгүй (батерей %1$lld %%, хэрэгтэй %2$lld %%)."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "घड्याळ चार्ज करा, नाहीतर आजची रात्र शिकण्याच्या टप्प्यात मोजली जाणार नाही (बॅटरी %1$lld %%, हवी %2$lld %%)."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Cas jam anda, jika tidak malam ini tidak dikira untuk fasa pembelajaran (bateri %1$lld %%, perlu %2$lld %%)."
          }
        },
        "my": {
          "stringUnit": {
            "state": "translated",
            "value": "နာရီကို အားသွင်းပါ၊ မဟုတ်ပါက ဒီည သင်ယူမှုအဆင့်အတွက် မရေတွက်ပါ (ဘက်ထရီ %1$lld %%၊ လိုအပ်ချက် %2$lld %%)။"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Lad klokken, ellers teller ikke i natt med i læringsfasen (batteri %1$lld %%, trenger %2$lld %%)."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "घडी चार्ज गर्नुहोस्, नत्र आजको रात सिक्ने चरणमा गनिँदैन (ब्याट्री %1$lld %%, चाहिन्छ %2$lld %%)।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Laad je horloge op, anders telt vannacht niet mee voor de leerfase (batterij %1$lld %%, nodig %2$lld %%)."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਘੜੀ ਚਾਰਜ ਕਰੋ, ਨਹੀਂ ਤਾਂ ਅੱਜ ਦੀ ਰਾਤ ਸਿੱਖਣ ਦੇ ਪੜਾਅ ਵਿੱਚ ਨਹੀਂ ਗਿਣੀ ਜਾਵੇਗੀ (ਬੈਟਰੀ %1$lld %%, ਚਾਹੀਦੀ %2$lld %%)।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Naładuj zegarek, inaczej ta noc nie zostanie zaliczona do fazy nauki (bateria %1$lld %%, potrzeba %2$lld %%)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Carregue o relógio, senão esta noite não vai contar para a fase de aprendizado (bateria %1$lld %%, precisa de %2$lld %%)."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Carrega o relógio, senão esta noite não conta para a fase de aprendizagem (bateria %1$lld %%, precisa de %2$lld %%)."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Încarcă ceasul, altfel noaptea aceasta nu va conta pentru faza de învățare (baterie %1$lld %%, necesar %2$lld %%)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Заряди часы, иначе эта ночь не будет засчитана для этапа обучения (заряд %1$lld %%, нужно %2$lld %%)."
          }
        },
        "si": {
          "stringUnit": {
            "state": "translated",
            "value": "ඔරලෝසුව ආරෝපණය කරන්න, නැතිනම් අද රාත්‍රිය ඉගෙනීමේ අදියරට ගණන් නොගැනේ (බැටරිය %1$lld %%, අවශ්‍ය %2$lld %%)."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Nabi hodinky, inak sa dnešná noc do fázy učenia nezapočíta (batéria %1$lld %%, treba %2$lld %%)."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Napolni uro, sicer nocoj ne bo štelo za fazo učenja (baterija %1$lld %%, potrebno %2$lld %%)."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Karikoje orën, përndryshe sonte nuk do të numërohet për fazën e të mësuarit (bateria %1$lld %%, duhen %2$lld %%)."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Напуни сат, иначе се ова ноћ неће урачунати у фазу учења (батерија %1$lld %%, потребно %2$lld %%)."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ladda klockan, annars räknas inte natten för inlärningsfasen (batteri %1$lld %%, behöver %2$lld %%)."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaji saa yako, la sivyo usiku wa leo hautahesabiwa kwa hatua ya kujifunza (betri %1$lld %%, inahitajika %2$lld %%)."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "கடிகாரத்தை சார்ஜ் செய்யுங்கள், இல்லையெனில் இன்றிரவு கற்றல் நிலைக்குக் கணக்கிடப்படாது (பேட்டரி %1$lld %%, தேவை %2$lld %%)."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "వాచ్‌ను ఛార్జ్ చేయండి, లేకపోతే ఈ రాత్రి నేర్చుకునే దశలో లెక్కలోకి రాదు (బ్యాటరీ %1$lld %%, కావాలి %2$lld %%)."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ชาร์จนาฬิกา ไม่เช่นนั้นคืนนี้จะไม่นับในช่วงเรียนรู้ (แบตเตอรี่ %1$lld %% ต้องการ %2$lld %%)"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saatini şarj et, yoksa bu gece öğrenme aşaması için sayılmaz (pil %1$lld %%, gerekli %2$lld %%)."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Заряди годинник, інакше цю ніч не буде зараховано до етапу навчання (заряд %1$lld %%, потрібно %2$lld %%)."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "گھڑی چارج کریں، ورنہ آج کی رات سیکھنے کے مرحلے میں نہیں گنی جائے گی (بیٹری %1$lld %%، درکار %2$lld %%)۔"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Soatni quvvatla, aks holda bu tun o‘rganish bosqichiga hisoblanmaydi (batareya %1$lld %%, kerak %2$lld %%)."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy sạc đồng hồ, nếu không đêm nay sẽ không được tính cho giai đoạn học (pin %1$lld %%, cần %2$lld %%)."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "幫手錶充電，唔係今晚就唔會計入學習階段（電量 %1$lld %%，需要 %2$lld %%）。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请给手表充电，否则今晚不计入学习阶段（电量 %1$lld %%，需要 %2$lld %%）。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請替手錶充電，否則今晚不計入學習階段（電量 %1$lld %%，需要 %2$lld %%）。"
          }
        },
        "zu": {
          "stringUnit": {
            "state": "translated",
            "value": "Shaja iwashi lakho, kungenjalo namuhla ebusuku ngeke kubalelwe isigaba sokufunda (ibhethri %1$lld %%, kudingeka %2$lld %%)."
          }
        }
      }
    },
    "watch_not_armed": {
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Maak Phase Wake oop voor jy gaan slaap sodat jou horlosie die wekker kan aktiveer."
          }
        },
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "ሰዓትዎ ማንቂያውን ማዘጋጀት እንዲችል ከመተኛትዎ በፊት Phase Wakeን ይክፈቱ።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "افتح Phase Wake قبل أن تنام لتتمكن ساعتك من تفعيل المنبه."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Saatın siqnalı aktivləşdirə bilsin deyə yatmazdan əvvəl Phase Wake-i aç."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Отвори Phase Wake, преди да заспиш, за да може часовникът да активира будилника."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ঘুমাতে যাওয়ার আগে Phase Wake খোলো, যাতে তোমার ঘড়ি অ্যালার্ম প্রস্তুত করতে পারে।"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Otvori Phase Wake prije spavanja kako bi sat mogao aktivirati alarm."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Obre Phase Wake abans d’anar a dormir perquè el rellotge pugui activar l’alarma."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Před spaním otevři Phase Wake, aby mohly hodinky budík aktivovat."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Åbn Phase Wake, før du går i seng, så dit ur kan aktivere alarmen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne Phase Wake vor dem Schlafen, damit die Uhr den Wecker scharf schaltet."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Άνοιξε το Phase Wake πριν κοιμηθείς, ώστε το ρολόι σου να ενεργοποιήσει το ξυπνητήρι."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Phase Wake before you go to sleep so your watch can arm the alarm."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre Phase Wake antes de dormir para que tu reloj pueda activar la alarma."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Ava Phase Wake enne magamaminekut, et kell saaks äratuse valmis seada."
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ireki Phase Wake lo egin aurretik, erlojuak alarma aktiba dezan."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "پیش از خواب Phase Wake را باز کن تا ساعتت بتواند زنگ را فعال کند."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Avaa Phase Wake ennen nukkumaanmenoa, jotta kellosi voi aktivoida herätyksen."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Buksan ang Phase Wake bago ka matulog para maihanda ng relo mo ang alarm."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvre Phase Wake avant de dormir pour que ta montre puisse activer l’alarme."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Oscail Phase Wake sula dtéann tú a chodladh ionas gur féidir le d’uaireadóir an t-aláram a ghníomhachtú."
          }
        },
        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre Phase Wake antes de durmir para que o reloxo poida activar a alarma."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "સૂતાં પહેલાં Phase Wake ખોલો, જેથી તમારી ઘડિયાળ એલાર્મ સક્રિય કરી શકે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "פתחו את Phase Wake לפני השינה כדי שהשעון יוכל להפעיל את המעורר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सोने से पहले Phase Wake खोलें, ताकि आपकी वॉच अलार्म को सक्रिय कर सके।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Otvori Phase Wake prije spavanja kako bi sat mogao aktivirati alarm."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Lefekvés előtt nyisd meg a Phase Wake-et, hogy az órád élesíthesse az ébresztőt."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Քնելուց առաջ բացիր Phase Wake-ը, որպեսզի ժամացույցդ կարողանա ակտիվացնել զարթուցիչը։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Buka Phase Wake sebelum tidur agar jam tanganmu bisa mengaktifkan alarm."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Opnaðu Phase Wake áður en þú ferð að sofa svo úrið geti virkjað vekjarann."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apri Phase Wake prima di dormire, così il tuo orologio può attivare la sveglia."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "眠る前にPhase Wakeを開いてください。ウォッチがアラームを有効にできるようになります。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "დაძინებამდე გახსენი Phase Wake, რომ საათმა მაღვიძარა გაააქტიუროს."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сағатың оятқышты іске қосуы үшін ұйықтар алдында Phase Wake-ті аш."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "បើក Phase Wake មុនពេលចូលដេក ដើម្បីឲ្យនាឡិកាអាចកំណត់ម៉ោងរោទ៍។"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ವಾಚ್ ಅಲಾರಾಂ ಸಕ್ರಿಯಗೊಳಿಸಲು, ಮಲಗುವ ಮೊದಲು Phase Wake ತೆರೆಯಿರಿ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "잠들기 전에 Phase Wake를 열어 주세요. 그래야 워치가 알람을 활성화할 수 있어요."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ເປີດ Phase Wake ກ່ອນເຂົ້ານອນ ເພື່ອໃຫ້ໂມງຕັ້ງໂມງປຸກໄດ້"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Prieš miegą atidaryk Phase Wake, kad laikrodis galėtų parengti žadintuvą."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Pirms gulētiešanas atver Phase Wake, lai pulkstenis varētu aktivizēt modinātāju."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Отвори го Phase Wake пред спиење за часовникот да може да го активира алармот."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "വാച്ചിന് അലാറം സജ്ജമാക്കാൻ, ഉറങ്ങും മുമ്പ് Phase Wake തുറക്കുക."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Цаг чинь сэрүүлгийг идэвхжүүлж чадахын тулд унтахаасаа өмнө Phase Wake-ийг нээ."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "झोपण्यापूर्वी Phase Wake उघडा, म्हणजे तुमचे घड्याळ अलार्म सक्रिय करू शकेल."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Buka Phase Wake sebelum awak tidur supaya jam tangan boleh mengaktifkan penggera."
