    "check_notifications_problem": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بدون الإشعارات لن يتمكن هاتفك من الرنين كمنبه احتياطي."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Bez oznámení nemůže telefon zazvonit jako záložní budík."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Uden notifikationer kan din telefon ikke ringe som backup-alarm."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ohne Mitteilungen kann das Handy nicht als Zweitwecker klingeln."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Χωρίς ειδοποιήσεις, το κινητό σου δεν μπορεί να χτυπήσει ως εφεδρικό ξυπνητήρι."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Without notifications, your phone can’t ring as a backup alarm."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin notificaciones, tu teléfono no puede sonar como alarma de respaldo."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "بدون اعلان، گوشی نمی‌تواند به‌عنوان زنگ پشتیبان زنگ بزند."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ilman ilmoituksia puhelimesi ei voi soida varaherätyksenä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sans notifications, ton téléphone ne peut pas sonner comme alarme de secours."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בלי התראות הטלפון לא יוכל לצלצל כשעון מעורר גיבוי."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सूचनाओं के बिना आपका फ़ोन बैकअप अलार्म के रूप में नहीं बज सकता।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Értesítések nélkül a telefonod nem tud tartalék ébresztőként csörögni."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tanpa notifikasi, ponselmu tidak bisa berbunyi sebagai alarm cadangan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Senza notifiche il telefono non può suonare come sveglia di riserva."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通知がないと、スマートフォンがバックアップのアラームとして鳴りません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "알림이 없으면 휴대폰이 예비 알람으로 울릴 수 없어요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
