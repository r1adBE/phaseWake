    "check_watch_battery_problem": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أقل من %1$lld %% – اشحن ساعتك لتصمد طوال الليل وتوقظك."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pod %1$lld %% – nabij hodinky, aby vydržely celou noc a mohly tě vzbudit."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Under %1$lld %% – oplad dit ur, så det holder natten igennem og kan vække dig."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unter %1$lld %% – lade die Uhr, damit sie die Nacht durchhält und dich weckt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κάτω από %1$lld %% – φόρτισε το ρολόι σου, ώστε να αντέξει όλη τη νύχτα και να σε ξυπνήσει."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Below %1$lld %% – charge your watch so it lasts the night and can wake you."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Menos del %1$lld %% – carga tu reloj para que aguante toda la noche y pueda despertarte."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "کمتر از %1$lld %% – ساعت را شارژ کن تا تمام شب روشن بماند و بیدارت کند."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle %1$lld %% – lataa kello, jotta se kestää yön yli ja voi herättää sinut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Moins de %1$lld %% – recharge ta montre pour qu’elle tienne toute la nuit et puisse te réveiller."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מתחת ל-%1$lld %% – טענו את השעון כדי שיחזיק כל הלילה ויוכל להעיר אתכם."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld %% से कम – अपनी वॉच चार्ज करें ताकि वह पूरी रात चले और आपको जगा सके।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld %% alatt – töltsd fel az órát, hogy kibírja az éjszakát és fel tudjon ébreszteni."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Di bawah %1$lld %% – isi daya jam tanganmu agar bertahan semalaman dan bisa membangunkanmu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sotto il %1$lld %% – ricarica l’orologio perché duri tutta la notte e possa svegliarti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld %%未満です – 一晩もって確実に起こせるよう、ウォッチを充電してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld %% 미만 – 밤새 버티고 깨워 줄 수 있도록 워치를 충전해 주세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kurang daripada %1$lld %% – cas jam tangan awak supaya tahan sepanjang malam dan boleh mengejutkan awak."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Under %1$lld %% – lad klokken slik at den varer natten og kan vekke deg."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Onder %1$lld %% – laad je horloge op zodat het de nacht doorkomt en je kan wekken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Poniżej %1$lld %% – naładuj zegarek, aby wytrzymał całą noc i mógł cię obudzić."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abaixo de %1$lld %% – carregue seu relógio para que ele dure a noite toda e possa te acordar."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Abaixo de %1$lld %% – carrega o relógio para que dure a noite toda e te possa acordar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Sub %1$lld %% – încarcă ceasul ca să reziste toată noaptea și să te poată trezi."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ниже %1$lld %% – поставь часы на зарядку, чтобы их хватило на всю ночь и они смогли тебя разбудить."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Under %1$lld %% – ladda klockan så att den räcker hela natten och kan väcka dig."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ต่ำกว่า %1$lld %% – ชาร์จนาฬิกาเพื่อให้ใช้งานได้ตลอดคืนและปลุกคุณได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pil %1$lld %% altında – gece boyunca dayanması ve seni uyandırabilmesi için saatini şarj et."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Нижче %1$lld %% – постав годинник на зарядку, щоб його вистачило на всю ніч і він зміг тебе розбудити."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dưới %1$lld %% – hãy sạc đồng hồ để đồng hồ chạy suốt đêm và có thể đánh thức bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "低于 %1$lld %% – 请给手表充电，以便它整夜运行并按时唤醒你。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "低於 %1$lld %% – 請為手錶充電，讓它撐過整晚並按時喚醒你。"
          }
        }
      }
    },
    "check_watch_problem": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذر الوصول إلى ساعتك. ارتدِها، وأبقِ Bluetooth قيد التشغيل، وافتح Phase Wake على الساعة مرة واحدة."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Hodinky nejsou dostupné. Nasaď si je, nech zapnuté Bluetooth a jednou na hodinkách otevři Phase Wake."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit ur kan ikke nås. Tag det på, hold Bluetooth slået til, og åbn Phase Wake på uret én gang."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Uhr ist nicht erreichbar. Trag sie, lass Bluetooth an und öffne Phase Wake einmal auf der Uhr."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το ρολόι σου δεν είναι προσβάσιμο. Φόρεσέ το, κράτα το Bluetooth ενεργό και άνοιξε το Phase Wake στο ρολόι μία φορά."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your watch isn’t reachable. Wear it, keep Bluetooth on and open Phase Wake on the watch once."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se puede acceder a tu reloj. Póntelo, mantén el Bluetooth activado y abre Phase Wake en el reloj una vez."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "به ساعتت دسترسی ندارم. آن را ببند، Bluetooth را روشن نگه دار و یک بار Phase Wake را روی ساعت باز کن."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kelloasi ei tavoiteta. Pidä se ranteessa, pidä Bluetooth päällä ja avaa Phase Wake kellossa kerran."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta montre est injoignable. Mets-la au poignet, garde le Bluetooth activé et ouvre Phase Wake une fois sur la montre."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אי אפשר להגיע לשעון שלכם. ענדו אותו, השאירו את ה-Bluetooth פעיל ופתחו את Phase Wake בשעון פעם אחת."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपकी वॉच तक पहुँचा नहीं जा सकता। उसे पहनें, Bluetooth चालू रखें और वॉच पर एक बार Phase Wake खोलें।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az órád nem érhető el. Vedd fel, tartsd bekapcsolva a Bluetooth-t, és nyisd meg egyszer a Phase Wake-et az órán."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jam tanganmu tidak terjangkau. Kenakan, biarkan Bluetooth menyala, dan buka Phase Wake di jam tangan sekali."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo orologio non è raggiungibile. Indossalo, tieni attivo il Bluetooth e apri Phase Wake sull’orologio una volta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ウォッチに接続できません。ウォッチを装着し、Bluetoothをオンにして、ウォッチでPhase Wakeを一度開いてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "워치에 연결할 수 없어요. 워치를 착용하고 Bluetooth를 켠 뒤, 워치에서 Phase Wake를 한 번 열어 주세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Jam tangan tidak dapat dicapai. Pakai jam tangan, biarkan Bluetooth hidup dan buka Phase Wake pada jam tangan sekali."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Klokken er ikke tilgjengelig. Ha den på deg, la Bluetooth stå på og åpne Phase Wake på klokken én gang."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je horloge is niet bereikbaar. Draag het, laat Bluetooth aan en open Phase Wake één keer op het horloge."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zegarek jest niedostępny. Załóż go, zostaw włączony Bluetooth i raz otwórz Phase Wake na zegarku."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível alcançar seu relógio. Use-o, mantenha o Bluetooth ligado e abra o Phase Wake no relógio uma vez."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O relógio não está acessível. Usa-o, mantém o Bluetooth ativado e abre o Phase Wake no relógio uma vez."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ceasul nu este accesibil. Poartă-l, ține Bluetooth pornit și deschide Phase Wake pe ceas o dată."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Часы недоступны. Надень их, не выключай Bluetooth и один раз открой Phase Wake на часах."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Klockan går inte att nå. Ta på den, låt Bluetooth vara på och öppna Phase Wake på klockan en gång."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ติดต่อนาฬิกาของคุณไม่ได้ ให้สวมนาฬิกา เปิด Bluetooth ไว้ และเปิด Phase Wake บนนาฬิกาสักครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saatine ulaşılamıyor. Tak, Bluetooth’u açık tut ve saatte Phase Wake’i bir kez aç."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Годинник недоступний. Одягни його, не вимикай Bluetooth і один раз відкрий Phase Wake на годиннику."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể kết nối với đồng hồ. Hãy đeo đồng hồ, bật Bluetooth và mở Phase Wake trên đồng hồ một lần."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法连接到你的手表。请戴上手表，保持 Bluetooth 开启，并在手表上打开一次 Phase Wake。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法連線到你的手錶。請戴上手錶，保持 Bluetooth 開啟，並在手錶上開啟一次 Phase Wake。"
          }
        }
      }
    },
    "check_watch_problem_apple": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
