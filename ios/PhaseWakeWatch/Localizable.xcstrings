    "editor_advice_text|one": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "في %1$lld من آخر %2$lld ليلة لم يظهر نوم خفيف ضمن النافذة. مع %3$lld دقيقة تزداد فرص الاستيقاظ في لحظة مناسبة."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "V %1$lld z poslední %2$lld noci se v okně neobjevil žádný lehký spánek. S %3$lld min se budeš častěji budit ve vhodnou chvíli."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "I %1$lld af den seneste %2$lld nat var der ingen let søvn i vinduet. Med %3$lld min vågner du oftere på et godt tidspunkt."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In %1$lld der letzten %2$lld Nacht kam kein leichter Schlaf ins Fenster. Mit %3$lld Min erwischst du öfter einen guten Moment."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Σε %1$lld από την τελευταία %2$lld νύχτα δεν υπήρχε ελαφρύς ύπνος στο παράθυρο. Με %3$lld λεπτά θα ξυπνάς πιο συχνά την κατάλληλη στιγμή."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In %1$lld of the last %2$lld night there was no light sleep in the window. With %3$lld min you’ll more often wake at a good moment."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En %1$lld de la última noche (%2$lld) no hubo sueño ligero dentro de la ventana. Con %3$lld min te despertarás más a menudo en un buen momento."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "در %1$lld شب از %2$lld شب اخیر، در بازه خواب سبک نبود. با %3$lld دقیقه بیشتر در لحظه‌ای مناسب بیدار می‌شوی."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld viimeisestä %2$lld yöstä ikkunassa ei ollut kevyttä unta. Kun ikkuna on %3$lld min, heräät useammin hyvällä hetkellä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dans %1$lld de la dernière nuit (%2$lld), il n’y avait pas de sommeil léger dans la fenêtre. Avec %3$lld min, tu te réveilleras plus souvent au bon moment."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ב-%1$lld מתוך הלילה האחרון (%2$lld) לא הייתה שינה קלה בחלון. עם %3$lld דק׳ יהיו יותר התעוררויות ברגע טוב."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पिछली %2$lld रात में से %1$lld रात में विंडो के दौरान हल्की नींद नहीं आई। %3$lld मिनट से तुम अक्सर सही समय पर जागोगे।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az utolsó %2$lld éjszakából %1$lld alkalommal nem volt könnyű alvás az ablakban. %3$lld perccel gyakrabban ébredsz jó pillanatban."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In %1$lld dell’ultima notte (%2$lld) non c’era sonno leggero nella finestra. Con %3$lld min ti sveglierai più spesso al momento giusto."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "I %1$lld av den siste %2$lld natten var det ingen lett søvn i vinduet. Med %3$lld min våkner du oftere på et godt tidspunkt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "In %1$lld van de laatste %2$lld nacht zat er geen lichte slaap in het venster. Met %3$lld min word je vaker op een goed moment wakker."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "W %1$lld z ostatniej %2$lld nocy w oknie nie było lekkiego snu. Przy %3$lld min częściej obudzisz się w dobrym momencie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Em %1$lld de %2$lld noite recente não houve sono leve na janela. Com %3$lld min, você vai acordar mais vezes num bom momento."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Em %1$lld de %2$lld noite recente não houve sono leve na janela. Com %3$lld min, vais acordar mais vezes num bom momento."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "În %1$lld din %2$lld noapte recentă nu a fost somn ușor în fereastră. Cu %3$lld min te vei trezi mai des într-un moment bun."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В %1$lld из последних %2$lld ночи в окне не было лёгкого сна. С %3$lld мин ты чаще будешь просыпаться в удачный момент."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Under %1$lld av den senaste %2$lld natten fanns ingen lätt sömn i fönstret. Med %3$lld min vaknar du oftare vid ett bra tillfälle."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Son %2$lld gecenin %1$lld tanesinde aralıkta hafif uyku yoktu. %3$lld dk ile daha sık uygun bir anda uyanırsın."
          }
        },
        "uk": {
          "stringUnit": {
