    "onb_privacy": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تبقى بياناتك على أجهزتك."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tvoje data zůstávají ve tvých zařízeních."
