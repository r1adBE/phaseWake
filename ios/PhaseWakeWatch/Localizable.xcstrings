    "bedtime_notification": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "موعد النوم %1$@ – هكذا تنام %2$@ حتى المنبّه في %3$@."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Do postele v %1$@ – tak se vyspíš %2$@ do budíku v %3$@."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Sengetid kl. %1$@ – så når du %2$@ søvn før alarmen kl. %3$@."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bettzeit um %1$@ – so schaffst du %2$@ bis zum Wecker um %3$@."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ύπνος στις %1$@ – έτσι κοιμάσαι %2$@ ως το ξυπνητήρι στις %3$@."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bedtime at %1$@ – that way you’ll get %2$@ before your alarm at %3$@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "A la cama a las %1$@ – así duermes %2$@ antes de la alarma de las %3$@."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "زمان خواب %1$@ – این‌طور تا زنگ ساعت %3$@، %2$@ می‌خوابی."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nukkumaan klo %1$@ – niin ehdit nukkua %2$@ ennen herätystä klo %3$@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Au lit à %1$@ – ainsi tu dors %2$@ avant ton réveil à %3$@."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שעת שינה ב־%1$@ – כך תישן %2$@ עד השעון המעורר ב־%3$@."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ बजे सो जाओ – ऐसे %3$@ बजे के अलार्म तक %2$@ की नींद होगी।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Lefekvés: %1$@ – így %2$@ alvásod lesz az ébresztőig (%3$@)."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidur pukul %1$@ – dengan begitu kamu tidur %2$@ sampai alarm pukul %3$@."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "A letto alle %1$@ – così dormi %2$@ prima della sveglia delle %3$@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ に就寝 – %3$@ のアラームまで %2$@ 眠れます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@에 취침 – 그러면 %3$@ 알람까지 %2$@ 잘 수 있어요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidur pada %1$@ – dengan itu anda tidur %2$@ sebelum penggera pada %3$@."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Leggetid kl. %1$@ – da rekker du %2$@ søvn før alarmen kl. %3$@."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bedtijd om %1$@ – zo slaap je %2$@ tot je wekker om %3$@."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pora spać o %1$@ – wtedy prześpisz %2$@ do budzika o %3$@."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Hora de dormir às %1$@ – assim você dorme %2$@ até o alarme das %3$@."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Deita-te às %1$@ – assim dormes %2$@ até ao alarme das %3$@."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "La culcare la %1$@ – așa dormi %2$@ până la alarma de la %3$@."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Спать в %1$@ — так ты поспишь %2$@ до будильника в %3$@."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Läggdags kl. %1$@ – då hinner du sova %2$@ till alarmet kl. %3$@."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เข้านอนตอน %1$@ – แล้วคุณจะได้นอน %2$@ ก่อนนาฬิกาปลุกตอน %3$@"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yatma saati %1$@ – böylece %3$@ alarmına kadar %2$@ uyursun."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Спати о %1$@ — так ти поспиш %2$@ до будильника о %3$@."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đi ngủ lúc %1$@ – như vậy bạn ngủ được %2$@ trước báo thức lúc %3$@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 就寝 – 这样到 %3$@ 的闹钟前你能睡 %2$@。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 就寢 – 這樣到 %3$@ 的鬧鐘前你能睡 %2$@。"
          }
        }
      }
    },
    "bedtime_text": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يذكّرك قبل موعد النوم بـ %1$lld دقيقة: وقت المنبّه ناقص هدف النوم."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Připomene ti to %1$lld min před časem spánku: čas buzení minus cíl spánku."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Minder dig om det %1$lld min før sengetid: vækketid minus søvnmål."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erinnert dich %1$lld Min vor der Bettzeit: Weckzeit minus Schlafziel."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Σου θυμίζει %1$lld λεπτά πριν την ώρα ύπνου: ώρα αφύπνισης μείον στόχος ύπνου."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reminds you %1$lld min before bedtime: your alarm time minus your sleep goal."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Te avisa %1$lld min antes de la hora de acostarte: hora de la alarma menos objetivo de sueño."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld دقیقه پیش از زمان خواب یادآوری می‌کند: زمان زنگ منهای هدف خواب."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Muistuttaa %1$lld min ennen nukkumaanmenoa: herätysaika miinus unitavoite."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Te le rappelle %1$lld min avant l’heure du coucher : heure du réveil moins objectif de sommeil."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מזכירה לך %1$lld דק׳ לפני שעת השינה: שעת ההשכמה פחות יעד השינה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सोने के समय से %1$lld मिनट पहले याद दिलाता है: अलार्म का समय घटा नींद का लक्ष्य।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld perccel lefekvés előtt emlékeztet: ébresztési idő mínusz alvási cél."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mengingatkanmu %1$lld mnt sebelum waktu tidur: jam alarm dikurangi target tidur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ti avvisa %1$lld min prima di andare a letto: ora della sveglia meno obiettivo di sonno."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "就寝時刻の %1$lld 分前にお知らせ:起床時刻から睡眠目標を引いた時刻。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "취침 시간 %1$lld분 전에 알려 줘요: 알람 시간에서 수면 목표를 뺀 시간."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Mengingatkan anda %1$lld min sebelum waktu tidur: masa penggera tolak sasaran tidur."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Minner deg på det %1$lld min før leggetid: vekketid minus søvnmål."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Herinnert je %1$lld min voor bedtijd: wektijd min slaapdoel."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przypomina %1$lld min przed porą snu: godzina budzika minus cel snu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Avisa você %1$lld min antes da hora de dormir: horário do alarme menos meta de sono."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Avisa-te %1$lld min antes da hora de deitar: hora do alarme menos meta de sono."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Îți amintește cu %1$lld min înainte de ora de culcare: ora alarmei minus obiectivul de somn."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Напоминает за %1$lld мин до отхода ко сну: время будильника минус цель сна."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Påminner dig %1$lld min före läggdags: väckningstid minus sömnmål."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เตือนก่อนเวลาเข้านอน %1$lld นาที: เวลาปลุกลบเป้าหมายการนอน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yatma saatinden %1$lld dk önce hatırlatır: alarm saati eksi uyku hedefi."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Нагадує за %1$lld хв до відходу до сну: час будильника мінус ціль сну."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhắc bạn %1$lld phút trước giờ đi ngủ: giờ báo thức trừ mục tiêu ngủ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在就寝时间前 %1$lld 分钟提醒你:闹钟时间减去睡眠目标。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在就寢時間前 %1$lld 分鐘提醒你:鬧鐘時間減去睡眠目標。"
          }
        }
      }
    },
