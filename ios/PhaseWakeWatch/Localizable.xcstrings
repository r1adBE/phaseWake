          "stringUnit": {
            "state": "translated",
            "value": "Solo brevi estratti. Restano sul telefono e vengono eliminati dopo 7 giorni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "短い断片だけ。スマホに残り、7日後に削除されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "짧은 조각만 저장해요. 휴대폰에만 남고 7일 뒤 삭제돼요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya keratan pendek. Kekal di telefon anda dan dipadam selepas 7 hari."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bare korte klipp. De blir på telefonen og slettes etter 7 dager."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alleen korte fragmenten. Ze blijven op je telefoon en worden na 7 dagen gewist."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tylko krótkie fragmenty. Zostają na telefonie i są usuwane po 7 dniach."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Só trechos curtos. Ficam no seu celular e são apagados depois de 7 dias."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Só excertos curtos. Ficam no teu telemóvel e são apagados ao fim de 7 dias."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Doar fragmente scurte. Rămân pe telefon și se șterg după 7 zile."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Только короткие фрагменты. Они остаются на телефоне и удаляются через 7 дней."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Bara korta klipp. De stannar på telefonen och raderas efter 7 dagar."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เก็บแค่ช่วงสั้น ๆ อยู่ในโทรศัพท์และลบหลัง 7 วัน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca kısa parçalar. Telefonunda kalır ve 7 gün sonra silinir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Лише короткі фрагменти. Вони залишаються на телефоні й видаляються через 7 днів."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ những đoạn ngắn. Chúng ở lại trên điện thoại và bị xóa sau 7 ngày."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只保存短片段。片段留在手机上，7 天后删除。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只保存短片段。片段留在手機上，7 天後刪除。"
          }
        }
      }
    },
    "sound_rec_permission": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "للتسجيل يحتاج Phase Wake إلى الميكروفون. لا يستمع إلا أثناء التسجيل."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "K nahrávání potřebuje Phase Wake mikrofon. Poslouchá jen, dokud nahrávání běží."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "For at optage skal Phase Wake bruge mikrofonen. Den lytter kun, mens optagelsen kører."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für die Aufnahme braucht Phase Wake das Mikrofon. Es hört nur zu, solange die Aufnahme läuft."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Για την καταγραφή το Phase Wake χρειάζεται το μικρόφωνο. Ακούει μόνο όσο τρέχει η καταγραφή."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To record, Phase Wake needs the microphone. It only listens while recording is on."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para grabar, Phase Wake necesita el micrófono. Solo escucha mientras la grabación está activa."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "برای ضبط، Phase Wake به میکروفون نیاز دارد. فقط تا وقتی ضبط روشن است گوش می‌دهد."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tallentamiseen Phase Wake tarvitsee mikrofonin. Se kuuntelee vain tallennuksen aikana."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour enregistrer, Phase Wake a besoin du micro. Il n’écoute que pendant l’enregistrement."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כדי להקליט, Phase Wake צריך את המיקרופון. הוא מקשיב רק כשההקלטה פועלת."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रिकॉर्ड करने के लिए Phase Wake को माइक्रोफ़ोन चाहिए। यह सिर्फ़ रिकॉर्डिंग के दौरान सुनता है।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A rögzítéshez a Phase Wake-nek kell a mikrofon. Csak a rögzítés alatt figyel."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Untuk merekam, Phase Wake butuh mikrofon. Mikrofon hanya mendengar selama perekaman aktif."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per registrare, Phase Wake ha bisogno del microfono. Ascolta solo mentre la registrazione è attiva."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "録音にはマイクが必要です。録音中だけ聞き取ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "녹음하려면 마이크가 필요해요. 녹음 중에만 들어요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Untuk merakam, Phase Wake memerlukan mikrofon. Ia hanya mendengar semasa rakaman aktif."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "For å ta opp trenger Phase Wake mikrofonen. Den lytter bare mens opptaket pågår."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Om op te nemen heeft Phase Wake de microfoon nodig. Die luistert alleen zolang de opname loopt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Do nagrywania Phase Wake potrzebuje mikrofonu. Słucha tylko, gdy nagrywanie jest włączone."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para gravar, o Phase Wake precisa do microfone. Ele só escuta enquanto a gravação está ativa."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Para gravar, o Phase Wake precisa do microfone. Só ouve enquanto a gravação está ativa."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Pentru înregistrare, Phase Wake are nevoie de microfon. Ascultă doar cât timp înregistrarea e pornită."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для записи Phase Wake нужен микрофон. Он слушает только во время записи."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "För att spela in behöver Phase Wake mikrofonen. Den lyssnar bara medan inspelningen pågår."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การบันทึกต้องใช้ไมโครโฟน จะฟังเฉพาะตอนที่เปิดบันทึกอยู่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kayıt için Phase Wake mikrofona ihtiyaç duyar. Yalnızca kayıt açıkken dinler."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Для запису Phase Wake потрібен мікрофон. Він слухає лише під час запису."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Để ghi âm, Phase Wake cần micrô. Nó chỉ nghe khi đang ghi âm."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "录音需要麦克风。只在录音开启时收听。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "錄音需要麥克風。只在錄音開啟時收聽。"
          }
        }
      }
    },
    "sound_rec_plug_in": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "التسجيل يعمل. الأفضل أن تشحن هاتفك طوال الليل."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nahrávání běží. Telefon dej na noc nejlépe nabíjet."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Optagelsen kører. Sæt helst telefonen til opladning om natten."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aufnahme läuft. Schliess das Handy für die Nacht am besten ans Ladegerät an."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η καταγραφή τρέχει. Καλύτερα βάλε το τηλέφωνο στον φορτιστή για τη νύχτα."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recording is on. Best plug in your phone for the night."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Grabación activa. Mejor conecta el teléfono al cargador por la noche."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "ضبط روشن است. بهتر است گوشی را شب به شارژر بزنی."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tallennus käynnissä. Laita puhelin mieluiten lataukseen yöksi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrement en cours. Branche de préférence ton téléphone pour la nuit."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ההקלטה פועלת. עדיף לחבר את הטלפון למטען בלילה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रिकॉर्डिंग चल रही है। बेहतर है कि रात भर फ़ोन चार्जर पर लगा रहे।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A rögzítés fut. Éjszakára legjobb töltőre tenni a telefont."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Perekaman berjalan. Sebaiknya isi daya ponsel semalaman."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Registrazione attiva. Meglio collegare il telefono al caricatore per la notte."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "録音中。夜はスマホを充電器につないでおくのがおすすめです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "녹음 중이에요. 밤새 휴대폰을 충전기에 연결해 두는 게 좋아요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Rakaman berjalan. Sebaiknya cas telefon sepanjang malam."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Opptaket pågår. Sett gjerne telefonen til lading om natten."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opname loopt. Sluit je telefoon voor de nacht het best aan op de lader."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nagrywanie trwa. Najlepiej podłącz telefon na noc do ładowarki."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Gravação ativa. Melhor deixar o celular no carregador durante a noite."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Gravação ativa. É melhor ligares o telemóvel ao carregador durante a noite."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Înregistrarea e pornită. Cel mai bine pune telefonul la încărcat peste noapte."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запись идёт. Лучше поставь телефон на зарядку на ночь."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inspelning pågår. Anslut gärna telefonen till laddaren över natten."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กำลังบันทึก ควรเสียบชาร์จโทรศัพท์ไว้ตลอดคืน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kayıt sürüyor. Telefonu gece şarja takman en iyisi."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Запис триває. Краще постав телефон на ніч заряджатися."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đang ghi âm. Tốt nhất là cắm sạc điện thoại qua đêm."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在录音。夜里最好给手机接上充电器。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "正在錄音。夜裡最好幫手機接上充電器。"
          }
        }
      }
    },
