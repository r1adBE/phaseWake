    "check_watch_app_problem": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ساعتك متصلة، لكن Phase Wake غير مثبّت عليها بعد."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Hodinky jsou připojené, ale Phase Wake v nich ještě není nainstalovaný."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit ur er forbundet, men Phase Wake er endnu ikke installeret på det."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Uhr ist verbunden, aber Phase Wake ist dort noch nicht installiert."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το ρολόι σου είναι συνδεδεμένο, αλλά το Phase Wake δεν έχει εγκατασταθεί ακόμα σε αυτό."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your watch is connected, but Phase Wake isn't installed on it yet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu reloj está conectado, pero Phase Wake aún no está instalado en él."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "ساعتت متصل است، اما Phase Wake هنوز روی آن نصب نشده است."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kellosi on yhdistetty, mutta Phase Wakea ei ole vielä asennettu siihen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta montre est connectée, mais Phase Wake n'y est pas encore installé."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "השעון שלכם מחובר, אבל Phase Wake עדיין לא מותקן בו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपकी वॉच कनेक्टेड है, लेकिन उस पर अभी Phase Wake इंस्टॉल नहीं है।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az órád csatlakoztatva van, de a Phase Wake még nincs telepítve rá."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jam tanganmu terhubung, tetapi Phase Wake belum terpasang di jam tangan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo orologio è connesso, ma Phase Wake non è ancora installato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ウォッチは接続されていますが、Phase Wakeがまだインストールされていません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "워치가 연결되어 있지만 아직 워치에 Phase Wake가 설치되지 않았어요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Jam tangan awak disambungkan, tetapi Phase Wake belum dipasang padanya."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Klokken er tilkoblet, men Phase Wake er ikke installert på den ennå."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je horloge is verbonden, maar Phase Wake is er nog niet op geïnstalleerd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zegarek jest połączony, ale Phase Wake nie jest jeszcze na nim zainstalowany."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu relógio está conectado, mas o Phase Wake ainda não está instalado nele."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O teu relógio está ligado, mas o Phase Wake ainda não está instalado nele."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ceasul tău este conectat, dar Phase Wake nu este încă instalat pe el."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Часы подключены, но Phase Wake на них ещё не установлен."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Klockan är ansluten, men Phase Wake är inte installerat på den än."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "นาฬิกาของคุณเชื่อมต่ออยู่ แต่ยังไม่ได้ติดตั้ง Phase Wake บนนาฬิกา"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saatin bağlı, ancak Phase Wake henüz saatte yüklü değil."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Годинник підключено, але Phase Wake на ньому ще не встановлено."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đồng hồ đã được kết nối nhưng Phase Wake chưa được cài trên đồng hồ."
          }
        },
        "zh-Hans": {
