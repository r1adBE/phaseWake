    "home_no_alarm_hint": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أنشئ منبّهًا – هنا أو في Phase Wake على الهاتف."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vytvoř budík – tady nebo v Phase Wake v telefonu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Opret en alarm – her eller i Phase Wake på telefonen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lege einen Wecker an – hier oder in Phase Wake auf dem Handy."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δημιούργησε αφύπνιση – εδώ ή στο Phase Wake στο κινητό."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add an alarm – here or in Phase Wake on your phone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Crea una alarma, aquí o en Phase Wake en el teléfono."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "زنگ بساز – همین‌جا یا در Phase Wake روی گوشی."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Luo herätys – tässä tai puhelimen Phase Wakessa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Crée un réveil – ici ou dans Phase Wake sur ton téléphone."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "צרו השכמה – כאן או ב-Phase Wake בטלפון."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अलार्म बनाएं – यहां या फ़ोन पर Phase Wake में।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Hozz létre ébresztőt – itt vagy a telefonon a Phase Wake-ben."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Buat alarm – di sini atau di Phase Wake pada ponsel."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Crea una sveglia – qui o in Phase Wake sul telefono."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アラームを作成 – ここか、スマホのPhase Wakeで。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "알람을 만드세요. 여기서나 휴대폰의 Phase Wake에서."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Cipta penggera – di sini atau dalam Phase Wake pada telefon."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Opprett en alarm – her eller i Phase Wake på telefonen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Maak een wekker – hier of in Phase Wake op je telefoon."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Utwórz budzik – tutaj lub w Phase Wake na telefonie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Crie um alarme – aqui ou no Phase Wake no celular."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Cria um alarme – aqui ou no Phase Wake no telemóvel."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Creează o alarmă – aici sau în Phase Wake pe telefon."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Создай будильник – здесь или в Phase Wake на телефоне."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Skapa ett alarm – här eller i Phase Wake på telefonen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สร้างการปลุก – ที่นี่หรือใน Phase Wake บนโทรศัพท์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Alarm oluştur – burada veya telefondaki Phase Wake’te."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Створи будильник – тут або в Phase Wake на телефоні."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tạo báo thức – tại đây hoặc trong Phase Wake trên điện thoại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "创建闹钟 – 在这里或在手机上的 Phase Wake 中。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "建立鬧鐘 – 在這裡或在手機上的 Phase Wake 中。"
          }
        }
      }
    },
    "home_no_alarm_text": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضبطوا وقتًا ونافذة زمنية. تُوقظك ساعتك عندما يكون نومك خفيفًا."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nastav čas a okno. Hodinky tě probudí, když budeš spát lehce."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vælg et tidspunkt og et vindue. Dit ur vækker dig, når du sover let."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stell eine Zeit und ein Fenster ein. Deine Uhr weckt dich, wenn du leicht schläfst."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Όρισε ώρα και παράθυρο. Το ρολόι σε ξυπνά όταν κοιμάσαι ελαφρά."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set a time and a window. Your watch wakes you when you sleep lightly."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige una hora y una ventana. Tu reloj te despierta cuando duermes ligero."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "یک زمان و یک بازه تعیین کن. ساعتت وقتی خواب سبکی داری بیدارت می‌کند."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Aseta aika ja aikaikkuna. Kellosi herättää sinut, kun nukut kevyesti."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisis une heure et une plage. Ta montre te réveille quand ton sommeil est léger."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "קבעו שעה וחלון זמן. השעון יעיר אתכם כשהשינה קלה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "समय और विंडो चुनो। जब तुम्हारी नींद हल्की होगी, घड़ी तुम्हें जगा देगी।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Állíts be egy időpontot és egy időablakot. Az órád akkor ébreszt, amikor könnyen alszol."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Atur waktu dan rentang. Jam tanganmu membangunkanmu saat tidurmu ringan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli un orario e una finestra. Il tuo smartwatch ti sveglia quando dormi leggero."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "時刻と時間幅を設定してください。眠りが浅いときにウォッチが起こします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시간과 범위를 정해 보세요. 얕게 잠들었을 때 워치가 깨워 드려요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tetapkan masa dan tetingkap. Jam tangan akan bangunkan awak ketika tidur awak ringan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Velg et tidspunkt og et vindu. Klokka vekker deg når du sover lett."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stel een tijd en een venster in. Je horloge wekt je als je licht slaapt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ustaw godzinę i okno. Zegarek obudzi cię, gdy będziesz spać lekko."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Defina um horário e uma janela. Seu relógio acorda você quando seu sono está leve."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Define uma hora e uma janela. O teu relógio acorda-te quando dormes de forma leve."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Alege o oră și un interval. Ceasul te trezește când dormi ușor."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Задай время и окно. Часы разбудят тебя, когда сон будет лёгким."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ställ in en tid och ett intervall. Klockan väcker dig när du sover lätt."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตั้งเวลาและช่วงเวลาปลุก นาฬิกาจะปลุกคุณเมื่อคุณหลับตื้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir saat ve bir aralık belirle. Saatin, hafif uyuduğunda seni uyandırır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Задай час і вікно. Годинник розбудить тебе, коли сон буде легким."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đặt giờ và khoảng thời gian. Đồng hồ sẽ đánh thức bạn khi bạn ngủ nông."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设定一个时间和一个时间窗。你睡得浅时，手表会叫醒你。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "設定一個時間和一段時間範圍。你睡得淺時，手錶會叫醒你。"
          }
        }
      }
    },
