    "export_contents_hint": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحتوي الملف على سلاسل الحركة ونبض القلب لكل ليلة – دون أسماء أو تواريخ أو معرّفات أجهزة."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Soubor obsahuje průběh pohybu a tepu za každou noc – bez jmen, dat a ID zařízení."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Filen indeholder bevægelses- og pulsserier for hver nat – uden navne, datoer eller enheds-id’er."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Datei enthält Bewegungs- und Pulsreihen jeder Nacht – ohne Namen, Datum oder Geräte-IDs."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το αρχείο περιέχει σειρές κίνησης και καρδιακών παλμών για κάθε νύχτα – χωρίς ονόματα, ημερομηνίες ή αναγνωριστικά συσκευών."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The file contains motion and heart rate series for each night – without names, dates or device IDs."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El archivo contiene series de movimiento y frecuencia cardiaca de cada noche, sin nombres, fechas ni identificadores de dispositivos."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "فایل شامل سری‌های حرکت و ضربان قلب هر شب است – بدون نام، تاریخ یا شناسه دستگاه."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiedosto sisältää jokaisen yön liike- ja sykesarjat – ilman nimiä, päivämääriä tai laitetunnuksia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le fichier contient les séries de mouvement et de fréquence cardiaque de chaque nuit – sans noms, dates ni identifiants d’appareil."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הקובץ מכיל סדרות של תנועה ודופק לכל לילה – ללא שמות, תאריכים או מזהי מכשירים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फ़ाइल में हर रात की हलचल और हृदय गति की शृंखलाएँ हैं – बिना नाम, तारीख या डिवाइस आईडी के।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A fájl minden éjszaka mozgás- és pulzussorait tartalmazza – nevek, dátumok és eszközazonosítók nélkül."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "File berisi rangkaian data gerakan dan detak jantung setiap malam – tanpa nama, tanggal, atau ID perangkat."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il file contiene le serie di movimento e frequenza cardiaca di ogni notte, senza nomi, date o ID dei dispositivi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイルには各夜の体動と心拍数の記録が含まれます（名前、日付、デバイスIDは含まれません）。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파일에는 이름, 날짜, 기기 ID 없이 밤마다의 움직임 및 심박수 데이터가 들어 있습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Fail ini mengandungi siri pergerakan dan kadar denyutan jantung bagi setiap malam – tanpa nama, tarikh atau ID peranti."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Filen inneholder bevegelses- og pulsserier for hver natt – uten navn, datoer eller enhets-ID-er."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het bestand bevat bewegings- en hartslagreeksen van elke nacht – zonder namen, datums of apparaat-ID’s."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Plik zawiera serie ruchu i tętna z każdej nocy – bez imion, dat i identyfikatorów urządzeń."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O arquivo contém séries de movimento e frequência cardíaca de cada noite – sem nomes, datas ou IDs de dispositivos."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O ficheiro contém séries de movimento e frequência cardíaca de cada noite – sem nomes, datas ou IDs de dispositivos."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Fișierul conține seriile de mișcare și puls din fiecare noapte – fără nume, date sau ID-uri de dispozitiv."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Файл содержит ряды движения и пульса за каждую ночь – без имён, дат и идентификаторов устройств."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Filen innehåller rörelse- och pulsserier för varje natt – utan namn, datum eller enhets-id."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไฟล์มีข้อมูลการเคลื่อนไหวและอัตราการเต้นของหัวใจของแต่ละคืน โดยไม่มีชื่อ วันที่ หรือรหัสอุปกรณ์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dosya her gecenin hareket ve nabız serilerini içerir – ad, tarih veya cihaz kimliği olmadan."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Файл містить ряди руху та пульсу за кожну ніч – без імен, дат та ідентифікаторів пристроїв."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
