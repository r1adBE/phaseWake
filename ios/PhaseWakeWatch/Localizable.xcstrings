    "night_unmeasured_apple": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أول %1$lld د لم تُقس – لا تقيس Apple Watch إلا آخر %2$lld د قبل الموعد."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Prvních %1$lld min neměřeno – Apple Watch měří jen posledních %2$lld min před cílovým časem."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Første %1$lld min ikke målt – Apple Watch måler kun de sidste %2$lld min før ønsket tid."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erste %1$lld Min nicht gemessen – die Apple Watch misst nur die letzten %2$lld Min vor der Zielzeit."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τα πρώτα %1$lld λ. δεν μετρήθηκαν – το Apple Watch μετρά μόνο τα τελευταία %2$lld λ. πριν τον στόχο."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "First %1$lld min not measured – the Apple Watch only measures the last %2$lld min before the target."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Primeros %1$lld min sin medir: el Apple Watch solo mide los últimos %2$lld min antes de la hora objetivo."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld دق اول اندازه‌گیری نشد – Apple Watch فقط %2$lld دق آخر پیش از زمان هدف را اندازه می‌گیرد."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ensimmäiset %1$lld min mittaamatta – Apple Watch mittaa vain viimeiset %2$lld min ennen tavoiteaikaa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld premières min non mesurées – l’Apple Watch ne mesure que les %2$lld dernières min avant l’heure cible."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld הדק׳ הראשונות לא נמדדו – Apple Watch מודד רק את %2$lld הדק׳ האחרונות לפני היעד."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पहले %1$lld मि. मापे नहीं गए – Apple Watch लक्ष्य से पहले के केवल आख़िरी %2$lld मि. मापती है।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az első %1$lld p nincs mérve – az Apple Watch csak a célidő előtti utolsó %2$lld percet méri."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld mnt pertama tidak diukur – Apple Watch hanya mengukur %2$lld mnt terakhir sebelum target."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Primi %1$lld min non misurati – l’Apple Watch misura solo gli ultimi %2$lld min prima dell’orario obiettivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最初の%1$lld分は未計測 – Apple Watchが計測するのは目標時刻前の最後の%2$lld分だけです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "처음 %1$lld분은 측정되지 않음 – Apple Watch는 목표 전 마지막 %2$lld분만 측정합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld min pertama tidak diukur – Apple Watch hanya mengukur %2$lld min terakhir sebelum sasaran."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Første %1$lld min ikke målt – Apple Watch måler bare de siste %2$lld min før ønsket tid."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Eerste %1$lld min niet gemeten – de Apple Watch meet alleen de laatste %2$lld min voor de doeltijd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pierwsze %1$lld min bez pomiaru – Apple Watch mierzy tylko ostatnie %2$lld min przed czasem docelowym."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Primeiros %1$lld min sem medição – o Apple Watch só mede os últimos %2$lld min antes do horário-alvo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Primeiros %1$lld min sem medição – o Apple Watch só mede os últimos %2$lld min antes da hora-alvo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Primele %1$lld min nemăsurate – Apple Watch măsoară doar ultimele %2$lld min dinainte de ora țintă."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Первые %1$lld мин не измерены – Apple Watch измеряют только последние %2$lld мин до цели."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Första %1$lld min inte uppmätta – Apple Watch mäter bara de sista %2$lld min före måltiden."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld นาทีแรกไม่ได้วัด – Apple Watch วัดเฉพาะ %2$lld นาทีสุดท้ายก่อนเวลาเป้าหมาย"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İlk %1$lld dk ölçülmedi – Apple Watch yalnızca hedef saatten önceki son %2$lld dk’yı ölçer."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перші %1$lld хв не виміряно – Apple Watch вимірює лише останні %2$lld хв до цілі."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld phút đầu không được đo – Apple Watch chỉ đo %2$lld phút cuối trước giờ mục tiêu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "前 %1$lld 分钟未测量——Apple Watch 只测量目标时间前的最后 %2$lld 分钟。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "前 %1$lld 分鐘未測量——Apple Watch 只測量目標時間前的最後 %2$lld 分鐘。"
          }
        }
      }
    },
