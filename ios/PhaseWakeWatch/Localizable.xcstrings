    "trends_health_hint": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مدة النوم وانتظامه يأتيان من Health Connect."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Délka a pravidelnost spánku pocházejí z Health Connect."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Søvnlængde og regelmæssighed kommer fra Health Connect."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schlafdauer und Regelmässigkeit kommen aus Health Connect."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η διάρκεια και η κανονικότητα του ύπνου προέρχονται από το Health Connect."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sleep duration and regularity come from Health Connect."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La duración y la regularidad del sueño provienen de Health Connect."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "مدت و نظم خواب از Health Connect می‌آید."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Unen kesto ja säännöllisyys tulevat Health Connectista."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La durée et la régularité du sommeil proviennent de Health Connect."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "משך השינה והסדירות שלה מגיעים מ-Health Connect."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नींद की अवधि और नियमितता Health Connect से आती है।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az alvás időtartama és rendszeressége a Health Connectből származik."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Durasi dan keteraturan tidur berasal dari Health Connect."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Durata e regolarità del sonno provengono da Health Connect."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "睡眠時間と規則性は Health Connect から取得されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "수면 시간과 규칙성은 Health Connect에서 가져와요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tempoh dan keteraturan tidur datang daripada Health Connect."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Søvnlengde og regelmessighet hentes fra Health Connect."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Slaapduur en regelmaat komen uit Health Connect."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Czas i regularność snu pochodzą z Health Connect."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A duração e a regularidade do sono vêm do Health Connect."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A duração e a regularidade do sono vêm do Health Connect."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Durata și regularitatea somnului provin din Health Connect."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Длительность и регулярность сна берутся из Health Connect."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Sömnlängd och regelbundenhet kommer från Health Connect."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ระยะเวลาและความสม่ำเสมอของการนอนมาจาก Health Connect"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uyku süresi ve düzeni Health Connect’ten gelir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тривалість і регулярність сну беруться з Health Connect."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thời lượng và độ đều đặn của giấc ngủ lấy từ Health Connect."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "睡眠时长和规律性来自 Health Connect。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "睡眠時間長度和規律性來自 Health Connect。"
          }
        }
      }
    },
