    "editor_sunrise_ring_hint|few": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يبدأ عند إيقاظك ويصبح ساطعًا تمامًا بعد %1$lld دقائق."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Začne, když tě probudí, a po %1$lld minutách naplno září."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaczyna się, gdy cię obudzimy, a po %1$lld minutach świeci pełną jasnością."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Pornește când ești trezit și este complet luminos după %1$lld minute."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Начинается, когда тебя будят, и через %1$lld минуты светит на полную яркость."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Починається, коли тебе будять, і через %1$lld хвилини світить на повну яскравість."
          }
        }
      }
    },
