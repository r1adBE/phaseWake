    "check_watch_update_problem": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حتى ذلك الحين لن تتخطى الساعة أي منبّه وستوقظك أيضًا في العطل."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Do té doby hodinky nic nepřeskočí a budí tě i o svátcích."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Indtil da springer uret ingen alarmer over og vækker dig også på helligdage."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bis dahin überspringt die Uhr keine Termine und weckt auch an Feiertagen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μέχρι τότε το ρολόι δεν παραλείπει καμία αφύπνιση και σε ξυπνά και τις αργίες."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Until then, your watch won’t skip alarms and will also wake you on holidays."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hasta entonces, el reloj no saltará ninguna alarma y también te despertará en festivos."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "تا آن موقع ساعت هیچ زنگی را رد نمی‌کند و روزهای تعطیل هم بیدارت می‌کند."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Siihen asti kello ei ohita herätyksiä ja herättää myös juhlapäivinä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "D'ici là, ta montre ne saute aucun réveil et te réveille aussi les jours fériés."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "עד אז השעון לא ידלג על אף השכמה ויעיר אתכם גם בחגים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "तब तक वॉच कोई अलार्म नहीं छोड़ेगी और छुट्टियों पर भी आपको जगाएगी।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Addig az óra nem hagy ki ébresztést, és ünnepnapokon is felébreszt."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sampai saat itu, jam tanganmu tidak akan melewati alarm dan tetap membangunkanmu saat hari libur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fino ad allora l'orologio non salta nessuna sveglia e ti sveglia anche nei festivi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "それまでウォッチはアラームをスキップせず、祝日にも起こします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그때까지 워치는 알람을 건너뛰지 않고 공휴일에도 깨워요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sehingga itu, jam tangan tidak akan melangkau penggera dan tetap mengejutkan awak pada cuti umum."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Frem til da hopper ikke klokken over noen alarmer og vekker deg også på helligdager."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tot die tijd slaat het horloge geen wekker over en wekt het je ook op feestdagen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Do tego czasu zegarek nie pominie żadnego budzika i obudzi cię także w święta."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Até lá, o relógio não vai pular alarmes e também vai te acordar em feriados."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Até lá, o relógio não salta nenhum alarme e também te acorda nos feriados."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Până atunci, ceasul nu sare peste nicio alarmă și te trezește și în sărbători."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "До этого часы не пропускают будильники и будят тебя и в праздники."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tills dess hoppar klockan inte över några alarm och väcker dig även på helgdagar."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "จนกว่าจะอัปเดต นาฬิกาจะไม่ข้ามการปลุกใดและจะปลุกคุณในวันหยุดด้วย"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "O zamana kadar saat hiçbir alarmı atlamaz ve tatillerde de seni uyandırır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
