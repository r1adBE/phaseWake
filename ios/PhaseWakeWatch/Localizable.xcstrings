    "goal_hint": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُحتسب في حصيلة الأسبوع ويحدد موعد نومك."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Počítá se do týdenní bilance a určuje čas, kdy jít spát."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Bruges i ugens status og bestemmer din sengetid."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zählt für die Wochenbilanz und bestimmt deine Bettzeit."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μετράει στον απολογισμό της εβδομάδας και ορίζει την ώρα ύπνου."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Used for your weekly balance and your bedtime."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuenta para el balance semanal y fija tu hora de acostarte."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "در جمع‌بندی هفته حساب می‌شود و زمان خوابت را تعیین می‌کند."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Käytetään viikon yhteenvedossa ja nukkumaanmenoajassa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sert au bilan de la semaine et fixe ton heure du coucher."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "נספר במאזן השבועי וקובע את שעת השינה שלך."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "साप्ताहिक हिसाब में गिना जाता है और सोने का समय तय करता है।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A heti mérlegbe számít, és meghatározza a lefekvés idejét."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Dihitung dalam ringkasan mingguan dan menentukan waktu tidurmu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Conta per il bilancio settimanale e stabilisce l’ora di andare a letto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "週のまとめに使われ、就寝時刻を決めます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "주간 결과에 반영되고 취침 시간을 정해요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Dikira dalam ringkasan mingguan dan menentukan waktu tidur anda."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Brukes i ukesoversikten og bestemmer leggetiden din."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Telt mee in je weekoverzicht en bepaalt je bedtijd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Liczy się do bilansu tygodnia i wyznacza porę snu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Conta para o balanço semanal e define seu horário de dormir."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Conta para o balanço semanal e define a tua hora de deitar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
