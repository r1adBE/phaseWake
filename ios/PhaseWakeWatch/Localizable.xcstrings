        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Watch: ยังไม่ได้เปิดนาฬิกาปลุก – มีแค่การแจ้งเตือน ไม่มีระยะการนอน เปิดแอปบนนาฬิกา"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Watch: alarm kurulu değil – yalnızca bildirim, uyku evresi yok. Saat uygulamasını aç."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Watch: будильник не ввімкнено – лише сповіщення, без фаз сну. Відкрий застосунок на годиннику."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Watch: الارم فعال نہیں – صرف اطلاع، نیند کے مراحل نہیں۔ گھڑی کی ایپ کھولو۔"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Watch: budilnik yoqilmagan – faqat bildirishnoma, uyqu bosqichlari yoʻq. Soat ilovasini och."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Watch: báo thức chưa được bật – chỉ có thông báo, không có giai đoạn ngủ. Hãy mở ứng dụng trên đồng hồ."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Watch：鬧鐘未啟用——只有通知，冇睡眠階段。請開啟手錶 App。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Watch：闹钟未启用——只有通知，没有睡眠阶段。请打开手表应用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Watch：鬧鐘未啟用——只有通知，沒有睡眠階段。請開啟手錶 App。"
          }
        },
        "zu": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Watch: i-alamu ayivuliwe – isaziso kuphela, azikho izigaba zokulala. Vula uhlelo lokusebenza lwewashi."
          }
        }
      }
