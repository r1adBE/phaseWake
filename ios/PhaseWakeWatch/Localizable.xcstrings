    "onb_done_text": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكنك تغيير كل شيء لاحقًا في الإعدادات. تصبح على خير!"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vše můžeš později změnit v nastavení. Dobrou noc!"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan ændre alt senere i indstillingerne. Godnat!"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles lässt sich später in den Einstellungen ändern. Gute Nacht!"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μπορείς να αλλάξεις τα πάντα αργότερα στις ρυθμίσεις. Καληνύχτα!"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can change everything later in the settings. Good night!"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes cambiarlo todo más tarde en los ajustes. ¡Buenas noches!"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "بعداً می‌توانی همه‌چیز را در تنظیمات تغییر دهی. شب بخیر!"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Voit muuttaa kaiken myöhemmin asetuksissa. Hyvää yötä!"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu peux tout modifier plus tard dans les réglages. Bonne nuit !"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אפשר לשנות הכול מאוחר יותר בהגדרות. לילה טוב!"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप सब कुछ बाद में सेटिंग में बदल सकते हैं। शुभ रात्रि!"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Később mindent módosíthatsz a beállításokban. Jó éjszakát!"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Semuanya bisa diubah nanti di setelan. Selamat tidur!"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Puoi cambiare tutto più tardi nelle impostazioni. Buonanotte!"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべて後から設定で変更できます。おやすみなさい！"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "나중에 설정에서 모두 바꿀 수 있어요. 잘 자요!"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Semuanya boleh diubah kemudian dalam tetapan. Selamat malam!"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan endre alt senere i innstillingene. God natt!"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je kunt alles later in de instellingen wijzigen. Welterusten!"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wszystko możesz później zmienić w ustawieniach. Dobranoc!"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você pode mudar tudo depois nas configurações. Boa noite!"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Podes alterar tudo mais tarde nas definições. Boa noite!"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Poți schimba totul mai târziu în setări. Noapte bună!"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Всё можно изменить позже в настройках. Спокойной ночи!"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan ändra allt senare i inställningarna. God natt!"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปลี่ยนทุกอย่างได้ภายหลังในการตั้งค่า ฝันดี!"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her şeyi daha sonra ayarlardan değiştirebilirsin. İyi geceler!"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Усе можна змінити пізніше в налаштуваннях. Добраніч!"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn có thể đổi mọi thứ sau trong cài đặt. Chúc ngủ ngon!"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "以后可以在设置中更改一切。晚安！"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "之後可以在設定中更改一切。晚安！"
          }
        }
      }
    },
