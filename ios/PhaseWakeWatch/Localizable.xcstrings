    "home_window_running": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "النافذة قيد التشغيل – جارٍ القياس الآن"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Okno běží – právě se měří"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vinduet kører – måler nu"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Weckfenster läuft – es wird gemessen"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το παράθυρο τρέχει – γίνεται μέτρηση"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wake window running – measuring now"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ventana en curso – midiendo ahora"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "بازه در حال اجراست – اکنون اندازه‌گیری می‌شود"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Aikaikkuna käynnissä – mitataan nyt"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Plage en cours – mesure en cours"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "החלון פועל – מודדים עכשיו"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "विंडो चल रही है – अभी मापा जा रहा है"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az időablak fut – most mér"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Rentang berjalan – sedang mengukur"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Finestra in corso – misurazione in corso"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "時間幅の計測中です"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "범위 진행 중 – 지금 측정하고 있어요"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tetingkap berjalan – sedang mengukur sekarang"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Vinduet pågår – måler nå"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Venster loopt – er wordt nu gemeten"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Okno trwa – trwa pomiar"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Janela em andamento – medindo agora"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Janela em curso – a medir agora"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Intervalul este în desfășurare – se măsoară acum"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Окно идёт – сейчас идёт измерение"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Fönstret pågår – mäter nu"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ช่วงเวลาปลุกกำลังทำงาน – กำลังวัดอยู่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aralık sürüyor – şu an ölçülüyor"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вікно триває – зараз іде вимірювання"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khoảng thời gian đang chạy – đang đo"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "时间窗运行中——正在监测"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "時間範圍執行中——正在偵測"
          }
        }
      }
    },
    "nap_hint": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يوقظك بعد هذه المدة، وفي الدقائق الأخيرة عند النوم الخفيف. لا تُحتسب ليلة."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vzbudí tě po této době, v posledních minutách už při lehkém spánku. Nepočítá se jako noc."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vækker dig efter denne tid, de sidste minutter allerede ved let søvn. Tæller ikke som en nat."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Weckt dich nach dieser Zeit, in den letzten Minuten schon bei leichtem Schlaf. Zählt nicht als Nacht."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Σε ξυπνά μετά από αυτόν τον χρόνο, στα τελευταία λεπτά ήδη σε ελαφρύ ύπνο. Δεν μετράει ως νύχτα."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wakes you after this time, in the last minutes already in light sleep. Doesn’t count as a night."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Te despierta tras este tiempo, en los últimos minutos ya en sueño ligero. No cuenta como noche."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "بعد از این مدت بیدارت می‌کند، در دقیقه‌های آخر از همان خواب سبک. شب حساب نمی‌شود."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Herättää sinut tämän ajan jälkeen, viimeisinä minuutteina jo kevyessä unessa. Ei lasketa yöksi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Te réveille après ce délai, dans les dernières minutes déjà en sommeil léger. Ne compte pas comme une nuit."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מעיר אתכם אחרי הזמן הזה, בדקות האחרונות כבר בשינה קלה. לא נחשב כלילה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस समय के बाद जगाता है, आखिरी मिनटों में हल्की नींद होने पर पहले ही। रात के रूप में नहीं गिना जाता।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ennyi idő után ébreszt, az utolsó percekben már éber alvásnál. Nem számít éjszakának."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Membangunkanmu setelah waktu ini, di menit-menit terakhir saat tidurmu ringan. Tidak dihitung sebagai malam."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ti sveglia dopo questo tempo, negli ultimi minuti già nel sonno leggero. Non conta come notte."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この時間の後に起こします。最後の数分は眠りが浅ければ先に起こします。夜としては記録されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 시간 후에 깨워 줘요. 마지막 몇 분은 잠이 얕으면 미리 깨워요. 밤으로 기록되지 않아요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Mengejutkan awak selepas masa ini, pada minit-minit terakhir apabila tidur ringan. Tidak dikira sebagai malam."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Vekker deg etter denne tiden, de siste minuttene allerede ved lett søvn. Teller ikke som en natt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wekt je na deze tijd, in de laatste minuten al bij lichte slaap. Telt niet als nacht."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Budzi Cię po tym czasie, w ostatnich minutach już przy płytkim śnie. Nie liczy się jako noc."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Acorda você após esse tempo, nos últimos minutos já em sono leve. Não conta como noite."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Acorda-te após este tempo, nos últimos minutos já em sono leve. Não conta como noite."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Te trezește după acest timp, în ultimele minute deja în somn ușor. Nu contează ca noapte."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Будит тебя через это время, в последние минуты уже при чутком сне. Не считается ночью."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Väcker dig efter den här tiden, de sista minuterna redan vid lätt sömn. Räknas inte som en natt."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ปลุกคุณหลังเวลานี้ ในไม่กี่นาทีสุดท้ายจะปลุกก่อนถ้าหลับตื้น ไม่นับเป็นคืน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu sürenin sonunda, son dakikalarda hafif uykudayken seni uyandırır. Gece sayılmaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Будить тебе після цього часу, в останні хвилини вже під час чуткого сну. Не вважається ніччю."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đánh thức bạn sau khoảng thời gian này, trong vài phút cuối nếu đang ngủ nông. Không tính là một đêm."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在这段时间后叫醒你，最后几分钟内睡得浅时会提前叫醒。不计为一晚。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在這段時間後叫醒你，最後幾分鐘內睡得淺時會提前叫醒。不計為一晚。"
          }
        }
      }
    },
