    "restore_confirm_text": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ستُستبدل المنبّهات والسجل والملاحظات والإعدادات على هذا الهاتف بالنسخة."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Budíky, historie, poznámky a nastavení v tomto telefonu budou nahrazeny zálohou."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Alarmer, historik, noter og indstillinger på denne telefon erstattes af kopien."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wecker, Verlauf, Notizen und Einstellungen auf diesem Handy werden durch die Sicherung ersetzt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι αφυπνίσεις, το ιστορικό, οι σημειώσεις και οι ρυθμίσεις αυτού του κινητού θα αντικατασταθούν από το αντίγραφο."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Alarms, history, notes and settings on this phone will be replaced by the backup."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las alarmas, el historial, las notas y los ajustes de este teléfono se reemplazarán por la copia."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "زنگ‌ها، سابقه، یادداشت‌ها و تنظیمات این گوشی با پشتیبان جایگزین می‌شوند."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämän puhelimen herätykset, historia, muistiinpanot ja asetukset korvataan varmuuskopiolla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les réveils, l’historique, les notes et les réglages de ce téléphone seront remplacés par la sauvegarde."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ההשכמות, ההיסטוריה, ההערות וההגדרות בטלפון הזה יוחלפו בגיבוי."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस फ़ोन के अलार्म, इतिहास, नोट और सेटिंग बैकअप से बदल दिए जाएंगे।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A telefon ébresztőit, előzményeit, jegyzeteit és beállításait a mentés váltja fel."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Alarm, riwayat, catatan, dan setelan di ponsel ini akan diganti dengan cadangan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sveglie, cronologia, note e impostazioni su questo telefono saranno sostituite dal backup."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このスマホのアラーム、履歴、メモ、設定がバックアップで置き換えられます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 휴대폰의 알람, 기록, 메모, 설정이 백업으로 바뀌어요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Penggera, sejarah, nota dan tetapan pada telefon ini akan digantikan dengan sandaran."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Alarmer, historikk, notater og innstillinger på denne telefonen erstattes av kopien."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wekkers, geschiedenis, notities en instellingen op deze telefoon worden vervangen door de back-up."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Budziki, historia, notatki i ustawienia na tym telefonie zostaną zastąpione kopią."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Alarmes, histórico, notas e configurações deste celular serão substituídos pelo backup."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
