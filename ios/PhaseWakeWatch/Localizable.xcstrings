    "wake_task_hint": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حلّ 3 عمليات قبل أن يصمت المنبه. الغفوة تعمل بدون عملية."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyřeš 3 příklady, než budík utichne. Odložení funguje bez příkladu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Løs 3 opgaver, før alarmen tier. Udsæt virker uden opgave."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "3 Aufgaben lösen, bevor der Wecker verstummt. Schlummern geht ohne Aufgabe."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Λύσε 3 πράξεις πριν σωπάσει το ξυπνητήρι. Η αναβολή γίνεται χωρίς πράξη."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Solve 3 sums before the alarm goes quiet. Snoozing works without a task."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Resuelve 3 sumas antes de que la alarma se calle. Posponer funciona sin cálculo."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "پیش از آنکه زنگ ساکت شود ۳ جمع را حل کن. چرت بدون حساب ممکن است."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ratkaise 3 laskua ennen kuin herätys hiljenee. Torkku toimii ilman tehtävää."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Résous 3 calculs avant que l’alarme se taise. La répétition fonctionne sans calcul."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לפתור 3 תרגילים לפני שהשעון משתתק. נודניק עובד גם בלי תרגיל."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अलार्म चुप होने से पहले 3 जोड़ हल करो। स्नूज़ बिना सवाल के चलता है।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Oldj meg 3 feladatot, mielőtt az ébresztő elhallgat. A szundi feladat nélkül is megy."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Selesaikan 3 soal sebelum alarm diam. Tunda bisa tanpa soal."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Risolvi 3 calcoli prima che la sveglia taccia. Il posticipo funziona senza calcolo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アラームが止まる前に計算を3問解きます。スヌーズは問題なしでできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "알람이 꺼지기 전에 계산 3문제를 풀어요. 다시 알림은 문제 없이 돼요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Selesaikan 3 soalan sebelum penggera senyap. Tunda boleh tanpa soalan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Løs 3 oppgaver før alarmen blir stille. Slumre går uten oppgave."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Los 3 sommen op voordat de wekker stil wordt. Sluimeren kan zonder som."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rozwiąż 3 działania, zanim budzik ucichnie. Drzemka działa bez zadania."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Resolva 3 contas antes de o alarme silenciar. Soneca funciona sem conta."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Resolve 3 contas antes de o alarme se calar. Adiar funciona sem conta."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Rezolvă 3 calcule înainte ca alarma să tacă. Amânarea merge fără calcul."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Реши 3 примера, прежде чем будильник замолчит. Отложить можно без примера."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lös 3 uppgifter innan larmet tystnar. Snooza går utan uppgift."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แก้โจทย์บวก 3 ข้อก่อนนาฬิกาปลุกเงียบ เลื่อนปลุกได้โดยไม่ต้องทำโจทย์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Alarm susmadan önce 3 işlem çöz. Erteleme işlemsiz çalışır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Розв’яжи 3 приклади, перш ніж будильник замовкне. Відкласти можна без прикладу."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giải 3 phép cộng trước khi báo thức im. Báo lại không cần giải."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "闹钟停止前要解 3 道加法题。贪睡无需答题。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "鬧鐘停止前要解 3 道加法題。貪睡無需答題。"
          }
        }
      }
    },
