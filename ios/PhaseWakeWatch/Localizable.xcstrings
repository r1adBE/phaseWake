    "sounds_hint": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعمل بمستوى صوت الوسائط ويتوقف على الأكثر عند بدء نافذة الاستيقاظ."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Hraje hlasitostí médií a skončí nejpozději, když začne tvé okno buzení."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Afspilles med medielydstyrken og stopper senest, når dit vækkevindue begynder."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Spielt mit der Medienlautstärke und hört spätestens auf, wenn dein Weckfenster beginnt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Παίζει με την ένταση πολυμέσων και σταματά το αργότερο όταν αρχίζει το παράθυρο αφύπνισής σου."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Plays at media volume and stops at the latest when your wake window begins."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Suena con el volumen multimedia y se detiene como muy tarde cuando empieza tu ventana de alarma."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "با صدای رسانه پخش می‌شود و حداکثر با شروع پنجرهٔ بیداری‌ات قطع می‌شود."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Soi median äänenvoimakkuudella ja loppuu viimeistään, kun herätysikkunasi alkaa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Joue au volume multimédia et s’arrête au plus tard au début de ta fenêtre de réveil."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מתנגן בעוצמת המדיה ונעצר לכל המאוחר כשחלון ההשכמה שלך מתחיל."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मीडिया वॉल्यूम पर चलता है और ज़्यादा से ज़्यादा तब रुक जाता है जब तुम्हारी जागने की विंडो शुरू होती है।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Médiahangerőn szól, és legkésőbb akkor elhallgat, amikor az ébresztési ablakod kezdődik."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Diputar dengan volume media dan berhenti paling lambat saat jendela bangunmu dimulai."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Suona al volume multimediale e si ferma al più tardi quando inizia la tua finestra di sveglia."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メディアの音量で再生し、遅くとも起床ウィンドウが始まると止まります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "미디어 볼륨으로 재생되며 늦어도 기상 시간대가 시작되면 멈춰요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Dimainkan pada kelantangan media dan berhenti paling lewat apabila tetingkap bangun anda bermula."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Spilles med medievolumet og stopper senest når vekkevinduet ditt begynner."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Speelt op mediavolume en stopt uiterlijk wanneer je wekvenster begint."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gra z głośnością multimediów i milknie najpóźniej, gdy zaczyna się twoje okno budzenia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca no volume de mídia e para, no máximo, quando começa sua janela de despertar."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca no volume multimédia e para, no máximo, quando começa a tua janela de despertar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Se aude la volumul media și se oprește cel târziu când începe fereastra ta de trezire."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Играет на громкости медиа и выключается не позже начала твоего окна пробуждения."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Spelas på medievolym och slutar senast när ditt väckningsfönster börjar."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เล่นด้วยระดับเสียงสื่อ และหยุดอย่างช้าที่สุดเมื่อช่วงเวลาปลุกของคุณเริ่ม"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Medya ses seviyesinde çalar ve en geç uyandırma pencereni başladığında durur."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Грає з гучністю медіа і вимикається не пізніше початку твого вікна пробудження."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phát theo âm lượng phương tiện và dừng muộn nhất khi khung giờ đánh thức của bạn bắt đầu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "以媒体音量播放,最迟在你的唤醒时段开始时停止。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "以媒體音量播放,最遲在你的喚醒時段開始時停止。"
          }
        }
      }
    },
