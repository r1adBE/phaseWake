    "check_battery_problem": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أقل من %1$lld %% – اشحن هاتفك ليتمكن المنبه الاحتياطي من الرنين."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pod %1$lld %% – nabij telefon, aby mohl zazvonit záložní budík."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Under %1$lld %% – oplad din telefon, så backup-alarmen kan ringe."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unter %1$lld %% – lade das Handy, damit der Zweitwecker sicher klingelt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κάτω από %1$lld %% – φόρτισε το κινητό σου, ώστε να μπορεί να χτυπήσει το εφεδρικό ξυπνητήρι."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Below %1$lld %% – charge your phone so the backup alarm can ring."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Menos del %1$lld %% – carga tu teléfono para que la alarma de respaldo pueda sonar."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "کمتر از %1$lld %% – گوشی را شارژ کن تا زنگ پشتیبان بتواند زنگ بزند."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle %1$lld %% – lataa puhelin, jotta varaherätys voi soida."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Moins de %1$lld %% – recharge ton téléphone pour que l’alarme de secours puisse sonner."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מתחת ל-%1$lld %% – טענו את הטלפון כדי שהשעון המעורר לגיבוי יוכל לצלצל."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld %% से कम – अपना फ़ोन चार्ज करें ताकि बैकअप अलार्म बज सके।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld %% alatt – töltsd fel a telefont, hogy a tartalék ébresztő meg tudjon szólalni."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Di bawah %1$lld %% – isi daya ponselmu agar alarm cadangan bisa berbunyi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sotto il %1$lld %% – ricarica il telefono perché la sveglia di riserva possa suonare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld %%未満です – バックアップのアラームが鳴るよう、スマートフォンを充電してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld %% 미만 – 예비 알람이 울릴 수 있도록 휴대폰을 충전해 주세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kurang daripada %1$lld %% – cas telefon awak supaya penggera sandaran boleh berdering."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Under %1$lld %% – lad telefonen slik at reservealarmen kan ringe."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Onder %1$lld %% – laad je telefoon op zodat de back-upwekker kan afgaan."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Poniżej %1$lld %% – naładuj telefon, aby zapasowy budzik mógł zadzwonić."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abaixo de %1$lld %% – carregue seu celular para que o alarme reserva possa tocar."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Abaixo de %1$lld %% – carrega o telemóvel para que o alarme de reserva possa tocar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Sub %1$lld %% – încarcă telefonul ca alarma de rezervă să poată suna."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ниже %1$lld %% – поставь телефон на зарядку, чтобы резервный будильник смог зазвонить."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Under %1$lld %% – ladda telefonen så att reservalarmet kan ringa."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ต่ำกว่า %1$lld %% – ชาร์จโทรศัพท์เพื่อให้นาฬิกาปลุกสำรองดังได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pil %1$lld %% altında – yedek alarmın çalabilmesi için telefonunu şarj et."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Нижче %1$lld %% – постав телефон на зарядку, щоб резервний будильник міг задзвонити."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dưới %1$lld %% – hãy sạc điện thoại để báo thức dự phòng có thể reo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "低于 %1$lld %% – 请给手机充电，以便备用闹钟能够响铃。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "低於 %1$lld %% – 請為手機充電，以便備用鬧鐘能夠響鈴。"
          }
        }
      }
    },
    "check_dnd": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عدم الإزعاج يسمح بالمنبهات"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Režim Nerušit propouští budíky"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Forstyr ikke lader alarmer igennem"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "«Nicht stören» lässt Wecker durch"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το «Μην ενοχλείτε» επιτρέπει ξυπνητήρια"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Do Not Disturb lets alarms through"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No molestar deja pasar las alarmas"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "مزاحم نشوید، زنگ‌ها را عبور می‌دهد"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Älä häiritse päästää herätykset läpi"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne pas déranger laisse passer les alarmes"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "״נא לא להפריע״ מאפשר שעונים מעוררים"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "डू नॉट डिस्टर्ब में अलार्म की अनुमति है"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Ne zavarjanak átengedi az ébresztőket"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jangan Ganggu meloloskan alarm"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non disturbare lascia passare le sveglie"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "おやすみモード中もアラームが鳴ります"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "방해 금지 모드에서도 알람이 울려요"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Jangan Ganggu membenarkan penggera"
          }
        },
        "nb": {
          "stringUnit": {
