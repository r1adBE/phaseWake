          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Uten varsler kan ikke telefonen ringe som reservealarm."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zonder meldingen kan je telefoon niet overgaan als back-upwekker."
