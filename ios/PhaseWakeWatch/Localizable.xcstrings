    "feeling_hint": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مع الوقت سترى ما إذا كان الاستيقاظ في النوم الخفيف يفيدك."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Časem uvidíš, jestli ti probuzení v lehkém spánku dělá dobře."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Med tiden kan du se, om det gør dig godt at vågne i let søvn."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "So siehst du mit der Zeit, ob dir das Wecken im leichten Schlaf guttut."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Με τον καιρό θα δεις αν σου κάνει καλό να ξυπνάς σε ελαφρύ ύπνο."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Over time you’ll see whether waking in light sleep does you good."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Con el tiempo verás si despertar en sueño ligero te sienta bien."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "با گذشت زمان می‌بینی که بیدارشدن در خواب سبک برایت خوب است یا نه."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajan myötä näet, tekeekö kevyessä unessa herääminen sinulle hyvää."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avec le temps, tu verras si te réveiller en sommeil léger te fait du bien."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "עם הזמן תראו אם התעוררות בשינה קלה עושה לכם טוב."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "समय के साथ आप देखेंगे कि हल्की नींद में जागना आपके लिए अच्छा है या नहीं।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Idővel látni fogod, jót tesz-e neked a könnyű alvásban ébredés."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Seiring waktu kamu akan melihat apakah bangun di tidur ringan baik untukmu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Col tempo vedrai se svegliarti nel sonno leggero ti fa bene."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "続けると、浅い眠りで起きることが自分に合っているかが分かります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시간이 지나면 얕은 잠에서 깨는 게 도움이 되는지 알 수 있어요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Lama-kelamaan awak akan nampak sama ada bangun dalam tidur ringan memberi manfaat."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Over tid ser du om det gjør deg godt å våkne i lett søvn."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Na verloop van tijd zie je of wakker worden in lichte slaap je goed doet."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Z czasem zobaczysz, czy budzenie się w lekkim śnie ci służy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Com o tempo, você verá se acordar durante o sono leve faz bem a você."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Com o tempo, vais ver se acordar em sono leve te faz bem."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "În timp vei vedea dacă trezirea în somn ușor îți face bine."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Со временем ты увидишь, идёт ли тебе на пользу пробуждение в лёгком сне."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Med tiden ser du om det gör dig gott att vakna i lätt sömn."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เมื่อใช้ไปสักพัก คุณจะเห็นว่าการตื่นในช่วงหลับตื้นดีกับคุณหรือไม่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zamanla hafif uykuda uyanmanın sana iyi gelip gelmediğini göreceksin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "З часом ти побачиш, чи йде тобі на користь пробудження в легкому сні."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Theo thời gian, bạn sẽ thấy việc thức dậy khi ngủ nhẹ có tốt cho bạn không."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "久而久之，你会看到在浅睡眠时醒来是否对你有益。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "久而久之，你會看到在淺眠時醒來是否對你有益。"
          }
        }
      }
    },
