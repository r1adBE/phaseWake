    "editor_alarm_gone": {
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Hierdie wekker is intussen uitgevee."
          }
        },
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "ይህ ማንቂያ በመሃሉ ተሰርዟል።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حُذف هذا المنبّه في هذه الأثناء."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu siqnal artıq silinib."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Този будилник междувременно е изтрит."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই অ্যালার্মটি ইতিমধ্যে মুছে ফেলা হয়েছে।"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovaj alarm je u međuvremenu izbrisan."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Aquesta alarma s’ha suprimit mentrestant."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tento budík byl mezitím smazán."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne alarm er blevet slettet i mellemtiden."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Wecker wurde inzwischen gelöscht."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτό το ξυπνητήρι διαγράφηκε στο μεταξύ."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This alarm was deleted in the meantime."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta alarma se ha eliminado mientras tanto."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "See äratus on vahepeal kustutatud."
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "Alarma hau ezabatu egin da bitartean."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "این زنگ در این فاصله حذف شده است."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä herätys on poistettu sillä välin."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Na-delete na ang alarm na ito."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce réveil a été supprimé entre-temps."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Scriosadh an t-aláram seo idir an dá linn."
          }
        },
        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta alarma eliminouse mentres tanto."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "આ એલાર્મ દરમિયાન કાઢી નખાયો છે."
          }
        },
        "he": {
