    "notes_custom_hint": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حتى %1$lld ملاحظات خاصة، مثل «تأمل»."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Až %1$lld vlastních poznámek, např. „Meditace“."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Op til %1$lld egne noter, for eksempel “Meditation”."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bis zu %1$lld eigene Notizen, z. B. «Meditation»."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Έως %1$lld δικές σου σημειώσεις, π.χ. «Διαλογισμός»."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Up to %1$lld notes of your own, for example “Meditation”."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hasta %1$lld notas propias, por ejemplo «Meditación»."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "تا %1$lld یادداشت خودت، مثلاً «مدیتیشن»."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Enintään %1$lld omaa muistiinpanoa, esimerkiksi ”Meditaatio”."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Jusqu’à %1$lld notes personnelles, par exemple « Méditation »."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "עד %1$lld הערות משלך, למשל ״מדיטציה״."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपने %1$lld नोट्स तक, जैसे “ध्यान”।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Legfeljebb %1$lld saját jegyzet, például „Meditáció”."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hingga %1$lld catatan sendiri, misalnya “Meditasi”."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fino a %1$lld note tue, ad esempio «Meditazione»."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自分のメモは %1$lld 個まで(例:「瞑想」)。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "나만의 메모는 최대 %1$lld개 (예: ‘명상’)."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sehingga %1$lld catatan sendiri, contohnya “Meditasi”."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Opptil %1$lld egne notater, for eksempel «Meditasjon»."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tot %1$lld eigen notities, bijvoorbeeld ‘Meditatie’."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Do %1$lld własnych notatek, np. „Medytacja”."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Até %1$lld notas suas, por exemplo “Meditação”."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Até %1$lld notas tuas, por exemplo «Meditação»."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Până la %1$lld notițe proprii, de exemplu „Meditație”."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "До %1$lld своих заметок, например «Медитация»."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Upp till %1$lld egna anteckningar, till exempel ”Meditation”."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บันทึกของคุณเองได้สูงสุด %1$lld รายการ เช่น “นั่งสมาธิ”"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "En fazla %1$lld kendi notun, örneğin “Meditasyon”."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "До %1$lld власних нотаток, наприклад «Медитація»."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tối đa %1$lld ghi chú của riêng bạn, ví dụ “Thiền”."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "最多 %1$lld 条自定义备注,例如“冥想”。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "最多 %1$lld 則自訂備註,例如「冥想」。"
          }
        }
      }
    },
