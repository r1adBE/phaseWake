    "test_hint": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يرنّ بعد دقيقتين بإعدادات منبّهك التالي، دون غفوة. لا يُحتسب ليلة."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zazvoní za 2 minuty s nastavením tvého dalšího budíku, bez odložení. Nepočítá se jako noc."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ringer om 2 minutter med indstillingerne for din næste alarm, uden udsættelse. Tæller ikke som en nat."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Klingelt in 2 Minuten mit den Einstellungen deines nächsten Weckers, ohne Schlummern. Zählt nicht als Nacht."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Χτυπά σε 2 λεπτά με τις ρυθμίσεις της επόμενης αφύπνισής σου, χωρίς αναβολή. Δεν μετράει ως νύχτα."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rings in 2 minutes with the settings of your next alarm, without snoozing. Doesn’t count as a night."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Suena en 2 minutos con los ajustes de tu próxima alarma, sin posponer. No cuenta como noche."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "۲ دقیقه دیگر با تنظیمات زنگ بعدی‌ات زنگ می‌زند، بدون چرت. شب حساب نمی‌شود."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Soi 2 minuutin päästä seuraavan herätyksesi asetuksilla, ilman torkkua. Ei lasketa yöksi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sonne dans 2 minutes avec les réglages de ton prochain réveil, sans répétition. Ne compte pas comme une nuit."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מצלצל בעוד 2 דקות עם ההגדרות של ההשכמה הבאה שלכם, בלי נודניק. לא נחשב כלילה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके अगले अलार्म की सेटिंग के साथ 2 मिनट में बजता है, बिना स्नूज़ के। रात के रूप में नहीं गिना जाता।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "2 perc múlva szól a következő ébresztőd beállításaival, szundi nélkül. Nem számít éjszakának."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Berbunyi dalam 2 menit dengan setelan alarm berikutnya, tanpa tunda. Tidak dihitung sebagai malam."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Suona tra 2 minuti con le impostazioni della tua prossima sveglia, senza posticipo. Non conta come notte."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "次のアラームの設定で2分後に鳴ります。スヌーズなし。夜としては記録されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다음 알람 설정으로 2분 후에 울려요. 다시 알림 없이. 밤으로 기록되지 않아요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Berbunyi dalam 2 minit dengan tetapan penggera seterusnya, tanpa tunda. Tidak dikira sebagai malam."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ringer om 2 minutter med innstillingene for den neste alarmen din, uten slumring. Teller ikke som en natt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gaat over 2 minuten af met de instellingen van je volgende wekker, zonder snoozen. Telt niet als nacht."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zadzwoni za 2 minuty z ustawieniami Twojego następnego budzika, bez drzemki. Nie liczy się jako noc."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca em 2 minutos com as configurações do seu próximo alarme, sem soneca. Não conta como noite."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca em 2 minutos com as definições do teu próximo alarme, sem adiar. Não conta como noite."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Sună în 2 minute cu setările următoarei tale alarme, fără amânare. Nu contează ca noapte."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Зазвонит через 2 минуты с настройками твоего следующего будильника, без повтора. Не считается ночью."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ringer om 2 minuter med inställningarna för ditt nästa alarm, utan snooze. Räknas inte som en natt."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ดังใน 2 นาทีด้วยการตั้งค่าของการปลุกครั้งถัดไป ไม่มีเลื่อนปลุก ไม่นับเป็นคืน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sonraki alarmının ayarlarıyla 2 dakika sonra çalar, ertelemesiz. Gece sayılmaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Задзвонить за 2 хвилини з налаштуваннями твого наступного будильника, без відкладення. Не вважається ніччю."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Reo sau 2 phút với cài đặt của báo thức tiếp theo, không báo lại. Không tính là một đêm."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "2 分钟后按你下一个闹钟的设置响铃，不能稍后提醒。不计为一晚。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "2 分鐘後依你下一個鬧鐘的設定響鈴，不能稍後提醒。不計為一晚。"
          }
        }
      }
    },
