    "holidays_hint": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا تشمل العطل المحلية لبلديات بعينها."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Místní svátky jednotlivých obcí nejsou zahrnuty."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Lokale helligdage i enkelte kommuner er ikke med."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lokale Feiertage einzelner Gemeinden sind nicht enthalten."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι τοπικές αργίες μεμονωμένων δήμων δεν περιλαμβάνονται."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Local holidays of single towns are not included."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se incluyen los festivos locales de cada municipio."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "تعطیلات محلی شهرهای جداگانه در آن نیست."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Yksittäisten kuntien paikalliset juhlapäivät eivät ole mukana."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les jours fériés locaux de certaines communes ne sont pas inclus."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "חגים מקומיים של יישובים בודדים אינם כלולים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अलग-अलग शहरों की स्थानीय छुट्टियां शामिल नहीं हैं।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az egyes települések helyi ünnepei nem szerepelnek."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hari libur lokal tiap daerah tidak termasuk."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I festivi locali dei singoli comuni non sono inclusi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各自治体の地方祝日は含まれません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "개별 지자체의 지역 공휴일은 포함되지 않아요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuti tempatan bagi kawasan tertentu tidak termasuk."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Lokale helligdager i enkelte kommuner er ikke med."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Lokale feestdagen van afzonderlijke gemeenten zijn niet inbegrepen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Lokalne święta poszczególnych gmin nie są uwzględnione."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Feriados locais de cada município não estão incluídos."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Feriados locais de cada município não estão incluídos."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Sărbătorile locale ale unor localități nu sunt incluse."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Местные праздники отдельных населённых пунктов не учитываются."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lokala helgdagar i enskilda kommuner ingår inte."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่รวมวันหยุดท้องถิ่นของแต่ละเทศบาล"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tek tek belediyelerin yerel tatilleri dahil değildir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Місцеві свята окремих громад не враховано."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không gồm ngày lễ địa phương của từng xã, phường."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不包含个别城镇的地方节日。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "不包含個別鄉鎮的地方假日。"
          }
        }
      }
    },
