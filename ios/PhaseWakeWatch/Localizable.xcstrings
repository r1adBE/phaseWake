    "check_ready_text": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الساعة متصلة والمنبهات مسموحة. اضغط للتفاصيل."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Hodinky jsou připojené, budíky povolené. Klepnutím zobrazíš podrobnosti."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Uret er forbundet, alarmer er tilladt. Tryk for detaljer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Uhr verbunden, Wecker erlaubt. Tippen für Details."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το ρολόι είναι συνδεδεμένο, τα ξυπνητήρια επιτρέπονται. Πάτα για λεπτομέρειες."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Watch connected, alarms allowed. Tap for details."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reloj conectado, alarmas permitidas. Toca para ver los detalles."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "ساعت متصل است و هشدارها مجاز است. برای جزئیات بزن."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kello on yhdistetty, herätykset sallittu. Napauta nähdäksesi lisätiedot."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Montre connectée, alarmes autorisées. Touche pour voir les détails."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "השעון מחובר, ההתראות מאושרות. הקישו לפרטים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वॉच कनेक्टेड है, अलार्म की अनुमति है। विवरण के लिए टैप करें।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az óra csatlakoztatva, az ébresztők engedélyezve. Koppints a részletekért."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jam tangan terhubung, alarm diizinkan. Ketuk untuk detail."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Orologio connesso, sveglie consentite. Tocca per i dettagli."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ウォッチ接続済み、アラーム許可済み。タップで詳細を表示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "워치 연결됨, 알람 허용됨. 탭하면 자세히 볼 수 있어요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Jam tangan disambungkan, penggera dibenarkan. Ketik untuk butiran."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Klokken er tilkoblet, alarmer er tillatt. Trykk for detaljer."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Horloge verbonden, wekkers toegestaan. Tik voor details."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zegarek połączony, budziki dozwolone. Dotknij, aby zobaczyć szczegóły."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Relógio conectado, alarmes permitidos. Toque para ver os detalhes."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Relógio ligado, alarmes permitidos. Toca para ver os detalhes."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ceas conectat, alarme permise. Atinge pentru detalii."
