    "onb_welcome_text": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يوقظك Phase Wake ضمن نافذتك عندما يكون نومك خفيفًا. الساعة تقيس، والهاتف يرنّ أيضًا."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake tě vzbudí v okně, když spíš lehce. Hodinky měří, telefon zvoní také."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake vækker dig inden for dit vindue, når du sover let. Uret måler, telefonen ringer også."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake weckt dich im Weckfenster, wenn du gerade leicht schläfst. Die Uhr misst, das Handy klingelt mit."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Phase Wake σε ξυπνά μέσα στο παράθυρό σου όταν κοιμάσαι ελαφριά. Το ρολόι μετρά, χτυπά και το κινητό."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake wakes you within your window when you sleep lightly. Your watch measures, your phone rings too."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake te despierta dentro de tu ventana cuando duermes ligero. El reloj mide, el teléfono también suena."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake وقتی خوابت سبک است، در بازهٔ تو بیدارت می‌کند. ساعت اندازه می‌گیرد، گوشی هم زنگ می‌زند."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake herättää sinut ikkunan sisällä, kun nukut kevyesti. Kello mittaa, puhelin soi myös."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake te réveille dans ta fenêtre quand ton sommeil est léger. La montre mesure, le téléphone sonne aussi."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake מעיר אתכם בתוך החלון כשהשינה קלה. השעון מודד, וגם הטלפון מצלצל."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जब आपकी नींद हल्की होती है, Phase Wake आपको आपकी विंडो में जगाता है। वॉच मापती है, फ़ोन भी बजता है।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Phase Wake az ablakodon belül ébreszt, amikor éppen éberen alszol. Az óra mér, a telefon is csörög."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake membangunkanmu dalam jendela waktu saat tidurmu ringan. Jam tangan mengukur, ponsel juga berbunyi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake ti sveglia nella finestra quando dormi leggero. L’orologio misura, anche il telefono suona."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "眠りが浅いときに、Phase Wakeがウィンドウ内で起こします。ウォッチが測定し、スマホも鳴ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "잠이 얕을 때 Phase Wake가 창 안에서 깨워 줘요. 워치가 측정하고 휴대폰도 함께 울려요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake mengejutkan awak dalam tetingkap masa apabila tidur awak ringan. Jam tangan mengukur, telefon juga berbunyi."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake vekker deg innenfor vinduet ditt når du sover lett. Klokken måler, telefonen ringer også."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake wekt je binnen je venster als je licht slaapt. Het horloge meet, de telefoon gaat ook af."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake budzi Cię w Twoim oknie, gdy śpisz płytko. Zegarek mierzy, telefon też dzwoni."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Phase Wake acorda você dentro da sua janela quando o sono está leve. O relógio mede, o celular também toca."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O Phase Wake acorda-te dentro da tua janela quando o sono está leve. O relógio mede, o telemóvel também toca."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake te trezește în fereastra ta când dormi ușor. Ceasul măsoară, telefonul sună și el."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake будит тебя в пределах окна, когда ты спишь чутко. Часы измеряют, телефон тоже звонит."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake väcker dig inom ditt fönster när du sover lätt. Klockan mäter, telefonen ringer också."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake ปลุกคุณในช่วงเวลาที่ตั้งไว้เมื่อคุณหลับตื้น นาฬิกาวัด โทรศัพท์ก็ดังด้วย"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake, hafif uyurken seni pencere içinde uyandırır. Saat ölçer, telefon da çalar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake будить тебе в межах вікна, коли ти спиш чутко. Годинник вимірює, телефон теж дзвонить."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Wake đánh thức bạn trong khung giờ khi bạn ngủ nông. Đồng hồ đo, điện thoại cũng reo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当你睡得浅时，Phase Wake 在你的时间窗口内叫醒你。手表负责测量，手机也会响。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "當你睡得淺時，Phase Wake 會在你的時間窗口內叫醒你。手錶負責測量，手機也會響。"
          }
        }
      }
    },
