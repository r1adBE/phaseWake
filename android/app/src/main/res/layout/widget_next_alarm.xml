<?xml version="1.0" encoding="utf-8"?>
<!-- Widget «Nächster Wecker»: Fenster gross, darunter Tag und Nacht-Check (Symbol und Text, nie nur Farbe). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:padding="14dp"
    tools:ignore="Overdraw">

    <TextView
        android:id="@+id/widget_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/widget_name"
        android:textColor="#FFC9C3E6"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/widget_window"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:textColor="#FFFBF7F0"
        android:textSize="24sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_day"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:textColor="#FFC9C3E6"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/widget_check"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:maxLines="2"
        android:textColor="#FFFBF7F0"
        android:textSize="13sp" />
</LinearLayout>
