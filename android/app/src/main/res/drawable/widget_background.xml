<?xml version="1.0" encoding="utf-8"?>
<!--
    Hintergrund des Widgets: Verlauf widget_top → widget_bottom (hell: Creme → Lavendel, dunkel: Nachthimmel,
    folgt dem Design des Systems), runde Ecken wie die Karten.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <gradient
        android:angle="270"
        android:endColor="@color/widget_bottom"
        android:startColor="@color/widget_top" />
    <corners android:radius="20dp" />
</shape>
